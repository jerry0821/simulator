10598: // Note that a local position will vary depending on initial scroll value,
10599: // This is a little bit confusing so bear with us:
10600: //  - local_pos = (absolution_pos - window->Pos)
10601: //  - So local_x/local_y are 0.0f for a position at the upper-left corner of a window,
10602: //    and generally local_x/local_y are >(padding+decoration) && <(size-padding-decoration) when in the visible area.
10603: //  - They mostly exist because of legacy API.
10604: // Following the rules above, when trying to work with scrolling code, consider that:
10605: //  - SetScrollFromPosY(0.0f) == SetScrollY(0.0f + scroll.y) == has no effect!
10606: //  - SetScrollFromPosY(-scroll.y) == SetScrollY(-scroll.y + scroll.y) == SetScrollY(0.0f) == reset scroll. Of course writing SetScrollY(0.0f) directly then makes more sense
10607: // We store a target position so centering and clamping can occur on the next frame when we are guaranteed to have a known window size
10608: void ImGui::SetScrollFromPosX(ImGuiWindow* window, float local_x, float center_x_ratio)
10609: {
10610:     IM_ASSERT(center_x_ratio >= 0.0f && center_x_ratio <= 1.0f);
10611:     window->ScrollTarget.x = IM_TRUNC(local_x - window->DecoOuterSizeX1 - window->DecoInnerSizeX1 + window->Scroll.x); // Convert local position to scroll offset
10612:     window->ScrollTargetCenterRatio.x = center_x_ratio;
10613:     window->ScrollTargetEdgeSnapDist.x = 0.0f;
10614: }
