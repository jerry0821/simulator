 7747: void ImGui::SetNavFocusScope(ImGuiID focus_scope_id)
 7748: {
 7749:     ImGuiContext& g = *GImGui;
 7750:     g.NavFocusScopeId = focus_scope_id;
 7751:     g.NavFocusRoute.resize(0); // Invalidate
 7752:     if (focus_scope_id == 0)
 7753:         return;
 7754:     IM_ASSERT(g.NavWindow != NULL);
 7755:     // Store current path (in reverse order)
 7756:     if (focus_scope_id == g.CurrentFocusScopeId)
 7757:     {
 7758:         // Top of focus stack contains local focus scopes inside current window
 7759:         for (int n = g.FocusScopeStack.Size - 1; n >= 0 && g.FocusScopeStack.Data[n].WindowID == g.CurrentWindow->ID; n--)
 7760:             g.NavFocusRoute.push_back(g.FocusScopeStack.Data[n]);
 7761:     }
 7762:     else if (focus_scope_id == g.NavWindow->NavRootFocusScopeId)
 7763:         g.NavFocusRoute.push_back({ focus_scope_id, g.NavWindow->ID });
 7764:     else
 7765:         return;
 7766:     // Then follow on manually set ParentWindowForFocusRoute field (#6798)
 7767:     for (ImGuiWindow* window = g.NavWindow->ParentWindowForFocusRoute; window != NULL; window = window->ParentWindowForFocusRoute)
 7768:         g.NavFocusRoute.push_back({ window->NavRootFocusScopeId, window->ID });
 7769:     IM_ASSERT(g.NavFocusRoute.Size < 100); // Maximum depth is technically 251 as per CalcRoutingScore(): 254 - 3
 7770: }
