4588: // API is designed this way to avoid exposing the 8K page size
4589: // e.g. use with IsGlyphRangeUnused(0, 255)
4590: bool ImFont::IsGlyphRangeUnused(unsigned int c_begin, unsigned int c_last)
4591: {
4592:     unsigned int page_begin = (c_begin / 8192);
4593:     unsigned int page_last = (c_last / 8192);
4594:     for (unsigned int page_n = page_begin; page_n <= page_last; page_n++)
4595:         if ((page_n >> 3) < sizeof(Used8kPagesMap))
4596:             if (Used8kPagesMap[page_n >> 3] & (1 << (page_n & 7)))
4597:                 return false;
4598:     return true;
4599: }
4600: // x0/y0/x1/y1 are offset from the character upper-left layout position, in pixels. Therefore x0/y0 are often fairly close to zero.
4601: // Not to be mistaken with texture coordinates, which are held by u0/v0/u1/v1 in normalized format (0.0..1.0 on each texture axis).
4602: // - 'src' is not necessarily == 'this->Sources' because multiple source fonts+configs can be used to build one target font.
4603: ImFontGlyph* ImFontAtlasBakedAddFontGlyph(ImFontAtlas* atlas, ImFontBaked* baked, ImFontConfig* src, const ImFontGlyph* in_glyph)
4604: {
4605:     int glyph_idx = baked->Glyphs.Size;
4606:     baked->Glyphs.push_back(*in_glyph);
4607:     ImFontGlyph* glyph = &baked->Glyphs[glyph_idx];
4608:     IM_ASSERT(baked->Glyphs.Size < 0xFFFE); // IndexLookup[] hold 16-bit values and -1/-2 are reserved.
4609:     // Set UV from packed rectangle
4610:     if (glyph->PackId != ImFontAtlasRectId_Invalid)
4611:     {
4612:         ImTextureRect* r = ImFontAtlasPackGetRect(atlas, glyph->PackId);
4613:         IM_ASSERT(glyph->U0 == 0.0f && glyph->V0 == 0.0f && glyph->U1 == 0.0f && glyph->V1 == 0.0f);
4614:         glyph->U0 = (r->x) * atlas->TexUvScale.x;
4615:         glyph->V0 = (r->y) * atlas->TexUvScale.y;
4616:         glyph->U1 = (r->x + r->w) * atlas->TexUvScale.x;
4617:         glyph->V1 = (r->y + r->h) * atlas->TexUvScale.y;
4618:         baked->MetricsTotalSurface += r->w * r->h;
4619:     }
4620:     if (src != NULL)
4621:     {
4622:         // Clamp & recenter if needed
4623:         const float ref_size = baked->OwnerFont->Sources[0]->SizePixels;
4624:         const float offsets_scale = (ref_size != 0.0f) ? (baked->Size / ref_size) : 1.0f;
4625:         float advance_x = ImClamp(glyph->AdvanceX, src->GlyphMinAdvanceX * offsets_scale, src->GlyphMaxAdvanceX * offsets_scale);
4626:         if (advance_x != glyph->AdvanceX)
4627:         {
4628:             float char_off_x = src->PixelSnapH ? ImTrunc((advance_x - glyph->AdvanceX) * 0.5f) : (advance_x - glyph->AdvanceX) * 0.5f;
4629:             glyph->X0 += char_off_x;
4630:             glyph->X1 += char_off_x;
4631:         }
4632:         // Snap to pixel
4633:         if (src->PixelSnapH)
4634:             advance_x = IM_ROUND(advance_x);
4635:         // Bake spacing
4636:         glyph->AdvanceX = advance_x + src->GlyphExtraAdvanceX;
4637:     }
4638:     if (glyph->Colored)
4639:         atlas->TexPixelsUseColors = atlas->TexData->UseColors = true;
4640:     // Update lookup tables
4641:     const int codepoint = glyph->Codepoint;
4642:     ImFontBaked_BuildGrowIndex(baked, codepoint + 1);
4643:     baked->IndexAdvanceX[codepoint] = glyph->AdvanceX;
4644:     baked->IndexLookup[codepoint] = (ImU16)glyph_idx;
4645:     const int page_n = codepoint / 8192;
4646:     baked->OwnerFont->Used8kPagesMap[page_n >> 3] |= 1 << (page_n & 7);
4647:     return glyph;
4648: }
