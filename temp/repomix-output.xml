18: 	class DebugText
19: 	{
20: 	private:
21: 		// 注意！初期化で外部から設定されるもの。Release不要。
22: 		ID3D11Device* m_pDevice = nullptr;
23: 		ID3D11DeviceContext* m_pContext = nullptr;
24: 		float m_OffsetX{ 0.0f }; // オフセットX座標
25: 		float m_OffsetY{ 0.0f }; // オフセットY座標
26: 		ULONG m_MaxLine{ 0 }; // 最大行数
27: 		ULONG m_MaxCharactersPerLine{ 0 }; // 1行あたりの最大文字数
28: 		float m_LineSpacing{ 0.0f }; // 行間隔
29: 		float m_CharacterSpacing{ 0.0f }; // 文字間隔
30: 		struct Characters { 
31: 			Characters(const DirectX::XMFLOAT4& color) : color(color) {}
32: 			std::string characters; 
33: 			DirectX::XMFLOAT4 color{ 1.0f, 1.0f, 1.0f, 1.0f };
34: 		};
35: 		struct LineStrings {
36: 			std::list<Characters> strings;
37: 			ULONG characterCount{ 0 };
38: 			ULONG spaceCount{ 0 };
39: 		};
40: 		std::list<LineStrings> m_TextLines; // 表示するテキスト行のリスト
41: 		UINT m_CharacterCount{ 0 }; // 現在の文字数（空白文字、改行文字、タブ文字を除く)
42: 		// フォントテクスチャ
43: 		std::wstring m_FileName; // ファイル名
44: 		ID3D11Resource* m_pTexture = nullptr;
45: 		ID3D11ShaderResourceView* m_pTextureView = nullptr;
46: 		UINT m_TextureWidth{ 0 }; // テクスチャの幅
47: 		UINT m_TextureHeight{ 0 }; // テクスチャの高さ
48: 		// テクスチャ管理MAP
49: 		static std::unordered_map<std::wstring, std::tuple<ID3D11Resource*, ID3D11ShaderResourceView*>> m_TextureMap;
50: 		Microsoft::WRL::ComPtr<ID3D11Buffer> m_pVertexBuffer; // 頂点バッファ
51: 		Microsoft::WRL::ComPtr<ID3D11Buffer> m_pIndexBuffer; // インデックスバッファ
52: 		UINT m_BufferSourceCharacterCount{ 0 }; // バッファに登録されている文字数
53: 		static Microsoft::WRL::ComPtr<ID3D11BlendState> m_pBlendState; // ブレンドステート
54: 		static Microsoft::WRL::ComPtr<ID3D11DepthStencilState> m_pDepthStencilState; // 深度ステンシルステート
55: 		static Microsoft::WRL::ComPtr<ID3D11RasterizerState> m_pRasterizerState; // ラスタライザーステート
56: 		static Microsoft::WRL::ComPtr<ID3D11VertexShader> m_pVertexShader; // 頂点シェーダー
57: 		static Microsoft::WRL::ComPtr<ID3D11InputLayout> m_pInputLayout; // 入力レイアウト
58: 		static Microsoft::WRL::ComPtr<ID3D11Buffer> m_pVSConstantBuffer; // 頂点シェーダー定数バッファ
59: 		static Microsoft::WRL::ComPtr<ID3D11PixelShader> m_pPixelShader; // ピクセルシェーダー
60: 		static Microsoft::WRL::ComPtr<ID3D11SamplerState> m_pSamplerState; // サンプラーステート
61: 	public:
62: 		DebugText() = delete;
63: 		DebugText(ID3D11Device* pDevice, ID3D11DeviceContext* pContext, const wchar_t* pFontTextureFileName, UINT screenWidth, UINT screenHeight, float offsetX = 0.0f, float offsetY = 0.0f, ULONG maxLine = 0, ULONG maxCharactersPerLine = 0, float lineSpacing = 0.0f, float characterSpacing = 0.0f);
64: 		~DebugText();
65: 		// ※一万文字くらいまで登録可能（空白文字、改行文字、タブ文字を除く）
66: 		void SetText(const char* pText, DirectX::XMFLOAT4 color = { 1.0f, 1.0f, 1.0f, 1.0f });
67: 		void Draw();
68: 		void Clear(); // 登録されているテキストをクリア
69: 	private:
70: 		struct Vertex
71: 		{
72: 			DirectX::XMFLOAT3 position; // 座標
73: 			DirectX::XMFLOAT4 color;    // 色
74: 			DirectX::XMFLOAT2 texcoord; // テクスチャ座標
75: 		};
76: 		void createBuffer(ULONG characterCount);
77: 	};
78: }
79: #endif // DEBUG_TEXT_H
