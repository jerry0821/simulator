490: /** @brief A mesh represents a geometry or model with a single material.
491: *
492: * It usually consists of a number of vertices and a series of primitives/faces
493: * referencing the vertices. In addition there might be a series of bones, each
494: * of them addressing a number of vertices with a certain weight. Vertex data
495: * is presented in channels with each channel containing a single per-vertex
496: * information such as a set of texture coordinates or a normal vector.
497: * If a data pointer is non-null, the corresponding data stream is present.
498: * From C++-programs you can also use the comfort functions Has*() to
499: * test for the presence of various data streams.
500: *
501: * A Mesh uses only a single material which is referenced by a material ID.
502: * @note The mPositions member is usually not optional. However, vertex positions
503: * *could* be missing if the #AI_SCENE_FLAGS_INCOMPLETE flag is set in
504: * @code
505: * aiScene::mFlags
506: * @endcode
507: */
508: struct aiMesh {
509:     /** Bitwise combination of the members of the #aiPrimitiveType enum.
510:      * This specifies which types of primitives are present in the mesh.
511:      * The "SortByPrimitiveType"-Step can be used to make sure the
512:      * output meshes consist of one primitive type each.
513:      */
514:     unsigned int mPrimitiveTypes;
515:     /** The number of vertices in this mesh.
516:     * This is also the size of all of the per-vertex data arrays.
517:     * The maximum value for this member is #AI_MAX_VERTICES.
518:     */
519:     unsigned int mNumVertices;
520:     /** The number of primitives (triangles, polygons, lines) in this  mesh.
521:     * This is also the size of the mFaces array.
522:     * The maximum value for this member is #AI_MAX_FACES.
523:     */
524:     unsigned int mNumFaces;
525:     /** Vertex positions.
526:     * This array is always present in a mesh. The array is
527:     * mNumVertices in size.
528:     */
529:     C_STRUCT aiVector3D *mVertices;
530:     /** Vertex normals.
531:     * The array contains normalized vectors, nullptr if not present.
532:     * The array is mNumVertices in size. Normals are undefined for
533:     * point and line primitives. A mesh consisting of points and
534:     * lines only may not have normal vectors. Meshes with mixed
535:     * primitive types (i.e. lines and triangles) may have normals,
536:     * but the normals for vertices that are only referenced by
537:     * point or line primitives are undefined and set to QNaN (WARN:
538:     * qNaN compares to inequal to *everything*, even to qNaN itself.
539:     * Using code like this to check whether a field is qnan is:
540:     * @code
541:     * #define IS_QNAN(f) (f != f)
542:     * @endcode
543:     * still dangerous because even 1.f == 1.f could evaluate to false! (
544:     * remember the subtleties of IEEE754 artithmetics). Use stuff like
545:     * @c fpclassify instead.
546:     * @note Normal vectors computed by Assimp are always unit-length.
547:     * However, this needn't apply for normals that have been taken
548:     *   directly from the model file.
549:     */
550:     C_STRUCT aiVector3D *mNormals;
551:     /** Vertex tangents.
552:     * The tangent of a vertex points in the direction of the positive
553:     * X texture axis. The array contains normalized vectors, nullptr if
554:     * not present. The array is mNumVertices in size. A mesh consisting
555:     * of points and lines only may not have normal vectors. Meshes with
556:     * mixed primitive types (i.e. lines and triangles) may have
557:     * normals, but the normals for vertices that are only referenced by
558:     * point or line primitives are undefined and set to qNaN.  See
559:     * the #mNormals member for a detailed discussion of qNaNs.
560:     * @note If the mesh contains tangents, it automatically also
561:     * contains bitangents.
562:     */
563:     C_STRUCT aiVector3D *mTangents;
564:     /** Vertex bitangents.
565:     * The bitangent of a vertex points in the direction of the positive
566:     * Y texture axis. The array contains normalized vectors, nullptr if not
567:     * present. The array is mNumVertices in size.
568:     * @note If the mesh contains tangents, it automatically also contains
569:     * bitangents.
570:     */
571:     C_STRUCT aiVector3D *mBitangents;
572:     /** Vertex color sets.
573:     * A mesh may contain 0 to #AI_MAX_NUMBER_OF_COLOR_SETS vertex
574:     * colors per vertex. nullptr if not present. Each array is
575:     * mNumVertices in size if present.
576:     */
577:     C_STRUCT aiColor4D *mColors[AI_MAX_NUMBER_OF_COLOR_SETS];
578:     /** Vertex texture coordinates, also known as UV channels.
579:     * A mesh may contain 0 to AI_MAX_NUMBER_OF_TEXTURECOORDS per
580:     * vertex. nullptr if not present. The array is mNumVertices in size.
581:     */
582:     C_STRUCT aiVector3D *mTextureCoords[AI_MAX_NUMBER_OF_TEXTURECOORDS];
583:     /** Specifies the number of components for a given UV channel.
584:     * Up to three channels are supported (UVW, for accessing volume
585:     * or cube maps). If the value is 2 for a given channel n, the
586:     * component p.z of mTextureCoords[n][p] is set to 0.0f.
587:     * If the value is 1 for a given channel, p.y is set to 0.0f, too.
588:     * @note 4D coordinates are not supported
589:     */
590:     unsigned int mNumUVComponents[AI_MAX_NUMBER_OF_TEXTURECOORDS];
591:     /** The faces the mesh is constructed from.
592:     * Each face refers to a number of vertices by their indices.
593:     * This array is always present in a mesh, its size is given
594:     * in mNumFaces. If the #AI_SCENE_FLAGS_NON_VERBOSE_FORMAT
595:     * is NOT set each face references an unique set of vertices.
596:     */
597:     C_STRUCT aiFace *mFaces;
598:     /** The number of bones this mesh contains.
599:     * Can be 0, in which case the mBones array is nullptr.
600:     */
601:     unsigned int mNumBones;
602:     /** The bones of this mesh.
603:     * A bone consists of a name by which it can be found in the
604:     * frame hierarchy and a set of vertex weights.
605:     */
606:     C_STRUCT aiBone **mBones;
607:     /** The material used by this mesh.
608:      * A mesh uses only a single material. If an imported model uses
609:      * multiple materials, the import splits up the mesh. Use this value
610:      * as index into the scene's material list.
611:      */
612:     unsigned int mMaterialIndex;
613:     /** Name of the mesh. Meshes can be named, but this is not a
614:      *  requirement and leaving this field empty is totally fine.
615:      *  There are mainly three uses for mesh names:
616:      *   - some formats name nodes and meshes independently.
617:      *   - importers tend to split meshes up to meet the
618:      *      one-material-per-mesh requirement. Assigning
619:      *      the same (dummy) name to each of the result meshes
620:      *      aids the caller at recovering the original mesh
621:      *      partitioning.
622:      *   - Vertex animations refer to meshes by their names.
623:      **/
624:     C_STRUCT aiString mName;
625:     /** The number of attachment meshes. Note! Currently only works with Collada loader. */
626:     unsigned int mNumAnimMeshes;
627:     /** Attachment meshes for this mesh, for vertex-based animation.
628:      *  Attachment meshes carry replacement data for some of the
629:      *  mesh'es vertex components (usually positions, normals).
630:      *  Note! Currently only works with Collada loader.*/
631:     C_STRUCT aiAnimMesh **mAnimMeshes;
632:     /**
633:      *  Method of morphing when anim-meshes are specified.
634:      *  @see aiMorphingMethod to learn more about the provided morphing targets.
635:      */
636:     unsigned int mMethod;
637:     /**
638:      *  The bounding box.
639:      */
640:     C_STRUCT aiAABB mAABB;
641:     /** Vertex UV stream names. Pointer to array of size AI_MAX_NUMBER_OF_TEXTURECOORDS
642:      */
643:     C_STRUCT aiString **mTextureCoordsNames;
644: #ifdef __cplusplus
645:     //! Default constructor. Initializes all members to 0
646:     aiMesh() AI_NO_EXCEPT
647:             : mPrimitiveTypes(0),
648:               mNumVertices(0),
649:               mNumFaces(0),
650:               mVertices(nullptr),
651:               mNormals(nullptr),
652:               mTangents(nullptr),
653:               mBitangents(nullptr),
654:               mColors(),
655:               mTextureCoords(),
656:               mNumUVComponents(),
657:               mFaces(nullptr),
658:               mNumBones(0),
659:               mBones(nullptr),
660:               mMaterialIndex(0),
661:               mNumAnimMeshes(0),
662:               mAnimMeshes(nullptr),
663:               mMethod(0),
664:               mAABB(),
665:               mTextureCoordsNames(nullptr) {
666:         for (unsigned int a = 0; a < AI_MAX_NUMBER_OF_TEXTURECOORDS; ++a) {
667:             mNumUVComponents[a] = 0;
668:             mTextureCoords[a] = nullptr;
669:         }
670:         for (unsigned int a = 0; a < AI_MAX_NUMBER_OF_COLOR_SETS; ++a) {
671:             mColors[a] = nullptr;
672:         }
673:     }
674:     //! Deletes all storage allocated for the mesh
675:     ~aiMesh() {
676:         delete[] mVertices;
677:         delete[] mNormals;
678:         delete[] mTangents;
679:         delete[] mBitangents;
680:         for (unsigned int a = 0; a < AI_MAX_NUMBER_OF_TEXTURECOORDS; a++) {
681:             delete[] mTextureCoords[a];
682:         }
683:         if (mTextureCoordsNames) {
684:             for (unsigned int a = 0; a < AI_MAX_NUMBER_OF_TEXTURECOORDS; a++) {
685:                 delete mTextureCoordsNames[a];
686:             }
687:             delete[] mTextureCoordsNames;
688:         }
689:         for (unsigned int a = 0; a < AI_MAX_NUMBER_OF_COLOR_SETS; a++) {
690:             delete[] mColors[a];
691:         }
692:         // DO NOT REMOVE THIS ADDITIONAL CHECK
693:         if (mNumBones && mBones) {
694:             for (unsigned int a = 0; a < mNumBones; a++) {
695:                 if (mBones[a]) {
696:                     delete mBones[a];
697:                 }
698:             }
699:             delete[] mBones;
700:         }
701:         if (mNumAnimMeshes && mAnimMeshes) {
702:             for (unsigned int a = 0; a < mNumAnimMeshes; a++) {
703:                 delete mAnimMeshes[a];
704:             }
705:             delete[] mAnimMeshes;
706:         }
707:         delete[] mFaces;
708:     }
709:     //! Check whether the mesh contains positions. Provided no special
710:     //! scene flags are set, this will always be true
711:     bool HasPositions() const { return mVertices != nullptr && mNumVertices > 0; }
712:     //! Check whether the mesh contains faces. If no special scene flags
713:     //! are set this should always return true
714:     bool HasFaces() const { return mFaces != nullptr && mNumFaces > 0; }
715:     //! Check whether the mesh contains normal vectors
716:     bool HasNormals() const { return mNormals != nullptr && mNumVertices > 0; }
717:     //! Check whether the mesh contains tangent and bitangent vectors
718:     //! It is not possible that it contains tangents and no bitangents
719:     //! (or the other way round). The existence of one of them
720:     //! implies that the second is there, too.
721:     bool HasTangentsAndBitangents() const { return mTangents != nullptr && mBitangents != nullptr && mNumVertices > 0; }
722:     //! Check whether the mesh contains a vertex color set
723:     //! \param pIndex Index of the vertex color set
724:     bool HasVertexColors(unsigned int pIndex) const {
725:         if (pIndex >= AI_MAX_NUMBER_OF_COLOR_SETS) {
726:             return false;
727:         } else {
728:             return mColors[pIndex] != nullptr && mNumVertices > 0;
729:         }
730:     }
731:     //! Check whether the mesh contains a texture coordinate set
732:     //! \param pIndex Index of the texture coordinates set
733:     bool HasTextureCoords(unsigned int pIndex) const {
734:         if (pIndex >= AI_MAX_NUMBER_OF_TEXTURECOORDS) {
735:             return false;
736:         } else {
737:             return mTextureCoords[pIndex] != nullptr && mNumVertices > 0;
738:         }
739:     }
740:     //! Get the number of UV channels the mesh contains
741:     unsigned int GetNumUVChannels() const {
742:         unsigned int n(0);
743:         while (n < AI_MAX_NUMBER_OF_TEXTURECOORDS && mTextureCoords[n]) {
744:             ++n;
745:         }
746:         return n;
747:     }
748:     //! Get the number of vertex color channels the mesh contains
749:     unsigned int GetNumColorChannels() const {
750:         unsigned int n(0);
751:         while (n < AI_MAX_NUMBER_OF_COLOR_SETS && mColors[n]) {
752:             ++n;
753:         }
754:         return n;
755:     }
756:     //! Check whether the mesh contains bones
757:     bool HasBones() const {
758:         return mBones != nullptr && mNumBones > 0;
759:     }
760:     //! Check whether the mesh contains a texture coordinate set name
761:     //! \param pIndex Index of the texture coordinates set
762:     bool HasTextureCoordsName(unsigned int pIndex) const {
763:         if (mTextureCoordsNames == nullptr || pIndex >= AI_MAX_NUMBER_OF_TEXTURECOORDS) {
764:             return false;
765:         }
766:         return mTextureCoordsNames[pIndex] != nullptr;
767:     }
768:     //! Set a texture coordinate set name
769:     //! \param pIndex Index of the texture coordinates set
770:     //! \param texCoordsName name of the texture coordinate set
771:     void SetTextureCoordsName(unsigned int pIndex, const aiString &texCoordsName) {
772:         if (pIndex >= AI_MAX_NUMBER_OF_TEXTURECOORDS) {
773:             return;
774:         }
775:         if (mTextureCoordsNames == nullptr) {
776:             // Construct and null-init array
777:             mTextureCoordsNames = new aiString *[AI_MAX_NUMBER_OF_TEXTURECOORDS] {};
778:         }
779:         if (texCoordsName.length == 0) {
780:             delete mTextureCoordsNames[pIndex];
781:             mTextureCoordsNames[pIndex] = nullptr;
782:             return;
783:         }
784:         if (mTextureCoordsNames[pIndex] == nullptr) {
785:             mTextureCoordsNames[pIndex] = new aiString(texCoordsName);
786:             return;
787:         }
788:         *mTextureCoordsNames[pIndex] = texCoordsName;
789:     }
790:     //! Get a texture coordinate set name
791:     //! \param pIndex Index of the texture coordinates set
792:     const aiString *GetTextureCoordsName(unsigned int pIndex) const {
793:         if (mTextureCoordsNames == nullptr || pIndex >= AI_MAX_NUMBER_OF_TEXTURECOORDS) {
794:             return nullptr;
795:         }
796:         return mTextureCoordsNames[pIndex];
797:     }
798: #endif // __cplusplus
799: };
