5294: static inline float ImAcos01(float x)
5295: {
5296:     if (x <= 0.0f) return IM_PI * 0.5f;
5297:     if (x >= 1.0f) return 0.0f;
5298:     return ImAcos(x);
5299:     //return (-0.69813170079773212f * x * x - 0.87266462599716477f) * x + 1.5707963267948966f; // Cheap approximation, may be enough for what we do.
5300: }
