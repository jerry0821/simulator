10746: // Supported flags: ImGuiPopupFlags_AnyPopupId, ImGuiPopupFlags_AnyPopupLevel
10747: bool ImGui::IsPopupOpen(ImGuiID id, ImGuiPopupFlags popup_flags)
10748: {
10749:     ImGuiContext& g = *GImGui;
10750:     if (popup_flags & ImGuiPopupFlags_AnyPopupId)
10751:     {
10752:         // Return true if any popup is open at the current BeginPopup() level of the popup stack
10753:         // This may be used to e.g. test for another popups already opened to handle popups priorities at the same level.
10754:         IM_ASSERT(id == 0);
10755:         if (popup_flags & ImGuiPopupFlags_AnyPopupLevel)
10756:             return g.OpenPopupStack.Size > 0;
10757:         else
10758:             return g.OpenPopupStack.Size > g.BeginPopupStack.Size;
10759:     }
10760:     else
10761:     {
10762:         if (popup_flags & ImGuiPopupFlags_AnyPopupLevel)
10763:         {
10764:             // Return true if the popup is open anywhere in the popup stack
10765:             for (int n = 0; n < g.OpenPopupStack.Size; n++)
10766:                 if (g.OpenPopupStack[n].PopupId == id)
10767:                     return true;
10768:             return false;
10769:         }
10770:         else
10771:         {
10772:             // Return true if the popup is open at the current BeginPopup() level of the popup stack (this is the most-common query)
10773:             return g.OpenPopupStack.Size > g.BeginPopupStack.Size && g.OpenPopupStack[g.BeginPopupStack.Size].PopupId == id;
10774:         }
10775:     }
10776: }
