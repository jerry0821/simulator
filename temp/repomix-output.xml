6660: //-------------------------------------------------------------------------
6661: // [SECTION] Widgets: Typing-Select support
6662: //-------------------------------------------------------------------------
6663: // [Experimental] Currently not exposed in public API.
6664: // Consume character inputs and return search request, if any.
6665: // This would typically only be called on the focused window or location you want to grab inputs for, e.g.
6666: //   if (ImGui::IsWindowFocused(...))
6667: //       if (ImGuiTypingSelectRequest* req = ImGui::GetTypingSelectRequest())
6668: //           focus_idx = ImGui::TypingSelectFindMatch(req, my_items.size(), [](void*, int n) { return my_items[n]->Name; }, &my_items, -1);
6669: // However the code is written in a way where calling it from multiple locations is safe (e.g. to obtain buffer).
6670: ImGuiTypingSelectRequest* ImGui::GetTypingSelectRequest(ImGuiTypingSelectFlags flags)
6671: {
6672:     ImGuiContext& g = *GImGui;
6673:     ImGuiTypingSelectState* data = &g.TypingSelectState;
6674:     ImGuiTypingSelectRequest* out_request = &data->Request;
6675:     // Clear buffer
6676:     const float TYPING_SELECT_RESET_TIMER = 1.80f;          // FIXME: Potentially move to IO config.
6677:     const int TYPING_SELECT_SINGLE_CHAR_COUNT_FOR_LOCK = 4; // Lock single char matching when repeating same char 4 times
6678:     if (data->SearchBuffer[0] != 0)
6679:     {
6680:         bool clear_buffer = false;
6681:         clear_buffer |= (g.NavFocusScopeId != data->FocusScope);
6682:         clear_buffer |= (data->LastRequestTime + TYPING_SELECT_RESET_TIMER < g.Time);
6683:         clear_buffer |= g.NavAnyRequest;
6684:         clear_buffer |= g.ActiveId != 0 && g.NavActivateId == 0; // Allow temporary SPACE activation to not interfere
6685:         clear_buffer |= IsKeyPressed(ImGuiKey_Escape) || IsKeyPressed(ImGuiKey_Enter);
6686:         clear_buffer |= IsKeyPressed(ImGuiKey_Backspace) && (flags & ImGuiTypingSelectFlags_AllowBackspace) == 0;
6687:         //if (clear_buffer) { IMGUI_DEBUG_LOG("GetTypingSelectRequest(): Clear SearchBuffer.\n"); }
6688:         if (clear_buffer)
6689:             data->Clear();
6690:     }
6691:     // Append to buffer
6692:     const int buffer_max_len = IM_ARRAYSIZE(data->SearchBuffer) - 1;
6693:     int buffer_len = (int)ImStrlen(data->SearchBuffer);
6694:     bool select_request = false;
6695:     for (ImWchar w : g.IO.InputQueueCharacters)
6696:     {
6697:         const int w_len = ImTextCountUtf8BytesFromStr(&w, &w + 1);
6698:         if (w < 32 || (buffer_len == 0 && ImCharIsBlankW(w)) || (buffer_len + w_len > buffer_max_len)) // Ignore leading blanks
6699:             continue;
6700:         char w_buf[5];
6701:         ImTextCharToUtf8(w_buf, (unsigned int)w);
6702:         if (data->SingleCharModeLock && w_len == out_request->SingleCharSize && memcmp(w_buf, data->SearchBuffer, w_len) == 0)
6703:         {
6704:             select_request = true; // Same character: don't need to append to buffer.
6705:             continue;
6706:         }
6707:         if (data->SingleCharModeLock)
6708:         {
6709:             data->Clear(); // Different character: clear
6710:             buffer_len = 0;
6711:         }
6712:         memcpy(data->SearchBuffer + buffer_len, w_buf, w_len + 1); // Append
6713:         buffer_len += w_len;
6714:         select_request = true;
6715:     }
6716:     g.IO.InputQueueCharacters.resize(0);
6717:     // Handle backspace
6718:     if ((flags & ImGuiTypingSelectFlags_AllowBackspace) && IsKeyPressed(ImGuiKey_Backspace, ImGuiInputFlags_Repeat))
6719:     {
6720:         char* p = (char*)(void*)ImTextFindPreviousUtf8Codepoint(data->SearchBuffer, data->SearchBuffer + buffer_len);
6721:         *p = 0;
6722:         buffer_len = (int)(p - data->SearchBuffer);
6723:     }
6724:     // Return request if any
6725:     if (buffer_len == 0)
6726:         return NULL;
6727:     if (select_request)
6728:     {
6729:         data->FocusScope = g.NavFocusScopeId;
6730:         data->LastRequestFrame = g.FrameCount;
6731:         data->LastRequestTime = (float)g.Time;
6732:     }
6733:     out_request->Flags = flags;
6734:     out_request->SearchBufferLen = buffer_len;
6735:     out_request->SearchBuffer = data->SearchBuffer;
6736:     out_request->SelectRequest = (data->LastRequestFrame == g.FrameCount);
6737:     out_request->SingleCharMode = false;
6738:     out_request->SingleCharSize = 0;
6739:     // Calculate if buffer contains the same character repeated.
6740:     // - This can be used to implement a special search mode on first character.
6741:     // - Performed on UTF-8 codepoint for correctness.
6742:     // - SingleCharMode is always set for first input character, because it usually leads to a "next".
6743:     if (flags & ImGuiTypingSelectFlags_AllowSingleCharMode)
6744:     {
6745:         const char* buf_begin = out_request->SearchBuffer;
6746:         const char* buf_end = out_request->SearchBuffer + out_request->SearchBufferLen;
6747:         const int c0_len = ImTextCountUtf8BytesFromChar(buf_begin, buf_end);
6748:         const char* p = buf_begin + c0_len;
6749:         for (; p < buf_end; p += c0_len)
6750:             if (memcmp(buf_begin, p, (size_t)c0_len) != 0)
6751:                 break;
6752:         const int single_char_count = (p == buf_end) ? (out_request->SearchBufferLen / c0_len) : 0;
6753:         out_request->SingleCharMode = (single_char_count > 0 || data->SingleCharModeLock);
6754:         out_request->SingleCharSize = (ImS8)c0_len;
6755:         data->SingleCharModeLock |= (single_char_count >= TYPING_SELECT_SINGLE_CHAR_COUNT_FOR_LOCK); // From now on we stop search matching to lock to single char mode.
6756:     }
6757:     return out_request;
6758: }
6759: static int ImStrimatchlen(const char* s1, const char* s1_end, const char* s2)
6760: {
6761:     int match_len = 0;
6762:     while (s1 < s1_end && ImToUpper(*s1++) == ImToUpper(*s2++))
6763:         match_len++;
6764:     return match_len;
6765: }
6766: // Default handler for finding a result for typing-select. You may implement your own.
6767: // You might want to display a tooltip to visualize the current request SearchBuffer
6768: // When SingleCharMode is set:
6769: // - it is better to NOT display a tooltip of other on-screen display indicator.
6770: // - the index of the currently focused item is required.
6771: //   if your SetNextItemSelectionUserData() values are indices, you can obtain it from ImGuiMultiSelectIO::NavIdItem, otherwise from g.NavLastValidSelectionUserData.
6772: int ImGui::TypingSelectFindMatch(ImGuiTypingSelectRequest* req, int items_count, const char* (*get_item_name_func)(void*, int), void* user_data, int nav_item_idx)
6773: {
6774:     if (req == NULL || req->SelectRequest == false) // Support NULL parameter so both calls can be done from same spot.
6775:         return -1;
6776:     int idx = -1;
6777:     if (req->SingleCharMode && (req->Flags & ImGuiTypingSelectFlags_AllowSingleCharMode))
6778:         idx = TypingSelectFindNextSingleCharMatch(req, items_count, get_item_name_func, user_data, nav_item_idx);
6779:     else
6780:         idx = TypingSelectFindBestLeadingMatch(req, items_count, get_item_name_func, user_data);
6781:     if (idx != -1)
6782:         SetNavCursorVisibleAfterMove();
6783:     return idx;
6784: }
6785: // Special handling when a single character is repeated: perform search on a single letter and goes to next.
6786: int ImGui::TypingSelectFindNextSingleCharMatch(ImGuiTypingSelectRequest* req, int items_count, const char* (*get_item_name_func)(void*, int), void* user_data, int nav_item_idx)
6787: {
6788:     // FIXME: Assume selection user data is index. Would be extremely practical.
6789:     //if (nav_item_idx == -1)
6790:     //    nav_item_idx = (int)g.NavLastValidSelectionUserData;
6791:     int first_match_idx = -1;
6792:     bool return_next_match = false;
6793:     for (int idx = 0; idx < items_count; idx++)
6794:     {
6795:         const char* item_name = get_item_name_func(user_data, idx);
6796:         if (ImStrimatchlen(req->SearchBuffer, req->SearchBuffer + req->SingleCharSize, item_name) < req->SingleCharSize)
6797:             continue;
6798:         if (return_next_match)                           // Return next matching item after current item.
6799:             return idx;
6800:         if (first_match_idx == -1 && nav_item_idx == -1) // Return first match immediately if we don't have a nav_item_idx value.
6801:             return idx;
6802:         if (first_match_idx == -1)                       // Record first match for wrapping.
6803:             first_match_idx = idx;
6804:         if (nav_item_idx == idx)                         // Record that we encountering nav_item so we can return next match.
6805:             return_next_match = true;
6806:     }
6807:     return first_match_idx; // First result
6808: }
6809: int ImGui::TypingSelectFindBestLeadingMatch(ImGuiTypingSelectRequest* req, int items_count, const char* (*get_item_name_func)(void*, int), void* user_data)
6810: {
6811:     int longest_match_idx = -1;
6812:     int longest_match_len = 0;
6813:     for (int idx = 0; idx < items_count; idx++)
6814:     {
6815:         const char* item_name = get_item_name_func(user_data, idx);
6816:         const int match_len = ImStrimatchlen(req->SearchBuffer, req->SearchBuffer + req->SearchBufferLen, item_name);
6817:         if (match_len <= longest_match_len)
6818:             continue;
6819:         longest_match_idx = idx;
6820:         longest_match_len = match_len;
6821:         if (match_len == req->SearchBufferLen)
6822:             break;
6823:     }
6824:     return longest_match_idx;
6825: }
