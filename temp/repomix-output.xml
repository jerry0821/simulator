247: 	float u0 = px / tw;
248: 	float v0 = py / th;
249: 	float u1 = (px + pw) / tw;
250: 	float v1 = (py + ph) / th;
251: 	v[0].uv = { u0, v0 };
252: 	v[1].uv = { u1, v0 };
253: 	v[2].uv = { u0, v1 };
254: 	v[3].uv = { u1, v1 };
255: 	// 頂点バッファのロックを解除
256: 	g_pContext->Unmap(g_pVertexBuffer, 0);
257: 	// 回転行列をシェーダーに設定
258: 	XMMATRIX scale		 = XMMatrixScaling(dw, dh, 1.0f); // 先にscale
259: 	XMMATRIX rotation	 = XMMatrixRotationZ(angle);
260: 	// XMMATRIX translation = XMMatrixTranslation(dx + dw * 0.5, dy + dh * 0.5, 0.0f);
261: 	XMMATRIX translation = XMMatrixTranslation(dx, dy, 0.0f);
262: 	Shader_SetWorldMatrix(scale * rotation * translation);
263: 	// 頂点バッファを描画パイプラインに設定
264: 	UINT stride = sizeof(Vertex);
265: 	UINT offset = 0;
266: 	g_pContext->IASetVertexBuffers(0, 1, &g_pVertexBuffer, &stride, &offset);
267: 	// プリミティブトポロジ設定
268: 	g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
269: 	// テクスチャの設定
270: 	Texture_SetTexture(texid);
271: 	// ポリゴン描画命令発行
272: 	g_pContext->Draw(NUM_VERTEX, 0);
273: }
274: void Sprite_Draw(float dx, float dy, float dw, float dh, const DirectX::XMFLOAT4& color)
275: {
276: 	// シェーダーを描画パイプラインに設定
277: 	Shader_Begin();
278: 	// 頂点バッファをロックする
279: 	D3D11_MAPPED_SUBRESOURCE msr;
280: 	g_pContext->Map(g_pVertexBuffer, 0, D3D11_MAP_WRITE_DISCARD, 0, &msr);
281: 	// 頂点バッファへの仮想ポインタを取得
282: 	Vertex* v = (Vertex*)msr.pData;
283: 	// 画面の左上から右下に向かう線分を描画する -> 時計回り
284: 	v[0].position = { dx,		dy,		 0.0f };	// LT
285: 	v[1].position = { dx + dw,  dy,		 0.0f };	// RT
286: 	v[2].position = { dx,		dy + dh, 0.0f };	// LB
287: 	v[3].position = { dx + dw,  dy + dh, 0.0f };	// RB
288: 	v[0].color = color;
289: 	v[1].color = color;
290: 	v[2].color = color;
291: 	v[3].color = color;
292: 	v[0].uv = { 0.0f, 0.0f };
293: 	v[1].uv = { 1.0f, 0.0f };
294: 	v[2].uv = { 0.0f, 1.0f };
295: 	v[3].uv = { 1.0f, 1.0f };
296: 	// 頂点バッファのロックを解除
297: 	g_pContext->Unmap(g_pVertexBuffer, 0);
298: 	// ワールド変換行列を設定
299: 	Shader_SetWorldMatrix(XMMatrixIdentity());
300: 	// 頂点バッファを描画パイプラインに設定
301: 	UINT stride = sizeof(Vertex);
302: 	UINT offset = 0;
303: 	g_pContext->IASetVertexBuffers(0, 1, &g_pVertexBuffer, &stride, &offset);
304: 	// プリミティブトポロジ設定
305: 	g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
306: 	// テクスチャの設定
307: 	//Texture_SetTexture(texid);
308: 	// ポリゴン描画命令発行
309: 	g_pContext->Draw(NUM_VERTEX, 0);
310: }
311: void Sprite_DrawSRV(ID3D11ShaderResourceView* pSRV, float dx, float dy, float dw, float dh)
312: {
313: 	// シェーダーを描画パイプラインに設定
314: 	Shader_Begin();
315: 	// 頂点バッファをロックする
316: 	D3D11_MAPPED_SUBRESOURCE msr;
317: 	g_pContext->Map(g_pVertexBuffer, 0, D3D11_MAP_WRITE_DISCARD, 0, &msr);
318: 	// 頂点バッファへの仮想ポインタを取得
319: 	Vertex* v = (Vertex*)msr.pData;
320: 	// 画面の左上から右下に向かう線分を描画する -> 時計回り
321: 	v[0].position = { dx,		dy,		 0.0f };	// LT
322: 	v[1].position = { dx + dw,  dy,		 0.0f };	// RT
323: 	v[2].position = { dx,		dy + dh, 0.0f };	// LB
324: 	v[3].position = { dx + dw,  dy + dh, 0.0f };	// RB
325: 	v[0].uv = { 0.0f, 0.0f };
326: 	v[1].uv = { 1.0f, 0.0f };
327: 	v[2].uv = { 0.0f, 1.0f };
328: 	v[3].uv = { 1.0f, 1.0f };
329: 	v[0].color = { 1.0f, 1.0f, 1.0f, 1.0f };
330: 	v[1].color = { 1.0f, 1.0f, 1.0f, 1.0f };
331: 	v[2].color = { 1.0f, 1.0f, 1.0f, 1.0f };
332: 	v[3].color = { 1.0f, 1.0f, 1.0f, 1.0f };
333: 	// 頂点バッファのロックを解除
334: 	g_pContext->Unmap(g_pVertexBuffer, 0);
335: 	// ワールド変換行列を設定
336: 	Shader_SetWorldMatrix(XMMatrixIdentity());
337: 	// 頂点バッファを描画パイプラインに設定
338: 	UINT stride = sizeof(Vertex);
339: 	UINT offset = 0;
340: 	g_pContext->IASetVertexBuffers(0, 1, &g_pVertexBuffer, &stride, &offset);
341: 	// プリミティブトポロジ設定
342: 	g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
343: 	// srvの設定
344: 	if (pSRV)
345: 	{
346: 		Direct3D_GetContext()->PSSetShaderResources(0, 1, &pSRV);
347: 	}
348: 	// ポリゴン描画命令発行
349: 	g_pContext->Draw(NUM_VERTEX, 0);
350: }
