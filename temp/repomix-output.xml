11837:                 NavProcessItemForTabbingRequest(id, item_flags, g.NavMoveFlags);
11838:             }
11839:             else if (g.NavId != id || (g.NavMoveFlags & ImGuiNavMoveFlags_AllowCurrentNavId))
11840:             {
11841:                 ImGuiNavItemData* result = (window == g.NavWindow) ? &g.NavMoveResultLocal : &g.NavMoveResultOther;
11842:                 if (NavScoreItem(result, nav_bb))
11843:                     NavApplyItemToResult(result);
11844:                 // Features like PageUp/PageDown need to maintain a separate score for the visible set of items.
11845:                 const float VISIBLE_RATIO = 0.70f;
11846:                 if (g.NavMoveFlags & ImGuiNavMoveFlags_AlsoScoreVisibleSet)
11847:                 {
11848:                     const ImRect& r = window->InnerRect; // window->ClipRect
11849:                     if (r.Overlaps(nav_bb))
11850:                         if (ImClamp(nav_bb.Max.y, r.Min.y, r.Max.y) - ImClamp(nav_bb.Min.y, r.Min.y, r.Max.y) >= (nav_bb.Max.y - nav_bb.Min.y) * VISIBLE_RATIO)
11851:                             if (NavScoreItem(&g.NavMoveResultLocalVisible, nav_bb))
11852:                                 NavApplyItemToResult(&g.NavMoveResultLocalVisible);
11853:                 }
11854:             }
11855:         }
11856:     }
11857:     // Update information for currently focused/navigated item
11858:     if (g.NavId == id)
11859:     {
11860:         if (g.NavWindow != window)
