13094: // When this returns true you need to: a) call SetDragDropPayload() exactly once, b) you may render the payload visual/description, c) call EndDragDropSource()
13095: // If the item has an identifier:
13096: // - This assume/require the item to be activated (typically via ButtonBehavior).
13097: // - Therefore if you want to use this with a mouse button other than left mouse button, it is up to the item itself to activate with another button.
13098: // - We then pull and use the mouse button that was used to activate the item and use it to carry on the drag.
13099: // If the item has no identifier:
13100: // - Currently always assume left mouse button.
13101: bool ImGui::BeginDragDropSource(ImGuiDragDropFlags flags)
13102: {
13103:     ImGuiContext& g = *GImGui;
13104:     ImGuiWindow* window = g.CurrentWindow;
13105:     // FIXME-DRAGDROP: While in the common-most "drag from non-zero active id" case we can tell the mouse button,
13106:     // in both SourceExtern and id==0 cases we may requires something else (explicit flags or some heuristic).
13107:     ImGuiMouseButton mouse_button = ImGuiMouseButton_Left;
13108:     bool source_drag_active = false;
13109:     ImGuiID source_id = 0;
13110:     ImGuiID source_parent_id = 0;
13111:     if ((flags & ImGuiDragDropFlags_SourceExtern) == 0)
13112:     {
13113:         source_id = g.LastItemData.ID;
13114:         if (source_id != 0)
13115:         {
13116:             // Common path: items with ID
13117:             if (g.ActiveId != source_id)
13118:                 return false;
13119:             if (g.ActiveIdMouseButton != -1)
13120:                 mouse_button = g.ActiveIdMouseButton;
13121:             if (g.IO.MouseDown[mouse_button] == false || window->SkipItems)
13122:                 return false;
13123:             g.ActiveIdAllowOverlap = false;
13124:         }
13125:         else
13126:         {
13127:             // Uncommon path: items without ID
13128:             if (g.IO.MouseDown[mouse_button] == false || window->SkipItems)
13129:                 return false;
13130:             if ((g.LastItemData.StatusFlags & ImGuiItemStatusFlags_HoveredRect) == 0 && (g.ActiveId == 0 || g.ActiveIdWindow != window))
13131:                 return false;
13132:             // If you want to use BeginDragDropSource() on an item with no unique identifier for interaction, such as Text() or Image(), you need to:
13133:             // A) Read the explanation below, B) Use the ImGuiDragDropFlags_SourceAllowNullID flag.
13134:             if (!(flags & ImGuiDragDropFlags_SourceAllowNullID))
13135:             {
13136:                 IM_ASSERT(0);
13137:                 return false;
13138:             }
13139:             // Magic fallback to handle items with no assigned ID, e.g. Text(), Image()
13140:             // We build a throwaway ID based on current ID stack + relative AABB of items in window.
13141:             // THE IDENTIFIER WON'T SURVIVE ANY REPOSITIONING/RESIZINGG OF THE WIDGET, so if your widget moves your dragging operation will be canceled.
13142:             // We don't need to maintain/call ClearActiveID() as releasing the button will early out this function and trigger !ActiveIdIsAlive.
13143:             // Rely on keeping other window->LastItemXXX fields intact.
13144:             source_id = g.LastItemData.ID = window->GetIDFromRectangle(g.LastItemData.Rect);
13145:             KeepAliveID(source_id);
13146:             bool is_hovered = ItemHoverable(g.LastItemData.Rect, source_id, g.LastItemData.ItemFlags);
13147:             if (is_hovered && g.IO.MouseClicked[mouse_button])
13148:             {
13149:                 SetActiveID(source_id, window);
13150:                 FocusWindow(window);
13151:             }
13152:             if (g.ActiveId == source_id) // Allow the underlying widget to display/return hovered during the mouse release frame, else we would get a flicker.
13153:                 g.ActiveIdAllowOverlap = is_hovered;
13154:         }
13155:         if (g.ActiveId != source_id)
13156:             return false;
13157:         source_parent_id = window->IDStack.back();
13158:         source_drag_active = IsMouseDragging(mouse_button);
13159:         // Disable navigation and key inputs while dragging + cancel existing request if any
13160:         SetActiveIdUsingAllKeyboardKeys();
13161:     }
13162:     else
13163:     {
13164:         // When ImGuiDragDropFlags_SourceExtern is set:
13165:         window = NULL;
13166:         source_id = ImHashStr("#SourceExtern");
13167:         source_drag_active = true;
13168:         mouse_button = g.IO.MouseDown[0] ? 0 : -1;
13169:         KeepAliveID(source_id);
13170:         SetActiveID(source_id, NULL);
13171:     }
13172:     IM_ASSERT(g.DragDropWithinTarget == false); // Can't nest BeginDragDropSource() and BeginDragDropTarget()
13173:     if (!source_drag_active)
13174:         return false;
13175:     // Activate drag and drop
13176:     if (!g.DragDropActive)
13177:     {
13178:         IM_ASSERT(source_id != 0);
13179:         ClearDragDrop();
13180:         IMGUI_DEBUG_LOG_ACTIVEID("[dragdrop] BeginDragDropSource() DragDropActive = true, source_id = 0x%08X%s\n",
13181:             source_id, (flags & ImGuiDragDropFlags_SourceExtern) ? " (EXTERN)" : "");
13182:         ImGuiPayload& payload = g.DragDropPayload;
13183:         payload.SourceId = source_id;
13184:         payload.SourceParentId = source_parent_id;
13185:         g.DragDropActive = true;
13186:         g.DragDropSourceFlags = flags;
13187:         g.DragDropMouseButton = mouse_button;
13188:         if (payload.SourceId == g.ActiveId)
13189:             g.ActiveIdNoClearOnFocusLoss = true;
13190:     }
13191:     g.DragDropSourceFrameCount = g.FrameCount;
13192:     g.DragDropWithinSource = true;
13193:     if (!(flags & ImGuiDragDropFlags_SourceNoPreviewTooltip))
13194:     {
13195:         // Target can request the Source to not display its tooltip (we use a dedicated flag to make this request explicit)
13196:         // We unfortunately can't just modify the source flags and skip the call to BeginTooltip, as caller may be emitting contents.
13197:         bool ret;
13198:         if (g.DragDropAcceptIdPrev && (g.DragDropAcceptFlagsPrev & ImGuiDragDropFlags_AcceptNoPreviewTooltip))
13199:             ret = BeginTooltipHidden();
13200:         else
13201:             ret = BeginTooltip();
13202:         IM_ASSERT(ret); // FIXME-NEWBEGIN: If this ever becomes false, we need to Begin("##Hidden", NULL, ImGuiWindowFlags_NoSavedSettings) + SetWindowHiddenAndSkipItemsForCurrentFrame().
13203:         IM_UNUSED(ret);
13204:     }
13205:     if (!(flags & ImGuiDragDropFlags_SourceNoDisableHover) && !(flags & ImGuiDragDropFlags_SourceExtern))
13206:         g.LastItemData.StatusFlags &= ~ImGuiItemStatusFlags_HoveredRect;
13207:     return true;
13208: }
13209: void ImGui::EndDragDropSource()
13210: {
13211:     ImGuiContext& g = *GImGui;
13212:     IM_ASSERT(g.DragDropActive);
13213:     IM_ASSERT(g.DragDropWithinSource && "Not after a BeginDragDropSource()?");
13214:     if (!(g.DragDropSourceFlags & ImGuiDragDropFlags_SourceNoPreviewTooltip))
13215:         EndTooltip();
13216:     // Discard the drag if have not called SetDragDropPayload()
13217:     if (g.DragDropPayload.DataFrameCount == -1)
13218:         ClearDragDrop();
13219:     g.DragDropWithinSource = false;
13220: }
13221: // Use 'cond' to choose to submit payload on drag start or every frame
13222: bool ImGui::SetDragDropPayload(const char* type, const void* data, size_t data_size, ImGuiCond cond)
13223: {
13224:     ImGuiContext& g = *GImGui;
13225:     ImGuiPayload& payload = g.DragDropPayload;
13226:     if (cond == 0)
13227:         cond = ImGuiCond_Always;
13228:     IM_ASSERT(type != NULL);
13229:     IM_ASSERT(ImStrlen(type) < IM_ARRAYSIZE(payload.DataType) && "Payload type can be at most 32 characters long");
13230:     IM_ASSERT((data != NULL && data_size > 0) || (data == NULL && data_size == 0));
13231:     IM_ASSERT(cond == ImGuiCond_Always || cond == ImGuiCond_Once);
13232:     IM_ASSERT(payload.SourceId != 0); // Not called between BeginDragDropSource() and EndDragDropSource()
13233:     if (cond == ImGuiCond_Always || payload.DataFrameCount == -1)
13234:     {
13235:         // Copy payload
13236:         ImStrncpy(payload.DataType, type, IM_ARRAYSIZE(payload.DataType));
13237:         g.DragDropPayloadBufHeap.resize(0);
13238:         if (data_size > sizeof(g.DragDropPayloadBufLocal))
13239:         {
13240:             // Store in heap
13241:             g.DragDropPayloadBufHeap.resize((int)data_size);
13242:             payload.Data = g.DragDropPayloadBufHeap.Data;
13243:             memcpy(payload.Data, data, data_size);
13244:         }
13245:         else if (data_size > 0)
13246:         {
13247:             // Store locally
13248:             memset(&g.DragDropPayloadBufLocal, 0, sizeof(g.DragDropPayloadBufLocal));
13249:             payload.Data = g.DragDropPayloadBufLocal;
13250:             memcpy(payload.Data, data, data_size);
13251:         }
13252:         else
13253:         {
13254:             payload.Data = NULL;
13255:         }
13256:         payload.DataSize = (int)data_size;
13257:     }
13258:     payload.DataFrameCount = g.FrameCount;
13259:     // Return whether the payload has been accepted
13260:     return (g.DragDropAcceptFrameCount == g.FrameCount) || (g.DragDropAcceptFrameCount == g.FrameCount - 1);
13261: }
