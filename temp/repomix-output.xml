8596:     g.CurrentTabBarStack.push_back(GetTabBarRefFromTabBar(tab_bar));
8597:     g.CurrentTabBar = tab_bar;
8598:     tab_bar->Window = window;
8599:     // Append with multiple BeginTabBar()/EndTabBar() pairs.
8600:     tab_bar->BackupCursorPos = window->DC.CursorPos;
8601:     if (tab_bar->CurrFrameVisible == g.FrameCount)
8602:     {
8603:         window->DC.CursorPos = ImVec2(tab_bar->BarRect.Min.x, tab_bar->BarRect.Max.y + tab_bar->ItemSpacingY);
8604:         tab_bar->BeginCount++;
8605:         return true;
8606:     }
8607:     // Ensure correct ordering when toggling ImGuiTabBarFlags_Reorderable flag, or when a new tab was added while being not reorderable
8608:     if ((flags & ImGuiTabBarFlags_Reorderable) != (tab_bar->Flags & ImGuiTabBarFlags_Reorderable) || (tab_bar->TabsAddedNew && !(flags & ImGuiTabBarFlags_Reorderable)))
