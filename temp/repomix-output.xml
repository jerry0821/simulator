4787:     ImFontBaked* baked = *p_baked_in_map;
4788:     if (baked != NULL)
4789:     {
4790:         IM_ASSERT(baked->Size == font_size && baked->OwnerFont == font && baked->BakedId == baked_id);
4791:         return baked;
4792:     }
4793:     // If atlas is locked, find closest match
4794:     // FIXME-OPT: This is not an optimal query.
4795:     if ((font->Flags & ImFontFlags_LockBakedSizes) || atlas->Locked)
4796:     {
4797:         baked = ImFontAtlasBakedGetClosestMatch(atlas, font, font_size, font_rasterizer_density);
4798:         if (baked != NULL)
4799:             return baked;
4800:         if (atlas->Locked)
4801:         {
4802:             IM_ASSERT(!atlas->Locked && "Cannot use dynamic font size with a locked ImFontAtlas!"); // Locked because rendering backend does not support ImGuiBackendFlags_RendererHasTextures!
4803:             return NULL;
4804:         }
4805:     }
4806:     // Create new
4807:     baked = ImFontAtlasBakedAdd(atlas, font, font_size, font_rasterizer_density, baked_id);
4808:     *p_baked_in_map = baked; // To avoid 'builder->BakedMap.SetVoidPtr(baked_id, baked);' while we can.
4809:     return baked;
4810: }
4811: // Trim trailing space and find beginning of next line
4812: const char* ImTextCalcWordWrapNextLineStart(const char* text, const char* text_end, ImDrawTextFlags flags)
4813: {
4814:     if ((flags & ImDrawTextFlags_WrapKeepBlanks) == 0)
4815:         while (text < text_end && ImCharIsBlankA(*text))
4816:             text++;
4817:     if (text < text_end && *text == '\n')
4818:         text++;
4819:     return text;
4820: }
4821: // Simple word-wrapping for English, not full-featured. Please submit failing cases!
4822: // This will return the next location to wrap from. If no wrapping if necessary, this will fast-forward to e.g. text_end.
4823: // FIXME: Much possible improvements (don't cut things like "word !", "word!!!" but cut within "word,,,,", more sensible support for punctuations, support for Unicode punctuations, etc.)
4824: const char* ImFontCalcWordWrapPositionEx(ImFont* font, float size, const char* text, const char* text_end, float wrap_width, ImDrawTextFlags flags)
4825: {
4826:     // For references, possible wrap point marked with ^
4827:     //  "aaa bbb, ccc,ddd. eee   fff. ggg!"
4828:     //      ^    ^    ^   ^   ^__    ^    ^
4829:     // List of hardcoded separators: .,;!?'"
4830:     // Skip extra blanks after a line returns (that includes not counting them in width computation)
4831:     // e.g. "Hello    world" --> "Hello" "World"
4832:     // Cut words that cannot possibly fit within one line.
4833:     // e.g.: "The tropical fish" with ~5 characters worth of width --> "The tr" "opical" "fish"
4834:     ImFontBaked* baked = font->GetFontBaked(size);
4835:     const float scale = size / baked->Size;
4836:     float line_width = 0.0f;
4837:     float word_width = 0.0f;
4838:     float blank_width = 0.0f;
4839:     wrap_width /= scale; // We work with unscaled widths to avoid scaling every characters
4840:     const char* word_end = text;
4841:     const char* prev_word_end = NULL;
4842:     bool inside_word = true;
4843:     const char* s = text;
4844:     IM_ASSERT(text_end != NULL);
4845:     while (s < text_end)
4846:     {
4847:         unsigned int c = (unsigned int)*s;
4848:         const char* next_s;
4849:         if (c < 0x80)
4850:             next_s = s + 1;
4851:         else
4852:             next_s = s + ImTextCharFromUtf8(&c, s, text_end);
4853:         if (c < 32)
4854:         {
4855:             if (c == '\n')
4856:                 return s; // Direct return, skip "Wrap_width is too small to fit anything" path.
4857:             if (c == '\r')
4858:             {
4859:                 s = next_s;
4860:                 continue;
4861:             }
4862:         }
4863:         // Optimized inline version of 'float char_width = GetCharAdvance((ImWchar)c);'
4864:         float char_width = (c < (unsigned int)baked->IndexAdvanceX.Size) ? baked->IndexAdvanceX.Data[c] : -1.0f;
4865:         if (char_width < 0.0f)
4866:             char_width = BuildLoadGlyphGetAdvanceOrFallback(baked, c);
4867:         if (ImCharIsBlankW(c))
4868:         {
4869:             if (inside_word)
4870:             {
4871:                 line_width += blank_width;
4872:                 blank_width = 0.0f;
4873:                 word_end = s;
4874:             }
4875:             blank_width += char_width;
4876:             inside_word = false;
4877:         }
4878:         else
4879:         {
4880:             word_width += char_width;
4881:             if (inside_word)
4882:             {
4883:                 word_end = next_s;
4884:             }
4885:             else
4886:             {
4887:                 prev_word_end = word_end;
4888:                 line_width += word_width + blank_width;
4889:                 if ((flags & ImDrawTextFlags_WrapKeepBlanks) && line_width <= wrap_width)
4890:                     prev_word_end = s;
4891:                 word_width = blank_width = 0.0f;
4892:             }
4893:             // Allow wrapping after punctuation.
4894:             inside_word = (c != '.' && c != ',' && c != ';' && c != '!' && c != '?' && c != '\"' && c != 0x3001 && c != 0x3002);
4895:         }
4896:         // We ignore blank width at the end of the line (they can be skipped)
4897:         if (line_width + word_width > wrap_width)
4898:         {
4899:             // Words that cannot possibly fit within an entire line will be cut anywhere.
4900:             if (word_width < wrap_width)
4901:                 s = prev_word_end ? prev_word_end : word_end;
4902:             break;
4903:         }
4904:         s = next_s;
4905:     }
4906:     // Wrap_width is too small to fit anything. Force displaying 1 character to minimize the height discontinuity.
4907:     // +1 may not be a character start point in UTF-8 but it's ok because caller loops use (text >= word_wrap_eol).
4908:     if (s == text && text < text_end)
4909:         return s + ImTextCountUtf8BytesFromChar(s, text_end);
4910:     return s;
4911: }
4912: const char* ImFont::CalcWordWrapPosition(float size, const char* text, const char* text_end, float wrap_width)
4913: {
4914:     return ImFontCalcWordWrapPositionEx(this, size, text, text_end, wrap_width, ImDrawTextFlags_None);
4915: }
4916: ImVec2 ImFontCalcTextSizeEx(ImFont* font, float size, float max_width, float wrap_width, const char* text_begin, const char* text_end_display, const char* text_end, const char** out_remaining, ImVec2* out_offset, ImDrawTextFlags flags)
4917: {
4918:     if (!text_end)
4919:         text_end = text_begin + ImStrlen(text_begin); // FIXME-OPT: Need to avoid this.
4920:     if (!text_end_display)
4921:         text_end_display = text_end;
4922:     ImFontBaked* baked = font->GetFontBaked(size);
4923:     const float line_height = size;
4924:     const float scale = line_height / baked->Size;
4925:     ImVec2 text_size = ImVec2(0, 0);
4926:     float line_width = 0.0f;
4927:     const bool word_wrap_enabled = (wrap_width > 0.0f);
4928:     const char* word_wrap_eol = NULL;
4929:     const char* s = text_begin;
4930:     while (s < text_end_display)
4931:     {
4932:         // Word-wrapping
4933:         if (word_wrap_enabled)
4934:         {
4935:             // Calculate how far we can render. Requires two passes on the string data but keeps the code simple and not intrusive for what's essentially an uncommon feature.
4936:             if (!word_wrap_eol)
4937:                 word_wrap_eol = ImFontCalcWordWrapPositionEx(font, size, s, text_end, wrap_width - line_width, flags);
4938:             if (s >= word_wrap_eol)
4939:             {
4940:                 if (text_size.x < line_width)
4941:                     text_size.x = line_width;
4942:                 text_size.y += line_height;
4943:                 line_width = 0.0f;
4944:                 s = ImTextCalcWordWrapNextLineStart(s, text_end, flags); // Wrapping skips upcoming blanks
4945:                 if (flags & ImDrawTextFlags_StopOnNewLine)
4946:                     break;
4947:                 word_wrap_eol = NULL;
4948:                 continue;
4949:             }
4950:         }
4951:         // Decode and advance source
4952:         const char* prev_s = s;
4953:         unsigned int c = (unsigned int)*s;
4954:         if (c < 0x80)
4955:             s += 1;
4956:         else
4957:             s += ImTextCharFromUtf8(&c, s, text_end);
4958:         if (c == '\n')
4959:         {
4960:             text_size.x = ImMax(text_size.x, line_width);
4961:             text_size.y += line_height;
4962:             line_width = 0.0f;
4963:             if (flags & ImDrawTextFlags_StopOnNewLine)
4964:                 break;
4965:             continue;
4966:         }
4967:         if (c == '\r')
4968:             continue;
4969:         // Optimized inline version of 'float char_width = GetCharAdvance((ImWchar)c);'
4970:         float char_width = (c < (unsigned int)baked->IndexAdvanceX.Size) ? baked->IndexAdvanceX.Data[c] : -1.0f;
4971:         if (char_width < 0.0f)
4972:             char_width = BuildLoadGlyphGetAdvanceOrFallback(baked, c);
4973:         char_width *= scale;
4974:         if (line_width + char_width >= max_width)
4975:         {
4976:             s = prev_s;
4977:             break;
4978:         }
4979:         line_width += char_width;
4980:     }
4981:     if (text_size.x < line_width)
4982:         text_size.x = line_width;
4983:     if (out_offset != NULL)
4984:         *out_offset = ImVec2(line_width, text_size.y + line_height);  // offset allow for the possibility of sitting after a trailing \n
4985:     if (line_width > 0 || text_size.y == 0.0f)                        // whereas size.y will ignore the trailing \n
4986:         text_size.y += line_height;
4987:     if (out_remaining != NULL)
4988:         *out_remaining = s;
4989:     return text_size;
4990: }
4991: ImVec2 ImFont::CalcTextSizeA(float size, float max_width, float wrap_width, const char* text_begin, const char* text_end, const char** out_remaining)
4992: {
4993:     return ImFontCalcTextSizeEx(this, size, max_width, wrap_width, text_begin, text_end, text_end, out_remaining, NULL, ImDrawTextFlags_None);
4994: }
4995: // Note: as with every ImDrawList drawing function, this expects that the font atlas texture is bound.
4996: void ImFont::RenderChar(ImDrawList* draw_list, float size, const ImVec2& pos, ImU32 col, ImWchar c, const ImVec4* cpu_fine_clip)
4997: {
4998:     ImFontBaked* baked = GetFontBaked(size);
4999:     const ImFontGlyph* glyph = baked->FindGlyph(c);
5000:     if (!glyph || !glyph->Visible)
5001:         return;
5002:     if (glyph->Colored)
5003:         col |= ~IM_COL32_A_MASK;
5004:     float scale = (size >= 0.0f) ? (size / baked->Size) : 1.0f;
5005:     float x = IM_TRUNC(pos.x);
5006:     float y = IM_TRUNC(pos.y);
5007:     float x1 = x + glyph->X0 * scale;
5008:     float x2 = x + glyph->X1 * scale;
5009:     if (cpu_fine_clip && (x1 > cpu_fine_clip->z || x2 < cpu_fine_clip->x))
5010:         return;
5011:     float y1 = y + glyph->Y0 * scale;
5012:     float y2 = y + glyph->Y1 * scale;
5013:     float u1 = glyph->U0;
5014:     float v1 = glyph->V0;
5015:     float u2 = glyph->U1;
5016:     float v2 = glyph->V1;
5017:     // Always CPU fine clip. Code extracted from RenderText().
5018:     // CPU side clipping used to fit text in their frame when the frame is too small. Only does clipping for axis aligned quads.
5019:     if (cpu_fine_clip != NULL)
5020:     {
5021:         if (x1 < cpu_fine_clip->x) { u1 = u1 + (1.0f - (x2 - cpu_fine_clip->x) / (x2 - x1)) * (u2 - u1); x1 = cpu_fine_clip->x; }
5022:         if (y1 < cpu_fine_clip->y) { v1 = v1 + (1.0f - (y2 - cpu_fine_clip->y) / (y2 - y1)) * (v2 - v1); y1 = cpu_fine_clip->y; }
5023:         if (x2 > cpu_fine_clip->z) { u2 = u1 + ((cpu_fine_clip->z - x1) / (x2 - x1)) * (u2 - u1); x2 = cpu_fine_clip->z; }
5024:         if (y2 > cpu_fine_clip->w) { v2 = v1 + ((cpu_fine_clip->w - y1) / (y2 - y1)) * (v2 - v1); y2 = cpu_fine_clip->w; }
5025:         if (y1 >= y2)
5026:             return;
5027:     }
5028:     draw_list->PrimReserve(6, 4);
5029:     draw_list->PrimRectUV(ImVec2(x1, y1), ImVec2(x2, y2), ImVec2(u1, v1), ImVec2(u2, v2), col);
5030: }
5031: // Note: as with every ImDrawList drawing function, this expects that the font atlas texture is bound.
5032: // DO NOT CALL DIRECTLY THIS WILL CHANGE WILDLY IN 2025-2025. Use ImDrawList::AddText().
5033: void ImFont::RenderText(ImDrawList* draw_list, float size, const ImVec2& pos, ImU32 col, const ImVec4& clip_rect, const char* text_begin, const char* text_end, float wrap_width, ImDrawTextFlags flags)
5034: {
5035:     // Align to be pixel perfect
5036: begin:
5037:     float x = IM_TRUNC(pos.x);
