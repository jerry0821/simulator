1543:          if (flags & 4) {
1544:             stbtt_int16 dy = *points++;
1545:             y += (flags & 32) ? dy : -dy; // ???
1546:          } else {
1547:             if (!(flags & 32)) {
1548:                y = y + (stbtt_int16) (points[0]*256 + points[1]);
