13305: // We don't use BeginDragDropTargetCustom() and duplicate its code because:
13306: // 1) we use LastItemData's ImGuiItemStatusFlags_HoveredRect which handles items that push a temporarily clip rectangle in their code. Calling BeginDragDropTargetCustom(LastItemRect) would not handle them.
13307: // 2) and it's faster. as this code may be very frequently called, we want to early out as fast as we can.
13308: // Also note how the HoveredWindow test is positioned differently in both functions (in both functions we optimize for the cheapest early out case)
13309: bool ImGui::BeginDragDropTarget()
13310: {
13311:     ImGuiContext& g = *GImGui;
13312:     if (!g.DragDropActive)
13313:         return false;
13314:     ImGuiWindow* window = g.CurrentWindow;
13315:     if (!(g.LastItemData.StatusFlags & ImGuiItemStatusFlags_HoveredRect))
13316:         return false;
13317:     ImGuiWindow* hovered_window = g.HoveredWindowUnderMovingWindow;
13318:     if (hovered_window == NULL || window->RootWindow != hovered_window->RootWindow || window->SkipItems)
13319:         return false;
13320:     const ImRect& display_rect = (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_HasDisplayRect) ? g.LastItemData.DisplayRect : g.LastItemData.Rect;
13321:     ImGuiID id = g.LastItemData.ID;
13322:     if (id == 0)
13323:     {
13324:         id = window->GetIDFromRectangle(display_rect);
13325:         KeepAliveID(id);
13326:     }
13327:     if (g.DragDropPayload.SourceId == id)
13328:         return false;
13329:     IM_ASSERT(g.DragDropWithinTarget == false && g.DragDropWithinSource == false); // Can't nest BeginDragDropSource() and BeginDragDropTarget()
13330:     g.DragDropTargetRect = display_rect;
13331:     g.DragDropTargetClipRect = (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_HasClipRect) ? g.LastItemData.ClipRect : window->ClipRect;
13332:     g.DragDropTargetId = id;
13333:     g.DragDropWithinTarget = true;
13334:     return true;
13335: }
