11635: static float inline NavScoreItemDistInterval(float cand_min, float cand_max, float curr_min, float curr_max)
11636: {
11637:     if (cand_max < curr_min)
11638:         return cand_max - curr_min;
11639:     if (curr_max < cand_min)
11640:         return cand_min - curr_max;
11641:     return 0.0f;
