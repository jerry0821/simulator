1426: // Horizontal/vertical separating line
1427: // FIXME: Surprisingly, this seemingly trivial widget is a victim of many different legacy/tricky layout issues.
1428: // Note how thickness == 1.0f is handled specifically as not moving CursorPos by 'thickness', but other values are.
1429: void ImGui::SeparatorEx(ImGuiSeparatorFlags flags, float thickness)
1430: {
1431:     ImGuiWindow* window = GetCurrentWindow();
1432:     if (window->SkipItems)
1433:         return;
1434:     ImGuiContext& g = *GImGui;
1435:     IM_ASSERT(ImIsPowerOfTwo(flags & (ImGuiSeparatorFlags_Horizontal | ImGuiSeparatorFlags_Vertical)));   // Check that only 1 option is selected
1436:     IM_ASSERT(thickness > 0.0f);
1437:     if (flags & ImGuiSeparatorFlags_Vertical)
1438:     {
1439:         // Vertical separator, for menu bars (use current line height).
1440:         float y1 = window->DC.CursorPos.y;
1441:         float y2 = window->DC.CursorPos.y + window->DC.CurrLineSize.y;
1442:         const ImRect bb(ImVec2(window->DC.CursorPos.x, y1), ImVec2(window->DC.CursorPos.x + thickness, y2));
1443:         ItemSize(ImVec2(thickness, 0.0f));
1444:         if (!ItemAdd(bb, 0))
1445:             return;
1446:         // Draw
1447:         window->DrawList->AddRectFilled(bb.Min, bb.Max, GetColorU32(ImGuiCol_Separator));
1448:         if (g.LogEnabled)
1449:             LogText(" |");
1450:     }
1451:     else if (flags & ImGuiSeparatorFlags_Horizontal)
1452:     {
1453:         // Horizontal Separator
1454:         float x1 = window->DC.CursorPos.x;
1455:         float x2 = window->WorkRect.Max.x;
1456:         // Preserve legacy behavior inside Columns()
1457:         // Before Tables API happened, we relied on Separator() to span all columns of a Columns() set.
1458:         // We currently don't need to provide the same feature for tables because tables naturally have border features.
1459:         ImGuiOldColumns* columns = (flags & ImGuiSeparatorFlags_SpanAllColumns) ? window->DC.CurrentColumns : NULL;
1460:         if (columns)
1461:         {
1462:             x1 = window->Pos.x + window->DC.Indent.x; // Used to be Pos.x before 2023/10/03
1463:             x2 = window->Pos.x + window->Size.x;
1464:             PushColumnsBackground();
1465:         }
1466:         // We don't provide our width to the layout so that it doesn't get feed back into AutoFit
1467:         // FIXME: This prevents ->CursorMaxPos based bounding box evaluation from working (e.g. TableEndCell)
1468:         const float thickness_for_layout = (thickness == 1.0f) ? 0.0f : thickness; // FIXME: See 1.70/1.71 Separator() change: makes legacy 1-px separator not affect layout yet. Should change.
1469:         const ImRect bb(ImVec2(x1, window->DC.CursorPos.y), ImVec2(x2, window->DC.CursorPos.y + thickness));
1470:         ItemSize(ImVec2(0.0f, thickness_for_layout));
1471:         if (ItemAdd(bb, 0))
1472:         {
1473:             // Draw
1474:             window->DrawList->AddRectFilled(bb.Min, bb.Max, GetColorU32(ImGuiCol_Separator));
1475:             if (g.LogEnabled)
1476:                 LogRenderedText(&bb.Min, "--------------------------------\n");
1477:         }
1478:         if (columns)
1479:         {
1480:             PopColumnsBackground();
1481:             columns->LineMinY = window->DC.CursorPos.y;
1482:         }
1483:     }
1484: }
