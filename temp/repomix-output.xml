7688: // This is essentially a thin wrapper to using BeginChild/EndChild with the ImGuiChildFlags_FrameStyle flag for stylistic changes + displaying a label.
7689: // This handle some subtleties with capturing info from the label.
7690: // If you don't need a label you can pretty much directly use ImGui::BeginChild() with ImGuiChildFlags_FrameStyle.
7691: // Tip: To have a list filling the entire window width, use size.x = -FLT_MIN and pass an non-visible label e.g. "##empty"
7692: // Tip: If your vertical size is calculated from an item count (e.g. 10 * item_height) consider adding a fractional part to facilitate seeing scrolling boundaries (e.g. 10.5f * item_height).
7693: bool ImGui::BeginListBox(const char* label, const ImVec2& size_arg)
7694: {
7695:     ImGuiContext& g = *GImGui;
7696:     ImGuiWindow* window = GetCurrentWindow();
7697:     if (window->SkipItems)
7698:         return false;
7699:     const ImGuiStyle& style = g.Style;
7700:     const ImGuiID id = GetID(label);
7701:     const ImVec2 label_size = CalcTextSize(label, NULL, true);
7702:     // Size default to hold ~7.25 items.
7703:     // Fractional number of items helps seeing that we can scroll down/up without looking at scrollbar.
7704:     ImVec2 size = ImTrunc(CalcItemSize(size_arg, CalcItemWidth(), GetTextLineHeightWithSpacing() * 7.25f + style.FramePadding.y * 2.0f));
7705:     ImVec2 frame_size = ImVec2(size.x, ImMax(size.y, label_size.y));
7706:     ImRect frame_bb(window->DC.CursorPos, window->DC.CursorPos + frame_size);
7707:     ImRect bb(frame_bb.Min, frame_bb.Max + ImVec2(label_size.x > 0.0f ? style.ItemInnerSpacing.x + label_size.x : 0.0f, 0.0f));
7708:     g.NextItemData.ClearFlags();
7709:     if (!IsRectVisible(bb.Min, bb.Max))
7710:     {
7711:         ItemSize(bb.GetSize(), style.FramePadding.y);
7712:         ItemAdd(bb, 0, &frame_bb);
7713:         g.NextWindowData.ClearFlags(); // We behave like Begin() and need to consume those values
7714:         return false;
7715:     }
7716:     // FIXME-OPT: We could omit the BeginGroup() if label_size.x == 0.0f but would need to omit the EndGroup() as well.
7717:     BeginGroup();
7718:     if (label_size.x > 0.0f)
7719:     {
7720:         ImVec2 label_pos = ImVec2(frame_bb.Max.x + style.ItemInnerSpacing.x, frame_bb.Min.y + style.FramePadding.y);
7721:         RenderText(label_pos, label);
7722:         window->DC.CursorMaxPos = ImMax(window->DC.CursorMaxPos, label_pos + label_size);
7723:         AlignTextToFramePadding();
7724:     }
7725:     BeginChild(id, frame_bb.GetSize(), ImGuiChildFlags_FrameStyle);
7726:     return true;
7727: }
