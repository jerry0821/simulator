 9261: // Process input queue
 9262: // We always call this with the value of 'bool g.IO.ConfigInputTrickleEventQueue'.
 9263: // - trickle_fast_inputs = false : process all events, turn into flattened input state (e.g. successive down/up/down/up will be lost)
 9264: // - trickle_fast_inputs = true  : process as many events as possible (successive down/up/down/up will be trickled over several frames so nothing is lost) (new feature in 1.87)
 9265: void ImGui::UpdateInputEvents(bool trickle_fast_inputs)
 9266: {
 9267:     ImGuiContext& g = *GImGui;
 9268:     ImGuiIO& io = g.IO;
 9269:     // Only trickle chars<>key when working with InputText()
 9270:     // FIXME: InputText() could parse event trail?
 9271:     // FIXME: Could specialize chars<>keys trickling rules for control keys (those not typically associated to characters)
 9272:     const bool trickle_interleaved_nonchar_keys_and_text = (trickle_fast_inputs && g.WantTextInputNextFrame == 1);
 9273:     bool mouse_moved = false, mouse_wheeled = false, key_changed = false, key_changed_nonchar = false, text_inputted = false;
 9274:     int  mouse_button_changed = 0x00;
 9275:     ImBitArray<ImGuiKey_NamedKey_COUNT> key_changed_mask;
 9276:     int event_n = 0;
 9277:     for (; event_n < g.InputEventsQueue.Size; event_n++)
 9278:     {
 9279:         ImGuiInputEvent* e = &g.InputEventsQueue[event_n];
 9280:         if (e->Type == ImGuiInputEventType_MousePos)
 9281:         {
 9282:             if (g.IO.WantSetMousePos)
 9283:                 continue;
 9284:             // Trickling Rule: Stop processing queued events if we already handled a mouse button change
 9285:             ImVec2 event_pos(e->MousePos.PosX, e->MousePos.PosY);
 9286:             if (trickle_fast_inputs && (mouse_button_changed != 0 || mouse_wheeled || key_changed || text_inputted))
 9287:                 break;
 9288:             io.MousePos = event_pos;
 9289:             io.MouseSource = e->MousePos.MouseSource;
 9290:             mouse_moved = true;
 9291:         }
 9292:         else if (e->Type == ImGuiInputEventType_MouseButton)
 9293:         {
 9294:             // Trickling Rule: Stop processing queued events if we got multiple action on the same button
 9295:             const ImGuiMouseButton button = e->MouseButton.Button;
 9296:             IM_ASSERT(button >= 0 && button < ImGuiMouseButton_COUNT);
 9297:             if (trickle_fast_inputs && ((mouse_button_changed & (1 << button)) || mouse_wheeled))
 9298:                 break;
 9299:             if (trickle_fast_inputs && e->MouseButton.MouseSource == ImGuiMouseSource_TouchScreen && mouse_moved) // #2702: TouchScreen have no initial hover.
 9300:                 break;
 9301:             io.MouseDown[button] = e->MouseButton.Down;
 9302:             io.MouseSource = e->MouseButton.MouseSource;
 9303:             mouse_button_changed |= (1 << button);
 9304:         }
 9305:         else if (e->Type == ImGuiInputEventType_MouseWheel)
 9306:         {
 9307:             // Trickling Rule: Stop processing queued events if we got multiple action on the event
 9308:             if (trickle_fast_inputs && (mouse_moved || mouse_button_changed != 0))
 9309:                 break;
 9310:             io.MouseWheelH += e->MouseWheel.WheelX;
 9311:             io.MouseWheel += e->MouseWheel.WheelY;
 9312:             io.MouseSource = e->MouseWheel.MouseSource;
 9313:             mouse_wheeled = true;
 9314:         }
 9315:         else if (e->Type == ImGuiInputEventType_Key)
 9316:         {
 9317:             // Trickling Rule: Stop processing queued events if we got multiple action on the same button
 9318:             if (io.ConfigFlags & ImGuiConfigFlags_NoKeyboard)
 9319:                 continue;
 9320:             ImGuiKey key = e->Key.Key;
 9321:             IM_ASSERT(key != ImGuiKey_None);
 9322:             ImGuiKeyData* key_data = GetKeyData(key);
 9323:             const int key_data_index = (int)(key_data - g.IO.KeysData);
 9324:             if (trickle_fast_inputs && key_data->Down != e->Key.Down && (key_changed_mask.TestBit(key_data_index) || mouse_button_changed != 0))
 9325:                 break;
 9326:             const bool key_is_potentially_for_char_input = IsKeyChordPotentiallyCharInput(GetMergedModsFromKeys() | key);
 9327:             if (trickle_interleaved_nonchar_keys_and_text && (text_inputted && !key_is_potentially_for_char_input))
 9328:                 break;
 9329:             if (key_data->Down != e->Key.Down) // Analog change only do not trigger this, so it won't block e.g. further mouse pos events testing key_changed.
 9330:             {
 9331:                 key_changed = true;
 9332:                 key_changed_mask.SetBit(key_data_index);
 9333:                 if (trickle_interleaved_nonchar_keys_and_text && !key_is_potentially_for_char_input)
 9334:                     key_changed_nonchar = true;
 9335:             }
 9336:             key_data->Down = e->Key.Down;
 9337:             key_data->AnalogValue = e->Key.AnalogValue;
 9338:         }
 9339:         else if (e->Type == ImGuiInputEventType_Text)
 9340:         {
 9341:             if (io.ConfigFlags & ImGuiConfigFlags_NoKeyboard)
 9342:                 continue;
 9343:             // Trickling Rule: Stop processing queued events if keys/mouse have been interacted with
 9344:             if (trickle_fast_inputs && (mouse_button_changed != 0 || mouse_moved || mouse_wheeled))
 9345:                 break;
 9346:             if (trickle_interleaved_nonchar_keys_and_text && key_changed_nonchar)
 9347:                 break;
 9348:             unsigned int c = e->Text.Char;
 9349:             io.InputQueueCharacters.push_back(c <= IM_UNICODE_CODEPOINT_MAX ? (ImWchar)c : IM_UNICODE_CODEPOINT_INVALID);
