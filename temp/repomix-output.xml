11: static std::unordered_map<std::wstring, int> g_TextureCache;
12: static std::unordered_map<std::string, MODEL*> g_ModelCache;
13: namespace ResourceManager
14: {
15:     void Initialize()
16:     {
17:         g_TextureCache.clear();
18:         g_ModelCache.clear();
19:     }
20:     void Finalize()
21:     {
22:         g_TextureCache.clear();
23:         for (auto& pair : g_ModelCache) {
24:             //ModelUnload(pair.second);
25:         }
26:         g_ModelCache.clear();
27:     }
28:     int GetTexture(const std::wstring& filename)
29:     {
30:         auto it = g_TextureCache.find(filename);
31:         if (it != g_TextureCache.end()) {
32:             return it->second;
33:         }
34:         int texId = Texture_Load(filename.c_str());
35:         g_TextureCache[filename] = texId;
36:         return texId;
37:     }
38:     MODEL* GetModel(const std::string& filename, float scale)
39:     {
40:         std::string key = filename + "_" + std::to_string(scale);
41:         auto it = g_ModelCache.find(key);
42:         if (it != g_ModelCache.end()) {
43:             return it->second;
44:         }
45:         MODEL* model = ModelLoad(filename.c_str(), scale);
46:         g_ModelCache[key] = model;
47:         return model;
48:     }
49: }
