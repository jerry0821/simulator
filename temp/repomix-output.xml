 40: {
 41: 	float x = 0.0f, y = 0.0f;
 42: 	if (g_State[user_index].Gamepad.sThumbLX < 0) {
 43: 		if (g_State[user_index].Gamepad.sThumbLX < -XINPUT_GAMEPAD_LEFT_THUMB_DEADZONE){
 44: 			x = (float)g_State[user_index].Gamepad.sThumbLX / 32768.0f;
 45: 		}
 46: 		else {
 47: 			x = 0.0f;
 48: 		}
 49: 	}
 50: 	else {
 51: 		if (g_State[user_index].Gamepad.sThumbLX > XINPUT_GAMEPAD_LEFT_THUMB_DEADZONE) {
 52: 			x = (float)g_State[user_index].Gamepad.sThumbLX / 32767.0f;
 53: 		}
 54: 		else {
 55: 			x = 0.0f;
 56: 		}
 57: 	}
 58: 	if (g_State[user_index].Gamepad.sThumbLY < 0) {
 59: 		if (g_State[user_index].Gamepad.sThumbLY < -XINPUT_GAMEPAD_LEFT_THUMB_DEADZONE) {
 60: 			y = (float)g_State[user_index].Gamepad.sThumbLY / 32768.0f;
 61: 		}
 62: 		else {
 63: 			y = 0.0f;
 64: 		}
 65: 	}
 66: 	else {
 67: 		if (g_State[user_index].Gamepad.sThumbLY > XINPUT_GAMEPAD_LEFT_THUMB_DEADZONE) {
 68: 			y = (float)g_State[user_index].Gamepad.sThumbLY / 32767.0f;
 69: 		}
 70: 		else {
 71: 			y = 0.0f;
 72: 		}
 73: 	}
 74: 	if(XMVectorGetX(XMVector2LengthSq({ x,y })) > 1.0f)
 75: 	{
 76: 		XMVECTOR v = XMVector2Normalize({ x,y });
 77: 		x = XMVectorGetX(v);
 78: 		y = XMVectorGetY(v);
 79: 	}
 80: 	return { x,y };
