 309: // align_x: 0.0f = left, 0.5f = center, 1.0f = right.
 310: // size_x : 0.0f = shortcut for GetContentRegionAvail().x
 311: // FIXME-WIP: Works but API is likely to be reworked. This is designed for 1 item on the line. (#7024)
 312: void ImGui::TextAlignedV(float align_x, float size_x, const char* fmt, va_list args)
 313: {
 314:     ImGuiWindow* window = GetCurrentWindow();
 315:     if (window->SkipItems)
 316:         return;
 317:     const char* text, *text_end;
 318:     ImFormatStringToTempBufferV(&text, &text_end, fmt, args);
 319:     const ImVec2 text_size = CalcTextSize(text, text_end);
 320:     size_x = CalcItemSize(ImVec2(size_x, 0.0f), 0.0f, text_size.y).x;
 321:     ImVec2 pos(window->DC.CursorPos.x, window->DC.CursorPos.y + window->DC.CurrLineTextBaseOffset);
 322:     ImVec2 pos_max(pos.x + size_x, window->ClipRect.Max.y);
 323:     ImVec2 size(ImMin(size_x, text_size.x), text_size.y);
 324:     window->DC.CursorMaxPos.x = ImMax(window->DC.CursorMaxPos.x, pos.x + text_size.x);
 325:     window->DC.IdealMaxPos.x = ImMax(window->DC.IdealMaxPos.x, pos.x + text_size.x);
 326:     if (align_x > 0.0f && text_size.x < size_x)
 327:         pos.x += ImTrunc((size_x - text_size.x) * align_x);
 328:     RenderTextEllipsis(window->DrawList, pos, pos_max, pos_max.x, text, text_end, &text_size);
 329:     const ImVec2 backup_max_pos = window->DC.CursorMaxPos;
 330:     ItemSize(size);
 331:     ItemAdd(ImRect(pos, pos + size), 0);
 332:     window->DC.CursorMaxPos.x = backup_max_pos.x; // Cancel out extending content size because right-aligned text would otherwise mess it up.
 333:     if (size_x < text_size.x && IsItemHovered(ImGuiHoveredFlags_NoNavOverride | ImGuiHoveredFlags_AllowWhenDisabled | ImGuiHoveredFlags_ForTooltip))
 334:         SetTooltip("%.*s", (int)(text_end - text), text);
 335: }
