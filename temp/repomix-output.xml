3799: // Public API to manipulate UTF-8 text from within a callback.
3800: // FIXME: The existence of this rarely exercised code path is a bit of a nuisance.
3801: // Historically they existed because STB_TEXTEDIT_INSERTCHARS() etc. worked on our ImWchar
3802: // buffer, but nowadays they both work on UTF-8 data. Should aim to merge both.
3803: void ImGuiInputTextCallbackData::DeleteChars(int pos, int bytes_count)
3804: {
3805:     IM_ASSERT(pos + bytes_count <= BufTextLen);
3806:     char* dst = Buf + pos;
3807:     const char* src = Buf + pos + bytes_count;
3808:     memmove(dst, src, BufTextLen - bytes_count - pos + 1);
3809:     if (CursorPos >= pos + bytes_count)
3810:         CursorPos -= bytes_count;
3811:     else if (CursorPos >= pos)
3812:         CursorPos = pos;
3813:     SelectionStart = SelectionEnd = CursorPos;
3814:     BufDirty = true;
3815:     BufTextLen -= bytes_count;
3816: }
3817: void ImGuiInputTextCallbackData::InsertChars(int pos, const char* new_text, const char* new_text_end)
3818: {
3819:     // Accept null ranges
3820:     if (new_text == new_text_end)
3821:         return;
3822:     ImGuiContext& g = *Ctx;
3823:     ImGuiInputTextState* obj = &g.InputTextState;
3824:     IM_ASSERT(obj->ID != 0 && g.ActiveId == obj->ID);
3825:     const bool is_resizable = (Flags & ImGuiInputTextFlags_CallbackResize) != 0;
3826:     const bool is_readonly = (Flags & ImGuiInputTextFlags_ReadOnly) != 0;
3827:     int new_text_len = new_text_end ? (int)(new_text_end - new_text) : (int)ImStrlen(new_text);
3828:     // We support partial insertion (with a mod in stb_textedit.h)
3829:     const int avail = BufSize - 1 - BufTextLen;
3830:     if (!is_resizable && new_text_len > avail)
3831:         new_text_len = (int)(ImTextFindValidUtf8CodepointEnd(new_text, new_text + new_text_len, new_text + avail) - new_text); // Truncate to closest UTF-8 codepoint. Alternative: return 0 to cancel insertion.
3832:     if (new_text_len == 0)
3833:         return;
3834:     // Grow internal buffer if needed
3835:     if (new_text_len + BufTextLen + 1 > obj->TextA.Size && is_resizable && !is_readonly)
3836:     {
3837:         IM_ASSERT(Buf == obj->TextA.Data);
3838:         int new_buf_size = BufTextLen + ImClamp(new_text_len * 4, 32, ImMax(256, new_text_len)) + 1;
3839:         obj->TextA.resize(new_buf_size + 1);
3840:         obj->TextSrc = obj->TextA.Data;
3841:         Buf = obj->TextA.Data;
3842:         BufSize = obj->BufCapacity = new_buf_size;
3843:     }
3844:     if (BufTextLen != pos)
3845:         memmove(Buf + pos + new_text_len, Buf + pos, (size_t)(BufTextLen - pos));
3846:     memcpy(Buf + pos, new_text, (size_t)new_text_len * sizeof(char));
3847:     Buf[BufTextLen + new_text_len] = '\0';
3848:     BufDirty = true;
3849:     BufTextLen += new_text_len;
3850:     if (CursorPos >= pos)
3851:         CursorPos += new_text_len;
3852:     CursorPos = ImClamp(CursorPos, 0, BufTextLen);
3853:     SelectionStart = SelectionEnd = CursorPos;
3854: }
