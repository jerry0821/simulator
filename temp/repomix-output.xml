6388: void ImGui::TreePop()
6389: {
6390:     ImGuiContext& g = *GImGui;
6391:     ImGuiWindow* window = g.CurrentWindow;
6392:     Unindent();
6393:     window->DC.TreeDepth--;
6394:     ImU32 tree_depth_mask = (1 << window->DC.TreeDepth);
6395:     if (window->DC.TreeHasStackDataDepthMask & tree_depth_mask)
6396:     {
6397:         const ImGuiTreeNodeStackData* data = &g.TreeNodeStack.Data[g.TreeNodeStack.Size - 1];
6398:         IM_ASSERT(data->ID == window->IDStack.back());
6399:         // Handle Left arrow to move to parent tree node (when ImGuiTreeNodeFlags_NavLeftJumpsToParent is enabled)
6400:         if (data->TreeFlags & ImGuiTreeNodeFlags_NavLeftJumpsToParent)
6401:             if (g.NavIdIsAlive && g.NavMoveDir == ImGuiDir_Left && g.NavWindow == window && NavMoveRequestButNoResultYet())
6402:                 NavMoveRequestResolveWithPastTreeNode(&g.NavMoveResultLocal, data);
6403:         // Draw hierarchy lines
6404:         if (data->DrawLinesX1 != +FLT_MAX && window->DC.CursorPos.y >= window->ClipRect.Min.y)
6405:             TreeNodeDrawLineToTreePop(data);
6406:         g.TreeNodeStack.pop_back();
6407:         window->DC.TreeHasStackDataDepthMask &= ~tree_depth_mask;
6408:         window->DC.TreeRecordsClippedNodesY2Mask &= ~tree_depth_mask;
6409:     }
6410:     IM_ASSERT(window->IDStack.Size > 1); // There should always be 1 element in the IDStack (pushed during window creation). If this triggers you called TreePop/PopID too much.
6411:     PopID();
6412: }
