5674: // A little color square. Return true when clicked.
5675: // FIXME: May want to display/ignore the alpha component in the color display? Yet show it in the tooltip.
5676: // 'desc_id' is not called 'label' because we don't display it next to the button, but only in the tooltip.
5677: // Note that 'col' may be encoded in HSV if ImGuiColorEditFlags_InputHSV is set.
5678: bool ImGui::ColorButton(const char* desc_id, const ImVec4& col, ImGuiColorEditFlags flags, const ImVec2& size_arg)
5679: {
5680:     ImGuiWindow* window = GetCurrentWindow();
5681:     if (window->SkipItems)
5682:         return false;
5683:     ImGuiContext& g = *GImGui;
5684:     const ImGuiID id = window->GetID(desc_id);
5685:     const float default_size = GetFrameHeight();
5686:     const ImVec2 size(size_arg.x == 0.0f ? default_size : size_arg.x, size_arg.y == 0.0f ? default_size : size_arg.y);
5687:     const ImRect bb(window->DC.CursorPos, window->DC.CursorPos + size);
5688:     ItemSize(bb, (size.y >= default_size) ? g.Style.FramePadding.y : 0.0f);
5689:     if (!ItemAdd(bb, id))
5690:         return false;
5691:     bool hovered, held;
5692:     bool pressed = ButtonBehavior(bb, id, &hovered, &held);
5693:     if (flags & (ImGuiColorEditFlags_NoAlpha | ImGuiColorEditFlags_AlphaOpaque))
5694:         flags &= ~(ImGuiColorEditFlags_AlphaNoBg | ImGuiColorEditFlags_AlphaPreviewHalf);
5695:     ImVec4 col_rgb = col;
5696:     if (flags & ImGuiColorEditFlags_InputHSV)
5697:         ColorConvertHSVtoRGB(col_rgb.x, col_rgb.y, col_rgb.z, col_rgb.x, col_rgb.y, col_rgb.z);
5698:     ImVec4 col_rgb_without_alpha(col_rgb.x, col_rgb.y, col_rgb.z, 1.0f);
5699:     float grid_step = ImMin(size.x, size.y) / 2.99f;
5700:     float rounding = ImMin(g.Style.FrameRounding, grid_step * 0.5f);
5701:     ImRect bb_inner = bb;
5702:     float off = 0.0f;
5703:     if ((flags & ImGuiColorEditFlags_NoBorder) == 0)
5704:     {
5705:         off = -0.75f; // The border (using Col_FrameBg) tends to look off when color is near-opaque and rounding is enabled. This offset seemed like a good middle ground to reduce those artifacts.
5706:         bb_inner.Expand(off);
5707:     }
5708:     if ((flags & ImGuiColorEditFlags_AlphaPreviewHalf) && col_rgb.w < 1.0f)
5709:     {
5710:         float mid_x = IM_ROUND((bb_inner.Min.x + bb_inner.Max.x) * 0.5f);
5711:         if ((flags & ImGuiColorEditFlags_AlphaNoBg) == 0)
5712:             RenderColorRectWithAlphaCheckerboard(window->DrawList, ImVec2(bb_inner.Min.x + grid_step, bb_inner.Min.y), bb_inner.Max, GetColorU32(col_rgb), grid_step, ImVec2(-grid_step + off, off), rounding, ImDrawFlags_RoundCornersRight);
5713:         else
5714:             window->DrawList->AddRectFilled(ImVec2(bb_inner.Min.x + grid_step, bb_inner.Min.y), bb_inner.Max, GetColorU32(col_rgb), rounding, ImDrawFlags_RoundCornersRight);
5715:         window->DrawList->AddRectFilled(bb_inner.Min, ImVec2(mid_x, bb_inner.Max.y), GetColorU32(col_rgb_without_alpha), rounding, ImDrawFlags_RoundCornersLeft);
5716:     }
5717:     else
5718:     {
5719:         // Because GetColorU32() multiplies by the global style Alpha and we don't want to display a checkerboard if the source code had no alpha
5720:         ImVec4 col_source = (flags & ImGuiColorEditFlags_AlphaOpaque) ? col_rgb_without_alpha : col_rgb;
5721:         if (col_source.w < 1.0f && (flags & ImGuiColorEditFlags_AlphaNoBg) == 0)
5722:             RenderColorRectWithAlphaCheckerboard(window->DrawList, bb_inner.Min, bb_inner.Max, GetColorU32(col_source), grid_step, ImVec2(off, off), rounding);
5723:         else
5724:             window->DrawList->AddRectFilled(bb_inner.Min, bb_inner.Max, GetColorU32(col_source), rounding);
5725:     }
5726:     RenderNavCursor(bb, id);
5727:     if ((flags & ImGuiColorEditFlags_NoBorder) == 0)
5728:     {
5729:         if (g.Style.FrameBorderSize > 0.0f)
5730:             RenderFrameBorder(bb.Min, bb.Max, rounding);
5731:         else
5732:             window->DrawList->AddRect(bb.Min, bb.Max, GetColorU32(ImGuiCol_FrameBg), rounding); // Color buttons are often in need of some sort of border // FIXME-DPI
5733:     }
5734:     // Drag and Drop Source
5735:     // NB: The ActiveId test is merely an optional micro-optimization, BeginDragDropSource() does the same test.
5736:     if (g.ActiveId == id && !(flags & ImGuiColorEditFlags_NoDragDrop) && BeginDragDropSource())
5737:     {
5738:         if (flags & ImGuiColorEditFlags_NoAlpha)
5739:             SetDragDropPayload(IMGUI_PAYLOAD_TYPE_COLOR_3F, &col_rgb, sizeof(float) * 3, ImGuiCond_Once);
5740:         else
5741:             SetDragDropPayload(IMGUI_PAYLOAD_TYPE_COLOR_4F, &col_rgb, sizeof(float) * 4, ImGuiCond_Once);
5742:         ColorButton(desc_id, col, flags);
5743:         SameLine();
5744:         TextEx("Color");
5745:         EndDragDropSource();
5746:     }
5747:     // Tooltip
5748:     if (!(flags & ImGuiColorEditFlags_NoTooltip) && hovered && IsItemHovered(ImGuiHoveredFlags_ForTooltip))
5749:         ColorTooltip(desc_id, &col.x, flags & (ImGuiColorEditFlags_InputMask_ | ImGuiColorEditFlags_AlphaMask_));
5750:     return pressed;
5751: }
