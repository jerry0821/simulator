13866:     ImGuiWindow* window = FindWindowByName(name);
13867:     if (window != NULL)
13868:     {
13869:         window->Flags |= ImGuiWindowFlags_NoSavedSettings;
13870:         InitOrLoadWindowSettings(window, NULL);
13871:     }
13872:     if (ImGuiWindowSettings* settings = window ? FindWindowSettingsByWindow(window) : FindWindowSettingsByID(ImHashStr(name)))
13873:         settings->WantDelete = true;
