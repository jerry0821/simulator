7534: static int IMGUI_CDECL PairComparerByValueInt(const void* lhs, const void* rhs)
7535: {
7536:     int lhs_v = ((const ImGuiStoragePair*)lhs)->val_i;
7537:     int rhs_v = ((const ImGuiStoragePair*)rhs)->val_i;
7538:     return (lhs_v > rhs_v ? +1 : lhs_v < rhs_v ? -1 : 0);
7539: }
7540: // GetNextSelectedItem() is an abstraction allowing us to change our underlying actual storage system without impacting user.
7541: // (e.g. store unselected vs compact down, compact down on demand, use raw ImVector<ImGuiID> instead of ImGuiStorage...)
7542: bool ImGuiSelectionBasicStorage::GetNextSelectedItem(void** opaque_it, ImGuiID* out_id)
7543: {
7544:     ImGuiStoragePair* it = (ImGuiStoragePair*)*opaque_it;
7545:     ImGuiStoragePair* it_end = _Storage.Data.Data + _Storage.Data.Size;
7546:     if (PreserveOrder && it == NULL && it_end != NULL)
7547:         ImQsort(_Storage.Data.Data, (size_t)_Storage.Data.Size, sizeof(ImGuiStoragePair), PairComparerByValueInt); // ~ImGuiStorage::BuildSortByValueInt()
7548:     if (it == NULL)
7549:         it = _Storage.Data.Data;
7550:     IM_ASSERT(it >= _Storage.Data.Data && it <= it_end);
7551:     if (it != it_end)
7552:         while (it->val_i == 0 && it < it_end)
7553:             it++;
7554:     const bool has_more = (it != it_end);
7555:     *opaque_it = has_more ? (void**)(it + 1) : (void**)(it);
7556:     *out_id = has_more ? it->key : 0;
7557:     if (PreserveOrder && !has_more)
7558:         _Storage.BuildSortByKey();
7559:     return has_more;
7560: }
7561: void ImGuiSelectionBasicStorage::SetItemSelected(ImGuiID id, bool selected)
7562: {
7563:     int* p_int = _Storage.GetIntRef(id, 0);
7564:     if (selected && *p_int == 0) { *p_int = _SelectionOrder++; Size++; }
7565:     else if (!selected && *p_int != 0) { *p_int = 0; Size--; }
7566: }
7567: // Optimized for batch edits (with same value of 'selected')
7568: static void ImGuiSelectionBasicStorage_BatchSetItemSelected(ImGuiSelectionBasicStorage* selection, ImGuiID id, bool selected, int size_before_amends, int selection_order)
7569: {
7570:     ImGuiStorage* storage = &selection->_Storage;
7571:     ImGuiStoragePair* it = ImLowerBound(storage->Data.Data, storage->Data.Data + size_before_amends, id);
7572:     const bool is_contained = (it != storage->Data.Data + size_before_amends) && (it->key == id);
7573:     if (selected == (is_contained && it->val_i != 0))
7574:         return;
7575:     if (selected && !is_contained)
7576:         storage->Data.push_back(ImGuiStoragePair(id, selection_order)); // Push unsorted at end of vector, will be sorted in SelectionMultiAmendsFinish()
7577:     else if (is_contained)
7578:         it->val_i = selected ? selection_order : 0; // Modify in-place.
7579:     selection->Size += selected ? +1 : -1;
7580: }
7581: static void ImGuiSelectionBasicStorage_BatchFinish(ImGuiSelectionBasicStorage* selection, bool selected, int size_before_amends)
7582: {
7583:     ImGuiStorage* storage = &selection->_Storage;
7584:     if (selected && selection->Size != size_before_amends)
7585:         storage->BuildSortByKey(); // When done selecting: sort everything
7586: }
7587: // Apply requests coming from BeginMultiSelect() and EndMultiSelect().
7588: // - Enable 'Demo->Tools->Debug Log->Selection' to see selection requests as they happen.
7589: // - Honoring SetRange requests requires that you can iterate/interpolate between RangeFirstItem and RangeLastItem.
7590: //   - In this demo we often submit indices to SetNextItemSelectionUserData() + store the same indices in persistent selection.
7591: //   - Your code may do differently. If you store pointers or objects ID in ImGuiSelectionUserData you may need to perform
7592: //     a lookup in order to have some way to iterate/interpolate between two items.
7593: // - A full-featured application is likely to allow search/filtering which is likely to lead to using indices
7594: //   and constructing a view index <> object id/ptr data structure anyway.
7595: // WHEN YOUR APPLICATION SETTLES ON A CHOICE, YOU WILL PROBABLY PREFER TO GET RID OF THIS UNNECESSARY 'ImGuiSelectionBasicStorage' INDIRECTION LOGIC.
7596: // Notice that with the simplest adapter (using indices everywhere), all functions return their parameters.
7597: // The most simple implementation (using indices everywhere) would look like:
7598: //   for (ImGuiSelectionRequest& req : ms_io->Requests)
7599: //   {
7600: //      if (req.Type == ImGuiSelectionRequestType_SetAll)    { Clear(); if (req.Selected) { for (int n = 0; n < items_count; n++) { SetItemSelected(n, true); } }
7601: //      if (req.Type == ImGuiSelectionRequestType_SetRange)  { for (int n = (int)ms_io->RangeFirstItem; n <= (int)ms_io->RangeLastItem; n++) { SetItemSelected(n, ms_io->Selected); } }
7602: //   }
7603: void ImGuiSelectionBasicStorage::ApplyRequests(ImGuiMultiSelectIO* ms_io)
7604: {
7605:     // For convenience we obtain ItemsCount as passed to BeginMultiSelect(), which is optional.
7606:     // It makes sense when using ImGuiSelectionBasicStorage to simply pass your items count to BeginMultiSelect().
7607:     // Other scheme may handle SetAll differently.
7608:     IM_ASSERT(ms_io->ItemsCount != -1 && "Missing value for items_count in BeginMultiSelect() call!");
7609:     IM_ASSERT(AdapterIndexToStorageId != NULL);
7610:     // This is optimized/specialized to cope with very large selections (e.g. 100k+ items)
7611:     // - A simpler version could call SetItemSelected() directly instead of ImGuiSelectionBasicStorage_BatchSetItemSelected() + ImGuiSelectionBasicStorage_BatchFinish().
7612:     // - Optimized select can append unsorted, then sort in a second pass. Optimized unselect can clear in-place then compact in a second pass.
7613:     // - A more optimal version wouldn't even use ImGuiStorage but directly a ImVector<ImGuiID> to reduce bandwidth, but this is a reasonable trade off to reuse code.
7614:     // - There are many ways this could be better optimized. The worse case scenario being: using BoxSelect2d in a grid, box-select scrolling down while wiggling
7615:     //   left and right: it affects coarse clipping + can emit multiple SetRange with 1 item each.
7616:     // FIXME-OPT: For each block of consecutive SetRange request:
7617:     // - add all requests to a sorted list, store ID, selected, offset in ImGuiStorage.
7618:     // - rewrite sorted storage a single time.
7619:     for (ImGuiSelectionRequest& req : ms_io->Requests)
7620:     {
7621:         if (req.Type == ImGuiSelectionRequestType_SetAll)
7622:         {
7623:             Clear();
7624:             if (req.Selected)
7625:             {
7626:                 _Storage.Data.reserve(ms_io->ItemsCount);
7627:                 const int size_before_amends = _Storage.Data.Size;
7628:                 for (int idx = 0; idx < ms_io->ItemsCount; idx++, _SelectionOrder++)
7629:                     ImGuiSelectionBasicStorage_BatchSetItemSelected(this, GetStorageIdFromIndex(idx), req.Selected, size_before_amends, _SelectionOrder);
7630:                 ImGuiSelectionBasicStorage_BatchFinish(this, req.Selected, size_before_amends);
7631:             }
7632:         }
7633:         else if (req.Type == ImGuiSelectionRequestType_SetRange)
7634:         {
7635:             const int selection_changes = (int)req.RangeLastItem - (int)req.RangeFirstItem + 1;
7636:             //ImGuiContext& g = *GImGui; IMGUI_DEBUG_LOG_SELECTION("Req %d/%d: set %d to %d\n", ms_io->Requests.index_from_ptr(&req), ms_io->Requests.Size, selection_changes, req.Selected);
7637:             if (selection_changes == 1 || (selection_changes < Size / 100))
7638:             {
7639:                 // Multiple sorted insertion + copy likely to be faster.
7640:                 // Technically we could do a single copy with a little more work (sort sequential SetRange requests)
7641:                 for (int idx = (int)req.RangeFirstItem; idx <= (int)req.RangeLastItem; idx++)
7642:                     SetItemSelected(GetStorageIdFromIndex(idx), req.Selected);
7643:             }
7644:             else
7645:             {
7646:                 // Append insertion + single sort likely be faster.
7647:                 // Use req.RangeDirection to set order field so that Shift+Clicking from 1 to 5 is different than Shift+Clicking from 5 to 1
7648:                 const int size_before_amends = _Storage.Data.Size;
7649:                 int selection_order = _SelectionOrder + ((req.RangeDirection < 0) ? selection_changes - 1 : 0);
7650:                 for (int idx = (int)req.RangeFirstItem; idx <= (int)req.RangeLastItem; idx++, selection_order += req.RangeDirection)
7651:                     ImGuiSelectionBasicStorage_BatchSetItemSelected(this, GetStorageIdFromIndex(idx), req.Selected, size_before_amends, selection_order);
7652:                 if (req.Selected)
7653:                     _SelectionOrder += selection_changes;
7654:                 ImGuiSelectionBasicStorage_BatchFinish(this, req.Selected, size_before_amends);
7655:             }
7656:         }
7657:     }
7658: }
