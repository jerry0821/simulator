 9687: static void ImGui::ErrorCheckEndFrameSanityChecks()
 9688: {
 9689:     // Verify that io.KeyXXX fields haven't been tampered with. Key mods should not be modified between NewFrame() and EndFrame()
 9690:     // One possible reason leading to this assert is that your backends update inputs _AFTER_ NewFrame().
 9691:     // It is known that when some modal native windows called mid-frame takes focus away, some backends such as GLFW will
 9692:     // send key release events mid-frame. This would normally trigger this assertion and lead to sheared inputs.
 9693:     // We silently accommodate for this case by ignoring the case where all io.KeyXXX modifiers were released (aka key_mod_flags == 0),
 9694:     // while still correctly asserting on mid-frame key press events.
 9695:     ImGuiContext& g = *GImGui;
 9696:     const ImGuiKeyChord key_mods = GetMergedModsFromKeys();
 9697:     IM_UNUSED(g);
 9698:     IM_UNUSED(key_mods);
 9699:     IM_ASSERT((key_mods == 0 || g.IO.KeyMods == key_mods) && "Mismatching io.KeyCtrl/io.KeyShift/io.KeyAlt/io.KeySuper vs io.KeyMods");
 9700:     IM_UNUSED(key_mods);
 9701:     IM_ASSERT(g.CurrentWindowStack.Size == 1);
 9702:     IM_ASSERT(g.CurrentWindowStack[0].Window->IsFallbackWindow);
 9703: }
