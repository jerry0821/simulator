 2143: // Known size hash
 2144: // It is ok to call ImHashData on a string with known length but the ### operator won't be supported.
 2145: // FIXME-OPT: Replace with e.g. FNV1a hash? CRC32 pretty much randomly access 1KB. Need to do proper measurements.
 2146: ImGuiID ImHashData(const void* data_p, size_t data_size, ImGuiID seed)
 2147: {
 2148:     ImU32 crc = ~seed;
 2149:     const unsigned char* data = (const unsigned char*)data_p;
 2150:     const unsigned char *data_end = (const unsigned char*)data_p + data_size;
 2151: #ifndef IMGUI_ENABLE_SSE4_2_CRC
 2152:     const ImU32* crc32_lut = GCrc32LookupTable;
 2153:     while (data < data_end)
 2154:         crc = (crc >> 8) ^ crc32_lut[(crc & 0xFF) ^ *data++];
 2155:     return ~crc;
 2156: #else
 2157:     while (data + 4 <= data_end)
 2158:     {
 2159:         crc = _mm_crc32_u32(crc, *(ImU32*)data);
 2160:         data += 4;
 2161:     }
 2162:     while (data < data_end)
 2163:         crc = _mm_crc32_u8(crc, *data++);
 2164:     return ~crc;
 2165: #endif
 2166: }
 2167: // Zero-terminated string hash, with support for ### to reset back to seed value
 2168: // We support a syntax of "label###id" where only "###id" is included in the hash, and only "label" gets displayed.
 2169: // Because this syntax is rarely used we are optimizing for the common case.
 2170: // - If we reach ### in the string we discard the hash so far and reset to the seed.
 2171: // - We don't do 'current += 2; continue;' after handling ### to keep the code smaller/faster (measured ~10% diff in Debug build)
 2172: // FIXME-OPT: Replace with e.g. FNV1a hash? CRC32 pretty much randomly access 1KB. Need to do proper measurements.
 2173: ImGuiID ImHashStr(const char* data_p, size_t data_size, ImGuiID seed)
 2174: {
 2175:     seed = ~seed;
 2176:     ImU32 crc = seed;
 2177:     const unsigned char* data = (const unsigned char*)data_p;
 2178: #ifndef IMGUI_ENABLE_SSE4_2_CRC
 2179:     const ImU32* crc32_lut = GCrc32LookupTable;
 2180: #endif
 2181:     if (data_size != 0)
 2182:     {
 2183:         while (data_size-- != 0)
 2184:         {
 2185:             unsigned char c = *data++;
 2186:             if (c == '#' && data_size >= 2 && data[0] == '#' && data[1] == '#')
 2187:                 crc = seed;
 2188: #ifndef IMGUI_ENABLE_SSE4_2_CRC
 2189:             crc = (crc >> 8) ^ crc32_lut[(crc & 0xFF) ^ c];
 2190: #else
 2191:             crc = _mm_crc32_u8(crc, c);
 2192: #endif
 2193:         }
 2194:     }
 2195:     else
 2196:     {
 2197:         while (unsigned char c = *data++)
 2198:         {
 2199:             if (c == '#' && data[0] == '#' && data[1] == '#')
 2200:                 crc = seed;
 2201: #ifndef IMGUI_ENABLE_SSE4_2_CRC
 2202:             crc = (crc >> 8) ^ crc32_lut[(crc & 0xFF) ^ c];
 2203: #else
 2204:             crc = _mm_crc32_u8(crc, c);
 2205: #endif
 2206:         }
 2207:     }
 2208:     return ~crc;
 2209: }
 2210: // Skip to the "###" marker if any. We don't skip past to match the behavior of GetID()
 2211: // FIXME-OPT: This is not designed to be optimal. Use with care.
 2212: const char* ImHashSkipUncontributingPrefix(const char* label)
 2213: {
 2214:     const char* result = label;
 2215:     while (unsigned char c = *label++)
 2216:         if (c == '#' && label[0] == '#' && label[1] == '#')
 2217:             result = label - 1;
 2218:     return result;
 2219: }
