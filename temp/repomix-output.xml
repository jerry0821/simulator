2142: template<typename T>
2143: static bool DataTypeClampT(T* v, const T* v_min, const T* v_max)
2144: {
2145:     // Clamp, both sides are optional, return true if modified
2146:     if (v_min && *v < *v_min) { *v = *v_min; return true; }
2147:     if (v_max && *v > *v_max) { *v = *v_max; return true; }
2148:     return false;
2149: }
