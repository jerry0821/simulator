 8444: // Rewrite routing data buffers to strip old entries + sort by key to make queries not touch scattered data.
 8445: //   Entries   D,A,B,B,A,C,B     --> A,A,B,B,B,C,D
 8446: //   Index     A:1 B:2 C:5 D:0   --> A:0 B:2 C:5 D:6
 8447: // See 'Metrics->Key Owners & Shortcut Routing' to visualize the result of that operation.
 8448: static void ImGui::UpdateKeyRoutingTable(ImGuiKeyRoutingTable* rt)
 8449: {
 8450:     ImGuiContext& g = *GImGui;
 8451:     rt->EntriesNext.resize(0);
 8452:     for (ImGuiKey key = ImGuiKey_NamedKey_BEGIN; key < ImGuiKey_NamedKey_END; key = (ImGuiKey)(key + 1))
 8453:     {
 8454:         const int new_routing_start_idx = rt->EntriesNext.Size;
 8455:         ImGuiKeyRoutingData* routing_entry;
 8456:         for (int old_routing_idx = rt->Index[key - ImGuiKey_NamedKey_BEGIN]; old_routing_idx != -1; old_routing_idx = routing_entry->NextEntryIndex)
 8457:         {
 8458:             routing_entry = &rt->Entries[old_routing_idx];
 8459:             routing_entry->RoutingCurrScore = routing_entry->RoutingNextScore;
 8460:             routing_entry->RoutingCurr = routing_entry->RoutingNext; // Update entry
 8461:             routing_entry->RoutingNext = ImGuiKeyOwner_NoOwner;
 8462:             routing_entry->RoutingNextScore = 0;
 8463:             if (routing_entry->RoutingCurr == ImGuiKeyOwner_NoOwner)
 8464:                 continue;
 8465:             rt->EntriesNext.push_back(*routing_entry); // Write alive ones into new buffer
 8466:             // Apply routing to owner if there's no owner already (RoutingCurr == None at this point)
 8467:             // This is the result of previous frame's SetShortcutRouting() call.
 8468:             if (routing_entry->Mods == g.IO.KeyMods)
 8469:             {
 8470:                 ImGuiKeyOwnerData* owner_data = GetKeyOwnerData(&g, key);
 8471:                 if (owner_data->OwnerCurr == ImGuiKeyOwner_NoOwner)
 8472:                 {
 8473:                     owner_data->OwnerCurr = routing_entry->RoutingCurr;
 8474:                     //IMGUI_DEBUG_LOG("SetKeyOwner(%s, owner_id=0x%08X) via Routing\n", GetKeyName(key), routing_entry->RoutingCurr);
 8475:                 }
 8476:             }
 8477:         }
 8478:         // Rewrite linked-list
 8479:         rt->Index[key - ImGuiKey_NamedKey_BEGIN] = (ImGuiKeyRoutingIndex)(new_routing_start_idx < rt->EntriesNext.Size ? new_routing_start_idx : -1);
 8480:         for (int n = new_routing_start_idx; n < rt->EntriesNext.Size; n++)
 8481:             rt->EntriesNext[n].NextEntryIndex = (ImGuiKeyRoutingIndex)((n + 1 < rt->EntriesNext.Size) ? n + 1 : -1);
 8482:     }
 8483:     rt->Entries.swap(rt->EntriesNext); // Swap new and old indexes
 8484: }
 8485: // owner_id may be None/Any, but routing_id needs to be always be set, so we default to GetCurrentFocusScope().
 8486: static inline ImGuiID GetRoutingIdFromOwnerId(ImGuiID owner_id)
 8487: {
 8488:     ImGuiContext& g = *GImGui;
 8489:     return (owner_id != ImGuiKeyOwner_NoOwner && owner_id != ImGuiKeyOwner_Any) ? owner_id : g.CurrentFocusScopeId;
 8490: }
 8491: ImGuiKeyRoutingData* ImGui::GetShortcutRoutingData(ImGuiKeyChord key_chord)
 8492: {
 8493:     // Majority of shortcuts will be Key + any number of Mods
 8494:     // We accept _Single_ mod with ImGuiKey_None.
 8495:     //  - Shortcut(ImGuiKey_S | ImGuiMod_Ctrl);                    // Legal
 8496:     //  - Shortcut(ImGuiKey_S | ImGuiMod_Ctrl | ImGuiMod_Shift);   // Legal
 8497:     //  - Shortcut(ImGuiMod_Ctrl);                                 // Legal
 8498:     //  - Shortcut(ImGuiMod_Ctrl | ImGuiMod_Shift);                // Not legal
 8499:     ImGuiContext& g = *GImGui;
 8500:     ImGuiKeyRoutingTable* rt = &g.KeysRoutingTable;
 8501:     ImGuiKeyRoutingData* routing_data;
 8502:     ImGuiKey key = (ImGuiKey)(key_chord & ~ImGuiMod_Mask_);
 8503:     ImGuiKey mods = (ImGuiKey)(key_chord & ImGuiMod_Mask_);
 8504:     if (key == ImGuiKey_None)
 8505:         key = ConvertSingleModFlagToKey(mods);
 8506:     IM_ASSERT(IsNamedKey(key));
 8507:     // Get (in the majority of case, the linked list will have one element so this should be 2 reads.
 8508:     // Subsequent elements will be contiguous in memory as list is sorted/rebuilt in NewFrame).
 8509:     for (ImGuiKeyRoutingIndex idx = rt->Index[key - ImGuiKey_NamedKey_BEGIN]; idx != -1; idx = routing_data->NextEntryIndex)
 8510:     {
 8511:         routing_data = &rt->Entries[idx];
 8512:         if (routing_data->Mods == mods)
 8513:             return routing_data;
 8514:     }
 8515:     // Add to linked-list
 8516:     ImGuiKeyRoutingIndex routing_data_idx = (ImGuiKeyRoutingIndex)rt->Entries.Size;
 8517:     rt->Entries.push_back(ImGuiKeyRoutingData());
 8518:     routing_data = &rt->Entries[routing_data_idx];
 8519:     routing_data->Mods = (ImU16)mods;
 8520:     routing_data->NextEntryIndex = rt->Index[key - ImGuiKey_NamedKey_BEGIN]; // Setup linked list
 8521:     rt->Index[key - ImGuiKey_NamedKey_BEGIN] = routing_data_idx;
 8522:     return routing_data;
 8523: }
 8524: // Current score encoding
 8525: //  -        0: Never route
 8526: //  -        1: ImGuiInputFlags_RouteGlobal    (lower priority)
 8527: //  - 100..199: ImGuiInputFlags_RouteFocused   (if window in focus-stack)
 8528: //         200: ImGuiInputFlags_RouteGlobal  | ImGuiInputFlags_RouteOverFocused
 8529: //         300: ImGuiInputFlags_RouteActive or ImGuiInputFlags_RouteFocused (if item active)
 8530: //         400: ImGuiInputFlags_RouteGlobal  | ImGuiInputFlags_RouteOverActive
 8531: //  - 500..599: ImGuiInputFlags_RouteFocused | ImGuiInputFlags_RouteOverActive (if window in focus-stack) (higher priority)
 8532: // 'flags' should include an explicit routing policy
 8533: static int CalcRoutingScore(ImGuiID focus_scope_id, ImGuiID owner_id, ImGuiInputFlags flags)
 8534: {
 8535:     ImGuiContext& g = *GImGui;
 8536:     if (flags & ImGuiInputFlags_RouteFocused)
 8537:     {
 8538:         // ActiveID gets high priority
 8539:         // (we don't check g.ActiveIdUsingAllKeys here. Routing is applied but if input ownership is tested later it may discard it)
 8540:         if (owner_id != 0 && g.ActiveId == owner_id)
 8541:             return 300;
 8542:         // Score based on distance to focused window (lower is better)
 8543:         // Assuming both windows are submitting a routing request,
 8544:         // - When Window....... is focused -> Window scores 3 (best), Window/ChildB scores 255 (no match)
 8545:         // - When Window/ChildB is focused -> Window scores 4,        Window/ChildB scores 3 (best)
 8546:         // Assuming only WindowA is submitting a routing request,
 8547:         // - When Window/ChildB is focused -> Window scores 4 (best), Window/ChildB doesn't have a score.
 8548:         // This essentially follow the window->ParentWindowForFocusRoute chain.
 8549:         if (focus_scope_id == 0)
 8550:             return 0;
 8551:         for (int index_in_focus_path = 0; index_in_focus_path < g.NavFocusRoute.Size; index_in_focus_path++)
 8552:             if (g.NavFocusRoute.Data[index_in_focus_path].ID == focus_scope_id)
 8553:             {
 8554:                 if (flags & ImGuiInputFlags_RouteOverActive) // && g.ActiveId != 0 && g.ActiveId != owner_id)
 8555:                     return 599 - index_in_focus_path;
 8556:                 else
 8557:                     return 199 - index_in_focus_path;
 8558:             }
 8559:         return 0;
 8560:     }
 8561:     else if (flags & ImGuiInputFlags_RouteActive)
 8562:     {
 8563:         if (owner_id != 0 && g.ActiveId == owner_id)
 8564:             return 300;
 8565:         return 0;
 8566:     }
 8567:     else if (flags & ImGuiInputFlags_RouteGlobal)
 8568:     {
 8569:         if (flags & ImGuiInputFlags_RouteOverActive)
 8570:             return 400;
 8571:         if (owner_id != 0 && g.ActiveId == owner_id)
 8572:             return 300;
 8573:         if (flags & ImGuiInputFlags_RouteOverFocused)
 8574:             return 200;
 8575:         return 1;
 8576:     }
 8577:     IM_ASSERT(0);
 8578:     return 0;
 8579: }
 8580: // - We need this to filter some Shortcut() routes when an item e.g. an InputText() is active
 8581: //   e.g. ImGuiKey_G won't be considered a shortcut when item is active, but ImGuiMod|ImGuiKey_G can be.
 8582: // - This is also used by UpdateInputEvents() to avoid trickling in the most common case of e.g. pressing ImGuiKey_G also emitting a G character.
 8583: static bool IsKeyChordPotentiallyCharInput(ImGuiKeyChord key_chord)
 8584: {
 8585:     // Mimic 'ignore_char_inputs' logic in InputText()
 8586:     ImGuiContext& g = *GImGui;
 8587:     // When the right mods are pressed it cannot be a char input so we won't filter the shortcut out.
 8588:     ImGuiKey mods = (ImGuiKey)(key_chord & ImGuiMod_Mask_);
 8589:     const bool ignore_char_inputs = ((mods & ImGuiMod_Ctrl) && !(mods & ImGuiMod_Alt)) || (g.IO.ConfigMacOSXBehaviors && (mods & ImGuiMod_Ctrl));
 8590:     if (ignore_char_inputs)
 8591:         return false;
 8592:     // Return true for A-Z, 0-9 and other keys associated to char inputs. Other keys such as F1-F12 won't be filtered.
 8593:     ImGuiKey key = (ImGuiKey)(key_chord & ~ImGuiMod_Mask_);
 8594:     if (key == ImGuiKey_None)
 8595:         return false;
 8596:     return g.KeysMayBeCharInput.TestBit(key);
 8597: }
 8598: // Request a desired route for an input chord (key + mods).
 8599: // Return true if the route is available this frame.
 8600: // - Routes and key ownership are attributed at the beginning of next frame based on best score and mod state.
 8601: //   (Conceptually this does a "Submit for next frame" + "Test for current frame".
 8602: //   As such, it could be called TrySetXXX or SubmitXXX, or the Submit and Test operations should be separate.)
 8603: bool ImGui::SetShortcutRouting(ImGuiKeyChord key_chord, ImGuiInputFlags flags, ImGuiID owner_id)
 8604: {
 8605:     ImGuiContext& g = *GImGui;
 8606:     if ((flags & ImGuiInputFlags_RouteTypeMask_) == 0)
 8607:         flags |= ImGuiInputFlags_RouteGlobal | ImGuiInputFlags_RouteOverFocused | ImGuiInputFlags_RouteOverActive; // IMPORTANT: This is the default for SetShortcutRouting() but NOT Shortcut()
 8608:     else
 8609:         IM_ASSERT(ImIsPowerOfTwo(flags & ImGuiInputFlags_RouteTypeMask_)); // Check that only 1 routing flag is used
 8610:     IM_ASSERT(owner_id != ImGuiKeyOwner_Any && owner_id != ImGuiKeyOwner_NoOwner);
 8611:     if (flags & (ImGuiInputFlags_RouteOverFocused | ImGuiInputFlags_RouteUnlessBgFocused))
 8612:         IM_ASSERT(flags & ImGuiInputFlags_RouteGlobal);
 8613:     if (flags & ImGuiInputFlags_RouteOverActive)
 8614:         IM_ASSERT(flags & (ImGuiInputFlags_RouteGlobal | ImGuiInputFlags_RouteFocused));
 8615:     // Add ImGuiMod_XXXX when a corresponding ImGuiKey_LeftXXX/ImGuiKey_RightXXX is specified.
 8616:     key_chord = FixupKeyChord(key_chord);
 8617:     // [DEBUG] Debug break requested by user
 8618:     if (g.DebugBreakInShortcutRouting == key_chord)
 8619:         IM_DEBUG_BREAK();
 8620:     if (flags & ImGuiInputFlags_RouteUnlessBgFocused)
 8621:         if (g.NavWindow == NULL)
 8622:             return false;
 8623:     // Note how ImGuiInputFlags_RouteAlways won't set routing and thus won't set owner. May want to rework this?
 8624:     if (flags & ImGuiInputFlags_RouteAlways)
 8625:     {
 8626:         IMGUI_DEBUG_LOG_INPUTROUTING("SetShortcutRouting(%s, flags=%04X, owner_id=0x%08X) -> always, no register\n", GetKeyChordName(key_chord), flags, owner_id);
 8627:         return true;
 8628:     }
 8629:     // Specific culling when there's an active item.
 8630:     if (g.ActiveId != 0 && g.ActiveId != owner_id)
 8631:     {
 8632:         if (flags & ImGuiInputFlags_RouteActive)
 8633:             return false;
 8634:         // Cull shortcuts with no modifiers when it could generate a character.
 8635:         // e.g. Shortcut(ImGuiKey_G) also generates 'g' character, should not trigger when InputText() is active.
 8636:         // but  Shortcut(Ctrl+G) should generally trigger when InputText() is active.
 8637:         // TL;DR: lettered shortcut with no mods or with only Alt mod will not trigger while an item reading text input is active.
 8638:         // (We cannot filter based on io.InputQueueCharacters[] contents because of trickling and key<>chars submission order are undefined)
 8639:         if (g.IO.WantTextInput && IsKeyChordPotentiallyCharInput(key_chord))
 8640:         {
 8641:             IMGUI_DEBUG_LOG_INPUTROUTING("SetShortcutRouting(%s, flags=%04X, owner_id=0x%08X) -> filtered as potential char input\n", GetKeyChordName(key_chord), flags, owner_id);
 8642:             return false;
 8643:         }
 8644:         // ActiveIdUsingAllKeyboardKeys trumps all for ActiveId
 8645:         if ((flags & ImGuiInputFlags_RouteOverActive) == 0 && g.ActiveIdUsingAllKeyboardKeys)
 8646:         {
 8647:             ImGuiKey key = (ImGuiKey)(key_chord & ~ImGuiMod_Mask_);
 8648:             if (key == ImGuiKey_None)
 8649:                 key = ConvertSingleModFlagToKey((ImGuiKey)(key_chord & ImGuiMod_Mask_));
 8650:             if (key >= ImGuiKey_Keyboard_BEGIN && key < ImGuiKey_Keyboard_END)
 8651:                 return false;
 8652:         }
 8653:     }
 8654:     // Where do we evaluate route for?
 8655:     ImGuiID focus_scope_id = g.CurrentFocusScopeId;
 8656:     if (flags & ImGuiInputFlags_RouteFromRootWindow)
 8657:         focus_scope_id = g.CurrentWindow->RootWindow->ID; // See PushFocusScope() call in Begin()
 8658:     const int score = CalcRoutingScore(focus_scope_id, owner_id, flags);
 8659:     IMGUI_DEBUG_LOG_INPUTROUTING("SetShortcutRouting(%s, flags=%04X, owner_id=0x%08X) -> score %d\n", GetKeyChordName(key_chord), flags, owner_id, score);
 8660:     if (score == 0)
 8661:         return false;
 8662:     // Submit routing for NEXT frame (assuming score is sufficient)
 8663:     // FIXME: Could expose a way to use a "serve last" policy for same score resolution (using >= instead of >).
 8664:     ImGuiKeyRoutingData* routing_data = GetShortcutRoutingData(key_chord);
 8665:     //const bool set_route = (flags & ImGuiInputFlags_ServeLast) ? (score >= routing_data->RoutingNextScore) : (score > routing_data->RoutingNextScore);
 8666:     if (score > routing_data->RoutingNextScore)
 8667:     {
 8668:         routing_data->RoutingNext = owner_id;
 8669:         routing_data->RoutingNextScore = (ImU16)score;
 8670:     }
 8671:     // Return routing state for CURRENT frame
 8672:     if (routing_data->RoutingCurr == owner_id)
 8673:         IMGUI_DEBUG_LOG_INPUTROUTING("--> granting current route\n");
 8674:     return routing_data->RoutingCurr == owner_id;
 8675: }
