3451:     ImVector<float>             IndexAdvanceX;      // 12-16 // out // Sparse. Glyphs->AdvanceX in a directly indexable way (cache-friendly for CalcTextSize functions which only this info, and are often bottleneck in large UI).
3452:     float                       FallbackAdvanceX;   // 4     // out // FindGlyph(FallbackChar)->AdvanceX
3453:     float                       Size;               // 4     // in  // Height of characters/line, set during loading (doesn't change after loading)
3454:     float                       RasterizerDensity;  // 4     // in  // Density this is baked at
3455:     // [Internal] Members: Hot ~28/36 bytes (for RenderText loop)
3456:     ImVector<ImU16>             IndexLookup;        // 12-16 // out // Sparse. Index glyphs by Unicode code-point.
3457:     ImVector<ImFontGlyph>       Glyphs;             // 12-16 // out // All glyphs.
3458:     int                         FallbackGlyphIndex; // 4     // out // Index of FontFallbackChar
3459:     // [Internal] Members: Cold
3460:     float                       Ascent, Descent;    // 4+4   // out // Ascent: distance from top to bottom of e.g. 'A' [0..FontSize] (unscaled)
3461:     unsigned int                MetricsTotalSurface:26;// 3  // out // Total surface in pixels to get an idea of the font rasterization/texture cost (not exact, we approximate the cost of padding between glyphs)
