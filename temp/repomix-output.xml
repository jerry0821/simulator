 6015: static void CalcResizePosSizeFromAnyCorner(ImGuiWindow* window, const ImVec2& corner_target_arg, const ImVec2& corner_norm, ImVec2* out_pos, ImVec2* out_size)
 6016: {
 6017:     ImVec2 corner_target = corner_target_arg;
 6018:     if (window->Flags & ImGuiWindowFlags_ChildWindow) // Clamp resizing of childs within parent
 6019:     {
 6020:         ImGuiWindow* parent_window = window->ParentWindow;
 6021:         ImGuiWindowFlags parent_flags = parent_window->Flags;
 6022:         ImRect limit_rect = parent_window->InnerRect;
 6023:         limit_rect.Expand(ImVec2(-ImMax(parent_window->WindowPadding.x, parent_window->WindowBorderSize), -ImMax(parent_window->WindowPadding.y, parent_window->WindowBorderSize)));
 6024:         if ((parent_flags & (ImGuiWindowFlags_HorizontalScrollbar | ImGuiWindowFlags_AlwaysHorizontalScrollbar)) == 0 || (parent_flags & ImGuiWindowFlags_NoScrollbar))
 6025:             corner_target.x = ImClamp(corner_target.x, limit_rect.Min.x, limit_rect.Max.x);
 6026:         if (parent_flags & ImGuiWindowFlags_NoScrollbar)
 6027:             corner_target.y = ImClamp(corner_target.y, limit_rect.Min.y, limit_rect.Max.y);
 6028:     }
 6029:     ImVec2 pos_min = ImLerp(corner_target, window->Pos, corner_norm);                // Expected window upper-left
 6030:     ImVec2 pos_max = ImLerp(window->Pos + window->Size, corner_target, corner_norm); // Expected window lower-right
 6031:     ImVec2 size_expected = pos_max - pos_min;
 6032:     ImVec2 size_constrained = CalcWindowSizeAfterConstraint(window, size_expected);
 6033:     *out_pos = pos_min;
 6034:     if (corner_norm.x == 0.0f)
 6035:         out_pos->x -= (size_constrained.x - size_expected.x);
 6036:     if (corner_norm.y == 0.0f)
 6037:         out_pos->y -= (size_constrained.y - size_expected.y);
 6038:     *out_size = size_constrained;
 6039: }
