11814:     if (g.NavInitRequest && g.NavLayer == window->DC.NavLayerCurrent && (item_flags & ImGuiItemFlags_Disabled) == 0)
11815:     {
11816:         // Even if 'ImGuiItemFlags_NoNavDefaultFocus' is on (typically collapse/close button) we record the first ResultId so they can be used as a fallback
11817:         const bool candidate_for_nav_default_focus = (item_flags & ImGuiItemFlags_NoNavDefaultFocus) == 0;
11818:         if (candidate_for_nav_default_focus || g.NavInitResult.ID == 0)
11819:         {
11820:             NavApplyItemToResult(&g.NavInitResult);
11821:         }
11822:         if (candidate_for_nav_default_focus)
11823:         {
11824:             g.NavInitRequest = false; // Found a match, clear request
11825:             NavUpdateAnyRequestFlag();
11826:         }
11827:     }
11828:     // Process Move Request (scoring for navigation)
11829:     // FIXME-NAV: Consider policy for double scoring (scoring from NavScoringRect + scoring from a rect wrapped according to current wrapping policy)
11830:     if (g.NavMoveScoringItems && (item_flags & ImGuiItemFlags_Disabled) == 0)
11831:     {
11832:         if ((g.NavMoveFlags & ImGuiNavMoveFlags_FocusApi) || (window->Flags & ImGuiWindowFlags_NoNavInputs) == 0)
11833:         {
11834:             const bool is_tabbing = (g.NavMoveFlags & ImGuiNavMoveFlags_IsTabbing) != 0;
11835:             if (is_tabbing)
