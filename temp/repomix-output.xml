<file path="shader_pixel_3d.hlsl">
  1: /*==============================================================================
  2: 
  3:    3D描画用ピクセルシェーダー [shader_pixel_3d.hlsl]
  4: 														 Author : Youhei Sato
  5: 														 Date   : 2025/05/15
  6: --------------------------------------------------------------------------------
  7: 
  8: ==============================================================================*/
  9: 
 10: cbuffer PS_CONSTANT_BUFFER : register(b0)
 11: {
 12:     float4 diffuse_color;
 13: };
 14: 
 15: cbuffer PS_CONSTANT_BUFFER : register(b1)
 16: {
 17:     float4 ambient_color;
 18: };
 19: 
 20: cbuffer PS_CONSTANT_BUFFER : register(b2)
 21: {
 22:     float4 directional_world_vector;
 23:     float4 directional_color;
 24: }
 25: 
 26: cbuffer PS_CONSTANT_BUFFER : register(b3)
 27: {
 28:     float3 eye_posW;
 29:     float  specular_power;
 30:     float4 specular_color;
 31: };
 32: 
 33: //cbuffer PS_CONSTANT_BUFFER : register(b4)
 34: //{
 35: //    float3 pointlight_posW; // 光源のワールド座標
 36: //    float pointlight_range; // 光源の届く最大範囲
 37: //    float4 pointlight_color;
 38: //};
 39: 
 40: struct PointLight
 41: {
 42:     float3 posW;
 43:     float range;
 44:     float4 color;
 45: };
 46: 
 47: cbuffer PS_CONSTANT_BUFFER : register(b4)
 48: {
 49:     PointLight pointlight[4];
 50:     int pointlight_count;
 51:     float3 pointlight_dummy;
 52: };
 53: 
 54: struct PS_INPUT
 55: {
 56:     float4 posH : SV_POSITION;
 57:     float4 posW : POSITION0;
 58:     float4 normalW : NORMAL0;
 59:     float4 color : COLOR0;
 60:     float2 uv : TEXCOORD0;
 61: };
 62: 
 63: Texture2D tex; // テクスチャ
 64: SamplerState samp; // テクスチャさんプラ
 65: 
 66: float4 main(PS_INPUT ps_in) : SV_TARGET
 67: {
 68:     float3 material_color = tex.Sample(samp, ps_in.uv).rgb * ps_in.color.rgb * diffuse_color.rgb;
 69:     
 70:     // 並行光源(diffuse light)
 71:     float4 normalW = normalize(ps_in.normalW);
 72:     float3 lightVec = normalize(-directional_world_vector.xyz);
 73:     //float dl = max(0, dot(lightVec, normalW.xyz)); // 通常の拡散光計算
 74:     float dl = (dot(lightVec, normalW.xyz) + 1.0f) * 0.5f; // 半分の明るさを加算(環境光の代わり)
 75:     float3 diffuse = material_color * directional_color.rgb * dl;
 76:     
 77:     // 環境光(ambient light)
 78:     float3 ambient = ambient_color.rgb * material_color;
 79:     
 80:     // スペキュラ計算
 81:     float3 toEye = normalize(eye_posW - ps_in.posW.xyz);
 82:     float3 r = reflect(-lightVec, normalW.xyz).xyz;
 83:     float t = pow(max(dot(r, toEye), 0.0f), specular_power); //反射大小
 84:     float3 specular = specular_color.rgb * t;
 85:     
 86:     float alpha =  tex.Sample(samp, ps_in.uv).a * ps_in.color.a * diffuse_color.a;
 87:     float3 final_color = ambient + diffuse + specular;
 88:     
 89:     // リムライト計算
 90:     float rim =1.0f - max(dot(normalW.xyz, toEye), 0.0f); // rim light 輪廓光
 91:     rim = pow(rim, 2.0f); // 強調
 92:     //final_color += float3(rim, rim, rim);
 93:     
 94:     // ポイントライト計算
 95:     for (int i = 0; i < pointlight_count;i++)
 96:     {
 97:         // 面と光源の距離
 98:         float3 lightToPixel = ps_in.posW.xyz - pointlight[i].posW;
 99:         float D = length(lightToPixel);
100:         // 距離減衰
101:         float A = pow(max(1.0f - 1.0f * D / pointlight[i].range, 0.0f), 2.0f);
102:         
103:         // 点と面の角度 
104:         float dl = max(0.0f, dot(-D, normalW.xyz));
105:         // float dl = (dot(lightVec, normalW.xyz) + 1.0f) * 0.5f; // 半分の明るさを加算(環境光の代わり)
106:                 
107:         final_color += material_color * pointlight[i].color.rgb * A * dl;
108:         
109:         // 点光源のスペキュラ計算
110:         float3 r_point = reflect(normalize(lightToPixel), normalW.xyz).xyz;
111:         float t_point = pow(max(dot(r_point, toEye), 0.0f), specular_power); //反射大小
112:         
113:         final_color += pointlight[i].color.rgb * t_point;
114:     }
115:     return float4(final_color, alpha);
116: }
</file>

