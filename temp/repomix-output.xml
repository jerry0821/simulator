1639: void ImGui::TableSetBgColor(ImGuiTableBgTarget target, ImU32 color, int column_n)
1640: {
1641:     ImGuiContext& g = *GImGui;
1642:     ImGuiTable* table = g.CurrentTable;
1643:     IM_ASSERT(target != ImGuiTableBgTarget_None);
1644:     if (table == NULL)
1645:     {
1646:         IM_ASSERT_USER_ERROR(table != NULL, "Call should only be done while in BeginTable() scope!");
1647:         return;
1648:     }
1649:     if (color == IM_COL32_DISABLE)
1650:         color = 0;
1651:     // We cannot draw neither the cell or row background immediately as we don't know the row height at this point in time.
1652:     switch (target)
1653:     {
1654:     case ImGuiTableBgTarget_CellBg:
1655:     {
1656:         if (table->RowPosY1 > table->InnerClipRect.Max.y) // Discard
1657:             return;
1658:         if (column_n == -1)
1659:             column_n = table->CurrentColumn;
1660:         if (!IM_BITARRAY_TESTBIT(table->VisibleMaskByIndex, column_n))
1661:             return;
1662:         if (table->RowCellDataCurrent < 0 || table->RowCellData[table->RowCellDataCurrent].Column != column_n)
1663:             table->RowCellDataCurrent++;
1664:         ImGuiTableCellData* cell_data = &table->RowCellData[table->RowCellDataCurrent];
1665:         cell_data->BgColor = color;
1666:         cell_data->Column = (ImGuiTableColumnIdx)column_n;
1667:         break;
1668:     }
1669:     case ImGuiTableBgTarget_RowBg0:
1670:     case ImGuiTableBgTarget_RowBg1:
1671:     {
1672:         if (table->RowPosY1 > table->InnerClipRect.Max.y) // Discard
1673:             return;
1674:         IM_ASSERT(column_n == -1);
1675:         int bg_idx = (target == ImGuiTableBgTarget_RowBg1) ? 1 : 0;
1676:         table->RowBgColor[bg_idx] = color;
1677:         break;
1678:     }
1679:     default:
1680:         IM_ASSERT(0);
1681:     }
1682: }
