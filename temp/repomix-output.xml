 2725: void ImGuiTextFilter::Build()
 2726: {
 2727:     Filters.resize(0);
 2728:     ImGuiTextRange input_range(InputBuf, InputBuf + ImStrlen(InputBuf));
 2729:     input_range.split(',', &Filters);
 2730:     CountGrep = 0;
 2731:     for (ImGuiTextRange& f : Filters)
 2732:     {
 2733:         while (f.b < f.e && ImCharIsBlankA(f.b[0]))
 2734:             f.b++;
 2735:         while (f.e > f.b && ImCharIsBlankA(f.e[-1]))
 2736:             f.e--;
 2737:         if (f.empty())
 2738:             continue;
 2739:         if (f.b[0] != '-')
 2740:             CountGrep += 1;
 2741:     }
 2742: }
 2743: bool ImGuiTextFilter::PassFilter(const char* text, const char* text_end) const
 2744: {
 2745:     if (Filters.Size == 0)
 2746:         return true;
 2747:     if (text == NULL)
 2748:         text = text_end = "";
 2749:     for (const ImGuiTextRange& f : Filters)
 2750:     {
 2751:         if (f.b == f.e)
 2752:             continue;
 2753:         if (f.b[0] == '-')
 2754:         {
 2755:             // Subtract
 2756:             if (ImStristr(text, text_end, f.b + 1, f.e) != NULL)
 2757:                 return false;
 2758:         }
 2759:         else
 2760:         {
 2761:             // Grep
 2762:             if (ImStristr(text, text_end, f.b, f.e) != NULL)
 2763:                 return true;
 2764:         }
 2765:     }
 2766:     // Implicit * grep
 2767:     if (CountGrep == 0)
 2768:         return true;
 2769:     return false;
 2770: }
