 33: /** @file postprocess.h
 34:  *  @brief Definitions for import post processing steps
 35:  */
 36: #pragma once
 37: #ifndef AI_POSTPROCESS_H_INC
 38: #define AI_POSTPROCESS_H_INC
 39: #include "types.h"
 40: #ifdef __GNUC__
 41: #   pragma GCC system_header
 42: #endif
 43: #ifdef __cplusplus
 44: extern "C" {
 45: #endif
 46: // -----------------------------------------------------------------------------------
 47: /** @enum  aiPostProcessSteps
 48:  *  @brief Defines the flags for all possible post processing steps.
 49:  *
 50:  *  @note Some steps are influenced by properties set on the Assimp::Importer itself
 51:  *
 52:  *  @see Assimp::Importer::ReadFile()
 53:  *  @see Assimp::Importer::SetPropertyInteger()
 54:  *  @see aiImportFile
 55:  *  @see aiImportFileEx
 56:  */
 57: // -----------------------------------------------------------------------------------
 58: enum aiPostProcessSteps
 59: {
 60:     // -------------------------------------------------------------------------
 61:     /** <hr>Calculates the tangents and bitangents for the imported meshes.
 62:      *
 63:      * Does nothing if a mesh does not have normals. You might want this post
 64:      * processing step to be executed if you plan to use tangent space calculations
 65:      * such as normal mapping  applied to the meshes. There's an importer property,
 66:      * <tt>#AI_CONFIG_PP_CT_MAX_SMOOTHING_ANGLE</tt>, which allows you to specify
 67:      * a maximum smoothing angle for the algorithm. However, usually you'll
 68:      * want to leave it at the default value.
 69:      */
 70:     aiProcess_CalcTangentSpace = 0x1,
 71:     // -------------------------------------------------------------------------
 72:     /** <hr>Identifies and joins identical vertex data sets within all
 73:      *  imported meshes.
 74:      *
 75:      * After this step is run, each mesh contains unique vertices,
 76:      * so a vertex may be used by multiple faces. You usually want
 77:      * to use this post processing step. If your application deals with
 78:      * indexed geometry, this step is compulsory or you'll just waste rendering
 79:      * time. <b>If this flag is not specified</b>, no vertices are referenced by
 80:      * more than one face and <b>no index buffer is required</b> for rendering.
 81:      */
 82:     aiProcess_JoinIdenticalVertices = 0x2,
 83:     // -------------------------------------------------------------------------
 84:     /** <hr>Converts all the imported data to a left-handed coordinate space.
 85:      *
 86:      * By default the data is returned in a right-handed coordinate space (which
 87:      * OpenGL prefers). In this space, +X points to the right,
 88:      * +Z points towards the viewer, and +Y points upwards. In the DirectX
 89:      * coordinate space +X points to the right, +Y points upwards, and +Z points
 90:      * away from the viewer.
 91:      *
 92:      * You'll probably want to consider this flag if you use Direct3D for
 93:      * rendering. The #aiProcess_ConvertToLeftHanded flag supersedes this
 94:      * setting and bundles all conversions typically required for D3D-based
 95:      * applications.
 96:      */
 97:     aiProcess_MakeLeftHanded = 0x4,
 98:     // -------------------------------------------------------------------------
 99:     /** <hr>Triangulates all faces of all meshes.
100:      *
101:      * By default the imported mesh data might contain faces with more than 3
102:      * indices. For rendering you'll usually want all faces to be triangles.
103:      * This post processing step splits up faces with more than 3 indices into
104:      * triangles. Line and point primitives are *not* modified! If you want
105:      * 'triangles only' with no other kinds of primitives, try the following
106:      * solution:
107:      * <ul>
108:      * <li>Specify both #aiProcess_Triangulate and #aiProcess_SortByPType </li>
109:      * <li>Ignore all point and line meshes when you process assimp's output</li>
110:      * </ul>
111:      */
112:     aiProcess_Triangulate = 0x8,
113:     // -------------------------------------------------------------------------
114:     /** <hr>Removes some parts of the data structure (animations, materials,
115:      *  light sources, cameras, textures, vertex components).
116:      *
117:      * The  components to be removed are specified in a separate
118:      * importer property, <tt>#AI_CONFIG_PP_RVC_FLAGS</tt>. This is quite useful
119:      * if you don't need all parts of the output structure. Vertex colors
120:      * are rarely used today for example... Calling this step to remove unneeded
121:      * data from the pipeline as early as possible results in increased
122:      * performance and a more optimized output data structure.
123:      * This step is also useful if you want to force Assimp to recompute
124:      * normals or tangents. The corresponding steps don't recompute them if
125:      * they're already there (loaded from the source asset). By using this
126:      * step you can make sure they are NOT there.
127:      *
128:      * This flag is a poor one, mainly because its purpose is usually
129:      * misunderstood. Consider the following case: a 3D model has been exported
130:      * from a CAD app, and it has per-face vertex colors. Vertex positions can't be
131:      * shared, thus the #aiProcess_JoinIdenticalVertices step fails to
132:      * optimize the data because of these nasty little vertex colors.
133:      * Most apps don't even process them, so it's all for nothing. By using
134:      * this step, unneeded components are excluded as early as possible
135:      * thus opening more room for internal optimizations.
136:      */
137:     aiProcess_RemoveComponent = 0x10,
138:     // -------------------------------------------------------------------------
139:     /** <hr>Generates normals for all faces of all meshes.
140:      *
141:      * This is ignored if normals are already there at the time this flag
142:      * is evaluated. Model importers try to load them from the source file, so
143:      * they're usually already there. Face normals are shared between all points
144:      * of a single face, so a single point can have multiple normals, which
145:      * forces the library to duplicate vertices in some cases.
146:      * #aiProcess_JoinIdenticalVertices is *senseless* then.
147:      *
148:      * This flag may not be specified together with #aiProcess_GenSmoothNormals.
149:      */
150:     aiProcess_GenNormals = 0x20,
151:     // -------------------------------------------------------------------------
152:     /** <hr>Generates smooth normals for all vertices in the mesh.
153:     *
154:     * This is ignored if normals are already there at the time this flag
155:     * is evaluated. Model importers try to load them from the source file, so
156:     * they're usually already there.
157:     *
158:     * This flag may not be specified together with
159:     * #aiProcess_GenNormals. There's a importer property,
160:     * <tt>#AI_CONFIG_PP_GSN_MAX_SMOOTHING_ANGLE</tt> which allows you to specify
161:     * an angle maximum for the normal smoothing algorithm. Normals exceeding
162:     * this limit are not smoothed, resulting in a 'hard' seam between two faces.
163:     * Using a decent angle here (e.g. 80 degrees) results in very good visual
164:     * appearance.
165:     */
166:     aiProcess_GenSmoothNormals = 0x40,
167:     // -------------------------------------------------------------------------
168:     /** <hr>Splits large meshes into smaller sub-meshes.
169:     *
170:     * This is quite useful for real-time rendering, where the number of triangles
171:     * which can be maximally processed in a single draw-call is limited
172:     * by the video driver/hardware. The maximum vertex buffer is usually limited
173:     * too. Both requirements can be met with this step: you may specify both a
174:     * triangle and vertex limit for a single mesh.
175:     *
176:     * The split limits can (and should!) be set through the
177:     * <tt>#AI_CONFIG_PP_SLM_VERTEX_LIMIT</tt> and <tt>#AI_CONFIG_PP_SLM_TRIANGLE_LIMIT</tt>
178:     * importer properties. The default values are <tt>#AI_SLM_DEFAULT_MAX_VERTICES</tt> and
179:     * <tt>#AI_SLM_DEFAULT_MAX_TRIANGLES</tt>.
180:     *
181:     * Note that splitting is generally a time-consuming task, but only if there's
182:     * something to split. The use of this step is recommended for most users.
183:     */
184:     aiProcess_SplitLargeMeshes = 0x80,
185:     // -------------------------------------------------------------------------
186:     /** <hr>Removes the node graph and pre-transforms all vertices with
187:     * the local transformation matrices of their nodes.
188:     *
189:     * If the resulting scene can be reduced to a single mesh, with a single
190:     * material, no lights, and no cameras, then the output scene will contain
191:     * only a root node (with no children) that references the single mesh.
192:     * Otherwise, the output scene will be reduced to a root node with a single
193:     * level of child nodes, each one referencing one mesh, and each mesh
194:     * referencing one material.
195:     *
196:     * In either case, for rendering, you can
197:     * simply render all meshes in order - you don't need to pay
198:     * attention to local transformations and the node hierarchy.
199:     * Animations are removed during this step.
200:     * This step is intended for applications without a scenegraph.
201:     * The step CAN cause some problems: if e.g. a mesh of the asset
202:     * contains normals and another, using the same material index, does not,
203:     * they will be brought together, but the first meshes's part of
204:     * the normal list is zeroed. However, these artifacts are rare.
205:     * @note The <tt>#AI_CONFIG_PP_PTV_NORMALIZE</tt> configuration property
206:     * can be set to normalize the scene's spatial dimension to the -1...1
207:     * range.
208:     */
209:     aiProcess_PreTransformVertices = 0x100,
210:     // -------------------------------------------------------------------------
211:     /** <hr>Limits the number of bones simultaneously affecting a single vertex
212:     *  to a maximum value.
213:     *
214:     * If any vertex is affected by more than the maximum number of bones, the least
215:     * important vertex weights are removed and the remaining vertex weights are
216:     * renormalized so that the weights still sum up to 1.
217:     * The default bone weight limit is 4 (defined as <tt>#AI_LMW_MAX_WEIGHTS</tt> in
218:     * config.h), but you can use the <tt>#AI_CONFIG_PP_LBW_MAX_WEIGHTS</tt> importer
219:     * property to supply your own limit to the post processing step.
220:     *
221:     * If you intend to perform the skinning in hardware, this post processing
222:     * step might be of interest to you.
223:     */
224:     aiProcess_LimitBoneWeights = 0x200,
225:     // -------------------------------------------------------------------------
226:     /** <hr>Validates the imported scene data structure.
227:      * This makes sure that all indices are valid, all animations and
228:      * bones are linked correctly, all material references are correct .. etc.
229:      *
230:      * It is recommended that you capture Assimp's log output if you use this flag,
231:      * so you can easily find out what's wrong if a file fails the
232:      * validation. The validator is quite strict and will find *all*
233:      * inconsistencies in the data structure... It is recommended that plugin
234:      * developers use it to debug their loaders. There are two types of
235:      * validation failures:
236:      * <ul>
237:      * <li>Error: There's something wrong with the imported data. Further
238:      *   postprocessing is not possible and the data is not usable at all.
239:      *   The import fails. #Importer::GetErrorString() or #aiGetErrorString()
240:      *   carry the error message around.</li>
241:      * <li>Warning: There are some minor issues (e.g. 1000000 animation
242:      *   keyframes with the same time), but further postprocessing and use
243:      *   of the data structure is still safe. Warning details are written
244:      *   to the log file, <tt>#AI_SCENE_FLAGS_VALIDATION_WARNING</tt> is set
245:      *   in #aiScene::mFlags</li>
246:      * </ul>
247:      *
248:      * This post-processing step is not time-consuming. Its use is not
249:      * compulsory, but recommended.
250:     */
251:     aiProcess_ValidateDataStructure = 0x400,
252:     // -------------------------------------------------------------------------
253:     /** <hr>Reorders triangles for better vertex cache locality.
254:      *
255:      * The step tries to improve the ACMR (average post-transform vertex cache
256:      * miss ratio) for all meshes. The implementation runs in O(n) and is
257:      * roughly based on the 'tipsify' algorithm (see <a href="
258:      * http://www.cs.princeton.edu/gfx/pubs/Sander_2007_%3ETR/tipsy.pdf">this
259:      * paper</a>).
260:      *
261:      * If you intend to render huge models in hardware, this step might
262:      * be of interest to you. The <tt>#AI_CONFIG_PP_ICL_PTCACHE_SIZE</tt>
263:      * importer property can be used to fine-tune the cache optimization.
264:      */
265:     aiProcess_ImproveCacheLocality = 0x800,
266:     // -------------------------------------------------------------------------
267:     /** <hr>Searches for redundant/unreferenced materials and removes them.
268:      *
269:      * This is especially useful in combination with the
270:      * #aiProcess_PreTransformVertices and #aiProcess_OptimizeMeshes flags.
271:      * Both join small meshes with equal characteristics, but they can't do
272:      * their work if two meshes have different materials. Because several
273:      * material settings are lost during Assimp's import filters,
274:      * (and because many exporters don't check for redundant materials), huge
275:      * models often have materials which are are defined several times with
276:      * exactly the same settings.
277:      *
278:      * Several material settings not contributing to the final appearance of
279:      * a surface are ignored in all comparisons (e.g. the material name).
280:      * So, if you're passing additional information through the
281:      * content pipeline (probably using *magic* material names), don't
282:      * specify this flag. Alternatively take a look at the
283:      * <tt>#AI_CONFIG_PP_RRM_EXCLUDE_LIST</tt> importer property.
284:      */
285:     aiProcess_RemoveRedundantMaterials = 0x1000,
286:     // -------------------------------------------------------------------------
287:     /** <hr>This step tries to determine which meshes have normal vectors
288:      * that are facing inwards and inverts them.
289:      *
290:      * The algorithm is simple but effective:
291:      * the bounding box of all vertices + their normals is compared against
292:      * the volume of the bounding box of all vertices without their normals.
293:      * This works well for most objects, problems might occur with planar
294:      * surfaces. However, the step tries to filter such cases.
295:      * The step inverts all in-facing normals. Generally it is recommended
296:      * to enable this step, although the result is not always correct.
297:     */
298:     aiProcess_FixInfacingNormals = 0x2000,
299:     // -------------------------------------------------------------------------
300:     /**
301:      * This step generically populates aiBone->mArmature and aiBone->mNode generically
302:      * The point of these is it saves you later having to calculate these elements
303:      * This is useful when handling rest information or skin information
304:      * If you have multiple armatures on your models we strongly recommend enabling this
305:      * Instead of writing your own multi-root, multi-armature lookups we have done the
306:      * hard work for you :)
307:    */
308:     aiProcess_PopulateArmatureData = 0x4000,
309:     // -------------------------------------------------------------------------
310:     /** <hr>This step splits meshes with more than one primitive type in
311:      *  homogeneous sub-meshes.
312:      *
313:      *  The step is executed after the triangulation step. After the step
314:      *  returns, just one bit is set in aiMesh::mPrimitiveTypes. This is
315:      *  especially useful for real-time rendering where point and line
316:      *  primitives are often ignored or rendered separately.
317:      *  You can use the <tt>#AI_CONFIG_PP_SBP_REMOVE</tt> importer property to
318:      *  specify which primitive types you need. This can be used to easily
319:      *  exclude lines and points, which are rarely used, from the import.
320:     */
321:     aiProcess_SortByPType = 0x8000,
322:     // -------------------------------------------------------------------------
323:     /** <hr>This step searches all meshes for degenerate primitives and
324:      *  converts them to proper lines or points.
325:      *
326:      * A face is 'degenerate' if one or more of its points are identical.
327:      * To have the degenerate stuff not only detected and collapsed but
328:      * removed, try one of the following procedures:
329:      * <br><b>1.</b> (if you support lines and points for rendering but don't
330:      *    want the degenerates)<br>
331:      * <ul>
332:      *   <li>Specify the #aiProcess_FindDegenerates flag.
333:      *   </li>
334:      *   <li>Set the <tt>#AI_CONFIG_PP_FD_REMOVE</tt> importer property to
335:      *       1. This will cause the step to remove degenerate triangles from the
336:      *       import as soon as they're detected. They won't pass any further
337:      *       pipeline steps.
338:      *   </li>
339:      * </ul>
340:      * <br><b>2.</b>(if you don't support lines and points at all)<br>
341:      * <ul>
342:      *   <li>Specify the #aiProcess_FindDegenerates flag.
343:      *   </li>
344:      *   <li>Specify the #aiProcess_SortByPType flag. This moves line and
345:      *     point primitives to separate meshes.
346:      *   </li>
347:      *   <li>Set the <tt>#AI_CONFIG_PP_SBP_REMOVE</tt> importer property to
348:      *       @code aiPrimitiveType_POINTS | aiPrimitiveType_LINES
349:      *       @endcode to cause SortByPType to reject point
350:      *       and line meshes from the scene.
351:      *   </li>
352:      * </ul>
353:      *
354:      * This step also removes very small triangles with a surface area smaller
355:      * than 10^-6. If you rely on having these small triangles, or notice holes
356:      * in your model, set the property <tt>#AI_CONFIG_PP_FD_CHECKAREA</tt> to
357:      * false.
358:      * @note Degenerate polygons are not necessarily evil and that's why
359:      * they're not removed by default. There are several file formats which
360:      * don't support lines or points, and some exporters bypass the
361:      * format specification and write them as degenerate triangles instead.
362:     */
363:     aiProcess_FindDegenerates = 0x10000,
364:     // -------------------------------------------------------------------------
365:     /** <hr>This step searches all meshes for invalid data, such as zeroed
366:      *  normal vectors or invalid UV coords and removes/fixes them. This is
367:      *  intended to get rid of some common exporter errors.
368:      *
369:      * This is especially useful for normals. If they are invalid, and
370:      * the step recognizes this, they will be removed and can later
371:      * be recomputed, i.e. by the #aiProcess_GenSmoothNormals flag.<br>
372:      * The step will also remove meshes that are infinitely small and reduce
373:      * animation tracks consisting of hundreds if redundant keys to a single
374:      * key. The <tt>AI_CONFIG_PP_FID_ANIM_ACCURACY</tt> config property decides
375:      * the accuracy of the check for duplicate animation tracks.
376:     */
377:     aiProcess_FindInvalidData = 0x20000,
378:     // -------------------------------------------------------------------------
379:     /** <hr>This step converts non-UV mappings (such as spherical or
380:      *  cylindrical mapping) to proper texture coordinate channels.
381:      *
382:      * Most applications will support UV mapping only, so you will
383:      * probably want to specify this step in every case. Note that Assimp is not
384:      * always able to match the original mapping implementation of the
385:      * 3D app which produced a model perfectly. It's always better to let the
386:      * modelling app compute the UV channels - 3ds max, Maya, Blender,
387:      * LightWave, and Modo do this for example.
388:      *
389:      * @note If this step is not requested, you'll need to process the
390:      * <tt>#AI_MATKEY_MAPPING</tt> material property in order to display all assets
391:      * properly.
392:      */
393:     aiProcess_GenUVCoords = 0x40000,
394:     // -------------------------------------------------------------------------
395:     /** <hr>This step applies per-texture UV transformations and bakes
396:      *  them into stand-alone vtexture coordinate channels.
397:      *
398:      * UV transformations are specified per-texture - see the
399:      * <tt>#AI_MATKEY_UVTRANSFORM</tt> material key for more information.
400:      * This step processes all textures with
401:      * transformed input UV coordinates and generates a new (pre-transformed) UV channel
402:      * which replaces the old channel. Most applications won't support UV
403:      * transformations, so you will probably want to specify this step.
404:      *
405:      * @note UV transformations are usually implemented in real-time apps by
406:      * transforming texture coordinates at vertex shader stage with a 3x3
407:      * (homogeneous) transformation matrix.
408:     */
409:     aiProcess_TransformUVCoords = 0x80000,
410:     // -------------------------------------------------------------------------
411:     /** <hr>This step searches for duplicate meshes and replaces them
412:      *  with references to the first mesh.
413:      *
414:      *  This step takes a while, so don't use it if speed is a concern.
415:      *  Its main purpose is to workaround the fact that many export
416:      *  file formats don't support instanced meshes, so exporters need to
417:      *  duplicate meshes. This step removes the duplicates again. Please
418:      *  note that Assimp does not currently support per-node material
419:      *  assignment to meshes, which means that identical meshes with
420:      *  different materials are currently *not* joined, although this is
421:      *  planned for future versions.
422:      */
423:     aiProcess_FindInstances = 0x100000,
424:     // -------------------------------------------------------------------------
425:     /** <hr>A post-processing step to reduce the number of meshes.
426:      *
427:      *  This will, in fact, reduce the number of draw calls.
428:      *
429:      *  This is a very effective optimization and is recommended to be used
430:      *  together with #aiProcess_OptimizeGraph, if possible. The flag is fully
431:      *  compatible with both #aiProcess_SplitLargeMeshes and #aiProcess_SortByPType.
432:     */
433:     aiProcess_OptimizeMeshes  = 0x200000,
434:     // -------------------------------------------------------------------------
435:     /** <hr>A post-processing step to optimize the scene hierarchy.
436:      *
437:      *  Nodes without animations, bones, lights or cameras assigned are
438:      *  collapsed and joined.
439:      *
440:      *  Node names can be lost during this step. If you use special 'tag nodes'
441:      *  to pass additional information through your content pipeline, use the
442:      *  <tt>#AI_CONFIG_PP_OG_EXCLUDE_LIST</tt> importer property to specify a
443:      *  list of node names you want to be kept. Nodes matching one of the names
444:      *  in this list won't be touched or modified.
445:      *
446:      *  Use this flag with caution. Most simple files will be collapsed to a
447:      *  single node, so complex hierarchies are usually completely lost. This is not
448:      *  useful for editor environments, but probably a very effective
449:      *  optimization if you just want to get the model data, convert it to your
450:      *  own format, and render it as fast as possible.
451:      *
452:      *  This flag is designed to be used with #aiProcess_OptimizeMeshes for best
453:      *  results.
454:      *
455:      *  @note 'Crappy' scenes with thousands of extremely small meshes packed
456:      *  in deeply nested nodes exist for almost all file formats.
457:      *  #aiProcess_OptimizeMeshes in combination with #aiProcess_OptimizeGraph
458:      *  usually fixes them all and makes them renderable.
459:     */
460:     aiProcess_OptimizeGraph  = 0x400000,
461:     // -------------------------------------------------------------------------
462:     /** <hr>This step flips all UV coordinates along the y-axis and adjusts
463:      * material settings and bitangents accordingly.
464:      *
465:      * <b>Output UV coordinate system:</b>
466:      * @code
467:      * 0y|0y ---------- 1x|0y
468:      * |                 |
469:      * |                 |
470:      * |                 |
471:      * 0x|1y ---------- 1x|1y
472:      * @endcode
473:      *
474:      * You'll probably want to consider this flag if you use Direct3D for
475:      * rendering. The #aiProcess_ConvertToLeftHanded flag supersedes this
476:      * setting and bundles all conversions typically required for D3D-based
477:      * applications.
478:     */
479:     aiProcess_FlipUVs = 0x800000,
480:     // -------------------------------------------------------------------------
481:     /** <hr>This step adjusts the output face winding order to be CW.
482:      *
483:      * The default face winding order is counter clockwise (CCW).
484:      *
485:      * <b>Output face order:</b>
486:      * @code
487:      *       x2
488:      *
489:      *                         x0
490:      *  x1
491:      * @endcode
492:     */
493:     aiProcess_FlipWindingOrder  = 0x1000000,
494:     // -------------------------------------------------------------------------
495:     /** <hr>This step splits meshes with many bones into sub-meshes so that each
496:      * sub-mesh has fewer or as many bones as a given limit.
497:     */
498:     aiProcess_SplitByBoneCount  = 0x2000000,
499:     // -------------------------------------------------------------------------
500:     /** <hr>This step removes bones losslessly or according to some threshold.
501:      *
502:      *  In some cases (i.e. formats that require it) exporters are forced to
503:      *  assign dummy bone weights to otherwise static meshes assigned to
504:      *  animated meshes. Full, weight-based skinning is expensive while
505:      *  animating nodes is extremely cheap, so this step is offered to clean up
506:      *  the data in that regard.
507:      *
508:      *  Use <tt>#AI_CONFIG_PP_DB_THRESHOLD</tt> to control this.
509:      *  Use <tt>#AI_CONFIG_PP_DB_ALL_OR_NONE</tt> if you want bones removed if and
510:      *  only if all bones within the scene qualify for removal.
511:     */
512:     aiProcess_Debone  = 0x4000000,
513:     // -------------------------------------------------------------------------
514:     /** <hr>This step will perform a global scale of the model.
515:     *
516:     *  Some importers are providing a mechanism to define a scaling unit for the
517:     *  model. This post processing step can be used to do so. You need to get the
518:     *  global scaling from your importer settings like in FBX. Use the flag
519:     *  AI_CONFIG_GLOBAL_SCALE_FACTOR_KEY from the global property table to configure this.
520:     *
521:     *  Use <tt>#AI_CONFIG_GLOBAL_SCALE_FACTOR_KEY</tt> to setup the global scaling factor.
522:     */
523:     aiProcess_GlobalScale = 0x8000000,
524:     // -------------------------------------------------------------------------
525:     /** <hr>A postprocessing step to embed of textures.
526:      *
527:      *  This will remove external data dependencies for textures.
528:      *  If a texture's file does not exist at the specified path
529:      *  (due, for instance, to an absolute path generated on another system),
530:      *  it will check if a file with the same name exists at the root folder
531:      *  of the imported model. And if so, it uses that.
532:      */
533:     aiProcess_EmbedTextures  = 0x10000000,
534:     // aiProcess_GenEntityMeshes = 0x100000,
535:     // aiProcess_OptimizeAnimations = 0x200000
536:     // aiProcess_FixTexturePaths = 0x200000
537:     aiProcess_ForceGenNormals = 0x20000000,
538:     // -------------------------------------------------------------------------
539:     /** <hr>Drops normals for all faces of all meshes.
540:      *
541:      * This is ignored if no normals are present.
542:      * Face normals are shared between all points of a single face,
543:      * so a single point can have multiple normals, which
544:      * forces the library to duplicate vertices in some cases.
545:      * #aiProcess_JoinIdenticalVertices is *senseless* then.
546:      * This process gives sense back to aiProcess_JoinIdenticalVertices
547:      */
548:     aiProcess_DropNormals = 0x40000000,
549:     // -------------------------------------------------------------------------
550:     /**
551:      */
552:     aiProcess_GenBoundingBoxes = 0x80000000
553: };
554: // ---------------------------------------------------------------------------------------
555: /** @def aiProcess_ConvertToLeftHanded
556:  *  @brief Shortcut flag for Direct3D-based applications.
557:  *
558:  *  Supersedes the #aiProcess_MakeLeftHanded and #aiProcess_FlipUVs and
559:  *  #aiProcess_FlipWindingOrder flags.
560:  *  The output data matches Direct3D's conventions: left-handed geometry, upper-left
561:  *  origin for UV coordinates and finally clockwise face order, suitable for CCW culling.
562:  *
563:  *  @deprecated
564:  */
565: #define aiProcess_ConvertToLeftHanded ( \
566:     aiProcess_MakeLeftHanded     | \
567:     aiProcess_FlipUVs            | \
568:     aiProcess_FlipWindingOrder   | \
569:     0 )
570: // ---------------------------------------------------------------------------------------
571: /** @def aiProcessPreset_TargetRealtime_Fast
572:  *  @brief Default postprocess configuration optimizing the data for real-time rendering.
573:  *
574:  *  Applications would want to use this preset to load models on end-user PCs,
575:  *  maybe for direct use in game.
576:  *
577:  * If you're using DirectX, don't forget to combine this value with
578:  * the #aiProcess_ConvertToLeftHanded step. If you don't support UV transformations
579:  * in your application apply the #aiProcess_TransformUVCoords step, too.
580:  *  @note Please take the time to read the docs for the steps enabled by this preset.
581:  *  Some of them offer further configurable properties, while some of them might not be of
582:  *  use for you so it might be better to not specify them.
583:  */
584: #define aiProcessPreset_TargetRealtime_Fast ( \
585:     aiProcess_CalcTangentSpace      |  \
586:     aiProcess_GenNormals            |  \
587:     aiProcess_JoinIdenticalVertices |  \
588:     aiProcess_Triangulate           |  \
589:     aiProcess_GenUVCoords           |  \
590:     aiProcess_SortByPType           |  \
591:     0 )
592:  // ---------------------------------------------------------------------------------------
593:  /** @def aiProcessPreset_TargetRealtime_Quality
594:   *  @brief Default postprocess configuration optimizing the data for real-time rendering.
595:   *
596:   *  Unlike #aiProcessPreset_TargetRealtime_Fast, this configuration
597:   *  performs some extra optimizations to improve rendering speed and
598:   *  to minimize memory usage. It could be a good choice for a level editor
599:   *  environment where import speed is not so important.
600:   *
601:   *  If you're using DirectX, don't forget to combine this value with
602:   *  the #aiProcess_ConvertToLeftHanded step. If you don't support UV transformations
603:   *  in your application apply the #aiProcess_TransformUVCoords step, too.
604:   *  @note Please take the time to read the docs for the steps enabled by this preset.
605:   *  Some of them offer further configurable properties, while some of them might not be
606:   *  of use for you so it might be better to not specify them.
607:   */
608: #define aiProcessPreset_TargetRealtime_Quality ( \
609:     aiProcess_CalcTangentSpace              |  \
610:     aiProcess_GenSmoothNormals              |  \
611:     aiProcess_JoinIdenticalVertices         |  \
612:     aiProcess_ImproveCacheLocality          |  \
613:     aiProcess_LimitBoneWeights              |  \
614:     aiProcess_RemoveRedundantMaterials      |  \
615:     aiProcess_SplitLargeMeshes              |  \
616:     aiProcess_Triangulate                   |  \
617:     aiProcess_GenUVCoords                   |  \
618:     aiProcess_SortByPType                   |  \
619:     aiProcess_FindDegenerates               |  \
620:     aiProcess_FindInvalidData               |  \
621:     0 )
622:  // ---------------------------------------------------------------------------------------
623:  /** @def aiProcessPreset_TargetRealtime_MaxQuality
624:   *  @brief Default postprocess configuration optimizing the data for real-time rendering.
625:   *
626:   *  This preset enables almost every optimization step to achieve perfectly
627:   *  optimized data. It's your choice for level editor environments where import speed
628:   *  is not important.
629:   *
630:   *  If you're using DirectX, don't forget to combine this value with
631:   *  the #aiProcess_ConvertToLeftHanded step. If you don't support UV transformations
632:   *  in your application, apply the #aiProcess_TransformUVCoords step, too.
633:   *  @note Please take the time to read the docs for the steps enabled by this preset.
634:   *  Some of them offer further configurable properties, while some of them might not be
635:   *  of use for you so it might be better to not specify them.
636:   */
637: #define aiProcessPreset_TargetRealtime_MaxQuality ( \
638:     aiProcessPreset_TargetRealtime_Quality   |  \
639:     aiProcess_FindInstances                  |  \
640:     aiProcess_ValidateDataStructure          |  \
641:     aiProcess_OptimizeMeshes                 |  \
642:     0 )
643: #ifdef __cplusplus
644: } // end of extern "C"
645: #endif
646: #endif // AI_POSTPROCESS_H_INC
</file>

