235:   const int segments=24;
236:   const int vpr=segments+1;
237:   XMMATRIX view=XMLoadFloat4x4(&Camera_GetMatrix()),proj=XMLoadFloat4x4(&Camera_GetPerspectiveMatrix());
238:   Shader3D_Begin();
239:   Shader3D_SetViewMatrix(view);
240:   Shader3D_SetProjMatrix(proj);
