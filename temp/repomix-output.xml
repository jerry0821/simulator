397: void CreateSlimeHurtEffect(DirectX::XMFLOAT3 centerPos)
398: {
399:     int count = 20;
400:     for (int i = 0; i < count; i++)
401:     {
402:         float angle = (rand() % 360) * 3.14159f / 180.0f;
403:         float speed = 2.0f + (rand() % 100) * 0.02f;
404:         XMFLOAT3 vel = {
