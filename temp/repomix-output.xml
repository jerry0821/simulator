 43: 	bd.Usage = D3D11_USAGE_DYNAMIC;
 44: 	bd.ByteWidth = sizeof(Vertex) * NUM_VERTEX;
 45: 	bd.BindFlags = D3D11_BIND_VERTEX_BUFFER;
 46: 	bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
 47: 	g_pDevice->CreateBuffer(&bd, NULL, &g_pVertexBuffer);
 48: }
