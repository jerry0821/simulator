 709:     _IdxWritePtr += 6;
 710: }
 711: void ImDrawList::PrimQuadUV(const ImVec2& a, const ImVec2& b, const ImVec2& c, const ImVec2& d, const ImVec2& uv_a, const ImVec2& uv_b, const ImVec2& uv_c, const ImVec2& uv_d, ImU32 col)
 712: {
 713:     ImDrawIdx idx = (ImDrawIdx)_VtxCurrentIdx;
 714:     _IdxWritePtr[0] = idx; _IdxWritePtr[1] = (ImDrawIdx)(idx+1); _IdxWritePtr[2] = (ImDrawIdx)(idx+2);
 715:     _IdxWritePtr[3] = idx; _IdxWritePtr[4] = (ImDrawIdx)(idx+2); _IdxWritePtr[5] = (ImDrawIdx)(idx+3);
 716:     _VtxWritePtr[0].pos = a; _VtxWritePtr[0].uv = uv_a; _VtxWritePtr[0].col = col;
 717:     _VtxWritePtr[1].pos = b; _VtxWritePtr[1].uv = uv_b; _VtxWritePtr[1].col = col;
 718:     _VtxWritePtr[2].pos = c; _VtxWritePtr[2].uv = uv_c; _VtxWritePtr[2].col = col;
 719:     _VtxWritePtr[3].pos = d; _VtxWritePtr[3].uv = uv_d; _VtxWritePtr[3].col = col;
 720:     _VtxWritePtr += 4;
 721:     _VtxCurrentIdx += 4;
 722:     _IdxWritePtr += 6;
 723: }
 724: // On AddPolyline() and AddConvexPolyFilled() we intentionally avoid using ImVec2 and superfluous function calls to optimize debug/non-inlined builds.
 725: // - Those macros expects l-values and need to be used as their own statement.
 726: // - Those macros are intentionally not surrounded by the 'do {} while (0)' idiom because even that translates to runtime with debug compilers.
 727: #define IM_NORMALIZE2F_OVER_ZERO(VX,VY)     { float d2 = VX*VX + VY*VY; if (d2 > 0.0f) { float inv_len = ImRsqrt(d2); VX *= inv_len; VY *= inv_len; } } (void)0
 728: #define IM_FIXNORMAL2F_MAX_INVLEN2          100.0f // 500.0f (see #4053, #3366)
 729: #define IM_FIXNORMAL2F(VX,VY)               { float d2 = VX*VX + VY*VY; if (d2 > 0.000001f) { float inv_len2 = 1.0f / d2; if (inv_len2 > IM_FIXNORMAL2F_MAX_INVLEN2) inv_len2 = IM_FIXNORMAL2F_MAX_INVLEN2; VX *= inv_len2; VY *= inv_len2; } } (void)0
 730: // TODO: Thickness anti-aliased lines cap are missing their AA fringe.
 731: // We avoid using the ImVec2 math operators here to reduce cost to a minimum for debug/non-inlined builds.
 732: void ImDrawList::AddPolyline(const ImVec2* points, const int points_count, ImU32 col, ImDrawFlags flags, float thickness)
 733: {
 734:     if (points_count < 2 || (col & IM_COL32_A_MASK) == 0)
 735:         return;
 736:     const bool closed = (flags & ImDrawFlags_Closed) != 0;
 737:     const ImVec2 opaque_uv = _Data->TexUvWhitePixel;
 738:     const int count = closed ? points_count : points_count - 1; // The number of line segments we need to draw
 739:     const bool thick_line = (thickness > _FringeScale);
 740:     if (Flags & ImDrawListFlags_AntiAliasedLines)
 741:     {
 742:         // Anti-aliased stroke
 743:         const float AA_SIZE = _FringeScale;
 744:         const ImU32 col_trans = col & ~IM_COL32_A_MASK;
 745:         // Thicknesses <1.0 should behave like thickness 1.0
 746:         thickness = ImMax(thickness, 1.0f);
 747:         const int integer_thickness = (int)thickness;
 748:         const float fractional_thickness = thickness - integer_thickness;
 749:         // Do we want to draw this line using a texture?
 750:         // - For now, only draw integer-width lines using textures to avoid issues with the way scaling occurs, could be improved.
 751:         // - If AA_SIZE is not 1.0f we cannot use the texture path.
 752:         const bool use_texture = (Flags & ImDrawListFlags_AntiAliasedLinesUseTex) && (integer_thickness < IM_DRAWLIST_TEX_LINES_WIDTH_MAX) && (fractional_thickness <= 0.00001f) && (AA_SIZE == 1.0f);
 753:         // We should never hit this, because NewFrame() doesn't set ImDrawListFlags_AntiAliasedLinesUseTex unless ImFontAtlasFlags_NoBakedLines is off
 754:         IM_ASSERT_PARANOID(!use_texture || !(_Data->Font->OwnerAtlas->Flags & ImFontAtlasFlags_NoBakedLines));
 755:         const int idx_count = use_texture ? (count * 6) : (thick_line ? count * 18 : count * 12);
 756:         const int vtx_count = use_texture ? (points_count * 2) : (thick_line ? points_count * 4 : points_count * 3);
 757:         PrimReserve(idx_count, vtx_count);
 758:         // Temporary buffer
 759:         // The first <points_count> items are normals at each line point, then after that there are either 2 or 4 temp points for each line point
 760:         _Data->TempBuffer.reserve_discard(points_count * ((use_texture || !thick_line) ? 3 : 5));
 761:         ImVec2* temp_normals = _Data->TempBuffer.Data;
 762:         ImVec2* temp_points = temp_normals + points_count;
 763:         // Calculate normals (tangents) for each line segment
 764:         for (int i1 = 0; i1 < count; i1++)
 765:         {
 766:             const int i2 = (i1 + 1) == points_count ? 0 : i1 + 1;
 767:             float dx = points[i2].x - points[i1].x;
 768:             float dy = points[i2].y - points[i1].y;
 769:             IM_NORMALIZE2F_OVER_ZERO(dx, dy);
 770:             temp_normals[i1].x = dy;
 771:             temp_normals[i1].y = -dx;
 772:         }
 773:         if (!closed)
 774:             temp_normals[points_count - 1] = temp_normals[points_count - 2];
 775:         // If we are drawing a one-pixel-wide line without a texture, or a textured line of any width, we only need 2 or 3 vertices per point
 776:         if (use_texture || !thick_line)
 777:         {
 778:             // [PATH 1] Texture-based lines (thick or non-thick)
 779:             // [PATH 2] Non texture-based lines (non-thick)
 780:             // The width of the geometry we need to draw - this is essentially <thickness> pixels for the line itself, plus "one pixel" for AA.
 781:             // - In the texture-based path, we don't use AA_SIZE here because the +1 is tied to the generated texture
 782:             //   (see ImFontAtlasBuildRenderLinesTexData() function), and so alternate values won't work without changes to that code.
 783:             // - In the non texture-based paths, we would allow AA_SIZE to potentially be != 1.0f with a patch (e.g. fringe_scale patch to
 784:             //   allow scaling geometry while preserving one-screen-pixel AA fringe).
 785:             const float half_draw_size = use_texture ? ((thickness * 0.5f) + 1) : AA_SIZE;
 786:             // If line is not closed, the first and last points need to be generated differently as there are no normals to blend
 787:             if (!closed)
 788:             {
 789:                 temp_points[0] = points[0] + temp_normals[0] * half_draw_size;
 790:                 temp_points[1] = points[0] - temp_normals[0] * half_draw_size;
 791:                 temp_points[(points_count-1)*2+0] = points[points_count-1] + temp_normals[points_count-1] * half_draw_size;
 792:                 temp_points[(points_count-1)*2+1] = points[points_count-1] - temp_normals[points_count-1] * half_draw_size;
 793:             }
 794:             // Generate the indices to form a number of triangles for each line segment, and the vertices for the line edges
 795:             // This takes points n and n+1 and writes into n+1, with the first point in a closed line being generated from the final one (as n+1 wraps)
 796:             // FIXME-OPT: Merge the different loops, possibly remove the temporary buffer.
 797:             unsigned int idx1 = _VtxCurrentIdx; // Vertex index for start of line segment
 798:             for (int i1 = 0; i1 < count; i1++) // i1 is the first point of the line segment
 799:             {
 800:                 const int i2 = (i1 + 1) == points_count ? 0 : i1 + 1; // i2 is the second point of the line segment
 801:                 const unsigned int idx2 = ((i1 + 1) == points_count) ? _VtxCurrentIdx : (idx1 + (use_texture ? 2 : 3)); // Vertex index for end of segment
 802:                 // Average normals
 803:                 float dm_x = (temp_normals[i1].x + temp_normals[i2].x) * 0.5f;
 804:                 float dm_y = (temp_normals[i1].y + temp_normals[i2].y) * 0.5f;
 805:                 IM_FIXNORMAL2F(dm_x, dm_y);
 806:                 dm_x *= half_draw_size; // dm_x, dm_y are offset to the outer edge of the AA area
 807:                 dm_y *= half_draw_size;
 808:                 // Add temporary vertices for the outer edges
 809:                 ImVec2* out_vtx = &temp_points[i2 * 2];
 810:                 out_vtx[0].x = points[i2].x + dm_x;
 811:                 out_vtx[0].y = points[i2].y + dm_y;
 812:                 out_vtx[1].x = points[i2].x - dm_x;
 813:                 out_vtx[1].y = points[i2].y - dm_y;
 814:                 if (use_texture)
 815:                 {
 816:                     // Add indices for two triangles
 817:                     _IdxWritePtr[0] = (ImDrawIdx)(idx2 + 0); _IdxWritePtr[1] = (ImDrawIdx)(idx1 + 0); _IdxWritePtr[2] = (ImDrawIdx)(idx1 + 1); // Right tri
 818:                     _IdxWritePtr[3] = (ImDrawIdx)(idx2 + 1); _IdxWritePtr[4] = (ImDrawIdx)(idx1 + 1); _IdxWritePtr[5] = (ImDrawIdx)(idx2 + 0); // Left tri
 819:                     _IdxWritePtr += 6;
 820:                 }
 821:                 else
 822:                 {
 823:                     // Add indexes for four triangles
 824:                     _IdxWritePtr[0] = (ImDrawIdx)(idx2 + 0); _IdxWritePtr[1] = (ImDrawIdx)(idx1 + 0); _IdxWritePtr[2] = (ImDrawIdx)(idx1 + 2); // Right tri 1
 825:                     _IdxWritePtr[3] = (ImDrawIdx)(idx1 + 2); _IdxWritePtr[4] = (ImDrawIdx)(idx2 + 2); _IdxWritePtr[5] = (ImDrawIdx)(idx2 + 0); // Right tri 2
 826:                     _IdxWritePtr[6] = (ImDrawIdx)(idx2 + 1); _IdxWritePtr[7] = (ImDrawIdx)(idx1 + 1); _IdxWritePtr[8] = (ImDrawIdx)(idx1 + 0); // Left tri 1
 827:                     _IdxWritePtr[9] = (ImDrawIdx)(idx1 + 0); _IdxWritePtr[10] = (ImDrawIdx)(idx2 + 0); _IdxWritePtr[11] = (ImDrawIdx)(idx2 + 1); // Left tri 2
 828:                     _IdxWritePtr += 12;
 829:                 }
 830:                 idx1 = idx2;
 831:             }
 832:             // Add vertices for each point on the line
 833:             if (use_texture)
 834:             {
 835:                 // If we're using textures we only need to emit the left/right edge vertices
 836:                 ImVec4 tex_uvs = _Data->TexUvLines[integer_thickness];
 837:                 /*if (fractional_thickness != 0.0f) // Currently always zero when use_texture==false!
 838:                 {
 839:                     const ImVec4 tex_uvs_1 = _Data->TexUvLines[integer_thickness + 1];
 840:                     tex_uvs.x = tex_uvs.x + (tex_uvs_1.x - tex_uvs.x) * fractional_thickness; // inlined ImLerp()
 841:                     tex_uvs.y = tex_uvs.y + (tex_uvs_1.y - tex_uvs.y) * fractional_thickness;
 842:                     tex_uvs.z = tex_uvs.z + (tex_uvs_1.z - tex_uvs.z) * fractional_thickness;
 843:                     tex_uvs.w = tex_uvs.w + (tex_uvs_1.w - tex_uvs.w) * fractional_thickness;
 844:                 }*/
 845:                 ImVec2 tex_uv0(tex_uvs.x, tex_uvs.y);
 846:                 ImVec2 tex_uv1(tex_uvs.z, tex_uvs.w);
 847:                 for (int i = 0; i < points_count; i++)
 848:                 {
 849:                     _VtxWritePtr[0].pos = temp_points[i * 2 + 0]; _VtxWritePtr[0].uv = tex_uv0; _VtxWritePtr[0].col = col; // Left-side outer edge
 850:                     _VtxWritePtr[1].pos = temp_points[i * 2 + 1]; _VtxWritePtr[1].uv = tex_uv1; _VtxWritePtr[1].col = col; // Right-side outer edge
 851:                     _VtxWritePtr += 2;
 852:                 }
 853:             }
 854:             else
 855:             {
 856:                 // If we're not using a texture, we need the center vertex as well
 857:                 for (int i = 0; i < points_count; i++)
 858:                 {
 859:                     _VtxWritePtr[0].pos = points[i];              _VtxWritePtr[0].uv = opaque_uv; _VtxWritePtr[0].col = col;       // Center of line
 860:                     _VtxWritePtr[1].pos = temp_points[i * 2 + 0]; _VtxWritePtr[1].uv = opaque_uv; _VtxWritePtr[1].col = col_trans; // Left-side outer edge
 861:                     _VtxWritePtr[2].pos = temp_points[i * 2 + 1]; _VtxWritePtr[2].uv = opaque_uv; _VtxWritePtr[2].col = col_trans; // Right-side outer edge
 862:                     _VtxWritePtr += 3;
 863:                 }
 864:             }
 865:         }
 866:         else
 867:         {
 868:             // [PATH 2] Non texture-based lines (thick): we need to draw the solid line core and thus require four vertices per point
 869:             const float half_inner_thickness = (thickness - AA_SIZE) * 0.5f;
 870:             // If line is not closed, the first and last points need to be generated differently as there are no normals to blend
 871:             if (!closed)
 872:             {
 873:                 const int points_last = points_count - 1;
 874:                 temp_points[0] = points[0] + temp_normals[0] * (half_inner_thickness + AA_SIZE);
 875:                 temp_points[1] = points[0] + temp_normals[0] * (half_inner_thickness);
 876:                 temp_points[2] = points[0] - temp_normals[0] * (half_inner_thickness);
 877:                 temp_points[3] = points[0] - temp_normals[0] * (half_inner_thickness + AA_SIZE);
 878:                 temp_points[points_last * 4 + 0] = points[points_last] + temp_normals[points_last] * (half_inner_thickness + AA_SIZE);
 879:                 temp_points[points_last * 4 + 1] = points[points_last] + temp_normals[points_last] * (half_inner_thickness);
 880:                 temp_points[points_last * 4 + 2] = points[points_last] - temp_normals[points_last] * (half_inner_thickness);
 881:                 temp_points[points_last * 4 + 3] = points[points_last] - temp_normals[points_last] * (half_inner_thickness + AA_SIZE);
 882:             }
 883:             // Generate the indices to form a number of triangles for each line segment, and the vertices for the line edges
 884:             // This takes points n and n+1 and writes into n+1, with the first point in a closed line being generated from the final one (as n+1 wraps)
 885:             // FIXME-OPT: Merge the different loops, possibly remove the temporary buffer.
 886:             unsigned int idx1 = _VtxCurrentIdx; // Vertex index for start of line segment
 887:             for (int i1 = 0; i1 < count; i1++) // i1 is the first point of the line segment
 888:             {
 889:                 const int i2 = (i1 + 1) == points_count ? 0 : (i1 + 1); // i2 is the second point of the line segment
 890:                 const unsigned int idx2 = (i1 + 1) == points_count ? _VtxCurrentIdx : (idx1 + 4); // Vertex index for end of segment
 891:                 // Average normals
 892:                 float dm_x = (temp_normals[i1].x + temp_normals[i2].x) * 0.5f;
 893:                 float dm_y = (temp_normals[i1].y + temp_normals[i2].y) * 0.5f;
 894:                 IM_FIXNORMAL2F(dm_x, dm_y);
 895:                 float dm_out_x = dm_x * (half_inner_thickness + AA_SIZE);
 896:                 float dm_out_y = dm_y * (half_inner_thickness + AA_SIZE);
 897:                 float dm_in_x = dm_x * half_inner_thickness;
 898:                 float dm_in_y = dm_y * half_inner_thickness;
 899:                 // Add temporary vertices
 900:                 ImVec2* out_vtx = &temp_points[i2 * 4];
 901:                 out_vtx[0].x = points[i2].x + dm_out_x;
