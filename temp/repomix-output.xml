243:   Vertex33 *v=(Vertex33*)msr.pData;
244:   float as=XM_2PI/segments;
245:   for(int i=0;i<=segments;i++){float a=i*as;v[i].position={sphere.center.x+cosf(a)*sphere.radius,sphere.center.y,sphere.center.z+sinf(a)*sphere.radius};v[i].normal={0,1,0};v[i].color=color;v[i].texcoord={0,0};}
246:   for(int i=0;i<=segments;i++){float a=i*as;v[vpr+i].position={sphere.center.x+cosf(a)*sphere.radius,sphere.center.y+sinf(a)*sphere.radius,sphere.center.z};v[vpr+i].normal={0,1,0};v[vpr+i].color=color;v[vpr+i].texcoord={0,0};}
247:   for(int i=0;i<=segments;i++){float a=i*as;v[vpr*2+i].position={sphere.center.x,sphere.center.y+cosf(a)*sphere.radius,sphere.center.z+sinf(a)*sphere.radius};v[vpr*2+i].normal={0,1,0};v[vpr*2+i].color=color;v[vpr*2+i].texcoord={0,0};}
248:   g_pContext->Unmap(g_pVertexBuffer.Get(),0);
