6997: static ImRect CalcScopeRect(ImGuiMultiSelectTempData* ms, ImGuiWindow* window)
6998: {
6999:     ImGuiContext& g = *GImGui;
7000:     if (ms->Flags & ImGuiMultiSelectFlags_ScopeRect)
7001:     {
7002:         // Warning: this depends on CursorMaxPos so it means to be called by EndMultiSelect() only
7003:         return ImRect(ms->ScopeRectMin, ImMax(window->DC.CursorMaxPos, ms->ScopeRectMin));
7004:     }
7005:     else
7006:     {
7007:         // When a table, pull HostClipRect, which allows us to predict ClipRect before first row/layout is performed. (#7970)
7008:         ImRect scope_rect = window->InnerClipRect;
7009:         if (g.CurrentTable != NULL)
7010:             scope_rect = g.CurrentTable->HostClipRect;
7011:         // Add inner table decoration (#7821) // FIXME: Why not baking in InnerClipRect?
7012:         scope_rect.Min = ImMin(scope_rect.Min + ImVec2(window->DecoInnerSizeX1, window->DecoInnerSizeY1), scope_rect.Max);
7013:         return scope_rect;
7014:     }
7015: }
7016: // Return ImGuiMultiSelectIO structure.
7017: // Lifetime: don't hold on ImGuiMultiSelectIO* pointers over multiple frames or past any subsequent call to BeginMultiSelect() or EndMultiSelect().
7018: // Passing 'selection_size' and 'items_count' parameters is currently optional.
7019: // - 'selection_size' is useful to disable some shortcut routing: e.g. ImGuiMultiSelectFlags_ClearOnEscape won't claim Escape key when selection_size 0,
7020: //    allowing a first press to clear selection THEN the second press to leave child window and return to parent.
7021: // - 'items_count' is stored in ImGuiMultiSelectIO which makes it a convenient way to pass the information to your ApplyRequest() handler (but you may pass it differently).
7022: // - If they are costly for you to compute (e.g. external intrusive selection without maintaining size), you may avoid them and pass -1.
7023: //   - If you can easily tell if your selection is empty or not, you may pass 0/1, or you may enable ImGuiMultiSelectFlags_ClearOnEscape flag dynamically.
7024: ImGuiMultiSelectIO* ImGui::BeginMultiSelect(ImGuiMultiSelectFlags flags, int selection_size, int items_count)
7025: {
7026:     ImGuiContext& g = *GImGui;
7027:     ImGuiWindow* window = g.CurrentWindow;
7028:     if (++g.MultiSelectTempDataStacked > g.MultiSelectTempData.Size)
7029:         g.MultiSelectTempData.resize(g.MultiSelectTempDataStacked, ImGuiMultiSelectTempData());
7030:     ImGuiMultiSelectTempData* ms = &g.MultiSelectTempData[g.MultiSelectTempDataStacked - 1];
7031:     IM_STATIC_ASSERT(offsetof(ImGuiMultiSelectTempData, IO) == 0); // Clear() relies on that.
7032:     g.CurrentMultiSelect = ms;
7033:     if ((flags & (ImGuiMultiSelectFlags_ScopeWindow | ImGuiMultiSelectFlags_ScopeRect)) == 0)
7034:         flags |= ImGuiMultiSelectFlags_ScopeWindow;
7035:     if (flags & ImGuiMultiSelectFlags_SingleSelect)
7036:         flags &= ~(ImGuiMultiSelectFlags_BoxSelect2d | ImGuiMultiSelectFlags_BoxSelect1d);
7037:     if (flags & ImGuiMultiSelectFlags_BoxSelect2d)
7038:         flags &= ~ImGuiMultiSelectFlags_BoxSelect1d;
7039:     // FIXME: Workaround to the fact we override CursorMaxPos, meaning size measurement are lost. (#8250)
7040:     // They should perhaps be stacked properly?
7041:     if (ImGuiTable* table = g.CurrentTable)
7042:         if (table->CurrentColumn != -1)
7043:             TableEndCell(table); // This is currently safe to call multiple time. If that properly is lost we can extract the "save measurement" part of it.
7044:     // FIXME: BeginFocusScope()
7045:     const ImGuiID id = window->IDStack.back();
7046:     ms->Clear();
7047:     ms->FocusScopeId = id;
7048:     ms->Flags = flags;
7049:     ms->IsFocused = (ms->FocusScopeId == g.NavFocusScopeId);
7050:     ms->BackupCursorMaxPos = window->DC.CursorMaxPos;
7051:     ms->ScopeRectMin = window->DC.CursorMaxPos = window->DC.CursorPos;
7052:     PushFocusScope(ms->FocusScopeId);
7053:     if (flags & ImGuiMultiSelectFlags_ScopeWindow) // Mark parent child window as navigable into, with highlight. Assume user will always submit interactive items.
7054:         window->DC.NavLayersActiveMask |= 1 << ImGuiNavLayer_Main;
7055:     // Use copy of keyboard mods at the time of the request, otherwise we would requires mods to be held for an extra frame.
7056:     ms->KeyMods = g.NavJustMovedToId ? (g.NavJustMovedToIsTabbing ? 0 : g.NavJustMovedToKeyMods) : g.IO.KeyMods;
7057:     if (flags & ImGuiMultiSelectFlags_NoRangeSelect)
7058:         ms->KeyMods &= ~ImGuiMod_Shift;
7059:     // Bind storage
7060:     ImGuiMultiSelectState* storage = g.MultiSelectStorage.GetOrAddByKey(id);
7061:     storage->ID = id;
7062:     storage->LastFrameActive = g.FrameCount;
7063:     storage->LastSelectionSize = selection_size;
7064:     storage->Window = window;
7065:     ms->Storage = storage;
7066:     // Output to user
7067:     ms->IO.Requests.resize(0);
7068:     ms->IO.RangeSrcItem = storage->RangeSrcItem;
7069:     ms->IO.NavIdItem = storage->NavIdItem;
7070:     ms->IO.NavIdSelected = (storage->NavIdSelected == 1) ? true : false;
7071:     ms->IO.ItemsCount = items_count;
7072:     // Clear when using Navigation to move within the scope
7073:     // (we compare FocusScopeId so it possible to use multiple selections inside a same window)
7074:     bool request_clear = false;
7075:     bool request_select_all = false;
7076:     if (g.NavJustMovedToId != 0 && g.NavJustMovedToFocusScopeId == ms->FocusScopeId && g.NavJustMovedToHasSelectionData)
7077:     {
7078:         if (ms->KeyMods & ImGuiMod_Shift)
7079:             ms->IsKeyboardSetRange = true;
7080:         if (ms->IsKeyboardSetRange)
7081:             IM_ASSERT(storage->RangeSrcItem != ImGuiSelectionUserData_Invalid); // Not ready -> could clear?
7082:         if ((ms->KeyMods & (ImGuiMod_Ctrl | ImGuiMod_Shift)) == 0 && (flags & (ImGuiMultiSelectFlags_NoAutoClear | ImGuiMultiSelectFlags_NoAutoSelect)) == 0)
7083:             request_clear = true;
7084:     }
7085:     else if (g.NavJustMovedFromFocusScopeId == ms->FocusScopeId)
7086:     {
7087:         // Also clear on leaving scope (may be optional?)
7088:         if ((ms->KeyMods & (ImGuiMod_Ctrl | ImGuiMod_Shift)) == 0 && (flags & (ImGuiMultiSelectFlags_NoAutoClear | ImGuiMultiSelectFlags_NoAutoSelect)) == 0)
7089:             request_clear = true;
7090:     }
7091:     // Box-select handling: update active state.
7092:     ImGuiBoxSelectState* bs = &g.BoxSelectState;
7093:     if (flags & (ImGuiMultiSelectFlags_BoxSelect1d | ImGuiMultiSelectFlags_BoxSelect2d))
7094:     {
7095:         ms->BoxSelectId = GetID("##BoxSelect");
7096:         if (BeginBoxSelect(CalcScopeRect(ms, window), window, ms->BoxSelectId, flags))
7097:             request_clear |= bs->RequestClear;
7098:     }
7099:     if (ms->IsFocused)
7100:     {
7101:         // Shortcut: Clear selection (Escape)
7102:         // - Only claim shortcut if selection is not empty, allowing further presses on Escape to e.g. leave current child window.
7103:         // - Box select also handle Escape and needs to pass an id to bypass ActiveIdUsingAllKeyboardKeys lock.
7104:         if (flags & ImGuiMultiSelectFlags_ClearOnEscape)
7105:         {
7106:             if (selection_size != 0 || bs->IsActive)
7107:                 if (Shortcut(ImGuiKey_Escape, ImGuiInputFlags_None, bs->IsActive ? bs->ID : 0))
7108:                 {
7109:                     request_clear = true;
7110:                     if (bs->IsActive)
7111:                         BoxSelectDeactivateDrag(bs);
7112:                 }
7113:         }
7114:         // Shortcut: Select all (Ctrl+A)
7115:         if (!(flags & ImGuiMultiSelectFlags_SingleSelect) && !(flags & ImGuiMultiSelectFlags_NoSelectAll))
7116:             if (Shortcut(ImGuiMod_Ctrl | ImGuiKey_A))
7117:                 request_select_all = true;
7118:     }
7119:     if (request_clear || request_select_all)
7120:     {
7121:         MultiSelectAddSetAll(ms, request_select_all);
7122:         if (!request_select_all)
7123:             storage->LastSelectionSize = 0;
7124:     }
7125:     ms->LoopRequestSetAll = request_select_all ? 1 : request_clear ? 0 : -1;
7126:     ms->LastSubmittedItem = ImGuiSelectionUserData_Invalid;
7127:     if (g.DebugLogFlags & ImGuiDebugLogFlags_EventSelection)
7128:         DebugLogMultiSelectRequests("BeginMultiSelect", &ms->IO);
7129:     return &ms->IO;
7130: }
7131: // Return updated ImGuiMultiSelectIO structure.
7132: // Lifetime: don't hold on ImGuiMultiSelectIO* pointers over multiple frames or past any subsequent call to BeginMultiSelect() or EndMultiSelect().
7133: ImGuiMultiSelectIO* ImGui::EndMultiSelect()
7134: {
7135:     ImGuiContext& g = *GImGui;
7136:     ImGuiMultiSelectTempData* ms = g.CurrentMultiSelect;
7137:     ImGuiMultiSelectState* storage = ms->Storage;
7138:     ImGuiWindow* window = g.CurrentWindow;
7139:     IM_ASSERT_USER_ERROR(ms->FocusScopeId == g.CurrentFocusScopeId, "EndMultiSelect() FocusScope mismatch!");
7140:     IM_ASSERT(g.CurrentMultiSelect != NULL && storage->Window == g.CurrentWindow);
7141:     IM_ASSERT(g.MultiSelectTempDataStacked > 0 && &g.MultiSelectTempData[g.MultiSelectTempDataStacked - 1] == g.CurrentMultiSelect);
7142:     ImRect scope_rect = CalcScopeRect(ms, window);
7143:     if (ms->IsFocused)
7144:     {
7145:         // We currently don't allow user code to modify RangeSrcItem by writing to BeginIO's version, but that would be an easy change here.
7146:         if (ms->IO.RangeSrcReset || (ms->RangeSrcPassedBy == false && ms->IO.RangeSrcItem != ImGuiSelectionUserData_Invalid)) // Can't read storage->RangeSrcItem here -> we want the state at beginning of the scope (see tests for easy failure)
7147:         {
7148:             IMGUI_DEBUG_LOG_SELECTION("[selection] EndMultiSelect: Reset RangeSrcItem.\n"); // Will set be to NavId.
7149:             storage->RangeSrcItem = ImGuiSelectionUserData_Invalid;
7150:         }
7151:         if (ms->NavIdPassedBy == false && storage->NavIdItem != ImGuiSelectionUserData_Invalid)
7152:         {
7153:             IMGUI_DEBUG_LOG_SELECTION("[selection] EndMultiSelect: Reset NavIdItem.\n");
7154:             storage->NavIdItem = ImGuiSelectionUserData_Invalid;
7155:             storage->NavIdSelected = -1;
7156:         }
7157:         if ((ms->Flags & (ImGuiMultiSelectFlags_BoxSelect1d | ImGuiMultiSelectFlags_BoxSelect2d)) && GetBoxSelectState(ms->BoxSelectId))
7158:             EndBoxSelect(scope_rect, ms->Flags);
7159:     }
7160:     if (ms->IsEndIO == false)
7161:         ms->IO.Requests.resize(0);
7162:     // Clear selection when clicking void?
7163:     // We specifically test for IsMouseDragPastThreshold(0) == false to allow box-selection!
7164:     // The InnerRect test is necessary for non-child/decorated windows.
7165:     bool scope_hovered = IsWindowHovered() && window->InnerRect.Contains(g.IO.MousePos);
7166:     if (scope_hovered && (ms->Flags & ImGuiMultiSelectFlags_ScopeRect))
7167:         scope_hovered &= scope_rect.Contains(g.IO.MousePos);
7168:     if (scope_hovered && g.HoveredId == 0 && g.ActiveId == 0)
7169:     {
7170:         if (ms->Flags & (ImGuiMultiSelectFlags_BoxSelect1d | ImGuiMultiSelectFlags_BoxSelect2d))
7171:         {
7172:             if (!g.BoxSelectState.IsActive && !g.BoxSelectState.IsStarting && g.IO.MouseClickedCount[0] == 1)
7173:             {
7174:                 BoxSelectPreStartDrag(ms->BoxSelectId, ImGuiSelectionUserData_Invalid);
7175:                 FocusWindow(window, ImGuiFocusRequestFlags_UnlessBelowModal);
7176:                 SetHoveredID(ms->BoxSelectId);
7177:                 if (ms->Flags & ImGuiMultiSelectFlags_ScopeRect)
7178:                     SetNavID(0, ImGuiNavLayer_Main, ms->FocusScopeId, ImRect(g.IO.MousePos, g.IO.MousePos)); // Automatically switch FocusScope for initial click from void to box-select.
7179:             }
7180:         }
7181:         if (ms->Flags & ImGuiMultiSelectFlags_ClearOnClickVoid)
7182:             if (IsMouseReleased(0) && IsMouseDragPastThreshold(0) == false && g.IO.KeyMods == ImGuiMod_None)
7183:                 MultiSelectAddSetAll(ms, false);
7184:     }
7185:     // Courtesy nav wrapping helper flag
7186:     if (ms->Flags & ImGuiMultiSelectFlags_NavWrapX)
7187:     {
7188:         IM_ASSERT(ms->Flags & ImGuiMultiSelectFlags_ScopeWindow); // Only supported at window scope
7189:         ImGui::NavMoveRequestTryWrapping(ImGui::GetCurrentWindow(), ImGuiNavMoveFlags_WrapX);
7190:     }
7191:     // Unwind
7192:     window->DC.CursorMaxPos = ImMax(ms->BackupCursorMaxPos, window->DC.CursorMaxPos);
7193:     PopFocusScope();
7194:     if (g.DebugLogFlags & ImGuiDebugLogFlags_EventSelection)
7195:         DebugLogMultiSelectRequests("EndMultiSelect", &ms->IO);
7196:     ms->FocusScopeId = 0;
7197:     ms->Flags = ImGuiMultiSelectFlags_None;
7198:     g.CurrentMultiSelect = (--g.MultiSelectTempDataStacked > 0) ? &g.MultiSelectTempData[g.MultiSelectTempDataStacked - 1] : NULL;
7199:     return &ms->IO;
7200: }
7201: void ImGui::SetNextItemSelectionUserData(ImGuiSelectionUserData selection_user_data)
7202: {
7203:     // Note that flags will be cleared by ItemAdd(), so it's only useful for Navigation code!
7204:     // This designed so widgets can also cheaply set this before calling ItemAdd(), so we are not tied to MultiSelect api.
7205:     ImGuiContext& g = *GImGui;
7206:     g.NextItemData.SelectionUserData = selection_user_data;
7207:     g.NextItemData.FocusScopeId = g.CurrentFocusScopeId;
7208:     if (ImGuiMultiSelectTempData* ms = g.CurrentMultiSelect)
7209:     {
7210:         // Auto updating RangeSrcPassedBy for cases were clipper is not used (done before ItemAdd() clipping)
7211:         g.NextItemData.ItemFlags |= ImGuiItemFlags_HasSelectionUserData | ImGuiItemFlags_IsMultiSelect;
7212:         if (ms->IO.RangeSrcItem == selection_user_data)
7213:             ms->RangeSrcPassedBy = true;
7214:     }
7215:     else
7216:     {
7217:         g.NextItemData.ItemFlags |= ImGuiItemFlags_HasSelectionUserData;
7218:     }
7219: }
7220: // In charge of:
7221: // - Applying SetAll for submitted items.
7222: // - Applying SetRange for submitted items and record end points.
7223: // - Altering button behavior flags to facilitate use with drag and drop.
7224: void ImGui::MultiSelectItemHeader(ImGuiID id, bool* p_selected, ImGuiButtonFlags* p_button_flags)
7225: {
7226:     ImGuiContext& g = *GImGui;
7227:     ImGuiMultiSelectTempData* ms = g.CurrentMultiSelect;
7228:     bool selected = *p_selected;
7229:     if (ms->IsFocused)
7230:     {
7231:         ImGuiMultiSelectState* storage = ms->Storage;
7232:         ImGuiSelectionUserData item_data = g.NextItemData.SelectionUserData;
7233:         IM_ASSERT(g.NextItemData.FocusScopeId == g.CurrentFocusScopeId && "Forgot to call SetNextItemSelectionUserData() prior to item, required in BeginMultiSelect()/EndMultiSelect() scope");
7234:         // Apply SetAll (Clear/SelectAll) requests requested by BeginMultiSelect().
7235:         // This is only useful if the user hasn't processed them already, and this only works if the user isn't using the clipper.
7236:         // If you are using a clipper you need to process the SetAll request after calling BeginMultiSelect()
7237:         if (ms->LoopRequestSetAll != -1)
7238:             selected = (ms->LoopRequestSetAll == 1);
7239:         // When using Shift+Nav: because it can incur scrolling we cannot afford a frame of lag with the selection highlight (otherwise scrolling would happen before selection)
7240:         // For this to work, we need someone to set 'RangeSrcPassedBy = true' at some point (either clipper either SetNextItemSelectionUserData() function)
7241:         if (ms->IsKeyboardSetRange)
7242:         {
7243:             IM_ASSERT(id != 0 && (ms->KeyMods & ImGuiMod_Shift) != 0);
7244:             const bool is_range_dst = (ms->RangeDstPassedBy == false) && g.NavJustMovedToId == id;     // Assume that g.NavJustMovedToId is not clipped.
7245:             if (is_range_dst)
7246:                 ms->RangeDstPassedBy = true;
7247:             if (is_range_dst && storage->RangeSrcItem == ImGuiSelectionUserData_Invalid) // If we don't have RangeSrc, assign RangeSrc = RangeDst
7248:             {
7249:                 storage->RangeSrcItem = item_data;
7250:                 storage->RangeSelected = selected ? 1 : 0;
7251:             }
7252:             const bool is_range_src = storage->RangeSrcItem == item_data;
7253:             if (is_range_src || is_range_dst || ms->RangeSrcPassedBy != ms->RangeDstPassedBy)
7254:             {
7255:                 // Apply range-select value to visible items
7256:                 IM_ASSERT(storage->RangeSrcItem != ImGuiSelectionUserData_Invalid && storage->RangeSelected != -1);
7257:                 selected = (storage->RangeSelected != 0);
7258:             }
7259:             else if ((ms->KeyMods & ImGuiMod_Ctrl) == 0 && (ms->Flags & ImGuiMultiSelectFlags_NoAutoClear) == 0)
7260:             {
7261:                 // Clear other items
7262:                 selected = false;
7263:             }
7264:         }
7265:         *p_selected = selected;
7266:     }
7267:     // Alter button behavior flags
7268:     // To handle drag and drop of multiple items we need to avoid clearing selection on click.
7269:     // Enabling this test makes actions using Ctrl+Shift delay their effect on MouseUp which is annoying, but it allows drag and drop of multiple items.
7270:     if (p_button_flags != NULL)
7271:     {
7272:         ImGuiButtonFlags button_flags = *p_button_flags;
7273:         button_flags |= ImGuiButtonFlags_NoHoveredOnFocus;
7274:         if ((!selected || (g.ActiveId == id && g.ActiveIdHasBeenPressedBefore)) && !(ms->Flags & ImGuiMultiSelectFlags_SelectOnClickRelease))
7275:             button_flags = (button_flags | ImGuiButtonFlags_PressedOnClick) & ~ImGuiButtonFlags_PressedOnClickRelease;
7276:         else
7277:             button_flags |= ImGuiButtonFlags_PressedOnClickRelease;
7278:         *p_button_flags = button_flags;
7279:     }
7280: }
7281: // In charge of:
7282: // - Auto-select on navigation.
7283: // - Box-select toggle handling.
7284: // - Right-click handling.
7285: // - Altering selection based on Ctrl/Shift modifiers, both for keyboard and mouse.
7286: // - Record current selection state for RangeSrc
7287: // This is all rather complex, best to run and refer to "widgets_multiselect_xxx" tests in imgui_test_suite.
7288: void ImGui::MultiSelectItemFooter(ImGuiID id, bool* p_selected, bool* p_pressed)
7289: {
7290:     ImGuiContext& g = *GImGui;
7291:     ImGuiWindow* window = g.CurrentWindow;
7292:     bool selected = *p_selected;
7293:     bool pressed = *p_pressed;
7294:     ImGuiMultiSelectTempData* ms = g.CurrentMultiSelect;
7295:     ImGuiMultiSelectState* storage = ms->Storage;
7296:     if (pressed)
7297:         ms->IsFocused = true;
7298:     bool hovered = false;
7299:     if (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_HoveredRect)
7300:         hovered = IsItemHovered(ImGuiHoveredFlags_AllowWhenBlockedByPopup);
7301:     if (!ms->IsFocused && !hovered)
7302:         return;
7303:     ImGuiSelectionUserData item_data = g.NextItemData.SelectionUserData;
7304:     ImGuiMultiSelectFlags flags = ms->Flags;
7305:     const bool is_singleselect = (flags & ImGuiMultiSelectFlags_SingleSelect) != 0;
7306:     bool is_ctrl = (ms->KeyMods & ImGuiMod_Ctrl) != 0;
7307:     bool is_shift = (ms->KeyMods & ImGuiMod_Shift) != 0;
7308:     bool apply_to_range_src = false;
7309:     if (g.NavId == id && storage->RangeSrcItem == ImGuiSelectionUserData_Invalid)
7310:         apply_to_range_src = true;
7311:     if (ms->IsEndIO == false)
7312:     {
7313:         ms->IO.Requests.resize(0);
7314:         ms->IsEndIO = true;
7315:     }
7316:     // Auto-select as you navigate a list
7317:     if (g.NavJustMovedToId == id)
7318:     {
7319:         if ((flags & ImGuiMultiSelectFlags_NoAutoSelect) == 0)
7320:         {
7321:             if (is_ctrl && is_shift)
7322:                 pressed = true;
7323:             else if (!is_ctrl)
7324:                 selected = pressed = true;
7325:         }
7326:         else
7327:         {
7328:             // With NoAutoSelect, using Shift+keyboard performs a write/copy
7329:             if (is_shift)
7330:                 pressed = true;
7331:             else if (!is_ctrl)
7332:                 apply_to_range_src = true; // Since if (pressed) {} main block is not running we update this
7333:         }
7334:     }
7335:     if (apply_to_range_src)
7336:     {
7337:         storage->RangeSrcItem = item_data;
7338:         storage->RangeSelected = selected; // Will be updated at the end of this function anyway.
7339:     }
7340:     // Box-select toggle handling
7341:     if (ms->BoxSelectId != 0)
7342:         if (ImGuiBoxSelectState* bs = GetBoxSelectState(ms->BoxSelectId))
7343:         {
7344:             const bool rect_overlap_curr = bs->BoxSelectRectCurr.Overlaps(g.LastItemData.Rect);
7345:             const bool rect_overlap_prev = bs->BoxSelectRectPrev.Overlaps(g.LastItemData.Rect);
7346:             if ((rect_overlap_curr && !rect_overlap_prev && !selected) || (rect_overlap_prev && !rect_overlap_curr))
7347:             {
7348:                 if (storage->LastSelectionSize <= 0 && bs->IsStartedSetNavIdOnce)
7349:                 {
7350:                     pressed = true; // First item act as a pressed: code below will emit selection request and set NavId (whatever we emit here will be overridden anyway)
7351:                     bs->IsStartedSetNavIdOnce = false;
7352:                 }
7353:                 else
7354:                 {
7355:                     selected = !selected;
7356:                     MultiSelectAddSetRange(ms, selected, +1, item_data, item_data);
7357:                 }
7358:                 storage->LastSelectionSize = ImMax(storage->LastSelectionSize + 1, 1);
7359:             }
7360:         }
7361:     // Right-click handling.
7362:     // FIXME-MULTISELECT: Maybe should be moved to Selectable()? Also see #5816, #8200, #9015
7363:     if (hovered && IsMouseClicked(1) && (flags & (ImGuiMultiSelectFlags_NoAutoSelect | ImGuiMultiSelectFlags_NoSelectOnRightClick)) == 0)
7364:     {
7365:         if (g.ActiveId != 0 && g.ActiveId != id)
7366:             ClearActiveID();
7367:         SetFocusID(id, window);
7368:         if (!pressed && !selected)
7369:         {
7370:             pressed = true;
7371:             is_ctrl = is_shift = false;
7372:         }
7373:     }
7374:     // Unlike Space, Enter doesn't alter selection (but can still return a press) unless current item is not selected.
7375:     // The later, "unless current item is not select", may become optional? It seems like a better default if Enter doesn't necessarily open something
7376:     // (unlike e.g. Windows explorer). For use case where Enter always open something, we might decide to make this optional?
7377:     const bool enter_pressed = pressed && (g.NavActivateId == id) && (g.NavActivateFlags & ImGuiActivateFlags_PreferInput);
7378:     // Alter selection
7379:     if (pressed && (!enter_pressed || !selected))
7380:     {
7381:         // Box-select
7382:         ImGuiInputSource input_source = (g.NavJustMovedToId == id || g.NavActivateId == id) ? g.NavInputSource : ImGuiInputSource_Mouse;
7383:         if (flags & (ImGuiMultiSelectFlags_BoxSelect1d | ImGuiMultiSelectFlags_BoxSelect2d))
7384:             if (selected == false && !g.BoxSelectState.IsActive && !g.BoxSelectState.IsStarting && input_source == ImGuiInputSource_Mouse && g.IO.MouseClickedCount[0] == 1)
7385:                 BoxSelectPreStartDrag(ms->BoxSelectId, item_data);
7386:         //----------------------------------------------------------------------------------------
7387:         // ACTION                      | Begin  | Pressed/Activated  | End
7388:         //----------------------------------------------------------------------------------------
7389:         // Keys Navigated:             | Clear  | Src=item, Sel=1               SetRange 1
7390:         // Keys Navigated: Ctrl        | n/a    | n/a
7391:         // Keys Navigated:      Shift  | n/a    | Dst=item, Sel=1,   => Clear + SetRange 1
7392:         // Keys Navigated: Ctrl+Shift  | n/a    | Dst=item, Sel=Src  => Clear + SetRange Src-Dst
7393:         // Keys Activated:             | n/a    | Src=item, Sel=1    => Clear + SetRange 1
7394:         // Keys Activated: Ctrl        | n/a    | Src=item, Sel=!Sel =>         SetSange 1
7395:         // Keys Activated:      Shift  | n/a    | Dst=item, Sel=1    => Clear + SetSange 1
7396:         //----------------------------------------------------------------------------------------
7397:         // Mouse Pressed:              | n/a    | Src=item, Sel=1,   => Clear + SetRange 1
7398:         // Mouse Pressed:  Ctrl        | n/a    | Src=item, Sel=!Sel =>         SetRange 1
7399:         // Mouse Pressed:       Shift  | n/a    | Dst=item, Sel=1,   => Clear + SetRange 1
7400:         // Mouse Pressed:  Ctrl+Shift  | n/a    | Dst=item, Sel=!Sel =>         SetRange Src-Dst
7401:         //----------------------------------------------------------------------------------------
7402:         if ((flags & ImGuiMultiSelectFlags_NoAutoClear) == 0)
7403:         {
7404:             bool request_clear = false;
7405:             if (is_singleselect)
7406:                 request_clear = true;
7407:             else if ((input_source == ImGuiInputSource_Mouse || g.NavActivateId == id) && !is_ctrl)
7408:                 request_clear = (flags & ImGuiMultiSelectFlags_NoAutoClearOnReselect) ? !selected : true;
7409:             else if ((input_source == ImGuiInputSource_Keyboard || input_source == ImGuiInputSource_Gamepad) && is_shift && !is_ctrl)
7410:                 request_clear = true; // With is_shift==false the RequestClear was done in BeginIO, not necessary to do again.
7411:             if (request_clear)
7412:                 MultiSelectAddSetAll(ms, false);
7413:         }
7414:         int range_direction;
7415:         bool range_selected;
7416:         if (is_shift && !is_singleselect)
7417:         {
7418:             //IM_ASSERT(storage->HasRangeSrc && storage->HasRangeValue);
7419:             if (storage->RangeSrcItem == ImGuiSelectionUserData_Invalid)
7420:                 storage->RangeSrcItem = item_data;
7421:             if ((flags & ImGuiMultiSelectFlags_NoAutoSelect) == 0)
7422:             {
7423:                 // Shift+Arrow always select
7424:                 // Ctrl+Shift+Arrow copy source selection state (already stored by BeginMultiSelect() in storage->RangeSelected)
7425:                 range_selected = (is_ctrl && storage->RangeSelected != -1) ? (storage->RangeSelected != 0) : true;
7426:             }
7427:             else
7428:             {
7429:                 // Shift+Arrow copy source selection state
7430:                 // Shift+Click always copy from target selection state
7431:                 if (ms->IsKeyboardSetRange)
7432:                     range_selected = (storage->RangeSelected != -1) ? (storage->RangeSelected != 0) : true;
7433:                 else
7434:                     range_selected = !selected;
7435:             }
7436:             range_direction = ms->RangeSrcPassedBy ? +1 : -1;
7437:         }
7438:         else
7439:         {
7440:             // Ctrl inverts selection, otherwise always select
7441:             if ((flags & ImGuiMultiSelectFlags_NoAutoSelect) == 0)
7442:                 selected = is_ctrl ? !selected : true;
7443:             else
7444:                 selected = !selected;
7445:             storage->RangeSrcItem = item_data;
7446:             range_selected = selected;
7447:             range_direction = +1;
7448:         }
7449:         MultiSelectAddSetRange(ms, range_selected, range_direction, storage->RangeSrcItem, item_data);
7450:     }
7451:     // Update/store the selection state of the Source item (used by Ctrl+Shift, when Source is unselected we perform a range unselect)
7452:     if (storage->RangeSrcItem == item_data)
7453:         storage->RangeSelected = selected ? 1 : 0;
7454:     // Update/store the selection state of focused item
7455:     if (g.NavId == id)
7456:     {
7457:         storage->NavIdItem = item_data;
7458:         storage->NavIdSelected = selected ? 1 : 0;
7459:     }
7460:     if (storage->NavIdItem == item_data)
7461:         ms->NavIdPassedBy = true;
7462:     ms->LastSubmittedItem = item_data;
7463:     *p_selected = selected;
7464:     *p_pressed = pressed;
7465: }
7466: void ImGui::MultiSelectAddSetAll(ImGuiMultiSelectTempData* ms, bool selected)
7467: {
7468:     ImGuiSelectionRequest req = { ImGuiSelectionRequestType_SetAll, selected, 0, ImGuiSelectionUserData_Invalid, ImGuiSelectionUserData_Invalid };
7469:     ms->IO.Requests.resize(0);      // Can always clear previous requests
7470:     ms->IO.Requests.push_back(req); // Add new request
7471: }
7472: void ImGui::MultiSelectAddSetRange(ImGuiMultiSelectTempData* ms, bool selected, int range_dir, ImGuiSelectionUserData first_item, ImGuiSelectionUserData last_item)
7473: {
7474:     // Merge contiguous spans into same request (unless NoRangeSelect is set which guarantees single-item ranges)
7475:     if (ms->IO.Requests.Size > 0 && first_item == last_item && (ms->Flags & ImGuiMultiSelectFlags_NoRangeSelect) == 0)
7476:     {
7477:         ImGuiSelectionRequest* prev = &ms->IO.Requests.Data[ms->IO.Requests.Size - 1];
7478:         if (prev->Type == ImGuiSelectionRequestType_SetRange && prev->RangeLastItem == ms->LastSubmittedItem && prev->Selected == selected)
7479:         {
7480:             prev->RangeLastItem = last_item;
7481:             return;
7482:         }
7483:     }
7484:     ImGuiSelectionRequest req = { ImGuiSelectionRequestType_SetRange, selected, (ImS8)range_dir, (range_dir > 0) ? first_item : last_item, (range_dir > 0) ? last_item : first_item };
7485:     ms->IO.Requests.push_back(req); // Add new request
7486: }
