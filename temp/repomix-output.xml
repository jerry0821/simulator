4020: static int* ImLowerBound(int* in_begin, int* in_end, int v)
4021: {
4022:     int* in_p = in_begin;
4023:     for (size_t count = (size_t)(in_end - in_p); count > 0; )
4024:     {
4025:         size_t count2 = count >> 1;
4026:         int* mid = in_p + count2;
4027:         if (*mid < v)
4028:         {
4029:             in_p = ++mid;
4030:             count -= count2 + 1;
4031:         }
4032:         else
4033:         {
4034:             count = count2;
4035:         }
4036:     }
4037:     return in_p;
4038: }
4039: // FIXME-WORDWRAP: Bundle some of this into ImGuiTextIndex and/or extract as a different tool?
4040: // 'max_output_buffer_size' happens to be a meaningful optimization to avoid writing the full line_index when not necessarily needed (e.g. very large buffer, scrolled up, inactive)
4041: static int InputTextLineIndexBuild(ImGuiInputTextFlags flags, ImGuiTextIndex* line_index, const char* buf, const char* buf_end, float wrap_width, int max_output_buffer_size, const char** out_buf_end)
4042: {
4043:     ImGuiContext& g = *GImGui;
4044:     int size = 0;
4045:     const char* s;
4046:     if (flags & ImGuiInputTextFlags_WordWrap)
4047:     {
4048:         for (s = buf; s < buf_end; s = (*s == '\n') ? s + 1 : s)
4049:         {
4050:             if (size++ <= max_output_buffer_size)
4051:                 line_index->Offsets.push_back((int)(s - buf));
4052:             s = ImFontCalcWordWrapPositionEx(g.Font, g.FontSize, s, buf_end, wrap_width, ImDrawTextFlags_WrapKeepBlanks);
4053:         }
4054:     }
4055:     else if (buf_end != NULL)
4056:     {
4057:         for (s = buf; s < buf_end; s = s ? s + 1 : buf_end)
4058:         {
4059:             if (size++ <= max_output_buffer_size)
4060:                 line_index->Offsets.push_back((int)(s - buf));
4061:             s = (const char*)ImMemchr(s, '\n', buf_end - s);
4062:         }
4063:     }
4064:     else
4065:     {
4066:         const char* s_eol;
4067:         for (s = buf; ; s = s_eol + 1)
4068:         {
4069:             if (size++ <= max_output_buffer_size)
4070:                 line_index->Offsets.push_back((int)(s - buf));
4071:             if ((s_eol = strchr(s, '\n')) != NULL)
4072:                 continue;
4073:             s += strlen(s);
4074:             break;
4075:         }
4076:     }
4077:     if (out_buf_end != NULL)
4078:         *out_buf_end = buf_end = s;
4079:     if (size == 0)
4080:     {
4081:         line_index->Offsets.push_back(0);
4082:         size++;
4083:     }
4084:     if (buf_end > buf && buf_end[-1] == '\n' && size <= max_output_buffer_size)
4085:     {
4086:         line_index->Offsets.push_back((int)(buf_end - buf));
4087:         size++;
4088:     }
4089:     return size;
4090: }
4091: static ImVec2 InputTextLineIndexGetPosOffset(ImGuiContext& g, ImGuiInputTextState* state, ImGuiTextIndex* line_index, const char* buf, const char* buf_end, int cursor_n)
4092: {
4093:     const char* cursor_ptr = buf + cursor_n;
4094:     int* it_begin = line_index->Offsets.begin();
4095:     int* it_end = line_index->Offsets.end();
4096:     const int* it = ImLowerBound(it_begin, it_end, cursor_n);
4097:     if (it > it_begin)
4098:         if (it == it_end || *it != cursor_n || (state != NULL && state->WrapWidth > 0.0f && state->LastMoveDirectionLR == ImGuiDir_Right && cursor_ptr[-1] != '\n' && cursor_ptr[-1] != 0))
4099:             it--;
4100:     const int line_no = (it == it_begin) ? 0 : line_index->Offsets.index_from_ptr(it);
4101:     const char* line_start = line_index->get_line_begin(buf, line_no);
4102:     ImVec2 offset;
4103:     offset.x = InputTextCalcTextSize(&g, line_start, cursor_ptr, buf_end, NULL, NULL, ImDrawTextFlags_WrapKeepBlanks).x;
4104:     offset.y = (line_no + 1) * g.FontSize;
4105:     return offset;
4106: }
