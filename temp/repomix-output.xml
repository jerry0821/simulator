31: Texture2D g_HeightMap : register(t0);
32: SamplerState g_Sampler : register(s0);
33:  
34: struct VS_IN
35: {
36:     float4 posL : POSITION0;
37:     float4 normalL : NORMAL0; //Local法線
38:     float4 blend : COLOR0;
39:     float2 uv : TEXCOORD0;
40: };
41:  
42: struct VS_OUT
43: {
44:     float4 posH : SV_POSITION;
45:     float4 posW : POSITION0;
46:     float4 normalW : NORMAL0;
47:     float4 blend : COLOR0;
48:     float2 uv : TEXCOORD0;
49:     
50:     float4 shadowPos : TEXCOORD1;
51: };
52:  
53: //=============================================================================
54: // 頂点シェーダ
55: //=============================================================================
56: VS_OUT main(VS_IN vi)
57: {
58:     VS_OUT vo;
59:     
60:     // 座標変換
61: 
62:     float4x4 mtxWV = mul(world, view);
63:     float4x4 mtxWVP = mul(mtxWV, proj);
64:     vo.posH = mul(float4(vi.posL), mtxWVP);
65:     //vo.posH = mul(vi.posL, mul(mul(world, view), proj));
66:     
67:     //?通の?ー?ド変換行列 (x)
68:     //?ー?ド変換行列の転置逆行列 (O)
69:     float4 normalW = mul(float4(vi.normalL.xyz, 0.0f), world);
70:     vo.normalW = normalW;
71:     vo.posW = mul(float4(vi.posL), world);
72:     
73:     vo.blend = vi.blend;
74:     
75:     
76:     //vo.blend = vi.blend; //地面のテクスチャのブレンド値はそのままパススルー
77:     
78:     vo.uv = vi.uv;
