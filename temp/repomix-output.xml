 4253: bool ImGui::IsWindowContentHoverable(ImGuiWindow* window, ImGuiHoveredFlags flags)
 4254: {
 4255:     // An active popup disable hovering on other windows (apart from its own children)
 4256:     // FIXME-OPT: This could be cached/stored within the window.
 4257:     ImGuiContext& g = *GImGui;
 4258:     if (g.NavWindow)
 4259:         if (ImGuiWindow* focused_root_window = g.NavWindow->RootWindow)
 4260:             if (focused_root_window->WasActive && focused_root_window != window->RootWindow)
 4261:             {
 4262:                 // For the purpose of those flags we differentiate "standard popup" from "modal popup"
 4263:                 // NB: The 'else' is important because Modal windows are also Popups.
 4264:                 bool want_inhibit = false;
 4265:                 if (focused_root_window->Flags & ImGuiWindowFlags_Modal)
 4266:                     want_inhibit = true;
 4267:                 else if ((focused_root_window->Flags & ImGuiWindowFlags_Popup) && !(flags & ImGuiHoveredFlags_AllowWhenBlockedByPopup))
 4268:                     want_inhibit = true;
 4269:                 // Inhibit hover unless the window is within the stack of our modal/popup
 4270:                 if (want_inhibit)
 4271:                     if (!IsWindowWithinBeginStackOf(window->RootWindow, focused_root_window))
 4272:                         return false;
 4273:             }
 4274:     return true;
 4275: }
