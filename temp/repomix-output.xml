7742: // This is merely a helper around BeginListBox(), EndListBox().
7743: // Considering using those directly to submit custom data or store selection differently.
7744: bool ImGui::ListBox(const char* label, int* current_item, const char* (*getter)(void* user_data, int idx), void* user_data, int items_count, int height_in_items)
7745: {
7746:     ImGuiContext& g = *GImGui;
7747:     // Calculate size from "height_in_items"
7748:     if (height_in_items < 0)
7749:         height_in_items = ImMin(items_count, 7);
7750:     float height_in_items_f = height_in_items + 0.25f;
7751:     ImVec2 size(0.0f, ImTrunc(GetTextLineHeightWithSpacing() * height_in_items_f + g.Style.FramePadding.y * 2.0f));
7752:     if (!BeginListBox(label, size))
7753:         return false;
7754:     // Assume all items have even height (= 1 line of text). If you need items of different height,
7755:     // you can create a custom version of ListBox() in your code without using the clipper.
7756:     bool value_changed = false;
7757:     ImGuiListClipper clipper;
7758:     clipper.Begin(items_count, GetTextLineHeightWithSpacing()); // We know exactly our line height here so we pass it as a minor optimization, but generally you don't need to.
7759:     clipper.IncludeItemByIndex(*current_item);
7760:     while (clipper.Step())
7761:         for (int i = clipper.DisplayStart; i < clipper.DisplayEnd; i++)
7762:         {
7763:             const char* item_text = getter(user_data, i);
7764:             if (item_text == NULL)
7765:                 item_text = "*Unknown item*";
7766:             PushID(i);
7767:             const bool item_selected = (i == *current_item);
7768:             if (Selectable(item_text, item_selected))
7769:             {
7770:                 *current_item = i;
7771:                 value_changed = true;
7772:             }
7773:             if (item_selected)
7774:                 SetItemDefaultFocus();
7775:             PopID();
7776:         }
7777:     EndListBox();
7778:     if (value_changed)
7779:         MarkItemEdited(g.LastItemData.ID);
7780:     return value_changed;
7781: }
