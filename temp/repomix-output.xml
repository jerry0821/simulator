3578: // Free up/compact internal Table buffers for when it gets unused
3579: void ImGui::TableGcCompactTransientBuffers(ImGuiTable* table)
3580: {
3581:     //IMGUI_DEBUG_PRINT("TableGcCompactTransientBuffers() id=0x%08X\n", table->ID);
3582:     ImGuiContext& g = *GImGui;
3583:     IM_ASSERT(table->MemoryCompacted == false);
3584:     table->SortSpecs.Specs = NULL;
3585:     table->SortSpecsMulti.clear();
