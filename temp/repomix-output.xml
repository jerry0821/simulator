1287: static inline ImDrawFlags FixRectCornerFlags(ImDrawFlags flags)
1288: {
1289:     /*
1290:     IM_STATIC_ASSERT(ImDrawFlags_RoundCornersTopLeft == (1 << 4));
1291: #ifndef IMGUI_DISABLE_OBSOLETE_FUNCTIONS
1292:     // Obsoleted in 1.82 (from February 2021). This code was stripped/simplified and mostly commented in 1.90 (from September 2023)
1293:     // - Legacy Support for hard coded ~0 (used to be a suggested equivalent to ImDrawCornerFlags_All)
1294:     if (flags == ~0)                    { return ImDrawFlags_RoundCornersAll; }
1295:     // - Legacy Support for hard coded 0x01 to 0x0F (matching 15 out of 16 old flags combinations). Read details in older version of this code.
1296:     if (flags >= 0x01 && flags <= 0x0F) { return (flags << 4); }
1297:     // We cannot support hard coded 0x00 with 'float rounding > 0.0f' --> replace with ImDrawFlags_RoundCornersNone or use 'float rounding = 0.0f'
1298: #endif
1299:     */
1300:     // If this assert triggers, please update your code replacing hardcoded values with new ImDrawFlags_RoundCorners* values.
1301:     // Note that ImDrawFlags_Closed (== 0x01) is an invalid flag for AddRect(), AddRectFilled(), PathRect() etc. anyway.
1302:     // See details in 1.82 Changelog as well as 2021/03/12 and 2023/09/08 entries in "API BREAKING CHANGES" section.
1303:     IM_ASSERT((flags & 0x0F) == 0 && "Misuse of legacy hardcoded ImDrawCornerFlags values!");
1304:     if ((flags & ImDrawFlags_RoundCornersMask_) == 0)
1305:         flags |= ImDrawFlags_RoundCornersAll;
1306:     return flags;
1307: }
1308: void ImDrawList::PathRect(const ImVec2& a, const ImVec2& b, float rounding, ImDrawFlags flags)
1309: {
1310:     if (rounding >= 0.5f)
1311:     {
1312:         flags = FixRectCornerFlags(flags);
1313:         rounding = ImMin(rounding, ImFabs(b.x - a.x) * (((flags & ImDrawFlags_RoundCornersTop) == ImDrawFlags_RoundCornersTop) || ((flags & ImDrawFlags_RoundCornersBottom) == ImDrawFlags_RoundCornersBottom) ? 0.5f : 1.0f) - 1.0f);
1314:         rounding = ImMin(rounding, ImFabs(b.y - a.y) * (((flags & ImDrawFlags_RoundCornersLeft) == ImDrawFlags_RoundCornersLeft) || ((flags & ImDrawFlags_RoundCornersRight) == ImDrawFlags_RoundCornersRight) ? 0.5f : 1.0f) - 1.0f);
1315:     }
1316:     if (rounding < 0.5f || (flags & ImDrawFlags_RoundCornersMask_) == ImDrawFlags_RoundCornersNone)
1317:     {
1318:         PathLineTo(a);
1319:         PathLineTo(ImVec2(b.x, a.y));
1320:         PathLineTo(b);
1321:         PathLineTo(ImVec2(a.x, b.y));
1322:     }
1323:     else
1324:     {
1325:         const float rounding_tl = (flags & ImDrawFlags_RoundCornersTopLeft)     ? rounding : 0.0f;
1326:         const float rounding_tr = (flags & ImDrawFlags_RoundCornersTopRight)    ? rounding : 0.0f;
1327:         const float rounding_br = (flags & ImDrawFlags_RoundCornersBottomRight) ? rounding : 0.0f;
1328:         const float rounding_bl = (flags & ImDrawFlags_RoundCornersBottomLeft)  ? rounding : 0.0f;
1329:         PathArcToFast(ImVec2(a.x + rounding_tl, a.y + rounding_tl), rounding_tl, 6, 9);
1330:         PathArcToFast(ImVec2(b.x - rounding_tr, a.y + rounding_tr), rounding_tr, 9, 12);
1331:         PathArcToFast(ImVec2(b.x - rounding_br, b.y - rounding_br), rounding_br, 0, 3);
1332:         PathArcToFast(ImVec2(a.x + rounding_bl, b.y - rounding_bl), rounding_bl, 3, 6);
1333:     }
1334: }
