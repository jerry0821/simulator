157:       {0.5f, 0.5f, 0.5f, 0.0f, 0.0f, 1.0f, 1, 1, 1, 1, 0, 0},
158:       {-0.5f, 0.5f, 0.5f, 0.0f, 0.0f, 1.0f, 1, 1, 1, 1, 1, 0},
159:       {-0.5f, -0.5f, 0.5f, 0.0f, 0.0f, 1.0f, 1, 1, 1, 1, 1, 1},
160:   };
161:   if (!s_TiledVB) {
162:     D3D11_BUFFER_DESC bd{};
163:     bd.Usage = D3D11_USAGE_IMMUTABLE;
164:     bd.ByteWidth = sizeof(verts);
165:     bd.BindFlags = D3D11_BIND_VERTEX_BUFFER;
166:     D3D11_SUBRESOURCE_DATA sd{verts, 0, 0};
167:     Direct3D_GetDevice()->CreateBuffer(&bd, &sd, &s_TiledVB);
168:     if (!s_TiledVB)
169:       return;
170:   }
171:   Shader3D_Begin();
172:   Shader3D_SetWorldMatrix(w);
173:   Texture_SetTexture(texId);
174:   UINT stride = sizeof(TV), offset = 0;
175:   Direct3D_GetContext()->IASetVertexBuffers(0, 1, &s_TiledVB, &stride, &offset);
176:   Direct3D_GetContext()->IASetPrimitiveTopology(
177:       D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
178:   Direct3D_GetContext()->Draw(36, 0);
179: }
180: void Map_Draw(const DirectX::XMMATRIX &view, const DirectX::XMMATRIX &proj) {
181:   XMMATRIX mtxWorld;
182:   ShaderField_SetLightViewProj(Light_GetLightViewProjectionMatrix());
183:   Shader3D_SetViewMatrix(view);
184:   Shader3D_SetProjMatrix(proj);
185:   for (MapObject &obj : g_MapObjects) {
186:     // Per-object texture resolution (lazy load)
187:     int resolvedTex = -1;
188:     if (!obj.TexturePath.empty()) {
189:       if (obj.TextureId < 0) {
190:         // Convert char path to wchar_t for ResourceManager
191:         std::wstring wpath(obj.TexturePath.begin(), obj.TexturePath.end());
192:         obj.TextureId = ResourceManager::GetTexture(wpath.c_str());
193:       }
194:       resolvedTex = obj.TextureId;
195:     }
196:     Direct3D_SetDepthEnable(true);
197:     switch (obj.KindId) {
198:     case FIELD:
199:       if (g_TerrainVisible) {
200:         XMMATRIX scale = XMMatrixScaling(5.0f, 5.0f, 5.0f);
201:         ShaderField_SetWorldMatrix(scale);
202:         MeshField_Draw();
203:       }
204:       break;
205:     case BLOCK:
206:       mtxWorld =
207:           XMMatrixScaling(obj.Scale.x, obj.Scale.y, obj.Scale.z) *
208:           XMMatrixRotationRollPitchYaw(obj.Rotation.x, obj.Rotation.y,
209:                                        obj.Rotation.z) *
210:           XMMatrixTranslation(obj.Position.x, obj.Position.y, obj.Position.z);
211:       if (resolvedTex >= 0)
212:         DrawCubeTiled(resolvedTex, mtxWorld);
213:       else
214:         Cube_Draw(g_CubeTexId, mtxWorld);
215:       break;
216:     case GRASS:
217:       mtxWorld =
218:           XMMatrixScaling(obj.Scale.x, obj.Scale.y, obj.Scale.z) *
219:           XMMatrixRotationRollPitchYaw(obj.Rotation.x, obj.Rotation.y,
220:                                        obj.Rotation.z) *
221:           XMMatrixTranslation(obj.Position.x, obj.Position.y, obj.Position.z);
222:       if (resolvedTex >= 0)
223:         DrawCubeTiled(resolvedTex, mtxWorld);
224:       else
225:         Cube_Draw(g_CubeGrassTexId, mtxWorld);
226:       break;
227:     case SPHERE:
228:       mtxWorld =
229:           XMMatrixScaling(obj.Scale.x, obj.Scale.y, obj.Scale.z) *
230:           XMMatrixRotationRollPitchYaw(obj.Rotation.x, obj.Rotation.y,
231:                                        obj.Rotation.z) *
232:           XMMatrixTranslation(obj.Position.x, obj.Position.y, obj.Position.z);
233:       Sphere_Draw(resolvedTex >= 0 ? resolvedTex : g_WhiteTexId, mtxWorld);
234:       break;
235:     case CYLINDER:
236:       mtxWorld =
237:           XMMatrixScaling(obj.Scale.x, obj.Scale.y, obj.Scale.z) *
238:           XMMatrixRotationRollPitchYaw(obj.Rotation.x, obj.Rotation.y,
239:                                        obj.Rotation.z) *
240:           XMMatrixTranslation(obj.Position.x, obj.Position.y, obj.Position.z);
241:       Cylinder_Draw(resolvedTex >= 0 ? resolvedTex : g_WhiteTexId, mtxWorld);
242:       break;
243:     case CAPSULE:
244:       mtxWorld =
245:           XMMatrixScaling(obj.Scale.x, obj.Scale.y, obj.Scale.z) *
246:           XMMatrixRotationRollPitchYaw(obj.Rotation.x, obj.Rotation.y,
247:                                        obj.Rotation.z) *
248:           XMMatrixTranslation(obj.Position.x, obj.Position.y, obj.Position.z);
249:       Capsule_Draw(resolvedTex >= 0 ? resolvedTex : g_WhiteTexId, mtxWorld);
250:       break;
251:     case SLIME:
252:       mtxWorld =
253:           XMMatrixScaling(obj.Scale.x, obj.Scale.y, obj.Scale.z) *
254:           XMMatrixTranslation(obj.Position.x, obj.Position.y, obj.Position.z);
255:       ModelToonDraw(g_Slime01, mtxWorld, view, proj);
256:       break;
257:     case ROCK:
258:       if (g_Rock) {
259:         mtxWorld =
260:             XMMatrixScaling(obj.Scale.x, obj.Scale.y, obj.Scale.z) *
261:             XMMatrixTranslation(obj.Position.x, obj.Position.y, obj.Position.z);
262:         ModelDraw(g_Rock, mtxWorld);
263:       }
264:       break;
265:     }
266:   }
267:   ID3D11ShaderResourceView *nullSRV = nullptr;
268:   Direct3D_GetContext()->PSSetShaderResources(2, 1, &nullSRV);
269: }
