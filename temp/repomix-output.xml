 3464:     ImVec2 pos = pos_min;
 3465:     const ImVec2 text_size = text_size_if_known ? *text_size_if_known : CalcTextSize(text, text_display_end, false, 0.0f);
 3466:     const ImVec2* clip_min = clip_rect ? &clip_rect->Min : &pos_min;
 3467:     const ImVec2* clip_max = clip_rect ? &clip_rect->Max : &pos_max;
 3468:     bool need_clipping = (pos.x + text_size.x >= clip_max->x) || (pos.y + text_size.y >= clip_max->y);
