 5120: static int IMGUI_CDECL ChildWindowComparer(const void* lhs, const void* rhs)
 5121: {
 5122:     const ImGuiWindow* const a = *(const ImGuiWindow* const *)lhs;
 5123:     const ImGuiWindow* const b = *(const ImGuiWindow* const *)rhs;
 5124:     if (int d = (a->Flags & ImGuiWindowFlags_Popup) - (b->Flags & ImGuiWindowFlags_Popup))
 5125:         return d;
 5126:     if (int d = (a->Flags & ImGuiWindowFlags_Tooltip) - (b->Flags & ImGuiWindowFlags_Tooltip))
 5127:         return d;
 5128:     return a->BeginOrderWithinParent - b->BeginOrderWithinParent;
 5129: }
 5130: static void AddWindowToSortBuffer(ImVector<ImGuiWindow*>* out_sorted_windows, ImGuiWindow* window)
 5131: {
 5132:     out_sorted_windows->push_back(window);
 5133:     if (window->Active)
 5134:     {
 5135:         int count = window->DC.ChildWindows.Size;
 5136:         ImQsort(window->DC.ChildWindows.Data, (size_t)count, sizeof(ImGuiWindow*), ChildWindowComparer);
 5137:         for (int i = 0; i < count; i++)
 5138:         {
 5139:             ImGuiWindow* child = window->DC.ChildWindows[i];
 5140:             if (child->Active)
 5141:                 AddWindowToSortBuffer(out_sorted_windows, child);
 5142:         }
 5143:     }
 5144: }
 5145: static void AddWindowToDrawData(ImGuiWindow* window, int layer)
 5146: {
 5147:     ImGuiContext& g = *GImGui;
 5148:     ImGuiViewportP* viewport = g.Viewports[0];
 5149:     g.IO.MetricsRenderWindows++;
 5150:     if (window->DrawList->_Splitter._Count > 1)
 5151:         window->DrawList->ChannelsMerge(); // Merge if user forgot to merge back. Also required in Docking branch for ImGuiWindowFlags_DockNodeHost windows.
 5152:     ImGui::AddDrawListToDrawDataEx(&viewport->DrawDataP, viewport->DrawDataBuilder.Layers[layer], window->DrawList);
 5153:     for (ImGuiWindow* child : window->DC.ChildWindows)
 5154:         if (IsWindowActiveAndVisible(child)) // Clipped children may have been marked not active
 5155:             AddWindowToDrawData(child, layer);
 5156: }
 5157: static inline int GetWindowDisplayLayer(ImGuiWindow* window)
 5158: {
 5159:     return (window->Flags & ImGuiWindowFlags_Tooltip) ? 1 : 0;
 5160: }
 5161: // Layer is locked for the root window, however child windows may use a different viewport (e.g. extruding menu)
 5162: static inline void AddRootWindowToDrawData(ImGuiWindow* window)
 5163: {
 5164:     AddWindowToDrawData(window, GetWindowDisplayLayer(window));
 5165: }
 5166: static void FlattenDrawDataIntoSingleLayer(ImDrawDataBuilder* builder)
 5167: {
 5168:     int n = builder->Layers[0]->Size;
 5169:     int full_size = n;
 5170:     for (int i = 1; i < IM_ARRAYSIZE(builder->Layers); i++)
 5171:         full_size += builder->Layers[i]->Size;
 5172:     builder->Layers[0]->resize(full_size);
 5173:     for (int layer_n = 1; layer_n < IM_ARRAYSIZE(builder->Layers); layer_n++)
 5174:     {
 5175:         ImVector<ImDrawList*>* layer = builder->Layers[layer_n];
 5176:         if (layer->empty())
 5177:             continue;
 5178:         memcpy(builder->Layers[0]->Data + n, layer->Data, layer->Size * sizeof(ImDrawList*));
 5179:         n += layer->Size;
 5180:         layer->resize(0);
 5181:     }
 5182: }
 5183: static void InitViewportDrawData(ImGuiViewportP* viewport)
 5184: {
 5185:     ImGuiIO& io = ImGui::GetIO();
 5186:     ImDrawData* draw_data = &viewport->DrawDataP;
 5187:     viewport->DrawDataBuilder.Layers[0] = &draw_data->CmdLists;
 5188:     viewport->DrawDataBuilder.Layers[1] = &viewport->DrawDataBuilder.LayerData1;
 5189:     viewport->DrawDataBuilder.Layers[0]->resize(0);
 5190:     viewport->DrawDataBuilder.Layers[1]->resize(0);
 5191:     draw_data->Valid = true;
 5192:     draw_data->CmdListsCount = 0;
 5193:     draw_data->TotalVtxCount = draw_data->TotalIdxCount = 0;
 5194:     draw_data->DisplayPos = viewport->Pos;
 5195:     draw_data->DisplaySize = viewport->Size;
 5196:     draw_data->FramebufferScale = io.DisplayFramebufferScale;
 5197:     draw_data->OwnerViewport = viewport;
 5198:     draw_data->Textures = &ImGui::GetPlatformIO().Textures;
 5199: }
 5200: // Push a clipping rectangle for both ImGui logic (hit-testing etc.) and low-level ImDrawList rendering.
 5201: // - When using this function it is sane to ensure that float are perfectly rounded to integer values,
 5202: //   so that e.g. (int)(max.x-min.x) in user's render produce correct result.
 5203: // - If the code here changes, may need to update code of functions like NextColumn() and PushColumnClipRect():
 5204: //   some frequently called functions which to modify both channels and clipping simultaneously tend to use the
 5205: //   more specialized SetWindowClipRectBeforeSetChannel() to avoid extraneous updates of underlying ImDrawCmds.
 5206: // - This is analogous to PushFont()/PopFont() in the sense that are a mixing a global stack and a window stack,
 5207: //   which in the case of ClipRect is not so problematic but tends to be more restrictive for fonts.
 5208: void ImGui::PushClipRect(const ImVec2& clip_rect_min, const ImVec2& clip_rect_max, bool intersect_with_current_clip_rect)
 5209: {
 5210:     ImGuiWindow* window = GetCurrentWindow();
 5211:     window->DrawList->PushClipRect(clip_rect_min, clip_rect_max, intersect_with_current_clip_rect);
 5212:     window->ClipRect = window->DrawList->_ClipRectStack.back();
 5213: }
 5214: void ImGui::PopClipRect()
 5215: {
 5216:     ImGuiWindow* window = GetCurrentWindow();
 5217:     window->DrawList->PopClipRect();
 5218:     window->ClipRect = window->DrawList->_ClipRectStack.back();
 5219: }
 5220: static void ImGui::RenderDimmedBackgroundBehindWindow(ImGuiWindow* window, ImU32 col)
 5221: {
 5222:     if ((col & IM_COL32_A_MASK) == 0)
 5223:         return;
 5224:     ImGuiViewportP* viewport = (ImGuiViewportP*)GetMainViewport();
 5225:     ImRect viewport_rect = viewport->GetMainRect();
 5226:     // Draw behind window by moving the draw command at the FRONT of the draw list
 5227:     {
 5228:         // We've already called AddWindowToDrawData() which called DrawList->ChannelsMerge() on DockNodeHost windows,
 5229:         // and draw list have been trimmed already, hence the explicit recreation of a draw command if missing.
 5230:         // FIXME: This is creating complication, might be simpler if we could inject a drawlist in drawdata at a given position and not attempt to manipulate ImDrawCmd order.
 5231:         ImDrawList* draw_list = window->RootWindow->DrawList;
 5232:         if (draw_list->CmdBuffer.Size == 0)
 5233:             draw_list->AddDrawCmd();
 5234:         draw_list->PushClipRect(viewport_rect.Min - ImVec2(1, 1), viewport_rect.Max + ImVec2(1, 1), false); // FIXME: Need to stricty ensure ImDrawCmd are not merged (ElemCount==6 checks below will verify that)
 5235:         draw_list->AddRectFilled(viewport_rect.Min, viewport_rect.Max, col);
 5236:         ImDrawCmd cmd = draw_list->CmdBuffer.back();
 5237:         IM_ASSERT(cmd.ElemCount == 6);
 5238:         draw_list->CmdBuffer.pop_back();
 5239:         draw_list->CmdBuffer.push_front(cmd);
 5240:         draw_list->AddDrawCmd(); // We need to create a command as CmdBuffer.back().IdxOffset won't be correct if we append to same command.
 5241:         draw_list->PopClipRect();
 5242:     }
 5243: }
 5244: ImGuiWindow* ImGui::FindBottomMostVisibleWindowWithinBeginStack(ImGuiWindow* parent_window)
 5245: {
 5246:     ImGuiContext& g = *GImGui;
 5247:     ImGuiWindow* bottom_most_visible_window = parent_window;
 5248:     for (int i = FindWindowDisplayIndex(parent_window); i >= 0; i--)
 5249:     {
 5250:         ImGuiWindow* window = g.Windows[i];
 5251:         if (window->Flags & ImGuiWindowFlags_ChildWindow)
 5252:             continue;
 5253:         if (!IsWindowWithinBeginStackOf(window, parent_window))
 5254:             break;
 5255:         if (IsWindowActiveAndVisible(window) && GetWindowDisplayLayer(window) <= GetWindowDisplayLayer(parent_window))
 5256:             bottom_most_visible_window = window;
 5257:     }
 5258:     return bottom_most_visible_window;
 5259: }
 5260: static void ImGui::RenderDimmedBackgrounds()
 5261: {
 5262:     ImGuiContext& g = *GImGui;
 5263:     ImGuiWindow* modal_window = GetTopMostAndVisiblePopupModal();
 5264:     if (g.DimBgRatio <= 0.0f && g.NavWindowingHighlightAlpha <= 0.0f)
 5265:         return;
 5266:     const bool dim_bg_for_modal = (modal_window != NULL);
 5267:     const bool dim_bg_for_window_list = (g.NavWindowingTargetAnim != NULL && g.NavWindowingTargetAnim->Active);
 5268:     if (!dim_bg_for_modal && !dim_bg_for_window_list)
 5269:         return;
 5270:     if (dim_bg_for_modal)
 5271:     {
 5272:         // Draw dimming behind modal or a begin stack child, whichever comes first in draw order.
 5273:         ImGuiWindow* dim_behind_window = FindBottomMostVisibleWindowWithinBeginStack(modal_window);
 5274:         RenderDimmedBackgroundBehindWindow(dim_behind_window, GetColorU32(modal_window->DC.ModalDimBgColor, g.DimBgRatio));
 5275:     }
 5276:     else if (dim_bg_for_window_list)
 5277:     {
 5278:         // Draw dimming behind Ctrl+Tab target window and behind Ctrl+Tab UI window
 5279:         RenderDimmedBackgroundBehindWindow(g.NavWindowingTargetAnim, GetColorU32(ImGuiCol_NavWindowingDimBg, g.DimBgRatio));
 5280:         // Draw border around Ctrl+Tab target window
 5281:         ImGuiWindow* window = g.NavWindowingTargetAnim;
 5282:         ImGuiViewport* viewport = GetMainViewport();
 5283:         float distance = g.FontSize;
 5284:         ImRect bb = window->Rect();
 5285:         bb.Expand(distance);
 5286:         if (bb.GetWidth() >= viewport->Size.x && bb.GetHeight() >= viewport->Size.y)
 5287:             bb.Expand(-distance - 1.0f); // If a window fits the entire viewport, adjust its highlight inward
 5288:         if (window->DrawList->CmdBuffer.Size == 0)
 5289:             window->DrawList->AddDrawCmd();
 5290:         window->DrawList->PushClipRect(viewport->Pos, viewport->Pos + viewport->Size);
 5291:         window->DrawList->AddRect(bb.Min, bb.Max, GetColorU32(ImGuiCol_NavWindowingHighlight, g.NavWindowingHighlightAlpha), window->WindowRounding, 0, 3.0f); // FIXME-DPI
 5292:         window->DrawList->PopClipRect();
 5293:     }
 5294: }
 5295: // This is normally called by Render(). You may want to call it directly if you want to avoid calling Render() but the gain will be very minimal.
 5296: void ImGui::EndFrame()
 5297: {
 5298:     ImGuiContext& g = *GImGui;
 5299:     IM_ASSERT(g.Initialized);
 5300:     // Don't process EndFrame() multiple times.
 5301:     if (g.FrameCountEnded == g.FrameCount)
 5302:         return;
 5303:     if (!g.WithinFrameScope)
 5304:     {
 5305:         IM_ASSERT_USER_ERROR(g.WithinFrameScope, "Forgot to call ImGui::NewFrame()?");
 5306:         return;
 5307:     }
 5308:     CallContextHooks(&g, ImGuiContextHookType_EndFramePre);
 5309:     // [EXPERIMENTAL] Recover from errors
 5310:     if (g.IO.ConfigErrorRecovery)
 5311:         ErrorRecoveryTryToRecoverState(&g.StackSizesInNewFrame);
 5312:     ErrorCheckEndFrameSanityChecks();
 5313:     ErrorCheckEndFrameFinalizeErrorTooltip();
 5314:     // Notify Platform/OS when our Input Method Editor cursor has moved (e.g. CJK inputs using Microsoft IME)
 5315:     ImGuiPlatformImeData* ime_data = &g.PlatformImeData;
 5316:     if (g.PlatformIO.Platform_SetImeDataFn != NULL && memcmp(ime_data, &g.PlatformImeDataPrev, sizeof(ImGuiPlatformImeData)) != 0)
 5317:     {
 5318:         IM_ASSERT(ime_data->ViewportId == IMGUI_VIEWPORT_DEFAULT_ID); // master branch
 5319:         ImGuiViewport* viewport = GetMainViewport();
 5320:         IMGUI_DEBUG_LOG_IO("[io] Calling Platform_SetImeDataFn(): WantVisible: %d, InputPos (%.2f,%.2f) for Viewport 0x%08X\n", ime_data->WantVisible, ime_data->InputPos.x, ime_data->InputPos.y, viewport->ID);
 5321:         g.PlatformIO.Platform_SetImeDataFn(&g, viewport, ime_data);
 5322:     }
 5323:     g.WantTextInputNextFrame = ime_data->WantTextInput ? 1 : 0;
 5324:     // Hide implicit/fallback "Debug" window if it hasn't been used
 5325:     g.WithinFrameScopeWithImplicitWindow = false;
 5326:     if (g.CurrentWindow && !g.CurrentWindow->WriteAccessed)
 5327:         g.CurrentWindow->Active = false;
 5328:     End();
 5329:     // Update navigation: Ctrl+Tab, wrap-around requests
 5330:     NavEndFrame();
 5331:     // Drag and Drop: Elapse payload (if delivered, or if source stops being submitted)
 5332:     if (g.DragDropActive)
 5333:     {
 5334:         bool is_delivered = g.DragDropPayload.Delivery;
 5335:         bool is_elapsed = (g.DragDropSourceFrameCount + 1 < g.FrameCount) && ((g.DragDropSourceFlags & ImGuiDragDropFlags_PayloadAutoExpire) || g.DragDropMouseButton == -1 || !IsMouseDown(g.DragDropMouseButton));
 5336:         if (is_delivered || is_elapsed)
 5337:             ClearDragDrop();
 5338:     }
 5339:     // Drag and Drop: Fallback for missing source tooltip. This is not ideal but better than nothing.
 5340:     // If you want to handle source item disappearing: instead of submitting your description tooltip
 5341:     // in the BeginDragDropSource() block of the dragged item, you can submit them from a safe single spot
 5342:     // (e.g. end of your item loop, or before EndFrame) by reading payload data.
 5343:     // In the typical case, the contents of drag tooltip should be possible to infer solely from payload data.
 5344:     if (g.DragDropActive && g.DragDropSourceFrameCount + 1 < g.FrameCount && !(g.DragDropSourceFlags & ImGuiDragDropFlags_SourceNoPreviewTooltip))
 5345:     {
 5346:         g.DragDropWithinSource = true;
 5347:         SetTooltip("...");
 5348:         g.DragDropWithinSource = false;
 5349:     }
 5350:     // End frame
 5351:     g.WithinFrameScope = false;
 5352:     g.FrameCountEnded = g.FrameCount;
 5353:     UpdateFontsEndFrame();
 5354:     // Initiate moving window + handle left-click and right-click focus
 5355:     UpdateMouseMovingWindowEndFrame();
 5356:     // Sort the window list so that all child windows are after their parent
 5357:     // We cannot do that on FocusWindow() because children may not exist yet
 5358:     g.WindowsTempSortBuffer.resize(0);
 5359:     g.WindowsTempSortBuffer.reserve(g.Windows.Size);
 5360:     for (ImGuiWindow* window : g.Windows)
 5361:     {
 5362:         if (window->Active && (window->Flags & ImGuiWindowFlags_ChildWindow))       // if a child is active its parent will add it
 5363:             continue;
 5364:         AddWindowToSortBuffer(&g.WindowsTempSortBuffer, window);
 5365:     }
 5366:     // This usually assert if there is a mismatch between the ImGuiWindowFlags_ChildWindow / ParentWindow values and DC.ChildWindows[] in parents, aka we've done something wrong.
 5367:     IM_ASSERT(g.Windows.Size == g.WindowsTempSortBuffer.Size);
 5368:     g.Windows.swap(g.WindowsTempSortBuffer);
 5369:     g.IO.MetricsActiveWindows = g.WindowsActiveCount;
 5370:     UpdateTexturesEndFrame();
 5371:     // Unlock font atlas
 5372:     for (ImFontAtlas* atlas : g.FontAtlases)
 5373:         atlas->Locked = false;
 5374:     // Clear Input data for next frame
 5375:     g.IO.MousePosPrev = g.IO.MousePos;
 5376:     g.IO.AppFocusLost = false;
 5377:     g.IO.MouseWheel = g.IO.MouseWheelH = 0.0f;
 5378:     g.IO.InputQueueCharacters.resize(0);
 5379:     CallContextHooks(&g, ImGuiContextHookType_EndFramePost);
 5380: }
 5381: // Prepare the data for rendering so you can call GetDrawData()
 5382: // (As with anything within the ImGui:: namespace this doesn't touch your GPU or graphics API at all:
 5383: // it is the role of the ImGui_ImplXXXX_RenderDrawData() function provided by the renderer backend)
 5384: void ImGui::Render()
 5385: {
 5386:     ImGuiContext& g = *GImGui;
 5387:     IM_ASSERT(g.Initialized);
 5388:     if (g.FrameCountEnded != g.FrameCount)
 5389:         EndFrame();
 5390:     if (g.FrameCountRendered == g.FrameCount)
 5391:         return;
 5392:     g.FrameCountRendered = g.FrameCount;
 5393:     g.IO.MetricsRenderWindows = 0;
 5394:     CallContextHooks(&g, ImGuiContextHookType_RenderPre);
 5395:     // Add background ImDrawList (for each active viewport)
 5396:     for (ImGuiViewportP* viewport : g.Viewports)
 5397:     {
 5398:         InitViewportDrawData(viewport);
 5399:         if (viewport->BgFgDrawLists[0] != NULL)
 5400:             AddDrawListToDrawDataEx(&viewport->DrawDataP, viewport->DrawDataBuilder.Layers[0], GetBackgroundDrawList(viewport));
 5401:     }
 5402:     // Draw modal/window whitening backgrounds
 5403:     RenderDimmedBackgrounds();
 5404:     // Add ImDrawList to render
 5405:     ImGuiWindow* windows_to_render_top_most[2];
 5406:     windows_to_render_top_most[0] = (g.NavWindowingTarget && !(g.NavWindowingTarget->Flags & ImGuiWindowFlags_NoBringToFrontOnFocus)) ? g.NavWindowingTarget->RootWindow : NULL;
 5407:     windows_to_render_top_most[1] = (g.NavWindowingTarget ? g.NavWindowingListWindow : NULL);
 5408:     for (ImGuiWindow* window : g.Windows)
 5409:     {
 5410:         IM_MSVC_WARNING_SUPPRESS(6011); // Static Analysis false positive "warning C6011: Dereferencing NULL pointer 'window'"
 5411:         if (IsWindowActiveAndVisible(window) && (window->Flags & ImGuiWindowFlags_ChildWindow) == 0 && window != windows_to_render_top_most[0] && window != windows_to_render_top_most[1])
 5412:             AddRootWindowToDrawData(window);
 5413:     }
 5414:     for (int n = 0; n < IM_ARRAYSIZE(windows_to_render_top_most); n++)
 5415:         if (windows_to_render_top_most[n] && IsWindowActiveAndVisible(windows_to_render_top_most[n])) // NavWindowingTarget is always temporarily displayed as the top-most window
 5416:             AddRootWindowToDrawData(windows_to_render_top_most[n]);
 5417:     // Draw software mouse cursor if requested by io.MouseDrawCursor flag
 5418:     if (g.IO.MouseDrawCursor && g.MouseCursor != ImGuiMouseCursor_None)
 5419:         RenderMouseCursor(g.IO.MousePos, g.Style.MouseCursorScale, g.MouseCursor, IM_COL32_WHITE, IM_COL32_BLACK, IM_COL32(0, 0, 0, 48));
 5420:     // Setup ImDrawData structures for end-user
 5421:     g.IO.MetricsRenderVertices = g.IO.MetricsRenderIndices = 0;
 5422:     for (ImGuiViewportP* viewport : g.Viewports)
 5423:     {
 5424:         FlattenDrawDataIntoSingleLayer(&viewport->DrawDataBuilder);
 5425:         // Add foreground ImDrawList (for each active viewport)
 5426:         if (viewport->BgFgDrawLists[1] != NULL)
 5427:             AddDrawListToDrawDataEx(&viewport->DrawDataP, viewport->DrawDataBuilder.Layers[0], GetForegroundDrawList(viewport));
 5428:         // We call _PopUnusedDrawCmd() last thing, as RenderDimmedBackgrounds() rely on a valid command being there (especially in docking branch).
 5429:         ImDrawData* draw_data = &viewport->DrawDataP;
 5430:         IM_ASSERT(draw_data->CmdLists.Size == draw_data->CmdListsCount);
 5431:         for (ImDrawList* draw_list : draw_data->CmdLists)
 5432:             draw_list->_PopUnusedDrawCmd();
 5433:         g.IO.MetricsRenderVertices += draw_data->TotalVtxCount;
 5434:         g.IO.MetricsRenderIndices += draw_data->TotalIdxCount;
 5435:     }
 5436: #ifndef IMGUI_DISABLE_DEBUG_TOOLS
 5437:     if (g.IO.BackendFlags & ImGuiBackendFlags_RendererHasTextures)
 5438:         for (ImFontAtlas* atlas : g.FontAtlases)
 5439:             ImFontAtlasDebugLogTextureRequests(atlas);
 5440: #endif
 5441:     CallContextHooks(&g, ImGuiContextHookType_RenderPost);
 5442: }
 5443: // Calculate text size. Text can be multi-line. Optionally ignore text after a ## marker.
 5444: // CalcTextSize("") should return ImVec2(0.0f, g.FontSize)
 5445: ImVec2 ImGui::CalcTextSize(const char* text, const char* text_end, bool hide_text_after_double_hash, float wrap_width)
 5446: {
 5447:     ImGuiContext& g = *GImGui;
 5448:     const char* text_display_end;
 5449:     if (hide_text_after_double_hash)
 5450:         text_display_end = FindRenderedTextEnd(text, text_end);      // Hide anything after a '##' string
 5451:     else
 5452:         text_display_end = text_end;
 5453:     ImFont* font = g.Font;
 5454:     const float font_size = g.FontSize;
 5455:     if (text == text_display_end)
 5456:         return ImVec2(0.0f, font_size);
 5457:     ImVec2 text_size = font->CalcTextSizeA(font_size, FLT_MAX, wrap_width, text, text_display_end, NULL);
 5458:     // Round
 5459:     // FIXME: This has been here since Dec 2015 (7b0bf230) but down the line we want this out.
 5460:     // FIXME: Investigate using ceilf or e.g.
 5461:     // - https://git.musl-libc.org/cgit/musl/tree/src/math/ceilf.c
 5462:     // - https://embarkstudios.github.io/rust-gpu/api/src/libm/math/ceilf.rs.html
 5463:     text_size.x = IM_TRUNC(text_size.x + 0.99999f);
 5464:     return text_size;
 5465: }
 5466: // Find window given position, search front-to-back
 5467: // - Typically write output back to g.HoveredWindow and g.HoveredWindowUnderMovingWindow.
 5468: // - FIXME: Note that we have an inconsequential lag here: OuterRectClipped is updated in Begin(), so windows moved programmatically
 5469: //   with SetWindowPos() and not SetNextWindowPos() will have that rectangle lagging by a frame at the time FindHoveredWindow() is
 5470: //   called, aka before the next Begin(). Moving window isn't affected.
 5471: // - The 'find_first_and_in_any_viewport = true' mode is only used by TestEngine. It is simpler to maintain here.
 5472: void ImGui::FindHoveredWindowEx(const ImVec2& pos, bool find_first_and_in_any_viewport, ImGuiWindow** out_hovered_window, ImGuiWindow** out_hovered_window_under_moving_window)
 5473: {
 5474:     ImGuiContext& g = *GImGui;
 5475:     ImGuiWindow* hovered_window = NULL;
 5476:     ImGuiWindow* hovered_window_under_moving_window = NULL;
 5477:     if (find_first_and_in_any_viewport == false && g.MovingWindow && !(g.MovingWindow->Flags & ImGuiWindowFlags_NoMouseInputs))
 5478:         hovered_window = g.MovingWindow;
 5479:     ImVec2 padding_regular = g.Style.TouchExtraPadding;
 5480:     ImVec2 padding_for_resize = ImMax(g.Style.TouchExtraPadding, ImVec2(g.Style.WindowBorderHoverPadding, g.Style.WindowBorderHoverPadding));
 5481:     for (int i = g.Windows.Size - 1; i >= 0; i--)
 5482:     {
 5483:         ImGuiWindow* window = g.Windows[i];
 5484:         IM_MSVC_WARNING_SUPPRESS(28182); // [Static Analyzer] Dereferencing NULL pointer.
 5485:         if (!window->WasActive || window->Hidden)
 5486:             continue;
 5487:         if (window->Flags & ImGuiWindowFlags_NoMouseInputs)
 5488:             continue;
 5489:         // Using the clipped AABB, a child window will typically be clipped by its parent (not always)
 5490:         ImVec2 hit_padding = (window->Flags & (ImGuiWindowFlags_NoResize | ImGuiWindowFlags_AlwaysAutoResize)) ? padding_regular : padding_for_resize;
 5491:         if (!window->OuterRectClipped.ContainsWithPad(pos, hit_padding))
 5492:             continue;
 5493:         // Support for one rectangular hole in any given window
 5494:         // FIXME: Consider generalizing hit-testing override (with more generic data, callback, etc.) (#1512)
 5495:         if (window->HitTestHoleSize.x != 0)
 5496:         {
 5497:             ImVec2 hole_pos(window->Pos.x + (float)window->HitTestHoleOffset.x, window->Pos.y + (float)window->HitTestHoleOffset.y);
 5498:             ImVec2 hole_size((float)window->HitTestHoleSize.x, (float)window->HitTestHoleSize.y);
 5499:             if (ImRect(hole_pos, hole_pos + hole_size).Contains(pos))
 5500:                 continue;
 5501:         }
 5502:         if (find_first_and_in_any_viewport)
 5503:         {
 5504:             hovered_window = window;
 5505:             break;
 5506:         }
 5507:         else
 5508:         {
 5509:             if (hovered_window == NULL)
 5510:                 hovered_window = window;
 5511:             IM_MSVC_WARNING_SUPPRESS(28182); // [Static Analyzer] Dereferencing NULL pointer.
 5512:             if (hovered_window_under_moving_window == NULL && (!g.MovingWindow || window->RootWindow != g.MovingWindow->RootWindow))
 5513:                 hovered_window_under_moving_window = window;
 5514:             if (hovered_window && hovered_window_under_moving_window)
 5515:                 break;
 5516:         }
 5517:     }
 5518:     *out_hovered_window = hovered_window;
 5519:     if (out_hovered_window_under_moving_window != NULL)
 5520:         *out_hovered_window_under_moving_window = hovered_window_under_moving_window;
 5521: }
