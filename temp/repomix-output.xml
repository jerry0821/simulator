 19: static ID3D11PixelShader* g_pPixelShader = nullptr;
 20: static ID3D11Buffer* g_pPSConstantBuffer0 = nullptr;
 21: // 注意！初期化で外部から設定されるもの。Release不要。
 22: static ID3D11Device* g_pDevice = nullptr;
 23: static ID3D11DeviceContext* g_pContext = nullptr;
 24: void Shader_SetMaterialColor(const DirectX::XMFLOAT4& color);
 25: bool Shader_Initialize(ID3D11Device* pDevice, ID3D11DeviceContext* pContext)
 26: {
 27: 	HRESULT hr; // 戻り値格納用
 28: 	// デバイスとデバイスコンテキストのチェック
 29: 	if (!pDevice || !pContext) {
 30: 		hal::dout << "Shader_Initialize() : 与えられたデバイスかコンテキストが不正です" << std::endl;
 31: 		return false;
 32: 	}
 33: 	// デバイスとデバイスコンテキストの保存
 34: 	g_pDevice = pDevice;
 35: 	g_pContext = pContext;
 36: 	// 事前コンパイル済み頂点シェーダーの読み込み
 37: 	std::ifstream ifs_vs("resource/shader/shader_vertex_2d.cso", std::ios::binary);
 38: 	if (!ifs_vs) {
 39: 		MessageBox(nullptr, "頂点シェーダーの読み込みに失敗しました\n\nshader_vertex_2d.cso", "エラー", MB_OK);
 40: 		return false;
 41: 	}
 42: 	// ファイルサイズを取得
 43: 	ifs_vs.seekg(0, std::ios::end); // ファイルポインタを末尾に移動
 44: 	std::streamsize filesize = ifs_vs.tellg(); // ファイルポインタの位置を取得（つまりファイルサイズ）
 45: 	ifs_vs.seekg(0, std::ios::beg); // ファイルポインタを先頭に戻す
 46: 	// バイナリデータを格納するためのバッファを確保
 47: 	unsigned char* vsbinary_pointer = new unsigned char[filesize];
 48: 	ifs_vs.read((char*)vsbinary_pointer, filesize); // バイナリデータを読み込む
 49: 	ifs_vs.close(); // ファイルを閉じる
 50: 	// 頂点シェーダーの作成
 51: 	hr = g_pDevice->CreateVertexShader(vsbinary_pointer, filesize, nullptr, &g_pVertexShader);
 52: 	if (FAILED(hr)) {
 53: 		hal::dout << "Shader_Initialize() : 頂点シェーダーの作成に失敗しました" << std::endl;
 54: 		delete[] vsbinary_pointer; // メモリリークしないようにバイナリデータのバッファを解放
 55: 		return false;
 56: 	}
 57: 	// 頂点レイアウトの定義
 58: 	D3D11_INPUT_ELEMENT_DESC layout[] = {
 59: 		{ "POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT,    0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 },
 60: 		{ "COLOR", 0, DXGI_FORMAT_R32G32B32A32_FLOAT,    0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 },
 61: 		{ "TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT,    0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 },
 62: 	};
 63: 	UINT num_elements = ARRAYSIZE(layout); // 配列の要素数を取得
 64: 	// 頂点レイアウトの作成
 65: 	hr = g_pDevice->CreateInputLayout(layout, num_elements, vsbinary_pointer, filesize, &g_pInputLayout);
 66: 	delete[] vsbinary_pointer; // バイナリデータのバッファを解放
 67: 	if (FAILED(hr)) {
 68: 		hal::dout << "Shader_Initialize() : 頂点レイアウトの作成に失敗しました" << std::endl;
 69: 		return false;
 70: 	}
 71: 	// 頂点シェーダー用定数バッファの作成
 72: 	D3D11_BUFFER_DESC buffer_desc{};
 73: 	buffer_desc.ByteWidth = sizeof(XMFLOAT4X4); // バッファのサイズ
 74: 	buffer_desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER; // バインドフラグ
 75: 	g_pDevice->CreateBuffer(&buffer_desc, nullptr, &g_pVSConstantBuffer0);
 76: 	g_pDevice->CreateBuffer(&buffer_desc, nullptr, &g_pVSConstantBuffer1);
 77: 	{
 78: 		D3D11_BUFFER_DESC ps_buffer_desc{};
 79: 		ps_buffer_desc.ByteWidth = sizeof(XMFLOAT4); // float4 (16バイト)
 80: 		ps_buffer_desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
 81: 		hr = g_pDevice->CreateBuffer(&ps_buffer_desc, nullptr, &g_pPSConstantBuffer0);
 82: 		if (FAILED(hr)) {
 83: 			hal::dout << "Shader_Initialize() : PS定数バッファの作成に失敗しました" << std::endl;
 84: 			return false;
 85: 		}
 86: 	}
 87: 	// 事前コンパイル済みピクセルシェーダーの読み込み
 88: 	std::ifstream ifs_ps("resource/shader/shader_pixel_2d.cso", std::ios::binary);
 89: 	if (!ifs_ps) {
 90: 		MessageBox(nullptr, "ピクセルシェーダーの読み込みに失敗しました\n\nshader_pixel_2d.cso", "エラー", MB_OK);
 91: 		return false;
 92: 	}
 93: 	ifs_ps.seekg(0, std::ios::end);
 94: 	filesize = ifs_ps.tellg();
 95: 	ifs_ps.seekg(0, std::ios::beg);
 96: 	unsigned char* psbinary_pointer = new unsigned char[filesize];
 97: 	ifs_ps.read((char*)psbinary_pointer, filesize);
 98: 	ifs_ps.close();
 99: 	// ピクセルシェーダーの作成
100: 	hr = g_pDevice->CreatePixelShader(psbinary_pointer, filesize, nullptr, &g_pPixelShader);
101: 	delete[] psbinary_pointer; // バイナリデータのバッファを解放
102: 	if (FAILED(hr)) {
103: 		hal::dout << "Shader_Initialize() : ピクセルシェーダーの作成に失敗しました" << std::endl;
104: 		return false;
105: 	}
106: 	return true;
107: }
108: void Shader_Finalize()
109: {
110: 	SAFE_RELEASE(g_pPixelShader);
111: 	SAFE_RELEASE(g_pVSConstantBuffer1);
112: 	SAFE_RELEASE(g_pVSConstantBuffer0);
113: 	SAFE_RELEASE(g_pInputLayout);
114: 	SAFE_RELEASE(g_pVertexShader);
115: 	SAFE_RELEASE(g_pPSConstantBuffer0);
116: }
117: void Shader_SetMaterialColor(const DirectX::XMFLOAT4& color)
118: {
119: 	if (g_pContext && g_pPSConstantBuffer0)
120: 	{
121: 		g_pContext->UpdateSubresource(g_pPSConstantBuffer0, 0, nullptr, &color, 0, 0);
122: 	}
123: }
124: void Shader_SetWorldMatrix(const DirectX::XMMATRIX& matrix)
125: {
126: 	// 定数バッファ格納用行列の構造体を定義
127: 	XMFLOAT4X4 transpose;
128: 	// 行列を転置して定数バッファ格納用行列に変換
129: 	XMStoreFloat4x4(&transpose, XMMatrixTranspose(matrix));
130: 	// 定数バッファに行列をセット
131: 	g_pContext->UpdateSubresource(g_pVSConstantBuffer1, 0, nullptr, &transpose, 0, 0);
132: }
133: void Shader_SetProjectionMatrix(const DirectX::XMMATRIX& matrix)
134: {
135: 	// 定数バッファ格納用行列の構造体を定義
136: 	XMFLOAT4X4 transpose;
137: 	// 行列を転置して定数バッファ格納用行列に変換
138: 	XMStoreFloat4x4(&transpose, XMMatrixTranspose(matrix));
139: 	// 定数バッファに行列をセット
140: 	g_pContext->UpdateSubresource(g_pVSConstantBuffer0, 0, nullptr, &transpose, 0, 0);
141: }
142: void Shader_Begin()
143: {
144: 	// 頂点シェーダーとピクセルシェーダーを描画パイプラインに設定
145: 	g_pContext->VSSetShader(g_pVertexShader, nullptr, 0);
146: 	g_pContext->PSSetShader(g_pPixelShader, nullptr, 0);
147: 	// 頂点レイアウトを描画パイプラインに設定
148: 	g_pContext->IASetInputLayout(g_pInputLayout);
149: 	// 定数バッファを描画パイプラインに設定
150: 	g_pContext->VSSetConstantBuffers(0, 1, &g_pVSConstantBuffer0);
151: 	g_pContext->VSSetConstantBuffers(1, 1, &g_pVSConstantBuffer1);
152: 	if (g_pPSConstantBuffer0)
153: 	{
154: 		XMFLOAT4 white = { 1.0f, 1.0f, 1.0f, 1.0f };
155: 		g_pContext->UpdateSubresource(g_pPSConstantBuffer0, 0, nullptr, &white, 0, 0);
156: 		g_pContext->PSSetConstantBuffers(0, 1, &g_pPSConstantBuffer0);
157: 	}
158: 	// サンプラーステートを描画パイプラインに設定
159: 	Sampler_SetFilterLinear();
160: }
</file>

