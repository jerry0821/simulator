 864: void ImGui::Scrollbar(ImGuiAxis axis)
 865: {
 866:     ImGuiContext& g = *GImGui;
 867:     ImGuiWindow* window = g.CurrentWindow;
 868:     const ImGuiID id = GetWindowScrollbarID(window, axis);
 869:     // Calculate scrollbar bounding box
 870:     ImRect bb = GetWindowScrollbarRect(window, axis);
 871:     ImDrawFlags rounding_corners = ImDrawFlags_RoundCornersNone;
 872:     if (axis == ImGuiAxis_X)
 873:     {
 874:         rounding_corners |= ImDrawFlags_RoundCornersBottomLeft;
 875:         if (!window->ScrollbarY)
 876:             rounding_corners |= ImDrawFlags_RoundCornersBottomRight;
 877:     }
 878:     else
 879:     {
 880:         if ((window->Flags & ImGuiWindowFlags_NoTitleBar) && !(window->Flags & ImGuiWindowFlags_MenuBar))
 881:             rounding_corners |= ImDrawFlags_RoundCornersTopRight;
 882:         if (!window->ScrollbarX)
 883:             rounding_corners |= ImDrawFlags_RoundCornersBottomRight;
 884:     }
 885:     float size_visible = window->InnerRect.Max[axis] - window->InnerRect.Min[axis];
 886:     float size_contents = window->ContentSize[axis] + window->WindowPadding[axis] * 2.0f;
 887:     ImS64 scroll = (ImS64)window->Scroll[axis];
 888:     ScrollbarEx(bb, id, axis, &scroll, (ImS64)size_visible, (ImS64)size_contents, rounding_corners);
 889:     window->Scroll[axis] = (float)scroll;
 890: }
 891: // Vertical/Horizontal scrollbar
 892: // The entire piece of code below is rather confusing because:
 893: // - We handle absolute seeking (when first clicking outside the grab) and relative manipulation (afterward or when clicking inside the grab)
 894: // - We store values as normalized ratio and in a form that allows the window content to change while we are holding on a scrollbar
 895: // - We handle both horizontal and vertical scrollbars, which makes the terminology not ideal.
 896: // Still, the code should probably be made simpler..
 897: bool ImGui::ScrollbarEx(const ImRect& bb_frame, ImGuiID id, ImGuiAxis axis, ImS64* p_scroll_v, ImS64 size_visible_v, ImS64 size_contents_v, ImDrawFlags draw_rounding_flags)
 898: {
 899:     ImGuiContext& g = *GImGui;
 900:     ImGuiWindow* window = g.CurrentWindow;
 901:     if (window->SkipItems)
 902:         return false;
 903:     const float bb_frame_width = bb_frame.GetWidth();
 904:     const float bb_frame_height = bb_frame.GetHeight();
 905:     if (bb_frame_width <= 0.0f || bb_frame_height <= 0.0f)
 906:         return false;
 907:     // When we are too small, start hiding and disabling the grab (this reduce visual noise on very small window and facilitate using the window resize grab)
 908:     float alpha = 1.0f;
 909:     if ((axis == ImGuiAxis_Y) && bb_frame_height < bb_frame_width)
 910:         alpha = ImSaturate(bb_frame_height / ImMax(bb_frame_width * 2.0f, 1.0f));
 911:     if (alpha <= 0.0f)
 912:         return false;
 913:     const ImGuiStyle& style = g.Style;
 914:     const bool allow_interaction = (alpha >= 1.0f);
 915:     ImRect bb = bb_frame;
 916:     float padding = IM_TRUNC(ImMin(style.ScrollbarPadding, ImMin(bb_frame_width, bb_frame_height) * 0.5f));
 917:     bb.Expand(-padding);
 918:     // V denote the main, longer axis of the scrollbar (= height for a vertical scrollbar)
 919:     const float scrollbar_size_v = (axis == ImGuiAxis_X) ? bb.GetWidth() : bb.GetHeight();
 920:     if (scrollbar_size_v < 1.0f)
 921:         return false;
 922:     // Calculate the height of our grabbable box. It generally represent the amount visible (vs the total scrollable amount)
 923:     // But we maintain a minimum size in pixel to allow for the user to still aim inside.
 924:     IM_ASSERT(ImMax(size_contents_v, size_visible_v) > 0.0f); // Adding this assert to check if the ImMax(XXX,1.0f) is still needed. PLEASE CONTACT ME if this triggers.
 925:     const ImS64 win_size_v = ImMax(ImMax(size_contents_v, size_visible_v), (ImS64)1);
 926:     const float grab_h_minsize = ImMin(bb.GetSize()[axis], style.GrabMinSize);
 927:     const float grab_h_pixels = ImClamp(scrollbar_size_v * ((float)size_visible_v / (float)win_size_v), grab_h_minsize, scrollbar_size_v);
 928:     const float grab_h_norm = grab_h_pixels / scrollbar_size_v;
 929:     // Handle input right away. None of the code of Begin() is relying on scrolling position before calling Scrollbar().
 930:     bool held = false;
 931:     bool hovered = false;
 932:     ItemAdd(bb_frame, id, NULL, ImGuiItemFlags_NoNav);
 933:     ButtonBehavior(bb, id, &hovered, &held, ImGuiButtonFlags_NoNavFocus);
 934:     const ImS64 scroll_max = ImMax((ImS64)1, size_contents_v - size_visible_v);
 935:     float scroll_ratio = ImSaturate((float)*p_scroll_v / (float)scroll_max);
 936:     float grab_v_norm = scroll_ratio * (scrollbar_size_v - grab_h_pixels) / scrollbar_size_v; // Grab position in normalized space
 937:     if (held && allow_interaction && grab_h_norm < 1.0f)
 938:     {
 939:         const float scrollbar_pos_v = bb.Min[axis];
 940:         const float mouse_pos_v = g.IO.MousePos[axis];
 941:         // Click position in scrollbar normalized space (0.0f->1.0f)
 942:         const float clicked_v_norm = ImSaturate((mouse_pos_v - scrollbar_pos_v) / scrollbar_size_v);
 943:         const int held_dir = (clicked_v_norm < grab_v_norm) ? -1 : (clicked_v_norm > grab_v_norm + grab_h_norm) ? +1 : 0;
 944:         if (g.ActiveIdIsJustActivated)
 945:         {
 946:             // On initial click when held_dir == 0 (clicked over grab): calculate the distance between mouse and the center of the grab
 947:             const bool scroll_to_clicked_location = (g.IO.ConfigScrollbarScrollByPage == false || g.IO.KeyShift || held_dir == 0);
 948:             g.ScrollbarSeekMode = scroll_to_clicked_location ? 0 : (short)held_dir;
 949:             g.ScrollbarClickDeltaToGrabCenter = (held_dir == 0 && !g.IO.KeyShift) ? clicked_v_norm - grab_v_norm - grab_h_norm * 0.5f : 0.0f;
 950:         }
 951:         // Apply scroll (p_scroll_v will generally point on one member of window->Scroll)
 952:         // It is ok to modify Scroll here because we are being called in Begin() after the calculation of ContentSize and before setting up our starting position
 953:         if (g.ScrollbarSeekMode == 0)
 954:         {
 955:             // Absolute seeking
 956:             const float scroll_v_norm = ImSaturate((clicked_v_norm - g.ScrollbarClickDeltaToGrabCenter - grab_h_norm * 0.5f) / (1.0f - grab_h_norm));
 957:             *p_scroll_v = (ImS64)(scroll_v_norm * scroll_max);
 958:         }
 959:         else
 960:         {
 961:             // Page by page
 962:             if (IsMouseClicked(ImGuiMouseButton_Left, ImGuiInputFlags_Repeat) && held_dir == g.ScrollbarSeekMode)
 963:             {
 964:                 float page_dir = (g.ScrollbarSeekMode > 0.0f) ? +1.0f : -1.0f;
 965:                 *p_scroll_v = ImClamp(*p_scroll_v + (ImS64)(page_dir * size_visible_v), (ImS64)0, scroll_max);
 966:             }
 967:         }
 968:         // Update values for rendering
 969:         scroll_ratio = ImSaturate((float)*p_scroll_v / (float)scroll_max);
 970:         grab_v_norm = scroll_ratio * (scrollbar_size_v - grab_h_pixels) / scrollbar_size_v;
 971:         // Update distance to grab now that we have seek'ed and saturated
 972:         //if (seek_absolute)
 973:         //    g.ScrollbarClickDeltaToGrabCenter = clicked_v_norm - grab_v_norm - grab_h_norm * 0.5f;
 974:     }
 975:     // Render
 976:     const ImU32 bg_col = GetColorU32(ImGuiCol_ScrollbarBg);
 977:     const ImU32 grab_col = GetColorU32(held ? ImGuiCol_ScrollbarGrabActive : hovered ? ImGuiCol_ScrollbarGrabHovered : ImGuiCol_ScrollbarGrab, alpha);
 978:     window->DrawList->AddRectFilled(bb_frame.Min, bb_frame.Max, bg_col, window->WindowRounding, draw_rounding_flags);
 979:     ImRect grab_rect;
 980:     if (axis == ImGuiAxis_X)
 981:         grab_rect = ImRect(ImLerp(bb.Min.x, bb.Max.x, grab_v_norm), bb.Min.y, ImLerp(bb.Min.x, bb.Max.x, grab_v_norm) + grab_h_pixels, bb.Max.y);
 982:     else
 983:         grab_rect = ImRect(bb.Min.x, ImLerp(bb.Min.y, bb.Max.y, grab_v_norm), bb.Max.x, ImLerp(bb.Min.y, bb.Max.y, grab_v_norm) + grab_h_pixels);
 984:     window->DrawList->AddRectFilled(grab_rect.Min, grab_rect.Max, grab_col, style.ScrollbarRounding);
 985:     return held;
 986: }
