 1: #include <fstream>
 2: #include <iostream>
 3: #include <sstream>
 4: #include <string>
 5: int main() {
 6:   std::ifstream in("resource/map_save.txt");
 7:   std::ofstream out("map_array_generated.txt");
 8:   std::string line;
 9:   std::getline(in, line); // header
10:   out << "static void Map_LoadDefaultObjects() {\n";
11:   out << "  g_MapObjects.reserve(1000);\n";
12:   while (std::getline(in, line)) {
13:     if (line.empty())
14:       continue;
15:     std::istringstream iss(line);
16:     int kindId;
17:     float px, py, pz, rx, ry, rz, sx, sy, sz, minx, miny, minz;
18:     std::string tpath;
19:     if (!(iss >> kindId >> px >> py >> pz >> rx >> ry >> rz >> sx >> sy >> sz >>
20:           minx >> miny >> minz)) {
21:       continue;
22:     }
23:     iss >> tpath;
24:     std::string kindStr = "BLOCK";
25:     if (kindId == 0)
26:       kindStr = "FIELD";
27:     else if (kindId == 1)
28:       kindStr = "BLOCK";
29:     else if (kindId == 2)
30:       kindStr = "SPHERE";
31:     else if (kindId == 3)
32:       kindStr = "CYLINDER";
33:     else if (kindId == 4)
34:       kindStr = "GRASS";
35:     else if (kindId == 5)
36:       kindStr = "SLIME";
37:     else if (kindId == 6)
38:       kindStr = "ROCK";
39:     std::string texStr = "\"\"";
40:     if (tpath != "" && tpath != "-") {
41:       texStr = "\"" + tpath + "\"";
42:     }
43:     char buf[512];
44:     snprintf(buf, sizeof(buf),
45:              "  g_MapObjects.push_back({(int)%s, {%.2ff, %.2ff, %.2ff}, "
46:              "{{%.2ff, %.2ff, %.2ff}, {%.2ff, %.2ff, %.2ff}}, {%.2ff, %.2ff, "
47:              "%.2ff}, {%.2ff, %.2ff, %.2ff}, %s, -1});\n",
48:              kindStr.c_str(), px, py, pz, minx, miny, minz, minx + sx,
49:              miny + sy, minz + sz, rx, ry, rz, sx, sy, sz, texStr.c_str());
50:     out << buf;
51:   }
52:   out << "}\n";
53:   return 0;
54: }
