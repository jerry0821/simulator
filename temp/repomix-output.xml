 7205:                         window->HiddenFramesCannotSkipItems = 1;
 7206:                     else
 7207:                         window->HiddenFramesCanSkipItems = 1;
 7208:                 }
 7209:             // Hide along with parent or if parent is collapsed
 7210:             if (parent_window && (parent_window->Collapsed || parent_window->HiddenFramesCanSkipItems > 0))
 7211:                 window->HiddenFramesCanSkipItems = 1;
 7212:             if (parent_window && parent_window->HiddenFramesCannotSkipItems > 0)
 7213:                 window->HiddenFramesCannotSkipItems = 1;
 7214:         }
