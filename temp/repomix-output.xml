2091: // Generic linear color gradient, write to RGB fields, leave A untouched.
2092: void ImGui::ShadeVertsLinearColorGradientKeepAlpha(ImDrawList* draw_list, int vert_start_idx, int vert_end_idx, ImVec2 gradient_p0, ImVec2 gradient_p1, ImU32 col0, ImU32 col1)
2093: {
2094:     ImVec2 gradient_extent = gradient_p1 - gradient_p0;
2095:     float gradient_inv_length2 = 1.0f / ImLengthSqr(gradient_extent);
2096:     ImDrawVert* vert_start = draw_list->VtxBuffer.Data + vert_start_idx;
2097:     ImDrawVert* vert_end = draw_list->VtxBuffer.Data + vert_end_idx;
2098:     const int col0_r = (int)(col0 >> IM_COL32_R_SHIFT) & 0xFF;
2099:     const int col0_g = (int)(col0 >> IM_COL32_G_SHIFT) & 0xFF;
2100:     const int col0_b = (int)(col0 >> IM_COL32_B_SHIFT) & 0xFF;
2101:     const int col_delta_r = ((int)(col1 >> IM_COL32_R_SHIFT) & 0xFF) - col0_r;
2102:     const int col_delta_g = ((int)(col1 >> IM_COL32_G_SHIFT) & 0xFF) - col0_g;
2103:     const int col_delta_b = ((int)(col1 >> IM_COL32_B_SHIFT) & 0xFF) - col0_b;
2104:     for (ImDrawVert* vert = vert_start; vert < vert_end; vert++)
2105:     {
2106:         float d = ImDot(vert->pos - gradient_p0, gradient_extent);
2107:         float t = ImClamp(d * gradient_inv_length2, 0.0f, 1.0f);
2108:         int r = (int)(col0_r + col_delta_r * t);
2109:         int g = (int)(col0_g + col_delta_g * t);
2110:         int b = (int)(col0_b + col_delta_b * t);
2111:         vert->col = (r << IM_COL32_R_SHIFT) | (g << IM_COL32_G_SHIFT) | (b << IM_COL32_B_SHIFT) | (vert->col & IM_COL32_A_MASK);
2112:     }
2113: }
2114: // Distribute UV over (a, b) rectangle
2115: void ImGui::ShadeVertsLinearUV(ImDrawList* draw_list, int vert_start_idx, int vert_end_idx, const ImVec2& a, const ImVec2& b, const ImVec2& uv_a, const ImVec2& uv_b, bool clamp)
2116: {
2117:     const ImVec2 size = b - a;
2118:     const ImVec2 uv_size = uv_b - uv_a;
2119:     const ImVec2 scale = ImVec2(
2120:         size.x != 0.0f ? (uv_size.x / size.x) : 0.0f,
2121:         size.y != 0.0f ? (uv_size.y / size.y) : 0.0f);
2122:     ImDrawVert* vert_start = draw_list->VtxBuffer.Data + vert_start_idx;
2123:     ImDrawVert* vert_end = draw_list->VtxBuffer.Data + vert_end_idx;
2124:     if (clamp)
2125:     {
2126:         const ImVec2 min = ImMin(uv_a, uv_b);
2127:         const ImVec2 max = ImMax(uv_a, uv_b);
2128:         for (ImDrawVert* vertex = vert_start; vertex < vert_end; ++vertex)
2129:             vertex->uv = ImClamp(uv_a + ImMul(ImVec2(vertex->pos.x, vertex->pos.y) - a, scale), min, max);
2130:     }
2131:     else
2132:     {
2133:         for (ImDrawVert* vertex = vert_start; vertex < vert_end; ++vertex)
2134:             vertex->uv = uv_a + ImMul(ImVec2(vertex->pos.x, vertex->pos.y) - a, scale);
2135:     }
2136: }
2137: void ImGui::ShadeVertsTransformPos(ImDrawList* draw_list, int vert_start_idx, int vert_end_idx, const ImVec2& pivot_in, float cos_a, float sin_a, const ImVec2& pivot_out)
2138: {
2139:     ImDrawVert* vert_start = draw_list->VtxBuffer.Data + vert_start_idx;
2140:     ImDrawVert* vert_end = draw_list->VtxBuffer.Data + vert_end_idx;
2141:     for (ImDrawVert* vertex = vert_start; vertex < vert_end; ++vertex)
2142:         vertex->pos = ImRotate(vertex->pos- pivot_in, cos_a, sin_a) + pivot_out;
2143: }
