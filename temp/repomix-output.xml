11874: // Handle "scoring" of an item for a tabbing/focusing request initiated by NavUpdateCreateTabbingRequest().
11875: // Note that SetKeyboardFocusHere() API calls are considered tabbing requests!
11876: // - Case 1: no nav/active id:    set result to first eligible item, stop storing.
11877: // - Case 2: tab forward:         on ref id set counter, on counter elapse store result
11878: // - Case 3: tab forward wrap:    set result to first eligible item (preemptively), on ref id set counter, on next frame if counter hasn't elapsed store result. // FIXME-TABBING: Could be done as a next-frame forwarded request
11879: // - Case 4: tab backward:        store all results, on ref id pick prev, stop storing
11880: // - Case 5: tab backward wrap:   store all results, on ref id if no result keep storing until last // FIXME-TABBING: Could be done as next-frame forwarded requested
11881: void ImGui::NavProcessItemForTabbingRequest(ImGuiID id, ImGuiItemFlags item_flags, ImGuiNavMoveFlags move_flags)
11882: {
11883:     ImGuiContext& g = *GImGui;
11884:     if ((move_flags & ImGuiNavMoveFlags_FocusApi) == 0)
11885:     {
11886:         if (g.NavLayer != g.CurrentWindow->DC.NavLayerCurrent)
11887:             return;
11888:         if (g.NavFocusScopeId != g.CurrentFocusScopeId)
11889:             return;
11890:     }
11891:     // - Can always land on an item when using API call.
11892:     // - Tabbing with _NavEnableKeyboard (space/enter/arrows): goes through every item.
11893:     // - Tabbing without _NavEnableKeyboard: goes through inputable items only.
11894:     bool can_stop;
11895:     if (move_flags & ImGuiNavMoveFlags_FocusApi)
11896:         can_stop = true;
11897:     else
11898:         can_stop = (item_flags & ImGuiItemFlags_NoTabStop) == 0 && ((g.IO.ConfigFlags & ImGuiConfigFlags_NavEnableKeyboard) || (item_flags & ImGuiItemFlags_Inputable));
11899:     // Always store in NavMoveResultLocal (unlike directional request which uses NavMoveResultOther on sibling/flattened windows)
11900:     ImGuiNavItemData* result = &g.NavMoveResultLocal;
11901:     if (g.NavTabbingDir == +1)
11902:     {
11903:         // Tab Forward or SetKeyboardFocusHere() with >= 0
11904:         if (can_stop && g.NavTabbingResultFirst.ID == 0)
11905:             NavApplyItemToResult(&g.NavTabbingResultFirst);
11906:         if (can_stop && g.NavTabbingCounter > 0 && --g.NavTabbingCounter == 0)
11907:             NavMoveRequestResolveWithLastItem(result);
11908:         else if (g.NavId == id)
11909:             g.NavTabbingCounter = 1;
11910:     }
11911:     else if (g.NavTabbingDir == -1)
11912:     {
11913:         // Tab Backward
11914:         if (g.NavId == id)
11915:         {
11916:             if (result->ID)
11917:             {
11918:                 g.NavMoveScoringItems = false;
11919:                 NavUpdateAnyRequestFlag();
11920:             }
11921:         }
11922:         else if (can_stop)
11923:         {
11924:             // Keep applying until reaching NavId
11925:             NavApplyItemToResult(result);
11926:         }
11927:     }
11928:     else if (g.NavTabbingDir == 0)
11929:     {
11930:         if (can_stop && g.NavId == id)
11931:             NavMoveRequestResolveWithLastItem(result);
11932:         if (can_stop && g.NavTabbingResultFirst.ID == 0) // Tab init
11933:             NavApplyItemToResult(&g.NavTabbingResultFirst);
11934:     }
11935: }
