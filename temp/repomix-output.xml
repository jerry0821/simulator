<file path="ease.h">
 1: #pragma once
 2: #include <cmath>
 3: // 圓周率常數，某些公式會用到
 4: #ifndef PI
 5: #define PI 3.1415926535f
 6: #endif
 7: class Easing
 8: {
 9: public:
10:     // ==========================================
11:     // 基礎線性 (無緩動)
12:     // ==========================================
13:     static float Linear(float t) { return t; }
14:     // ==========================================
15:     // Sine (正弦波) - 非常柔和，適合呼吸燈、雲朵飄動
16:     // ==========================================
17:     static float InSine(float t) { return 1.0f - std::cos((t * PI) / 2.0f); }
18:     static float OutSine(float t) { return std::sin((t * PI) / 2.0f); }
19:     static float InOutSine(float t) { return -(std::cos(PI * t) - 1.0f) / 2.0f; }
20:     // ==========================================
21:     // Quad (二次方) - 標準緩動，適合 UI、移動
22:     // ==========================================
23:     static float InQuad(float t) { return t * t; }
24:     static float OutQuad(float t) { return 1.0f - (1.0f - t) * (1.0f - t); }
25:     static float InOutQuad(float t) {
26:         return t < 0.5f ? 2.0f * t * t : 1.0f - std::pow(-2.0f * t + 2.0f, 2.0f) / 2.0f;
27:     }
28:     // ==========================================
29:     // Cubic (三次方) - 比 Quad 強烈一點，適合賽車、物理加速
30:     // ==========================================
31:     static float InCubic(float t) { return t * t * t; }
32:     static float OutCubic(float t) { return 1.0f - std::pow(1.0f - t, 3.0f); }
33:     static float InOutCubic(float t) {
34:         return t < 0.5f ? 4.0f * t * t * t : 1.0f - std::pow(-2.0f * t + 2.0f, 3.0f) / 2.0f;
35:     }
36:     // ==========================================
37:     // Quart (四次方) / Quint (五次方) - 更加劇烈
38:     // ==========================================
39:     static float OutQuart(float t) { return 1.0f - std::pow(1.0f - t, 4.0f); }
40:     static float OutQuint(float t) { return 1.0f - std::pow(1.0f - t, 5.0f); }
41:     // ==========================================
42:     // Expo (指數) - 像閃電一樣快，極具爆發力 (適合火柱噴發)
43:     // ==========================================
44:     static float InExpo(float t) { return t == 0.0f ? 0.0f : std::pow(2.0f, 10.0f * t - 10.0f); }
45:     static float OutExpo(float t) { return t == 1.0f ? 1.0f : 1.0f - std::pow(2.0f, -10.0f * t); }
46:     // ==========================================
47:     // Back (回彈) - 會稍微衝過頭再縮回來 (適合 UI 彈出)
48:     // ==========================================
49:     static float InBack(float t) {
50:         const float c1 = 1.70158f;
51:         const float c3 = c1 + 1.0f;
52:         return c3 * t * t * t - c1 * t * t;
53:     }
54:     static float OutBack(float t) {
55:         const float c1 = 1.70158f;
56:         const float c3 = c1 + 1.0f;
57:         return 1.0f + c3 * std::pow(t - 1.0f, 3.0f) + c1 * std::pow(t - 1.0f, 2.0f);
58:     }
59:     // ==========================================
60:     // Bounce (彈跳球) - 像球掉到地上一樣彈幾下 (適合落地效果)
61:     // ==========================================
62:     static float OutBounce(float t) {
63:         const float n1 = 7.5625f;
64:         const float d1 = 2.75f;
65:         if (t < 1.0f / d1) {
66:             return n1 * t * t;
67:         }
68:         else if (t < 2.0f / d1) {
69:             return n1 * (t -= 1.5f / d1) * t + 0.75f;
70:         }
71:         else if (t < 2.5f / d1) {
72:             return n1 * (t -= 2.25f / d1) * t + 0.9375f;
73:         }
74:         else {
75:             return n1 * (t -= 2.625f / d1) * t + 0.984375f;
76:         }
77:     }
78:     // InBounce 比較少用，通常是用 1 - OutBounce(1-t)
79:     static float InBounce(float t) {
80:         return 1.0f - OutBounce(1.0f - t);
81:     }
82:     // ==========================================
83:     // Elastic (橡皮筋) - 劇烈抖動 (適合受到重擊)
84:     // ==========================================
85:     static float OutElastic(float t) {
86:         const float c4 = (2.0f * PI) / 3.0f;
87:         return t == 0.0f ? 0.0f : t == 1.0f ? 1.0f : std::pow(2.0f, -10.0f * t) * std::sin((t * 10.0f - 0.75f) * c4) + 1.0f;
88:     }
89: };
</file>

<file path="easing_cube.cpp">
 1: #include "easing_cube.h"
 2: #include "cube.h"	
 3: using namespace DirectX;
 4: #include <algorithm>
 5: void EasingCube::Update(double elapsed_time)
 6: {
 7: 	if (!m_IsStart) return;
 8: 	m_AccumulatedTime += elapsed_time;
 9: }
10: void EasingCube::Draw() const
11: {
12: 	XMVECTOR start = XMLoadFloat3(&m_StartPosition);
13: 	XMVECTOR end = XMLoadFloat3(&m_EndPosition);
14: 	XMVECTOR v = end - start;
15: 	double ratio = std::min(m_AccumulatedTime / m_Duration , 1.0);
16: 	float ratiof = static_cast<float>(easeOutCubic(ratio));
17: 	v *= ratiof;
18: 	v += start;
19: 	XMMATRIX world = XMMatrixTranslationFromVector(v);
20: 	Cube_Draw(2, world); 
21: }
</file>

