790:           XMMatrixScaling(selObj->Scale.x, selObj->Scale.y, selObj->Scale.z) *
791:           XMMatrixRotationRollPitchYaw(selObj->Rotation.x, selObj->Rotation.y,
792:                                        selObj->Rotation.z) *
793:           XMMatrixTranslationFromVector(XMLoadFloat3(&selObj->Position));
794:       if (selObj->KindId == SPHERE) {
795:         Collision::Debug::DrawSphereMtx(0.5f, selWorldFull,
796:                                      {1.0f, 1.0f, 0.0f, 1.0f});
797:       } else if (selObj->KindId == CYLINDER || selObj->KindId == CAPSULE) {
798:         Collision::Debug::DrawCapsuleMtx(0.5f, 0.5f, selWorldFull,
799:                                       {1.0f, 1.0f, 0.0f, 1.0f});
800:       } else {
801:         Collision::Debug::DrawOBB(localAabb, selWorldFull,
802:                                {1.0f, 1.0f, 0.0f, 1.0f});
803:       }
804:       // Gizmo: rotation + translation only (no scale) for fixed thickness
805:       XMMATRIX selWorldNoScale =
806:           XMMatrixRotationRollPitchYaw(selObj->Rotation.x, selObj->Rotation.y,
807:                                        selObj->Rotation.z) *
808:           XMMatrixTranslationFromVector(XMLoadFloat3(&selObj->Position));
809:       // Stem lengths scale with object, thickness stays fixed
810:       float lenX = 0.7f * selObj->Scale.x;
811:       float lenY = 0.7f * selObj->Scale.y;
812:       float lenZ = 0.7f * selObj->Scale.z;
813:       Collision::AABB stemX = {{0.0f, -0.04f, -0.04f}, {lenX, 0.04f, 0.04f}};
814:       Collision::AABB stemY = {{-0.04f, 0.0f, -0.04f}, {0.04f, lenY, 0.04f}};
815:       Collision::AABB stemZ = {{-0.04f, -0.04f, 0.0f}, {0.04f, 0.04f, lenZ}};
816:       Collision::Debug::DrawOBB(stemX, selWorldNoScale, {1.0f, 0.0f, 0.0f, 1.0f});
817:       Collision::Debug::DrawOBB(stemY, selWorldNoScale, {0.0f, 1.0f, 0.0f, 1.0f});
818:       Collision::Debug::DrawOBB(stemZ, selWorldNoScale, {0.0f, 0.0f, 1.0f, 1.0f});
819:       // Center point (fixed size)
820:       Collision::AABB handleCenter = {{-0.03f, -0.03f, -0.03f}, {0.03f, 0.03f, 0.03f}};
821:       Collision::Debug::DrawOBB(handleCenter, selWorldNoScale,
822:                              {1.0f, 1.0f, 1.0f, 1.0f});
823:       // Cones at tips (fixed size, positioned at stem ends)
824:       Collision::Debug::DrawConeOBB(XMFLOAT3(lenX, 0, 0),
825:                                  XMFLOAT3(lenX + 0.3f, 0, 0), 0.12f,
826:                                  selWorldNoScale, {1.0f, 0.0f, 0.0f, 1.0f});
827:       Collision::Debug::DrawConeOBB(XMFLOAT3(0, lenY, 0),
828:                                  XMFLOAT3(0, lenY + 0.3f, 0), 0.12f,
829:                                  selWorldNoScale, {0.0f, 1.0f, 0.0f, 1.0f});
830:       Collision::Debug::DrawConeOBB(XMFLOAT3(0, 0, lenZ),
831:                                  XMFLOAT3(0, 0, lenZ + 0.3f), 0.12f,
832:                                  selWorldNoScale, {0.0f, 0.0f, 1.0f, 1.0f});
833:       Direct3D_SetDepthEnable(true);
834:     }
835:   }
