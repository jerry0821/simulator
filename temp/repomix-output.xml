 2495:     int b = ImLerp((int)(col_a >> IM_COL32_B_SHIFT) & 0xFF, (int)(col_b >> IM_COL32_B_SHIFT) & 0xFF, t);
 2496:     return IM_COL32(r, g, b, 0xFF);
 2497: }
