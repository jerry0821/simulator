12310: void ImGui::NavInitRequestApplyResult()
12311: {
12312:     // In very rare cases g.NavWindow may be null (e.g. clearing focus after requesting an init request, which does happen when releasing Alt while clicking on void)
12313:     ImGuiContext& g = *GImGui;
12314:     if (!g.NavWindow)
12315:         return;
12316:     ImGuiNavItemData* result = &g.NavInitResult;
12317:     if (g.NavId != result->ID)
12318:     {
12319:         g.NavJustMovedFromFocusScopeId = g.NavFocusScopeId;
12320:         g.NavJustMovedToId = result->ID;
12321:         g.NavJustMovedToFocusScopeId = result->FocusScopeId;
12322:         g.NavJustMovedToKeyMods = 0;
12323:         g.NavJustMovedToIsTabbing = false;
12324:         g.NavJustMovedToHasSelectionData = (result->ItemFlags & ImGuiItemFlags_HasSelectionUserData) != 0;
12325:     }
12326:     // Apply result from previous navigation init request (will typically select the first item, unless SetItemDefaultFocus() has been called)
12327:     // FIXME-NAV: On _NavFlattened windows, g.NavWindow will only be updated during subsequent frame. Not a problem currently.
12328:     IMGUI_DEBUG_LOG_NAV("[nav] NavInitRequest: ApplyResult: NavID 0x%08X in Layer %d Window \"%s\"\n", result->ID, g.NavLayer, g.NavWindow->Name);
12329:     SetNavID(result->ID, g.NavLayer, result->FocusScopeId, result->RectRel);
12330:     g.NavIdIsAlive = true; // Mark as alive from previous frame as we got a result
12331:     if (result->SelectionUserData != ImGuiSelectionUserData_Invalid)
12332:         g.NavLastValidSelectionUserData = result->SelectionUserData;
12333:     if (g.NavInitRequestFromMove)
12334:         SetNavCursorVisibleAfterMove();
12335: }
12336: // Bias scoring rect ahead of scoring + update preferred pos (if missing) using source position
12337: static void NavBiasScoringRect(ImRect& r, ImVec2& preferred_pos_rel, ImGuiDir move_dir, ImGuiNavMoveFlags move_flags)
12338: {
12339:     // Bias initial rect
12340:     ImGuiContext& g = *GImGui;
12341:     const ImVec2 rel_to_abs_offset = g.NavWindow->DC.CursorStartPos;
12342:     // Initialize bias on departure if we don't have any. So mouse-click + arrow will record bias.
12343:     // - We default to L/U bias, so moving down from a large source item into several columns will land on left-most column.
12344:     // - But each successful move sets new bias on one axis, only cleared when using mouse.
12345:     if ((move_flags & ImGuiNavMoveFlags_Forwarded) == 0)
12346:     {
12347:         if (preferred_pos_rel.x == FLT_MAX)
12348:             preferred_pos_rel.x = ImMin(r.Min.x + 1.0f, r.Max.x) - rel_to_abs_offset.x;
12349:         if (preferred_pos_rel.y == FLT_MAX)
12350:             preferred_pos_rel.y = r.GetCenter().y - rel_to_abs_offset.y;
12351:     }
12352:     // Apply general bias on the other axis
12353:     if ((move_dir == ImGuiDir_Up || move_dir == ImGuiDir_Down) && preferred_pos_rel.x != FLT_MAX)
12354:         r.Min.x = r.Max.x = preferred_pos_rel.x + rel_to_abs_offset.x;
12355:     else if ((move_dir == ImGuiDir_Left || move_dir == ImGuiDir_Right) && preferred_pos_rel.y != FLT_MAX)
12356:         r.Min.y = r.Max.y = preferred_pos_rel.y + rel_to_abs_offset.y;
12357: }
