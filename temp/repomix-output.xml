7977: void ImGuiMenuColumns::CalcNextTotalWidth(bool update_offsets)
7978: {
7979:     ImU16 offset = 0;
7980:     bool want_spacing = false;
7981:     for (int i = 0; i < IM_ARRAYSIZE(Widths); i++)
7982:     {
7983:         ImU16 width = Widths[i];
7984:         if (want_spacing && width > 0)
7985:             offset += Spacing;
7986:         want_spacing |= (width > 0);
7987:         if (update_offsets)
7988:         {
7989:             if (i == 1) { OffsetLabel = offset; }
7990:             if (i == 2) { OffsetShortcut = offset; }
7991:             if (i == 3) { OffsetMark = offset; }
7992:         }
7993:         offset += width;
7994:     }
7995:     NextTotalWidth = offset;
7996: }
