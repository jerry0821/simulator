 343: // Add a label+text combo aligned to other label+value widgets
 344: void ImGui::LabelTextV(const char* label, const char* fmt, va_list args)
 345: {
 346:     ImGuiWindow* window = GetCurrentWindow();
 347:     if (window->SkipItems)
 348:         return;
 349:     ImGuiContext& g = *GImGui;
 350:     const ImGuiStyle& style = g.Style;
 351:     const float w = CalcItemWidth();
 352:     const char* value_text_begin, *value_text_end;
 353:     ImFormatStringToTempBufferV(&value_text_begin, &value_text_end, fmt, args);
 354:     const ImVec2 value_size = CalcTextSize(value_text_begin, value_text_end, false);
 355:     const ImVec2 label_size = CalcTextSize(label, NULL, true);
 356:     const ImVec2 pos = window->DC.CursorPos;
 357:     const ImRect value_bb(pos, pos + ImVec2(w, value_size.y + style.FramePadding.y * 2));
 358:     const ImRect total_bb(pos, pos + ImVec2(w + (label_size.x > 0.0f ? style.ItemInnerSpacing.x + label_size.x : 0.0f), ImMax(value_size.y, label_size.y) + style.FramePadding.y * 2));
 359:     ItemSize(total_bb, style.FramePadding.y);
 360:     if (!ItemAdd(total_bb, 0))
 361:         return;
 362:     // Render
 363:     RenderTextClipped(value_bb.Min + style.FramePadding, value_bb.Max, value_text_begin, value_text_end, &value_size, ImVec2(0.0f, 0.0f));
 364:     if (label_size.x > 0.0f)
 365:         RenderText(ImVec2(value_bb.Max.x + style.ItemInnerSpacing.x, value_bb.Min.y + style.FramePadding.y), label);
 366: }
