 41: // メイン
 42: int APIENTRY WinMain(_In_ HINSTANCE hInstance, _In_opt_ HINSTANCE, _In_ LPSTR,
 43:                      _In_ int nCmdShow) {
 44:   static_cast<void>(CoInitializeEx(nullptr, COINIT_MULTITHREADED));
 45:   // DPIスケーリング
 46:   SetProcessDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
 47:   HWND hWnd = GameWindow_Create(hInstance);
 48:   SystemTimer_Initialize();
 49:   KeyLogger_Initialize();
 50:   PadLogger_Initialize();
 51:   Mouse_Initialize(hWnd);
 52:   Direct3D_Initialize(hWnd);
 53:   Shader_Initialize(Direct3D_GetDevice(), Direct3D_GetContext());
 54:   Shader3D_Initialize();
 55:   Shader3D_Unlit_Initialize();
 56:   ShaderToon_Initialize();
 57:   ShaderParticle_Initialize();
 58:   Texture_Initialize(Direct3D_GetDevice(), Direct3D_GetContext());
 59:   Sampler_Initialize(Direct3D_GetDevice(), Direct3D_GetContext());
 60:   Sprite_Initialize(Direct3D_GetDevice(), Direct3D_GetContext());
 61:   SpriteAnim_Initialize();
 62:   Collision::Debug::Initialize(Direct3D_GetDevice(), Direct3D_GetContext());
 63:   Grid_Initialize(Direct3D_GetDevice(), Direct3D_GetContext());
 64:   Cube_Initialize(Direct3D_GetDevice(), Direct3D_GetContext());
 65:   Sphere_Initialize(Direct3D_GetDevice(), Direct3D_GetContext());
 66:   Cylinder_Initialize(Direct3D_GetDevice(), Direct3D_GetContext());
 67:   Capsule_Initialize(Direct3D_GetDevice(), Direct3D_GetContext());
 68:   MeshField_Initialize(Direct3D_GetDevice(), Direct3D_GetContext());
 69:   Light_Initialize(Direct3D_GetDevice(), Direct3D_GetContext());
 70:   Scene_Initialize();
 71:   DebugMenu_Initialize(Direct3D_GetDevice(), Direct3D_GetContext(), hWnd);
 72: #if defined(DEBUG) || defined(_DEBUG)
 73:   hal::DebugText dt(
 74:       Direct3D_GetDevice(), Direct3D_GetContext(),
 75:       L"resource/texture/consolab_ascii_512.png", Direct3D_GetBackBufferWidth(),
 76:       Direct3D_GetBackBufferHeight(), 0.0f, 0.0f, 0, 0, 0.0f, 14.0f);
 77: #endif
 78:   // Mouse_SetVisible(false);
 79:   ShowWindow(hWnd, nCmdShow);
 80:   UpdateWindow(hWnd);
 81:   // fps・実行フレーム速度計測用
 82:   double exec_last_time = SystemTimer_GetTime();
 83:   double fps_last_time = exec_last_time;
 84:   double current_time = 0.0;
 85:   ULONG frame_count = 0;
 86:   double fps = 0.0;
 87:   // ゲームループ＆メッセージループ
 88:   MSG msg;
 89:   do {
 90:     if (PeekMessage(&msg, nullptr, 0, 0,
 91:                     PM_REMOVE)) { // ウィンドウメッセージが来ていたら
 92:       TranslateMessage(&msg);
 93:       DispatchMessage(&msg);
 94:     } else { // ゲームの処理
 95:       // fps計測
 96:       current_time = SystemTimer_GetTime(); // システム時刻を取得
 97:       double elapsed_time =
 98:           current_time - fps_last_time; // fps計測用の経過時間を計算
 99:       if (elapsed_time >= 1.0) // 1秒ごとに計測
100:       {
101:         fps = frame_count / elapsed_time;
102:         fps_last_time = current_time; // FPSを測定した時刻を保存
103:         frame_count = 0;              // カウントをクリア
104:       }
105:       // 1/60秒ごとに実行
106:       elapsed_time = current_time - exec_last_time;
107:       // if (elapsed_time >= (1.0 / 60.0)) { // フレーム固定の時はこっち
108:       if (true) {                      // fps無限はこっち
109:         exec_last_time = current_time; // 処理した時刻を保存
110:         // ゲームの更新
111:         KeyLogger_Update(); // ここにしか書かない　1フレームに1つ
112:         PadLogger_Update();
113:         DebugMenu_Begin();
114:         Scene_Update(elapsed_time);
115:         SpriteAnim_Update(elapsed_time);
116:         // ゲームの描画
117:         Direct3D_ClearBackbuffer();
118:         Direct3D_SetBackbuffer();
119:         Scene_Draw();
120:         Sprite_Begin();
121: #if defined(DEBUG) || defined(_DEBUG)
122:         std::stringstream ss;
123:         ss << "fps:" << fps << std::endl;
124:         dt.SetText(ss.str().c_str(), {1.0f, 0.0f, 1.0f, 1.0f});
125:         dt.Draw();
126:         dt.Clear();
127: #endif
128:         DebugMenu_Draw();
129:         DebugMenu_End();
130:         Direct3D_Present();
131:         Scene_Refresh(); // シーンの更新 ゲームの更新の前に書く人もいる
132:         frame_count++;
133:       }
134:     }
135:   } while (msg.message != WM_QUIT);
136: #if defined(DEBUG) || defined(_DEBUG)
137:   Collision::Debug::Finalize();
138: #endif
139:   DebugMenu_Finalize();
140:   Light_Finalize();
141:   MeshField_Finalize();
142:   Grid_Finalize();
143:   Cylinder_Finalize();
144:   Capsule_Finalize();
145:   Sphere_Finalize();
146:   Cube_Finalize();
147:   Collision::Debug::Finalize();
148:   Scene_Finalize();
149:   SpriteAnim_Finalize();
150:   Sprite_Finalize();
151:   Sampler_Finalize();
152:   Texture_Finalize();
153:   ShaderParticle_Finalize();
154:   ShaderToon_Finalize();
155:   Shader3D_Unlit_Finalize();
156:   Shader3D_Finalize();
157:   Shader_Finalize();
158:   Direct3D_Finalize();
159:   Mouse_Finalize();
160:   return (int)msg.wParam;
161: }
