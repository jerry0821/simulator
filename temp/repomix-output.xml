3903: void ImGui::BeginColumns(const char* str_id, int columns_count, ImGuiOldColumnFlags flags)
3904: {
3905:     ImGuiContext& g = *GImGui;
3906:     ImGuiWindow* window = GetCurrentWindow();
3907:     IM_ASSERT(columns_count >= 1);
3908:     IM_ASSERT(window->DC.CurrentColumns == NULL);   // Nested columns are currently not supported
3909:     // Acquire storage for the columns set
3910:     ImGuiID id = GetColumnsID(str_id, columns_count);
3911:     ImGuiOldColumns* columns = FindOrCreateColumns(window, id);
3912:     IM_ASSERT(columns->ID == id);
3913:     columns->Current = 0;
3914:     columns->Count = columns_count;
3915:     columns->Flags = flags;
3916:     window->DC.CurrentColumns = columns;
3917:     window->DC.NavIsScrollPushableX = false; // Shortcut for NavUpdateCurrentWindowIsScrollPushableX();
3918:     columns->HostCursorPosY = window->DC.CursorPos.y;
3919:     columns->HostCursorMaxPosX = window->DC.CursorMaxPos.x;
3920:     columns->HostInitialClipRect = window->ClipRect;
3921:     columns->HostBackupParentWorkRect = window->ParentWorkRect;
3922:     window->ParentWorkRect = window->WorkRect;
3923:     // Set state for first column
3924:     // We aim so that the right-most column will have the same clipping width as other after being clipped by parent ClipRect
3925:     const float column_padding = g.Style.ItemSpacing.x;
3926:     const float half_clip_extend_x = ImTrunc(ImMax(window->WindowPadding.x * 0.5f, window->WindowBorderSize));
3927:     const float max_1 = window->WorkRect.Max.x + column_padding - ImMax(column_padding - window->WindowPadding.x, 0.0f);
3928:     const float max_2 = window->WorkRect.Max.x + half_clip_extend_x;
3929:     columns->OffMinX = window->DC.Indent.x - column_padding + ImMax(column_padding - window->WindowPadding.x, 0.0f);
3930:     columns->OffMaxX = ImMax(ImMin(max_1, max_2) - window->Pos.x, columns->OffMinX + 1.0f);
3931:     columns->LineMinY = columns->LineMaxY = window->DC.CursorPos.y;
3932:     // Clear data if columns count changed
3933:     if (columns->Columns.Size != 0 && columns->Columns.Size != columns_count + 1)
3934:         columns->Columns.resize(0);
3935:     // Initialize default widths
3936:     columns->IsFirstFrame = (columns->Columns.Size == 0);
3937:     if (columns->Columns.Size == 0)
3938:     {
3939:         columns->Columns.reserve(columns_count + 1);
3940:         for (int n = 0; n < columns_count + 1; n++)
3941:         {
3942:             ImGuiOldColumnData column;
3943:             column.OffsetNorm = n / (float)columns_count;
3944:             columns->Columns.push_back(column);
3945:         }
3946:     }
3947:     for (int n = 0; n < columns_count; n++)
3948:     {
3949:         // Compute clipping rectangle
3950:         ImGuiOldColumnData* column = &columns->Columns[n];
3951:         float clip_x1 = IM_ROUND(window->Pos.x + GetColumnOffset(n));
3952:         float clip_x2 = IM_ROUND(window->Pos.x + GetColumnOffset(n + 1) - 1.0f);
3953:         column->ClipRect = ImRect(clip_x1, -FLT_MAX, clip_x2, +FLT_MAX);
3954:         column->ClipRect.ClipWithFull(window->ClipRect);
3955:     }
3956:     if (columns->Count > 1)
3957:     {
3958:         columns->Splitter.Split(window->DrawList, 1 + columns->Count);
3959:         columns->Splitter.SetCurrentChannel(window->DrawList, 1);
3960:         PushColumnClipRect(0);
3961:     }
3962:     // We don't generally store Indent.x inside ColumnsOffset because it may be manipulated by the user.
3963:     float offset_0 = GetColumnOffset(columns->Current);
3964:     float offset_1 = GetColumnOffset(columns->Current + 1);
3965:     float width = offset_1 - offset_0;
3966:     PushItemWidth(width * 0.65f);
3967:     window->DC.ColumnsOffset.x = ImMax(column_padding - window->WindowPadding.x, 0.0f);
3968:     window->DC.CursorPos.x = IM_TRUNC(window->Pos.x + window->DC.Indent.x + window->DC.ColumnsOffset.x);
3969:     window->WorkRect.Max.x = window->Pos.x + offset_1 - column_padding;
3970:     window->WorkRect.Max.y = window->ContentRegionRect.Max.y;
3971: }
3972: void ImGui::NextColumn()
3973: {
3974:     ImGuiWindow* window = GetCurrentWindow();
3975:     if (window->SkipItems || window->DC.CurrentColumns == NULL)
3976:         return;
3977:     ImGuiContext& g = *GImGui;
3978:     ImGuiOldColumns* columns = window->DC.CurrentColumns;
3979:     if (columns->Count == 1)
3980:     {
3981:         window->DC.CursorPos.x = IM_TRUNC(window->Pos.x + window->DC.Indent.x + window->DC.ColumnsOffset.x);
3982:         IM_ASSERT(columns->Current == 0);
3983:         return;
3984:     }
3985:     // Next column
3986:     if (++columns->Current == columns->Count)
3987:         columns->Current = 0;
3988:     PopItemWidth();
3989:     // Optimization: avoid PopClipRect() + SetCurrentChannel() + PushClipRect()
3990:     // (which would needlessly attempt to update commands in the wrong channel, then pop or overwrite them),
3991:     ImGuiOldColumnData* column = &columns->Columns[columns->Current];
3992:     SetWindowClipRectBeforeSetChannel(window, column->ClipRect);
3993:     columns->Splitter.SetCurrentChannel(window->DrawList, columns->Current + 1);
3994:     const float column_padding = g.Style.ItemSpacing.x;
3995:     columns->LineMaxY = ImMax(columns->LineMaxY, window->DC.CursorPos.y);
3996:     if (columns->Current > 0)
3997:     {
3998:         // Columns 1+ ignore IndentX (by canceling it out)
3999:         // FIXME-COLUMNS: Unnecessary, could be locked?
4000:         window->DC.ColumnsOffset.x = GetColumnOffset(columns->Current) - window->DC.Indent.x + column_padding;
4001:     }
4002:     else
4003:     {
4004:         // New row/line: column 0 honor IndentX.
4005:         window->DC.ColumnsOffset.x = ImMax(column_padding - window->WindowPadding.x, 0.0f);
4006:         window->DC.IsSameLine = false;
4007:         columns->LineMinY = columns->LineMaxY;
4008:     }
4009:     window->DC.CursorPos.x = IM_TRUNC(window->Pos.x + window->DC.Indent.x + window->DC.ColumnsOffset.x);
4010:     window->DC.CursorPos.y = columns->LineMinY;
4011:     window->DC.CurrLineSize = ImVec2(0.0f, 0.0f);
4012:     window->DC.CurrLineTextBaseOffset = 0.0f;
4013:     // FIXME-COLUMNS: Share code with BeginColumns() - move code on columns setup.
4014:     float offset_0 = GetColumnOffset(columns->Current);
4015:     float offset_1 = GetColumnOffset(columns->Current + 1);
4016:     float width = offset_1 - offset_0;
4017:     PushItemWidth(width * 0.65f);
4018:     window->WorkRect.Max.x = window->Pos.x + offset_1 - column_padding;
