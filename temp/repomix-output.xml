8586: bool    ImGui::BeginTabBarEx(ImGuiTabBar* tab_bar, const ImRect& tab_bar_bb, ImGuiTabBarFlags flags)
8587: {
8588:     ImGuiContext& g = *GImGui;
8589:     ImGuiWindow* window = g.CurrentWindow;
8590:     if (window->SkipItems)
8591:         return false;
8592:     IM_ASSERT(tab_bar->ID != 0);
