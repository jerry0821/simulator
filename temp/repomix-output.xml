  8: #include "meshfield.h"
  9: #include "direct3d.h"
 10: using namespace DirectX;
 11: #include <d3d11.h>
 12: #include "shader_field.h"
 13: #include "texture.h"
 14: #include "camera.h"
 15: #include "sampler.h"
 16: #include "DirectXTex.h"
 17: #include <vector>
 18: // メッシュフィールドデータ
 19: static constexpr float FIELD_MESH_WIDTH = 1.0f; // メッシュ1枚分の横幅
 20: static constexpr float FIELD_MESH_DEPTH = 1.0f; // メッシュ1枚分の横幅
 21: static constexpr int FIELD_MESH_H_COUNT = 1000; // 横のメッシュ数
 22: static constexpr int FIELD_MESH_V_COUNT = 1000; // 縦のメッシュ数 
 23: static constexpr int FIELD_MESH_H_VERTEX_COUNT = FIELD_MESH_H_COUNT + 1; // 横の頂点数
 24: static constexpr int FIELD_MESH_V_VERTEX_COUNT = FIELD_MESH_V_COUNT + 1; // 縦の頂点数
 25: static constexpr int NUM_VERTEX = FIELD_MESH_H_VERTEX_COUNT * FIELD_MESH_V_VERTEX_COUNT; // 頂点数 
 26: static constexpr int NUM_INDEX = 6 * FIELD_MESH_H_COUNT * FIELD_MESH_V_COUNT; // index数
 27: static ID3D11Buffer* g_pVertexBuffer = nullptr;
 28: static ID3D11Buffer* g_pIndexBuffer = nullptr;
 29: static int g_MeshFieldTexId0 = -1; // メッシュフィールドのテクスチャID
 30: static int g_MeshFieldTexId1 = -1;
 31: static int g_HeightMapTexID = -1;
 32: // 注意！初期化で外部から設定されるもの。Release不要。
 33: static ID3D11Device* g_pDevice = nullptr;
 34: static ID3D11DeviceContext* g_pContext = nullptr;
 35: bool g_IsFlatMeshField = false;
 36: std::vector<float> g_OriginalHeights;
 37: // 頂点構造体
 38: struct Vertex3D
 39: {
 40: 	XMFLOAT3 position;	// 頂点座標
 41: 	XMFLOAT3 normal;	// 法線
 42: 	XMFLOAT4 color;		// 色
 43: 	XMFLOAT2 texcoord;	// テクスチャーUV
 44: };
 45: static Vertex3D g_MeshFieldVertex[NUM_VERTEX];
 46: static unsigned int g_MeshFieldIndex[NUM_INDEX]{};
 47: void MeshField_Initialize(ID3D11Device* pDevice, ID3D11DeviceContext* pContext)
 48: {
 49: 	// デバイスとデバイスコンテキストの保存
 50: 	g_pDevice = pDevice;
 51: 	g_pContext = pContext;
 52: 	// テクスチャの高さを読む
 53: 	TexMetadata metadata;
 54: 	ScratchImage image;
 55: 	// CPUに読む
 56: 	HRESULT hr = DirectX::LoadFromWICFile(
 57: 		L"resource/texture/height_map2.png",
 58: 		DirectX::WIC_FLAGS_NONE,
 59: 		&metadata,
 60: 		image
 61: 	);
 62: 	if (FAILED(hr)) {
 63: 		MessageBox(nullptr, "Error loading heightmap", "Warning", MB_OK);
 64: 		return;
 65: 	}
 66: 	DirectX::ScratchImage convertedImage;
 67: 	const DirectX::Image* img = nullptr;
 68: 	// R8G8B8A8じゃないなら、転換
 69: 	if (metadata.format != DXGI_FORMAT_R8G8B8A8_UNORM)
 70: 	{
 71: 		hr = DirectX::Convert(
 72: 			image.GetImages(), 1, metadata,
 73: 			DXGI_FORMAT_R8G8B8A8_UNORM, 
 74: 			DirectX::TEX_FILTER_DEFAULT,
 75: 			0.5f,
 76: 			convertedImage 
 77: 		);
 78: 		if (FAILED(hr)) {
 79: 			MessageBox(nullptr, "Error converting heightmap", "Warning", MB_OK);
 80: 			return;
 81: 		}
 82: 		img = convertedImage.GetImage(0, 0, 0);
 83: 	}
 84: 	else // if 4 bytes
 85: 	{
 86: 		img = image.GetImage(0, 0, 0);
 87: 	}
 88: 	uint8_t* pPixels = img->pixels;
 89: 	size_t rowPitch = img->rowPitch;
 90: 	int texWidth = (int)img->width;  
 91: 	int texHeight = (int)img->height;
 92: 	// 頂点バッファ生成
 93: 	D3D11_BUFFER_DESC bd = {};
 94: 	bd.Usage = D3D11_USAGE_DYNAMIC;
 95: 	bd.ByteWidth = sizeof(Vertex3D) * NUM_VERTEX;
 96: 	bd.BindFlags = D3D11_BIND_VERTEX_BUFFER;
 97: 	bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
 98: 	//　頂点情報を配列に作る
 99: 	for (int z = 0; z < FIELD_MESH_V_VERTEX_COUNT; z++) {
100: 		for (int x = 0; x < FIELD_MESH_H_VERTEX_COUNT; x++) {
101: 			// 横 + 横の最大数　* 縦
102: 			int index = x + FIELD_MESH_H_VERTEX_COUNT * z;
103: 			float px = (float)(x * FIELD_MESH_WIDTH);
104: 			float pz = (float)(z * FIELD_MESH_DEPTH);
105: 			float py = 0.0f;
106: 			// py 計算
107: 			if (pPixels != nullptr) {
108: 				int u = (int)((float)x / FIELD_MESH_H_COUNT * texWidth);
109: 				int v = (int)((float)z / FIELD_MESH_V_COUNT * texHeight);
110: 				if (u >= texWidth) {
111: 					u = texWidth - 1;
112: 				}
113: 				if (v >= texHeight) {
114: 					v = texHeight - 1;
115: 				}
116: 				// 色を読む
117: 				uint8_t* pPixelAddress = pPixels + (v * rowPitch) + (u * 4);
118: 				float colorValue = (float)pPixelAddress[0];
119: 				float heightScale = 20.0f;
120: 				float h = colorValue / 255.0f; // 0.0 ~ 1.0
121: 				py = (h - 0.5f) * heightScale;
122: 			}
123: 			//g_MeshFieldVertex[index].position = { (float)(x * FIELD_MESH_WIDTH),0.0f,(float)(z * FIELD_MESH_DEPTH) };
124: 			g_MeshFieldVertex[index].position = { px, py, pz };
125: 			g_MeshFieldVertex[index].normal = { 0.0f,1.0f,0.0f };
126: 			g_MeshFieldVertex[index].color = { 1.0f,1.0f,1.0f,1.0f };
127: 			g_MeshFieldVertex[index].texcoord = { x * 1.0f,z * 1.0f };
128: 		}
129: 	}
130: 	for (int z = 0; z < FIELD_MESH_V_VERTEX_COUNT; z++) {
131: 		for (int x = 0; x < FIELD_MESH_H_VERTEX_COUNT; x++) {
132: 			int index = x + FIELD_MESH_H_VERTEX_COUNT * z;
133: 			float hC = g_MeshFieldVertex[index].position.y; // Center
134: 			float hL = (x > 0) ? g_MeshFieldVertex[index - 1].position.y : hC;
135: 			float hR = (x < FIELD_MESH_H_VERTEX_COUNT - 1) ? g_MeshFieldVertex[index + 1].position.y : hC;
136: 			float hU = (z > 0) ? g_MeshFieldVertex[index - FIELD_MESH_H_VERTEX_COUNT].position.y : hC;
137: 			float hD = (z < FIELD_MESH_V_VERTEX_COUNT - 1) ? g_MeshFieldVertex[index + FIELD_MESH_H_VERTEX_COUNT].position.y : hC;
138: 			XMFLOAT3 vH = { FIELD_MESH_WIDTH * 2.0f, hR - hL, 0.0f };
139: 			XMFLOAT3 vV = { 0.0f, hD - hU, FIELD_MESH_DEPTH * 2.0f };
140: 			XMVECTOR vecH = XMLoadFloat3(&vH);
141: 			XMVECTOR vecV = XMLoadFloat3(&vV);
142: 			XMVECTOR vecNormal = XMVector3Cross(vecV, vecH);
143: 			vecNormal = XMVector3Normalize(vecNormal);
144: 			XMStoreFloat3(&g_MeshFieldVertex[index].normal, vecNormal);
145: 		}
146: 	}
147: 	//for (int z = 0; z < FIELD_MESH_V_COUNT; z++) {
148: 	//	int index = 26 + FIELD_MESH_H_VERTEX_COUNT * z;
149: 	//	g_MeshFieldVertex[index].color = { 0.0f,1.0f,0.0f,1.0f };
150: 	//	int index1 = 25 + FIELD_MESH_H_VERTEX_COUNT * z;
151: 	//	g_MeshFieldVertex[index1].color = { 0.0f,1.0f,0.0f,1.0f };
152: 	//	int index2 = 27 + FIELD_MESH_H_VERTEX_COUNT * z;
153: 	//	g_MeshFieldVertex[index2].color = { 0.0f,1.0f,0.0f,1.0f };
154: 	//
155: 	//}
156: 	D3D11_SUBRESOURCE_DATA sd{};
157: 	sd.pSysMem = g_MeshFieldVertex;
158: 	g_OriginalHeights.clear();
159: for (int i = 0; i < NUM_VERTEX; i++) {
160:     g_OriginalHeights.push_back(g_MeshFieldVertex[i].position.y);
161: }
162: g_pDevice->CreateBuffer(&bd, &sd, &g_pVertexBuffer);
163: 	bd.ByteWidth = sizeof(unsigned int) * NUM_INDEX;
164: 	bd.BindFlags = D3D11_BIND_INDEX_BUFFER;
165: 	// インデックスバッファ作成
166: 	int index = 0;
167: 	for (int v = 0; v < FIELD_MESH_V_COUNT; v++) {
168: 		for (int h = 0; h < FIELD_MESH_H_COUNT; h++) {
169: 			g_MeshFieldIndex[index + 0] = h + (v + 0) * FIELD_MESH_H_VERTEX_COUNT;
170: 			g_MeshFieldIndex[index + 1] = h + (v + 1) * FIELD_MESH_H_VERTEX_COUNT + 1;
171: 			g_MeshFieldIndex[index + 2] = g_MeshFieldIndex[index + 0] + 1;
172: 			g_MeshFieldIndex[index + 3] = g_MeshFieldIndex[index + 0];
173: 			g_MeshFieldIndex[index + 4] = g_MeshFieldIndex[index + 1] - 1;
174: 			g_MeshFieldIndex[index + 5] = g_MeshFieldIndex[index + 1];
175: 			index += 6;
176: 		}
177: 	}
178: 	// インデックス情報を配列に作る
179: 	sd.pSysMem = g_MeshFieldIndex;
180: 	g_pDevice->CreateBuffer(&bd, &sd, &g_pIndexBuffer);
181: 	g_MeshFieldTexId1 = Texture_Load(L"resource/texture/stone_floor.png"); // キューブのテクスチャの読み込み
182: 	g_MeshFieldTexId0 = Texture_Load(L"resource/texture/rock.png");
183: 	//g_HeightMapTexID = Texture_Load(L"resource/texture/height_map2.png");
184: 	ShaderField_Initialize(g_pDevice, g_pContext);
185: }
186: void MeshField_SetFlatMode(bool isFlat)
187: {
188:     if (g_IsFlatMeshField == isFlat) return;
189:     g_IsFlatMeshField = isFlat;
190:     if (g_pVertexBuffer) {
191:         D3D11_MAPPED_SUBRESOURCE mappedResource;
192:         if (SUCCEEDED(g_pContext->Map(g_pVertexBuffer, 0, D3D11_MAP_WRITE_DISCARD, 0, &mappedResource))) {
193:             Vertex3D* vertices = (Vertex3D*)mappedResource.pData;
194:             for (int i = 0; i < NUM_VERTEX; ++i) {
195:                 if (isFlat) {
196:                     vertices[i].position.y = 0.0f;
197:                 }
198:                 else {
199:                     vertices[i].position.y = g_OriginalHeights[i];
200:                 }
201:                 vertices[i].position.x = g_MeshFieldVertex[i].position.x;
202:                 vertices[i].position.z = g_MeshFieldVertex[i].position.z;
203:                 vertices[i].normal = g_MeshFieldVertex[i].normal;
204:                 vertices[i].color = g_MeshFieldVertex[i].color;
205:                 vertices[i].texcoord = g_MeshFieldVertex[i].texcoord;
206:             }
207:             g_pContext->Unmap(g_pVertexBuffer, 0);
208:         }
209:     }
210: }
211: void MeshField_Finalize(void)
212: {
213: 	ShaderField_Finalize();
214: 	SAFE_RELEASE(g_pVertexBuffer); // 頂点バッファの解放
215: 	SAFE_RELEASE(g_pIndexBuffer);
216: }
217: void MeshField_Draw()
218: {
219: 	// シェーダーを描画パイプラインに設定
220: 	ShaderField_Begin();
221: 	Sampler_SetFilterAnisotropic();
222: 	ID3D11ShaderResourceView* pHeightSRV = Texture_GetSRV(g_HeightMapTexID);
223: 	ShaderField_SetHeightMap(pHeightSRV);
224: 	// テクスチャの設定
225: 	Texture_SetTexture(g_MeshFieldTexId0, 0);
226: 	Texture_SetTexture(g_MeshFieldTexId1, 1);
227: 	//Texture_SetTexture(g_HeightMapTexID, 1);
228: 	// 頂点バッファを描画パイプラインに設定
229: 	UINT stride = sizeof(Vertex3D);
230: 	UINT offset = 0;
231: 	g_pContext->IASetVertexBuffers(0, 1, &g_pVertexBuffer, &stride, &offset);
232: 	// インデックスバッファを描画パイプラインに設定
233: 	g_pContext->IASetIndexBuffer(g_pIndexBuffer, DXGI_FORMAT_R32_UINT, 0);
234: 	// プリミティブトポロジ設定
235: 	g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
236: 	// 頂点シェーダーにワールド座標変換行列を設定
237: 	float offset_x = FIELD_MESH_H_COUNT * FIELD_MESH_WIDTH * 0.5f;
238: 	float offset_z = FIELD_MESH_V_COUNT * FIELD_MESH_DEPTH * 0.5f;
239: 	ShaderField_SetWorldMatrix(XMMatrixTranslation(-offset_x, 0.0f, -offset_z));
240: 	// カメラとパースペクティブ行列
241: 	//ShaderField_SetViewMatrix(XMLoadFloat4x4(&Camera_GetMatrix()));
242: 	//ShaderField_SetProjectionMatrix(XMLoadFloat4x4(&Camera_GetPerspectiveMatrix()));
243: 	//ShaderField_SetShadowMap(Texture_GetSRV(g_MeshFieldTexId1));
244: 	ShaderField_SetMaterialColor({ 1.0f,1.0f,1.0f,1.0f });
245: 	// ポリゴン描画命令発行
246: 	g_pContext->DrawIndexed(NUM_INDEX, 0, 0); // 6頂点で1面分
247: }
248: void MeshField_DrawMeshOnly() {
249: 	UINT stride = sizeof(Vertex3D);
250: 	UINT offset = 0;
251: 	g_pContext->IASetVertexBuffers(0, 1, &g_pVertexBuffer, &stride, &offset);
252: 	g_pContext->IASetIndexBuffer(g_pIndexBuffer, DXGI_FORMAT_R32_UINT, 0);
253: 	g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
254: 	float offset_x = FIELD_MESH_H_COUNT * FIELD_MESH_WIDTH * 0.5f;
255: 	float offset_z = FIELD_MESH_V_COUNT * FIELD_MESH_DEPTH * 0.5f;
256: 	XMMATRIX world = XMMatrixTranslation(-offset_x, 0.0f, -offset_z);
257: 	g_pContext->DrawIndexed(NUM_INDEX, 0, 0);
258: }
259: float MeshField_GetHeight(float x, float z)
260: {
261: 	// (0,0)に戻る
262: 	float width = FIELD_MESH_H_COUNT * FIELD_MESH_WIDTH;
263: 	float depth = FIELD_MESH_V_COUNT * FIELD_MESH_DEPTH;
264: 	float localX = x + (width / 2.0f);
265: 	float localZ = z + (depth / 2.0f);
266: 	int gridX = (int)(localX / FIELD_MESH_WIDTH);
267: 	int gridZ = (int)(localZ / FIELD_MESH_DEPTH);
268: 	if (gridX < 0 || gridX >= FIELD_MESH_H_COUNT ||
269: 		gridZ < 0 || gridZ >= FIELD_MESH_V_COUNT)
270: 	{
271: 		return 0.0f;
272: 	}
273: 	int idxTL = gridX + FIELD_MESH_H_VERTEX_COUNT * gridZ;				// Top-Left
274:     int idxTR = (gridX + 1) + FIELD_MESH_H_VERTEX_COUNT * gridZ;		// Top-Right
275:     int idxBL = gridX + FIELD_MESH_H_VERTEX_COUNT * (gridZ + 1);		// Bottom-Left
276:     int idxBR = (gridX + 1) + FIELD_MESH_H_VERTEX_COUNT * (gridZ + 1);	// Bottom-Right
277: 	float yTL = g_MeshFieldVertex[idxTL].position.y;
278: 	float yTR = g_MeshFieldVertex[idxTR].position.y;
279: 	float yBL = g_MeshFieldVertex[idxBL].position.y;
280: 	float yBR = g_MeshFieldVertex[idxBR].position.y;
281: 	float ratioX = (localX - (float)gridX * FIELD_MESH_WIDTH) / FIELD_MESH_WIDTH;
282: 	float ratioZ = (localZ - (float)gridZ * FIELD_MESH_DEPTH) / FIELD_MESH_DEPTH;
283: 	float height = 0.0f;
284: 	if (ratioX + ratioZ <= 1.0f)
285: 	{	//左上
286: 		height = yTL + (yTR - yTL) * ratioX + (yBL - yTL) * ratioZ;
287: 	}
288: 	else
289: 	{	//右下
290: 		height = yBR + (yBL - yBR) * (1.0f - ratioX) + (yTR - yBR) * (1.0f - ratioZ);
291: 	}
292: 	return height;
293: }
