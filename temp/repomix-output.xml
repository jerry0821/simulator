1594: //   The only case where this is correct is if we provided a min_row_height to TableNextRow() and don't go below it, or in TableEndRow() when we locked that height.
1595: // - Important: if ImGuiTableFlags_PadOuterX is set but ImGuiTableFlags_PadInnerX is not set, the outer-most left and right
1596: //   columns report a small offset so their CellBgRect can extend up to the outer border.
1597: //   FIXME: But the rendering code in TableEndRow() nullifies that with clamping required for scrolling.
1598: ImRect ImGui::TableGetCellBgRect(const ImGuiTable* table, int column_n)
1599: {
1600:     const ImGuiTableColumn* column = &table->Columns[column_n];
1601:     float x1 = column->MinX;
1602:     float x2 = column->MaxX;
1603:     //if (column->PrevEnabledColumn == -1)
1604:     //    x1 -= table->OuterPaddingX;
1605:     //if (column->NextEnabledColumn == -1)
1606:     //    x2 += table->OuterPaddingX;
1607:     x1 = ImMax(x1, table->WorkRect.Min.x);
1608:     x2 = ImMin(x2, table->WorkRect.Max.x);
1609:     return ImRect(x1, table->RowPosY1, x2, table->RowPosY2);
