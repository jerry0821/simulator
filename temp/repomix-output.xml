<file path="shader_vertex_billboard.hlsl">
 1: /*==============================================================================
 2: 
 3:    ビルボード描画用頂点シェーダー [shader_vertex_billboard.hlsl]
 4: 														 Author : Jerry
 5: 														 Date   : 2025/11/14
 6: --------------------------------------------------------------------------------
 7: 
 8: ==============================================================================*/
 9: 
10: // 定数バッファ
11: cbuffer VS_CONSTANT_BUFFER : register(b0)
12: {
13:     float4x4 world;
14: };
15: 
16: cbuffer VS_CONSTANT_BUFFER : register(b1)
17: {
18:     float4x4 view;
19: };
20: 
21: cbuffer VS_CONSTANT_BUFFER : register(b2)
22: {
23:     float4x4 proj;
24: };
25: 
26: cbuffer VS_CONSTANT_BUFFER : register(b3)
27: {
28:     float2 scale;
29:     float2 translation;
30: };
31:  
32: struct VS_IN
33: {
34:     float4 posL : POSITION0;
35:     float4 color : COLOR0;
36:     float2 uv : TEXCOORD0;
37: };
38:  
39: struct VS_OUT
40: {
41:     float4 posH : SV_POSITION;
42:     float4 color : COLOR0;
43:     float2 uv : TEXCOORD0;
44: };
45:  
46: //=============================================================================
47: // 頂点シェーダ
48: //=============================================================================
49: VS_OUT main(VS_IN vi)
50: {
51:     VS_OUT vo;
52:     
53:     // 座標変換
54:     float4x4 mtxWV = mul(world, view);
55:     float4x4 mtxWVP = mul(mtxWV, proj);
56:     vo.posH = mul(vi.posL, mtxWVP);
57:     
58:     vo.color = vi.color;
59:     
60:     vo.uv = vi.uv * scale + translation;
61:     
62:     return vo;
63: }
</file>

