3560: // - Currently represents the Platform Window created by the application which is hosting our Dear ImGui windows.
3561: // - In 'docking' branch with multi-viewport enabled, we extend this concept to have multiple active viewports.
3562: // - In the future we will extend this concept further to also represent Platform Monitor and support a "no main platform window" operation mode.
3563: // - About Main Area vs Work Area:
3564: //   - Main Area = entire viewport.
3565: //   - Work Area = entire viewport minus sections used by main menu bars (for platform windows), or by task bar (for platform monitor).
3566: //   - Windows are generally trying to stay within the Work Area of their host viewport.
3567: struct ImGuiViewport
3568: {
3569:     ImGuiID             ID;                     // Unique identifier for the viewport
3570:     ImGuiViewportFlags  Flags;                  // See ImGuiViewportFlags_
3571:     ImVec2              Pos;                    // Main Area: Position of the viewport (Dear ImGui coordinates are the same as OS desktop/native coordinates)
3572:     ImVec2              Size;                   // Main Area: Size of the viewport.
3573:     ImVec2              FramebufferScale;       // Density of the viewport for Retina display (always 1,1 on Windows, may be 2,2 etc on macOS/iOS). This will affect font rasterizer density.
3574:     ImVec2              WorkPos;                // Work Area: Position of the viewport minus task bars, menus bars, status bars (>= Pos)
3575:     ImVec2              WorkSize;               // Work Area: Size of the viewport minus task bars, menu bars, status bars (<= Size)
3576:     // Platform/Backend Dependent Data
3577:     void*               PlatformHandle;         // void* to hold higher-level, platform window handle (e.g. HWND, GLFWWindow*, SDL_Window*)
3578:     void*               PlatformHandleRaw;      // void* to hold lower-level, platform-native window handle (under Win32 this is expected to be a HWND, unused for other platforms)
3579:     ImGuiViewport()     { memset(this, 0, sizeof(*this)); }
3580:     // Helpers
3581:     ImVec2              GetCenter() const       { return ImVec2(Pos.x + Size.x * 0.5f, Pos.y + Size.y * 0.5f); }
3582:     ImVec2              GetWorkCenter() const   { return ImVec2(WorkPos.x + WorkSize.x * 0.5f, WorkPos.y + WorkSize.y * 0.5f); }
3583: };
