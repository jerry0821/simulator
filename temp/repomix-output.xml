 33: #pragma once
 34: #ifndef AI_HASH_H_INCLUDED
 35: #define AI_HASH_H_INCLUDED
 36: #ifdef __GNUC__
 37: #   pragma GCC system_header
 38: #endif
 39: #include <stdint.h"
 40: #include <string.h"
 41: #include <cmath>
 42: // ------------------------------------------------------------------------------------------------
 43: // Hashing function taken from
 44: // http://www.azillionmonkeys.com/qed/hash.html
 45: // (incremental version)
 46: //
 47: // This code is Copyright 2004-2008 by Paul Hsieh. It is used here in the belief that
 48: // Assimp's license is considered compatible with Pauls's derivative license as specified
 49: // on his web page.
 50: //
 51: // (stdint.h should have been been included here)
 52: // ------------------------------------------------------------------------------------------------
 53: #undef get16bits
 54: #if (defined(__GNUC__) && defined(__i386__)) || defined(__WATCOMC__) \
 55:   || defined(_MSC_VER) || defined (__BORLANDC__) || defined (__TURBOC__)
 56: #define get16bits(d) (*((const uint16_t *) (d)))
 57: #endif
 58: #if !defined (get16bits)
 59: #define get16bits(d) ((((uint32_t)(((const uint8_t *)(d))[1])) << 8)\
 60:                        +(uint32_t)(((const uint8_t *)(d))[0]) )
 61: #endif
 62: // ------------------------------------------------------------------------------------------------
 63: inline uint32_t SuperFastHash (const char * data, uint32_t len = 0, uint32_t hash = 0) {
 64:     uint32_t tmp;
 65:     int rem;
 66:     if (!data) return 0;
 67:     if (!len)len = (uint32_t)::strlen(data);
 68:     rem = len & 3;
 69:     len >>= 2;
 70:     /* Main loop */
 71:     for (;len > 0; len--) {
 72:         hash  += get16bits (data);
 73:         tmp    = (get16bits (data+2) << 11) ^ hash;
 74:         hash   = (hash << 16) ^ tmp;
 75:         data  += 2*sizeof (uint16_t);
 76:         hash  += hash >> 11;
 77:     }
 78:     /* Handle end cases */
 79:     switch (rem) {
 80:         case 3: hash += get16bits (data);
 81:                 hash ^= hash << 16;
 82:                 hash ^= abs(data[sizeof(uint16_t)]) << 18;
 83:                 hash += hash >> 11;
 84:                 break;
 85:         case 2: hash += get16bits (data);
 86:                 hash ^= hash << 11;
 87:                 hash += hash >> 17;
 88:                 break;
 89:         case 1: hash += *data;
 90:                 hash ^= hash << 10;
 91:                 hash += hash >> 1;
 92:     }
 93:     /* Force "avalanching" of final 127 bits */
 94:     hash ^= hash << 3;
 95:     hash += hash >> 5;
 96:     hash ^= hash << 4;
 97:     hash += hash >> 17;
 98:     hash ^= hash << 25;
 99:     hash += hash >> 6;
100:     return hash;
101: }
102: #endif // !! AI_HASH_H_INCLUDED
</file>

