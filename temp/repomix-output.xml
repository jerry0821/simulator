8997: // Note: we may scroll to tab that are not selected! e.g. using keyboard arrow keys
8998: static void ImGui::TabBarScrollToTab(ImGuiTabBar* tab_bar, ImGuiID tab_id, ImGuiTabBarSection* sections)
8999: {
9000:     ImGuiTabItem* tab = TabBarFindTabByID(tab_bar, tab_id);
9001:     if (tab == NULL)
9002:         return;
9003:     if (tab->Flags & ImGuiTabItemFlags_SectionMask_)
9004:         return;
9005:     ImGuiContext& g = *GImGui;
9006:     float margin = g.FontSize * 1.0f; // When to scroll to make Tab N+1 visible always make a bit of N visible to suggest more scrolling area (since we don't have a scrollbar)
9007:     int order = TabBarGetTabOrder(tab_bar, tab);
9008:     // Scrolling happens only in the central section (leading/trailing sections are not scrolling)
9009:     float scrollable_width = TabBarCalcScrollableWidth(tab_bar, sections);
9010:     // We make all tabs positions all relative Sections[0].Width to make code simpler
9011:     float tab_x1 = tab->Offset - sections[0].Width + (order > sections[0].TabCount - 1 ? -margin : 0.0f);
9012:     float tab_x2 = tab->Offset - sections[0].Width + tab->Width + (order + 1 < tab_bar->Tabs.Size - sections[2].TabCount ? margin : 1.0f);
9013:     tab_bar->ScrollingTargetDistToVisibility = 0.0f;
9014:     if (tab_bar->ScrollingTarget > tab_x1 || (tab_x2 - tab_x1 >= scrollable_width))
9015:     {
9016:         // Scroll to the left
9017:         tab_bar->ScrollingTargetDistToVisibility = ImMax(tab_bar->ScrollingAnim - tab_x2, 0.0f);
9018:         tab_bar->ScrollingTarget = tab_x1;
9019:     }
9020:     else if (tab_bar->ScrollingTarget < tab_x2 - scrollable_width)
9021:     {
9022:         // Scroll to the right
9023:         tab_bar->ScrollingTargetDistToVisibility = ImMax((tab_x1 - scrollable_width) - tab_bar->ScrollingAnim, 0.0f);
9024:         tab_bar->ScrollingTarget = tab_x2 - scrollable_width;
9025:     }
9026: }
