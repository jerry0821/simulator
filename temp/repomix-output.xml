33: /** @file Profiler.h
34:  *  @brief Utility to measure the respective runtime of each import step
35:  */
36: #pragma once
37: #ifndef AI_INCLUDED_PROFILER_H
38: #define AI_INCLUDED_PROFILER_H
39: #ifdef __GNUC__
40: #   pragma GCC system_header
41: #endif
42: #include <chrono>
43: #include "DefaultLogger.hpp>
44: #include "TinyFormatter.h"
45: #include <map>
46: namespace Assimp {
47: namespace Profiling {
48: using namespace Formatter;
49: // ------------------------------------------------------------------------------------------------
50: /** Simple wrapper around boost::timer to simplify reporting. Timings are automatically
51:  *  dumped to the log file.
52:  */
53: class Profiler {
54: public:
55:     Profiler() {
56:         // empty
57:     }
58:     /** Start a named timer */
59:     void BeginRegion(const std::string& region) {
60:         regions[region] = std::chrono::system_clock::now();
61:         ASSIMP_LOG_DEBUG("START `",region,"`");
62:     }
63:     /** End a specific named timer and write its end time to the log */
64:     void EndRegion(const std::string& region) {
65:         RegionMap::const_iterator it = regions.find(region);
66:         if (it == regions.end()) {
67:             return;
68:         }
69:         std::chrono::duration<double> elapsedSeconds = std::chrono::system_clock::now() - regions[region];
70:         ASSIMP_LOG_DEBUG("END   `",region,"`, dt= ", elapsedSeconds.count()," s");
71:     }
72: private:
73:     typedef std::map<std::string,std::chrono::time_point<std::chrono::system_clock>> RegionMap;
74:     RegionMap regions;
75: };
76: }
77: }
78: #endif // AI_INCLUDED_PROFILER_H
</file>

