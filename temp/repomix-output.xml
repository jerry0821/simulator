13294:     ImGuiID id = viewport->ID;
13295:     if (!IsMouseHoveringRect(bb.Min, bb.Max, false) || (id == g.DragDropPayload.SourceId))
13296:         return false;
13297:     IM_ASSERT(g.DragDropWithinTarget == false && g.DragDropWithinSource == false); // Can't nest BeginDragDropSource() and BeginDragDropTarget()
13298:     g.DragDropTargetRect = bb;
13299:     g.DragDropTargetClipRect = bb;
