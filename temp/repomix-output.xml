1743: bool ImGui::BeginComboPopup(ImGuiID popup_id, const ImRect& bb, ImGuiComboFlags flags)
1744: {
1745:     ImGuiContext& g = *GImGui;
1746:     if (!IsPopupOpen(popup_id, ImGuiPopupFlags_None))
1747:     {
1748:         g.NextWindowData.ClearFlags();
1749:         return false;
1750:     }
1751:     // Set popup size
1752:     float w = bb.GetWidth();
1753:     if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasSizeConstraint)
1754:     {
1755:         g.NextWindowData.SizeConstraintRect.Min.x = ImMax(g.NextWindowData.SizeConstraintRect.Min.x, w);
1756:     }
1757:     else
1758:     {
1759:         if ((flags & ImGuiComboFlags_HeightMask_) == 0)
1760:             flags |= ImGuiComboFlags_HeightRegular;
1761:         IM_ASSERT(ImIsPowerOfTwo(flags & ImGuiComboFlags_HeightMask_)); // Only one
1762:         int popup_max_height_in_items = -1;
1763:         if (flags & ImGuiComboFlags_HeightRegular)     popup_max_height_in_items = 8;
1764:         else if (flags & ImGuiComboFlags_HeightSmall)  popup_max_height_in_items = 4;
1765:         else if (flags & ImGuiComboFlags_HeightLarge)  popup_max_height_in_items = 20;
1766:         ImVec2 constraint_min(0.0f, 0.0f), constraint_max(FLT_MAX, FLT_MAX);
1767:         if ((g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasSize) == 0 || g.NextWindowData.SizeVal.x <= 0.0f) // Don't apply constraints if user specified a size
1768:             constraint_min.x = w;
1769:         if ((g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasSize) == 0 || g.NextWindowData.SizeVal.y <= 0.0f)
1770:             constraint_max.y = CalcMaxPopupHeightFromItemCount(popup_max_height_in_items);
1771:         SetNextWindowSizeConstraints(constraint_min, constraint_max);
1772:     }
1773:     // This is essentially a specialized version of BeginPopupEx()
1774:     char name[16];
1775:     ImFormatString(name, IM_ARRAYSIZE(name), "##Combo_%02d", g.BeginComboDepth); // Recycle windows based on depth
1776:     // Set position given a custom constraint (peak into expected window size so we can position it)
1777:     // FIXME: This might be easier to express with an hypothetical SetNextWindowPosConstraints() function?
1778:     // FIXME: This might be moved to Begin() or at least around the same spot where Tooltips and other Popups are calling FindBestWindowPosForPopupEx()?
1779:     if (ImGuiWindow* popup_window = FindWindowByName(name))
1780:         if (popup_window->WasActive)
1781:         {
1782:             // Always override 'AutoPosLastDirection' to not leave a chance for a past value to affect us.
1783:             ImVec2 size_expected = CalcWindowNextAutoFitSize(popup_window);
1784:             popup_window->AutoPosLastDirection = (flags & ImGuiComboFlags_PopupAlignLeft) ? ImGuiDir_Left : ImGuiDir_Down; // Left = "Below, Toward Left", Down = "Below, Toward Right (default)"
1785:             ImRect r_outer = GetPopupAllowedExtentRect(popup_window);
1786:             ImVec2 pos = FindBestWindowPosForPopupEx(bb.GetBL(), size_expected, &popup_window->AutoPosLastDirection, r_outer, bb, ImGuiPopupPositionPolicy_ComboBox);
1787:             SetNextWindowPos(pos);
1788:         }
1789:     // We don't use BeginPopupEx() solely because we have a custom name string, which we could make an argument to BeginPopupEx()
1790:     ImGuiWindowFlags window_flags = ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_Popup | ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoMove;
1791:     PushStyleVarX(ImGuiStyleVar_WindowPadding, g.Style.FramePadding.x); // Horizontally align ourselves with the framed text
1792:     bool ret = Begin(name, NULL, window_flags);
1793:     PopStyleVar();
1794:     if (!ret)
1795:     {
1796:         EndPopup();
1797:         if (!g.IO.ConfigDebugBeginReturnValueOnce && !g.IO.ConfigDebugBeginReturnValueLoop) // Begin may only return false with those debug tools activated.
1798:             IM_ASSERT(0); // This should never happen as we tested for IsPopupOpen() above
1799:         return false;
1800:     }
1801:     g.BeginComboDepth++;
1802:     return true;
1803: }
