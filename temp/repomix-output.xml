5412: //-----------------------------------------------------------------------------
5413: // [SECTION] Decompression code
5414: //-----------------------------------------------------------------------------
5415: // Compressed with stb_compress() then converted to a C array and encoded as base85.
5416: // Use the program in misc/fonts/binary_to_compressed_c.cpp to create the array from a TTF file.
5417: // The purpose of encoding as base85 instead of "0x00,0x01,..." style is only save on _source code_ size.
5418: // Decompression from stb.h (public domain) by Sean Barrett https://github.com/nothings/stb/blob/master/stb.h
5419: //-----------------------------------------------------------------------------
5420: static unsigned int stb_decompress_length(const unsigned char *input)
5421: {
5422:     return (input[8] << 24) + (input[9] << 16) + (input[10] << 8) + input[11];
5423: }
5424: static unsigned char *stb__barrier_out_e, *stb__barrier_out_b;
5425: static const unsigned char *stb__barrier_in_b;
5426: static unsigned char *stb__dout;
5427: static void stb__match(const unsigned char *data, unsigned int length)
5428: {
5429:     // INVERSE of memmove... write each byte before copying the next...
5430:     IM_ASSERT(stb__dout + length <= stb__barrier_out_e);
5431:     if (stb__dout + length > stb__barrier_out_e) { stb__dout += length; return; }
5432:     if (data < stb__barrier_out_b) { stb__dout = stb__barrier_out_e+1; return; }
5433:     while (length--) *stb__dout++ = *data++;
5434: }
5435: static void stb__lit(const unsigned char *data, unsigned int length)
5436: {
5437:     IM_ASSERT(stb__dout + length <= stb__barrier_out_e);
5438:     if (stb__dout + length > stb__barrier_out_e) { stb__dout += length; return; }
5439:     if (data < stb__barrier_in_b) { stb__dout = stb__barrier_out_e+1; return; }
5440:     memcpy(stb__dout, data, length);
5441:     stb__dout += length;
5442: }
5443: #define stb__in2(x)   ((i[x] << 8) + i[(x)+1])
5444: #define stb__in3(x)   ((i[x] << 16) + stb__in2((x)+1))
5445: #define stb__in4(x)   ((i[x] << 24) + stb__in3((x)+1))
5446: static const unsigned char *stb_decompress_token(const unsigned char *i)
5447: {
5448:     if (*i >= 0x20) { // use fewer if's for cases that expand small
5449:         if (*i >= 0x80)       stb__match(stb__dout-i[1]-1, i[0] - 0x80 + 1), i += 2;
5450:         else if (*i >= 0x40)  stb__match(stb__dout-(stb__in2(0) - 0x4000 + 1), i[2]+1), i += 3;
5451:         else /* *i >= 0x20 */ stb__lit(i+1, i[0] - 0x20 + 1), i += 1 + (i[0] - 0x20 + 1);
5452:     } else { // more ifs for cases that expand large, since overhead is amortized
5453:         if (*i >= 0x18)       stb__match(stb__dout-(stb__in3(0) - 0x180000 + 1), i[3]+1), i += 4;
5454:         else if (*i >= 0x10)  stb__match(stb__dout-(stb__in3(0) - 0x100000 + 1), stb__in2(3)+1), i += 5;
5455:         else if (*i >= 0x08)  stb__lit(i+2, stb__in2(0) - 0x0800 + 1), i += 2 + (stb__in2(0) - 0x0800 + 1);
5456:         else if (*i == 0x07)  stb__lit(i+3, stb__in2(1) + 1), i += 3 + (stb__in2(1) + 1);
5457:         else if (*i == 0x06)  stb__match(stb__dout-(stb__in3(1)+1), i[4]+1), i += 5;
5458:         else if (*i == 0x04)  stb__match(stb__dout-(stb__in3(1)+1), stb__in2(4)+1), i += 6;
5459:     }
5460:     return i;
5461: }
5462: static unsigned int stb_adler32(unsigned int adler32, unsigned char *buffer, unsigned int buflen)
5463: {
5464:     const unsigned long ADLER_MOD = 65521;
5465:     unsigned long s1 = adler32 & 0xffff, s2 = adler32 >> 16;
5466:     unsigned long blocklen = buflen % 5552;
5467:     unsigned long i;
5468:     while (buflen) {
5469:         for (i=0; i + 7 < blocklen; i += 8) {
5470:             s1 += buffer[0], s2 += s1;
5471:             s1 += buffer[1], s2 += s1;
5472:             s1 += buffer[2], s2 += s1;
5473:             s1 += buffer[3], s2 += s1;
5474:             s1 += buffer[4], s2 += s1;
5475:             s1 += buffer[5], s2 += s1;
5476:             s1 += buffer[6], s2 += s1;
5477:             s1 += buffer[7], s2 += s1;
5478:             buffer += 8;
5479:         }
5480:         for (; i < blocklen; ++i)
5481:             s1 += *buffer++, s2 += s1;
5482:         s1 %= ADLER_MOD, s2 %= ADLER_MOD;
5483:         buflen -= blocklen;
5484:         blocklen = 5552;
5485:     }
5486:     return (unsigned int)(s2 << 16) + (unsigned int)s1;
5487: }
5488: static unsigned int stb_decompress(unsigned char *output, const unsigned char *i, unsigned int /*length*/)
5489: {
5490:     if (stb__in4(0) != 0x57bC0000) return 0;
5491:     if (stb__in4(4) != 0)          return 0; // error! stream is > 4GB
5492:     const unsigned int olen = stb_decompress_length(i);
5493:     stb__barrier_in_b = i;
5494:     stb__barrier_out_e = output + olen;
5495:     stb__barrier_out_b = output;
5496:     i += 16;
5497:     stb__dout = output;
5498:     for (;;) {
5499:         const unsigned char *old_i = i;
5500:         i = stb_decompress_token(i);
5501:         if (i == old_i) {
5502:             if (*i == 0x05 && i[1] == 0xfa) {
5503:                 IM_ASSERT(stb__dout == output + olen);
5504:                 if (stb__dout != output + olen) return 0;
5505:                 if (stb_adler32(1, output, olen) != (unsigned int) stb__in4(2))
5506:                     return 0;
5507:                 return olen;
5508:             } else {
5509:                 IM_ASSERT(0); /* NOTREACHED */
5510:                 return 0;
5511:             }
5512:         }
5513:         IM_ASSERT(stb__dout <= output + olen);
5514:         if (stb__dout > output + olen)
5515:             return 0;
5516:     }
5517: }
