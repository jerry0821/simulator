 598: // Render-level scissoring. This is passed down to your render function but not used for CPU-side coarse clipping. Prefer using higher-level ImGui::PushClipRect() to affect logic (hit-testing and widget culling)
 599: void ImDrawList::PushClipRect(const ImVec2& cr_min, const ImVec2& cr_max, bool intersect_with_current_clip_rect)
 600: {
 601:     ImVec4 cr(cr_min.x, cr_min.y, cr_max.x, cr_max.y);
 602:     if (intersect_with_current_clip_rect)
 603:     {
 604:         ImVec4 current = _CmdHeader.ClipRect;
 605:         if (cr.x < current.x) cr.x = current.x;
 606:         if (cr.y < current.y) cr.y = current.y;
 607:         if (cr.z > current.z) cr.z = current.z;
 608:         if (cr.w > current.w) cr.w = current.w;
 609:     }
 610:     cr.z = ImMax(cr.x, cr.z);
 611:     cr.w = ImMax(cr.y, cr.w);
 612:     _ClipRectStack.push_back(cr);
 613:     _CmdHeader.ClipRect = cr;
 614:     _OnChangedClipRect();
 615: }
