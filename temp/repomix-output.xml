 4163:         deactivated_data->ID = g.ActiveId;
 4164:         deactivated_data->ElapseFrame = (g.LastItemData.ID == g.ActiveId) ? g.FrameCount : g.FrameCount + 1; // FIXME: OK to use LastItemData?
 4165:         deactivated_data->HasBeenEditedBefore = g.ActiveIdHasBeenEditedBefore;
 4166:         deactivated_data->IsAlive = (g.ActiveIdIsAlive == g.ActiveId);
 4167:         // This could be written in a more general way (e.g associate a hook to ActiveId),
 4168:         // but since this is currently quite an exception we'll leave it as is.
 4169:         // One common scenario leading to this is: pressing Key ->NavMoveRequestApplyResult() -> ClearActiveID()
 4170:         if (g.InputTextState.ID == g.ActiveId)
 4171:             InputTextDeactivateHook(g.ActiveId);
 4172:         // While most behaved code would make an effort to not steal active id during window move/drag operations,
 4173:         // we at least need to be resilient to it. Canceling the move is rather aggressive and users of 'master' branch
 4174:         // may prefer the weird ill-defined half working situation ('docking' did assert), so may need to rework that.
 4175:         if (g.MovingWindow != NULL && g.ActiveId == g.MovingWindow->MoveId)
 4176:         {
 4177:             IMGUI_DEBUG_LOG_ACTIVEID("SetActiveID() cancel MovingWindow\n");
