13875: static void WindowSettingsHandler_ClearAll(ImGuiContext* ctx, ImGuiSettingsHandler*)
13876: {
13877:     ImGuiContext& g = *ctx;
13878:     for (ImGuiWindow* window : g.Windows)
13879:         window->SettingsOffset = -1;
