241: void CreateMagicCircle(DirectX::XMFLOAT3 center)
242: {
243:     Particle_Spawn(
244:         center,
245:         { 0, 0, 0 },
246:         { 0.5f, 0.9f, 1.0f, 1.0f },
247:         4.0f,    
248:         0.3f, 
249:         PT_SPARK,
250:         0.0f, 0.0f
251:     );
252:     float radii[] = { 1.5f, 0.8f };
253:     int counts[] = { 40, 20 }; 
254:     for (int r = 0; r < 2; r++) 
255:     {
256:         float currentRadius = radii[r];
257:         int count = counts[r];
258:         for (int i = 0; i < count; i++)
259:         {
260:             float angle = (360.0f / count * i) * (3.14159f / 180.0f);
261:             float px = cos(angle) * currentRadius;
262:             float pz = sin(angle) * currentRadius;
263:             XMFLOAT3 pos = { center.x + px, center.y + 0.1f, center.z + pz };
264:             float tanX = -pz;
265:             float tanZ = px;
266:             float len = sqrt(tanX * tanX + tanZ * tanZ);
267:             tanX /= len; tanZ /= len;
268:             XMFLOAT3 vel = { tanX * 1.0f, 0.0f, tanZ * 1.0f };
269:             Particle_Spawn(
270:                 pos,
271:                 vel,
272:                 { 0.1f, 0.8f, 1.0f, 1.0f }, 
273:                 0.5f,    
274:                 3.0f,    
275:                 PT_SPARK,
276:                 0.0f,
277:                 3.0f  
278:             );
279:         }
280:     }
281:     int risingCount = 40;
282:     for (int i = 0; i < risingCount; i++)
283:     {
284:         float angle = (rand() % 360) * (3.14159f / 180.0f);
285:         float r = 0.5f + (rand() % 100) * 0.015f;
286:         float px = cos(angle) * r;
287:         float pz = sin(angle) * r;
288:         XMFLOAT3 pos = { center.x + px, center.y, center.z + pz };
289:         XMFLOAT3 vel = { -pz * 3.0f, 2.0f + (rand() % 20) * 0.1f, px * 3.0f };
290:         Particle_Spawn(
291:             pos,
292:             vel,
293:             { 0.6f, 1.0f, 1.0f, 1.0f }, 
294:             0.25f,
295:             1.5f,
296:             PT_SPARK,
297:             -1.0f, 
298:             0.5f
299:         );
300:     }
301:     // pillar
302:     for (int i = 0; i < 15; i++) {
303:         float speedY = 4.0f + (float)i * 0.5f;
304:         Particle_Spawn(center, { 0, speedY, 0 }, { 1,1,1,1 }, 0.6f, 1.0f, PT_SPARK, 0.0f, 0.1f);
305:     }
306: }
307: void CreateFirePillarVisual(DirectX::XMFLOAT3 center, float radius)
308: {
309:     int density = 3;
310:     float pillarHeight = 10.0f;
311:     for (int i = 0; i < density; i++)
312:     {
313:         float rRatio = (rand() % 100) / 100.0f;
314:         rRatio = sqrtf(rRatio);
315:         float r = rRatio * radius;
316:         float theta = (rand() % 360) * 3.14159f / 180.0f;
317:         float randomHeight = ((rand() % 100) / 100.0f) * pillarHeight;
318:         XMFLOAT3 pos = {
319:             center.x + r * cosf(theta),
320:             center.y + randomHeight,
321:             center.z + r * sinf(theta)
322:         };
323:         // (Suction Velocity)
324:         float dirToCenterX = -cosf(theta);
325:         float dirToCenterZ = -sinf(theta);
326:         float suctionStrength = 5.0f + (r / radius) * 15.0f;
327:         float speedY = 8.0f + ((rand() % 100) / 100.0f) * 5.0f; 
328:         XMFLOAT3 vel = {
329:             dirToCenterX * suctionStrength, // X 軸 內
330:             speedY,                         // Y 軸 上
331:             dirToCenterZ * suctionStrength  // Z 軸 內
332:         };
333:         // ==========================================
334:         XMFLOAT4 color;
335:         color = { 2.0f, 0.6f, 0.1f, 0.7f };
336:         Particle_Spawn(
337:             pos,
338:             vel,
339:             color,
340:             2.5f,  
341:             0.15f, 
342:             PT_FIRE,
343:             0.0f,
344:             0.0f
345:         );
346:     }
347: }
348: void CreateUltChargeEffect(XMFLOAT3 centerPos, float spawnRadius, int count, XMFLOAT4 color, float timeToCenter)
349: {
350:     if (timeToCenter <= 0.001f) timeToCenter = 0.1f;
351:     for (int i = 0; i < count; i++) 
352:     {
353:         float angle = (rand() % 360) * 3.14159f / 180.0f;
354:         float hOffset = ((rand() % 200) / 100.0f) - 1.0f;
355:         XMFLOAT3 spawnPos;
356:         spawnPos.x = centerPos.x + cosf(angle) * spawnRadius;
357:         spawnPos.y = centerPos.y + (hOffset * spawnRadius * 0.5f);
358:         spawnPos.z = centerPos.z + sinf(angle) * spawnRadius;
359:         // 1. 基礎向心速度 (往中心直飛)
360:         XMFLOAT3 vel;
361:         vel.x = (centerPos.x - spawnPos.x) / timeToCenter;
362:         vel.y = (centerPos.y - spawnPos.y) / timeToCenter;
363:         vel.z = (centerPos.z - spawnPos.z) / timeToCenter;
364:         // =========================================================
365:         // ★ 2. 加入漩渦力道 (Swirl Force)
366:         // 利用圓的切線方向 (-sin, cos) 讓粒子產生繞著 Y 軸旋轉的效果
367:         // =========================================================
368:         float swirlForce = 2.0f; // 數值越大，繞圈的幅度越寬、越有龍捲風的感覺
369:         vel.x += -sinf(angle) * swirlForce;
370:         vel.z += cosf(angle) * swirlForce;
371:         float size = 0.5f + ((rand() % 100) / 100.0f) * 1.0f;
372:         Particle_Spawn(
373:             spawnPos,
374:             vel,
375:             color,
376:             size,
377:             timeToCenter,
378:             PT_SPARK,
379:             0.0f,
380:             0.0f
381:         );
382:     }
383: }
384: void CreateEnergyOrbEffect(DirectX::XMFLOAT3 centerPos, DirectX::XMFLOAT4 color, float size)
385: {
386:     Particle_Spawn(
387:         centerPos,
