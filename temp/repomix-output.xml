 4625:     if (viewport->BgFgDrawListsLastFrame[drawlist_no] != g.FrameCount)
 4626:     {
 4627:         draw_list->_ResetForNewFrame();
 4628:         draw_list->PushTexture(g.IO.Fonts->TexRef);
 4629:         draw_list->PushClipRect(viewport->Pos, viewport->Pos + viewport->Size, false);
 4630:         viewport->BgFgDrawListsLastFrame[drawlist_no] = g.FrameCount;
 4631:     }
 4632:     return draw_list;
 4633: }
