<file path="shader_particle.cpp">
  1: #include "shader_particle.h"
  2: #include "direct3d.h" 
  3: #include "debug_ostream.h" 
  4: #include "sampler.h"
  5: #include <fstream>
  6: #include <vector>
  7: using namespace DirectX;
  8: #include "texture.h"
  9: static ID3D11VertexShader* g_pVertexShader = nullptr;
 10: static ID3D11PixelShader* g_pPixelShader = nullptr;
 11: static ID3D11InputLayout* g_pInputLayout = nullptr;
 12: static ID3D11Buffer* g_pConstantBuffer = nullptr;
 13: static ID3D11Buffer* g_pDynamicVertexBuffer = nullptr;
 14: static const int MAX_BATCH_SIZE = 4000;
 15: struct CB_Matrix {
 16:     XMFLOAT4X4 World;
 17:     XMFLOAT4X4 View;
 18:     XMFLOAT4X4 Projection;
 19: };
 20: static XMMATRIX g_WorldMatrix;
 21: static XMMATRIX g_ViewMatrix;
 22: static XMMATRIX g_ProjectionMatrix;
 23: static bool LoadShaderFile(const char* filename, std::vector<char>& buffer)
 24: {
 25:     std::ifstream ifs(filename, std::ios::binary);
 26:     if (!ifs) return false;
 27:     ifs.seekg(0, std::ios::end);
 28:     size_t size = (size_t)ifs.tellg();
 29:     ifs.seekg(0, std::ios::beg);
 30:     buffer.resize(size);
 31:     ifs.read(buffer.data(), size);
 32:     return true;
 33: }
 34: bool ShaderParticle_Initialize()
 35: {
 36:     HRESULT hr;
 37:     // 行列の初期化
 38:     g_WorldMatrix = XMMatrixIdentity();
 39:     g_ViewMatrix = XMMatrixIdentity();
 40:     g_ProjectionMatrix = XMMatrixIdentity();
 41:     // 1. 頂点シェーダー読み込み
 42:     std::vector<char> vsData;
 43:     if (!LoadShaderFile("resource/shader/shader_vertex_particle.cso", vsData)) {
 44:         hal::dout << "shader_vertex_particle読み込み失敗" << std::endl;
 45:         return false;
 46:     }
 47:     hr = Direct3D_GetDevice()->CreateVertexShader(vsData.data(), vsData.size(), nullptr, &g_pVertexShader);
 48:     if (FAILED(hr)) return false;
 49:     // 2. 入力レイアウト作成 (★ここが重要！ VertexParticle 構造体に合わせる)
 50:     // 構造: Position(float3), Color(float4), UV(float2)
 51:     D3D11_INPUT_ELEMENT_DESC layout[] = {
 52:         { "POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT,    0, 0,                            D3D11_INPUT_PER_VERTEX_DATA, 0 },
 53:         { "COLOR",    0, DXGI_FORMAT_R32G32B32A32_FLOAT, 0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 },
 54:         { "TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT,       0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 },
 55:     };
 56:     hr = Direct3D_GetDevice()->CreateInputLayout(layout, ARRAYSIZE(layout), vsData.data(), vsData.size(), &g_pInputLayout);
 57:     if (FAILED(hr)) return false;
 58:     // 3. ピクセルシェーダー読み込み
 59:     std::vector<char> psData;
 60:     // もし shader_pixel_particle.cso がなければ、一時的に shader_pixel_2d.cso を使っても動きます
 61:     if (!LoadShaderFile("resource/shader/shader_pixel_particle.cso", psData)) {
 62:         hal::dout << "shader_pixel_particle読み込み失敗" << std::endl;
 63:         return false;
 64:     }
 65:     hr = Direct3D_GetDevice()->CreatePixelShader(psData.data(), psData.size(), nullptr, &g_pPixelShader);
 66:     if (FAILED(hr)) return false;
 67:     // 4. 定数バッファ作成 (World, View, Projection)
 68:     D3D11_BUFFER_DESC bd = {};
 69:     bd.ByteWidth = sizeof(CB_Matrix);
 70:     bd.Usage = D3D11_USAGE_DEFAULT;
 71:     bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
 72:     hr = Direct3D_GetDevice()->CreateBuffer(&bd, nullptr, &g_pConstantBuffer);
 73:     if (FAILED(hr)) return false;
 74:     ZeroMemory(&bd, sizeof(bd));
 75:     bd.Usage = D3D11_USAGE_DYNAMIC; // CPU書き込み可
 76:     bd.ByteWidth = sizeof(VertexParticle) * MAX_BATCH_SIZE * 6; // 容量確保
 77:     bd.BindFlags = D3D11_BIND_VERTEX_BUFFER;
 78:     bd.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
 79:     hr = Direct3D_GetDevice()->CreateBuffer(&bd, nullptr, &g_pDynamicVertexBuffer);
 80:     if (FAILED(hr)) return false;
 81:     return true;
 82: }
 83: void ShaderParticle_Finalize()
 84: {
 85: 	SAFE_RELEASE(g_pVertexShader);
 86: 	SAFE_RELEASE(g_pPixelShader);
 87: 	SAFE_RELEASE(g_pInputLayout);
 88: 	SAFE_RELEASE(g_pConstantBuffer);
 89: 	SAFE_RELEASE(g_pDynamicVertexBuffer);
 90: }
 91: void ShaderParticle_SetWorldMatrix(const XMMATRIX& world) { g_WorldMatrix = world; }
 92: void ShaderParticle_SetViewMatrix(const XMMATRIX& view) { g_ViewMatrix = view; }
 93: void ShaderParticle_SetProjectionMatrix(const XMMATRIX& projection) { g_ProjectionMatrix = projection; }
 94: void ShaderParticle_Begin()
 95: {
 96:     if (!Direct3D_GetContext()) return;
 97:     // 1. 定数バッファの更新 (CPU -> GPU)
 98:     CB_Matrix data;
 99:     XMStoreFloat4x4(&data.World, XMMatrixTranspose(g_WorldMatrix));
100:     XMStoreFloat4x4(&data.View, XMMatrixTranspose(g_ViewMatrix));
101:     XMStoreFloat4x4(&data.Projection, XMMatrixTranspose(g_ProjectionMatrix));
102:     Direct3D_GetContext()->UpdateSubresource(g_pConstantBuffer, 0, nullptr, &data, 0, 0);
103:     // 2. シェーダーの設定
104:     Direct3D_GetContext()->VSSetShader(g_pVertexShader, nullptr, 0);
105:     Direct3D_GetContext()->PSSetShader(g_pPixelShader, nullptr, 0);
106:     // 3. 入力レイアウトの設定 (Particle専用)
107:     Direct3D_GetContext()->IASetInputLayout(g_pInputLayout);
108:     // 4. 定数バッファの設定 (Vertex Shader b0)
109:     Direct3D_GetContext()->VSSetConstantBuffers(0, 1, &g_pConstantBuffer);
110:     // 5. サンプラーの設定 (もし画像を使うなら必要)
111:     Sampler_SetFilterLinear();
112: }
113: void ShaderParticle_DrawBatch(const std::vector<VertexParticle>& vertices, int texID)
114: {
115:     if (vertices.empty()) return;
116:     if (!Direct3D_GetContext()) return;
117:     ID3D11ShaderResourceView* pSRV = Texture_GetSRV(texID);
118:     Direct3D_GetContext()->PSSetShaderResources(0, 1, &pSRV);
119:     D3D11_MAPPED_SUBRESOURCE msr;
120:     Direct3D_GetContext()->Map(g_pDynamicVertexBuffer, 0, D3D11_MAP_WRITE_DISCARD, 0, &msr);//  D3D11_MAP_WRITE_NO_OVERWRITE 
121:     VertexParticle* dataDest = (VertexParticle*)msr.pData;
122:     size_t copySize = vertices.size() * sizeof(VertexParticle);
123:     memcpy(dataDest, vertices.data(), copySize);
124:     Direct3D_GetContext()->Unmap(g_pDynamicVertexBuffer, 0);
125:     UINT stride = sizeof(VertexParticle);
126:     UINT offset = 0;
127:     Direct3D_GetContext()->IASetVertexBuffers(0, 1, &g_pDynamicVertexBuffer, &stride, &offset);
128:     Direct3D_GetContext()->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
129:     Direct3D_GetContext()->Draw((UINT)vertices.size(), 0);
130: }
</file>

