1943: // Enum for ImGui::TableSetBgColor()
1944: // Background colors are rendering in 3 layers:
1945: //  - Layer 0: draw with RowBg0 color if set, otherwise draw with ColumnBg0 if set.
1946: //  - Layer 1: draw with RowBg1 color if set, otherwise draw with ColumnBg1 if set.
1947: //  - Layer 2: draw with CellBg color if set.
1948: // The purpose of the two row/columns layers is to let you decide if a background color change should override or blend with the existing color.
1949: // When using ImGuiTableFlags_RowBg on the table, each row has the RowBg0 color automatically set for odd/even rows.
1950: // If you set the color of RowBg0 target, your color will override the existing RowBg0 color.
1951: // If you set the color of RowBg1 or ColumnBg1 target, your color will blend over the RowBg0 color.
1952: enum ImGuiTableBgTarget_
1953: {
1954:     ImGuiTableBgTarget_None                     = 0,
1955:     ImGuiTableBgTarget_RowBg0                   = 1,        // Set row background color 0 (generally used for background, automatically set when ImGuiTableFlags_RowBg is used)
1956:     ImGuiTableBgTarget_RowBg1                   = 2,        // Set row background color 1 (generally used for selection marking)
1957:     ImGuiTableBgTarget_CellBg                   = 3,        // Set cell background color (top-most color)
1958: };
1959: // Sorting specifications for a table (often handling sort specs for a single column, occasionally more)
1960: // Obtained by calling TableGetSortSpecs().
1961: // When 'SpecsDirty == true' you can sort your data. It will be true with sorting specs have changed since last call, or the first time.
1962: // Make sure to set 'SpecsDirty = false' after sorting, else you may wastefully sort your data every frame!
1963: struct ImGuiTableSortSpecs
1964: {
1965:     const ImGuiTableColumnSortSpecs* Specs;     // Pointer to sort spec array.
1966:     int                         SpecsCount;     // Sort spec count. Most often 1. May be > 1 when ImGuiTableFlags_SortMulti is enabled. May be == 0 when ImGuiTableFlags_SortTristate is enabled.
1967:     bool                        SpecsDirty;     // Set to true when specs have changed since last time! Use this to sort again, then clear the flag.
1968:     ImGuiTableSortSpecs()       { memset(this, 0, sizeof(*this)); }
1969: };
1970: // Sorting specification for one column of a table (sizeof == 12 bytes)
1971: struct ImGuiTableColumnSortSpecs
1972: {
1973:     ImGuiID                     ColumnUserID;       // User id of the column (if specified by a TableSetupColumn() call)
1974:     ImS16                       ColumnIndex;        // Index of the column
1975:     ImS16                       SortOrder;          // Index within parent ImGuiTableSortSpecs (always stored in order starting from 0, tables sorted on a single criteria will always have a 0 here)
1976:     ImGuiSortDirection          SortDirection;      // ImGuiSortDirection_Ascending or ImGuiSortDirection_Descending
1977:     ImGuiTableColumnSortSpecs() { memset(this, 0, sizeof(*this)); }
1978: };
