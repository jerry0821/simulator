5996: bool ImGui::TreeNodeUpdateNextOpen(ImGuiID storage_id, ImGuiTreeNodeFlags flags)
5997: {
5998:     if (flags & ImGuiTreeNodeFlags_Leaf)
5999:         return true;
6000:     // We only write to the tree storage if the user clicks, or explicitly use the SetNextItemOpen function
6001:     ImGuiContext& g = *GImGui;
6002:     ImGuiWindow* window = g.CurrentWindow;
6003:     ImGuiStorage* storage = window->DC.StateStorage;
6004:     bool is_open;
6005:     if (g.NextItemData.HasFlags & ImGuiNextItemDataFlags_HasOpen)
6006:     {
6007:         if (g.NextItemData.OpenCond & ImGuiCond_Always)
6008:         {
6009:             is_open = g.NextItemData.OpenVal;
6010:             TreeNodeSetOpen(storage_id, is_open);
6011:         }
6012:         else
6013:         {
6014:             // We treat ImGuiCond_Once and ImGuiCond_FirstUseEver the same because tree node state are not saved persistently.
6015:             const int stored_value = storage->GetInt(storage_id, -1);
6016:             if (stored_value == -1)
6017:             {
6018:                 is_open = g.NextItemData.OpenVal;
6019:                 TreeNodeSetOpen(storage_id, is_open);
6020:             }
6021:             else
6022:             {
6023:                 is_open = stored_value != 0;
6024:             }
6025:         }
6026:     }
6027:     else
6028:     {
6029:         is_open = storage->GetInt(storage_id, (flags & ImGuiTreeNodeFlags_DefaultOpen) ? 1 : 0) != 0;
6030:     }
6031:     // When logging is enabled, we automatically expand tree nodes (but *NOT* collapsing headers.. seems like sensible behavior).
6032:     // NB- If we are above max depth we still allow manually opened nodes to be logged.
6033:     if (g.LogEnabled && !(flags & ImGuiTreeNodeFlags_NoAutoOpenOnLog) && (window->DC.TreeDepth - g.LogDepthRef) < g.LogDepthToExpand)
6034:         is_open = true;
6035:     return is_open;
6036: }
6037: // Store ImGuiTreeNodeStackData for just submitted node.
6038: // Currently only supports 32 level deep and we are fine with (1 << Depth) overflowing into a zero, easy to increase.
6039: static void TreeNodeStoreStackData(ImGuiTreeNodeFlags flags, float x1)
6040: {
6041:     ImGuiContext& g = *GImGui;
6042:     ImGuiWindow* window = g.CurrentWindow;
6043:     g.TreeNodeStack.resize(g.TreeNodeStack.Size + 1);
6044:     ImGuiTreeNodeStackData* tree_node_data = &g.TreeNodeStack.Data[g.TreeNodeStack.Size - 1];
6045:     tree_node_data->ID = g.LastItemData.ID;
6046:     tree_node_data->TreeFlags = flags;
6047:     tree_node_data->ItemFlags = g.LastItemData.ItemFlags;
6048:     tree_node_data->NavRect = g.LastItemData.NavRect;
6049:     // Initially I tried to latch value for GetColorU32(ImGuiCol_TreeLines) but it's not a good trade-off for very large trees.
6050:     const bool draw_lines = (flags & (ImGuiTreeNodeFlags_DrawLinesFull | ImGuiTreeNodeFlags_DrawLinesToNodes)) != 0;
6051:     tree_node_data->DrawLinesX1 = draw_lines ? (x1 + g.FontSize * 0.5f + g.Style.FramePadding.x) : +FLT_MAX;
6052:     tree_node_data->DrawLinesTableColumn = (draw_lines && g.CurrentTable) ? (ImGuiTableColumnIdx)g.CurrentTable->CurrentColumn : -1;
6053:     tree_node_data->DrawLinesToNodesY2 = -FLT_MAX;
6054:     window->DC.TreeHasStackDataDepthMask |= (1 << window->DC.TreeDepth);
6055:     if (flags & ImGuiTreeNodeFlags_DrawLinesToNodes)
6056:         window->DC.TreeRecordsClippedNodesY2Mask |= (1 << window->DC.TreeDepth);
6057: }
6058: bool ImGui::TreeNodeBehavior(ImGuiID id, ImGuiTreeNodeFlags flags, const char* label, const char* label_end)
6059: {
6060:     ImGuiWindow* window = GetCurrentWindow();
6061:     if (window->SkipItems)
6062:         return false;
6063:     ImGuiContext& g = *GImGui;
6064:     const ImGuiStyle& style = g.Style;
6065:     // When not framed, we vertically increase height up to typical framed widget height
6066:     const bool display_frame = (flags & ImGuiTreeNodeFlags_Framed) != 0;
6067:     const bool use_frame_padding = (display_frame || (flags & ImGuiTreeNodeFlags_FramePadding));
6068:     const ImVec2 padding = use_frame_padding ? style.FramePadding : ImVec2(style.FramePadding.x, ImMin(window->DC.CurrLineTextBaseOffset, style.FramePadding.y));
6069:     if (!label_end)
6070:         label_end = FindRenderedTextEnd(label);
6071:     const ImVec2 label_size = CalcTextSize(label, label_end, false);
6072:     const float text_offset_x = g.FontSize + (display_frame ? padding.x * 3 : padding.x * 2);   // Collapsing arrow width + Spacing
6073:     const float text_offset_y = use_frame_padding ? ImMax(style.FramePadding.y, window->DC.CurrLineTextBaseOffset) : window->DC.CurrLineTextBaseOffset; // Latch before ItemSize changes it
6074:     const float text_width = g.FontSize + label_size.x + padding.x * 2;                         // Include collapsing arrow
6075:     const float frame_height = label_size.y + padding.y * 2;
6076:     const bool span_all_columns = (flags & ImGuiTreeNodeFlags_SpanAllColumns) != 0 && (g.CurrentTable != NULL);
6077:     const bool span_all_columns_label = (flags & ImGuiTreeNodeFlags_LabelSpanAllColumns) != 0 && (g.CurrentTable != NULL);
6078:     ImRect frame_bb;
6079:     frame_bb.Min.x = span_all_columns ? window->ParentWorkRect.Min.x : (flags & ImGuiTreeNodeFlags_SpanFullWidth) ? window->WorkRect.Min.x : window->DC.CursorPos.x;
6080:     frame_bb.Min.y = window->DC.CursorPos.y + (text_offset_y - padding.y);
6081:     frame_bb.Max.x = span_all_columns ? window->ParentWorkRect.Max.x : (flags & ImGuiTreeNodeFlags_SpanLabelWidth) ? window->DC.CursorPos.x + text_width + padding.x : window->WorkRect.Max.x;
6082:     frame_bb.Max.y = window->DC.CursorPos.y + (text_offset_y - padding.y) + frame_height;
6083:     if (display_frame)
6084:     {
6085:         const float outer_extend = IM_TRUNC(window->WindowPadding.x * 0.5f); // Framed header expand a little outside of current limits
6086:         frame_bb.Min.x -= outer_extend;
6087:         frame_bb.Max.x += outer_extend;
6088:     }
6089:     ImVec2 text_pos(window->DC.CursorPos.x + text_offset_x, window->DC.CursorPos.y + text_offset_y);
6090:     ItemSize(ImVec2(text_width, frame_height), padding.y);
6091:     // For regular tree nodes, we arbitrary allow to click past 2 worth of ItemSpacing
6092:     ImRect interact_bb = frame_bb;
6093:     if ((flags & (ImGuiTreeNodeFlags_Framed | ImGuiTreeNodeFlags_SpanAvailWidth | ImGuiTreeNodeFlags_SpanFullWidth | ImGuiTreeNodeFlags_SpanLabelWidth | ImGuiTreeNodeFlags_SpanAllColumns)) == 0)
6094:         interact_bb.Max.x = frame_bb.Min.x + text_width + (label_size.x > 0.0f ? style.ItemSpacing.x * 2.0f : 0.0f);
6095:     // Compute open and multi-select states before ItemAdd() as it clear NextItem data.
6096:     ImGuiID storage_id = (g.NextItemData.HasFlags & ImGuiNextItemDataFlags_HasStorageID) ? g.NextItemData.StorageId : id;
6097:     bool is_open = TreeNodeUpdateNextOpen(storage_id, flags);
6098:     bool is_visible;
6099:     if (span_all_columns || span_all_columns_label)
6100:     {
6101:         // Modify ClipRect for the ItemAdd(), faster than doing a PushColumnsBackground/PushTableBackgroundChannel for every Selectable..
6102:         const float backup_clip_rect_min_x = window->ClipRect.Min.x;
6103:         const float backup_clip_rect_max_x = window->ClipRect.Max.x;
6104:         window->ClipRect.Min.x = window->ParentWorkRect.Min.x;
6105:         window->ClipRect.Max.x = window->ParentWorkRect.Max.x;
6106:         is_visible = ItemAdd(interact_bb, id);
6107:         window->ClipRect.Min.x = backup_clip_rect_min_x;
6108:         window->ClipRect.Max.x = backup_clip_rect_max_x;
6109:     }
6110:     else
6111:     {
6112:         is_visible = ItemAdd(interact_bb, id);
6113:     }
6114:     g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_HasDisplayRect;
6115:     g.LastItemData.DisplayRect = frame_bb;
6116:     // If a NavLeft request is happening and ImGuiTreeNodeFlags_NavLeftJumpsToParent enabled:
6117:     // Store data for the current depth to allow returning to this node from any child item.
6118:     // For this purpose we essentially compare if g.NavIdIsAlive went from 0 to 1 between TreeNode() and TreePop().
6119:     // It will become tempting to enable ImGuiTreeNodeFlags_NavLeftJumpsToParent by default or move it to ImGuiStyle.
6120:     bool store_tree_node_stack_data = false;
6121:     if ((flags & ImGuiTreeNodeFlags_DrawLinesMask_) == 0)
6122:         flags |= g.Style.TreeLinesFlags;
6123:     const bool draw_tree_lines = (flags & (ImGuiTreeNodeFlags_DrawLinesFull | ImGuiTreeNodeFlags_DrawLinesToNodes)) && (frame_bb.Min.y < window->ClipRect.Max.y) && (g.Style.TreeLinesSize > 0.0f);
6124:     if (!(flags & ImGuiTreeNodeFlags_NoTreePushOnOpen))
6125:     {
6126:         store_tree_node_stack_data = draw_tree_lines;
6127:         if ((flags & ImGuiTreeNodeFlags_NavLeftJumpsToParent) && !g.NavIdIsAlive)
6128:             if (g.NavMoveDir == ImGuiDir_Left && g.NavWindow == window && NavMoveRequestButNoResultYet())
6129:                 store_tree_node_stack_data = true;
6130:     }
6131:     const bool is_leaf = (flags & ImGuiTreeNodeFlags_Leaf) != 0;
6132:     if (!is_visible)
6133:     {
6134:         if ((flags & ImGuiTreeNodeFlags_DrawLinesToNodes) && (window->DC.TreeRecordsClippedNodesY2Mask & (1 << (window->DC.TreeDepth - 1))))
6135:         {
6136:             ImGuiTreeNodeStackData* parent_data = &g.TreeNodeStack.Data[g.TreeNodeStack.Size - 1];
6137:             parent_data->DrawLinesToNodesY2 = ImMax(parent_data->DrawLinesToNodesY2, window->DC.CursorPos.y); // Don't need to aim to mid Y position as we are clipped anyway.
6138:             if (frame_bb.Min.y >= window->ClipRect.Max.y)
6139:                 window->DC.TreeRecordsClippedNodesY2Mask &= ~(1 << (window->DC.TreeDepth - 1)); // Done
6140:         }
6141:         if (is_open && store_tree_node_stack_data)
6142:             TreeNodeStoreStackData(flags, text_pos.x - text_offset_x); // Call before TreePushOverrideID()
6143:         if (is_open && !(flags & ImGuiTreeNodeFlags_NoTreePushOnOpen))
6144:             TreePushOverrideID(id);
6145:         IMGUI_TEST_ENGINE_ITEM_INFO(g.LastItemData.ID, label, g.LastItemData.StatusFlags | (is_leaf ? 0 : ImGuiItemStatusFlags_Openable) | (is_open ? ImGuiItemStatusFlags_Opened : 0));
6146:         return is_open;
6147:     }
6148:     if (span_all_columns || span_all_columns_label)
6149:     {
6150:         TablePushBackgroundChannel();
6151:         g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_HasClipRect;
6152:         g.LastItemData.ClipRect = window->ClipRect;
6153:     }
6154:     ImGuiButtonFlags button_flags = ImGuiTreeNodeFlags_None;
6155:     if ((flags & ImGuiTreeNodeFlags_AllowOverlap) || (g.LastItemData.ItemFlags & ImGuiItemFlags_AllowOverlap))
6156:         button_flags |= ImGuiButtonFlags_AllowOverlap;
6157:     if (!is_leaf)
6158:         button_flags |= ImGuiButtonFlags_PressedOnDragDropHold;
6159:     // We allow clicking on the arrow section with keyboard modifiers held, in order to easily
6160:     // allow browsing a tree while preserving selection with code implementing multi-selection patterns.
6161:     // When clicking on the rest of the tree node we always disallow keyboard modifiers.
6162:     const float arrow_hit_x1 = (text_pos.x - text_offset_x) - style.TouchExtraPadding.x;
6163:     const float arrow_hit_x2 = (text_pos.x - text_offset_x) + (g.FontSize + padding.x * 2.0f) + style.TouchExtraPadding.x;
6164:     const bool is_mouse_x_over_arrow = (g.IO.MousePos.x >= arrow_hit_x1 && g.IO.MousePos.x < arrow_hit_x2);
6165:     const bool is_multi_select = (g.LastItemData.ItemFlags & ImGuiItemFlags_IsMultiSelect) != 0;
6166:     if (is_multi_select) // We absolutely need to distinguish open vs select so _OpenOnArrow comes by default
6167:         flags |= (flags & ImGuiTreeNodeFlags_OpenOnMask_) == 0 ? ImGuiTreeNodeFlags_OpenOnArrow | ImGuiTreeNodeFlags_OpenOnDoubleClick : ImGuiTreeNodeFlags_OpenOnArrow;
6168:     // Open behaviors can be altered with the _OpenOnArrow and _OnOnDoubleClick flags.
6169:     // Some alteration have subtle effects (e.g. toggle on MouseUp vs MouseDown events) due to requirements for multi-selection and drag and drop support.
6170:     // - Single-click on label = Toggle on MouseUp (default, when _OpenOnArrow=0)
6171:     // - Single-click on arrow = Toggle on MouseDown (when _OpenOnArrow=0)
6172:     // - Single-click on arrow = Toggle on MouseDown (when _OpenOnArrow=1)
6173:     // - Double-click on label = Toggle on MouseDoubleClick (when _OpenOnDoubleClick=1)
6174:     // - Double-click on arrow = Toggle on MouseDoubleClick (when _OpenOnDoubleClick=1 and _OpenOnArrow=0)
6175:     // It is rather standard that arrow click react on Down rather than Up.
6176:     // We set ImGuiButtonFlags_PressedOnClickRelease on OpenOnDoubleClick because we want the item to be active on the initial MouseDown in order for drag and drop to work.
6177:     if (is_mouse_x_over_arrow)
6178:         button_flags |= ImGuiButtonFlags_PressedOnClick;
6179:     else if (flags & ImGuiTreeNodeFlags_OpenOnDoubleClick)
6180:         button_flags |= ImGuiButtonFlags_PressedOnClickRelease | ImGuiButtonFlags_PressedOnDoubleClick;
6181:     else
6182:         button_flags |= ImGuiButtonFlags_PressedOnClickRelease;
6183:     if (flags & ImGuiTreeNodeFlags_NoNavFocus)
6184:         button_flags |= ImGuiButtonFlags_NoNavFocus;
6185:     bool selected = (flags & ImGuiTreeNodeFlags_Selected) != 0;
6186:     const bool was_selected = selected;
6187:     // Multi-selection support (header)
6188:     if (is_multi_select)
6189:     {
6190:         // Handle multi-select + alter button flags for it
6191:         MultiSelectItemHeader(id, &selected, &button_flags);
6192:         if (is_mouse_x_over_arrow)
6193:             button_flags = (button_flags | ImGuiButtonFlags_PressedOnClick) & ~ImGuiButtonFlags_PressedOnClickRelease;
6194:     }
6195:     else
6196:     {
6197:         if (window != g.HoveredWindow || !is_mouse_x_over_arrow)
6198:             button_flags |= ImGuiButtonFlags_NoKeyModsAllowed;
6199:     }
6200:     bool hovered, held;
6201:     bool pressed = ButtonBehavior(interact_bb, id, &hovered, &held, button_flags);
6202:     bool toggled = false;
6203:     if (!is_leaf)
6204:     {
6205:         if (pressed && g.DragDropHoldJustPressedId != id)
6206:         {
6207:             if ((flags & ImGuiTreeNodeFlags_OpenOnMask_) == 0 || (g.NavActivateId == id && !is_multi_select))
6208:                 toggled = true; // Single click
6209:             if (flags & ImGuiTreeNodeFlags_OpenOnArrow)
6210:                 toggled |= is_mouse_x_over_arrow && !g.NavHighlightItemUnderNav; // Lightweight equivalent of IsMouseHoveringRect() since ButtonBehavior() already did the job
6211:             if ((flags & ImGuiTreeNodeFlags_OpenOnDoubleClick) && g.IO.MouseClickedCount[0] == 2)
6212:                 toggled = true; // Double click
6213:         }
6214:         else if (pressed && g.DragDropHoldJustPressedId == id)
6215:         {
6216:             IM_ASSERT(button_flags & ImGuiButtonFlags_PressedOnDragDropHold);
6217:             if (!is_open) // When using Drag and Drop "hold to open" we keep the node highlighted after opening, but never close it again.
6218:                 toggled = true;
6219:             else
6220:                 pressed = false; // Cancel press so it doesn't trigger selection.
6221:         }
6222:         if (g.NavId == id && g.NavMoveDir == ImGuiDir_Left && is_open)
6223:         {
6224:             toggled = true;
6225:             NavClearPreferredPosForAxis(ImGuiAxis_X);
6226:             NavMoveRequestCancel();
6227:         }
6228:         if (g.NavId == id && g.NavMoveDir == ImGuiDir_Right && !is_open) // If there's something upcoming on the line we may want to give it the priority?
6229:         {
6230:             toggled = true;
6231:             NavClearPreferredPosForAxis(ImGuiAxis_X);
6232:             NavMoveRequestCancel();
6233:         }
6234:         if (toggled)
6235:         {
6236:             is_open = !is_open;
6237:             window->DC.StateStorage->SetInt(storage_id, is_open);
6238:             g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_ToggledOpen;
6239:         }
6240:     }
6241:     // Multi-selection support (footer)
6242:     if (is_multi_select)
6243:     {
6244:         bool pressed_copy = pressed && !toggled;
6245:         MultiSelectItemFooter(id, &selected, &pressed_copy);
6246:         if (pressed)
6247:             SetNavID(id, window->DC.NavLayerCurrent, g.CurrentFocusScopeId, interact_bb);
6248:     }
6249:     if (selected != was_selected)
6250:         g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_ToggledSelection;
6251:     // Render
6252:     {
6253:         const ImU32 text_col = GetColorU32(ImGuiCol_Text);
6254:         ImGuiNavRenderCursorFlags nav_render_cursor_flags = ImGuiNavRenderCursorFlags_Compact;
6255:         if (is_multi_select)
6256:             nav_render_cursor_flags |= ImGuiNavRenderCursorFlags_AlwaysDraw; // Always show the nav rectangle
6257:         if (display_frame)
6258:         {
6259:             // Framed type
6260:             const ImU32 bg_col = GetColorU32((held && hovered) ? ImGuiCol_HeaderActive : hovered ? ImGuiCol_HeaderHovered : ImGuiCol_Header);
6261:             RenderFrame(frame_bb.Min, frame_bb.Max, bg_col, true, style.FrameRounding);
6262:             RenderNavCursor(frame_bb, id, nav_render_cursor_flags);
6263:             if (span_all_columns && !span_all_columns_label)
6264:                 TablePopBackgroundChannel();
6265:             if (flags & ImGuiTreeNodeFlags_Bullet)
6266:                 RenderBullet(window->DrawList, ImVec2(text_pos.x - text_offset_x * 0.60f, text_pos.y + g.FontSize * 0.5f), text_col);
6267:             else if (!is_leaf)
6268:                 RenderArrow(window->DrawList, ImVec2(text_pos.x - text_offset_x + padding.x, text_pos.y), text_col, is_open ? ((flags & ImGuiTreeNodeFlags_UpsideDownArrow) ? ImGuiDir_Up : ImGuiDir_Down) : ImGuiDir_Right, 1.0f);
6269:             else // Leaf without bullet, left-adjusted text
6270:                 text_pos.x -= text_offset_x - padding.x;
6271:             if (flags & ImGuiTreeNodeFlags_ClipLabelForTrailingButton)
6272:                 frame_bb.Max.x -= g.FontSize + style.FramePadding.x;
6273:             if (g.LogEnabled)
6274:                 LogSetNextTextDecoration("###", "###");
6275:         }
6276:         else
6277:         {
6278:             // Unframed typed for tree nodes
6279:             if (hovered || selected)
6280:             {
6281:                 const ImU32 bg_col = GetColorU32((held && hovered) ? ImGuiCol_HeaderActive : hovered ? ImGuiCol_HeaderHovered : ImGuiCol_Header);
6282:                 RenderFrame(frame_bb.Min, frame_bb.Max, bg_col, false);
6283:             }
6284:             RenderNavCursor(frame_bb, id, nav_render_cursor_flags);
6285:             if (span_all_columns && !span_all_columns_label)
6286:                 TablePopBackgroundChannel();
6287:             if (flags & ImGuiTreeNodeFlags_Bullet)
6288:                 RenderBullet(window->DrawList, ImVec2(text_pos.x - text_offset_x * 0.5f, text_pos.y + g.FontSize * 0.5f), text_col);
6289:             else if (!is_leaf)
6290:                 RenderArrow(window->DrawList, ImVec2(text_pos.x - text_offset_x + padding.x, text_pos.y + g.FontSize * 0.15f), text_col, is_open ? ((flags & ImGuiTreeNodeFlags_UpsideDownArrow) ? ImGuiDir_Up : ImGuiDir_Down) : ImGuiDir_Right, 0.70f);
6291:             if (g.LogEnabled)
6292:                 LogSetNextTextDecoration(">", NULL);
6293:         }
6294:         if (draw_tree_lines)
6295:             TreeNodeDrawLineToChildNode(ImVec2(text_pos.x - text_offset_x + padding.x, text_pos.y + g.FontSize * 0.5f));
6296:         // Label
6297:         if (display_frame)
6298:             RenderTextClipped(text_pos, frame_bb.Max, label, label_end, &label_size);
6299:         else
6300:             RenderText(text_pos, label, label_end, false);
6301:         if (span_all_columns_label)
6302:             TablePopBackgroundChannel();
6303:     }
6304:     if (is_open && store_tree_node_stack_data)
6305:         TreeNodeStoreStackData(flags, text_pos.x - text_offset_x); // Call before TreePushOverrideID()
6306:     if (is_open && !(flags & ImGuiTreeNodeFlags_NoTreePushOnOpen))
6307:         TreePushOverrideID(id); // Could use TreePush(label) but this avoid computing twice
6308:     IMGUI_TEST_ENGINE_ITEM_INFO(id, label, g.LastItemData.StatusFlags | (is_leaf ? 0 : ImGuiItemStatusFlags_Openable) | (is_open ? ImGuiItemStatusFlags_Opened : 0));
6309:     return is_open;
6310: }
6311: // Draw horizontal line from our parent node
6312: // This is only called for visible child nodes so we are not too fussy anymore about performances
6313: void ImGui::TreeNodeDrawLineToChildNode(const ImVec2& target_pos)
6314: {
6315:     ImGuiContext& g = *GImGui;
6316:     ImGuiWindow* window = g.CurrentWindow;
6317:     if (window->DC.TreeDepth == 0 || (window->DC.TreeHasStackDataDepthMask & (1 << (window->DC.TreeDepth - 1))) == 0)
6318:         return;
6319:     ImGuiTreeNodeStackData* parent_data = &g.TreeNodeStack.Data[g.TreeNodeStack.Size - 1];
6320:     float x1 = ImTrunc(parent_data->DrawLinesX1);
6321:     float x2 = ImTrunc(target_pos.x - g.Style.ItemInnerSpacing.x);
6322:     float y = ImTrunc(target_pos.y);
6323:     float rounding = (g.Style.TreeLinesRounding > 0.0f) ? ImMin(x2 - x1, g.Style.TreeLinesRounding) : 0.0f;
6324:     parent_data->DrawLinesToNodesY2 = ImMax(parent_data->DrawLinesToNodesY2, y - rounding);
6325:     if (x1 >= x2)
6326:         return;
6327:     if (rounding > 0.0f)
6328:     {
6329:         x1 += 0.5f + rounding;
6330:         window->DrawList->PathArcToFast(ImVec2(x1, y - rounding), rounding, 6, 3);
6331:         if (x1 < x2)
6332:             window->DrawList->PathLineTo(ImVec2(x2, y));
6333:         window->DrawList->PathStroke(GetColorU32(ImGuiCol_TreeLines), ImDrawFlags_None, g.Style.TreeLinesSize);
6334:     }
6335:     else
6336:     {
6337:         window->DrawList->AddLine(ImVec2(x1, y), ImVec2(x2, y), GetColorU32(ImGuiCol_TreeLines), g.Style.TreeLinesSize);
6338:     }
6339: }
6340: // Draw vertical line of the hierarchy
6341: void ImGui::TreeNodeDrawLineToTreePop(const ImGuiTreeNodeStackData* data)
6342: {
6343:     ImGuiContext& g = *GImGui;
6344:     ImGuiWindow* window = g.CurrentWindow;
6345:     float y1 = ImMax(data->NavRect.Max.y, window->ClipRect.Min.y);
6346:     float y2 = data->DrawLinesToNodesY2;
6347:     if (data->TreeFlags & ImGuiTreeNodeFlags_DrawLinesFull)
6348:     {
6349:         float y2_full = window->DC.CursorPos.y;
6350:         if (g.CurrentTable)
6351:             y2_full = ImMax(g.CurrentTable->RowPosY2, y2_full);
6352:         y2_full = ImTrunc(y2_full - g.Style.ItemSpacing.y - g.FontSize * 0.5f);
6353:         if (y2 + (g.Style.ItemSpacing.y + g.Style.TreeLinesRounding) < y2_full) // FIXME: threshold to use ToNodes Y2 instead of Full Y2 when close by ItemSpacing.y
6354:             y2 = y2_full;
6355:     }
6356:     y2 = ImMin(y2, window->ClipRect.Max.y);
6357:     if (y2 <= y1)
6358:         return;
6359:     float x = ImTrunc(data->DrawLinesX1);
6360:     if (data->DrawLinesTableColumn != -1)
6361:         TablePushColumnChannel(data->DrawLinesTableColumn);
6362:     window->DrawList->AddLine(ImVec2(x, y1), ImVec2(x, y2), GetColorU32(ImGuiCol_TreeLines), g.Style.TreeLinesSize);
6363:     if (data->DrawLinesTableColumn != -1)
6364:         TablePopColumnChannel();
6365: }
