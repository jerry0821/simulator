13386: void ImGui::RenderDragDropTargetRectForItem(const ImRect& bb)
13387: {
13388:     ImGuiContext& g = *GImGui;
13389:     ImGuiWindow* window = g.CurrentWindow;
13390:     ImRect bb_display = bb;
13391:     bb_display.ClipWith(g.DragDropTargetClipRect); // Clip THEN expand so we have a way to visualize that target is not entirely visible.
13392:     bb_display.Expand(g.Style.DragDropTargetPadding);
13393:     bool push_clip_rect = !window->ClipRect.Contains(bb_display);
13394:     if (push_clip_rect)
13395:         window->DrawList->PushClipRectFullScreen();
13396:     RenderDragDropTargetRectEx(window->DrawList, bb_display);
13397:     if (push_clip_rect)
13398:         window->DrawList->PopClipRect();
13399: }
