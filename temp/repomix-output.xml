5124:         flags |= (g.ColorEditOptions & ImGuiColorEditFlags_PickerMask_);
5125:     if (!(flags & ImGuiColorEditFlags_InputMask_))
5126:         flags |= (g.ColorEditOptions & ImGuiColorEditFlags_InputMask_);
5127:     flags |= (g.ColorEditOptions & ~(ImGuiColorEditFlags_DisplayMask_ | ImGuiColorEditFlags_DataTypeMask_ | ImGuiColorEditFlags_PickerMask_ | ImGuiColorEditFlags_InputMask_));
5128:     IM_ASSERT(ImIsPowerOfTwo(flags & ImGuiColorEditFlags_DisplayMask_)); // Check that only 1 is selected
5129:     IM_ASSERT(ImIsPowerOfTwo(flags & ImGuiColorEditFlags_InputMask_));   // Check that only 1 is selected
5130:     const bool alpha = (flags & ImGuiColorEditFlags_NoAlpha) == 0;
5131:     const bool hdr = (flags & ImGuiColorEditFlags_HDR) != 0;
5132:     const int components = alpha ? 4 : 3;
5133:     const float w_button = (flags & ImGuiColorEditFlags_NoSmallPreview) ? 0.0f : (square_sz + style.ItemInnerSpacing.x);
