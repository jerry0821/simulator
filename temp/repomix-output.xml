<file path="cylinder.cpp">
  1: #include "cylinder.h"
  2: #include "direct3d.h"
  3: #include "shader3d.h"
  4: #include "texture.h"
  5: #include <cmath>
  6: #include <vector>
  7: using namespace DirectX;
  8: struct Vertex3D {
  9:   XMFLOAT3 position;
 10:   XMFLOAT3 normal;
 11:   XMFLOAT4 color;
 12:   XMFLOAT2 texcoord;
 13: };
 14: static ID3D11Buffer *g_pVertexBuffer = nullptr;
 15: static ID3D11Buffer *g_pIndexBuffer = nullptr;
 16: static int g_IndexCount = 0;
 17: static ID3D11Device *g_pDevice = nullptr;
 18: static ID3D11DeviceContext *g_pContext = nullptr;
 19: void Cylinder_Initialize(ID3D11Device *pDevice, ID3D11DeviceContext *pContext) {
 20:   g_pDevice = pDevice;
 21:   g_pContext = pContext;
 22:   int slices = 32;
 23:   float radius = 0.5f;
 24:   float halfHeight = 0.5f;
 25:   std::vector<Vertex3D> vertices;
 26:   std::vector<unsigned short> indices;
 27:   // Body vertices
 28:   for (int i = 0; i <= slices; ++i) {
 29:     float u = (float)i / slices;
 30:     float theta = u * XM_2PI;
 31:     float c = cosf(theta);
 32:     float s = sinf(theta);
 33:     // Top vertex representing top edge
 34:     vertices.push_back({{radius * c, halfHeight, radius * s},
 35:                         {c, 0, s},
 36:                         {1, 1, 1, 1},
 37:                         {u, 0.0f}});
 38:     // Bottom vertex representing bottom edge
 39:     vertices.push_back({{radius * c, -halfHeight, radius * s},
 40:                         {c, 0, s},
 41:                         {1, 1, 1, 1},
 42:                         {u, 1.0f}});
 43:   }
 44:   // Body indices
 45:   for (int i = 0; i < slices; ++i) {
 46:     unsigned short top = i * 2;
 47:     unsigned short bottom = i * 2 + 1;
 48:     unsigned short nextTop = (i + 1) * 2;
 49:     unsigned short nextBottom = (i + 1) * 2 + 1;
 50:     indices.push_back(top);
 51:     indices.push_back(nextTop);
 52:     indices.push_back(bottom);
 53:     indices.push_back(nextTop);
 54:     indices.push_back(nextBottom);
 55:     indices.push_back(bottom);
 56:   }
 57:   // Caps
 58:   int baseIndex = (int)vertices.size();
 59:   // Top Cap Center
 60:   vertices.push_back(
 61:       {{0, halfHeight, 0}, {0, 1, 0}, {1, 1, 1, 1}, {0.5f, 0.5f}});
 62:   unsigned short topCenter = baseIndex;
 63:   baseIndex++;
 64:   for (int i = 0; i <= slices; ++i) {
 65:     float theta = ((float)i / slices) * XM_2PI;
 66:     float c = cosf(theta);
 67:     float s = sinf(theta);
 68:     float u = c * 0.5f + 0.5f;
 69:     float v = s * 0.5f + 0.5f;
 70:     vertices.push_back({{radius * c, halfHeight, radius * s},
 71:                         {0, 1, 0},
 72:                         {1, 1, 1, 1},
 73:                         {u, v}});
 74:   }
 75:   for (int i = 0; i < slices; ++i) {
 76:     indices.push_back(topCenter);
 77:     indices.push_back(baseIndex + i + 1);
 78:     indices.push_back(baseIndex + i);
 79:   }
 80:   baseIndex += slices + 1;
 81:   // Bottom Cap Center
 82:   vertices.push_back(
 83:       {{0, -halfHeight, 0}, {0, -1, 0}, {1, 1, 1, 1}, {0.5f, 0.5f}});
 84:   unsigned short bottomCenter = baseIndex;
 85:   baseIndex++;
 86:   for (int i = 0; i <= slices; ++i) {
 87:     float theta = ((float)i / slices) * XM_2PI;
 88:     float c = cosf(theta);
 89:     float s = sinf(theta);
 90:     float u = c * 0.5f + 0.5f;
 91:     float v = s * 0.5f + 0.5f;
 92:     vertices.push_back({{radius * c, -halfHeight, radius * s},
 93:                         {0, -1, 0},
 94:                         {1, 1, 1, 1},
 95:                         {u, v}});
 96:   }
 97:   for (int i = 0; i < slices; ++i) {
 98:     indices.push_back(bottomCenter);
 99:     indices.push_back(baseIndex + i);
100:     indices.push_back(baseIndex + i + 1);
101:   }
102:   g_IndexCount = (int)indices.size();
103:   // Create Vertex Buffer
104:   D3D11_BUFFER_DESC vbDesc = {};
105:   vbDesc.Usage = D3D11_USAGE_DEFAULT;
106:   vbDesc.ByteWidth = sizeof(Vertex3D) * (UINT)vertices.size();
107:   vbDesc.BindFlags = D3D11_BIND_VERTEX_BUFFER;
108:   D3D11_SUBRESOURCE_DATA vbInitData = {};
109:   vbInitData.pSysMem = vertices.data();
110:   g_pDevice->CreateBuffer(&vbDesc, &vbInitData, &g_pVertexBuffer);
111:   // Create Index Buffer
112:   D3D11_BUFFER_DESC ibDesc = {};
113:   ibDesc.Usage = D3D11_USAGE_DEFAULT;
114:   ibDesc.ByteWidth = sizeof(unsigned short) * (UINT)indices.size();
115:   ibDesc.BindFlags = D3D11_BIND_INDEX_BUFFER;
116:   D3D11_SUBRESOURCE_DATA ibInitData = {};
117:   ibInitData.pSysMem = indices.data();
118:   g_pDevice->CreateBuffer(&ibDesc, &ibInitData, &g_pIndexBuffer);
119: }
120: void Cylinder_Finalize(void) {
121:   SAFE_RELEASE(g_pVertexBuffer);
122:   SAFE_RELEASE(g_pIndexBuffer);
123: }
124: void Cylinder_Draw(int texId, const DirectX::XMMATRIX &mtxWorld) {
125:   if (!g_pVertexBuffer || !g_pIndexBuffer)
126:     return;
127:   Shader3D_Begin();
128:   Shader3D_SetMaterialColor({1.0f, 1.0f, 1.0f, 1.0f});
129:   UINT stride = sizeof(Vertex3D);
130:   UINT offset = 0;
131:   g_pContext->IASetVertexBuffers(0, 1, &g_pVertexBuffer, &stride, &offset);
132:   g_pContext->IASetIndexBuffer(g_pIndexBuffer, DXGI_FORMAT_R16_UINT, 0);
133:   g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
134:   Shader3D_SetWorldMatrix(mtxWorld);
135:   Texture_SetTexture(texId);
136:   g_pContext->DrawIndexed(g_IndexCount, 0, 0);
137: }
</file>

