257:     void FitPowerOf2(UINT origx, UINT origy, UINT& targetx, UINT& targety, size_t maxsize)
258:     {
259:         const float origAR = float(origx) / float(origy);
260:         if (origx > origy)
261:         {
262:             size_t x;
263:             for (x = maxsize; x > 1; x >>= 1) { if (x <= targetx) break; }
264:             targetx = UINT(x);
265:             float bestScore = FLT_MAX;
266:             for (size_t y = maxsize; y > 0; y >>= 1)
267:             {
268:                 const float score = fabsf((float(x) / float(y)) - origAR);
269:                 if (score < bestScore)
270:                 {
271:                     bestScore = score;
272:                     targety = UINT(y);
273:                 }
274:             }
275:         }
276:         else
277:         {
278:             size_t y;
279:             for (y = maxsize; y > 1; y >>= 1) { if (y <= targety) break; }
280:             targety = UINT(y);
281:             float bestScore = FLT_MAX;
282:             for (size_t x = maxsize; x > 0; x >>= 1)
283:             {
284:                 const float score = fabsf((float(x) / float(y)) - origAR);
285:                 if (score < bestScore)
286:                 {
287:                     bestScore = score;
288:                     targetx = UINT(x);
289:                 }
290:             }
291:         }
292:     }
