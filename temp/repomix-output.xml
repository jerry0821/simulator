13: };
14: 
15: cbuffer VS_CONSTANT_BUFFER : register(b1)
16: {
17:     float4x4 world;
18: };
19: 
20: struct VS_IN
21: {
22:     float4 posL : POSITION0;
23:     float4 normalL : NORMAL0; //Local法線
24: };
25: struct VS_OUT
26: {
27:     float4 posH : SV_POSITION;
28:     float4 normalW : NORMAL0;
