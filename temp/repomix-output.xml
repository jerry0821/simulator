2398:     // [DEBUG] Display merge groups
2399: #if 0
2400:     if (g.IO.KeyShift)
2401:         for (int merge_group_n = 0; merge_group_n < IM_ARRAYSIZE(merge_groups); merge_group_n++)
2402:         {
2403:             MergeGroup* merge_group = &merge_groups[merge_group_n];
