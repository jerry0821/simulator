8691:     for (int tab_src_n = 0; tab_src_n < tab_bar->Tabs.Size; tab_src_n++)
8692:     {
8693:         ImGuiTabItem* tab = &tab_bar->Tabs[tab_src_n];
8694:         if (tab->LastFrameVisible < tab_bar->PrevFrameVisible || tab->WantClose)
8695:         {
8696:             // Remove tab
8697:             if (tab_bar->VisibleTabId == tab->ID) { tab_bar->VisibleTabId = 0; }
8698:             if (tab_bar->SelectedTabId == tab->ID) { tab_bar->SelectedTabId = 0; }
8699:             if (tab_bar->NextSelectedTabId == tab->ID) { tab_bar->NextSelectedTabId = 0; }
8700:             continue;
8701:         }
8702:         if (tab_dst_n != tab_src_n)
8703:             tab_bar->Tabs[tab_dst_n] = tab_bar->Tabs[tab_src_n];
8704:         tab = &tab_bar->Tabs[tab_dst_n];
8705:         tab->IndexDuringLayout = (ImS16)tab_dst_n;
8706:         // We will need sorting if tabs have changed section (e.g. moved from one of Leading/Central/Trailing to another)
8707:         int curr_tab_section_n = TabItemGetSectionIdx(tab);
8708:         if (tab_dst_n > 0)
8709:         {
8710:             ImGuiTabItem* prev_tab = &tab_bar->Tabs[tab_dst_n - 1];
8711:             int prev_tab_section_n = TabItemGetSectionIdx(prev_tab);
8712:             if (curr_tab_section_n == 0 && prev_tab_section_n != 0)
8713:                 need_sort_by_section = true;
8714:             if (prev_tab_section_n == 2 && curr_tab_section_n != 2)
8715:                 need_sort_by_section = true;
8716:         }
8717:         sections[curr_tab_section_n].TabCount++;
