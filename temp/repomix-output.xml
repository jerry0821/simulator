1183: bool ImGui::RadioButton(const char* label, bool active)
1184: {
1185:     ImGuiWindow* window = GetCurrentWindow();
1186:     if (window->SkipItems)
1187:         return false;
1188:     ImGuiContext& g = *GImGui;
1189:     const ImGuiStyle& style = g.Style;
1190:     const ImGuiID id = window->GetID(label);
1191:     const ImVec2 label_size = CalcTextSize(label, NULL, true);
1192:     const float square_sz = GetFrameHeight();
1193:     const ImVec2 pos = window->DC.CursorPos;
1194:     const ImRect check_bb(pos, pos + ImVec2(square_sz, square_sz));
1195:     const ImRect total_bb(pos, pos + ImVec2(square_sz + (label_size.x > 0.0f ? style.ItemInnerSpacing.x + label_size.x : 0.0f), label_size.y + style.FramePadding.y * 2.0f));
1196:     ItemSize(total_bb, style.FramePadding.y);
1197:     if (!ItemAdd(total_bb, id))
1198:         return false;
1199:     ImVec2 center = check_bb.GetCenter();
1200:     center.x = IM_ROUND(center.x);
1201:     center.y = IM_ROUND(center.y);
1202:     const float radius = (square_sz - 1.0f) * 0.5f;
1203:     bool hovered, held;
1204:     bool pressed = ButtonBehavior(total_bb, id, &hovered, &held);
1205:     if (pressed)
1206:         MarkItemEdited(id);
1207:     RenderNavCursor(total_bb, id);
1208:     const int num_segment = window->DrawList->_CalcCircleAutoSegmentCount(radius);
1209:     window->DrawList->AddCircleFilled(center, radius, GetColorU32((held && hovered) ? ImGuiCol_FrameBgActive : hovered ? ImGuiCol_FrameBgHovered : ImGuiCol_FrameBg), num_segment);
1210:     if (active)
1211:     {
1212:         const float pad = ImMax(1.0f, IM_TRUNC(square_sz / 6.0f));
1213:         window->DrawList->AddCircleFilled(center, radius - pad, GetColorU32(ImGuiCol_CheckMark));
1214:     }
1215:     if (style.FrameBorderSize > 0.0f)
1216:     {
1217:         window->DrawList->AddCircle(center + ImVec2(1, 1), radius, GetColorU32(ImGuiCol_BorderShadow), num_segment, style.FrameBorderSize);
1218:         window->DrawList->AddCircle(center, radius, GetColorU32(ImGuiCol_Border), num_segment, style.FrameBorderSize);
1219:     }
1220:     ImVec2 label_pos = ImVec2(check_bb.Max.x + style.ItemInnerSpacing.x, check_bb.Min.y + style.FramePadding.y);
1221:     if (g.LogEnabled)
1222:         LogRenderedText(&label_pos, active ? "(x)" : "( )");
1223:     if (label_size.x > 0.0f)
1224:         RenderText(label_pos, label);
1225:     IMGUI_TEST_ENGINE_ITEM_INFO(id, label, g.LastItemData.StatusFlags);
1226:     return pressed;
1227: }
