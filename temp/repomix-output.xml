2386: //-----------------------------------------------------------------------------
2387: // Shared state of InputText(), passed as an argument to your callback when a ImGuiInputTextFlags_Callback* flag is used.
2388: // The callback function should return 0 by default.
2389: // Callbacks (follow a flag name and see comments in ImGuiInputTextFlags_ declarations for more details)
2390: // - ImGuiInputTextFlags_CallbackEdit:        Callback on buffer edit. Note that InputText() already returns true on edit + you can always use IsItemEdited(). The callback is useful to manipulate the underlying buffer while focus is active.
2391: // - ImGuiInputTextFlags_CallbackAlways:      Callback on each iteration
2392: // - ImGuiInputTextFlags_CallbackCompletion:  Callback on pressing TAB
2393: // - ImGuiInputTextFlags_CallbackHistory:     Callback on pressing Up/Down arrows
2394: // - ImGuiInputTextFlags_CallbackCharFilter:  Callback on character inputs to replace or discard them. Modify 'EventChar' to replace or discard, or return 1 in callback to discard.
2395: // - ImGuiInputTextFlags_CallbackResize:      Callback on buffer capacity changes request (beyond 'buf_size' parameter value), allowing the string to grow.
2396: struct ImGuiInputTextCallbackData
2397: {
2398:     ImGuiContext*       Ctx;            // Parent UI context
2399:     ImGuiInputTextFlags EventFlag;      // One ImGuiInputTextFlags_Callback*    // Read-only
2400:     ImGuiInputTextFlags Flags;          // What user passed to InputText()      // Read-only
2401:     void*               UserData;       // What user passed to InputText()      // Read-only
2402:     // Arguments for the different callback events
2403:     // - During Resize callback, Buf will be same as your input buffer.
2404:     // - However, during Completion/History/Always callback, Buf always points to our own internal data (it is not the same as your buffer)! Changes to it will be reflected into your own buffer shortly after the callback.
2405:     // - To modify the text buffer in a callback, prefer using the InsertChars() / DeleteChars() function. InsertChars() will take care of calling the resize callback if necessary.
2406:     // - If you know your edits are not going to resize the underlying buffer allocation, you may modify the contents of 'Buf[]' directly. You need to update 'BufTextLen' accordingly (0 <= BufTextLen < BufSize) and set 'BufDirty'' to true so InputText can update its internal state.
2407:     ImWchar             EventChar;      // Character input                      // Read-write   // [CharFilter] Replace character with another one, or set to zero to drop. return 1 is equivalent to setting EventChar=0;
2408:     ImGuiKey            EventKey;       // Key pressed (Up/Down/TAB)            // Read-only    // [Completion,History]
2409:     char*               Buf;            // Text buffer                          // Read-write   // [Resize] Can replace pointer / [Completion,History,Always] Only write to pointed data, don't replace the actual pointer!
2410:     int                 BufTextLen;     // Text length (in bytes)               // Read-write   // [Resize,Completion,History,Always] Exclude zero-terminator storage. In C land: == strlen(some_text), in C++ land: string.length()
2411:     int                 BufSize;        // Buffer size (in bytes) = capacity+1  // Read-only    // [Resize,Completion,History,Always] Include zero-terminator storage. In C land: == ARRAYSIZE(my_char_array), in C++ land: string.capacity()+1
2412:     bool                BufDirty;       // Set if you modify Buf/BufTextLen!    // Write        // [Completion,History,Always]
2413:     int                 CursorPos;      //                                      // Read-write   // [Completion,History,Always]
2414:     int                 SelectionStart; //                                      // Read-write   // [Completion,History,Always] == to SelectionEnd when no selection
2415:     int                 SelectionEnd;   //                                      // Read-write   // [Completion,History,Always]
2416:     // Helper functions for text manipulation.
2417:     // Use those function to benefit from the CallbackResize behaviors. Calling those function reset the selection.
2418:     IMGUI_API ImGuiInputTextCallbackData();
2419:     IMGUI_API void      DeleteChars(int pos, int bytes_count);
2420:     IMGUI_API void      InsertChars(int pos, const char* text, const char* text_end = NULL);
2421:     void                SelectAll()             { SelectionStart = 0; SelectionEnd = BufTextLen; }
2422:     void                ClearSelection()        { SelectionStart = SelectionEnd = BufTextLen; }
2423:     bool                HasSelection() const    { return SelectionStart != SelectionEnd; }
2424: };
