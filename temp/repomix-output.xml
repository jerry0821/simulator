13458: // Internal version that takes a position to decide on newline placement and pad items according to their depth.
13459: // We split text into individual lines to add current tree level padding
13460: // FIXME: This code is a little complicated perhaps, considering simplifying the whole system.
13461: void ImGui::LogRenderedText(const ImVec2* ref_pos, const char* text, const char* text_end)
13462: {
13463:     ImGuiContext& g = *GImGui;
13464:     ImGuiWindow* window = g.CurrentWindow;
13465:     const char* prefix = g.LogNextPrefix;
13466:     const char* suffix = g.LogNextSuffix;
13467:     g.LogNextPrefix = g.LogNextSuffix = NULL;
13468:     if (!text_end)
13469:         text_end = FindRenderedTextEnd(text, text_end);
13470:     const bool log_new_line = ref_pos && (ref_pos->y > g.LogLinePosY + g.Style.FramePadding.y + 1);
13471:     if (ref_pos)
13472:         g.LogLinePosY = ref_pos->y;
13473:     if (log_new_line)
13474:     {
13475:         LogText(IM_NEWLINE);
13476:         g.LogLineFirstItem = true;
13477:     }
13478:     if (prefix)
13479:         LogRenderedText(ref_pos, prefix, prefix + ImStrlen(prefix)); // Calculate end ourself to ensure "##" are included here.
13480:     // Re-adjust padding if we have popped out of our starting depth
13481:     if (g.LogDepthRef > window->DC.TreeDepth)
13482:         g.LogDepthRef = window->DC.TreeDepth;
13483:     const int tree_depth = (window->DC.TreeDepth - g.LogDepthRef);
13484:     const char* text_remaining = text;
13485:     for (;;)
13486:     {
13487:         // Split the string. Each new line (after a '\n') is followed by indentation corresponding to the current depth of our log entry.
13488:         // We don't add a trailing \n yet to allow a subsequent item on the same line to be captured.
13489:         const char* line_start = text_remaining;
13490:         const char* line_end = ImStreolRange(line_start, text_end);
13491:         const bool is_last_line = (line_end == text_end);
13492:         if (line_start != line_end || !is_last_line)
13493:         {
13494:             const int line_length = (int)(line_end - line_start);
13495:             const int indentation = g.LogLineFirstItem ? tree_depth * 4 : 1;
13496:             LogText("%*s%.*s", indentation, "", line_length, line_start);
13497:             g.LogLineFirstItem = false;
13498:             if (*line_end == '\n')
13499:             {
13500:                 LogText(IM_NEWLINE);
13501:                 g.LogLineFirstItem = true;
13502:             }
13503:         }
13504:         if (is_last_line)
13505:             break;
13506:         text_remaining = line_end + 1;
13507:     }
13508:     if (suffix)
13509:         LogRenderedText(ref_pos, suffix, suffix + ImStrlen(suffix));
13510: }
