 7881: static void ImGui::UpdateTexturesNewFrame()
 7882: {
 7883:     // Cannot update every atlases based on atlas's FrameCount < g.FrameCount, because an atlas may be shared by multiple contexts with different frame count.
 7884:     ImGuiContext& g = *GImGui;
 7885:     const bool has_textures = (g.IO.BackendFlags & ImGuiBackendFlags_RendererHasTextures) != 0;
 7886:     for (ImFontAtlas* atlas : g.FontAtlases)
 7887:     {
 7888:         if (atlas->OwnerContext == &g)
 7889:         {
 7890:             ImFontAtlasUpdateNewFrame(atlas, g.FrameCount, has_textures);
 7891:         }
 7892:         else
 7893:         {
 7894:             // (1) If you manage font atlases yourself, e.g. create a ImFontAtlas yourself you need to call ImFontAtlasUpdateNewFrame() on it.
 7895:             // Otherwise, calling ImGui::CreateContext() without parameter will create an atlas owned by the context.
 7896:             // (2) If you have multiple font atlases, make sure the 'atlas->RendererHasTextures' as specified in the ImFontAtlasUpdateNewFrame() call matches for that.
 7897:             // (3) If you have multiple imgui contexts, they also need to have a matching value for ImGuiBackendFlags_RendererHasTextures.
 7898:             IM_ASSERT(atlas->Builder != NULL && atlas->Builder->FrameCount != -1);
 7899:             IM_ASSERT(atlas->RendererHasTextures == has_textures);
 7900:         }
 7901:     }
 7902: }
 7903: // Build a single texture list
 7904: static void ImGui::UpdateTexturesEndFrame()
 7905: {
 7906:     ImGuiContext& g = *GImGui;
 7907:     g.PlatformIO.Textures.resize(0);
 7908:     for (ImFontAtlas* atlas : g.FontAtlases)
 7909:         for (ImTextureData* tex : atlas->TexList)
 7910:         {
 7911:             // We provide this information so backends can decide whether to destroy textures.
 7912:             // This means in practice that if N imgui contexts are created with a shared atlas, we assume all of them have a backend initialized.
 7913:             tex->RefCount = (unsigned short)atlas->RefCount;
 7914:             g.PlatformIO.Textures.push_back(tex);
 7915:         }
 7916:     for (ImTextureData* tex : g.UserTextures)
 7917:         g.PlatformIO.Textures.push_back(tex);
 7918: }
 7919: void ImGui::UpdateFontsNewFrame()
 7920: {
 7921:     ImGuiContext& g = *GImGui;
 7922:     if ((g.IO.BackendFlags & ImGuiBackendFlags_RendererHasTextures) == 0)
 7923:         for (ImFontAtlas* atlas : g.FontAtlases)
 7924:             atlas->Locked = true;
 7925:     if (g.Style._NextFrameFontSizeBase != 0.0f)
 7926:     {
 7927:         g.Style.FontSizeBase = g.Style._NextFrameFontSizeBase;
 7928:         g.Style._NextFrameFontSizeBase = 0.0f;
 7929:     }
