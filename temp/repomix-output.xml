12405:     }
12406: #endif
12407:     // Submit
12408:     g.NavMoveForwardToNextFrame = false;
12409:     if (g.NavMoveDir != ImGuiDir_None)
12410:         NavMoveRequestSubmit(g.NavMoveDir, g.NavMoveClipDir, g.NavMoveFlags, g.NavMoveScrollFlags);
12411:     // Moving with no reference triggers an init request (will be used as a fallback if the direction fails to find a match)
12412:     if (g.NavMoveSubmitted && g.NavId == 0)
12413:     {
12414:         IMGUI_DEBUG_LOG_NAV("[nav] NavInitRequest: from move, window \"%s\", layer=%d\n", window ? window->Name : "<NULL>", g.NavLayer);
12415:         g.NavInitRequest = g.NavInitRequestFromMove = true;
12416:         g.NavInitResult.ID = 0;
12417:         if (g.IO.ConfigNavCursorVisibleAuto)
12418:             g.NavCursorVisible = true;
12419:     }
12420:     // When using gamepad, we project the reference nav bounding box into window visible area.
12421:     // This is to allow resuming navigation inside the visible area after doing a large amount of scrolling,
12422:     // since with gamepad all movements are relative (can't focus a visible object like we can with the mouse).
12423:     if (g.NavMoveSubmitted && g.NavInputSource == ImGuiInputSource_Gamepad && g.NavLayer == ImGuiNavLayer_Main && window != NULL)// && (g.NavMoveFlags & ImGuiNavMoveFlags_Forwarded))
12424:     {
12425:         bool clamp_x = (g.NavMoveFlags & (ImGuiNavMoveFlags_LoopX | ImGuiNavMoveFlags_WrapX)) == 0;
12426:         bool clamp_y = (g.NavMoveFlags & (ImGuiNavMoveFlags_LoopY | ImGuiNavMoveFlags_WrapY)) == 0;
12427:         ImRect inner_rect_rel = WindowRectAbsToRel(window, ImRect(window->InnerRect.Min - ImVec2(1, 1), window->InnerRect.Max + ImVec2(1, 1)));
12428:         // Take account of changing scroll to handle triggering a new move request on a scrolling frame. (#6171)
12429:         // Otherwise 'inner_rect_rel' would be off on the move result frame.
12430:         inner_rect_rel.Translate(CalcNextScrollFromScrollTargetAndClamp(window) - window->Scroll);
12431:         if ((clamp_x || clamp_y) && !inner_rect_rel.Contains(window->NavRectRel[g.NavLayer]))
12432:         {
12433:             IMGUI_DEBUG_LOG_NAV("[nav] NavMoveRequest: clamp NavRectRel for gamepad move\n");
12434:             float pad_x = ImMin(inner_rect_rel.GetWidth(), window->FontRefSize * 0.5f);
12435:             float pad_y = ImMin(inner_rect_rel.GetHeight(), window->FontRefSize * 0.5f); // Terrible approximation for the intent of starting navigation from first fully visible item
12436:             inner_rect_rel.Min.x = clamp_x ? (inner_rect_rel.Min.x + pad_x) : -FLT_MAX;
12437:             inner_rect_rel.Max.x = clamp_x ? (inner_rect_rel.Max.x - pad_x) : +FLT_MAX;
12438:             inner_rect_rel.Min.y = clamp_y ? (inner_rect_rel.Min.y + pad_y) : -FLT_MAX;
12439:             inner_rect_rel.Max.y = clamp_y ? (inner_rect_rel.Max.y - pad_y) : +FLT_MAX;
12440:             window->NavRectRel[g.NavLayer].ClipWithFull(inner_rect_rel);
12441:             g.NavId = 0;
12442:         }
12443:     }
12444:     // Prepare scoring rectangle.
12445:     // For scoring we use a single segment on the left side our current item bounding box (not touching the edge to avoid box overlap with zero-spaced items)
12446:     ImRect scoring_rect;
12447:     if (window != NULL)
12448:     {
12449:         ImRect nav_rect_rel = !window->NavRectRel[g.NavLayer].IsInverted() ? window->NavRectRel[g.NavLayer] : ImRect(0, 0, 0, 0);
12450:         scoring_rect = WindowRectRelToAbs(window, nav_rect_rel);
12451:         if (g.NavMoveFlags & ImGuiNavMoveFlags_IsPageMove)
12452:         {
12453:             // When we start from a visible location, score visible items and prioritize this result.
12454:             if (window->InnerRect.Contains(scoring_rect))
12455:                 g.NavMoveFlags |= ImGuiNavMoveFlags_AlsoScoreVisibleSet;
12456:             g.NavScoringNoClipRect = scoring_rect;
12457:             scoring_rect.TranslateY(scoring_page_offset_y);
12458:             g.NavScoringNoClipRect.Add(scoring_rect);
12459:         }
12460:         //GetForegroundDrawList()->AddRectFilled(scoring_rect.Min - ImVec2(1, 1), scoring_rect.Max + ImVec2(1, 1), IM_COL32(255, 100, 0, 80)); // [DEBUG] Pre-bias
12461:         if (g.NavMoveSubmitted)
12462:             NavBiasScoringRect(scoring_rect, window->RootWindowForNav->NavPreferredScoringPosRel[g.NavLayer], g.NavMoveDir, g.NavMoveFlags);
12463:         IM_ASSERT(!scoring_rect.IsInverted()); // Ensure we have a non-inverted bounding box here will allow us to remove extraneous ImFabs() calls in NavScoreItem().
12464:         //GetForegroundDrawList()->AddRectFilled(scoring_rect.Min - ImVec2(1, 1), scoring_rect.Max + ImVec2(1, 1), IM_COL32(255, 100, 0, 80)); // [DEBUG] Post-bias
12465:         //if (!g.NavScoringNoClipRect.IsInverted()) { GetForegroundDrawList()->AddRectFilled(g.NavScoringNoClipRect.Min, g.NavScoringNoClipRect.Max, IM_COL32(100, 255, 0, 80)); } // [DEBUG]
12466:     }
12467:     g.NavScoringRect = scoring_rect;
12468:     //g.NavScoringNoClipRect.Add(scoring_rect);
12469: }
12470: void ImGui::NavUpdateCreateTabbingRequest()
12471: {
12472:     ImGuiContext& g = *GImGui;
12473:     ImGuiWindow* window = g.NavWindow;
12474:     IM_ASSERT(g.NavMoveDir == ImGuiDir_None);
12475:     if (window == NULL || g.NavWindowingTarget != NULL || (window->Flags & ImGuiWindowFlags_NoNavInputs))
12476:         return;
12477:     const bool tab_pressed = IsKeyPressed(ImGuiKey_Tab, ImGuiInputFlags_Repeat, ImGuiKeyOwner_NoOwner) && !g.IO.KeyCtrl && !g.IO.KeyAlt;
12478:     if (!tab_pressed)
12479:         return;
12480:     // Initiate tabbing request
12481:     // (this is ALWAYS ENABLED, regardless of ImGuiConfigFlags_NavEnableKeyboard flag!)
12482:     // See NavProcessItemForTabbingRequest() for a description of the various forward/backward tabbing cases with and without wrapping.
12483:     const bool nav_keyboard_active = (g.IO.ConfigFlags & ImGuiConfigFlags_NavEnableKeyboard) != 0;
12484:     if (nav_keyboard_active)
12485:         g.NavTabbingDir = g.IO.KeyShift ? -1 : (g.NavCursorVisible == false && g.ActiveId == 0) ? 0 : +1;
12486:     else
12487:         g.NavTabbingDir = g.IO.KeyShift ? -1 : (g.ActiveId == 0) ? 0 : +1;
12488:     ImGuiNavMoveFlags move_flags = ImGuiNavMoveFlags_IsTabbing | ImGuiNavMoveFlags_Activate;
12489:     ImGuiScrollFlags scroll_flags = window->Appearing ? ImGuiScrollFlags_KeepVisibleEdgeX | ImGuiScrollFlags_AlwaysCenterY : ImGuiScrollFlags_KeepVisibleEdgeX | ImGuiScrollFlags_KeepVisibleEdgeY;
12490:     ImGuiDir clip_dir = (g.NavTabbingDir < 0) ? ImGuiDir_Up : ImGuiDir_Down;
12491:     NavMoveRequestSubmit(ImGuiDir_None, clip_dir, move_flags, scroll_flags); // FIXME-NAV: Once we refactor tabbing, add LegacyApi flag to not activate non-inputable.
12492:     g.NavTabbingCounter = -1;
12493: }
12494: // Apply result from previous frame navigation directional move request. Always called from NavUpdate()
12495: void ImGui::NavMoveRequestApplyResult()
12496: {
12497:     ImGuiContext& g = *GImGui;
12498: #if IMGUI_DEBUG_NAV_SCORING
12499:     if (g.NavMoveFlags & ImGuiNavMoveFlags_DebugNoResult) // [DEBUG] Scoring all items in NavWindow at all times
12500:         return;
12501: #endif
12502:     // Select which result to use
12503:     ImGuiNavItemData* result = (g.NavMoveResultLocal.ID != 0) ? &g.NavMoveResultLocal : (g.NavMoveResultOther.ID != 0) ? &g.NavMoveResultOther : NULL;
12504:     // Tabbing forward wrap
12505:     if ((g.NavMoveFlags & ImGuiNavMoveFlags_IsTabbing) && result == NULL)
12506:         if ((g.NavTabbingCounter == 1 || g.NavTabbingDir == 0) && g.NavTabbingResultFirst.ID)
12507:             result = &g.NavTabbingResultFirst;
12508:     // In a situation when there are no results but NavId != 0, re-enable the Navigation highlight (because g.NavId is not considered as a possible result)
12509:     const ImGuiAxis axis = (g.NavMoveDir == ImGuiDir_Up || g.NavMoveDir == ImGuiDir_Down) ? ImGuiAxis_Y : ImGuiAxis_X;
12510:     if (result == NULL)
12511:     {
12512:         if (g.NavMoveFlags & ImGuiNavMoveFlags_IsTabbing)
12513:             g.NavMoveFlags |= ImGuiNavMoveFlags_NoSetNavCursorVisible;
12514:         if (g.NavId != 0 && (g.NavMoveFlags & ImGuiNavMoveFlags_NoSetNavCursorVisible) == 0)
12515:             SetNavCursorVisibleAfterMove();
12516:         NavClearPreferredPosForAxis(axis); // On a failed move, clear preferred pos for this axis.
12517:         IMGUI_DEBUG_LOG_NAV("[nav] NavMoveSubmitted but not led to a result!\n");
12518:         return;
12519:     }
12520:     // PageUp/PageDown behavior first jumps to the bottom/top mostly visible item, _otherwise_ use the result from the previous/next page.
12521:     if (g.NavMoveFlags & ImGuiNavMoveFlags_AlsoScoreVisibleSet)
12522:         if (g.NavMoveResultLocalVisible.ID != 0 && g.NavMoveResultLocalVisible.ID != g.NavId)
12523:             result = &g.NavMoveResultLocalVisible;
12524:     // Maybe entering a flattened child from the outside? In this case solve the tie using the regular scoring rules.
12525:     if (result != &g.NavMoveResultOther && g.NavMoveResultOther.ID != 0 && g.NavMoveResultOther.Window->ParentWindow == g.NavWindow)
12526:         if ((g.NavMoveResultOther.DistBox < result->DistBox) || (g.NavMoveResultOther.DistBox == result->DistBox && g.NavMoveResultOther.DistCenter < result->DistCenter))
12527:             result = &g.NavMoveResultOther;
12528:     IM_ASSERT(g.NavWindow && result->Window);
12529:     // Scroll to keep newly navigated item fully into view.
12530:     if (g.NavLayer == ImGuiNavLayer_Main)
12531:     {
12532:         ImRect rect_abs = WindowRectRelToAbs(result->Window, result->RectRel);
12533:         ScrollToRectEx(result->Window, rect_abs, g.NavMoveScrollFlags);
12534:         if (g.NavMoveFlags & ImGuiNavMoveFlags_ScrollToEdgeY)
12535:         {
12536:             // FIXME: Should remove this? Or make more precise: use ScrollToRectEx() with edge?
12537:             float scroll_target = (g.NavMoveDir == ImGuiDir_Up) ? result->Window->ScrollMax.y : 0.0f;
12538:             SetScrollY(result->Window, scroll_target);
12539:         }
12540:     }
12541:     if (g.NavWindow != result->Window)
12542:     {
12543:         IMGUI_DEBUG_LOG_FOCUS("[focus] NavMoveRequest: SetNavWindow(\"%s\")\n", result->Window->Name);
12544:         g.NavWindow = result->Window;
12545:         g.NavLastValidSelectionUserData = ImGuiSelectionUserData_Invalid;
12546:     }
12547:     // Clear active id unless requested not to
12548:     // FIXME: ImGuiNavMoveFlags_NoClearActiveId is currently unused as we don't have a clear strategy to preserve active id after interaction,
12549:     // so this is mostly provided as a gateway for further experiments (see #1418, #2890)
12550:     if (g.ActiveId != result->ID && (g.NavMoveFlags & ImGuiNavMoveFlags_NoClearActiveId) == 0)
12551:         ClearActiveID();
12552:     // Don't set NavJustMovedToId if just landed on the same spot (which may happen with ImGuiNavMoveFlags_AllowCurrentNavId)
12553:     // PageUp/PageDown however sets always set NavJustMovedTo (vs Home/End which doesn't) mimicking Windows behavior.
12554:     if ((g.NavId != result->ID || (g.NavMoveFlags & ImGuiNavMoveFlags_IsPageMove)) && (g.NavMoveFlags & ImGuiNavMoveFlags_NoSelect) == 0)
12555:     {
12556:         g.NavJustMovedFromFocusScopeId = g.NavFocusScopeId;
12557:         g.NavJustMovedToId = result->ID;
12558:         g.NavJustMovedToFocusScopeId = result->FocusScopeId;
12559:         g.NavJustMovedToKeyMods = g.NavMoveKeyMods;
12560:         g.NavJustMovedToIsTabbing = (g.NavMoveFlags & ImGuiNavMoveFlags_IsTabbing) != 0;
12561:         g.NavJustMovedToHasSelectionData = (result->ItemFlags & ImGuiItemFlags_HasSelectionUserData) != 0;
12562:         //IMGUI_DEBUG_LOG_NAV("[nav] NavJustMovedFromFocusScopeId = 0x%08X, NavJustMovedToFocusScopeId = 0x%08X\n", g.NavJustMovedFromFocusScopeId, g.NavJustMovedToFocusScopeId);
12563:     }
12564:     // Apply new NavID/Focus
12565:     IMGUI_DEBUG_LOG_NAV("[nav] NavMoveRequest: result NavID 0x%08X in Layer %d Window \"%s\"\n", result->ID, g.NavLayer, g.NavWindow->Name);
12566:     ImVec2 preferred_scoring_pos_rel = g.NavWindow->RootWindowForNav->NavPreferredScoringPosRel[g.NavLayer];
12567:     SetNavID(result->ID, g.NavLayer, result->FocusScopeId, result->RectRel);
12568:     if (result->SelectionUserData != ImGuiSelectionUserData_Invalid)
12569:         g.NavLastValidSelectionUserData = result->SelectionUserData;
12570:     // Restore last preferred position for current axis
12571:     // (storing in RootWindowForNav-> as the info is desirable at the beginning of a Move Request. In theory all storage should use RootWindowForNav..)
12572:     if ((g.NavMoveFlags & ImGuiNavMoveFlags_IsTabbing) == 0)
12573:     {
12574:         preferred_scoring_pos_rel[axis] = result->RectRel.GetCenter()[axis];
12575:         g.NavWindow->RootWindowForNav->NavPreferredScoringPosRel[g.NavLayer] = preferred_scoring_pos_rel;
12576:     }
12577:     // Tabbing: Activates Inputable, otherwise only Focus
12578:     if ((g.NavMoveFlags & ImGuiNavMoveFlags_IsTabbing) && (result->ItemFlags & ImGuiItemFlags_Inputable) == 0)
12579:         g.NavMoveFlags &= ~ImGuiNavMoveFlags_Activate;
12580:     // Activate
12581:     if (g.NavMoveFlags & ImGuiNavMoveFlags_Activate)
12582:     {
12583:         g.NavNextActivateId = result->ID;
12584:         g.NavNextActivateFlags = ImGuiActivateFlags_None;
12585:         if (g.NavMoveFlags & ImGuiNavMoveFlags_FocusApi)
12586:             g.NavNextActivateFlags |= ImGuiActivateFlags_FromFocusApi;
12587:         if (g.NavMoveFlags & ImGuiNavMoveFlags_IsTabbing)
12588:             g.NavNextActivateFlags |= ImGuiActivateFlags_PreferInput | ImGuiActivateFlags_TryToPreserveState | ImGuiActivateFlags_FromTabbing;
12589:     }
12590:     // Make nav cursor visible
12591:     if ((g.NavMoveFlags & ImGuiNavMoveFlags_NoSetNavCursorVisible) == 0)
12592:         SetNavCursorVisibleAfterMove();
12593: }
12594: // Process Escape/NavCancel input (to close a popup, get back to parent, clear focus)
12595: // FIXME: In order to support e.g. Escape to clear a selection we'll need:
12596: // - either to store the equivalent of ActiveIdUsingKeyInputMask for a FocusScope and test for it.
12597: // - either to move most/all of those tests to the epilogue/end functions of the scope they are dealing with (e.g. exit child window in EndChild()) or in EndFrame(), to allow an earlier intercept
12598: static void ImGui::NavUpdateCancelRequest()
12599: {
12600:     ImGuiContext& g = *GImGui;
12601:     const bool nav_gamepad_active = (g.IO.ConfigFlags & ImGuiConfigFlags_NavEnableGamepad) != 0 && (g.IO.BackendFlags & ImGuiBackendFlags_HasGamepad) != 0;
12602:     const bool nav_keyboard_active = (g.IO.ConfigFlags & ImGuiConfigFlags_NavEnableKeyboard) != 0;
12603:     if (!(nav_keyboard_active && IsKeyPressed(ImGuiKey_Escape, 0, ImGuiKeyOwner_NoOwner)) && !(nav_gamepad_active && IsKeyPressed(ImGuiKey_NavGamepadCancel, 0, ImGuiKeyOwner_NoOwner)))
12604:         return;
12605:     IMGUI_DEBUG_LOG_NAV("[nav] NavUpdateCancelRequest()\n");
12606:     if (g.ActiveId != 0)
12607:     {
12608:         ClearActiveID();
12609:     }
12610:     else if (g.NavLayer != ImGuiNavLayer_Main)
12611:     {
12612:         // Leave the "menu" layer
12613:         NavRestoreLayer(ImGuiNavLayer_Main);
12614:         SetNavCursorVisibleAfterMove();
12615:     }
12616:     else if (g.NavWindow && g.NavWindow != g.NavWindow->RootWindow && !(g.NavWindow->RootWindowForNav->Flags & ImGuiWindowFlags_Popup) && g.NavWindow->RootWindowForNav->ParentWindow)
12617:     {
12618:         // Exit child window
12619:         ImGuiWindow* child_window = g.NavWindow->RootWindowForNav;
12620:         ImGuiWindow* parent_window = child_window->ParentWindow;
12621:         IM_ASSERT(child_window->ChildId != 0);
12622:         FocusWindow(parent_window);
12623:         SetNavID(child_window->ChildId, ImGuiNavLayer_Main, 0, WindowRectAbsToRel(parent_window, child_window->Rect()));
12624:         SetNavCursorVisibleAfterMove();
12625:     }
12626:     else if (g.OpenPopupStack.Size > 0 && g.OpenPopupStack.back().Window != NULL && !(g.OpenPopupStack.back().Window->Flags & ImGuiWindowFlags_Modal))
12627:     {
12628:         // Close open popup/menu
12629:         ClosePopupToLevel(g.OpenPopupStack.Size - 1, true);
12630:     }
12631:     else
12632:     {
12633:         // Clear NavLastId for popups but keep it for regular child window so we can leave one and come back where we were
12634:         // FIXME-NAV: This should happen on window appearing.
12635:         if (g.IO.ConfigNavEscapeClearFocusItem || g.IO.ConfigNavEscapeClearFocusWindow)
12636:             if (g.NavWindow && ((g.NavWindow->Flags & ImGuiWindowFlags_Popup)))// || !(g.NavWindow->Flags & ImGuiWindowFlags_ChildWindow)))
12637:                 g.NavWindow->NavLastIds[0] = 0;
12638:         // Clear nav focus
12639:         if (g.IO.ConfigNavEscapeClearFocusItem || g.IO.ConfigNavEscapeClearFocusWindow)
12640:             g.NavId = 0;
12641:         if (g.IO.ConfigNavEscapeClearFocusWindow)
12642:             FocusWindow(NULL);
12643:     }
12644: }
12645: // Handle PageUp/PageDown/Home/End keys
12646: // Called from NavUpdateCreateMoveRequest() which will use our output to create a move request
12647: // FIXME-NAV: This doesn't work properly with NavFlattened siblings as we use NavWindow rectangle for reference
12648: // FIXME-NAV: how to get Home/End to aim at the beginning/end of a 2D grid?
12649: static float ImGui::NavUpdatePageUpPageDown()
12650: {
12651:     ImGuiContext& g = *GImGui;
12652:     ImGuiWindow* window = g.NavWindow;
12653:     if ((window->Flags & ImGuiWindowFlags_NoNavInputs) || g.NavWindowingTarget != NULL)
12654:         return 0.0f;
12655:     const bool page_up_held = IsKeyDown(ImGuiKey_PageUp, ImGuiKeyOwner_NoOwner);
12656:     const bool page_down_held = IsKeyDown(ImGuiKey_PageDown, ImGuiKeyOwner_NoOwner);
12657:     const bool home_pressed = IsKeyPressed(ImGuiKey_Home, ImGuiInputFlags_Repeat, ImGuiKeyOwner_NoOwner);
12658:     const bool end_pressed = IsKeyPressed(ImGuiKey_End, ImGuiInputFlags_Repeat, ImGuiKeyOwner_NoOwner);
12659:     if (page_up_held == page_down_held && home_pressed == end_pressed) // Proceed if either (not both) are pressed, otherwise early out
12660:         return 0.0f;
12661:     if (g.NavLayer != ImGuiNavLayer_Main)
12662:         NavRestoreLayer(ImGuiNavLayer_Main);
12663:     if ((window->DC.NavLayersActiveMask & (1 << ImGuiNavLayer_Main)) == 0 && window->DC.NavWindowHasScrollY)
12664:     {
12665:         // Fallback manual-scroll when window has no navigable item
12666:         if (IsKeyPressed(ImGuiKey_PageUp, ImGuiInputFlags_Repeat, ImGuiKeyOwner_NoOwner))
12667:             SetScrollY(window, window->Scroll.y - window->InnerRect.GetHeight());
12668:         else if (IsKeyPressed(ImGuiKey_PageDown, ImGuiInputFlags_Repeat, ImGuiKeyOwner_NoOwner))
12669:             SetScrollY(window, window->Scroll.y + window->InnerRect.GetHeight());
12670:         else if (home_pressed)
12671:             SetScrollY(window, 0.0f);
12672:         else if (end_pressed)
12673:             SetScrollY(window, window->ScrollMax.y);
12674:     }
12675:     else
12676:     {
12677:         ImRect& nav_rect_rel = window->NavRectRel[g.NavLayer];
12678:         const float page_offset_y = ImMax(0.0f, window->InnerRect.GetHeight() - window->FontRefSize * 1.0f + nav_rect_rel.GetHeight());
12679:         float nav_scoring_rect_offset_y = 0.0f;
12680:         if (IsKeyPressed(ImGuiKey_PageUp, true))
12681:         {
12682:             nav_scoring_rect_offset_y = -page_offset_y;
12683:             g.NavMoveDir = ImGuiDir_Down; // Because our scoring rect is offset up, we request the down direction (so we can always land on the last item)
12684:             g.NavMoveClipDir = ImGuiDir_Up;
12685:             g.NavMoveFlags = ImGuiNavMoveFlags_AllowCurrentNavId | ImGuiNavMoveFlags_IsPageMove; // ImGuiNavMoveFlags_AlsoScoreVisibleSet may be added later
12686:         }
12687:         else if (IsKeyPressed(ImGuiKey_PageDown, true))
12688:         {
12689:             nav_scoring_rect_offset_y = +page_offset_y;
12690:             g.NavMoveDir = ImGuiDir_Up; // Because our scoring rect is offset down, we request the up direction (so we can always land on the last item)
12691:             g.NavMoveClipDir = ImGuiDir_Down;
12692:             g.NavMoveFlags = ImGuiNavMoveFlags_AllowCurrentNavId | ImGuiNavMoveFlags_IsPageMove; // ImGuiNavMoveFlags_AlsoScoreVisibleSet may be added later
12693:         }
12694:         else if (home_pressed)
12695:         {
12696:             // FIXME-NAV: handling of Home/End is assuming that the top/bottom most item will be visible with Scroll.y == 0/ScrollMax.y
12697:             // Scrolling will be handled via the ImGuiNavMoveFlags_ScrollToEdgeY flag, we don't scroll immediately to avoid scrolling happening before nav result.
12698:             // Preserve current horizontal position if we have any.
12699:             nav_rect_rel.Min.y = nav_rect_rel.Max.y = 0.0f;
12700:             if (nav_rect_rel.IsInverted())
12701:                 nav_rect_rel.Min.x = nav_rect_rel.Max.x = 0.0f;
12702:             g.NavMoveDir = ImGuiDir_Down;
12703:             g.NavMoveFlags = ImGuiNavMoveFlags_AllowCurrentNavId | ImGuiNavMoveFlags_ScrollToEdgeY;
12704:             // FIXME-NAV: MoveClipDir left to _None, intentional?
12705:         }
12706:         else if (end_pressed)
12707:         {
12708:             nav_rect_rel.Min.y = nav_rect_rel.Max.y = window->ContentSize.y;
12709:             if (nav_rect_rel.IsInverted())
12710:                 nav_rect_rel.Min.x = nav_rect_rel.Max.x = 0.0f;
12711:             g.NavMoveDir = ImGuiDir_Up;
12712:             g.NavMoveFlags = ImGuiNavMoveFlags_AllowCurrentNavId | ImGuiNavMoveFlags_ScrollToEdgeY;
12713:             // FIXME-NAV: MoveClipDir left to _None, intentional?
12714:         }
12715:         return nav_scoring_rect_offset_y;
12716:     }
12717:     return 0.0f;
12718: }
12719: static void ImGui::NavEndFrame()
12720: {
12721:     ImGuiContext& g = *GImGui;
12722:     // Show Ctrl+Tab list window
12723:     if (g.NavWindowingTarget != NULL)
12724:         NavUpdateWindowingOverlay();
12725:     // Perform wrap-around in menus
12726:     // FIXME-NAV: Wrap may need to apply a weight bias on the other axis. e.g. 4x4 grid with 2 last items missing on last item won't handle LoopY/WrapY correctly.
12727:     // FIXME-NAV: Wrap (not Loop) support could be handled by the scoring function and then WrapX would function without an extra frame.
12728:     if (g.NavWindow && NavMoveRequestButNoResultYet() && (g.NavMoveFlags & ImGuiNavMoveFlags_WrapMask_) && (g.NavMoveFlags & ImGuiNavMoveFlags_Forwarded) == 0)
