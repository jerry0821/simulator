387:           if (obj->KindId == SPHERE) {
388:             hit = Collision::IntersectRaySphere(test_near, dir, 0.5f, objWorld);
389:           } else if (obj->KindId == CYLINDER) {
390:             hit = Collision::IntersectRayCylinder(test_near, dir, 0.5f, 0.5f,
391:                                                  objWorld);
392:           } else if (obj->KindId == CAPSULE) {
393:             hit = Collision::IntersectRayCapsule(test_near, dir, 0.5f, 0.5f,
394:                                                 objWorld);
