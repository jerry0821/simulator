 519: // Helper: ImRect (2D axis aligned bounding-box)
 520: // NB: we can't rely on ImVec2 math operators being available here!
 521: struct IMGUI_API ImRect
 522: {
 523:     ImVec2      Min;    // Upper-left
 524:     ImVec2      Max;    // Lower-right
 525:     constexpr ImRect()                                        : Min(0.0f, 0.0f), Max(0.0f, 0.0f)  {}
 526:     constexpr ImRect(const ImVec2& min, const ImVec2& max)    : Min(min), Max(max)                {}
 527:     constexpr ImRect(const ImVec4& v)                         : Min(v.x, v.y), Max(v.z, v.w)      {}
 528:     constexpr ImRect(float x1, float y1, float x2, float y2)  : Min(x1, y1), Max(x2, y2)          {}
 529:     ImVec2      GetCenter() const                   { return ImVec2((Min.x + Max.x) * 0.5f, (Min.y + Max.y) * 0.5f); }
 530:     ImVec2      GetSize() const                     { return ImVec2(Max.x - Min.x, Max.y - Min.y); }
 531:     float       GetWidth() const                    { return Max.x - Min.x; }
 532:     float       GetHeight() const                   { return Max.y - Min.y; }
 533:     float       GetArea() const                     { return (Max.x - Min.x) * (Max.y - Min.y); }
 534:     ImVec2      GetTL() const                       { return Min; }                   // Top-left
 535:     ImVec2      GetTR() const                       { return ImVec2(Max.x, Min.y); }  // Top-right
 536:     ImVec2      GetBL() const                       { return ImVec2(Min.x, Max.y); }  // Bottom-left
 537:     ImVec2      GetBR() const                       { return Max; }                   // Bottom-right
 538:     bool        Contains(const ImVec2& p) const     { return p.x     >= Min.x && p.y     >= Min.y && p.x     <  Max.x && p.y     <  Max.y; }
 539:     bool        Contains(const ImRect& r) const     { return r.Min.x >= Min.x && r.Min.y >= Min.y && r.Max.x <= Max.x && r.Max.y <= Max.y; }
 540:     bool        ContainsWithPad(const ImVec2& p, const ImVec2& pad) const { return p.x >= Min.x - pad.x && p.y >= Min.y - pad.y && p.x < Max.x + pad.x && p.y < Max.y + pad.y; }
 541:     bool        Overlaps(const ImRect& r) const     { return r.Min.y <  Max.y && r.Max.y >  Min.y && r.Min.x <  Max.x && r.Max.x >  Min.x; }
 542:     void        Add(const ImVec2& p)                { if (Min.x > p.x)     Min.x = p.x;     if (Min.y > p.y)     Min.y = p.y;     if (Max.x < p.x)     Max.x = p.x;     if (Max.y < p.y)     Max.y = p.y; }
 543:     void        Add(const ImRect& r)                { if (Min.x > r.Min.x) Min.x = r.Min.x; if (Min.y > r.Min.y) Min.y = r.Min.y; if (Max.x < r.Max.x) Max.x = r.Max.x; if (Max.y < r.Max.y) Max.y = r.Max.y; }
 544:     void        Expand(const float amount)          { Min.x -= amount;   Min.y -= amount;   Max.x += amount;   Max.y += amount; }
 545:     void        Expand(const ImVec2& amount)        { Min.x -= amount.x; Min.y -= amount.y; Max.x += amount.x; Max.y += amount.y; }
 546:     void        Translate(const ImVec2& d)          { Min.x += d.x; Min.y += d.y; Max.x += d.x; Max.y += d.y; }
 547:     void        TranslateX(float dx)                { Min.x += dx; Max.x += dx; }
 548:     void        TranslateY(float dy)                { Min.y += dy; Max.y += dy; }
 549:     void        ClipWith(const ImRect& r)           { Min = ImMax(Min, r.Min); Max = ImMin(Max, r.Max); }                   // Simple version, may lead to an inverted rectangle, which is fine for Contains/Overlaps test but not for display.
 550:     void        ClipWithFull(const ImRect& r)       { Min = ImClamp(Min, r.Min, r.Max); Max = ImClamp(Max, r.Min, r.Max); } // Full version, ensure both points are fully clipped.
 551:     void        Floor()                             { Min.x = IM_TRUNC(Min.x); Min.y = IM_TRUNC(Min.y); Max.x = IM_TRUNC(Max.x); Max.y = IM_TRUNC(Max.y); }
 552:     bool        IsInverted() const                  { return Min.x > Max.x || Min.y > Max.y; }
 553:     ImVec4      ToVec4() const                      { return ImVec4(Min.x, Min.y, Max.x, Max.y); }
 554:     const ImVec4& AsVec4() const                    { return *(const ImVec4*)&Min.x; }
 555: };
 556: // Helper: ImBitArray
 557: #define         IM_BITARRAY_TESTBIT(_ARRAY, _N)                 ((_ARRAY[(_N) >> 5] & ((ImU32)1 << ((_N) & 31))) != 0) // Macro version of ImBitArrayTestBit(): ensure args have side-effect or are costly!
 558: #define         IM_BITARRAY_CLEARBIT(_ARRAY, _N)                ((_ARRAY[(_N) >> 5] &= ~((ImU32)1 << ((_N) & 31))))    // Macro version of ImBitArrayClearBit(): ensure args have side-effect or are costly!
 559: inline size_t   ImBitArrayGetStorageSizeInBytes(int bitcount)   { return (size_t)((bitcount + 31) >> 5) << 2; }
 560: inline void     ImBitArrayClearAllBits(ImU32* arr, int bitcount){ memset(arr, 0, ImBitArrayGetStorageSizeInBytes(bitcount)); }
 561: inline bool     ImBitArrayTestBit(const ImU32* arr, int n)      { ImU32 mask = (ImU32)1 << (n & 31); return (arr[n >> 5] & mask) != 0; }
 562: inline void     ImBitArrayClearBit(ImU32* arr, int n)           { ImU32 mask = (ImU32)1 << (n & 31); arr[n >> 5] &= ~mask; }
 563: inline void     ImBitArraySetBit(ImU32* arr, int n)             { ImU32 mask = (ImU32)1 << (n & 31); arr[n >> 5] |= mask; }
 564: inline void     ImBitArraySetBitRange(ImU32* arr, int n, int n2) // Works on range [n..n2)
 565: {
 566:     n2--;
 567:     while (n <= n2)
 568:     {
 569:         int a_mod = (n & 31);
 570:         int b_mod = (n2 > (n | 31) ? 31 : (n2 & 31)) + 1;
 571:         ImU32 mask = (ImU32)(((ImU64)1 << b_mod) - 1) & ~(ImU32)(((ImU64)1 << a_mod) - 1);
 572:         arr[n >> 5] |= mask;
 573:         n = (n + 32) & ~31;
 574:     }
 575: }
 576: typedef ImU32* ImBitArrayPtr; // Name for use in structs
 577: // Helper: ImBitArray class (wrapper over ImBitArray functions)
 578: // Store 1-bit per value.
 579: template<int BITCOUNT, int OFFSET = 0>
 580: struct ImBitArray
 581: {
 582:     ImU32           Storage[(BITCOUNT + 31) >> 5];
 583:     ImBitArray()                                { ClearAllBits(); }
 584:     void            ClearAllBits()              { memset(Storage, 0, sizeof(Storage)); }
 585:     void            SetAllBits()                { memset(Storage, 255, sizeof(Storage)); }
 586:     bool            TestBit(int n) const        { n += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT); return IM_BITARRAY_TESTBIT(Storage, n); }
 587:     void            SetBit(int n)               { n += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT); ImBitArraySetBit(Storage, n); }
 588:     void            ClearBit(int n)             { n += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT); ImBitArrayClearBit(Storage, n); }
 589:     void            SetBitRange(int n, int n2)  { n += OFFSET; n2 += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT && n2 > n && n2 <= BITCOUNT); ImBitArraySetBitRange(Storage, n, n2); } // Works on range [n..n2)
 590:     bool            operator[](int n) const     { n += OFFSET; IM_ASSERT(n >= 0 && n < BITCOUNT); return IM_BITARRAY_TESTBIT(Storage, n); }
 591: };
 592: // Helper: ImBitVector
 593: // Store 1-bit per value.
 594: struct IMGUI_API ImBitVector
 595: {
 596:     ImVector<ImU32> Storage;
 597:     void            Create(int sz)              { Storage.resize((sz + 31) >> 5); memset(Storage.Data, 0, (size_t)Storage.Size * sizeof(Storage.Data[0])); }
 598:     void            Clear()                     { Storage.clear(); }
 599:     bool            TestBit(int n) const        { IM_ASSERT(n < (Storage.Size << 5)); return IM_BITARRAY_TESTBIT(Storage.Data, n); }
 600:     void            SetBit(int n)               { IM_ASSERT(n < (Storage.Size << 5)); ImBitArraySetBit(Storage.Data, n); }
 601:     void            ClearBit(int n)             { IM_ASSERT(n < (Storage.Size << 5)); ImBitArrayClearBit(Storage.Data, n); }
 602: };
