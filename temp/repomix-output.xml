304:         _Outptr_opt_ ID3D11ShaderResourceView** textureView) noexcept
305:     {
306:         UINT width, height;
307:         HRESULT hr = frame->GetSize(&width, &height);
308:         if (FAILED(hr))
309:             return hr;
310:         if (maxsize > UINT32_MAX)
311:             return E_INVALIDARG;
312:         assert(width > 0 && height > 0);
313:         if (!maxsize)
314:         {
315:             // This is a bit conservative because the hardware could support larger textures than
316:             // the Feature Level defined minimums, but doing it this way is much easier and more
317:             // performant for WIC than the 'fail and retry' model used by DDSTextureLoader
318:             switch (d3dDevice->GetFeatureLevel())
319:             {
320:             case D3D_FEATURE_LEVEL_9_1:
321:             case D3D_FEATURE_LEVEL_9_2:
322:                 maxsize = 2048u /*D3D_FL9_1_REQ_TEXTURE2D_U_OR_V_DIMENSION*/;
323:                 break;
324:             case D3D_FEATURE_LEVEL_9_3:
325:                 maxsize = 4096u /*D3D_FL9_3_REQ_TEXTURE2D_U_OR_V_DIMENSION*/;
326:                 break;
327:             case D3D_FEATURE_LEVEL_10_0:
328:             case D3D_FEATURE_LEVEL_10_1:
329:                 maxsize = 8192u /*D3D10_REQ_TEXTURE2D_U_OR_V_DIMENSION*/;
330:                 break;
331:             default:
332:                 maxsize = size_t(D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION);
333:                 break;
334:             }
335:         }
336:         assert(maxsize > 0);
337:         UINT twidth = width;
338:         UINT theight = height;
339:         if (loadFlags & WIC_LOADER_FIT_POW2)
340:         {
341:             FitPowerOf2(width, height, twidth, theight, maxsize);
342:         }
343:         else if (width > maxsize || height > maxsize)
344:         {
345:             const float ar = static_cast<float>(height) / static_cast<float>(width);
346:             if (width > height)
347:             {
348:                 twidth = static_cast<UINT>(maxsize);
349:                 theight = std::max<UINT>(1, static_cast<UINT>(static_cast<float>(maxsize) * ar));
350:             }
351:             else
352:             {
353:                 theight = static_cast<UINT>(maxsize);
354:                 twidth = std::max<UINT>(1, static_cast<UINT>(static_cast<float>(maxsize) / ar));
355:             }
356:             assert(twidth <= maxsize && theight <= maxsize);
357:         }
358:         if (loadFlags & WIC_LOADER_MAKE_SQUARE)
359:         {
360:             twidth = std::max<UINT>(twidth, theight);
361:             theight = twidth;
362:         }
363:         // Determine format
364:         WICPixelFormatGUID pixelFormat;
365:         hr = frame->GetPixelFormat(&pixelFormat);
366:         if (FAILED(hr))
367:             return hr;
368:         WICPixelFormatGUID convertGUID;
369:         memcpy_s(&convertGUID, sizeof(WICPixelFormatGUID), &pixelFormat, sizeof(GUID));
370:         size_t bpp = 0;
371:         DXGI_FORMAT format = WICToDXGI(pixelFormat);
372:         if (format == DXGI_FORMAT_UNKNOWN)
373:         {
374:             if (memcmp(&GUID_WICPixelFormat96bppRGBFixedPoint, &pixelFormat, sizeof(WICPixelFormatGUID)) == 0)
375:             {
376:                 if (g_WIC2)
377:                 {
378:                     memcpy_s(&convertGUID, sizeof(WICPixelFormatGUID), &GUID_WICPixelFormat96bppRGBFloat, sizeof(GUID));
379:                     format = DXGI_FORMAT_R32G32B32_FLOAT;
380:                     bpp = 96;
381:                 }
382:                 else
383:                 {
384:                     memcpy_s(&convertGUID, sizeof(WICPixelFormatGUID), &GUID_WICPixelFormat128bppRGBAFloat, sizeof(GUID));
385:                     format = DXGI_FORMAT_R32G32B32A32_FLOAT;
386:                     bpp = 128;
387:                 }
388:             }
389:             else
390:             {
391:                 for (size_t i = 0; i < std::size(g_WICConvert); ++i)
392:                 {
393:                     if (memcmp(&g_WICConvert[i].source, &pixelFormat, sizeof(WICPixelFormatGUID)) == 0)
394:                     {
395:                         memcpy_s(&convertGUID, sizeof(WICPixelFormatGUID), &g_WICConvert[i].target, sizeof(GUID));
396:                         format = WICToDXGI(g_WICConvert[i].target);
397:                         assert(format != DXGI_FORMAT_UNKNOWN);
398:                         bpp = WICBitsPerPixel(convertGUID);
399:                         break;
400:                     }
401:                 }
402:             }
403:             if (format == DXGI_FORMAT_UNKNOWN)
404:                 return HRESULT_FROM_WIN32(ERROR_NOT_SUPPORTED);
405:         }
406:         else
407:         {
408:             bpp = WICBitsPerPixel(pixelFormat);
409:         }
410:         if ((format == DXGI_FORMAT_R32G32B32_FLOAT) && d3dContext && textureView)
411:         {
412:             // Special case test for optional device support for autogen mipchains for R32G32B32_FLOAT
413:             UINT fmtSupport = 0;
414:             hr = d3dDevice->CheckFormatSupport(DXGI_FORMAT_R32G32B32_FLOAT, &fmtSupport);
415:             if (FAILED(hr) || !(fmtSupport & D3D11_FORMAT_SUPPORT_MIP_AUTOGEN))
416:             {
417:                 // Use R32G32B32A32_FLOAT instead which is required for Feature Level 10.0 and up
418:                 memcpy_s(&convertGUID, sizeof(WICPixelFormatGUID), &GUID_WICPixelFormat128bppRGBAFloat, sizeof(GUID));
419:                 format = DXGI_FORMAT_R32G32B32A32_FLOAT;
420:                 bpp = 128;
421:             }
422:         }
423:         if (loadFlags & WIC_LOADER_FORCE_RGBA32)
424:         {
425:             memcpy_s(&convertGUID, sizeof(WICPixelFormatGUID), &GUID_WICPixelFormat32bppRGBA, sizeof(GUID));
426:             format = DXGI_FORMAT_R8G8B8A8_UNORM;
427:             bpp = 32;
428:         }
429:         if (!bpp)
430:             return E_FAIL;
431:         // Handle sRGB formats
432:         if (loadFlags & WIC_LOADER_FORCE_SRGB)
433:         {
434:             format = MakeSRGB(format);
435:         }
436:         else if (!(loadFlags & WIC_LOADER_IGNORE_SRGB))
437:         {
438:             ComPtr<IWICMetadataQueryReader> metareader;
439:             if (SUCCEEDED(frame->GetMetadataQueryReader(metareader.GetAddressOf())))
440:             {
441:                 GUID containerFormat;
442:                 if (SUCCEEDED(metareader->GetContainerFormat(&containerFormat)))
443:                 {
444:                     bool sRGB = false;
445:                     PROPVARIANT value;
446:                     PropVariantInit(&value);
447:                     // Check for colorspace chunks
448:                     if (memcmp(&containerFormat, &GUID_ContainerFormatPng, sizeof(GUID)) == 0)
449:                     {
450:                         if (SUCCEEDED(metareader->GetMetadataByName(L"/sRGB/RenderingIntent", &value)) && value.vt == VT_UI1)
451:                         {
452:                             sRGB = true;
453:                         }
454:                         else if (SUCCEEDED(metareader->GetMetadataByName(L"/gAMA/ImageGamma", &value)) && value.vt == VT_UI4)
455:                         {
456:                             sRGB = (value.uintVal == 45455);
457:                         }
458:                         else
459:                         {
460:                             sRGB = (loadFlags & WIC_LOADER_SRGB_DEFAULT) != 0;
461:                         }
462:                     }
463:                     else if (SUCCEEDED(metareader->GetMetadataByName(L"System.Image.ColorSpace", &value)) && value.vt == VT_UI2)
464:                     {
465:                         sRGB = (value.uiVal == 1);
466:                     }
467:                     else
468:                     {
469:                         sRGB = (loadFlags & WIC_LOADER_SRGB_DEFAULT) != 0;
470:                     }
471:                     std::ignore = PropVariantClear(&value);
472:                     if (sRGB)
473:                         format = MakeSRGB(format);
474:                 }
475:             }
476:         }
477:         // Verify our target format is supported by the current device
478:         // (handles WDDM 1.0 or WDDM 1.1 device driver cases as well as DirectX 11.0 Runtime without 16bpp format support)
479:         UINT support = 0;
480:         hr = d3dDevice->CheckFormatSupport(format, &support);
481:         if (FAILED(hr) || !(support & D3D11_FORMAT_SUPPORT_TEXTURE2D))
482:         {
483:             // Fallback to RGBA 32-bit format which is supported by all devices
484:             memcpy_s(&convertGUID, sizeof(WICPixelFormatGUID), &GUID_WICPixelFormat32bppRGBA, sizeof(GUID));
485:             format = DXGI_FORMAT_R8G8B8A8_UNORM;
486:             bpp = 32;
487:         }
488:         // Allocate temporary memory for image
489:         const uint64_t rowBytes = (uint64_t(twidth) * uint64_t(bpp) + 7u) / 8u;
490:         const uint64_t numBytes = rowBytes * uint64_t(theight);
491:         if (rowBytes > UINT32_MAX || numBytes > UINT32_MAX)
492:             return HRESULT_FROM_WIN32(ERROR_ARITHMETIC_OVERFLOW);
493:         const auto rowPitch = static_cast<size_t>(rowBytes);
494:         const auto imageSize = static_cast<size_t>(numBytes);
495:         std::unique_ptr<uint8_t[]> temp(new (std::nothrow) uint8_t[imageSize]);
496:         if (!temp)
497:             return E_OUTOFMEMORY;
498:         // Load image data
499:         if (memcmp(&convertGUID, &pixelFormat, sizeof(GUID)) == 0
500:             && twidth == width
501:             && theight == height)
502:         {
503:             // No format conversion or resize needed
504:             hr = frame->CopyPixels(nullptr, static_cast<UINT>(rowPitch), static_cast<UINT>(imageSize), temp.get());
505:             if (FAILED(hr))
506:                 return hr;
507:         }
508:         else if (twidth != width || theight != height)
509:         {
510:             // Resize
511:             auto pWIC = GetWIC();
512:             if (!pWIC)
513:                 return E_NOINTERFACE;
514:             ComPtr<IWICBitmapScaler> scaler;
515:             hr = pWIC->CreateBitmapScaler(scaler.GetAddressOf());
516:             if (FAILED(hr))
517:                 return hr;
518:             hr = scaler->Initialize(frame, twidth, theight, WICBitmapInterpolationModeFant);
519:             if (FAILED(hr))
520:                 return hr;
521:             WICPixelFormatGUID pfScaler;
522:             hr = scaler->GetPixelFormat(&pfScaler);
523:             if (FAILED(hr))
524:                 return hr;
525:             if (memcmp(&convertGUID, &pfScaler, sizeof(GUID)) == 0)
526:             {
527:                 // No format conversion needed
528:                 hr = scaler->CopyPixels(nullptr, static_cast<UINT>(rowPitch), static_cast<UINT>(imageSize), temp.get());
529:                 if (FAILED(hr))
530:                     return hr;
531:             }
532:             else
533:             {
534:                 ComPtr<IWICFormatConverter> FC;
535:                 hr = pWIC->CreateFormatConverter(FC.GetAddressOf());
536:                 if (FAILED(hr))
537:                     return hr;
538:                 BOOL canConvert = FALSE;
539:                 hr = FC->CanConvert(pfScaler, convertGUID, &canConvert);
540:                 if (FAILED(hr) || !canConvert)
541:                 {
542:                     return E_UNEXPECTED;
543:                 }
544:                 hr = FC->Initialize(scaler.Get(), convertGUID, WICBitmapDitherTypeErrorDiffusion, nullptr, 0, WICBitmapPaletteTypeMedianCut);
545:                 if (FAILED(hr))
546:                     return hr;
547:                 hr = FC->CopyPixels(nullptr, static_cast<UINT>(rowPitch), static_cast<UINT>(imageSize), temp.get());
548:                 if (FAILED(hr))
549:                     return hr;
550:             }
551:         }
552:         else
553:         {
554:             // Format conversion but no resize
555:             auto pWIC = GetWIC();
556:             if (!pWIC)
557:                 return E_NOINTERFACE;
558:             ComPtr<IWICFormatConverter> FC;
559:             hr = pWIC->CreateFormatConverter(FC.GetAddressOf());
560:             if (FAILED(hr))
561:                 return hr;
562:             BOOL canConvert = FALSE;
563:             hr = FC->CanConvert(pixelFormat, convertGUID, &canConvert);
564:             if (FAILED(hr) || !canConvert)
565:             {
566:                 return E_UNEXPECTED;
567:             }
568:             hr = FC->Initialize(frame, convertGUID, WICBitmapDitherTypeErrorDiffusion, nullptr, 0, WICBitmapPaletteTypeMedianCut);
569:             if (FAILED(hr))
570:                 return hr;
571:             hr = FC->CopyPixels(nullptr, static_cast<UINT>(rowPitch), static_cast<UINT>(imageSize), temp.get());
572:             if (FAILED(hr))
573:                 return hr;
574:         }
575:         // See if format is supported for auto-gen mipmaps (varies by feature level)
576:         bool autogen = false;
577:         if (d3dContext && textureView) // Must have context and shader-view to auto generate mipmaps
578:         {
579:             UINT fmtSupport = 0;
580:             hr = d3dDevice->CheckFormatSupport(format, &fmtSupport);
581:             if (SUCCEEDED(hr) && (fmtSupport & D3D11_FORMAT_SUPPORT_MIP_AUTOGEN))
582:             {
583:                 autogen = true;
584:             }
585:         }
586:         // Create texture
587:         D3D11_TEXTURE2D_DESC desc = {};
588:         desc.Width = twidth;
589:         desc.Height = theight;
590:         desc.MipLevels = (autogen) ? 0u : 1u;
591:         desc.ArraySize = 1;
592:         desc.Format = format;
593:         desc.SampleDesc.Count = 1;
594:         desc.SampleDesc.Quality = 0;
595:         desc.Usage = usage;
596:         desc.CPUAccessFlags = cpuAccessFlags;
597:         if (autogen)
598:         {
599:             desc.BindFlags = bindFlags | D3D11_BIND_RENDER_TARGET;
600:             desc.MiscFlags = miscFlags | D3D11_RESOURCE_MISC_GENERATE_MIPS;
601:         }
602:         else
603:         {
604:             desc.BindFlags = bindFlags;
605:             desc.MiscFlags = miscFlags;
606:         }
607:         D3D11_SUBRESOURCE_DATA initData;
608:         initData.pSysMem = temp.get();
609:         initData.SysMemPitch = static_cast<UINT>(rowPitch);
610:         initData.SysMemSlicePitch = static_cast<UINT>(imageSize);
611:         ID3D11Texture2D* tex = nullptr;
612:         hr = d3dDevice->CreateTexture2D(&desc, (autogen) ? nullptr : &initData, &tex);
613:         if (SUCCEEDED(hr) && tex)
614:         {
615:             if (textureView)
616:             {
617:                 D3D11_SHADER_RESOURCE_VIEW_DESC SRVDesc = {};
618:                 SRVDesc.Format = desc.Format;
619:                 SRVDesc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
620:                 SRVDesc.Texture2D.MipLevels = (autogen) ? unsigned(-1) : 1u;
621:                 hr = d3dDevice->CreateShaderResourceView(tex, &SRVDesc, textureView);
622:                 if (FAILED(hr))
623:                 {
624:                     tex->Release();
625:                     return hr;
626:                 }
627:                 if (autogen)
628:                 {
629:                     assert(d3dContext != nullptr);
630:                     d3dContext->UpdateSubresource(tex, 0, nullptr, temp.get(), static_cast<UINT>(rowPitch), static_cast<UINT>(imageSize));
631:                     d3dContext->GenerateMips(*textureView);
632:                 }
633:             }
634:             if (texture)
635:             {
636:                 *texture = tex;
637:             }
638:             else
639:             {
640:                 SetDebugObjectName(tex, "WICTextureLoader");
641:                 tex->Release();
642:             }
643:         }
644:         return hr;
645:     }
646:     //--------------------------------------------------------------------------------------
647:     void SetDebugTextureInfo(
648:         _In_z_ const wchar_t* fileName,
649:         _In_opt_ ID3D11Resource** texture,
650:         _In_opt_ ID3D11ShaderResourceView** textureView) noexcept
651:     {
652:     #if !defined(NO_D3D11_DEBUG_NAME) && ( defined(_DEBUG) || defined(PROFILE) )
653:         if (texture || textureView)
654:         {
655:             CHAR strFileA[MAX_PATH];
656:             const int result = WideCharToMultiByte(CP_UTF8,
657:                 WC_NO_BEST_FIT_CHARS,
658:                 fileName,
659:                 -1,
660:                 strFileA,
661:                 MAX_PATH,
662:                 nullptr,
663:                 nullptr
664:             );
665:             if (result > 0)
666:             {
667:                 if (texture && *texture)
668:                 {
669:                     (*texture)->SetPrivateData(WKPDID_D3DDebugObjectName,
670:                         static_cast<UINT>(result),
671:                         strFileA
672:                     );
673:                 }
674:                 if (textureView && *textureView)
675:                 {
676:                     (*textureView)->SetPrivateData(WKPDID_D3DDebugObjectName,
677:                         static_cast<UINT>(result),
678:                         strFileA
679:                     );
680:                 }
681:             }
682:         }
683:     #else
684:         UNREFERENCED_PARAMETER(fileName);
685:         UNREFERENCED_PARAMETER(texture);
686:         UNREFERENCED_PARAMETER(textureView);
687:     #endif
688:     }
