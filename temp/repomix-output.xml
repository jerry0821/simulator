440: bool configureBackBuffer()
441: {
442: 	HRESULT hr;
443: 	ID3D11Texture2D* back_buffer_pointer = nullptr;
444: 	// バックバッファの取得
445: 	hr = g_pSwapChain->GetBuffer(0, __uuidof(ID3D11Texture2D), (void**)&back_buffer_pointer);
446: 	if (FAILED(hr)) {
447: 		hal::dout << "バックバッファの取得に失敗しました" << std::endl;
448: 		return false;
449: 	}
450: 	// バックバッファのレンダーターゲットビューの生成
451: 	hr = g_pDevice->CreateRenderTargetView(back_buffer_pointer, nullptr, &g_pRenderTargetView);
452: 	if (FAILED(hr)) {
453: 		back_buffer_pointer->Release();
454: 		hal::dout << "バックバッファのレンダーターゲットビューの生成に失敗しました" << std::endl;
455: 		return false;
456: 	}
457: 	// バックバッファの状態（情報）を取得
458: 	back_buffer_pointer->GetDesc(&g_BackBufferDesc);
459: 	back_buffer_pointer->Release(); // バックバッファのポインタは不要なので解放
460: 	// デプスステンシルバッファの生成
461: 	D3D11_TEXTURE2D_DESC depth_stencil_desc{};
462: 	depth_stencil_desc.Width = g_BackBufferDesc.Width;
463: 	depth_stencil_desc.Height = g_BackBufferDesc.Height;
464: 	depth_stencil_desc.MipLevels = 1;
465: 	depth_stencil_desc.ArraySize = 1;
466: 	depth_stencil_desc.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
467: 	depth_stencil_desc.SampleDesc.Count = 1;
468: 	depth_stencil_desc.SampleDesc.Quality = 0;
469: 	depth_stencil_desc.Usage = D3D11_USAGE_DEFAULT;
470: 	depth_stencil_desc.BindFlags = D3D11_BIND_DEPTH_STENCIL;
471: 	depth_stencil_desc.CPUAccessFlags = 0;
472: 	depth_stencil_desc.MiscFlags = 0;
473: 	hr = g_pDevice->CreateTexture2D(&depth_stencil_desc, nullptr, &g_pDepthStencilBuffer);
474: 	if (FAILED(hr)) {
475: 		hal::dout << "デプスステンシルバッファの生成に失敗しました" << std::endl;
476: 		return false;
477: 	}
478: 	// デプスステンシルビューの生成
479: 	D3D11_DEPTH_STENCIL_VIEW_DESC depth_stencil_view_desc{};
480: 	depth_stencil_view_desc.Format = depth_stencil_desc.Format;
481: 	depth_stencil_view_desc.ViewDimension = D3D11_DSV_DIMENSION_TEXTURE2D;
482: 	depth_stencil_view_desc.Texture2D.MipSlice = 0;
483: 	depth_stencil_view_desc.Flags = 0;
484: 	hr = g_pDevice->CreateDepthStencilView(g_pDepthStencilBuffer, &depth_stencil_view_desc, &g_pDepthStencilView);
485: 	if (FAILED(hr)) {
486: 		hal::dout << "デプスステンシルビューの生成に失敗しました" << std::endl;
487: 		return false;
488: 	}
489: 	// ビューポートの設定 
490: 	g_Viewport.TopLeftX = 0.0f;
491: 	g_Viewport.TopLeftY = 0.0f;
492: 	g_Viewport.Width = static_cast<FLOAT>(g_BackBufferDesc.Width);
493: 	g_Viewport.Height = static_cast<FLOAT>(g_BackBufferDesc.Height);
494: 	g_Viewport.MinDepth = 0.0f;
495: 	g_Viewport.MaxDepth = 1.0f;
496: 	//g_pDeviceContext->RSSetViewports(1, &g_Viewport); // ビューポートの設定
497: 	return true;
498: }
