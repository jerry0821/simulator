 289: //-----------------------------------------------------------------------------
 290: // [SECTION] Texture identifiers (ImTextureID, ImTextureRef)
 291: //-----------------------------------------------------------------------------
 292: // ImTextureID = backend specific, low-level identifier for a texture uploaded in GPU/graphics system.
 293: // [Compile-time configurable type]
 294: // - When a Rendered Backend creates a texture, it store its native identifier into a ImTextureID value.
 295: //   (e.g. Used by DX11 backend to a `ID3D11ShaderResourceView*`; Used by OpenGL backends to store `GLuint`;
 296: //         Used by SDLGPU backend to store a `SDL_GPUTextureSamplerBinding*`, etc.).
 297: // - User may submit their own textures to e.g. ImGui::Image() function by passing this value.
 298: // - During the rendering loop, the Renderer Backend retrieve the ImTextureID, which stored inside a
 299: //   ImTextureRef, which is stored inside a ImDrawCmd.
 300: // - Compile-time type configuration:
 301: //   - To use something other than a 64-bit value: add '#define ImTextureID MyTextureType*' in your imconfig.h file.
 302: //   - This can be whatever to you want it to be! read the FAQ entry about textures for details.
 303: //   - You may decide to store a higher-level structure containing texture, sampler, shader etc. with various
 304: //     constructors if you like. You will need to implement ==/!= operators.
 305: // History:
 306: // - In v1.91.4 (2024/10/08): the default type for ImTextureID was changed from 'void*' to 'ImU64'. This allowed backends requiring 64-bit worth of data to build on 32-bit architectures. Use intermediary intptr_t cast and read FAQ if you have casting warnings.
 307: // - In v1.92.0 (2025/06/11): added ImTextureRef which carry either a ImTextureID either a pointer to internal texture atlas. All user facing functions taking ImTextureID changed to ImTextureRef
 308: #ifndef ImTextureID
 309: typedef ImU64 ImTextureID;      // Default: store up to 64-bits (any pointer or integer). A majority of backends are ok with that.
 310: #endif
 311: // Define this if you need 0 to be a valid ImTextureID for your backend.
 312: #ifndef ImTextureID_Invalid
 313: #define ImTextureID_Invalid     ((ImTextureID)0)
 314: #endif
 315: // ImTextureRef = higher-level identifier for a texture. Store a ImTextureID _or_ a ImTextureData*.
 316: // The identifier is valid even before the texture has been uploaded to the GPU/graphics system.
 317: // This is what gets passed to functions such as `ImGui::Image()`, `ImDrawList::AddImage()`.
 318: // This is what gets stored in draw commands (`ImDrawCmd`) to identify a texture during rendering.
 319: // - When a texture is created by user code (e.g. custom images), we directly stores the low-level ImTextureID.
 320: //   Because of this, when displaying your own texture you are likely to ever only manage ImTextureID values on your side.
 321: // - When a texture is created by the backend, we stores a ImTextureData* which becomes an indirection
 322: //   to extract the ImTextureID value during rendering, after texture upload has happened.
 323: // - To create a ImTextureRef from a ImTextureData you can use ImTextureData::GetTexRef().
 324: //   We intentionally do not provide an ImTextureRef constructor for this: we don't expect this
 325: //   to be frequently useful to the end-user, and it would be erroneously called by many legacy code.
 326: // - If you want to bind the current atlas when using custom rectangle, you can use io.Fonts->TexRef.
 327: // - Binding generators for languages such as C (which don't have constructors), should provide a helper, e.g.
 328: //      inline ImTextureRef ImTextureRefFromID(ImTextureID tex_id) { ImTextureRef tex_ref = { ._TexData = NULL, .TexID = tex_id }; return tex_ref; }
 329: // In 1.92 we changed most drawing functions using ImTextureID to use ImTextureRef.
 330: // We intentionally do not provide an implicit ImTextureRef -> ImTextureID cast operator because it is technically lossy to convert ImTextureRef to ImTextureID before rendering.
 331: IM_MSVC_RUNTIME_CHECKS_OFF
 332: struct ImTextureRef
 333: {
 334:     ImTextureRef()                          { _TexData = NULL; _TexID = ImTextureID_Invalid; }
 335:     ImTextureRef(ImTextureID tex_id)        { _TexData = NULL; _TexID = tex_id; }
 336: #if !defined(IMGUI_DISABLE_OBSOLETE_FUNCTIONS) && !defined(ImTextureID)
 337:     ImTextureRef(void* tex_id)              { _TexData = NULL; _TexID = (ImTextureID)(size_t)tex_id; }  // For legacy backends casting to ImTextureID
 338: #endif
 339:     inline ImTextureID  GetTexID() const;   // == (_TexData ? _TexData->TexID : _TexID) // Implemented below in the file.
 340:     // Members (either are set, never both!)
 341:     ImTextureData*      _TexData;           //      A texture, generally owned by a ImFontAtlas. Will convert to ImTextureID during render loop, after texture has been uploaded.
 342:     ImTextureID         _TexID;             // _OR_ Low-level backend texture identifier, if already uploaded or created by user/app. Generally provided to e.g. ImGui::Image() calls.
 343: };
