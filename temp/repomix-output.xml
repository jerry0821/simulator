1641:     int                     _TrianglesLeft = 0;
1642:     ImTriangulatorNode*     _Nodes = NULL;
1643:     ImTriangulatorNodeSpan  _Ears;
1644:     ImTriangulatorNodeSpan  _Reflexes;
1645: };
1646: // Distribute storage for nodes, ears and reflexes.
1647: // FIXME-OPT: if everything is convex, we could report it to caller and let it switch to an convex renderer
1648: // (this would require first building reflexes to bail to convex if empty, without even building nodes)
1649: void ImTriangulator::Init(const ImVec2* points, int points_count, void* scratch_buffer)
1650: {
1651:     IM_ASSERT(scratch_buffer != NULL && points_count >= 3);
1652:     _TrianglesLeft = EstimateTriangleCount(points_count);
1653:     _Nodes         = (ImTriangulatorNode*)scratch_buffer;                          // points_count x Node
1654:     _Ears.Data     = (ImTriangulatorNode**)(_Nodes + points_count);                // points_count x Node*
1655:     _Reflexes.Data = (ImTriangulatorNode**)(_Nodes + points_count) + points_count; // points_count x Node*
1656:     BuildNodes(points, points_count);
1657:     BuildReflexes();
1658:     BuildEars();
1659: }
1660: void ImTriangulator::BuildNodes(const ImVec2* points, int points_count)
1661: {
1662:     for (int i = 0; i < points_count; i++)
1663:     {
1664:         _Nodes[i].Type = ImTriangulatorNodeType_Convex;
1665:         _Nodes[i].Index = i;
1666:         _Nodes[i].Pos = points[i];
1667:         _Nodes[i].Next = _Nodes + i + 1;
1668:         _Nodes[i].Prev = _Nodes + i - 1;
1669:     }
1670:     _Nodes[0].Prev = _Nodes + points_count - 1;
1671:     _Nodes[points_count - 1].Next = _Nodes;
1672: }
1673: void ImTriangulator::BuildReflexes()
1674: {
1675:     ImTriangulatorNode* n1 = _Nodes;
1676:     for (int i = _TrianglesLeft; i >= 0; i--, n1 = n1->Next)
1677:     {
1678:         if (ImTriangleIsClockwise(n1->Prev->Pos, n1->Pos, n1->Next->Pos))
1679:             continue;
1680:         n1->Type = ImTriangulatorNodeType_Reflex;
1681:         _Reflexes.push_back(n1);
1682:     }
1683: }
1684: void ImTriangulator::BuildEars()
1685: {
1686:     ImTriangulatorNode* n1 = _Nodes;
1687:     for (int i = _TrianglesLeft; i >= 0; i--, n1 = n1->Next)
1688:     {
1689:         if (n1->Type != ImTriangulatorNodeType_Convex)
1690:             continue;
1691:         if (!IsEar(n1->Prev->Index, n1->Index, n1->Next->Index, n1->Prev->Pos, n1->Pos, n1->Next->Pos))
1692:             continue;
1693:         n1->Type = ImTriangulatorNodeType_Ear;
1694:         _Ears.push_back(n1);
1695:     }
1696: }
1697: void ImTriangulator::GetNextTriangle(unsigned int out_triangle[3])
1698: {
1699:     if (_Ears.Size == 0)
1700:     {
1701:         FlipNodeList();
1702:         ImTriangulatorNode* node = _Nodes;
1703:         for (int i = _TrianglesLeft; i >= 0; i--, node = node->Next)
1704:             node->Type = ImTriangulatorNodeType_Convex;
1705:         _Reflexes.Size = 0;
1706:         BuildReflexes();
1707:         BuildEars();
1708:         // If we still don't have ears, it means geometry is degenerated.
1709:         if (_Ears.Size == 0)
1710:         {
1711:             // Return first triangle available, mimicking the behavior of convex fill.
1712:             IM_ASSERT(_TrianglesLeft > 0); // Geometry is degenerated
1713:             _Ears.Data[0] = _Nodes;
1714:             _Ears.Size    = 1;
1715:         }
1716:     }
1717:     ImTriangulatorNode* ear = _Ears.Data[--_Ears.Size];
1718:     out_triangle[0] = ear->Prev->Index;
1719:     out_triangle[1] = ear->Index;
1720:     out_triangle[2] = ear->Next->Index;
1721:     ear->Unlink();
1722:     if (ear == _Nodes)
1723:         _Nodes = ear->Next;
1724:     ReclassifyNode(ear->Prev);
1725:     ReclassifyNode(ear->Next);
1726:     _TrianglesLeft--;
1727: }
1728: void ImTriangulator::FlipNodeList()
1729: {
1730:     ImTriangulatorNode* prev = _Nodes;
1731:     ImTriangulatorNode* temp = _Nodes;
1732:     ImTriangulatorNode* current = _Nodes->Next;
1733:     prev->Next = prev;
1734:     prev->Prev = prev;
1735:     while (current != _Nodes)
1736:     {
1737:         temp = current->Next;
1738:         current->Next = prev;
1739:         prev->Prev = current;
1740:         _Nodes->Next = current;
1741:         current->Prev = _Nodes;
1742:         prev = current;
1743:         current = temp;
1744:     }
1745:     _Nodes = prev;
1746: }
1747: // A triangle is an ear is no other vertex is inside it. We can test reflexes vertices only (see reference algorithm)
1748: bool ImTriangulator::IsEar(int i0, int i1, int i2, const ImVec2& v0, const ImVec2& v1, const ImVec2& v2) const
1749: {
1750:     ImTriangulatorNode** p_end = _Reflexes.Data + _Reflexes.Size;
1751:     for (ImTriangulatorNode** p = _Reflexes.Data; p < p_end; p++)
1752:     {
1753:         ImTriangulatorNode* reflex = *p;
1754:         if (reflex->Index != i0 && reflex->Index != i1 && reflex->Index != i2)
1755:             if (ImTriangleContainsPoint(v0, v1, v2, reflex->Pos))
1756:                 return false;
1757:     }
1758:     return true;
1759: }
1760: void ImTriangulator::ReclassifyNode(ImTriangulatorNode* n1)
1761: {
1762:     // Classify node
1763:     ImTriangulatorNodeType type;
1764:     const ImTriangulatorNode* n0 = n1->Prev;
1765:     const ImTriangulatorNode* n2 = n1->Next;
1766:     if (!ImTriangleIsClockwise(n0->Pos, n1->Pos, n2->Pos))
1767:         type = ImTriangulatorNodeType_Reflex;
1768:     else if (IsEar(n0->Index, n1->Index, n2->Index, n0->Pos, n1->Pos, n2->Pos))
1769:         type = ImTriangulatorNodeType_Ear;
1770:     else
1771:         type = ImTriangulatorNodeType_Convex;
1772:     // Update lists when a type changes
1773:     if (type == n1->Type)
1774:         return;
1775:     if (n1->Type == ImTriangulatorNodeType_Reflex)
1776:         _Reflexes.find_erase_unsorted(n1->Index);
1777:     else if (n1->Type == ImTriangulatorNodeType_Ear)
1778:         _Ears.find_erase_unsorted(n1->Index);
1779:     if (type == ImTriangulatorNodeType_Reflex)
1780:         _Reflexes.push_back(n1);
1781:     else if (type == ImTriangulatorNodeType_Ear)
1782:         _Ears.push_back(n1);
1783:     n1->Type = type;
1784: }
1785: // Use ear-clipping algorithm to triangulate a simple polygon (no self-interaction, no holes).
1786: // (Reminder: we don't perform any coarse clipping/culling in ImDrawList layer!
1787: // It is up to caller to ensure not making costly calls that will be outside of visible area.
1788: // As concave fill is noticeably more expensive than other primitives, be mindful of this...
1789: // Caller can build AABB of points, and avoid filling if 'draw_list->_CmdHeader.ClipRect.Overlays(points_bb) == false')
1790: void ImDrawList::AddConcavePolyFilled(const ImVec2* points, const int points_count, ImU32 col)
1791: {
1792:     if (points_count < 3 || (col & IM_COL32_A_MASK) == 0)
1793:         return;
1794:     const ImVec2 uv = _Data->TexUvWhitePixel;
1795:     ImTriangulator triangulator;
1796:     unsigned int triangle[3];
1797:     if (Flags & ImDrawListFlags_AntiAliasedFill)
1798:     {
1799:         // Anti-aliased Fill
1800:         const float AA_SIZE = _FringeScale;
1801:         const ImU32 col_trans = col & ~IM_COL32_A_MASK;
1802:         const int idx_count = (points_count - 2) * 3 + points_count * 6;
1803:         const int vtx_count = (points_count * 2);
1804:         PrimReserve(idx_count, vtx_count);
1805:         // Add indexes for fill
1806:         unsigned int vtx_inner_idx = _VtxCurrentIdx;
1807:         unsigned int vtx_outer_idx = _VtxCurrentIdx + 1;
1808:         _Data->TempBuffer.reserve_discard((ImTriangulator::EstimateScratchBufferSize(points_count) + sizeof(ImVec2)) / sizeof(ImVec2));
1809:         triangulator.Init(points, points_count, _Data->TempBuffer.Data);
1810:         while (triangulator._TrianglesLeft > 0)
1811:         {
1812:             triangulator.GetNextTriangle(triangle);
1813:             _IdxWritePtr[0] = (ImDrawIdx)(vtx_inner_idx + (triangle[0] << 1)); _IdxWritePtr[1] = (ImDrawIdx)(vtx_inner_idx + (triangle[1] << 1)); _IdxWritePtr[2] = (ImDrawIdx)(vtx_inner_idx + (triangle[2] << 1));
1814:             _IdxWritePtr += 3;
1815:         }
1816:         // Compute normals
1817:         _Data->TempBuffer.reserve_discard(points_count);
1818:         ImVec2* temp_normals = _Data->TempBuffer.Data;
1819:         for (int i0 = points_count - 1, i1 = 0; i1 < points_count; i0 = i1++)
1820:         {
1821:             const ImVec2& p0 = points[i0];
1822:             const ImVec2& p1 = points[i1];
1823:             float dx = p1.x - p0.x;
1824:             float dy = p1.y - p0.y;
1825:             IM_NORMALIZE2F_OVER_ZERO(dx, dy);
1826:             temp_normals[i0].x = dy;
1827:             temp_normals[i0].y = -dx;
1828:         }
1829:         for (int i0 = points_count - 1, i1 = 0; i1 < points_count; i0 = i1++)
1830:         {
1831:             // Average normals
1832:             const ImVec2& n0 = temp_normals[i0];
1833:             const ImVec2& n1 = temp_normals[i1];
1834:             float dm_x = (n0.x + n1.x) * 0.5f;
1835:             float dm_y = (n0.y + n1.y) * 0.5f;
1836:             IM_FIXNORMAL2F(dm_x, dm_y);
1837:             dm_x *= AA_SIZE * 0.5f;
1838:             dm_y *= AA_SIZE * 0.5f;
1839:             // Add vertices
1840:             _VtxWritePtr[0].pos.x = (points[i1].x - dm_x); _VtxWritePtr[0].pos.y = (points[i1].y - dm_y); _VtxWritePtr[0].uv = uv; _VtxWritePtr[0].col = col;        // Inner
1841:             _VtxWritePtr[1].pos.x = (points[i1].x + dm_x); _VtxWritePtr[1].pos.y = (points[i1].y + dm_y); _VtxWritePtr[1].uv = uv; _VtxWritePtr[1].col = col_trans;  // Outer
1842:             _VtxWritePtr += 2;
1843:             // Add indexes for fringes
1844:             _IdxWritePtr[0] = (ImDrawIdx)(vtx_inner_idx + (i1 << 1)); _IdxWritePtr[1] = (ImDrawIdx)(vtx_inner_idx + (i0 << 1)); _IdxWritePtr[2] = (ImDrawIdx)(vtx_outer_idx + (i0 << 1));
1845:             _IdxWritePtr[3] = (ImDrawIdx)(vtx_outer_idx + (i0 << 1)); _IdxWritePtr[4] = (ImDrawIdx)(vtx_outer_idx + (i1 << 1)); _IdxWritePtr[5] = (ImDrawIdx)(vtx_inner_idx + (i1 << 1));
1846:             _IdxWritePtr += 6;
1847:         }
1848:         _VtxCurrentIdx += (ImDrawIdx)vtx_count;
1849:     }
1850:     else
1851:     {
1852:         // Non Anti-aliased Fill
1853:         const int idx_count = (points_count - 2) * 3;
1854:         const int vtx_count = points_count;
1855:         PrimReserve(idx_count, vtx_count);
1856:         for (int i = 0; i < vtx_count; i++)
1857:         {
1858:             _VtxWritePtr[0].pos = points[i]; _VtxWritePtr[0].uv = uv; _VtxWritePtr[0].col = col;
1859:             _VtxWritePtr++;
1860:         }
1861:         _Data->TempBuffer.reserve_discard((ImTriangulator::EstimateScratchBufferSize(points_count) + sizeof(ImVec2)) / sizeof(ImVec2));
1862:         triangulator.Init(points, points_count, _Data->TempBuffer.Data);
1863:         while (triangulator._TrianglesLeft > 0)
1864:         {
1865:             triangulator.GetNextTriangle(triangle);
1866:             _IdxWritePtr[0] = (ImDrawIdx)(_VtxCurrentIdx + triangle[0]); _IdxWritePtr[1] = (ImDrawIdx)(_VtxCurrentIdx + triangle[1]); _IdxWritePtr[2] = (ImDrawIdx)(_VtxCurrentIdx + triangle[2]);
1867:             _IdxWritePtr += 3;
1868:         }
1869:         _VtxCurrentIdx += (ImDrawIdx)vtx_count;
1870:     }
1871: }
1872: //-----------------------------------------------------------------------------
1873: // [SECTION] ImDrawListSplitter
1874: //-----------------------------------------------------------------------------
1875: // FIXME: This may be a little confusing, trying to be a little too low-level/optimal instead of just doing vector swap..
1876: //-----------------------------------------------------------------------------
1877: void ImDrawListSplitter::ClearFreeMemory()
1878: {
1879:     for (int i = 0; i < _Channels.Size; i++)
1880:     {
1881:         if (i == _Current)
1882:             memset(&_Channels[i], 0, sizeof(_Channels[i]));  // Current channel is a copy of CmdBuffer/IdxBuffer, don't destruct again
1883:         _Channels[i]._CmdBuffer.clear();
1884:         _Channels[i]._IdxBuffer.clear();
1885:     }
1886:     _Current = 0;
1887:     _Count = 1;
1888:     _Channels.clear();
1889: }
1890: void ImDrawListSplitter::Split(ImDrawList* draw_list, int channels_count)
1891: {
1892:     IM_UNUSED(draw_list);
1893:     IM_ASSERT(_Current == 0 && _Count <= 1 && "Nested channel splitting is not supported. Please use separate instances of ImDrawListSplitter.");
1894:     int old_channels_count = _Channels.Size;
1895:     if (old_channels_count < channels_count)
1896:     {
1897:         _Channels.reserve(channels_count); // Avoid over reserving since this is likely to stay stable
1898:         _Channels.resize(channels_count);
1899:     }
1900:     _Count = channels_count;
1901:     // Channels[] (24/32 bytes each) hold storage that we'll swap with draw_list->_CmdBuffer/_IdxBuffer
1902:     // The content of Channels[0] at this point doesn't matter. We clear it to make state tidy in a debugger but we don't strictly need to.
1903:     // When we switch to the next channel, we'll copy draw_list->_CmdBuffer/_IdxBuffer into Channels[0] and then Channels[1] into draw_list->CmdBuffer/_IdxBuffer
1904:     memset(&_Channels[0], 0, sizeof(ImDrawChannel));
1905:     for (int i = 1; i < channels_count; i++)
1906:     {
1907:         if (i >= old_channels_count)
1908:         {
1909:             IM_PLACEMENT_NEW(&_Channels[i]) ImDrawChannel();
1910:         }
1911:         else
1912:         {
1913:             _Channels[i]._CmdBuffer.resize(0);
1914:             _Channels[i]._IdxBuffer.resize(0);
1915:         }
1916:     }
1917: }
1918: void ImDrawListSplitter::Merge(ImDrawList* draw_list)
1919: {
1920:     // Note that we never use or rely on _Channels.Size because it is merely a buffer that we never shrink back to 0 to keep all sub-buffers ready for use.
1921:     if (_Count <= 1)
1922:         return;
1923:     SetCurrentChannel(draw_list, 0);
1924:     draw_list->_PopUnusedDrawCmd();
1925:     // Calculate our final buffer sizes. Also fix the incorrect IdxOffset values in each command.
1926:     int new_cmd_buffer_count = 0;
1927:     int new_idx_buffer_count = 0;
1928:     ImDrawCmd* last_cmd = (_Count > 0 && draw_list->CmdBuffer.Size > 0) ? &draw_list->CmdBuffer.back() : NULL;
1929:     int idx_offset = last_cmd ? last_cmd->IdxOffset + last_cmd->ElemCount : 0;
1930:     for (int i = 1; i < _Count; i++)
1931:     {
1932:         ImDrawChannel& ch = _Channels[i];
1933:         if (ch._CmdBuffer.Size > 0 && ch._CmdBuffer.back().ElemCount == 0 && ch._CmdBuffer.back().UserCallback == NULL) // Equivalent of PopUnusedDrawCmd()
1934:             ch._CmdBuffer.pop_back();
1935:         if (ch._CmdBuffer.Size > 0 && last_cmd != NULL)
1936:         {
1937:             // Do not include ImDrawCmd_AreSequentialIdxOffset() in the compare as we rebuild IdxOffset values ourselves.
1938:             // Manipulating IdxOffset (e.g. by reordering draw commands like done by RenderDimmedBackgroundBehindWindow()) is not supported within a splitter.
1939:             ImDrawCmd* next_cmd = &ch._CmdBuffer[0];
1940:             if (ImDrawCmd_HeaderCompare(last_cmd, next_cmd) == 0 && last_cmd->UserCallback == NULL && next_cmd->UserCallback == NULL)
1941:             {
1942:                 // Merge previous channel last draw command with current channel first draw command if matching.
1943:                 last_cmd->ElemCount += next_cmd->ElemCount;
1944:                 idx_offset += next_cmd->ElemCount;
1945:                 ch._CmdBuffer.erase(ch._CmdBuffer.Data); // FIXME-OPT: Improve for multiple merges.
1946:             }
1947:         }
1948:         if (ch._CmdBuffer.Size > 0)
1949:             last_cmd = &ch._CmdBuffer.back();
1950:         new_cmd_buffer_count += ch._CmdBuffer.Size;
1951:         new_idx_buffer_count += ch._IdxBuffer.Size;
1952:         for (int cmd_n = 0; cmd_n < ch._CmdBuffer.Size; cmd_n++)
1953:         {
1954:             ch._CmdBuffer.Data[cmd_n].IdxOffset = idx_offset;
1955:             idx_offset += ch._CmdBuffer.Data[cmd_n].ElemCount;
1956:         }
1957:     }
1958:     draw_list->CmdBuffer.resize(draw_list->CmdBuffer.Size + new_cmd_buffer_count);
1959:     draw_list->IdxBuffer.resize(draw_list->IdxBuffer.Size + new_idx_buffer_count);
1960:     // Write commands and indices in order (they are fairly small structures, we don't copy vertices only indices)
1961:     ImDrawCmd* cmd_write = draw_list->CmdBuffer.Data + draw_list->CmdBuffer.Size - new_cmd_buffer_count;
1962:     ImDrawIdx* idx_write = draw_list->IdxBuffer.Data + draw_list->IdxBuffer.Size - new_idx_buffer_count;
1963:     for (int i = 1; i < _Count; i++)
1964:     {
1965:         ImDrawChannel& ch = _Channels[i];
1966:         if (int sz = ch._CmdBuffer.Size) { memcpy(cmd_write, ch._CmdBuffer.Data, sz * sizeof(ImDrawCmd)); cmd_write += sz; }
1967:         if (int sz = ch._IdxBuffer.Size) { memcpy(idx_write, ch._IdxBuffer.Data, sz * sizeof(ImDrawIdx)); idx_write += sz; }
1968:     }
1969:     draw_list->_IdxWritePtr = idx_write;
1970:     // Ensure there's always a non-callback draw command trailing the command-buffer
1971:     if (draw_list->CmdBuffer.Size == 0 || draw_list->CmdBuffer.back().UserCallback != NULL)
1972:         draw_list->AddDrawCmd();
1973:     // If current command is used with different settings we need to add a new command
1974:     ImDrawCmd* curr_cmd = &draw_list->CmdBuffer.Data[draw_list->CmdBuffer.Size - 1];
1975:     if (curr_cmd->ElemCount == 0)
1976:         ImDrawCmd_HeaderCopy(curr_cmd, &draw_list->_CmdHeader); // Copy ClipRect, TexRef, VtxOffset
1977:     else if (ImDrawCmd_HeaderCompare(curr_cmd, &draw_list->_CmdHeader) != 0)
1978:         draw_list->AddDrawCmd();
1979:     _Count = 1;
1980: }
1981: void ImDrawListSplitter::SetCurrentChannel(ImDrawList* draw_list, int idx)
1982: {
1983:     IM_ASSERT(idx >= 0 && idx < _Count);
1984:     if (_Current == idx)
1985:         return;
1986:     // Overwrite ImVector (12/16 bytes), four times. This is merely a silly optimization instead of doing .swap()
1987:     memcpy(&_Channels.Data[_Current]._CmdBuffer, &draw_list->CmdBuffer, sizeof(draw_list->CmdBuffer));
1988:     memcpy(&_Channels.Data[_Current]._IdxBuffer, &draw_list->IdxBuffer, sizeof(draw_list->IdxBuffer));
1989:     _Current = idx;
1990:     memcpy(&draw_list->CmdBuffer, &_Channels.Data[idx]._CmdBuffer, sizeof(draw_list->CmdBuffer));
1991:     memcpy(&draw_list->IdxBuffer, &_Channels.Data[idx]._IdxBuffer, sizeof(draw_list->IdxBuffer));
1992:     draw_list->_IdxWritePtr = draw_list->IdxBuffer.Data + draw_list->IdxBuffer.Size;
1993:     // If current command is used with different settings we need to add a new command
1994:     ImDrawCmd* curr_cmd = (draw_list->CmdBuffer.Size == 0) ? NULL : &draw_list->CmdBuffer.Data[draw_list->CmdBuffer.Size - 1];
1995:     if (curr_cmd == NULL)
1996:         draw_list->AddDrawCmd();
1997:     else if (curr_cmd->ElemCount == 0)
1998:         ImDrawCmd_HeaderCopy(curr_cmd, &draw_list->_CmdHeader); // Copy ClipRect, TexRef, VtxOffset
1999:     else if (ImDrawCmd_HeaderCompare(curr_cmd, &draw_list->_CmdHeader) != 0)
2000:         draw_list->AddDrawCmd();
2001: }
2002: //-----------------------------------------------------------------------------
2003: // [SECTION] ImDrawData
2004: //-----------------------------------------------------------------------------
2005: void ImDrawData::Clear()
2006: {
2007:     Valid = false;
2008:     CmdListsCount = TotalIdxCount = TotalVtxCount = 0;
2009:     CmdLists.resize(0); // The ImDrawList are NOT owned by ImDrawData but e.g. by ImGuiContext, so we don't clear them.
2010:     DisplayPos = DisplaySize = FramebufferScale = ImVec2(0.0f, 0.0f);
2011:     OwnerViewport = NULL;
2012:     Textures = NULL;
2013: }
2014: // Important: 'out_list' is generally going to be draw_data->CmdLists, but may be another temporary list
2015: // as long at it is expected that the result will be later merged into draw_data->CmdLists[].
2016: void ImGui::AddDrawListToDrawDataEx(ImDrawData* draw_data, ImVector<ImDrawList*>* out_list, ImDrawList* draw_list)
2017: {
2018:     if (draw_list->CmdBuffer.Size == 0)
2019:         return;
2020:     if (draw_list->CmdBuffer.Size == 1 && draw_list->CmdBuffer[0].ElemCount == 0 && draw_list->CmdBuffer[0].UserCallback == NULL)
2021:         return;
2022:     // Draw list sanity check. Detect mismatch between PrimReserve() calls and incrementing _VtxCurrentIdx, _VtxWritePtr etc.
2023:     // May trigger for you if you are using PrimXXX functions incorrectly.
2024:     IM_ASSERT(draw_list->VtxBuffer.Size == 0 || draw_list->_VtxWritePtr == draw_list->VtxBuffer.Data + draw_list->VtxBuffer.Size);
2025:     IM_ASSERT(draw_list->IdxBuffer.Size == 0 || draw_list->_IdxWritePtr == draw_list->IdxBuffer.Data + draw_list->IdxBuffer.Size);
2026:     if (!(draw_list->Flags & ImDrawListFlags_AllowVtxOffset))
2027:         IM_ASSERT((int)draw_list->_VtxCurrentIdx == draw_list->VtxBuffer.Size);
2028:     // Check that draw_list doesn't use more vertices than indexable (default ImDrawIdx = unsigned short = 2 bytes = 64K vertices per ImDrawList = per window)
2029:     // If this assert triggers because you are drawing lots of stuff manually:
2030:     // - First, make sure you are coarse clipping yourself and not trying to draw many things outside visible bounds.
2031:     //   Be mindful that the lower-level ImDrawList API doesn't filter vertices. Use the Metrics/Debugger window to inspect draw list contents.
2032:     // - If you want large meshes with more than 64K vertices, you can either:
2033:     //   (A) Handle the ImDrawCmd::VtxOffset value in your renderer backend, and set 'io.BackendFlags |= ImGuiBackendFlags_RendererHasVtxOffset'.
2034:     //       Most example backends already support this from 1.71. Pre-1.71 backends won't.
2035:     //       Some graphics API such as GL ES 1/2 don't have a way to offset the starting vertex so it is not supported for them.
2036:     //   (B) Or handle 32-bit indices in your renderer backend, and uncomment '#define ImDrawIdx unsigned int' line in imconfig.h.
2037:     //       Most example backends already support this. For example, the OpenGL example code detect index size at compile-time:
2038:     //         glDrawElements(GL_TRIANGLES, (GLsizei)pcmd->ElemCount, sizeof(ImDrawIdx) == 2 ? GL_UNSIGNED_SHORT : GL_UNSIGNED_INT, idx_buffer_offset);
2039:     //       Your own engine or render API may use different parameters or function calls to specify index sizes.
2040:     //       2 and 4 bytes indices are generally supported by most graphics API.
2041:     // - If for some reason neither of those solutions works for you, a workaround is to call BeginChild()/EndChild() before reaching
2042:     //   the 64K limit to split your draw commands in multiple draw lists.
2043:     if (sizeof(ImDrawIdx) == 2)
2044:         IM_ASSERT(draw_list->_VtxCurrentIdx < (1 << 16) && "Too many vertices in ImDrawList using 16-bit indices. Read comment above");
2045:     // Resolve callback data pointers
2046:     if (draw_list->_CallbacksDataBuf.Size > 0)
2047:         for (ImDrawCmd& cmd : draw_list->CmdBuffer)
2048:             if (cmd.UserCallback != NULL && cmd.UserCallbackDataOffset != -1 && cmd.UserCallbackDataSize > 0)
