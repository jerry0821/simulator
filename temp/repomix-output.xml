4518: void ImFontGlyphRangesBuilder::AddText(const char* text, const char* text_end)
4519: {
4520:     if (text_end == NULL)
4521:         text_end = text + strlen(text);
4522:     while (text < text_end)
4523:     {
4524:         unsigned int c = 0;
4525:         int c_len = ImTextCharFromUtf8(&c, text, text_end);
4526:         text += c_len;
4527:         if (c_len == 0)
4528:             break;
4529:         AddChar((ImWchar)c);
4530:     }
4531: }
4532: void ImFontGlyphRangesBuilder::AddRanges(const ImWchar* ranges)
4533: {
4534:     for (; ranges[0]; ranges += 2)
4535:         for (unsigned int c = ranges[0]; c <= ranges[1] && c <= IM_UNICODE_CODEPOINT_MAX; c++) //-V560
4536:             AddChar((ImWchar)c);
4537: }
4538: void ImFontGlyphRangesBuilder::BuildRanges(ImVector<ImWchar>* out_ranges)
4539: {
4540:     const int max_codepoint = IM_UNICODE_CODEPOINT_MAX;
4541:     for (int n = 0; n <= max_codepoint; n++)
4542:         if (GetBit(n))
4543:         {
4544:             out_ranges->push_back((ImWchar)n);
4545:             while (n < max_codepoint && GetBit(n + 1))
4546:                 n++;
4547:             out_ranges->push_back((ImWchar)n);
4548:         }
4549:     out_ranges->push_back(0);
4550: }
