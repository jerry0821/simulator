136: bool Direct3D_Initialize(HWND hWnd)
137: {
138: 	/* デバイス、スワップチェーン、コンテキスト生成 */
139: 	DXGI_SWAP_CHAIN_DESC swap_chain_desc{};
140: 	swap_chain_desc.Windowed = TRUE;	// full screen
141: 	swap_chain_desc.BufferCount = 2;	// 裏画面が何個用意する
142: 	// swap_chain_desc.BufferDesc.Width = 0;
143: 	// swap_chain_desc.BufferDesc.Height = 0;
144: 	// ⇒ ウィンドウサイズに合わせて自動的に設定される
145: 	swap_chain_desc.BufferDesc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;	// 色のformat
146: 	swap_chain_desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;	// 何に使う、ここは絵を各場所で使う
147: 	swap_chain_desc.SampleDesc.Count = 1;
148: 	swap_chain_desc.SampleDesc.Quality = 0;
149: 	swap_chain_desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL;
150: 	//swap_chain_desc.SwapEffect = DXGI_SWAP_EFFECT_DISCARD; // ベンチマークの時はこっち
151: 	swap_chain_desc.OutputWindow = hWnd;
152: 	/*
153: 	IDXGIFactory1* pFactory;
154: 	CreateDXGIFactory1(IID_PPV_ARGS(&pFactory));
155: 	IDXGIAdapter1* pAdapter;
156: 	pFactory->EnumAdapters1(1, &pAdapter); // セカンダリアダプタを取得
157: 	pFactory->Release();
158: 	DXGI_ADAPTER_DESC1 desc;
159: 	pAdapter->GetDesc1(&desc); // アダプタの情報を取得して確認したい場合
160: 	pAdapter->Release(); // D3D11CreateDeviceAndSwapChain()の第１引数に渡して利用し終わったら解放する
161: 	*/
162: 	UINT device_flags = 0;
163: #if defined(DEBUG) || defined(_DEBUG)
164: 	device_flags |= D3D11_CREATE_DEVICE_DEBUG;
165: #endif
166: 	D3D_FEATURE_LEVEL levels[] = {
167: 		D3D_FEATURE_LEVEL_11_1,
168: 		D3D_FEATURE_LEVEL_11_0
169: 	};
170: 	D3D_FEATURE_LEVEL feature_level = D3D_FEATURE_LEVEL_11_0;
171: 	HRESULT hr = D3D11CreateDeviceAndSwapChain(
172: 		nullptr,
173: 		D3D_DRIVER_TYPE_HARDWARE,
174: 		nullptr,
175: 		device_flags,
176: 		levels,
177: 		ARRAYSIZE(levels),
178: 		D3D11_SDK_VERSION,
179: 		&swap_chain_desc,
180: 		&g_pSwapChain,	// 大事
181: 		&g_pDevice,	// 大事
182: 		&feature_level,
183: 		&g_pDeviceContext	// 大事
184: 	);
185: 	if (FAILED(hr)) {
186: 		MessageBox(hWnd, "Direct3Dの初期化に失敗しました", "エラー", MB_OK);
187: 		return false;
188: 	}
189: 	if (!configureBackBuffer()) {
190: 		MessageBox(hWnd, "バックバッファの設定に失敗しました", "エラー", MB_OK);
191: 		return false;
192: 	}
193: 	// オフスクリーン関連のリソース作成
194: 	// メイン画面の裏で描画するためのバッファ
195: 	int screenW = Direct3D_GetBackBufferWidth();
196: 	int screenH = Direct3D_GetBackBufferHeight();
197: 	if (!MakeRenderTarget(screenW, screenH,
198: 		&g_pSceneTex, &g_pSceneRTV, &g_pSceneSRV, &g_pSceneDepthTex, &g_pSceneDSV, &g_SceneViewport))
199: 		return false;
200: 	// ミニマップ用のオフスクリーンバッファ
201: 	if (!MakeRenderTarget(512, 512,
202: 		&g_pMiniMapTex, &g_pMiniMapRTV, &g_pMiniMapSRV, &g_pMiniMapDepthTex, &g_pMiniMapDSV, &g_MiniMapViewport))
203: 		return false;
204: 	// プレイヤー用のオフスクリーンバッファ
205: 	if (!MakeRenderTarget(screenW, screenH,
206: 		&g_pPlayerTex, &g_pPlayerRTV, &g_pPlayerSRV, &g_pPlayerDepthTex, &g_pPlayerDSV, &g_PlayerViewport))
207: 		return false;
208: 	// RGB A -> 好きに使っていい値、基本は透明の表現に使う
209: 	// αテスト、αブレンド
210: 	// ブレンドステート設定
211: 	D3D11_BLEND_DESC bd = {};
212: 	bd.AlphaToCoverageEnable = FALSE;
213: 	bd.IndependentBlendEnable = FALSE;
214: 	bd.RenderTarget[0].BlendEnable = TRUE;	// αブレンドするしない
215: 	/*------- 透過ブレンドの設定----------*/
216: 	// src ... ソース（今から描く絵（色）） dest　...　すでに絵描かれた絵（色）
217: 	// RGB
218: 	bd.RenderTarget[0].SrcBlend = D3D11_BLEND_SRC_ALPHA;
219: 	bd.RenderTarget[0].DestBlend = D3D11_BLEND_INV_SRC_ALPHA;
220: 	bd.RenderTarget[0].BlendOp = D3D11_BLEND_OP_ADD;	// 演算子
221: 	// SrcRGB * SrcBlend + DestRGB * (1 - DestBlend)
222: 	// A
223: 	bd.RenderTarget[0].SrcBlendAlpha = D3D11_BLEND_ONE;
224: 	bd.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_ZERO;
225: 	bd.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_ADD;
226: 	// SrcBlendAlpha * 1 + DestBlendAlpha * 0
227: 	bd.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
228: 	g_pDevice->CreateBlendState(&bd, &g_pBlendStateMultiply);
229: 	/*-----------------------------------*/
230: 	/*------- 加算ブレンドの設定----------*/
231: 	// src ... ソース（今から描く絵（色）） dest　...　すでに絵描かれた絵（色）
232: 	// RGB
233: 	bd.RenderTarget[0].DestBlend = D3D11_BLEND_ONE;
234: 	// SrcRGB * SrcBlend + DestRGB * (1 - DestBlend)
235: 	// SrcBlendAlpha * 1 + DestBlendAlpha * 0
236: 	g_pDevice->CreateBlendState(&bd, &g_pBlendStateAdd);
237: 	/*-----------------------------------*/
238: 	Direct3D_SetAlphaBlendTransparent();
239: 	// HACK: 3Dの場合、関数化のほうがいい
240: 	// 深度ステンシルステート設定
241: 	D3D11_DEPTH_STENCIL_DESC dsd = {};
242: 	dsd.DepthFunc = D3D11_COMPARISON_LESS;
243: 	dsd.StencilEnable = FALSE;
244: 	dsd.DepthEnable = FALSE; // 無効にする
245: 	dsd.DepthWriteMask = D3D11_DEPTH_WRITE_MASK_ZERO;
246: 	g_pDevice->CreateDepthStencilState(&dsd, &g_pDepthStencilStateDepthDisable);
247: 	dsd.StencilEnable = FALSE;
248: 	dsd.DepthEnable = TRUE;
249: 	dsd.DepthWriteMask = D3D11_DEPTH_WRITE_MASK_ALL;
250: 	dsd.DepthFunc = D3D11_COMPARISON_LESS_EQUAL;
251: 	g_pDevice->CreateDepthStencilState(&dsd, &g_pDepthStencilStateDepthEnable);
252: 	dsd.StencilEnable = FALSE;
253: 	dsd.DepthEnable = TRUE;
254: 	// dsd.DepthFunc = D3D11_COMPARISON_ALWAYS; // 不管其他的深度　絶対描く
255: 	dsd.DepthFunc = D3D11_COMPARISON_LESS_EQUAL;
256: 	dsd.DepthWriteMask = D3D11_DEPTH_WRITE_MASK_ZERO;
257: 	g_pDevice->CreateDepthStencilState(&dsd, &g_pDepthStencilStateDepthWriteDisable);
258: 	Direct3D_SetDepthEnable(true);
259: 	// ラスタライザステートの作成
260: 	D3D11_RASTERIZER_DESC rd = {};
261: 	rd.FillMode = D3D11_FILL_SOLID;
262: 	//rd.FillMode = D3D11_FILL_WIREFRAME;
263: 	rd.CullMode = D3D11_CULL_BACK;
264: 	//rd.CullMode = D3D11_CULL_NONE;
265: 	rd.DepthClipEnable = TRUE;
266: 	rd.MultisampleEnable = FALSE;
267: 	g_pDevice->CreateRasterizerState(&rd, &g_pRasterizerState);
268: 	// デバイスコンテキストにラスタライザーステートを設定
269: 	g_pDeviceContext->RSSetState(g_pRasterizerState);
270: 	return true;
271: }
272: void Direct3D_Finalize()
273: {
274: 	releaseBackBuffer();
275: 	// Same as below
276: 	SAFE_RELEASE(g_pRasterizerState);
277: 	SAFE_RELEASE(g_pDepthStencilStateDepthDisable);
278: 	SAFE_RELEASE(g_pDepthStencilStateDepthEnable);
279: 	SAFE_RELEASE(g_pBlendStateMultiply);
280: 	SAFE_RELEASE(g_pBlendStateAdd);
281: 	//releaseOffscreenBuffer();
282: 	SAFE_RELEASE(g_pSwapChain);
283: 	SAFE_RELEASE(g_pDeviceContext);
284: 	SAFE_RELEASE(g_pDevice);
285: 	SAFE_RELEASE(g_pSceneSRV);
286: 	SAFE_RELEASE(g_pSceneRTV);
287: 	SAFE_RELEASE(g_pSceneTex);
288: 	SAFE_RELEASE(g_pSceneDSV);
289: 	SAFE_RELEASE(g_pSceneDepthTex);
290: 	SAFE_RELEASE(g_pMiniMapSRV);
291: 	SAFE_RELEASE(g_pMiniMapRTV);
292: 	SAFE_RELEASE(g_pMiniMapTex);
293: 	SAFE_RELEASE(g_pMiniMapDSV);
294: 	SAFE_RELEASE(g_pMiniMapDepthTex);
