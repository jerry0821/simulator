1897: // [Public] Append into a specific column
1898: bool ImGui::TableSetColumnIndex(int column_n)
1899: {
1900:     ImGuiContext& g = *GImGui;
1901:     ImGuiTable* table = g.CurrentTable;
1902:     if (!table)
1903:         return false;
1904:     if (table->CurrentColumn != column_n)
1905:     {
1906:         if (table->CurrentColumn != -1)
1907:             TableEndCell(table);
1908:         if ((column_n >= 0 && column_n < table->ColumnsCount) == false)
1909:         {
1910:             IM_ASSERT_USER_ERROR(column_n >= 0 && column_n < table->ColumnsCount, "TableSetColumnIndex() invalid column index!");
1911:             return false;
1912:         }
1913:         TableBeginCell(table, column_n);
1914:     }
1915:     // Return whether the column is visible. User may choose to skip submitting items based on this return value,
1916:     // however they shouldn't skip submitting for columns that may have the tallest contribution to row height.
1917:     return table->Columns[column_n].IsRequestOutput;
1918: }
1919: // [Public] Append into the next column, wrap and create a new row when already on last column
1920: bool ImGui::TableNextColumn()
1921: {
1922:     ImGuiContext& g = *GImGui;
1923:     ImGuiTable* table = g.CurrentTable;
1924:     if (!table)
1925:         return false;
1926:     if (table->IsInsideRow && table->CurrentColumn + 1 < table->ColumnsCount)
1927:     {
1928:         if (table->CurrentColumn != -1)
1929:             TableEndCell(table);
1930:         TableBeginCell(table, table->CurrentColumn + 1);
1931:     }
1932:     else
1933:     {
1934:         TableNextRow();
1935:         TableBeginCell(table, 0);
1936:     }
1937:     // Return whether the column is visible. User may choose to skip submitting items based on this return value,
1938:     // however they shouldn't skip submitting for columns that may have the tallest contribution to row height.
1939:     return table->Columns[table->CurrentColumn].IsRequestOutput;
1940: }
1941: // [Internal] Called by TableSetColumnIndex()/TableNextColumn()
1942: // This is called very frequently, so we need to be mindful of unnecessary overhead.
1943: // FIXME-TABLE FIXME-OPT: Could probably shortcut some things for non-active or clipped columns.
1944: void ImGui::TableBeginCell(ImGuiTable* table, int column_n)
1945: {
1946:     ImGuiContext& g = *GImGui;
1947:     ImGuiTableColumn* column = &table->Columns[column_n];
1948:     ImGuiWindow* window = table->InnerWindow;
1949:     table->CurrentColumn = column_n;
1950:     // Start position is roughly ~~ CellRect.Min + CellPadding + Indent
1951:     float start_x = column->WorkMinX;
1952:     if (column->Flags & ImGuiTableColumnFlags_IndentEnable)
1953:         start_x += table->RowIndentOffsetX; // ~~ += window.DC.Indent.x - table->HostIndentX, except we locked it for the row.
1954:     window->DC.CursorPos.x = start_x;
1955:     window->DC.CursorPos.y = table->RowPosY1 + table->RowCellPaddingY;
1956:     window->DC.CursorMaxPos.x = window->DC.CursorPos.x;
1957:     window->DC.ColumnsOffset.x = start_x - window->Pos.x - window->DC.Indent.x; // FIXME-WORKRECT
1958:     window->DC.CursorPosPrevLine.x = window->DC.CursorPos.x; // PrevLine.y is preserved. This allows users to call SameLine() to share LineSize between columns.
1959:     window->DC.CurrLineTextBaseOffset = table->RowTextBaseline;
1960:     window->DC.NavLayerCurrent = (ImGuiNavLayer)column->NavLayerCurrent;
1961:     // Note how WorkRect.Max.y is only set once during layout
1962:     window->WorkRect.Min.y = window->DC.CursorPos.y;
1963:     window->WorkRect.Min.x = column->WorkMinX;
1964:     window->WorkRect.Max.x = column->WorkMaxX;
1965:     window->DC.ItemWidth = column->ItemWidth;
1966:     window->SkipItems = column->IsSkipItems;
1967:     if (column->IsSkipItems)
1968:     {
1969:         g.LastItemData.ID = 0;
1970:         g.LastItemData.StatusFlags = 0;
1971:     }
1972:     // Also see TablePushColumnChannel()
1973:     if (table->Flags & ImGuiTableFlags_NoClip)
1974:     {
1975:         // FIXME: if we end up drawing all borders/bg in EndTable, could remove this and just assert that channel hasn't changed.
1976:         table->DrawSplitter->SetCurrentChannel(window->DrawList, TABLE_DRAW_CHANNEL_NOCLIP);
1977:         //IM_ASSERT(table->DrawSplitter._Current == TABLE_DRAW_CHANNEL_NOCLIP);
1978:     }
1979:     else
1980:     {
1981:         // FIXME-TABLE: Could avoid this if draw channel is dummy channel?
1982:         SetWindowClipRectBeforeSetChannel(window, column->ClipRect);
1983:         table->DrawSplitter->SetCurrentChannel(window->DrawList, column->DrawChannelCurrent);
1984:     }
1985:     // Logging
1986:     if (g.LogEnabled && !column->IsSkipItems)
1987:     {
1988:         LogRenderedText(&window->DC.CursorPos, "|");
1989:         g.LogLinePosY = FLT_MAX;
1990:     }
1991: }
1992: // [Internal] Called by TableNextRow()/TableSetColumnIndex()/TableNextColumn()
1993: void ImGui::TableEndCell(ImGuiTable* table)
1994: {
1995:     ImGuiTableColumn* column = &table->Columns[table->CurrentColumn];
1996:     ImGuiWindow* window = table->InnerWindow;
1997:     if (window->DC.IsSetPos)
1998:         ErrorCheckUsingSetCursorPosToExtendParentBoundaries();
1999:     // Report maximum position so we can infer content size per column.
2000:     float* p_max_pos_x;
2001:     if (table->RowFlags & ImGuiTableRowFlags_Headers)
2002:         p_max_pos_x = &column->ContentMaxXHeadersUsed;  // Useful in case user submit contents in header row that is not a TableHeader() call
2003:     else
2004:         p_max_pos_x = table->IsUnfrozenRows ? &column->ContentMaxXUnfrozen : &column->ContentMaxXFrozen;
2005:     *p_max_pos_x = ImMax(*p_max_pos_x, window->DC.CursorMaxPos.x);
2006:     if (column->IsEnabled)
2007:         table->RowPosY2 = ImMax(table->RowPosY2, window->DC.CursorMaxPos.y + table->RowCellPaddingY);
2008:     column->ItemWidth = window->DC.ItemWidth;
2009:     // Propagate text baseline for the entire row
2010:     // FIXME-TABLE: Here we propagate text baseline from the last line of the cell.. instead of the first one.
2011:     table->RowTextBaseline = ImMax(table->RowTextBaseline, window->DC.PrevLineTextBaseOffset);
2012: }
2013: //-------------------------------------------------------------------------
2014: // [SECTION] Tables: Columns width management
2015: //-------------------------------------------------------------------------
2016: // - TableGetMaxColumnWidth() [Internal]
2017: // - TableGetColumnWidthAuto() [Internal]
2018: // - TableSetColumnWidth()
2019: // - TableSetColumnWidthAutoSingle() [Internal]
2020: // - TableSetColumnWidthAutoAll() [Internal]
2021: // - TableUpdateColumnsWeightFromWidth() [Internal]
2022: //-------------------------------------------------------------------------
2023: // Note that actual columns widths are computed in TableUpdateLayout().
2024: //-------------------------------------------------------------------------
2025: // Maximum column content width given current layout. Use column->MinX so this value differs on a per-column basis.
2026: float ImGui::TableCalcMaxColumnWidth(const ImGuiTable* table, int column_n)
2027: {
2028:     const ImGuiTableColumn* column = &table->Columns[column_n];
2029:     float max_width = FLT_MAX;
2030:     const float min_column_distance = table->MinColumnWidth + table->CellPaddingX * 2.0f + table->CellSpacingX1 + table->CellSpacingX2;
2031:     if (table->Flags & ImGuiTableFlags_ScrollX)
2032:     {
2033:         // Frozen columns can't reach beyond visible width else scrolling will naturally break.
2034:         // (we use DisplayOrder as within a set of multiple frozen column reordering is possible)
2035:         if (column->DisplayOrder < table->FreezeColumnsRequest)
2036:         {
2037:             max_width = (table->InnerClipRect.Max.x - (table->FreezeColumnsRequest - column->DisplayOrder) * min_column_distance) - column->MinX;
2038:             max_width = max_width - table->OuterPaddingX - table->CellPaddingX - table->CellSpacingX2;
2039:         }
2040:     }
2041:     else if ((table->Flags & ImGuiTableFlags_NoKeepColumnsVisible) == 0)
2042:     {
2043:         // If horizontal scrolling if disabled, we apply a final lossless shrinking of columns in order to make
2044:         // sure they are all visible. Because of this we also know that all of the columns will always fit in
2045:         // table->WorkRect and therefore in table->InnerRect (because ScrollX is off)
2046:         // FIXME-TABLE: This is solved incorrectly but also quite a difficult problem to fix as we also want ClipRect width to match.
2047:         // See "table_width_distrib" and "table_width_keep_visible" tests
2048:         max_width = table->WorkRect.Max.x - (table->ColumnsEnabledCount - column->IndexWithinEnabledSet - 1) * min_column_distance - column->MinX;
2049:         //max_width -= table->CellSpacingX1;
2050:         max_width -= table->CellSpacingX2;
2051:         max_width -= table->CellPaddingX * 2.0f;
2052:         max_width -= table->OuterPaddingX;
2053:     }
2054:     return max_width;
2055: }
2056: // Note this is meant to be stored in column->WidthAuto, please generally use the WidthAuto field
2057: float ImGui::TableGetColumnWidthAuto(ImGuiTable* table, ImGuiTableColumn* column)
2058: {
2059:     const float content_width_body = ImMax(column->ContentMaxXFrozen, column->ContentMaxXUnfrozen) - column->WorkMinX;
2060:     const float content_width_headers = column->ContentMaxXHeadersIdeal - column->WorkMinX;
2061:     float width_auto = content_width_body;
2062:     if (!(column->Flags & ImGuiTableColumnFlags_NoHeaderWidth))
2063:         width_auto = ImMax(width_auto, content_width_headers);
2064:     // Non-resizable fixed columns preserve their requested width
2065:     if ((column->Flags & ImGuiTableColumnFlags_WidthFixed) && column->InitStretchWeightOrWidth > 0.0f)
2066:         if (!(table->Flags & ImGuiTableFlags_Resizable) || (column->Flags & ImGuiTableColumnFlags_NoResize))
2067:             width_auto = column->InitStretchWeightOrWidth;
2068:     return ImMax(width_auto, table->MinColumnWidth);
2069: }
2070: // 'width' = inner column width, without padding
2071: void ImGui::TableSetColumnWidth(int column_n, float width)
2072: {
2073:     ImGuiContext& g = *GImGui;
2074:     ImGuiTable* table = g.CurrentTable;
2075:     IM_ASSERT(table != NULL && table->IsLayoutLocked == false);
2076:     IM_ASSERT(column_n >= 0 && column_n < table->ColumnsCount);
2077:     ImGuiTableColumn* column_0 = &table->Columns[column_n];
2078:     float column_0_width = width;
2079:     // Apply constraints early
2080:     // Compare both requested and actual given width to avoid overwriting requested width when column is stuck (minimum size, bounded)
2081:     IM_ASSERT(table->MinColumnWidth > 0.0f);
