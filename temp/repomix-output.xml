1679:     ImGuiNextWindowDataFlags backup_next_window_data_flags = g.NextWindowData.HasFlags;
1680:     g.NextWindowData.ClearFlags(); // We behave like Begin() and need to consume those values
1681:     if (window->SkipItems)
1682:         return false;
1683:     const ImGuiStyle& style = g.Style;
1684:     const ImGuiID id = window->GetID(label);
1685:     IM_ASSERT((flags & (ImGuiComboFlags_NoArrowButton | ImGuiComboFlags_NoPreview)) != (ImGuiComboFlags_NoArrowButton | ImGuiComboFlags_NoPreview)); // Can't use both flags together
1686:     if (flags & ImGuiComboFlags_WidthFitPreview)
1687:         IM_ASSERT((flags & (ImGuiComboFlags_NoPreview | (ImGuiComboFlags)ImGuiComboFlags_CustomPreview)) == 0);
1688:     const float arrow_size = (flags & ImGuiComboFlags_NoArrowButton) ? 0.0f : GetFrameHeight();
1689:     const ImVec2 label_size = CalcTextSize(label, NULL, true);
1690:     const float preview_width = ((flags & ImGuiComboFlags_WidthFitPreview) && (preview_value != NULL)) ? CalcTextSize(preview_value, NULL, true).x : 0.0f;
1691:     const float w = (flags & ImGuiComboFlags_NoPreview) ? arrow_size : ((flags & ImGuiComboFlags_WidthFitPreview) ? (arrow_size + preview_width + style.FramePadding.x * 2.0f) : CalcItemWidth());
1692:     const ImRect bb(window->DC.CursorPos, window->DC.CursorPos + ImVec2(w, label_size.y + style.FramePadding.y * 2.0f));
1693:     const ImRect total_bb(bb.Min, bb.Max + ImVec2(label_size.x > 0.0f ? style.ItemInnerSpacing.x + label_size.x : 0.0f, 0.0f));
1694:     ItemSize(total_bb, style.FramePadding.y);
1695:     if (!ItemAdd(total_bb, id, &bb))
1696:         return false;
1697:     // Open on click
1698:     bool hovered, held;
1699:     bool pressed = ButtonBehavior(bb, id, &hovered, &held);
1700:     const ImGuiID popup_id = ImHashStr("##ComboPopup", 0, id);
1701:     bool popup_open = IsPopupOpen(popup_id, ImGuiPopupFlags_None);
1702:     if (pressed && !popup_open)
1703:     {
1704:         OpenPopupEx(popup_id, ImGuiPopupFlags_None);
1705:         popup_open = true;
1706:     }
1707:     // Render shape
1708:     const ImU32 frame_col = GetColorU32(hovered ? ImGuiCol_FrameBgHovered : ImGuiCol_FrameBg);
1709:     const float value_x2 = ImMax(bb.Min.x, bb.Max.x - arrow_size);
1710:     RenderNavCursor(bb, id);
1711:     if (!(flags & ImGuiComboFlags_NoPreview))
1712:         window->DrawList->AddRectFilled(bb.Min, ImVec2(value_x2, bb.Max.y), frame_col, style.FrameRounding, (flags & ImGuiComboFlags_NoArrowButton) ? ImDrawFlags_RoundCornersAll : ImDrawFlags_RoundCornersLeft);
1713:     if (!(flags & ImGuiComboFlags_NoArrowButton))
1714:     {
1715:         ImU32 bg_col = GetColorU32((popup_open || hovered) ? ImGuiCol_ButtonHovered : ImGuiCol_Button);
1716:         ImU32 text_col = GetColorU32(ImGuiCol_Text);
1717:         window->DrawList->AddRectFilled(ImVec2(value_x2, bb.Min.y), bb.Max, bg_col, style.FrameRounding, (w <= arrow_size) ? ImDrawFlags_RoundCornersAll : ImDrawFlags_RoundCornersRight);
1718:         if (value_x2 + arrow_size - style.FramePadding.x <= bb.Max.x)
1719:             RenderArrow(window->DrawList, ImVec2(value_x2 + style.FramePadding.y, bb.Min.y + style.FramePadding.y), text_col, ImGuiDir_Down, 1.0f);
1720:     }
1721:     RenderFrameBorder(bb.Min, bb.Max, style.FrameRounding);
1722:     // Custom preview
1723:     if (flags & ImGuiComboFlags_CustomPreview)
1724:     {
1725:         g.ComboPreviewData.PreviewRect = ImRect(bb.Min.x, bb.Min.y, value_x2, bb.Max.y);
1726:         IM_ASSERT(preview_value == NULL || preview_value[0] == 0);
1727:         preview_value = NULL;
1728:     }
1729:     // Render preview and label
1730:     if (preview_value != NULL && !(flags & ImGuiComboFlags_NoPreview))
1731:     {
1732:         if (g.LogEnabled)
1733:             LogSetNextTextDecoration("{", "}");
1734:         RenderTextClipped(bb.Min + style.FramePadding, ImVec2(value_x2, bb.Max.y), preview_value, NULL, NULL);
1735:     }
1736:     if (label_size.x > 0)
1737:         RenderText(ImVec2(bb.Max.x + style.ItemInnerSpacing.x, bb.Min.y + style.FramePadding.y), label);
1738:     if (!popup_open)
