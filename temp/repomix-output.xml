 33: #pragma once
 34: #ifndef AI_GENERIC_PROPERTY_H_INCLUDED
 35: #define AI_GENERIC_PROPERTY_H_INCLUDED
 36: #ifdef __GNUC__
 37: #    pragma GCC system_header
 38: #endif
 39: #include "Hash.h"
 40: #include "ai_assert.h"
 41: #include "Importer.hpp>
 42: #include <map>
 43: // ------------------------------------------------------------------------------------------------
 44: template <class T>
 45: inline bool SetGenericProperty(std::map<unsigned int, T> &list,
 46:         const char *szName, const T &value) {
 47:     ai_assert(nullptr != szName);
 48:     const uint32_t hash = SuperFastHash(szName);
 49:     typename std::map<unsigned int, T>::iterator it = list.find(hash);
 50:     if (it == list.end()) {
 51:         list.insert(std::pair<unsigned int, T>(hash, value));
 52:         return false;
 53:     }
 54:     (*it).second = value;
 55:     return true;
 56: }
 57: // ------------------------------------------------------------------------------------------------
 58: template <class T>
 59: inline const T &GetGenericProperty(const std::map<unsigned int, T> &list,
 60:         const char *szName, const T &errorReturn) {
 61:     ai_assert(nullptr != szName);
 62:     const uint32_t hash = SuperFastHash(szName);
 63:     typename std::map<unsigned int, T>::const_iterator it = list.find(hash);
 64:     if (it == list.end()) {
 65:         return errorReturn;
 66:     }
 67:     return (*it).second;
 68: }
 69: // ------------------------------------------------------------------------------------------------
 70: // Special version for pointer types - they will be deleted when replaced with another value
 71: // passing nullptr removes the whole property
 72: template <class T>
 73: inline void SetGenericPropertyPtr(std::map<unsigned int, T *> &list,
 74:         const char *szName, T *value, bool *bWasExisting = nullptr) {
 75:     ai_assert(nullptr != szName);
 76:     const uint32_t hash = SuperFastHash(szName);
 77:     typename std::map<unsigned int, T *>::iterator it = list.find(hash);
 78:     if (it == list.end()) {
 79:         if (bWasExisting) {
 80:             *bWasExisting = false;
 81:         }
 82:         list.insert(std::pair<unsigned int, T *>(hash, value));
 83:         return;
 84:     }
 85:     if ((*it).second != value) {
 86:         delete (*it).second;
 87:         (*it).second = value;
 88:     }
 89:     if (!value) {
 90:         list.erase(it);
 91:     }
 92:     if (bWasExisting) {
 93:         *bWasExisting = true;
 94:     }
 95: }
 96: // ------------------------------------------------------------------------------------------------
 97: template <class T>
 98: inline bool HasGenericProperty(const std::map<unsigned int, T> &list,
 99:         const char *szName) {
100:     ai_assert(nullptr != szName);
101:     const uint32_t hash = SuperFastHash(szName);
102:     typename std::map<unsigned int, T>::const_iterator it = list.find(hash);
103:     if (it == list.end()) {
104:         return false;
105:     }
