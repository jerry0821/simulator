 1689: void ImGuiIO::AddMouseButtonEvent(int mouse_button, bool down)
 1690: {
 1691:     IM_ASSERT(Ctx != NULL);
 1692:     ImGuiContext& g = *Ctx;
 1693:     IM_ASSERT(mouse_button >= 0 && mouse_button < ImGuiMouseButton_COUNT);
 1694:     if (!AppAcceptingEvents)
 1695:         return;
 1696:     // On MacOS X: Convert Ctrl(Super)+Left click into Right-click: handle held button.
 1697:     if (ConfigMacOSXBehaviors && mouse_button == 0 && MouseCtrlLeftAsRightClick)
 1698:     {
 1699:         // Order of both statements matters: this event will still release mouse button 1
 1700:         mouse_button = 1;
 1701:         if (!down)
 1702:             MouseCtrlLeftAsRightClick = false;
 1703:     }
 1704:     // Filter duplicate
 1705:     const ImGuiInputEvent* latest_event = FindLatestInputEvent(&g, ImGuiInputEventType_MouseButton, (int)mouse_button);
 1706:     const bool latest_button_down = latest_event ? latest_event->MouseButton.Down : g.IO.MouseDown[mouse_button];
 1707:     if (latest_button_down == down)
 1708:         return;
 1709:     // On MacOS X: Convert Ctrl(Super)+Left click into Right-click.
 1710:     // - Note that this is actual physical Ctrl which is ImGuiMod_Super for us.
 1711:     // - At this point we want from !down to down, so this is handling the initial press.
 1712:     if (ConfigMacOSXBehaviors && mouse_button == 0 && down)
 1713:     {
 1714:         const ImGuiInputEvent* latest_super_event = FindLatestInputEvent(&g, ImGuiInputEventType_Key, (int)ImGuiMod_Super);
 1715:         if (latest_super_event ? latest_super_event->Key.Down : g.IO.KeySuper)
 1716:         {
 1717:             IMGUI_DEBUG_LOG_IO("[io] Super+Left Click aliased into Right Click\n");
 1718:             MouseCtrlLeftAsRightClick = true;
 1719:             AddMouseButtonEvent(1, true); // This is just quicker to write that passing through, as we need to filter duplicate again.
 1720:             return;
 1721:         }
 1722:     }
 1723:     ImGuiInputEvent e;
 1724:     e.Type = ImGuiInputEventType_MouseButton;
 1725:     e.Source = ImGuiInputSource_Mouse;
 1726:     e.EventId = g.InputEventsNextEventId++;
 1727:     e.MouseButton.Button = mouse_button;
 1728:     e.MouseButton.Down = down;
 1729:     e.MouseButton.MouseSource = g.InputEventsNextMouseSource;
 1730:     g.InputEventsQueue.push_back(e);
 1731: }
