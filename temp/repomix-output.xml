2588: // Return NULL if no sort specs (most often when ImGuiTableFlags_Sortable is not set)
2589: // When 'sort_specs->SpecsDirty == true' you should sort your data. It will be true when sorting specs have
2590: // changed since last call, or the first time. Make sure to set 'SpecsDirty = false' after sorting,
2591: // else you may wastefully sort your data every frame!
2592: // Lifetime: don't hold on this pointer over multiple frames or past any subsequent call to BeginTable()!
2593: ImGuiTableSortSpecs* ImGui::TableGetSortSpecs()
2594: {
2595:     ImGuiContext& g = *GImGui;
2596:     ImGuiTable* table = g.CurrentTable;
2597:     if (table == NULL || !(table->Flags & ImGuiTableFlags_Sortable))
2598:         return NULL;
2599:     // Require layout (in case TableHeadersRow() hasn't been called) as it may alter IsSortSpecsDirty in some paths.
2600:     if (!table->IsLayoutLocked)
2601:         TableUpdateLayout(table);
2602:     TableSortSpecsBuild(table);
2603:     return &table->SortSpecs;
2604: }
2605: static inline ImGuiSortDirection TableGetColumnAvailSortDirection(ImGuiTableColumn* column, int n)
2606: {
2607:     IM_ASSERT(n < column->SortDirectionsAvailCount);
2608:     return (ImGuiSortDirection)((column->SortDirectionsAvailList >> (n << 1)) & 0x03);
2609: }
2610: // Fix sort direction if currently set on a value which is unavailable (e.g. activating NoSortAscending/NoSortDescending)
2611: void ImGui::TableFixColumnSortDirection(ImGuiTable* table, ImGuiTableColumn* column)
2612: {
2613:     if (column->SortOrder == -1 || (column->SortDirectionsAvailMask & (1 << column->SortDirection)) != 0)
2614:         return;
2615:     column->SortDirection = (ImU8)TableGetColumnAvailSortDirection(column, 0);
2616:     table->IsSortSpecsDirty = true;
2617: }
2618: // Calculate next sort direction that would be set after clicking the column
2619: // - If the PreferSortDescending flag is set, we will default to a Descending direction on the first click.
2620: // - Note that the PreferSortAscending flag is never checked, it is essentially the default and therefore a no-op.
2621: IM_STATIC_ASSERT(ImGuiSortDirection_None == 0 && ImGuiSortDirection_Ascending == 1 && ImGuiSortDirection_Descending == 2);
2622: ImGuiSortDirection ImGui::TableGetColumnNextSortDirection(ImGuiTableColumn* column)
2623: {
2624:     IM_ASSERT(column->SortDirectionsAvailCount > 0);
2625:     if (column->SortOrder == -1)
2626:         return TableGetColumnAvailSortDirection(column, 0);
2627:     for (int n = 0; n < 3; n++)
2628:         if (column->SortDirection == TableGetColumnAvailSortDirection(column, n))
2629:             return TableGetColumnAvailSortDirection(column, (n + 1) % column->SortDirectionsAvailCount);
2630:     IM_ASSERT(0);
2631:     return ImGuiSortDirection_None;
2632: }
2633: // Note that the NoSortAscending/NoSortDescending flags are processed in TableSortSpecsSanitize(), and they may change/revert
2634: // the value of SortDirection. We could technically also do it here but it would be unnecessary and duplicate code.
2635: void ImGui::TableSetColumnSortDirection(int column_n, ImGuiSortDirection sort_direction, bool append_to_sort_specs)
2636: {
2637:     ImGuiContext& g = *GImGui;
2638:     ImGuiTable* table = g.CurrentTable;
2639:     if (!(table->Flags & ImGuiTableFlags_SortMulti))
2640:         append_to_sort_specs = false;
2641:     if (!(table->Flags & ImGuiTableFlags_SortTristate))
2642:         IM_ASSERT(sort_direction != ImGuiSortDirection_None);
2643:     ImGuiTableColumnIdx sort_order_max = 0;
2644:     if (append_to_sort_specs)
2645:         for (int other_column_n = 0; other_column_n < table->ColumnsCount; other_column_n++)
2646:             sort_order_max = ImMax(sort_order_max, table->Columns[other_column_n].SortOrder);
2647:     ImGuiTableColumn* column = &table->Columns[column_n];
2648:     column->SortDirection = (ImU8)sort_direction;
2649:     if (column->SortDirection == ImGuiSortDirection_None)
2650:         column->SortOrder = -1;
2651:     else if (column->SortOrder == -1 || !append_to_sort_specs)
2652:         column->SortOrder = append_to_sort_specs ? sort_order_max + 1 : 0;
2653:     for (int other_column_n = 0; other_column_n < table->ColumnsCount; other_column_n++)
2654:     {
2655:         ImGuiTableColumn* other_column = &table->Columns[other_column_n];
2656:         if (other_column != column && !append_to_sort_specs)
2657:             other_column->SortOrder = -1;
2658:         TableFixColumnSortDirection(table, other_column);
2659:     }
2660:     table->IsSettingsDirty = true;
2661:     table->IsSortSpecsDirty = true;
2662: }
2663: void ImGui::TableSortSpecsSanitize(ImGuiTable* table)
2664: {
2665:     IM_ASSERT(table->Flags & ImGuiTableFlags_Sortable);
2666:     // Clear SortOrder from hidden column and verify that there's no gap or duplicate.
2667:     int sort_order_count = 0;
2668:     ImU64 sort_order_mask = 0x00;
2669:     for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
2670:     {
2671:         ImGuiTableColumn* column = &table->Columns[column_n];
2672:         if (column->SortOrder != -1 && !column->IsEnabled)
2673:             column->SortOrder = -1;
2674:         if (column->SortOrder == -1)
2675:             continue;
2676:         sort_order_count++;
2677:         sort_order_mask |= ((ImU64)1 << column->SortOrder);
2678:         IM_ASSERT(sort_order_count < (int)sizeof(sort_order_mask) * 8);
2679:     }
2680:     const bool need_fix_linearize = ((ImU64)1 << sort_order_count) != (sort_order_mask + 1);
2681:     const bool need_fix_single_sort_order = (sort_order_count > 1) && !(table->Flags & ImGuiTableFlags_SortMulti);
2682:     if (need_fix_linearize || need_fix_single_sort_order)
2683:     {
2684:         ImU64 fixed_mask = 0x00;
2685:         for (int sort_n = 0; sort_n < sort_order_count; sort_n++)
2686:         {
2687:             // Fix: Rewrite sort order fields if needed so they have no gap or duplicate.
2688:             // (e.g. SortOrder 0 disappeared, SortOrder 1..2 exists --> rewrite then as SortOrder 0..1)
2689:             int column_with_smallest_sort_order = -1;
2690:             for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
2691:                 if ((fixed_mask & ((ImU64)1 << (ImU64)column_n)) == 0 && table->Columns[column_n].SortOrder != -1)
2692:                     if (column_with_smallest_sort_order == -1 || table->Columns[column_n].SortOrder < table->Columns[column_with_smallest_sort_order].SortOrder)
2693:                         column_with_smallest_sort_order = column_n;
2694:             IM_ASSERT(column_with_smallest_sort_order != -1);
2695:             fixed_mask |= ((ImU64)1 << column_with_smallest_sort_order);
2696:             table->Columns[column_with_smallest_sort_order].SortOrder = (ImGuiTableColumnIdx)sort_n;
2697:             // Fix: Make sure only one column has a SortOrder if ImGuiTableFlags_MultiSortable is not set.
2698:             if (need_fix_single_sort_order)
2699:             {
2700:                 sort_order_count = 1;
2701:                 for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
2702:                     if (column_n != column_with_smallest_sort_order)
2703:                         table->Columns[column_n].SortOrder = -1;
2704:                 break;
2705:             }
2706:         }
2707:     }
2708:     // Fallback default sort order (if no column with the ImGuiTableColumnFlags_DefaultSort flag)
2709:     if (sort_order_count == 0 && !(table->Flags & ImGuiTableFlags_SortTristate))
2710:         for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
2711:         {
2712:             ImGuiTableColumn* column = &table->Columns[column_n];
2713:             if (column->IsEnabled && !(column->Flags & ImGuiTableColumnFlags_NoSort))
2714:             {
2715:                 sort_order_count = 1;
2716:                 column->SortOrder = 0;
2717:                 column->SortDirection = (ImU8)TableGetColumnAvailSortDirection(column, 0);
2718:                 break;
2719:             }
2720:         }
2721:     table->SortSpecsCount = (ImGuiTableColumnIdx)sort_order_count;
2722: }
2723: void ImGui::TableSortSpecsBuild(ImGuiTable* table)
2724: {
2725:     bool dirty = table->IsSortSpecsDirty;
2726:     if (dirty)
2727:     {
2728:         TableSortSpecsSanitize(table);
2729:         table->SortSpecsMulti.resize(table->SortSpecsCount <= 1 ? 0 : table->SortSpecsCount);
2730:         table->SortSpecs.SpecsDirty = true; // Mark as dirty for user
2731:         table->IsSortSpecsDirty = false; // Mark as not dirty for us
2732:     }
2733:     // Write output
2734:     // May be able to move all SortSpecs data from table (48 bytes) to ImGuiTableTempData if we decide to write it back on every BeginTable()
2735:     ImGuiTableColumnSortSpecs* sort_specs = (table->SortSpecsCount == 0) ? NULL : (table->SortSpecsCount == 1) ? &table->SortSpecsSingle : table->SortSpecsMulti.Data;
2736:     if (dirty && sort_specs != NULL)
2737:         for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
2738:         {
2739:             ImGuiTableColumn* column = &table->Columns[column_n];
2740:             if (column->SortOrder == -1)
2741:                 continue;
2742:             IM_ASSERT(column->SortOrder < table->SortSpecsCount);
2743:             ImGuiTableColumnSortSpecs* sort_spec = &sort_specs[column->SortOrder];
2744:             sort_spec->ColumnUserID = column->UserID;
2745:             sort_spec->ColumnIndex = (ImGuiTableColumnIdx)column_n;
2746:             sort_spec->SortOrder = (ImGuiTableColumnIdx)column->SortOrder;
2747:             sort_spec->SortDirection = (ImGuiSortDirection)column->SortDirection;
2748:         }
2749:     table->SortSpecs.Specs = sort_specs;
2750:     table->SortSpecs.SpecsCount = table->SortSpecsCount;
2751: }
