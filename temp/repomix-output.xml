16: void KeyLogger_Update()
17: {
18: 	const Keyboard_State* pState = Keyboard_GetState(); // 嘘ついてポインタにアドレスを入れてる
19: 	LPBYTE pn = (LPBYTE)pState; // 今
20: 	LPBYTE pp = (LPBYTE)&g_PrevState; // ひとつ前の結果
21: 	LPBYTE pt = (LPBYTE)&g_TriggerState; // さっき押してなくて今押してるか
22: 	LPBYTE pr = (LPBYTE)&g_ReleaseState; // さっき押してて今放したか
23: 	for (int i = 0; i < sizeof(Keyboard_State); i++){
24: 		pt[i] = (pp[i] ^ pn[i]) & pn[i];
25: 		pr[i] = (pp[i] ^ pn[i]) & pp[i];
26: 	}
27: 	g_PrevState = *pState;
28: }
