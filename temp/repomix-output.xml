8006: // FIXME: Provided a rectangle perhaps e.g. a BeginMenuBarEx() could be used anywhere..
8007: // Currently the main responsibility of this function being to setup clip-rect + horizontal layout + menu navigation layer.
8008: // Ideally we also want this to be responsible for claiming space out of the main window scrolling rectangle, in which case ImGuiWindowFlags_MenuBar will become unnecessary.
8009: // Then later the same system could be used for multiple menu-bars, scrollbars, side-bars.
8010: bool ImGui::BeginMenuBar()
8011: {
8012:     ImGuiWindow* window = GetCurrentWindow();
8013:     if (window->SkipItems)
8014:         return false;
8015:     if (!(window->Flags & ImGuiWindowFlags_MenuBar))
8016:         return false;
8017:     IM_ASSERT(!window->DC.MenuBarAppending);
8018:     BeginGroup(); // Backup position on layer 0 // FIXME: Misleading to use a group for that backup/restore
8019:     PushID("##MenuBar");
8020:     // We don't clip with current window clipping rectangle as it is already set to the area below. However we clip with window full rect.
8021:     // We remove 1 worth of rounding to Max.x to that text in long menus and small windows don't tend to display over the lower-right rounded area, which looks particularly glitchy.
8022:     const float border_top = ImMax(window->WindowBorderSize * 0.5f - window->TitleBarHeight, 0.0f);
8023:     ImRect bar_rect = window->MenuBarRect();
8024:     ImRect clip_rect(IM_ROUND(bar_rect.Min.x + window->WindowBorderSize * 0.5f), IM_ROUND(bar_rect.Min.y + border_top), IM_ROUND(ImMax(bar_rect.Min.x, bar_rect.Max.x - ImMax(window->WindowRounding, window->WindowBorderSize * 0.5f))), IM_ROUND(bar_rect.Max.y));
8025:     clip_rect.ClipWith(window->OuterRectClipped);
8026:     PushClipRect(clip_rect.Min, clip_rect.Max, false);
8027:     // We overwrite CursorMaxPos because BeginGroup sets it to CursorPos (essentially the .EmitItem hack in EndMenuBar() would need something analogous here, maybe a BeginGroupEx() with flags).
8028:     window->DC.CursorPos = window->DC.CursorMaxPos = ImVec2(bar_rect.Min.x + window->DC.MenuBarOffset.x, bar_rect.Min.y + window->DC.MenuBarOffset.y);
8029:     window->DC.LayoutType = ImGuiLayoutType_Horizontal;
8030:     window->DC.IsSameLine = false;
8031:     window->DC.NavLayerCurrent = ImGuiNavLayer_Menu;
8032:     window->DC.MenuBarAppending = true;
8033:     AlignTextToFramePadding();
8034:     return true;
8035: }
8036: void ImGui::EndMenuBar()
8037: {
8038:     ImGuiWindow* window = GetCurrentWindow();
8039:     if (window->SkipItems)
8040:         return;
8041:     ImGuiContext& g = *GImGui;
8042:     IM_MSVC_WARNING_SUPPRESS(6011); // Static Analysis false positive "warning C6011: Dereferencing NULL pointer 'window'"
8043:     IM_ASSERT(window->Flags & ImGuiWindowFlags_MenuBar);
8044:     IM_ASSERT(window->DC.MenuBarAppending);
8045:     // Nav: When a move request within one of our child menu failed, capture the request to navigate among our siblings.
8046:     if (NavMoveRequestButNoResultYet() && (g.NavMoveDir == ImGuiDir_Left || g.NavMoveDir == ImGuiDir_Right) && (g.NavWindow->Flags & ImGuiWindowFlags_ChildMenu))
8047:     {
8048:         // Try to find out if the request is for one of our child menu
8049:         ImGuiWindow* nav_earliest_child = g.NavWindow;
8050:         while (nav_earliest_child->ParentWindow && (nav_earliest_child->ParentWindow->Flags & ImGuiWindowFlags_ChildMenu))
8051:             nav_earliest_child = nav_earliest_child->ParentWindow;
8052:         if (nav_earliest_child->ParentWindow == window && nav_earliest_child->DC.ParentLayoutType == ImGuiLayoutType_Horizontal && (g.NavMoveFlags & ImGuiNavMoveFlags_Forwarded) == 0)
8053:         {
8054:             // To do so we claim focus back, restore NavId and then process the movement request for yet another frame.
8055:             // This involve a one-frame delay which isn't very problematic in this situation. We could remove it by scoring in advance for multiple window (probably not worth bothering)
8056:             const ImGuiNavLayer layer = ImGuiNavLayer_Menu;
8057:             IM_ASSERT(window->DC.NavLayersActiveMaskNext & (1 << layer)); // Sanity check (FIXME: Seems unnecessary)
8058:             FocusWindow(window);
8059:             SetNavID(window->NavLastIds[layer], layer, 0, window->NavRectRel[layer]);
8060:             // FIXME-NAV: How to deal with this when not using g.IO.ConfigNavCursorVisibleAuto?
8061:             if (g.NavCursorVisible)
8062:             {
8063:                 g.NavCursorVisible = false; // Hide nav cursor for the current frame so we don't see the intermediary selection. Will be set again
8064:                 g.NavCursorHideFrames = 2;
8065:             }
8066:             g.NavHighlightItemUnderNav = g.NavMousePosDirty = true;
8067:             NavMoveRequestForward(g.NavMoveDir, g.NavMoveClipDir, g.NavMoveFlags, g.NavMoveScrollFlags); // Repeat
8068:         }
8069:     }
8070:     PopClipRect();
8071:     PopID();
8072:     IM_MSVC_WARNING_SUPPRESS(6011); // Static Analysis false positive "warning C6011: Dereferencing NULL pointer 'window'"
8073:     window->DC.MenuBarOffset.x = window->DC.CursorPos.x - window->Pos.x; // Save horizontal position so next append can reuse it. This is kinda equivalent to a per-layer CursorPos.
8074:     // FIXME: Extremely confusing, cleanup by (a) working on WorkRect stack system (b) not using a Group confusingly here.
8075:     ImGuiGroupData& group_data = g.GroupStack.back();
8076:     group_data.EmitItem = false;
8077:     ImVec2 restore_cursor_max_pos = group_data.BackupCursorMaxPos;
8078:     window->DC.IdealMaxPos.x = ImMax(window->DC.IdealMaxPos.x, window->DC.CursorMaxPos.x - window->Scroll.x); // Convert ideal extents for scrolling layer equivalent.
8079:     EndGroup(); // Restore position on layer 0 // FIXME: Misleading to use a group for that backup/restore
8080:     window->DC.LayoutType = ImGuiLayoutType_Vertical;
8081:     window->DC.IsSameLine = false;
8082:     window->DC.NavLayerCurrent = ImGuiNavLayer_Main;
8083:     window->DC.MenuBarAppending = false;
8084:     window->DC.CursorMaxPos = restore_cursor_max_pos;
8085: }
8086: // Important: calling order matters!
8087: // FIXME: Somehow overlapping with docking tech.
8088: // FIXME: The "rect-cut" aspect of this could be formalized into a lower-level helper (rect-cut: https://halt.software/dead-simple-layouts)
8089: bool ImGui::BeginViewportSideBar(const char* name, ImGuiViewport* viewport_p, ImGuiDir dir, float axis_size, ImGuiWindowFlags window_flags)
8090: {
8091:     IM_ASSERT(dir != ImGuiDir_None);
8092:     ImGuiWindow* bar_window = FindWindowByName(name);
8093:     if (bar_window == NULL || bar_window->BeginCount == 0)
8094:     {
8095:         // Calculate and set window size/position
8096:         ImGuiViewportP* viewport = (ImGuiViewportP*)(void*)(viewport_p ? viewport_p : GetMainViewport());
8097:         ImRect avail_rect = viewport->GetBuildWorkRect();
8098:         ImGuiAxis axis = (dir == ImGuiDir_Up || dir == ImGuiDir_Down) ? ImGuiAxis_Y : ImGuiAxis_X;
8099:         ImVec2 pos = avail_rect.Min;
8100:         if (dir == ImGuiDir_Right || dir == ImGuiDir_Down)
8101:             pos[axis] = avail_rect.Max[axis] - axis_size;
8102:         ImVec2 size = avail_rect.GetSize();
8103:         size[axis] = axis_size;
8104:         SetNextWindowPos(pos);
8105:         SetNextWindowSize(size);
8106:         // Report our size into work area (for next frame) using actual window size
8107:         if (dir == ImGuiDir_Up || dir == ImGuiDir_Left)
8108:             viewport->BuildWorkInsetMin[axis] += axis_size;
8109:         else if (dir == ImGuiDir_Down || dir == ImGuiDir_Right)
8110:             viewport->BuildWorkInsetMax[axis] += axis_size;
8111:     }
8112:     window_flags |= ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove;
8113:     PushStyleVar(ImGuiStyleVar_WindowRounding, 0.0f);
8114:     PushStyleVar(ImGuiStyleVar_WindowMinSize, ImVec2(0, 0)); // Lift normal size constraint
8115:     bool is_open = Begin(name, NULL, window_flags);
8116:     PopStyleVar(2);
8117:     return is_open;
8118: }
