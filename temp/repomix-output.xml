10850: // Mark popup as open (toggle toward open state).
10851: // Popups are closed when user click outside, or activate a pressable item, or CloseCurrentPopup() is called within a BeginPopup()/EndPopup() block.
10852: // Popup identifiers are relative to the current ID-stack (so OpenPopup and BeginPopup needs to be at the same level).
10853: // One open popup per level of the popup hierarchy (NB: when assigning we reset the Window member of ImGuiPopupRef to NULL)
10854: void ImGui::OpenPopupEx(ImGuiID id, ImGuiPopupFlags popup_flags)
10855: {
10856:     ImGuiContext& g = *GImGui;
10857:     ImGuiWindow* parent_window = g.CurrentWindow;
10858:     const int current_stack_size = g.BeginPopupStack.Size;
10859:     if (popup_flags & ImGuiPopupFlags_NoOpenOverExistingPopup)
10860:         if (IsPopupOpen((ImGuiID)0, ImGuiPopupFlags_AnyPopupId))
10861:             return;
10862:     ImGuiPopupData popup_ref; // Tagged as new ref as Window will be set back to NULL if we write this into OpenPopupStack.
10863:     popup_ref.PopupId = id;
10864:     popup_ref.Window = NULL;
10865:     popup_ref.RestoreNavWindow = g.NavWindow;           // When popup closes focus may be restored to NavWindow (depend on window type).
10866:     popup_ref.OpenFrameCount = g.FrameCount;
10867:     popup_ref.OpenParentId = parent_window->IDStack.back();
10868:     popup_ref.OpenPopupPos = NavCalcPreferredRefPos();
10869:     popup_ref.OpenMousePos = IsMousePosValid(&g.IO.MousePos) ? g.IO.MousePos : popup_ref.OpenPopupPos;
10870:     IMGUI_DEBUG_LOG_POPUP("[popup] OpenPopupEx(0x%08X)\n", id);
10871:     if (g.OpenPopupStack.Size < current_stack_size + 1)
10872:     {
10873:         g.OpenPopupStack.push_back(popup_ref);
10874:     }
10875:     else
10876:     {
10877:         // Gently handle the user mistakenly calling OpenPopup() every frames: it is likely a programming mistake!
10878:         // However, if we were to run the regular code path, the ui would become completely unusable because the popup will always be
10879:         // in hidden-while-calculating-size state _while_ claiming focus. Which is extremely confusing situation for the programmer.
10880:         // Instead, for successive frames calls to OpenPopup(), we silently avoid reopening even if ImGuiPopupFlags_NoReopen is not specified.
10881:         bool keep_existing = false;
10882:         if (g.OpenPopupStack[current_stack_size].PopupId == id)
10883:             if ((g.OpenPopupStack[current_stack_size].OpenFrameCount == g.FrameCount - 1) || (popup_flags & ImGuiPopupFlags_NoReopen))
10884:                 keep_existing = true;
10885:         if (keep_existing)
10886:         {
10887:             // No reopen
10888:             g.OpenPopupStack[current_stack_size].OpenFrameCount = popup_ref.OpenFrameCount;
10889:         }
10890:         else
10891:         {
10892:             // Reopen: close child popups if any, then flag popup for open/reopen (set position, focus, init navigation)
10893:             ClosePopupToLevel(current_stack_size, true);
10894:             g.OpenPopupStack.push_back(popup_ref);
10895:         }
10896:         // When reopening a popup we first refocus its parent, otherwise if its parent is itself a popup it would get closed by ClosePopupsOverWindow().
10897:         // This is equivalent to what ClosePopupToLevel() does.
10898:         //if (g.OpenPopupStack[current_stack_size].PopupId == id)
10899:         //    FocusWindow(parent_window);
10900:     }
10901: }
10902: // When popups are stacked, clicking on a lower level popups puts focus back to it and close popups above it.
10903: // This function closes any popups that are over 'ref_window'.
10904: void ImGui::ClosePopupsOverWindow(ImGuiWindow* ref_window, bool restore_focus_to_window_under_popup)
10905: {
10906:     ImGuiContext& g = *GImGui;
10907:     if (g.OpenPopupStack.Size == 0)
10908:         return;
10909:     // Don't close our own child popup windows.
10910:     //IMGUI_DEBUG_LOG_POPUP("[popup] ClosePopupsOverWindow(\"%s\") restore_under=%d\n", ref_window ? ref_window->Name : "<NULL>", restore_focus_to_window_under_popup);
10911:     int popup_count_to_keep = 0;
10912:     if (ref_window)
10913:     {
10914:         // Find the highest popup which is a descendant of the reference window (generally reference window = NavWindow)
10915:         for (; popup_count_to_keep < g.OpenPopupStack.Size; popup_count_to_keep++)
10916:         {
10917:             ImGuiPopupData& popup = g.OpenPopupStack[popup_count_to_keep];
10918:             if (!popup.Window)
10919:                 continue;
10920:             IM_ASSERT((popup.Window->Flags & ImGuiWindowFlags_Popup) != 0);
10921:             // Trim the stack unless the popup is a direct parent of the reference window (the reference window is often the NavWindow)
10922:             // - Clicking/Focusing Window2 won't close Popup1:
10923:             //     Window -> Popup1 -> Window2(Ref)
10924:             // - Clicking/focusing Popup1 will close Popup2 and Popup3:
10925:             //     Window -> Popup1(Ref) -> Popup2 -> Popup3
10926:             // - Each popups may contain child windows, which is why we compare ->RootWindow!
10927:             //     Window -> Popup1 -> Popup1_Child -> Popup2 -> Popup2_Child
10928:             // We step through every popup from bottom to top to validate their position relative to reference window.
10929:             bool ref_window_is_descendent_of_popup = false;
10930:             for (int n = popup_count_to_keep; n < g.OpenPopupStack.Size; n++)
10931:                 if (ImGuiWindow* popup_window = g.OpenPopupStack[n].Window)
10932:                     if (IsWindowWithinBeginStackOf(ref_window, popup_window))
10933:                     {
10934:                         ref_window_is_descendent_of_popup = true;
10935:                         break;
10936:                     }
10937:             if (!ref_window_is_descendent_of_popup)
10938:                 break;
10939:         }
10940:     }
10941:     if (popup_count_to_keep < g.OpenPopupStack.Size) // This test is not required but it allows to set a convenient breakpoint on the statement below
10942:     {
10943:         IMGUI_DEBUG_LOG_POPUP("[popup] ClosePopupsOverWindow(\"%s\")\n", ref_window ? ref_window->Name : "<NULL>");
10944:         ClosePopupToLevel(popup_count_to_keep, restore_focus_to_window_under_popup);
10945:     }
10946: }
