2994: // Important: data must be fed left to right
2995: void ImGui::TableAngledHeadersRowEx(ImGuiID row_id, float angle, float max_label_width, const ImGuiTableHeaderData* data, int data_count)
2996: {
2997:     ImGuiContext& g = *GImGui;
2998:     ImGuiTable* table = g.CurrentTable;
2999:     ImGuiWindow* window = g.CurrentWindow;
3000:     ImDrawList* draw_list = window->DrawList;
3001:     if (table == NULL)
3002:     {
3003:         IM_ASSERT_USER_ERROR(table != NULL, "Call should only be done while in BeginTable() scope!");
3004:         return;
3005:     }
3006:     IM_ASSERT(table->CurrentRow == -1 && "Must be first row");
3007:     if (max_label_width == 0.0f)
3008:         max_label_width = TableGetHeaderAngledMaxLabelWidth();
3009:     // Angle argument expressed in (-IM_PI/2 .. +IM_PI/2) as it is easier to think about for user.
3010:     const bool flip_label = (angle < 0.0f);
3011:     angle -= IM_PI * 0.5f;
3012:     const float cos_a = ImCos(angle);
3013:     const float sin_a = ImSin(angle);
3014:     const float label_cos_a = flip_label ? ImCos(angle + IM_PI) : cos_a;
3015:     const float label_sin_a = flip_label ? ImSin(angle + IM_PI) : sin_a;
3016:     const ImVec2 unit_right = ImVec2(cos_a, sin_a);
3017:     // Calculate our base metrics and set angled headers data _before_ the first call to TableNextRow()
3018:     // FIXME-STYLE: Would it be better for user to submit 'max_label_width' or 'row_height' ? One can be derived from the other.
3019:     const float header_height = g.FontSize + g.Style.CellPadding.x * 2.0f;
3020:     const float row_height = ImTrunc(ImFabs(ImRotate(ImVec2(max_label_width, flip_label ? +header_height : -header_height), cos_a, sin_a).y));
3021:     table->AngledHeadersHeight = row_height;
3022:     table->AngledHeadersSlope = (sin_a != 0.0f) ? (cos_a / sin_a) : 0.0f;
3023:     const ImVec2 header_angled_vector = unit_right * (row_height / -sin_a); // vector from bottom-left to top-left, and from bottom-right to top-right
3024:     // Declare row, override and draw our own background
3025:     TableNextRow(ImGuiTableRowFlags_Headers, row_height);
3026:     TableNextColumn();
3027:     const ImRect row_r(table->WorkRect.Min.x, table->BgClipRect.Min.y, table->WorkRect.Max.x, table->RowPosY2);
3028:     table->DrawSplitter->SetCurrentChannel(draw_list, TABLE_DRAW_CHANNEL_BG0);
3029:     float clip_rect_min_x = table->BgClipRect.Min.x;
3030:     if (table->FreezeColumnsCount > 0)
3031:         clip_rect_min_x = ImMax(clip_rect_min_x, table->Columns[table->FreezeColumnsCount - 1].MaxX);
3032:     TableSetBgColor(ImGuiTableBgTarget_RowBg0, 0); // Cancel
3033:     PushClipRect(table->BgClipRect.Min, table->BgClipRect.Max, false); // Span all columns
3034:     draw_list->AddRectFilled(ImVec2(table->BgClipRect.Min.x, row_r.Min.y), ImVec2(table->BgClipRect.Max.x, row_r.Max.y), GetColorU32(ImGuiCol_TableHeaderBg, 0.25f)); // FIXME-STYLE: Change row background with an arbitrary color.
3035:     PushClipRect(ImVec2(clip_rect_min_x, table->BgClipRect.Min.y), table->BgClipRect.Max, true); // Span all columns
3036:     ButtonBehavior(row_r, row_id, NULL, NULL);
3037:     KeepAliveID(row_id);
3038:     const float ascent_scaled = g.FontBaked->Ascent * g.FontBakedScale; // FIXME: Standardize those scaling factors better
3039:     const float line_off_for_ascent_x = (ImMax((g.FontSize - ascent_scaled) * 0.5f, 0.0f) / -sin_a) * (flip_label ? -1.0f : 1.0f);
3040:     const ImVec2 padding = g.Style.CellPadding; // We will always use swapped component
3041:     const ImVec2 align = g.Style.TableAngledHeadersTextAlign;
3042:     // Draw background and labels in first pass, then all borders.
3043:     float max_x = -FLT_MAX;
3044:     for (int pass = 0; pass < 2; pass++)
3045:         for (int order_n = 0; order_n < data_count; order_n++)
3046:         {
3047:             const ImGuiTableHeaderData* request = &data[order_n];
3048:             const int column_n = request->Index;
3049:             ImGuiTableColumn* column = &table->Columns[column_n];
3050:             ImVec2 bg_shape[4];
3051:             bg_shape[0] = ImVec2(column->MaxX, row_r.Max.y);
3052:             bg_shape[1] = ImVec2(column->MinX, row_r.Max.y);
3053:             bg_shape[2] = bg_shape[1] + header_angled_vector;
3054:             bg_shape[3] = bg_shape[0] + header_angled_vector;
3055:             if (pass == 0)
3056:             {
3057:                 // Draw shape
3058:                 draw_list->AddQuadFilled(bg_shape[0], bg_shape[1], bg_shape[2], bg_shape[3], request->BgColor0);
3059:                 draw_list->AddQuadFilled(bg_shape[0], bg_shape[1], bg_shape[2], bg_shape[3], request->BgColor1); // Optional highlight
3060:                 max_x = ImMax(max_x, bg_shape[3].x);
3061:                 // Draw label
3062:                 // - First draw at an offset where RenderTextXXX() function won't meddle with applying current ClipRect, then transform to final offset.
3063:                 // - Handle multiple lines manually, as we want each lines to follow on the horizontal border, rather than see a whole block rotated.
3064:                 const char* label_name = TableGetColumnName(table, column_n);
3065:                 const char* label_name_end = FindRenderedTextEnd(label_name);
3066:                 const float line_off_step_x = (g.FontSize / -sin_a);
3067:                 const int label_lines = ImTextCountLines(label_name, label_name_end);
3068:                 // Left<>Right alignment
3069:                 float line_off_curr_x = flip_label ? (label_lines - 1) * line_off_step_x : 0.0f;
3070:                 float line_off_for_align_x = ImFloor(ImMax((((column->MaxX - column->MinX) - padding.x * 2.0f) - (label_lines * line_off_step_x)), 0.0f) * align.x);
3071:                 line_off_curr_x += line_off_for_align_x - line_off_for_ascent_x;
3072:                 // Register header width
3073:                 column->ContentMaxXHeadersUsed = column->ContentMaxXHeadersIdeal = column->WorkMinX + ImCeil(label_lines * line_off_step_x - line_off_for_align_x);
3074:                 while (label_name < label_name_end)
3075:                 {
3076:                     const char* label_name_eol = strchr(label_name, '\n');
3077:                     if (label_name_eol == NULL)
3078:                         label_name_eol = label_name_end;
3079:                     // FIXME: Individual line clipping for right-most column is broken for negative angles.
3080:                     ImVec2 label_size = CalcTextSize(label_name, label_name_eol);
3081:                     float clip_width = max_label_width - padding.y; // Using padding.y*2.0f would be symmetrical but hide more text.
3082:                     float clip_height = ImMin(label_size.y, column->ClipRect.Max.x - column->WorkMinX - line_off_curr_x);
3083:                     ImRect clip_r(window->ClipRect.Min, window->ClipRect.Min + ImVec2(clip_width, clip_height));
3084:                     int vtx_idx_begin = draw_list->_VtxCurrentIdx;
3085:                     PushStyleColor(ImGuiCol_Text, request->TextColor);
3086:                     RenderTextEllipsis(draw_list, clip_r.Min, clip_r.Max, clip_r.Max.x, label_name, label_name_eol, &label_size);
3087:                     PopStyleColor();
3088:                     int vtx_idx_end = draw_list->_VtxCurrentIdx;
3089:                     // Up<>Down alignment
3090:                     const float available_space = ImMax(clip_width - label_size.x + ImAbs(padding.x * cos_a) * 2.0f - ImAbs(padding.y * sin_a) * 2.0f, 0.0f);
3091:                     const float vertical_offset = available_space * align.y * (flip_label ? -1.0f : 1.0f);
3092:                     // Rotate and offset label
3093:                     ImVec2 pivot_in = ImVec2(window->ClipRect.Min.x - vertical_offset, window->ClipRect.Min.y + label_size.y);
3094:                     ImVec2 pivot_out = ImVec2(column->WorkMinX, row_r.Max.y);
3095:                     line_off_curr_x += flip_label ? -line_off_step_x : line_off_step_x;
3096:                     pivot_out += unit_right * padding.y;
3097:                     if (flip_label)
3098:                         pivot_out += unit_right * (clip_width - ImMax(0.0f, clip_width - label_size.x));
3099:                     pivot_out.x += flip_label ? line_off_curr_x + line_off_step_x : line_off_curr_x;
3100:                     ShadeVertsTransformPos(draw_list, vtx_idx_begin, vtx_idx_end, pivot_in, label_cos_a, label_sin_a, pivot_out); // Rotate and offset
3101:                     //if (g.IO.KeyShift) { ImDrawList* fg_dl = GetForegroundDrawList(); vtx_idx_begin = fg_dl->_VtxCurrentIdx; fg_dl->AddRect(clip_r.Min, clip_r.Max, IM_COL32(0, 255, 0, 255), 0.0f, 0, 1.0f); ShadeVertsTransformPos(fg_dl, vtx_idx_begin, fg_dl->_VtxCurrentIdx, pivot_in, label_cos_a, label_sin_a, pivot_out); }
3102:                     label_name = label_name_eol + 1;
3103:                 }
3104:             }
3105:             if (pass == 1)
3106:             {
3107:                 // Draw border
3108:                 draw_list->AddLine(bg_shape[0], bg_shape[3], TableGetColumnBorderCol(table, order_n, column_n));
3109:             }
3110:         }
3111:     PopClipRect();
3112:     PopClipRect();
3113:     table->TempData->AngledHeadersExtraWidth = ImMax(0.0f, max_x - table->Columns[table->RightMostEnabledColumn].MaxX);
3114: }
