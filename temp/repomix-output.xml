8610:     tab_bar->TabsAddedNew = false;
8611:     // Flags
8612:     if ((flags & ImGuiTabBarFlags_FittingPolicyMask_) == 0)
8613:         flags |= ImGuiTabBarFlags_FittingPolicyDefault_;
8614:     tab_bar->Flags = flags;
8615:     tab_bar->BarRect = tab_bar_bb;
8616:     tab_bar->WantLayout = true; // Layout will be done on the first call to ItemTab()
8617:     tab_bar->PrevFrameVisible = tab_bar->CurrFrameVisible;
8618:     tab_bar->CurrFrameVisible = g.FrameCount;
8619:     tab_bar->PrevTabsContentsHeight = tab_bar->CurrTabsContentsHeight;
8620:     tab_bar->CurrTabsContentsHeight = 0.0f;
8621:     tab_bar->ItemSpacingY = g.Style.ItemSpacing.y;
8622:     tab_bar->FramePadding = g.Style.FramePadding;
8623:     tab_bar->TabsActiveCount = 0;
8624:     tab_bar->LastTabItemIdx = -1;
8625:     tab_bar->BeginCount = 1;
8626:     // Set cursor pos in a way which only be used in the off-chance the user erroneously submits item before BeginTabItem(): items will overlap
8627:     window->DC.CursorPos = ImVec2(tab_bar->BarRect.Min.x, tab_bar->BarRect.Max.y + tab_bar->ItemSpacingY);
8628:     // Draw separator
8629:     // (it would be misleading to draw this in EndTabBar() suggesting that it may be drawn over tabs, as tab bar are appendable)
8630:     const ImU32 col = GetColorU32((flags & ImGuiTabBarFlags_IsFocused) ? ImGuiCol_TabSelected : ImGuiCol_TabDimmedSelected);
8631:     if (g.Style.TabBarBorderSize > 0.0f)
8632:     {
8633:         const float y = tab_bar->BarRect.Max.y;
8634:         window->DrawList->AddRectFilled(ImVec2(tab_bar->SeparatorMinX, y - g.Style.TabBarBorderSize), ImVec2(tab_bar->SeparatorMaxX, y), col);
8635:     }
