2876: // On font removal we need to remove references (otherwise we could queue removal?)
2877: // We allow old_font == new_font which forces updating all values (e.g. sizes)
2878: void ImFontAtlasBuildNotifySetFont(ImFontAtlas* atlas, ImFont* old_font, ImFont* new_font)
2879: {
2880:     for (ImDrawListSharedData* shared_data : atlas->DrawListSharedDatas)
2881:     {
2882:         if (shared_data->Font == old_font)
2883:             shared_data->Font = new_font;
2884:         if (ImGuiContext* ctx = shared_data->Context)
2885:         {
2886:             if (ctx->IO.FontDefault == old_font)
2887:                 ctx->IO.FontDefault = new_font;
2888:             if (ctx->Font == old_font)
2889:             {
2890:                 ImGuiContext* curr_ctx = ImGui::GetCurrentContext();
2891:                 bool need_bind_ctx = ctx != curr_ctx;
2892:                 if (need_bind_ctx)
2893:                     ImGui::SetCurrentContext(ctx);
2894:                 ImGui::SetCurrentFont(new_font, ctx->FontSizeBase, ctx->FontSize);
2895:                 if (need_bind_ctx)
2896:                     ImGui::SetCurrentContext(curr_ctx);
2897:             }
2898:             for (ImFontStackData& font_stack_data : ctx->FontStack)
2899:                 if (font_stack_data.Font == old_font)
2900:                     font_stack_data.Font = new_font;
2901:         }
2902:     }
2903: }
2904: void ImFontAtlas::RemoveFont(ImFont* font)
2905: {
2906:     IM_ASSERT(!Locked && "Cannot modify a locked ImFontAtlas!");
2907:     ImFontAtlasFontDestroyOutput(this, font);
2908:     for (ImFontConfig* src : font->Sources)
2909:         ImFontAtlasFontDestroySourceData(this, src);
2910:     for (int src_n = 0; src_n < Sources.Size; src_n++)
2911:         if (Sources[src_n].DstFont == font)
2912:             Sources.erase(&Sources[src_n--]);
2913:     bool removed = Fonts.find_erase(font);
2914:     IM_ASSERT(removed);
2915:     IM_UNUSED(removed);
2916:     ImFontAtlasBuildUpdatePointers(this);
2917:     font->OwnerAtlas = NULL;
2918:     IM_DELETE(font);
2919:     // Notify external systems
2920:     ImFont* new_current_font = Fonts.empty() ? NULL : Fonts[0];
2921:     ImFontAtlasBuildNotifySetFont(this, font, new_current_font);
2922: }
