4154: static bool ImGui_ImplStbTrueType_FontBakedLoadGlyph(ImFontAtlas* atlas, ImFontConfig* src, ImFontBaked* baked, void*, ImWchar codepoint, ImFontGlyph* out_glyph, float* out_advance_x)
4155: {
4156:     // Search for first font which has the glyph
4157:     ImGui_ImplStbTrueType_FontSrcData* bd_font_data = (ImGui_ImplStbTrueType_FontSrcData*)src->FontLoaderData;
4158:     IM_ASSERT(bd_font_data);
4159:     int glyph_index = stbtt_FindGlyphIndex(&bd_font_data->FontInfo, (int)codepoint);
4160:     if (glyph_index == 0)
4161:         return false;
4162:     // Fonts unit to pixels
4163:     int oversample_h, oversample_v;
4164:     ImFontAtlasBuildGetOversampleFactors(src, baked, &oversample_h, &oversample_v);
4165:     const float scale_for_layout = bd_font_data->ScaleFactor * baked->Size;
4166:     const float rasterizer_density = src->RasterizerDensity * baked->RasterizerDensity;
4167:     const float scale_for_raster_x = bd_font_data->ScaleFactor * baked->Size * rasterizer_density * oversample_h;
4168:     const float scale_for_raster_y = bd_font_data->ScaleFactor * baked->Size * rasterizer_density * oversample_v;
4169:     // Obtain size and advance
4170:     int x0, y0, x1, y1;
4171:     int advance, lsb;
4172:     stbtt_GetGlyphBitmapBoxSubpixel(&bd_font_data->FontInfo, glyph_index, scale_for_raster_x, scale_for_raster_y, 0, 0, &x0, &y0, &x1, &y1);
4173:     stbtt_GetGlyphHMetrics(&bd_font_data->FontInfo, glyph_index, &advance, &lsb);
4174:     // Load metrics only mode
4175:     if (out_advance_x != NULL)
4176:     {
4177:         IM_ASSERT(out_glyph == NULL);
4178:         *out_advance_x = advance * scale_for_layout;
4179:         return true;
4180:     }
4181:     // Prepare glyph
4182:     out_glyph->Codepoint = codepoint;
4183:     out_glyph->AdvanceX = advance * scale_for_layout;
4184:     // Pack and retrieve position inside texture atlas
4185:     // (generally based on stbtt_PackFontRangesRenderIntoRects)
4186:     const bool is_visible = (x0 != x1 && y0 != y1);
4187:     if (is_visible)
4188:     {
4189:         const int w = (x1 - x0 + oversample_h - 1);
4190:         const int h = (y1 - y0 + oversample_v - 1);
4191:         ImFontAtlasRectId pack_id = ImFontAtlasPackAddRect(atlas, w, h);
4192:         if (pack_id == ImFontAtlasRectId_Invalid)
4193:         {
4194:             // Pathological out of memory case (TexMaxWidth/TexMaxHeight set too small?)
4195:             IM_ASSERT(pack_id != ImFontAtlasRectId_Invalid && "Out of texture memory.");
4196:             return false;
4197:         }
4198:         ImTextureRect* r = ImFontAtlasPackGetRect(atlas, pack_id);
4199:         // Render
4200:         stbtt_GetGlyphBitmapBox(&bd_font_data->FontInfo, glyph_index, scale_for_raster_x, scale_for_raster_y, &x0, &y0, &x1, &y1);
4201:         ImFontAtlasBuilder* builder = atlas->Builder;
4202:         builder->TempBuffer.resize(w * h * 1);
4203:         unsigned char* bitmap_pixels = builder->TempBuffer.Data;
4204:         memset(bitmap_pixels, 0, w * h * 1);
4205:         // Render with oversampling
4206:         // (those functions conveniently assert if pixels are not cleared, which is another safety layer)
4207:         float sub_x, sub_y;
4208:         stbtt_MakeGlyphBitmapSubpixelPrefilter(&bd_font_data->FontInfo, bitmap_pixels, w, h, w,
4209:             scale_for_raster_x, scale_for_raster_y, 0, 0, oversample_h, oversample_v, &sub_x, &sub_y, glyph_index);
4210:         const float ref_size = baked->OwnerFont->Sources[0]->SizePixels;
4211:         const float offsets_scale = (ref_size != 0.0f) ? (baked->Size / ref_size) : 1.0f;
4212:         float font_off_x = (src->GlyphOffset.x * offsets_scale);
4213:         float font_off_y = (src->GlyphOffset.y * offsets_scale);
4214:         if (src->PixelSnapH) // Snap scaled offset. This is to mitigate backward compatibility issues for GlyphOffset, but a better design would be welcome.
4215:             font_off_x = IM_ROUND(font_off_x);
4216:         if (src->PixelSnapV)
4217:             font_off_y = IM_ROUND(font_off_y);
4218:         font_off_x += sub_x;
4219:         font_off_y += sub_y + IM_ROUND(baked->Ascent);
4220:         float recip_h = 1.0f / (oversample_h * rasterizer_density);
4221:         float recip_v = 1.0f / (oversample_v * rasterizer_density);
4222:         // Register glyph
4223:         // r->x r->y are coordinates inside texture (in pixels)
4224:         // glyph.X0, glyph.Y0 are drawing coordinates from base text position, and accounting for oversampling.
4225:         out_glyph->X0 = x0 * recip_h + font_off_x;
4226:         out_glyph->Y0 = y0 * recip_v + font_off_y;
4227:         out_glyph->X1 = (x0 + (int)r->w) * recip_h + font_off_x;
4228:         out_glyph->Y1 = (y0 + (int)r->h) * recip_v + font_off_y;
4229:         out_glyph->Visible = true;
4230:         out_glyph->PackId = pack_id;
4231:         ImFontAtlasBakedSetFontGlyphBitmap(atlas, baked, src, out_glyph, r, bitmap_pixels, ImTextureFormat_Alpha8, w);
4232:     }
4233:     return true;
4234: }
