 33: */
 34: /**  @file  qnan.h
 35:  *   @brief Some utilities for our dealings with qnans.
 36:  *
 37:  *   @note Some loaders use qnans to mark invalid values tempoarily, also
 38:  *     Assimp explicitly enforces undefined normals to be set to qnan.
 39:  *     qnan utilities are available in standard libraries (C99 for example)
 40:  *     but last time I checked compiler coverage was so bad that I decided
 41:  *     to reinvent the wheel.
 42:  */
 43: #pragma once
 44: #ifndef AI_QNAN_H_INCLUDED
 45: #define AI_QNAN_H_INCLUDED
 46: #ifdef __GNUC__
 47: #   pragma GCC system_header
 48: #endif
 49: #include "defs.h"
 50: #include <limits>
 51: #include <stdint.h"
 52: // ---------------------------------------------------------------------------
 53: /** Data structure to represent the bit pattern of a 32 Bit
 54:  *         IEEE 754 floating-point number. */
 55: union _IEEESingle {
 56:     float Float;
 57:     struct
 58:     {
 59:         uint32_t Frac : 23;
 60:         uint32_t Exp  : 8;
 61:         uint32_t Sign : 1;
 62:     } IEEE;
 63: };
 64: // ---------------------------------------------------------------------------
 65: /** Data structure to represent the bit pattern of a 64 Bit
 66:  *         IEEE 754 floating-point number. */
 67: union _IEEEDouble {
 68:     double Double;
 69:     struct
 70:     {
 71:         uint64_t Frac : 52;
 72:         uint64_t Exp  : 11;
 73:         uint64_t Sign : 1;
 74:     } IEEE;
 75: };
 76: // ---------------------------------------------------------------------------
 77: /** Check whether a given float is qNaN.
 78:  *  @param in Input value */
 79: AI_FORCE_INLINE bool is_qnan(float in) {
 80:     // the straightforward solution does not work:
 81:     //   return (in != in);
 82:     // compiler generates code like this
 83:     //   load <in> to <register-with-different-width>
 84:     //   compare <register-with-different-width> against <in>
 85:     // FIXME: Use <float> stuff instead? I think fpclassify needs C99
 86:     _IEEESingle temp;
 87:     memcpy(&temp, &in, sizeof(float));
 88:     return (temp.IEEE.Exp == (1u << 8)-1 &&
 89:         temp.IEEE.Frac);
 90: }
 91: // ---------------------------------------------------------------------------
 92: /** Check whether a given double is qNaN.
 93:  *  @param in Input value */
 94: AI_FORCE_INLINE bool is_qnan(double in) {
 95:     // the straightforward solution does not work:
 96:     //   return (in != in);
 97:     // compiler generates code like this
 98:     //   load <in> to <register-with-different-width>
 99:     //   compare <register-with-different-width> against <in>
100:     // FIXME: Use <float> stuff instead? I think fpclassify needs C99
101:     _IEEEDouble temp;
102:     memcpy(&temp, &in, sizeof(in));
103:     return (temp.IEEE.Exp == (1u << 11)-1 &&
104:         temp.IEEE.Frac);
105: }
106: // ---------------------------------------------------------------------------
107: /** @brief check whether a float is either NaN or (+/-) INF.
108:  *
109:  *  Denorms return false, they're treated like normal values.
110:  *  @param in Input value */
111: AI_FORCE_INLINE bool is_special_float(float in) {
112:     _IEEESingle temp;
113:     memcpy(&temp, &in, sizeof(float));
114:     return (temp.IEEE.Exp == (1u << 8)-1);
115: }
116: // ---------------------------------------------------------------------------
117: /** @brief check whether a double is either NaN or (+/-) INF.
118:  *
119:  *  Denorms return false, they're treated like normal values.
120:  *  @param in Input value */
121: AI_FORCE_INLINE bool is_special_float(double in) {
122:    _IEEESingle temp;
123:     memcpy(&temp, &in, sizeof(float));
124:     return (temp.IEEE.Exp == (1u << 11)-1);
125: }
126: // ---------------------------------------------------------------------------
127: /** Check whether a float is NOT qNaN.
128:  *  @param in Input value */
129: template<class TReal>
130: AI_FORCE_INLINE bool is_not_qnan(TReal in) {
131:     return !is_qnan(in);
132: }
133: // ---------------------------------------------------------------------------
134: /** @brief Get a fresh qnan.  */
135: AI_FORCE_INLINE ai_real get_qnan() {
136:     return std::numeric_limits<ai_real>::quiet_NaN();
137: }
138: #endif // !! AI_QNAN_H_INCLUDED
</file>

