10805: // When a modal popup is open, newly created windows that want focus (i.e. are not popups and do not specify ImGuiWindowFlags_NoFocusOnAppearing)
10806: // should be positioned behind that modal window, unless the window was created inside the modal begin-stack.
10807: // In case of multiple stacked modals newly created window honors begin stack order and does not go below its own modal parent.
10808: // - WindowA            // FindBlockingModal() returns Modal1
10809: //   - WindowB          //                  .. returns Modal1
10810: //   - Modal1           //                  .. returns Modal2
10811: //      - WindowC       //                  .. returns Modal2
10812: //          - WindowD   //                  .. returns Modal2
10813: //          - Modal2    //                  .. returns Modal2
10814: //            - WindowE //                  .. returns NULL
10815: // Notes:
10816: // - FindBlockingModal(NULL) == NULL is generally equivalent to GetTopMostPopupModal() == NULL.
10817: //   Only difference is here we check for ->Active/WasActive but it may be unnecessary.
10818: ImGuiWindow* ImGui::FindBlockingModal(ImGuiWindow* window)
10819: {
10820:     ImGuiContext& g = *GImGui;
10821:     if (g.OpenPopupStack.Size <= 0)
10822:         return NULL;
10823:     // Find a modal that has common parent with specified window. Specified window should be positioned behind that modal.
10824:     for (ImGuiPopupData& popup_data : g.OpenPopupStack)
10825:     {
10826:         ImGuiWindow* popup_window = popup_data.Window;
10827:         if (popup_window == NULL || !(popup_window->Flags & ImGuiWindowFlags_Modal))
10828:             continue;
10829:         if (!popup_window->Active && !popup_window->WasActive)  // Check WasActive, because this code may run before popup renders on current frame, also check Active to handle newly created windows.
10830:             continue;
10831:         if (window == NULL)                                     // FindBlockingModal(NULL) test for if FocusWindow(NULL) is naturally possible via a mouse click.
10832:             return popup_window;
10833:         if (IsWindowWithinBeginStackOf(window, popup_window))   // Window may be over modal
10834:             continue;
10835:         return popup_window;                                    // Place window right below first block modal
10836:     }
10837:     return NULL;
10838: }
