2440: static void ImFontAtlasBuildUpdateRendererHasTexturesFromContext(ImFontAtlas* atlas)
2441: {
2442:     // [LEGACY] Copy back the ImGuiBackendFlags_RendererHasTextures flag from ImGui context.
2443:     // - This is the 1% exceptional case where that dependency if useful, to bypass an issue where otherwise at the
2444:     //   time of an early call to Build(), it would be impossible for us to tell if the backend supports texture update.
2445:     // - Without this hack, we would have quite a pitfall as many legacy codebases have an early call to Build().
2446:     //   Whereas conversely, the portion of people using ImDrawList without ImGui is expected to be pathologically rare.
2447:     for (ImDrawListSharedData* shared_data : atlas->DrawListSharedDatas)
2448:         if (ImGuiContext* imgui_ctx = shared_data->Context)
2449:         {
2450:             atlas->RendererHasTextures = (imgui_ctx->IO.BackendFlags & ImGuiBackendFlags_RendererHasTextures) != 0;
2451:             break;
2452:         }
2453: }
2454: // Called by NewFrame() for atlases owned by a context.
2455: // If you manually manage font atlases, you'll need to call this yourself.
2456: // - 'frame_count' needs to be provided because we can gc/prioritize baked fonts based on their age.
2457: // - 'frame_count' may not match those of all imgui contexts using this atlas, as contexts may be updated as different frequencies. But generally you can use ImGui::GetFrameCount() on one of your context.
2458: void ImFontAtlasUpdateNewFrame(ImFontAtlas* atlas, int frame_count, bool renderer_has_textures)
2459: {
2460:     IM_ASSERT(atlas->Builder == NULL || atlas->Builder->FrameCount < frame_count); // Protection against being called twice.
2461:     atlas->RendererHasTextures = renderer_has_textures;
2462:     // Check that font atlas was built or backend support texture reload in which case we can build now
2463:     if (atlas->RendererHasTextures)
2464:     {
2465:         atlas->TexIsBuilt = true;
2466:         if (atlas->Builder == NULL) // This will only happen if fonts were not already loaded.
2467:             ImFontAtlasBuildMain(atlas);
2468:     }
2469:     // Legacy backend
2470:     if (!atlas->RendererHasTextures)
2471:         IM_ASSERT_USER_ERROR(atlas->TexIsBuilt, "Backend does not support ImGuiBackendFlags_RendererHasTextures, and font atlas is not built! Update backend OR make sure you called ImGui_ImplXXXX_NewFrame() function for renderer backend, which should call io.Fonts->GetTexDataAsRGBA32() / GetTexDataAsAlpha8().");
2472:     if (atlas->TexIsBuilt && atlas->Builder->PreloadedAllGlyphsRanges)
2473:         IM_ASSERT_USER_ERROR(atlas->RendererHasTextures == false, "Called ImFontAtlas::Build() before ImGuiBackendFlags_RendererHasTextures got set! With new backends: you don't need to call Build().");
2474:     // Clear BakedCurrent cache, this is important because it ensure the uncached path gets taken once.
2475:     // We also rely on ImFontBaked* pointers never crossing frames.
2476:     ImFontAtlasBuilder* builder = atlas->Builder;
2477:     builder->FrameCount = frame_count;
2478:     for (ImFont* font : atlas->Fonts)
2479:         font->LastBaked = NULL;
2480:     // Garbage collect BakedPool
2481:     if (builder->BakedDiscardedCount > 0)
2482:     {
2483:         int dst_n = 0, src_n = 0;
2484:         for (; src_n < builder->BakedPool.Size; src_n++)
2485:         {
2486:             ImFontBaked* p_src = &builder->BakedPool[src_n];
2487:             if (p_src->WantDestroy)
2488:                 continue;
2489:             ImFontBaked* p_dst = &builder->BakedPool[dst_n++];
2490:             if (p_dst == p_src)
2491:                 continue;
2492:             memcpy(p_dst, p_src, sizeof(ImFontBaked));
2493:             builder->BakedMap.SetVoidPtr(p_dst->BakedId, p_dst);
2494:         }
2495:         IM_ASSERT(dst_n + builder->BakedDiscardedCount == src_n);
2496:         builder->BakedPool.Size -= builder->BakedDiscardedCount;
2497:         builder->BakedDiscardedCount = 0;
2498:     }
2499:     // Update texture status
2500:     for (int tex_n = 0; tex_n < atlas->TexList.Size; tex_n++)
2501:     {
2502:         ImTextureData* tex = atlas->TexList[tex_n];
2503:         bool remove_from_list = false;
2504:         if (tex->Status == ImTextureStatus_OK)
2505:         {
2506:             tex->Updates.resize(0);
2507:             tex->UpdateRect.x = tex->UpdateRect.y = (unsigned short)~0;
2508:             tex->UpdateRect.w = tex->UpdateRect.h = 0;
2509:         }
2510:         if (tex->Status == ImTextureStatus_WantCreate && atlas->RendererHasTextures)
2511:             IM_ASSERT(tex->TexID == ImTextureID_Invalid && tex->BackendUserData == NULL && "Backend set texture's TexID/BackendUserData but did not update Status to OK.");
2512:         // Request destroy
2513:         // - Keep bool to true in order to differentiate a planned destroy vs a destroy decided by the backend.
2514:         // - We don't destroy pixels right away, as backend may have an in-flight copy from RAM.
2515:         if (tex->WantDestroyNextFrame && tex->Status != ImTextureStatus_Destroyed && tex->Status != ImTextureStatus_WantDestroy)
2516:         {
2517:             IM_ASSERT(tex->Status == ImTextureStatus_OK || tex->Status == ImTextureStatus_WantCreate || tex->Status == ImTextureStatus_WantUpdates);
2518:             tex->Status = ImTextureStatus_WantDestroy;
2519:         }
2520:         // If a texture has never reached the backend, they don't need to know about it.
2521:         // (note: backends between 1.92.0 and 1.92.4 could set an already destroyed texture to ImTextureStatus_WantDestroy
2522:         //  when invalidating graphics objects twice, which would previously remove it from the list and crash.)
2523:         if (tex->Status == ImTextureStatus_WantDestroy && tex->TexID == ImTextureID_Invalid && tex->BackendUserData == NULL)
2524:             tex->Status = ImTextureStatus_Destroyed;
2525:         // Process texture being destroyed
2526:         if (tex->Status == ImTextureStatus_Destroyed)
2527:         {
2528:             IM_ASSERT(tex->TexID == ImTextureID_Invalid && tex->BackendUserData == NULL && "Backend set texture Status to Destroyed but did not clear TexID/BackendUserData!");
2529:             if (tex->WantDestroyNextFrame)
2530:                 remove_from_list = true; // Destroy was scheduled by us
2531:             else
2532:                 tex->Status = ImTextureStatus_WantCreate; // Destroy was done was backend: recreate it (e.g. freed resources mid-run)
2533:         }
2534:         // The backend may need defer destroying by a few frames, to handle texture used by previous in-flight rendering.
2535:         // We allow the texture staying in _WantDestroy state and increment a counter which the backend can use to take its decision.
2536:         if (tex->Status == ImTextureStatus_WantDestroy)
2537:             tex->UnusedFrames++;
2538:         // Destroy and remove
2539:         if (remove_from_list)
2540:         {
2541:             IM_ASSERT(atlas->TexData != tex);
2542:             tex->DestroyPixels();
2543:             IM_DELETE(tex);
2544:             atlas->TexList.erase(atlas->TexList.begin() + tex_n);
2545:             tex_n--;
2546:         }
2547:     }
2548: }
2549: void ImFontAtlasTextureBlockConvert(const unsigned char* src_pixels, ImTextureFormat src_fmt, int src_pitch, unsigned char* dst_pixels, ImTextureFormat dst_fmt, int dst_pitch, int w, int h)
2550: {
2551:     IM_ASSERT(src_pixels != NULL && dst_pixels != NULL);
2552:     if (src_fmt == dst_fmt)
2553:     {
2554:         int line_sz = w * ImTextureDataGetFormatBytesPerPixel(src_fmt);
2555:         for (int ny = h; ny > 0; ny--, src_pixels += src_pitch, dst_pixels += dst_pitch)
2556:             memcpy(dst_pixels, src_pixels, line_sz);
2557:     }
2558:     else if (src_fmt == ImTextureFormat_Alpha8 && dst_fmt == ImTextureFormat_RGBA32)
2559:     {
2560:         for (int ny = h; ny > 0; ny--, src_pixels += src_pitch, dst_pixels += dst_pitch)
2561:         {
2562:             const ImU8* src_p = (const ImU8*)src_pixels;
2563:             ImU32* dst_p = (ImU32*)(void*)dst_pixels;
2564:             for (int nx = w; nx > 0; nx--)
2565:                 *dst_p++ = IM_COL32(255, 255, 255, (unsigned int)(*src_p++));
2566:         }
2567:     }
2568:     else if (src_fmt == ImTextureFormat_RGBA32 && dst_fmt == ImTextureFormat_Alpha8)
2569:     {
2570:         for (int ny = h; ny > 0; ny--, src_pixels += src_pitch, dst_pixels += dst_pitch)
2571:         {
2572:             const ImU32* src_p = (const ImU32*)(void*)src_pixels;
2573:             ImU8* dst_p = (ImU8*)dst_pixels;
2574:             for (int nx = w; nx > 0; nx--)
2575:                 *dst_p++ = ((*src_p++) >> IM_COL32_A_SHIFT) & 0xFF;
2576:         }
2577:     }
2578:     else
2579:     {
2580:         IM_ASSERT(0);
2581:     }
2582: }
2583: // Source buffer may be written to (used for in-place mods).
2584: // Post-process hooks may eventually be added here.
2585: void ImFontAtlasTextureBlockPostProcess(ImFontAtlasPostProcessData* data)
2586: {
2587:     // Multiply operator (legacy)
2588:     if (data->FontSrc->RasterizerMultiply != 1.0f)
2589:         ImFontAtlasTextureBlockPostProcessMultiply(data, data->FontSrc->RasterizerMultiply);
2590: }
2591: void ImFontAtlasTextureBlockPostProcessMultiply(ImFontAtlasPostProcessData* data, float multiply_factor)
2592: {
2593:     unsigned char* pixels = (unsigned char*)data->Pixels;
2594:     int pitch = data->Pitch;
2595:     if (data->Format == ImTextureFormat_Alpha8)
2596:     {
2597:         for (int ny = data->Height; ny > 0; ny--, pixels += pitch)
2598:         {
2599:             ImU8* p = (ImU8*)pixels;
2600:             for (int nx = data->Width; nx > 0; nx--, p++)
2601:             {
2602:                 unsigned int v = ImMin((unsigned int)(*p * multiply_factor), (unsigned int)255);
2603:                 *p = (unsigned char)v;
2604:             }
2605:         }
2606:     }
2607:     else if (data->Format == ImTextureFormat_RGBA32) //-V547
2608:     {
2609:         for (int ny = data->Height; ny > 0; ny--, pixels += pitch)
2610:         {
2611:             ImU32* p = (ImU32*)(void*)pixels;
2612:             for (int nx = data->Width; nx > 0; nx--, p++)
2613:             {
2614:                 unsigned int a = ImMin((unsigned int)(((*p >> IM_COL32_A_SHIFT) & 0xFF) * multiply_factor), (unsigned int)255);
2615:                 *p = IM_COL32((*p >> IM_COL32_R_SHIFT) & 0xFF, (*p >> IM_COL32_G_SHIFT) & 0xFF, (*p >> IM_COL32_B_SHIFT) & 0xFF, a);
2616:             }
2617:         }
2618:     }
2619:     else
2620:     {
2621:         IM_ASSERT(0);
2622:     }
2623: }
2624: // Fill with single color. We don't use this directly but it is convenient for anyone working on uploading custom rects.
2625: void ImFontAtlasTextureBlockFill(ImTextureData* dst_tex, int dst_x, int dst_y, int w, int h, ImU32 col)
2626: {
2627:     if (dst_tex->Format == ImTextureFormat_Alpha8)
2628:     {
2629:         ImU8 col_a = (col >> IM_COL32_A_SHIFT) & 0xFF;
2630:         for (int y = 0; y < h; y++)
2631:             memset((ImU8*)dst_tex->GetPixelsAt(dst_x, dst_y + y), col_a, w);
2632:     }
2633:     else
2634:     {
2635:         for (int y = 0; y < h; y++)
2636:         {
2637:             ImU32* p = (ImU32*)(void*)dst_tex->GetPixelsAt(dst_x, dst_y + y);
2638:             for (int x = w; x > 0; x--, p++)
2639:                 *p = col;
2640:         }
2641:     }
2642: }
2643: // Copy block from one texture to another
2644: void ImFontAtlasTextureBlockCopy(ImTextureData* src_tex, int src_x, int src_y, ImTextureData* dst_tex, int dst_x, int dst_y, int w, int h)
2645: {
2646:     IM_ASSERT(src_tex->Pixels != NULL && dst_tex->Pixels != NULL);
2647:     IM_ASSERT(src_tex->Format == dst_tex->Format);
2648:     IM_ASSERT(src_x >= 0 && src_x + w <= src_tex->Width);
2649:     IM_ASSERT(src_y >= 0 && src_y + h <= src_tex->Height);
2650:     IM_ASSERT(dst_x >= 0 && dst_x + w <= dst_tex->Width);
2651:     IM_ASSERT(dst_y >= 0 && dst_y + h <= dst_tex->Height);
2652:     for (int y = 0; y < h; y++)
2653:         memcpy(dst_tex->GetPixelsAt(dst_x, dst_y + y), src_tex->GetPixelsAt(src_x, src_y + y), w * dst_tex->BytesPerPixel);
2654: }
2655: // Queue texture block update for renderer backend
2656: void ImFontAtlasTextureBlockQueueUpload(ImFontAtlas* atlas, ImTextureData* tex, int x, int y, int w, int h)
2657: {
2658:     IM_ASSERT(tex->Status != ImTextureStatus_WantDestroy && tex->Status != ImTextureStatus_Destroyed);
2659:     IM_ASSERT(x >= 0 && x <= 0xFFFF && y >= 0 && y <= 0xFFFF && w >= 0 && x + w <= 0x10000 && h >= 0 && y + h <= 0x10000);
2660:     IM_UNUSED(atlas);
2661:     ImTextureRect req = { (unsigned short)x, (unsigned short)y, (unsigned short)w, (unsigned short)h };
2662:     int new_x1 = ImMax(tex->UpdateRect.w == 0 ? 0 : tex->UpdateRect.x + tex->UpdateRect.w, req.x + req.w);
2663:     int new_y1 = ImMax(tex->UpdateRect.h == 0 ? 0 : tex->UpdateRect.y + tex->UpdateRect.h, req.y + req.h);
2664:     tex->UpdateRect.x = ImMin(tex->UpdateRect.x, req.x);
2665:     tex->UpdateRect.y = ImMin(tex->UpdateRect.y, req.y);
2666:     tex->UpdateRect.w = (unsigned short)(new_x1 - tex->UpdateRect.x);
2667:     tex->UpdateRect.h = (unsigned short)(new_y1 - tex->UpdateRect.y);
2668:     tex->UsedRect.x = ImMin(tex->UsedRect.x, req.x);
2669:     tex->UsedRect.y = ImMin(tex->UsedRect.y, req.y);
2670:     tex->UsedRect.w = (unsigned short)(ImMax(tex->UsedRect.x + tex->UsedRect.w, req.x + req.w) - tex->UsedRect.x);
2671:     tex->UsedRect.h = (unsigned short)(ImMax(tex->UsedRect.y + tex->UsedRect.h, req.y + req.h) - tex->UsedRect.y);
2672:     atlas->TexIsBuilt = false;
2673:     // No need to queue if status is == ImTextureStatus_WantCreate
2674:     if (tex->Status == ImTextureStatus_OK || tex->Status == ImTextureStatus_WantUpdates)
2675:     {
2676:         tex->Status = ImTextureStatus_WantUpdates;
2677:         tex->Updates.push_back(req);
2678:     }
2679: }
