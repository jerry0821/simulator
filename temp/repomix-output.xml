3345:     g.NextItemData.ItemFlags |= ImGuiItemFlags_NoMarkEdited;
3346:     flags |= ImGuiInputTextFlags_AutoSelectAll | (ImGuiInputTextFlags)ImGuiInputTextFlags_LocalizeDecimalPoint;
