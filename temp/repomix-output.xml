8638: void    ImGui::EndTabBar()
8639: {
8640:     ImGuiContext& g = *GImGui;
8641:     ImGuiWindow* window = g.CurrentWindow;
8642:     if (window->SkipItems)
8643:         return;
8644:     ImGuiTabBar* tab_bar = g.CurrentTabBar;
8645:     if (tab_bar == NULL)
8646:     {
8647:         IM_ASSERT_USER_ERROR(tab_bar != NULL, "Mismatched BeginTabBar()/EndTabBar()!");
8648:         return;
8649:     }
8650:     // Fallback in case no TabItem have been submitted
8651:     if (tab_bar->WantLayout)
8652:         TabBarLayout(tab_bar);
8653:     // Restore the last visible height if no tab is visible, this reduce vertical flicker/movement when a tabs gets removed without calling SetTabItemClosed().
8654:     const bool tab_bar_appearing = (tab_bar->PrevFrameVisible + 1 < g.FrameCount);
8655:     if (tab_bar->VisibleTabWasSubmitted || tab_bar->VisibleTabId == 0 || tab_bar_appearing)
8656:     {
8657:         tab_bar->CurrTabsContentsHeight = ImMax(window->DC.CursorPos.y - tab_bar->BarRect.Max.y, tab_bar->CurrTabsContentsHeight);
8658:         window->DC.CursorPos.y = tab_bar->BarRect.Max.y + tab_bar->CurrTabsContentsHeight;
8659:     }
8660:     else
8661:     {
8662:         window->DC.CursorPos.y = tab_bar->BarRect.Max.y + tab_bar->PrevTabsContentsHeight;
8663:     }
8664:     if (tab_bar->BeginCount > 1)
8665:         window->DC.CursorPos = tab_bar->BackupCursorPos;
8666:     tab_bar->LastTabItemIdx = -1;
8667:     if ((tab_bar->Flags & ImGuiTabBarFlags_DockNode) == 0)
8668:         PopID();
8669:     g.CurrentTabBarStack.pop_back();
8670:     g.CurrentTabBar = g.CurrentTabBarStack.empty() ? NULL : GetTabBarFromTabBarRef(g.CurrentTabBarStack.back());
8671: }
8672: // Scrolling happens only in the central section (leading/trailing sections are not scrolling)
8673: static float TabBarCalcScrollableWidth(ImGuiTabBar* tab_bar, ImGuiTabBarSection* sections)
8674: {
8675:     return tab_bar->BarRect.GetWidth() - sections[0].Width - sections[2].Width - sections[1].Spacing;
8676: }
8677: // This is called only once a frame before by the first call to ItemTab()
8678: // The reason we're not calling it in BeginTabBar() is to leave a chance to the user to call the SetTabItemClosed() functions.
8679: static void ImGui::TabBarLayout(ImGuiTabBar* tab_bar)
8680: {
8681:     ImGuiContext& g = *GImGui;
8682:     tab_bar->WantLayout = false;
