5076: // ColorEdit supports RGB and HSV inputs. In case of RGB input resulting color may have undefined hue and/or saturation.
5077: // Since widget displays both RGB and HSV values we must preserve hue and saturation to prevent these values resetting.
5078: static void ColorEditRestoreHS(const float* col, float* H, float* S, float* V)
5079: {
5080:     ImGuiContext& g = *GImGui;
5081:     IM_ASSERT(g.ColorEditCurrentID != 0);
5082:     if (g.ColorEditSavedID != g.ColorEditCurrentID || g.ColorEditSavedColor != ImGui::ColorConvertFloat4ToU32(ImVec4(col[0], col[1], col[2], 0)))
5083:         return;
5084:     // When S == 0, H is undefined.
5085:     // When H == 1 it wraps around to 0.
5086:     if (*S == 0.0f || (*H == 0.0f && g.ColorEditSavedHue == 1))
5087:         *H = g.ColorEditSavedHue;
5088:     // When V == 0, S is undefined.
5089:     if (*V == 0.0f)
5090:         *S = g.ColorEditSavedSat;
