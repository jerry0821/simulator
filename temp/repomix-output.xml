11234:             return pos;
11235:         }
11236:     }
11237:     // Fallback when not enough room:
11238:     *last_dir = ImGuiDir_None;
11239:     // For tooltip we prefer avoiding the cursor at all cost even if it means that part of the tooltip won't be visible.
11240:     if (policy == ImGuiPopupPositionPolicy_Tooltip)
11241:         return ref_pos + ImVec2(2, 2);
11242:     // Otherwise try to keep within display
11243:     ImVec2 pos = ref_pos;
11244:     pos.x = ImMax(ImMin(pos.x + size.x, r_outer.Max.x) - size.x, r_outer.Min.x);
11245:     pos.y = ImMax(ImMin(pos.y + size.y, r_outer.Max.y) - size.y, r_outer.Min.y);
11246:     return pos;
11247: }
11248: // Note that this is used for popups, which can overlap the non work-area of individual viewports.
11249: ImRect ImGui::GetPopupAllowedExtentRect(ImGuiWindow* window)
11250: {
11251:     ImGuiContext& g = *GImGui;
11252:     IM_UNUSED(window);
11253:     ImRect r_screen = ((ImGuiViewportP*)(void*)GetMainViewport())->GetMainRect();
11254:     ImVec2 padding = g.Style.DisplaySafeAreaPadding;
11255:     r_screen.Expand(ImVec2((r_screen.GetWidth() > padding.x * 2) ? -padding.x : 0.0f, (r_screen.GetHeight() > padding.y * 2) ? -padding.y : 0.0f));
11256:     return r_screen;
11257: }
11258: ImVec2 ImGui::FindBestWindowPosForPopup(ImGuiWindow* window)
11259: {
11260:     ImGuiContext& g = *GImGui;
11261:     ImRect r_outer = GetPopupAllowedExtentRect(window);
11262:     if (window->Flags & ImGuiWindowFlags_ChildMenu)
11263:     {
11264:         // Child menus typically request _any_ position within the parent menu item, and then we move the new menu outside the parent bounds.
11265:         // This is how we end up with child menus appearing (most-commonly) on the right of the parent menu.
11266:         IM_ASSERT(g.CurrentWindow == window);
11267:         ImGuiWindow* parent_window = g.CurrentWindowStack[g.CurrentWindowStack.Size - 2].Window;
11268:         float horizontal_overlap = g.Style.ItemInnerSpacing.x; // We want some overlap to convey the relative depth of each menu (currently the amount of overlap is hard-coded to style.ItemSpacing.x).
11269:         ImRect r_avoid;
11270:         if (parent_window->DC.MenuBarAppending)
11271:             r_avoid = ImRect(-FLT_MAX, parent_window->ClipRect.Min.y, FLT_MAX, parent_window->ClipRect.Max.y); // Avoid parent menu-bar. If we wanted multi-line menu-bar, we may instead want to have the calling window setup e.g. a NextWindowData.PosConstraintAvoidRect field
11272:         else
11273:             r_avoid = ImRect(parent_window->Pos.x + horizontal_overlap, -FLT_MAX, parent_window->Pos.x + parent_window->Size.x - horizontal_overlap - parent_window->ScrollbarSizes.x, FLT_MAX);
11274:         return FindBestWindowPosForPopupEx(window->Pos, window->Size, &window->AutoPosLastDirection, r_outer, r_avoid, ImGuiPopupPositionPolicy_Default);
11275:     }
11276:     if (window->Flags & ImGuiWindowFlags_Popup)
11277:     {
11278:         return FindBestWindowPosForPopupEx(window->Pos, window->Size, &window->AutoPosLastDirection, r_outer, ImRect(window->Pos, window->Pos), ImGuiPopupPositionPolicy_Default); // Ideally we'd disable r_avoid here
11279:     }
11280:     if (window->Flags & ImGuiWindowFlags_Tooltip)
11281:     {
11282:         // Position tooltip (always follows mouse + clamp within outer boundaries)
11283:         // FIXME:
11284:         // - Too many paths. One problem is that FindBestWindowPosForPopupEx() doesn't allow passing a suggested position (so touch screen path doesn't use it by default).
11285:         // - Drag and drop tooltips are not using this path either: BeginTooltipEx() manually sets their position.
11286:         // - Require some tidying up. In theory we could handle both cases in same location, but requires a bit of shuffling
11287:         //   as drag and drop tooltips are calling SetNextWindowPos() leading to 'window_pos_set_by_api' being set in Begin().
11288:         IM_ASSERT(g.CurrentWindow == window);
11289:         const float scale = g.Style.MouseCursorScale;
11290:         const ImVec2 ref_pos = NavCalcPreferredRefPos();
11291:         if (g.IO.MouseSource == ImGuiMouseSource_TouchScreen && NavCalcPreferredRefPosSource() == ImGuiInputSource_Mouse)
11292:         {
11293:             ImVec2 tooltip_pos = ref_pos + TOOLTIP_DEFAULT_OFFSET_TOUCH * scale - (TOOLTIP_DEFAULT_PIVOT_TOUCH * window->Size);
11294:             if (r_outer.Contains(ImRect(tooltip_pos, tooltip_pos + window->Size)))
11295:                 return tooltip_pos;
11296:         }
11297:         ImVec2 tooltip_pos = ref_pos + TOOLTIP_DEFAULT_OFFSET_MOUSE * scale;
11298:         ImRect r_avoid;
11299:         if (g.NavCursorVisible && g.NavHighlightItemUnderNav && !g.IO.ConfigNavMoveSetMousePos)
11300:             r_avoid = ImRect(ref_pos.x - 16, ref_pos.y - 8, ref_pos.x + 16, ref_pos.y + 8);
11301:         else
11302:             r_avoid = ImRect(ref_pos.x - 16, ref_pos.y - 8, ref_pos.x + 24 * scale, ref_pos.y + 24 * scale); // FIXME: Hard-coded based on mouse cursor shape expectation. Exact dimension not very important.
11303:         //GetForegroundDrawList()->AddRect(r_avoid.Min, r_avoid.Max, IM_COL32(255, 0, 255, 255));
11304:         return FindBestWindowPosForPopupEx(tooltip_pos, window->Size, &window->AutoPosLastDirection, r_outer, r_avoid, ImGuiPopupPositionPolicy_Tooltip);
11305:     }
11306:     IM_ASSERT(0);
11307:     return window->Pos;
11308: }
