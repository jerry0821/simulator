 12: #include "imgui.h"
 13: #include "imgui_impl_win32.h"
 14: #include "imgui_impl_dx11.h"
 15: // ウィンドウ情報
 16: static constexpr char WINDOW_CLASS[] = "GameWindow"; // メインウインドウクラス名
 17: static constexpr char TITLE[] = "Game";	// 	タイトルバーのテクスト
 18: const constexpr int SCREEN_WIDTH = 1920;
 19: const constexpr int SCREEN_HEIGHT = 1080;
 20: extern IMGUI_IMPL_API LRESULT ImGui_ImplWin32_WndProcHandler(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam);
 21: // ウインドウプロシージャ　プロトタイプ宣言
 22: LRESULT CALLBACK WndProc(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam);
 23: HWND GameWindow_Create(_In_ HINSTANCE hInstance)
 24: {
 25: 	// ウインドウクラスの登録
 26: 	WNDCLASSEX wcex{};
 27: 	wcex.cbSize = sizeof(WNDCLASSEX);
 28: 	wcex.lpfnWndProc = WndProc;
 29: 	wcex.hInstance = hInstance;
 30: 	wcex.hIcon = LoadIcon(hInstance, IDI_APPLICATION);
 31: 	wcex.hCursor = LoadCursor(nullptr, IDC_ARROW);
 32: 	wcex.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);
 33: 	wcex.lpszMenuName = nullptr;
 34: 	wcex.lpszClassName = WINDOW_CLASS;
 35: 	wcex.hIconSm = LoadIcon(wcex.hInstance, IDI_APPLICATION);
 36: 	RegisterClassEx(&wcex);
 37: 	// メインウィンドウの作成
 38: 	RECT window_rect{
 39: 		0, 0, SCREEN_WIDTH, SCREEN_HEIGHT
 40: 	};
 41: 	DWORD style = WS_OVERLAPPEDWINDOW & ~(WS_MAXIMIZEBOX | WS_THICKFRAME);
 42: 	AdjustWindowRect(&window_rect, style, FALSE);
 43: 	const int WINDOW_WIDTH = window_rect.right - window_rect.left;
 44: 	const int WINDOW_HEIGHT = window_rect.bottom - window_rect.top;
 45: 	// デスクトップのサイズを取得
 46: 	// ライブラリモニターの画面解像度取得
 47: 	int desktop_width = GetSystemMetrics(SM_CXSCREEN);
 48: 	int desktop_height = GetSystemMetrics(SM_CYSCREEN);
 49: 	// ウインドウの表示位置をデスクトップの真ん中に調整する
 50: 	// offset to center, use std::max to prevent window overflow
 51: 	const int WINDOW_X = std::max(0, (desktop_width - WINDOW_WIDTH) / 2);
 52: 	const int WINDOW_Y = std::max(0, (desktop_height - WINDOW_HEIGHT) / 2);
 53: 	HWND hWnd = CreateWindow(
 54: 		WINDOW_CLASS,
