13658: // Called by NewFrame()
13659: void ImGui::UpdateSettings()
13660: {
13661:     // Load settings on first frame (if not explicitly loaded manually before)
13662:     ImGuiContext& g = *GImGui;
13663:     if (!g.SettingsLoaded)
13664:     {
13665:         IM_ASSERT(g.SettingsWindows.empty());
13666:         if (g.IO.IniFilename)
13667:             LoadIniSettingsFromDisk(g.IO.IniFilename);
13668:         g.SettingsLoaded = true;
13669:     }
13670:     // Save settings (with a delay after the last modification, so we don't spam disk too much)
13671:     if (g.SettingsDirtyTimer > 0.0f)
13672:     {
13673:         g.SettingsDirtyTimer -= g.IO.DeltaTime;
13674:         if (g.SettingsDirtyTimer <= 0.0f)
13675:         {
13676:             if (g.IO.IniFilename != NULL)
13677:                 SaveIniSettingsToDisk(g.IO.IniFilename);
13678:             else
13679:                 g.IO.WantSaveIniSettings = true;  // Let user know they can call SaveIniSettingsToMemory(). user will need to clear io.WantSaveIniSettings themselves.
13680:             g.SettingsDirtyTimer = 0.0f;
13681:         }
13682:     }
13683: }
