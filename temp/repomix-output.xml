12088: static ImGuiInputSource ImGui::NavCalcPreferredRefPosSource()
12089: {
12090:     ImGuiContext& g = *GImGui;
12091:     ImGuiWindow* window = g.NavWindow;
12092:     const bool activated_shortcut = g.ActiveId != 0 && g.ActiveIdFromShortcut && g.ActiveId == g.LastItemData.ID;
12093:     // Testing for !activated_shortcut here could in theory be removed if we decided that activating a remote shortcut altered one of the g.NavDisableXXX flag.
12094:     if ((!g.NavCursorVisible || !g.NavHighlightItemUnderNav || !window) && !activated_shortcut)
12095:         return ImGuiInputSource_Mouse;
12096:     else
12097:         return ImGuiInputSource_Keyboard; // or Nav in general
12098: }
12099: static ImVec2 ImGui::NavCalcPreferredRefPos()
12100: {
12101:     ImGuiContext& g = *GImGui;
12102:     ImGuiWindow* window = g.NavWindow;
12103:     ImGuiInputSource source = NavCalcPreferredRefPosSource();
12104:     const bool activated_shortcut = g.ActiveId != 0 && g.ActiveIdFromShortcut && g.ActiveId == g.LastItemData.ID;
12105:     if (source != ImGuiInputSource_Mouse && !activated_shortcut && window == NULL)
12106:         source = ImGuiInputSource_Mouse;
12107:     // Testing for !activated_shortcut here could in theory be removed if we decided that activating a remote shortcut altered one of the g.NavDisableXXX flag.
12108:     if (source == ImGuiInputSource_Mouse)
12109:     {
12110:         // Mouse (we need a fallback in case the mouse becomes invalid after being used)
12111:         // The +1.0f offset when stored by OpenPopupEx() allows reopening this or another popup (same or another mouse button) while not moving the mouse, it is pretty standard.
12112:         // In theory we could move that +1.0f offset in OpenPopupEx()
12113:         ImVec2 p = IsMousePosValid(&g.IO.MousePos) ? g.IO.MousePos : g.MouseLastValidPos;
12114:         return ImVec2(p.x + 1.0f, p.y);
12115:     }
12116:     else
12117:     {
12118:         // When navigation is active and mouse is disabled, pick a position around the bottom left of the currently navigated item
12119:         ImRect ref_rect;
12120:         if (activated_shortcut)
12121:             ref_rect = g.LastItemData.NavRect;
12122:         else if (window != NULL)
12123:             ref_rect = WindowRectRelToAbs(window, window->NavRectRel[g.NavLayer]);
12124:         // Take account of upcoming scrolling (maybe set mouse pos should be done in EndFrame?)
12125:         if (window != NULL && window->LastFrameActive != g.FrameCount && (window->ScrollTarget.x != FLT_MAX || window->ScrollTarget.y != FLT_MAX))
12126:         {
12127:             ImVec2 next_scroll = CalcNextScrollFromScrollTargetAndClamp(window);
12128:             ref_rect.Translate(window->Scroll - next_scroll);
12129:         }
12130:         ImVec2 pos = ImVec2(ref_rect.Min.x + ImMin(g.Style.FramePadding.x * 4, ref_rect.GetWidth()), ref_rect.Max.y - ImMin(g.Style.FramePadding.y, ref_rect.GetHeight()));
12131:         ImGuiViewport* viewport = GetMainViewport();
12132:         return ImTrunc(ImClamp(pos, viewport->Pos, viewport->Pos + viewport->Size)); // ImTrunc() is important because non-integer mouse position application in backend might be lossy and result in undesirable non-zero delta.
12133:     }
12134: }
12135: float ImGui::GetNavTweakPressedAmount(ImGuiAxis axis)
12136: {
12137:     ImGuiContext& g = *GImGui;
12138:     float repeat_delay, repeat_rate;
12139:     GetTypematicRepeatRate(ImGuiInputFlags_RepeatRateNavTweak, &repeat_delay, &repeat_rate);
12140:     ImGuiKey key_less, key_more;
12141:     if (g.NavInputSource == ImGuiInputSource_Gamepad)
12142:     {
12143:         key_less = (axis == ImGuiAxis_X) ? ImGuiKey_GamepadDpadLeft : ImGuiKey_GamepadDpadUp;
12144:         key_more = (axis == ImGuiAxis_X) ? ImGuiKey_GamepadDpadRight : ImGuiKey_GamepadDpadDown;
12145:     }
12146:     else
12147:     {
12148:         key_less = (axis == ImGuiAxis_X) ? ImGuiKey_LeftArrow : ImGuiKey_UpArrow;
12149:         key_more = (axis == ImGuiAxis_X) ? ImGuiKey_RightArrow : ImGuiKey_DownArrow;
12150:     }
12151:     float amount = (float)GetKeyPressedAmount(key_more, repeat_delay, repeat_rate) - (float)GetKeyPressedAmount(key_less, repeat_delay, repeat_rate);
12152:     if (amount != 0.0f && IsKeyDown(key_less) && IsKeyDown(key_more)) // Cancel when opposite directions are held, regardless of repeat phase
12153:         amount = 0.0f;
12154:     return amount;
12155: }
