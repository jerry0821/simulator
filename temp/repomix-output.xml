 33: /** @file quaternion.h
 34:  *  @brief Quaternion structure, including operators when compiling in C++
 35:  */
 36: #pragma once
 37: #ifndef AI_QUATERNION_H_INC
 38: #define AI_QUATERNION_H_INC
 39: #ifdef __cplusplus
 40: #ifdef __GNUC__
 41: #   pragma GCC system_header
 42: #endif
 43: #include "defs.h"
 44: template <typename TReal> class aiVector3t;
 45: template <typename TReal> class aiMatrix3x3t;
 46: template <typename TReal> class aiMatrix4x4t;
 47: // ---------------------------------------------------------------------------
 48: /** Represents a quaternion in a 4D vector. */
 49: template <typename TReal>
 50: class aiQuaterniont
 51: {
 52: public:
 53:     aiQuaterniont() AI_NO_EXCEPT : w(1.0), x(), y(), z() {}
 54:     aiQuaterniont(TReal pw, TReal px, TReal py, TReal pz)
 55:         : w(pw), x(px), y(py), z(pz) {}
 56:     /** Construct from rotation matrix. Result is undefined if the matrix is not orthonormal. */
 57:     explicit aiQuaterniont( const aiMatrix3x3t<TReal>& pRotMatrix);
 58:     /** Construct from euler angles */
 59:     aiQuaterniont( TReal roty, TReal rotz, TReal rotx);
 60:     /** Construct from an axis-angle pair */
 61:     aiQuaterniont( aiVector3t<TReal> axis, TReal angle);
 62:     /** Construct from a normalized quaternion stored in a vec3 */
 63:     explicit aiQuaterniont( aiVector3t<TReal> normalized);
 64:     /** Returns a matrix representation of the quaternion */
 65:     aiMatrix3x3t<TReal> GetMatrix() const;
 66: public:
 67:     bool operator== (const aiQuaterniont& o) const;
 68:     bool operator!= (const aiQuaterniont& o) const;
 69:     // transform vector by matrix
 70:     aiQuaterniont& operator *= (const aiMatrix4x4t<TReal>& mat);
 71:     bool Equal(const aiQuaterniont &o, TReal epsilon = ai_epsilon) const;
 72: public:
 73:     /** Normalize the quaternion */
 74:     aiQuaterniont& Normalize();
 75:     /** Compute quaternion conjugate */
 76:     aiQuaterniont& Conjugate ();
