 1: /*==============================================================================
 2: 
 3:    ビルボード描画用ピクセルシェーダー [shader_pixel_billboard.hlsl]
 4: 														 Author : Youhei Sato
 5: 														 Date   : 2025/11/14
 6: --------------------------------------------------------------------------------
 7: 
 8: ==============================================================================*/
 9: 
10: cbuffer PS_CONSTANT_BUFFER : register(b0)
11: {
12:     float4 diffuse_color;
13: };
14: 
15: struct PS_INPUT
16: {
17:     float4 posH : SV_POSITION;
18:     float4 color : COLOR0;
19:     float2 uv : TEXCOORD0;
20: };
21: 
22: Texture2D tex; // テクスチャ
23: SamplerState samp; // テクスチャさんプラ
24: 
25: float4 main(PS_INPUT ps_in) : SV_TARGET
26: {
27:     // return ps_in.color;
28:     float4 color = tex.Sample(samp, ps_in.uv) * ps_in.color * diffuse_color;
29:     //float4 color = tex.Sample(samp, ps_in.uv) * diffuse_color;
30:     if (color.a < 0.1f)
31:     {
32:         discard;
33:     }
34:     return color;
35: }
