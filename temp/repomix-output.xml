 4784: void ImGui::UpdateHoveredWindowAndCaptureFlags(const ImVec2& mouse_pos)
 4785: {
 4786:     ImGuiContext& g = *GImGui;
 4787:     ImGuiIO& io = g.IO;
 4788:     // FIXME-DPI: This storage was added on 2021/03/31 for test engine, but if we want to multiply WINDOWS_HOVER_PADDING
 4789:     // by DpiScale, we need to make this window-agnostic anyhow, maybe need storing inside ImGuiWindow.
 4790:     g.WindowsBorderHoverPadding = ImMax(ImMax(g.Style.TouchExtraPadding.x, g.Style.TouchExtraPadding.y), g.Style.WindowBorderHoverPadding);
 4791:     // Find the window hovered by mouse:
 4792:     // - Child windows can extend beyond the limit of their parent so we need to derive HoveredRootWindow from HoveredWindow.
 4793:     // - When moving a window we can skip the search, which also conveniently bypasses the fact that window->WindowRectClipped is lagging as this point of the frame.
 4794:     // - We also support the moved window toggling the NoInputs flag after moving has started in order to be able to detect windows below it, which is useful for e.g. docking mechanisms.
 4795:     bool clear_hovered_windows = false;
 4796:     FindHoveredWindowEx(mouse_pos, false, &g.HoveredWindow, &g.HoveredWindowUnderMovingWindow);
 4797:     g.HoveredWindowBeforeClear = g.HoveredWindow;
 4798:     // Modal windows prevents mouse from hovering behind them.
 4799:     ImGuiWindow* modal_window = GetTopMostPopupModal();
 4800:     if (modal_window && g.HoveredWindow && !IsWindowWithinBeginStackOf(g.HoveredWindow->RootWindow, modal_window))
 4801:         clear_hovered_windows = true;
 4802:     // Disabled mouse hovering (we don't currently clear MousePos, we could)
 4803:     if (io.ConfigFlags & ImGuiConfigFlags_NoMouse)
 4804:         clear_hovered_windows = true;
 4805:     // We track click ownership. When clicked outside of a window the click is owned by the application and
 4806:     // won't report hovering nor request capture even while dragging over our windows afterward.
 4807:     const bool has_open_popup = (g.OpenPopupStack.Size > 0);
 4808:     const bool has_open_modal = (modal_window != NULL);
 4809:     int mouse_earliest_down = -1;
 4810:     bool mouse_any_down = false;
 4811:     for (int i = 0; i < IM_ARRAYSIZE(io.MouseDown); i++)
 4812:     {
 4813:         if (io.MouseClicked[i])
 4814:         {
 4815:             io.MouseDownOwned[i] = (g.HoveredWindow != NULL) || has_open_popup;
 4816:             io.MouseDownOwnedUnlessPopupClose[i] = (g.HoveredWindow != NULL) || has_open_modal;
 4817:         }
 4818:         mouse_any_down |= io.MouseDown[i];
 4819:         if (io.MouseDown[i] || io.MouseReleased[i]) // Increase release frame for our evaluation of earliest button (#1392)
 4820:             if (mouse_earliest_down == -1 || io.MouseClickedTime[i] < io.MouseClickedTime[mouse_earliest_down])
 4821:                 mouse_earliest_down = i;
 4822:     }
 4823:     const bool mouse_avail = (mouse_earliest_down == -1) || io.MouseDownOwned[mouse_earliest_down];
 4824:     const bool mouse_avail_unless_popup_close = (mouse_earliest_down == -1) || io.MouseDownOwnedUnlessPopupClose[mouse_earliest_down];
 4825:     // If mouse was first clicked outside of ImGui bounds we also cancel out hovering.
 4826:     // FIXME: For patterns of drag and drop across OS windows, we may need to rework/remove this test (first committed 311c0ca9 on 2015/02)
 4827:     const bool mouse_dragging_extern_payload = g.DragDropActive && (g.DragDropSourceFlags & ImGuiDragDropFlags_SourceExtern) != 0;
 4828:     if (!mouse_avail && !mouse_dragging_extern_payload)
 4829:         clear_hovered_windows = true;
 4830:     if (clear_hovered_windows)
 4831:         g.HoveredWindow = g.HoveredWindowUnderMovingWindow = NULL;
 4832:     // Update io.WantCaptureMouse for the user application (true = dispatch mouse info to Dear ImGui only, false = dispatch mouse to Dear ImGui + underlying app)
 4833:     // Update io.WantCaptureMouseAllowPopupClose (experimental) to give a chance for app to react to popup closure with a drag
 4834:     if (g.WantCaptureMouseNextFrame != -1)
 4835:     {
 4836:         io.WantCaptureMouse = io.WantCaptureMouseUnlessPopupClose = (g.WantCaptureMouseNextFrame != 0);
 4837:     }
 4838:     else
 4839:     {
 4840:         io.WantCaptureMouse = (mouse_avail && (g.HoveredWindow != NULL || mouse_any_down)) || has_open_popup;
 4841:         io.WantCaptureMouseUnlessPopupClose = (mouse_avail_unless_popup_close && (g.HoveredWindow != NULL || mouse_any_down)) || has_open_modal;
 4842:     }
 4843:     // Update io.WantCaptureKeyboard for the user application (true = dispatch keyboard info to Dear ImGui only, false = dispatch keyboard info to Dear ImGui + underlying app)
 4844:     io.WantCaptureKeyboard = false;
 4845:     if ((io.ConfigFlags & ImGuiConfigFlags_NoKeyboard) == 0)
 4846:     {
 4847:         if ((g.ActiveId != 0) || (modal_window != NULL))
 4848:             io.WantCaptureKeyboard = true;
 4849:         else if (io.NavActive && (io.ConfigFlags & ImGuiConfigFlags_NavEnableKeyboard) && io.ConfigNavCaptureKeyboard)
 4850:             io.WantCaptureKeyboard = true;
 4851:     }
 4852:     if (g.WantCaptureKeyboardNextFrame != -1) // Manual override
 4853:         io.WantCaptureKeyboard = (g.WantCaptureKeyboardNextFrame != 0);
 4854:     // Update io.WantTextInput flag, this is to allow systems without a keyboard (e.g. mobile, hand-held) to show a software keyboard if possible
 4855:     io.WantTextInput = (g.WantTextInputNextFrame != -1) ? (g.WantTextInputNextFrame != 0) : false;
 4856: }
