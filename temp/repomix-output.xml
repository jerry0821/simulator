11431:         return;
11432:     for (int i = 0; i < g.Windows.Size; i++)
11433:         if (g.Windows[i] == window)
11434:         {
11435:             memmove(&g.Windows[1], &g.Windows[0], (size_t)i * sizeof(ImGuiWindow*));
11436:             g.Windows[0] = window;
11437:             break;
11438:         }
