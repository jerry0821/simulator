 459: void ImDrawList::AddDrawCmd()
 460: {
 461:     ImDrawCmd draw_cmd;
 462:     draw_cmd.ClipRect = _CmdHeader.ClipRect;    // Same as calling ImDrawCmd_HeaderCopy()
 463:     draw_cmd.TexRef = _CmdHeader.TexRef;
 464:     draw_cmd.VtxOffset = _CmdHeader.VtxOffset;
 465:     draw_cmd.IdxOffset = IdxBuffer.Size;
 466:     IM_ASSERT(draw_cmd.ClipRect.x <= draw_cmd.ClipRect.z && draw_cmd.ClipRect.y <= draw_cmd.ClipRect.w);
 467:     CmdBuffer.push_back(draw_cmd);
 468: }
 469: // Pop trailing draw command (used before merging or presenting to user)
 470: // Note that this leaves the ImDrawList in a state unfit for further commands, as most code assume that CmdBuffer.Size > 0 && CmdBuffer.back().UserCallback == NULL
 471: void ImDrawList::_PopUnusedDrawCmd()
 472: {
 473:     while (CmdBuffer.Size > 0)
 474:     {
 475:         ImDrawCmd* curr_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];
 476:         if (curr_cmd->ElemCount != 0 || curr_cmd->UserCallback != NULL)
 477:             return;// break;
 478:         CmdBuffer.pop_back();
 479:     }
 480: }
 481: void ImDrawList::AddCallback(ImDrawCallback callback, void* userdata, size_t userdata_size)
 482: {
 483:     IM_ASSERT_PARANOID(CmdBuffer.Size > 0);
 484:     ImDrawCmd* curr_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];
 485:     IM_ASSERT(callback != NULL);
 486:     IM_ASSERT(curr_cmd->UserCallback == NULL);
 487:     if (curr_cmd->ElemCount != 0)
 488:     {
 489:         AddDrawCmd();
 490:         curr_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];
 491:     }
 492:     curr_cmd->UserCallback = callback;
 493:     if (userdata_size == 0)
 494:     {
 495:         // Store user data directly in command (no indirection)
 496:         curr_cmd->UserCallbackData = userdata;
 497:         curr_cmd->UserCallbackDataSize = 0;
 498:         curr_cmd->UserCallbackDataOffset = -1;
 499:     }
 500:     else
 501:     {
 502:         // Copy and store user data in a buffer
 503:         IM_ASSERT(userdata != NULL);
 504:         IM_ASSERT(userdata_size < (1u << 31));
 505:         curr_cmd->UserCallbackData = NULL; // Will be resolved during Render()
 506:         curr_cmd->UserCallbackDataSize = (int)userdata_size;
 507:         curr_cmd->UserCallbackDataOffset = _CallbacksDataBuf.Size;
 508:         _CallbacksDataBuf.resize(_CallbacksDataBuf.Size + (int)userdata_size);
 509:         memcpy(_CallbacksDataBuf.Data + (size_t)curr_cmd->UserCallbackDataOffset, userdata, userdata_size);
 510:     }
 511:     AddDrawCmd(); // Force a new command after us (see comment below)
 512: }
 513: // Compare ClipRect, TexRef and VtxOffset with a single memcmp()
 514: #define ImDrawCmd_HeaderSize                            (offsetof(ImDrawCmd, VtxOffset) + sizeof(unsigned int))
 515: #define ImDrawCmd_HeaderCompare(CMD_LHS, CMD_RHS)       (memcmp(CMD_LHS, CMD_RHS, ImDrawCmd_HeaderSize))    // Compare ClipRect, TexRef, VtxOffset
 516: #define ImDrawCmd_HeaderCopy(CMD_DST, CMD_SRC)          (memcpy(CMD_DST, CMD_SRC, ImDrawCmd_HeaderSize))    // Copy ClipRect, TexRef, VtxOffset
 517: #define ImDrawCmd_AreSequentialIdxOffset(CMD_0, CMD_1)  (CMD_0->IdxOffset + CMD_0->ElemCount == CMD_1->IdxOffset)
 518: // Try to merge two last draw commands
 519: void ImDrawList::_TryMergeDrawCmds()
 520: {
 521:     IM_ASSERT_PARANOID(CmdBuffer.Size > 0);
 522:     ImDrawCmd* curr_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];
 523:     ImDrawCmd* prev_cmd = curr_cmd - 1;
 524:     if (ImDrawCmd_HeaderCompare(curr_cmd, prev_cmd) == 0 && ImDrawCmd_AreSequentialIdxOffset(prev_cmd, curr_cmd) && curr_cmd->UserCallback == NULL && prev_cmd->UserCallback == NULL)
 525:     {
 526:         prev_cmd->ElemCount += curr_cmd->ElemCount;
 527:         CmdBuffer.pop_back();
 528:     }
 529: }
 530: // Our scheme may appears a bit unusual, basically we want the most-common calls AddLine AddRect etc. to not have to perform any check so we always have a command ready in the stack.
 531: // The cost of figuring out if a new command has to be added or if we can merge is paid in those Update** functions only.
 532: void ImDrawList::_OnChangedClipRect()
 533: {
 534:     // If current command is used with different settings we need to add a new command
 535:     IM_ASSERT_PARANOID(CmdBuffer.Size > 0);
 536:     ImDrawCmd* curr_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];
 537:     if (curr_cmd->ElemCount != 0 && memcmp(&curr_cmd->ClipRect, &_CmdHeader.ClipRect, sizeof(ImVec4)) != 0)
 538:     {
 539:         AddDrawCmd();
 540:         return;
 541:     }
 542:     IM_ASSERT(curr_cmd->UserCallback == NULL);
 543:     // Try to merge with previous command if it matches, else use current command
 544:     ImDrawCmd* prev_cmd = curr_cmd - 1;
 545:     if (curr_cmd->ElemCount == 0 && CmdBuffer.Size > 1 && ImDrawCmd_HeaderCompare(&_CmdHeader, prev_cmd) == 0 && ImDrawCmd_AreSequentialIdxOffset(prev_cmd, curr_cmd) && prev_cmd->UserCallback == NULL)
 546:     {
 547:         CmdBuffer.pop_back();
 548:         return;
 549:     }
 550:     curr_cmd->ClipRect = _CmdHeader.ClipRect;
 551: }
 552: void ImDrawList::_OnChangedTexture()
 553: {
 554:     // If current command is used with different settings we need to add a new command
 555:     IM_ASSERT_PARANOID(CmdBuffer.Size > 0);
 556:     ImDrawCmd* curr_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];
 557:     if (curr_cmd->ElemCount != 0 && curr_cmd->TexRef != _CmdHeader.TexRef)
 558:     {
 559:         AddDrawCmd();
 560:         return;
 561:     }
 562:     // Unlike other _OnChangedXXX functions this may be called by ImFontAtlasUpdateDrawListsTextures() in more locations so we need to handle this case.
 563:     if (curr_cmd->UserCallback != NULL)
 564:         return;
 565:     // Try to merge with previous command if it matches, else use current command
 566:     ImDrawCmd* prev_cmd = curr_cmd - 1;
 567:     if (curr_cmd->ElemCount == 0 && CmdBuffer.Size > 1 && ImDrawCmd_HeaderCompare(&_CmdHeader, prev_cmd) == 0 && ImDrawCmd_AreSequentialIdxOffset(prev_cmd, curr_cmd) && prev_cmd->UserCallback == NULL)
 568:     {
 569:         CmdBuffer.pop_back();
 570:         return;
 571:     }
 572:     curr_cmd->TexRef = _CmdHeader.TexRef;
 573: }
 574: void ImDrawList::_OnChangedVtxOffset()
 575: {
 576:     // We don't need to compare curr_cmd->VtxOffset != _CmdHeader.VtxOffset because we know it'll be different at the time we call this.
 577:     _VtxCurrentIdx = 0;
 578:     IM_ASSERT_PARANOID(CmdBuffer.Size > 0);
 579:     ImDrawCmd* curr_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];
 580:     //IM_ASSERT(curr_cmd->VtxOffset != _CmdHeader.VtxOffset); // See #3349
 581:     if (curr_cmd->ElemCount != 0)
 582:     {
 583:         AddDrawCmd();
 584:         return;
 585:     }
 586:     IM_ASSERT(curr_cmd->UserCallback == NULL);
 587:     curr_cmd->VtxOffset = _CmdHeader.VtxOffset;
 588: }
 589: int ImDrawList::_CalcCircleAutoSegmentCount(float radius) const
