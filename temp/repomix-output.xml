 15: #include "keyboard.h"
 16: #include <assert.h>
 17: static_assert(sizeof(Keyboard_State) == 256 / 8, "キーボード状態構造体のサイズ不一致");
 18: static Keyboard_State gState = {};
 19: static void keyDown(int key)
 20: {
 21:     if (key < 0 || key > 0xfe) { return;  }
 22:     unsigned int* p = (unsigned int*)&gState;
 23:     unsigned int bf = 1u << (key & 0x1f);
 24:     p[(key >> 5)] |= bf;
 25: }
 26: static void keyUp(int key)
 27: {
 28:     if (key < 0 || key > 0xfe) { return; }
 29:     unsigned int* p = (unsigned int*)&gState;
 30:     unsigned int bf = 1u << (key & 0x1f);
 31:     p[(key >> 5)] &= ~bf;
 32: }
 33: void Keyboard_Initialize(void)
 34: {
 35:     Keyboard_Reset();
 36: }
 37: bool Keyboard_IsKeyDown(Keyboard_Keys key, const Keyboard_State* pState)
 38: {
 39:     if (key <= 0xfe)
 40:     {
 41:         unsigned int* p = (unsigned int*)pState;
 42:         unsigned int bf = 1u << (key & 0x1f);
 43:         return (p[(key >> 5)] & bf) != 0;
 44:     }
 45:     return false;
 46: }
 47: bool Keyboard_IsKeyUp(Keyboard_Keys key, const Keyboard_State* pState)
 48: {
 49:     if (key <= 0xfe)
 50:     {
 51:         unsigned int* p = (unsigned int*)pState;
 52:         unsigned int bf = 1u << (key & 0x1f);
 53:         return (p[(key >> 5)] & bf) == 0;
 54:     }
 55:     return false;
 56: }
 57: bool Keyboard_IsKeyDown(Keyboard_Keys key)
 58: {
 59:     return Keyboard_IsKeyDown(key, &gState);
 60: }
 61: bool Keyboard_IsKeyUp(Keyboard_Keys key)
 62: {
 63:     return Keyboard_IsKeyUp(key, &gState);
 64: }
 65: // キーボードの現在の状態を取得する
 66: const Keyboard_State* Keyboard_GetState(void)
 67: {
 68:     return &gState;
 69: }
 70: void Keyboard_Reset(void)
 71: {
 72:     ZeroMemory(&gState, sizeof(Keyboard_State));
 73: }
 74: // キーボード制御のためのウォンどうメッセージプロシージャフック関数
 75: void Keyboard_ProcessMessage(UINT message, WPARAM wParam, LPARAM lParam)
 76: {
 77:     bool down = false;
 78:     switch (message)
 79:     {
 80:     case WM_ACTIVATEAPP:
 81:         Keyboard_Reset();
 82:         return;
 83:     case WM_KEYDOWN:
 84:     case WM_SYSKEYDOWN:
 85:         down = true;
 86:         break;
 87:     case WM_KEYUP:
 88:     case WM_SYSKEYUP:
 89:         break;
 90:     default:
 91:         return;
 92:     }
 93:     int vk = (int)wParam;
 94:     switch (vk)
 95:     {
 96:     case VK_SHIFT:
 97:         vk = (int)MapVirtualKey(((unsigned int)lParam & 0x00ff0000) >> 16u, MAPVK_VSC_TO_VK_EX);
 98:         if (!down)
 99:         {
100:             // 左シフトと右シフトの両方が同時に押された場合にクリアされるようにするための回避策
101:             keyUp(VK_LSHIFT);
102:             keyUp(VK_RSHIFT);
103:         }
104:         break;
105:     case VK_CONTROL:
106:         vk = ((UINT)lParam & 0x01000000) ? VK_RCONTROL : VK_LCONTROL;
107:         break;
108:     case VK_MENU:
109:         vk = ((UINT)lParam & 0x01000000) ? VK_RMENU : VK_LMENU;
110:         break;
111:     }
112:     if (down)
113:     {
114:         keyDown(vk);
115:     }
116:     else
117:     {
118:         keyUp(vk);
119:     }
120: }
</file>

