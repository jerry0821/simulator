 8018: void ImGui::UpdateCurrentFontSize(float restore_font_size_after_scaling)
 8019: {
 8020:     ImGuiContext& g = *GImGui;
 8021:     ImGuiWindow* window = g.CurrentWindow;
 8022:     g.Style.FontSizeBase = g.FontSizeBase;
 8023:     // Early out to avoid hidden window keeping bakes referenced and out of GC reach.
 8024:     // However this would leave a pretty subtle and damning error surface area if g.FontBaked was mismatching.
 8025:     // FIXME: perhaps g.FontSize should be updated?
 8026:     if (window != NULL && window->SkipItems)
 8027:     {
 8028:         ImGuiTable* table = g.CurrentTable;
 8029:         if (table == NULL || (table->CurrentColumn != -1 && table->Columns[table->CurrentColumn].IsSkipItems == false)) // See 8465#issuecomment-2951509561 and #8865. Ideally the SkipItems=true in tables would be amended with extra data.
 8030:             return;
 8031:     }
 8032:     // Restoring is pretty much only used by PopFont()
 8033:     float final_size = (restore_font_size_after_scaling > 0.0f) ? restore_font_size_after_scaling : 0.0f;
 8034:     if (final_size == 0.0f)
 8035:     {
 8036:         final_size = g.FontSizeBase;
 8037:         // Global scale factors
 8038:         final_size *= g.Style.FontScaleMain;    // Main global scale factor
 8039:         final_size *= g.Style.FontScaleDpi;     // Per-monitor/viewport DPI scale factor, automatically updated when io.ConfigDpiScaleFonts is enabled.
 8040:         // Window scale (mostly obsolete now)
 8041:         if (window != NULL)
 8042:             final_size *= window->FontWindowScale;
 8043:         // Legacy scale factors
 8044: #ifndef IMGUI_DISABLE_OBSOLETE_FUNCTIONS
 8045:         final_size *= g.IO.FontGlobalScale; // Use style.FontScaleMain instead!
 8046:         if (g.Font != NULL)
 8047:             final_size *= g.Font->Scale;    // Was never really useful.
 8048: #endif
 8049:     }
 8050:     // Round font size
 8051:     // - We started rounding in 1.90 WIP (18991) as our layout system currently doesn't support non-rounded font size well yet.
 8052:     // - We may support it better later and remove this rounding.
 8053:     final_size = GetRoundedFontSize(final_size);
 8054:     final_size = ImClamp(final_size, 1.0f, IMGUI_FONT_SIZE_MAX);
 8055:     if (g.Font != NULL && (g.IO.BackendFlags & ImGuiBackendFlags_RendererHasTextures))
 8056:         g.Font->CurrentRasterizerDensity = g.FontRasterizerDensity;
 8057:     g.FontSize = final_size;
 8058:     g.FontBaked = (g.Font != NULL && window != NULL) ? g.Font->GetFontBaked(final_size) : NULL;
 8059:     g.FontBakedScale = (g.Font != NULL && window != NULL) ? (g.FontSize / g.FontBaked->Size) : 0.0f;
 8060:     g.DrawListSharedData.FontSize = g.FontSize;
 8061:     g.DrawListSharedData.FontScale = g.FontBakedScale;
 8062: }
