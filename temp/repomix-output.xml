2569: // Helper: Manually clip large list of items.
2570: // If you have lots evenly spaced items and you have random access to the list, you can perform coarse
2571: // clipping based on visibility to only submit items that are in view.
2572: // The clipper calculates the range of visible items and advance the cursor to compensate for the non-visible items we have skipped.
2573: // (Dear ImGui already clip items based on their bounds but: it needs to first layout the item to do so, and generally
2574: //  fetching/submitting your own data incurs additional cost. Coarse clipping using ImGuiListClipper allows you to easily
2575: //  scale using lists with tens of thousands of items without a problem)
2576: // Usage:
2577: //   ImGuiListClipper clipper;
2578: //   clipper.Begin(1000);         // We have 1000 elements, evenly spaced.
2579: //   while (clipper.Step())
2580: //       for (int i = clipper.DisplayStart; i < clipper.DisplayEnd; i++)
2581: //           ImGui::Text("line number %d", i);
2582: // Generally what happens is:
2583: // - Clipper lets you process the first element (DisplayStart = 0, DisplayEnd = 1) regardless of it being visible or not.
2584: // - User code submit that one element.
2585: // - Clipper can measure the height of the first element
2586: // - Clipper calculate the actual range of elements to display based on the current clipping rectangle, position the cursor before the first visible element.
2587: // - User code submit visible elements.
2588: // - The clipper also handles various subtleties related to keyboard/gamepad navigation, wrapping etc.
2589: struct ImGuiListClipper
2590: {
2591:     ImGuiContext*   Ctx;                // Parent UI context
2592:     int             DisplayStart;       // First item to display, updated by each call to Step()
2593:     int             DisplayEnd;         // End of items to display (exclusive)
2594:     int             ItemsCount;         // [Internal] Number of items
2595:     float           ItemsHeight;        // [Internal] Height of item after a first step and item submission can calculate it
2596:     double          StartPosY;          // [Internal] Cursor position at the time of Begin() or after table frozen rows are all processed
2597:     double          StartSeekOffsetY;   // [Internal] Account for frozen rows in a table and initial loss of precision in very large windows.
2598:     void*           TempData;           // [Internal] Internal data
2599:     ImGuiListClipperFlags Flags;        // [Internal] Flags, currently not yet well exposed.
2600:     // items_count: Use INT_MAX if you don't know how many items you have (in which case the cursor won't be advanced in the final step, and you can call SeekCursorForItem() manually if you need)
2601:     // items_height: Use -1.0f to be calculated automatically on first step. Otherwise pass in the distance between your items, typically GetTextLineHeightWithSpacing() or GetFrameHeightWithSpacing().
2602:     IMGUI_API ImGuiListClipper();
2603:     IMGUI_API ~ImGuiListClipper();
2604:     IMGUI_API void  Begin(int items_count, float items_height = -1.0f);
2605:     IMGUI_API void  End();             // Automatically called on the last call of Step() that returns false.
2606:     IMGUI_API bool  Step();            // Call until it returns false. The DisplayStart/DisplayEnd fields will be set and you can process/draw those items.
2607:     // Call IncludeItemByIndex() or IncludeItemsByIndex() *BEFORE* first call to Step() if you need a range of items to not be clipped, regardless of their visibility.
2608:     // (Due to alignment / padding of certain items it is possible that an extra item may be included on either end of the display range).
2609:     inline void     IncludeItemByIndex(int item_index)                  { IncludeItemsByIndex(item_index, item_index + 1); }
2610:     IMGUI_API void  IncludeItemsByIndex(int item_begin, int item_end);  // item_end is exclusive e.g. use (42, 42+1) to make item 42 never clipped.
2611:     // Seek cursor toward given item. This is automatically called while stepping.
2612:     // - The only reason to call this is: you can use ImGuiListClipper::Begin(INT_MAX) if you don't know item count ahead of time.
2613:     // - In this case, after all steps are done, you'll want to call SeekCursorForItem(item_count).
2614:     IMGUI_API void  SeekCursorForItem(int item_index);
2615: #ifndef IMGUI_DISABLE_OBSOLETE_FUNCTIONS
2616:     //inline void IncludeRangeByIndices(int item_begin, int item_end)      { IncludeItemsByIndex(item_begin, item_end); } // [renamed in 1.89.9]
2617:     //inline void ForceDisplayRangeByIndices(int item_begin, int item_end) { IncludeItemsByIndex(item_begin, item_end); } // [renamed in 1.89.6]
2618:     //inline ImGuiListClipper(int items_count, float items_height = -1.0f) { memset(this, 0, sizeof(*this)); ItemsCount = -1; Begin(items_count, items_height); } // [removed in 1.79]
2619: #endif
2620: };
2621: // Helpers: ImVec2/ImVec4 operators
2622: // - It is important that we are keeping those disabled by default so they don't leak in user space.
2623: // - This is in order to allow user enabling implicit cast operators between ImVec2/ImVec4 and their own types (using IM_VEC2_CLASS_EXTRA in imconfig.h)
2624: // - Add '#define IMGUI_DEFINE_MATH_OPERATORS' before including this file (or in imconfig.h) to access courtesy maths operators for ImVec2 and ImVec4.
2625: // - We intentionally provide ImVec2*float but not float*ImVec2: this is rare enough and we want to reduce the surface for possible user mistake.
2626: #ifdef IMGUI_DEFINE_MATH_OPERATORS
2627: #define IMGUI_DEFINE_MATH_OPERATORS_IMPLEMENTED
2628: IM_MSVC_RUNTIME_CHECKS_OFF
2629: // ImVec2 operators
2630: inline ImVec2  operator*(const ImVec2& lhs, const float rhs)    { return ImVec2(lhs.x * rhs, lhs.y * rhs); }
2631: inline ImVec2  operator/(const ImVec2& lhs, const float rhs)    { return ImVec2(lhs.x / rhs, lhs.y / rhs); }
2632: inline ImVec2  operator+(const ImVec2& lhs, const ImVec2& rhs)  { return ImVec2(lhs.x + rhs.x, lhs.y + rhs.y); }
2633: inline ImVec2  operator-(const ImVec2& lhs, const ImVec2& rhs)  { return ImVec2(lhs.x - rhs.x, lhs.y - rhs.y); }
2634: inline ImVec2  operator*(const ImVec2& lhs, const ImVec2& rhs)  { return ImVec2(lhs.x * rhs.x, lhs.y * rhs.y); }
2635: inline ImVec2  operator/(const ImVec2& lhs, const ImVec2& rhs)  { return ImVec2(lhs.x / rhs.x, lhs.y / rhs.y); }
2636: inline ImVec2  operator-(const ImVec2& lhs)                     { return ImVec2(-lhs.x, -lhs.y); }
2637: inline ImVec2& operator*=(ImVec2& lhs, const float rhs)         { lhs.x *= rhs; lhs.y *= rhs; return lhs; }
2638: inline ImVec2& operator/=(ImVec2& lhs, const float rhs)         { lhs.x /= rhs; lhs.y /= rhs; return lhs; }
