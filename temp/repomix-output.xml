3825: void ImGui::SetColumnOffset(int column_index, float offset)
3826: {
3827:     ImGuiContext& g = *GImGui;
3828:     ImGuiWindow* window = g.CurrentWindow;
3829:     ImGuiOldColumns* columns = window->DC.CurrentColumns;
3830:     IM_ASSERT(columns != NULL);
3831:     if (column_index < 0)
3832:         column_index = columns->Current;
3833:     IM_ASSERT(column_index < columns->Columns.Size);
3834:     const bool preserve_width = !(columns->Flags & ImGuiOldColumnFlags_NoPreserveWidths) && (column_index < columns->Count - 1);
3835:     const float width = preserve_width ? GetColumnWidthEx(columns, column_index, columns->IsBeingResized) : 0.0f;
3836:     if (!(columns->Flags & ImGuiOldColumnFlags_NoForceWithinWindow))
3837:         offset = ImMin(offset, columns->OffMaxX - g.Style.ColumnsMinSpacing * (columns->Count - column_index));
3838:     columns->Columns[column_index].OffsetNorm = GetColumnNormFromOffset(columns, offset - columns->OffMinX);
3839:     if (preserve_width)
3840:         SetColumnOffset(column_index + 1, offset + ImMax(g.Style.ColumnsMinSpacing, width));
