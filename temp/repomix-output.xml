8531: static int IMGUI_CDECL TabItemComparerBySection(const void* lhs, const void* rhs)
8532: {
8533:     const ImGuiTabItem* a = (const ImGuiTabItem*)lhs;
8534:     const ImGuiTabItem* b = (const ImGuiTabItem*)rhs;
8535:     const int a_section = TabItemGetSectionIdx(a);
8536:     const int b_section = TabItemGetSectionIdx(b);
8537:     if (a_section != b_section)
8538:         return a_section - b_section;
8539:     return (int)(a->IndexDuringLayout - b->IndexDuringLayout);
8540: }
8541: static int IMGUI_CDECL TabItemComparerByBeginOrder(const void* lhs, const void* rhs)
8542: {
8543:     const ImGuiTabItem* a = (const ImGuiTabItem*)lhs;
8544:     const ImGuiTabItem* b = (const ImGuiTabItem*)rhs;
8545:     return (int)(a->BeginOrder - b->BeginOrder);
