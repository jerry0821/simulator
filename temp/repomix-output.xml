16056: void ImGui::DebugHookIdInfo(ImGuiID id, ImGuiDataType data_type, const void* data_id, const void* data_id_end)
16057: {
16058:     ImGuiContext& g = *GImGui;
16059:     ImGuiDebugItemPathQuery* query = &g.DebugItemPathQuery;
16060:     if (query->Active == false)
16061:     {
16062:         IM_ASSERT(id == 0);
16063:         return;
16064:     }
16065:     ImGuiWindow* window = g.CurrentWindow;
16066:     // Step -1: stack query
16067:     // This assumes that the ID was computed with the current ID stack, which tends to be the case for our widget.
16068:     if (query->Step == -1)
16069:     {
16070:         IM_ASSERT(query->Results.Size == 0);
16071:         query->Step++;
16072:         query->Results.resize(window->IDStack.Size + 1, ImGuiStackLevelInfo());
16073:         for (int n = 0; n < window->IDStack.Size + 1; n++)
16074:             query->Results[n].ID = (n < window->IDStack.Size) ? window->IDStack[n] : id;
16075:         return;
16076:     }
16077:     // Step 0+: query for individual level
16078:     IM_ASSERT(query->Step >= 0);
16079:     if (query->Step != window->IDStack.Size)
16080:         return;
16081:     ImGuiStackLevelInfo* info = &query->Results[query->Step];
16082:     IM_ASSERT(info->ID == id && info->QueryFrameCount > 0);
16083:     if (info->DescOffset == -1)
16084:     {
16085:         const char* result = NULL;
16086:         const char* result_end = NULL;
16087:         switch (data_type)
16088:         {
16089:         case ImGuiDataType_S32:
16090:             ImFormatStringToTempBuffer(&result, &result_end, "%d", (int)(intptr_t)data_id);
16091:             break;
16092:         case ImGuiDataType_String:
16093:             ImFormatStringToTempBuffer(&result, &result_end, "%.*s", data_id_end ? (int)((const char*)data_id_end - (const char*)data_id) : (int)ImStrlen((const char*)data_id), (const char*)data_id);
16094:             break;
16095:         case ImGuiDataType_Pointer:
16096:             ImFormatStringToTempBuffer(&result, &result_end, "(void*)0x%p", data_id);
16097:             break;
16098:         case ImGuiDataType_ID:
16099:             // PushOverrideID() is often used to avoid hashing twice, which would lead to 2 calls to DebugHookIdInfo(). We prioritize the first one.
16100:             ImFormatStringToTempBuffer(&result, &result_end, "0x%08X [override]", id);
16101:             break;
16102:         default:
16103:             IM_ASSERT(0);
16104:         }
16105:         info->DescOffset = query->ResultsDescBuf.size();
16106:         query->ResultsDescBuf.append(result, result_end + 1); // Include zero terminator
16107:     }
16108:     info->QuerySuccess = true;
16109:     if (info->DataType == -1)
16110:         info->DataType = (ImS8)data_type;
