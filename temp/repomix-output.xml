<file path="shader3d.cpp">
  1: /*==============================================================================
  2:    シェーダー [shader.cpp]
  3: 														 Author : Youhei Sato
  4: 														 Date   : 2025/05/15
  5: --------------------------------------------------------------------------------
  6: ==============================================================================*/
  7: #include <d3d11.h>
  8: #include <DirectXMath.h>
  9: using namespace DirectX;
 10: #include "direct3d.h"
 11: #include "debug_ostream.h"
 12: #include <fstream>
 13: #include "shader3d.h"
 14: #include "sampler.h"
 15: static ID3D11VertexShader* g_pVertexShader = nullptr;
 16: static ID3D11InputLayout* g_pInputLayout = nullptr;
 17: static ID3D11Buffer* g_pVSConstantBuffer0 = nullptr; // world
 18: static ID3D11Buffer* g_pVSConstantBuffer1 = nullptr; // view
 19: static ID3D11Buffer* g_pVSConstantBuffer2 = nullptr; // proj
 20: static ID3D11PixelShader* g_pPixelShader = nullptr;
 21: static ID3D11Buffer* g_pPSConstantBuffer0 = nullptr; // Material
 22: // 注意！初期化で外部から設定されるもの。Release不要。
 23: static ID3D11Device* g_pDevice = nullptr;
 24: static ID3D11DeviceContext* g_pContext = nullptr;
 25: bool Shader3D_Initialize()
 26: {
 27: 	HRESULT hr; // 戻り値格納用
 28: 	// 事前コンパイル済み頂点シェーダーの読み込み
 29: 	std::ifstream ifs_vs("resource/shader/shader_vertex_3d.cso", std::ios::binary);
 30: 	if (!ifs_vs) {
 31: 		MessageBox(nullptr, "頂点シェーダーの読み込みに失敗しました\n\nshader_vertex_3d.cso", "エラー", MB_OK);
 32: 		return false;
 33: 	}
 34: 	// ファイルサイズを取得
 35: 	ifs_vs.seekg(0, std::ios::end); // ファイルポインタを末尾に移動
 36: 	std::streamsize filesize = ifs_vs.tellg(); // ファイルポインタの位置を取得（つまりファイルサイズ）
 37: 	ifs_vs.seekg(0, std::ios::beg); // ファイルポインタを先頭に戻す
 38: 	// バイナリデータを格納するためのバッファを確保
 39: 	unsigned char* vsbinary_pointer = new unsigned char[filesize];
 40: 	ifs_vs.read((char*)vsbinary_pointer, filesize); // バイナリデータを読み込む
 41: 	ifs_vs.close(); // ファイルを閉じる
 42: 	// 頂点シェーダーの作成
 43: 	hr = Direct3D_GetDevice()->CreateVertexShader(vsbinary_pointer, filesize, nullptr, &g_pVertexShader);
 44: 	if (FAILED(hr)) {
 45: 		hal::dout << "Shader_Initialize() : 頂点シェーダーの作成に失敗しました" << std::endl;
 46: 		delete[] vsbinary_pointer; // メモリリークしないようにバイナリデータのバッファを解放
 47: 		return false;
 48: 	}
 49: 	// 頂点レイアウトの定義
 50: 	D3D11_INPUT_ELEMENT_DESC layout[] = {
 51: 		{ "POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT,		0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 },
 52: 		{ "NORMAL",	  0, DXGI_FORMAT_R32G32B32_FLOAT,		0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 },
 53: 		{ "COLOR",	  0, DXGI_FORMAT_R32G32B32A32_FLOAT,    0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 },	
 54: 		{ "TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT,			0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 }
 55: 	};
 56: 	UINT num_elements = ARRAYSIZE(layout); // 配列の要素数を取得
 57: 	// 頂点レイアウトの作成
 58: 	hr = Direct3D_GetDevice()->CreateInputLayout(layout, num_elements, vsbinary_pointer, filesize, &g_pInputLayout);
 59: 	delete[] vsbinary_pointer; // バイナリデータのバッファを解放
 60: 	if (FAILED(hr)) {
 61: 		hal::dout << "Shader_Initialize() : 頂点レイアウトの作成に失敗しました" << std::endl;
 62: 		return false;
 63: 	}
 64: 	D3D11_BUFFER_DESC buffer_desc{};
 65: 	buffer_desc.ByteWidth = sizeof(XMFLOAT4X4); 
 66: 	buffer_desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
 67: 	Direct3D_GetDevice()->CreateBuffer(&buffer_desc, nullptr, &g_pVSConstantBuffer0);
 68: 	Direct3D_GetDevice()->CreateBuffer(&buffer_desc, nullptr, &g_pVSConstantBuffer1);
 69: 	Direct3D_GetDevice()->CreateBuffer(&buffer_desc, nullptr, &g_pVSConstantBuffer2);
 70: 	// 事前コンパイル済みピクセルシェーダーの読み込み
 71: 	std::ifstream ifs_ps("resource/shader/shader_pixel_3d.cso", std::ios::binary);
 72: 	if (!ifs_ps) {
 73: 		MessageBox(nullptr, "ピクセルシェーダーの読み込みに失敗しました\n\nshader_pixel_3d.cso", "エラー", MB_OK);
 74: 		return false;
 75: 	}
 76: 	ifs_ps.seekg(0, std::ios::end);
 77: 	filesize = ifs_ps.tellg();
 78: 	ifs_ps.seekg(0, std::ios::beg);
 79: 	unsigned char* psbinary_pointer = new unsigned char[filesize];
 80: 	ifs_ps.read((char*)psbinary_pointer, filesize);
 81: 	ifs_ps.close();
 82: 	// ピクセルシェーダーの作成
 83: 	hr = Direct3D_GetDevice()->CreatePixelShader(psbinary_pointer, filesize, nullptr, &g_pPixelShader);
 84: 	delete[] psbinary_pointer; // バイナリデータのバッファを解放
 85: 	if (FAILED(hr)) {
 86: 		hal::dout << "Shader_Initialize() : ピクセルシェーダーの作成に失敗しました" << std::endl;
 87: 		return false;
 88: 	}
 89: 	// ピクセルシェーダー用定数バッファの作成
 90: 	buffer_desc.ByteWidth = sizeof(XMFLOAT4); // バッファのサイズ
 91: 	Direct3D_GetDevice()->CreateBuffer(&buffer_desc, nullptr, &g_pPSConstantBuffer0);
 92: 	return true;
 93: }
 94: void Shader3D_Finalize()
 95: {
 96: 	SAFE_RELEASE(g_pPixelShader);
 97: 	SAFE_RELEASE(g_pPSConstantBuffer0);
 98: 	SAFE_RELEASE(g_pVSConstantBuffer2);
 99: 	SAFE_RELEASE(g_pVSConstantBuffer1);
100: 	SAFE_RELEASE(g_pVSConstantBuffer0);
101: 	SAFE_RELEASE(g_pInputLayout);
102: 	SAFE_RELEASE(g_pVertexShader);
103: }
104: void Shader3D_SetWorldMatrix(const DirectX::XMMATRIX& matrix)
105: {
106: 	// 定数バッファ格納用行列の構造体を定義
107: 	XMFLOAT4X4 transpose;
108: 	// 行列を転置して定数バッファ格納用行列に変換
109: 	XMStoreFloat4x4(&transpose, XMMatrixTranspose(matrix));
110: 	// 定数バッファに行列をセット
111: 	Direct3D_GetContext()->UpdateSubresource(g_pVSConstantBuffer0, 0, nullptr, &transpose, 0, 0);
112: }
113: void Shader3D_SetViewMatrix(const DirectX::XMMATRIX& matrix)
114: {
115: 	XMFLOAT4X4 transpose;
116: 	XMStoreFloat4x4(&transpose, XMMatrixTranspose(matrix));
117: 	Direct3D_GetContext()->UpdateSubresource(g_pVSConstantBuffer1, 0, nullptr, &transpose, 0, 0);
118: }
119: void Shader3D_SetProjMatrix(const DirectX::XMMATRIX& matrix)
120: {
121: 	XMFLOAT4X4 transpose;
122: 	XMStoreFloat4x4(&transpose, XMMatrixTranspose(matrix));
123: 	Direct3D_GetContext()->UpdateSubresource(g_pVSConstantBuffer2, 0, nullptr, &transpose, 0, 0);
124: }
125: void Shader3D_SetMaterialColor(const XMFLOAT4& color)
126: {
127: 	//定数バッファに行列をセット
128: 	Direct3D_GetContext()->UpdateSubresource(g_pPSConstantBuffer0, 0, nullptr, &color, 0, 0);
129: }
130: void Shader3D_Begin()
131: {
132: 	// 頂点シェーダーとピクセルシェーダーを描画パイプラインに設定
133: 	Direct3D_GetContext()->VSSetShader(g_pVertexShader, nullptr, 0);
134: 	Direct3D_GetContext()->PSSetShader(g_pPixelShader, nullptr, 0);
135: 	// 頂点レイアウトを描画パイプラインに設定
136: 	Direct3D_GetContext()->IASetInputLayout(g_pInputLayout);
137: 	// 定数バッファを描画パイプラインに設定
138: 	ID3D11Buffer* pBuffers[3] = {
139: 		g_pVSConstantBuffer0, // b0: World
140: 		g_pVSConstantBuffer1, // b1: View (之前缺這個)
141: 		g_pVSConstantBuffer2  // b2: Proj (之前缺這個)
142: 	};
143: 	// 從 Slot 0 開始，設定 3 個緩衝區
144: 	Direct3D_GetContext()->VSSetConstantBuffers(0, 3, pBuffers);
145: 	Direct3D_GetContext()->PSSetConstantBuffers(0, 1, &g_pPSConstantBuffer0);
146: 	// サンプラーステートを描画パイプラインに設定
147: 	//g_pContext->PSSetSamplers(0, 1, &g_pSamplerState);
148: 	//Sampler_SetFilterAnisotropic();
149: }
</file>

