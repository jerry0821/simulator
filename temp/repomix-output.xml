 34: /** @file vector3.h
 35:  *  @brief 3D vector structure, including operators when compiling in C++
 36:  */
 37: #pragma once
 38: #ifndef AI_VECTOR3D_H_INC
 39: #define AI_VECTOR3D_H_INC
 40: #ifdef __GNUC__
 41: #   pragma GCC system_header
 42: #endif
 43: #ifdef __cplusplus
 44: #   include <cmath>
 45: #else
 46: #   include <math.h"
 47: #endif
 48: #include "defs.h"
 49: #ifdef __cplusplus
 50: template<typename TReal> class aiMatrix3x3t;
 51: template<typename TReal> class aiMatrix4x4t;
 52: // ---------------------------------------------------------------------------
 53: /// @brief  Represents a three-dimensional vector.
 54: // ---------------------------------------------------------------------------
 55: template <typename TReal>
 56: class aiVector3t {
 57: public:
 58:     /// @brief  The default class constructor.
 59:     aiVector3t() AI_NO_EXCEPT : x(), y(), z() {}
 60:     /// @brief  The class constructor with the components.
 61:     /// @param  _x  The x-component for the vector.
 62:     /// @param  _y  The y-component for the vector.
 63:     /// @param  _z  The z-component for the vector.
 64:     aiVector3t(TReal _x, TReal _y, TReal _z) : x(_x), y(_y), z(_z) {}
 65:     /// @brief  The class constructor with a default value.
 66:     /// @param  _xyz  The value for x, y and z.
 67:     explicit aiVector3t (TReal _xyz ) : x(_xyz), y(_xyz), z(_xyz) {}
 68:     /// @brief  The copy constructor.
 69:     /// @param  o The instance to copy from.
 70:     aiVector3t( const aiVector3t& o ) = default;
 71:     /// @brief  combined operators
 72:     /// @brief  The copy constructor.
 73:     const aiVector3t& operator += (const aiVector3t& o);
 74:     /// @brief  The copy constructor.
 75:     const aiVector3t& operator -= (const aiVector3t& o);
 76:     /// @brief  The copy constructor.
 77:     const aiVector3t& operator *= (TReal f);
 78:     /// @brief  The copy constructor.
 79:     const aiVector3t& operator /= (TReal f);
 80:     /// @brief  Transform vector by matrix
 81:     aiVector3t& operator *= (const aiMatrix3x3t<TReal>& mat);
 82:     aiVector3t& operator *= (const aiMatrix4x4t<TReal>& mat);
 83:     /// @brief  access a single element, const.
 84:     TReal operator[](unsigned int i) const;
 85:     /// @brief  access a single element, non-const.
 86:     TReal& operator[](unsigned int i);
 87:     // comparison
 88:     bool operator== (const aiVector3t& other) const;
 89:     bool operator!= (const aiVector3t& other) const;
 90:     bool operator < (const aiVector3t& other) const;
 91:     /// @brief  
 92:     bool Equal(const aiVector3t &other, TReal epsilon = ai_epsilon) const;
 93:     template <typename TOther>
 94:     operator aiVector3t<TOther> () const;
 95:     /** @brief Set the components of a vector
 96:      *  @param pX X component
 97:      *  @param pY Y component
 98:      *  @param pZ Z component  */
 99:     void Set( TReal pX, TReal pY, TReal pZ);
100:     /** @brief Get the squared length of the vector
101:      *  @return Square length */
102:     TReal SquareLength() const;
103:     /** @brief Get the length of the vector
104:      *  @return length */
105:     TReal Length() const;
106:     /** @brief Normalize the vector */
107:     aiVector3t& Normalize();
108:     /** @brief Normalize the vector with extra check for zero vectors */
109:     aiVector3t& NormalizeSafe();
110:     /** @brief Componentwise multiplication of two vectors
111:      *
112:      *  Note that vec*vec yields the dot product.
113:      *  @param o Second factor */
114:     const aiVector3t SymMul(const aiVector3t& o);
115:     TReal x, y, z;
116: };
117: typedef aiVector3t<ai_real> aiVector3D;
118: #else
119: struct aiVector3D {
120:     ai_real x, y, z;
121: };
122: #endif // __cplusplus
123: #ifdef __cplusplus
124: #endif // __cplusplus
125: #endif // AI_VECTOR3D_H_INC
</file>

