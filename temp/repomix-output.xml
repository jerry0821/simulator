267:   for(int i=0;i<=segments;i++){float a=i*as;v[vpr+i].position={sphere.center.x+cosf(a)*sphere.radius,sphere.center.y+sinf(a)*sphere.radius,sphere.center.z};v[vpr+i].normal={0,0,1};v[vpr+i].color=color;v[vpr+i].uv={0,0};}
