8157: static bool IsRootOfOpenMenuSet()
8158: {
8159:     ImGuiContext& g = *GImGui;
8160:     ImGuiWindow* window = g.CurrentWindow;
8161:     if ((g.OpenPopupStack.Size <= g.BeginPopupStack.Size) || (window->Flags & ImGuiWindowFlags_ChildMenu))
8162:         return false;
8163:     // Initially we used 'upper_popup->OpenParentId == window->IDStack.back()' to differentiate multiple menu sets from each others
8164:     // (e.g. inside menu bar vs loose menu items) based on parent ID.
8165:     // This would however prevent the use of e.g. PushID() user code submitting menus.
8166:     // Previously this worked between popup and a first child menu because the first child menu always had the _ChildWindow flag,
8167:     // making hovering on parent popup possible while first child menu was focused - but this was generally a bug with other side effects.
8168:     // Instead we don't treat Popup specifically (in order to consistently support menu features in them), maybe the first child menu of a Popup
8169:     // doesn't have the _ChildWindow flag, and we rely on this IsRootOfOpenMenuSet() check to allow hovering between root window/popup and first child menu.
8170:     // In the end, lack of ID check made it so we could no longer differentiate between separate menu sets. To compensate for that, we at least check parent window nav layer.
8171:     // This fixes the most common case of menu opening on hover when moving between window content and menu bar. Multiple different menu sets in same nav layer would still
8172:     // open on hover, but that should be a lesser problem, because if such menus are close in proximity in window content then it won't feel weird and if they are far apart
8173:     // it likely won't be a problem anyone runs into.
8174:     const ImGuiPopupData* upper_popup = &g.OpenPopupStack[g.BeginPopupStack.Size];
8175:     if (window->DC.NavLayerCurrent != upper_popup->ParentNavLayer)
8176:         return false;
8177:     return upper_popup->Window && (upper_popup->Window->Flags & ImGuiWindowFlags_ChildMenu) && ImGui::IsWindowChildOf(upper_popup->Window, window, true);
8178: }
8179: bool ImGui::BeginMenuEx(const char* label, const char* icon, bool enabled)
8180: {
8181:     ImGuiWindow* window = GetCurrentWindow();
8182:     if (window->SkipItems)
8183:         return false;
8184:     ImGuiContext& g = *GImGui;
8185:     const ImGuiStyle& style = g.Style;
8186:     const ImGuiID id = window->GetID(label);
8187:     bool menu_is_open = IsPopupOpen(id, ImGuiPopupFlags_None);
8188:     // Sub-menus are ChildWindow so that mouse can be hovering across them (otherwise top-most popup menu would steal focus and not allow hovering on parent menu)
8189:     // The first menu in a hierarchy isn't so hovering doesn't get across (otherwise e.g. resizing borders with ImGuiButtonFlags_FlattenChildren would react), but top-most BeginMenu() will bypass that limitation.
8190:     ImGuiWindowFlags window_flags = ImGuiWindowFlags_ChildMenu | ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoNavFocus;
8191:     if (window->Flags & ImGuiWindowFlags_ChildMenu)
8192:         window_flags |= ImGuiWindowFlags_ChildWindow;
8193:     // If a menu with same the ID was already submitted, we will append to it, matching the behavior of Begin().
8194:     // We are relying on a O(N) search - so O(N log N) over the frame - which seems like the most efficient for the expected small amount of BeginMenu() calls per frame.
8195:     // If somehow this is ever becoming a problem we can switch to use e.g. ImGuiStorage mapping key to last frame used.
8196:     if (g.MenusIdSubmittedThisFrame.contains(id))
8197:     {
8198:         if (menu_is_open)
8199:             menu_is_open = BeginPopupMenuEx(id, label, window_flags); // menu_is_open can be 'false' when the popup is completely clipped (e.g. zero size display)
8200:         else
8201:             g.NextWindowData.ClearFlags();          // we behave like Begin() and need to consume those values
8202:         return menu_is_open;
8203:     }
8204:     // Tag menu as used. Next time BeginMenu() with same ID is called it will append to existing menu
8205:     g.MenusIdSubmittedThisFrame.push_back(id);
8206:     ImVec2 label_size = CalcTextSize(label, NULL, true);
8207:     // Odd hack to allow hovering across menus of a same menu-set (otherwise we wouldn't be able to hover parent without always being a Child window)
8208:     // This is only done for items for the menu set and not the full parent window.
8209:     const bool menuset_is_open = IsRootOfOpenMenuSet();
8210:     if (menuset_is_open)
8211:         PushItemFlag(ImGuiItemFlags_NoWindowHoverableCheck, true);
8212:     // The reference position stored in popup_pos will be used by Begin() to find a suitable position for the child menu,
8213:     // However the final position is going to be different! It is chosen by FindBestWindowPosForPopup().
8214:     // e.g. Menus tend to overlap each other horizontally to amplify relative Z-ordering.
8215:     ImVec2 popup_pos;
8216:     ImVec2 pos = window->DC.CursorPos;
8217:     PushID(label);
8218:     if (!enabled)
8219:         BeginDisabled();
8220:     const ImGuiMenuColumns* offsets = &window->DC.MenuColumns;
8221:     bool pressed;
8222:     // We use ImGuiSelectableFlags_NoSetKeyOwner to allow down on one menu item, move, up on another.
8223:     const ImGuiSelectableFlags selectable_flags = ImGuiSelectableFlags_NoHoldingActiveID | ImGuiSelectableFlags_NoSetKeyOwner | ImGuiSelectableFlags_SelectOnClick | ImGuiSelectableFlags_NoAutoClosePopups;
8224:     if (window->DC.LayoutType == ImGuiLayoutType_Horizontal)
8225:     {
8226:         // Menu inside a horizontal menu bar
8227:         // Selectable extend their highlight by half ItemSpacing in each direction.
8228:         // For ChildMenu, the popup position will be overwritten by the call to FindBestWindowPosForPopup() in Begin()
8229:         window->DC.CursorPos.x += IM_TRUNC(style.ItemSpacing.x * 0.5f);
8230:         PushStyleVarX(ImGuiStyleVar_ItemSpacing, style.ItemSpacing.x * 2.0f);
8231:         float w = label_size.x;
8232:         ImVec2 text_pos(window->DC.CursorPos.x + offsets->OffsetLabel, pos.y + window->DC.CurrLineTextBaseOffset);
8233:         pressed = Selectable("", menu_is_open, selectable_flags, ImVec2(w, label_size.y));
8234:         LogSetNextTextDecoration("[", "]");
8235:         RenderText(text_pos, label);
8236:         PopStyleVar();
8237:         window->DC.CursorPos.x += IM_TRUNC(style.ItemSpacing.x * (-1.0f + 0.5f)); // -1 spacing to compensate the spacing added when Selectable() did a SameLine(). It would also work to call SameLine() ourselves after the PopStyleVar().
8238:         popup_pos = ImVec2(pos.x - 1.0f - IM_TRUNC(style.ItemSpacing.x * 0.5f), text_pos.y - style.FramePadding.y + window->MenuBarHeight);
8239:     }
8240:     else
8241:     {
8242:         // Menu inside a regular/vertical menu
8243:         // (In a typical menu window where all items are BeginMenu() or MenuItem() calls, extra_w will always be 0.0f.
8244:         //  Only when they are other items sticking out we're going to add spacing, yet only register minimum width into the layout system.)
8245:         float icon_w = (icon && icon[0]) ? CalcTextSize(icon, NULL).x : 0.0f;
8246:         float checkmark_w = IM_TRUNC(g.FontSize * 1.20f);
8247:         float min_w = window->DC.MenuColumns.DeclColumns(icon_w, label_size.x, 0.0f, checkmark_w); // Feedback to next frame
8248:         float extra_w = ImMax(0.0f, GetContentRegionAvail().x - min_w);
8249:         ImVec2 text_pos(window->DC.CursorPos.x, pos.y + window->DC.CurrLineTextBaseOffset);
8250:         pressed = Selectable("", menu_is_open, selectable_flags | ImGuiSelectableFlags_SpanAvailWidth, ImVec2(min_w, label_size.y));
8251:         LogSetNextTextDecoration("", ">");
8252:         RenderText(ImVec2(text_pos.x + offsets->OffsetLabel, text_pos.y), label);
8253:         if (icon_w > 0.0f)
8254:             RenderText(ImVec2(text_pos.x + offsets->OffsetIcon, text_pos.y), icon);
8255:         RenderArrow(window->DrawList, ImVec2(text_pos.x + offsets->OffsetMark + extra_w + g.FontSize * 0.30f, text_pos.y), GetColorU32(ImGuiCol_Text), ImGuiDir_Right);
8256:         popup_pos = ImVec2(pos.x, text_pos.y - style.WindowPadding.y);
8257:     }
8258:     if (!enabled)
8259:         EndDisabled();
8260:     const bool hovered = (g.HoveredId == id) && enabled && !g.NavHighlightItemUnderNav;
8261:     if (menuset_is_open)
8262:         PopItemFlag();
8263:     bool want_open = false;
8264:     bool want_open_nav_init = false;
8265:     bool want_close = false;
8266:     if (window->DC.LayoutType == ImGuiLayoutType_Vertical) // (window->Flags & (ImGuiWindowFlags_Popup|ImGuiWindowFlags_ChildMenu))
8267:     {
8268:         // Close menu when not hovering it anymore unless we are moving roughly in the direction of the menu
8269:         // Implement http://bjk5.com/post/44698559168/breaking-down-amazons-mega-dropdown to avoid using timers, so menus feels more reactive.
8270:         bool moving_toward_child_menu = false;
8271:         ImGuiPopupData* child_popup = (g.BeginPopupStack.Size < g.OpenPopupStack.Size) ? &g.OpenPopupStack[g.BeginPopupStack.Size] : NULL; // Popup candidate (testing below)
8272:         ImGuiWindow* child_menu_window = (child_popup && child_popup->Window && child_popup->Window->ParentWindow == window) ? child_popup->Window : NULL;
8273:         if (g.HoveredWindow == window && child_menu_window != NULL)
8274:         {
8275:             const float ref_unit = g.FontSize; // FIXME-DPI
8276:             const float child_dir = (window->Pos.x < child_menu_window->Pos.x) ? 1.0f : -1.0f;
8277:             const ImRect next_window_rect = child_menu_window->Rect();
8278:             ImVec2 ta = (g.IO.MousePos - g.IO.MouseDelta);
8279:             ImVec2 tb = (child_dir > 0.0f) ? next_window_rect.GetTL() : next_window_rect.GetTR();
8280:             ImVec2 tc = (child_dir > 0.0f) ? next_window_rect.GetBL() : next_window_rect.GetBR();
8281:             const float pad_farmost_h = ImClamp(ImFabs(ta.x - tb.x) * 0.30f, ref_unit * 0.5f, ref_unit * 2.5f); // Add a bit of extra slack.
8282:             ta.x += child_dir * -0.5f;
8283:             tb.x += child_dir * ref_unit;
8284:             tc.x += child_dir * ref_unit;
8285:             tb.y = ta.y + ImMax((tb.y - pad_farmost_h) - ta.y, -ref_unit * 8.0f); // Triangle has maximum height to limit the slope and the bias toward large sub-menus
8286:             tc.y = ta.y + ImMin((tc.y + pad_farmost_h) - ta.y, +ref_unit * 8.0f);
8287:             moving_toward_child_menu = ImTriangleContainsPoint(ta, tb, tc, g.IO.MousePos);
8288:             //GetForegroundDrawList()->AddTriangleFilled(ta, tb, tc, moving_toward_child_menu ? IM_COL32(0,128,0,128) : IM_COL32(128,0,0,128)); // [DEBUG]
8289:         }
8290:         // The 'HovereWindow == window' check creates an inconsistency (e.g. moving away from menu slowly tends to hit same window, whereas moving away fast does not)
8291:         // But we also need to not close the top-menu menu when moving over void. Perhaps we should extend the triangle check to a larger polygon.
8292:         // (Remember to test this on BeginPopup("A")->BeginMenu("B") sequence which behaves slightly differently as B isn't a Child of A and hovering isn't shared.)
8293:         if (menu_is_open && !hovered && g.HoveredWindow == window && !moving_toward_child_menu && !g.NavHighlightItemUnderNav && g.ActiveId == 0)
8294:             want_close = true;
8295:         // Open
8296:         // (note: at this point 'hovered' actually includes the NavDisableMouseHover == false test)
8297:         if (!menu_is_open && pressed) // Click/activate to open
8298:             want_open = true;
8299:         else if (!menu_is_open && hovered && !moving_toward_child_menu) // Hover to open
8300:             want_open = true;
8301:         else if (!menu_is_open && hovered && g.HoveredIdTimer >= 0.30f && g.MouseStationaryTimer >= 0.30f) // Hover to open (timer fallback)
8302:             want_open = true;
8303:         if (g.NavId == id && g.NavMoveDir == ImGuiDir_Right) // Nav-Right to open
8304:         {
8305:             want_open = want_open_nav_init = true;
8306:             NavMoveRequestCancel();
8307:             SetNavCursorVisibleAfterMove();
8308:         }
8309:     }
8310:     else
8311:     {
8312:         // Menu bar
8313:         if (menu_is_open && pressed && menuset_is_open) // Click an open menu again to close it
8314:         {
8315:             want_close = true;
8316:             want_open = menu_is_open = false;
8317:         }
8318:         else if (pressed || (hovered && menuset_is_open && !menu_is_open)) // First click to open, then hover to open others
8319:         {
8320:             want_open = true;
8321:         }
8322:         else if (g.NavId == id && g.NavMoveDir == ImGuiDir_Down) // Nav-Down to open
8323:         {
8324:             want_open = true;
8325:             NavMoveRequestCancel();
8326:         }
8327:     }
8328:     if (!enabled) // explicitly close if an open menu becomes disabled, facilitate users code a lot in pattern such as 'if (BeginMenu("options", has_object)) { ..use object.. }'
8329:         want_close = true;
8330:     if (want_close && IsPopupOpen(id, ImGuiPopupFlags_None))
8331:         ClosePopupToLevel(g.BeginPopupStack.Size, true);
8332:     IMGUI_TEST_ENGINE_ITEM_INFO(id, label, g.LastItemData.StatusFlags | ImGuiItemStatusFlags_Openable | (menu_is_open ? ImGuiItemStatusFlags_Opened : 0));
8333:     PopID();
8334:     if (want_open && !menu_is_open && g.OpenPopupStack.Size > g.BeginPopupStack.Size)
8335:     {
8336:         // Don't reopen/recycle same menu level in the same frame if it is a different menu ID, first close the other menu and yield for a frame.
8337:         OpenPopup(label);
8338:     }
8339:     else if (want_open)
8340:     {
8341:         menu_is_open = true;
8342:         OpenPopup(label, ImGuiPopupFlags_NoReopen);// | (want_open_nav_init ? ImGuiPopupFlags_NoReopenAlwaysNavInit : 0));
8343:     }
8344:     if (menu_is_open)
8345:     {
8346:         ImGuiLastItemData last_item_in_parent = g.LastItemData;
8347:         SetNextWindowPos(popup_pos, ImGuiCond_Always);                  // Note: misleading: the value will serve as reference for FindBestWindowPosForPopup(), not actual pos.
8348:         PushStyleVar(ImGuiStyleVar_ChildRounding, style.PopupRounding); // First level will use _PopupRounding, subsequent will use _ChildRounding
8349:         menu_is_open = BeginPopupMenuEx(id, label, window_flags); // menu_is_open may be 'false' when the popup is completely clipped (e.g. zero size display)
8350:         PopStyleVar();
8351:         if (menu_is_open)
8352:         {
8353:             // Implement what ImGuiPopupFlags_NoReopenAlwaysNavInit would do:
8354:             // Perform an init request in the case the popup was already open (via a previous mouse hover)
8355:             if (want_open && want_open_nav_init && !g.NavInitRequest)
8356:             {
8357:                 FocusWindow(g.CurrentWindow, ImGuiFocusRequestFlags_UnlessBelowModal);
8358:                 NavInitWindow(g.CurrentWindow, false);
8359:             }
8360:             // Restore LastItemData so IsItemXXXX functions can work after BeginMenu()/EndMenu()
8361:             // (This fixes using IsItemClicked() and IsItemHovered(), but IsItemHovered() also relies on its support for ImGuiItemFlags_NoWindowHoverableCheck)
8362:             g.LastItemData = last_item_in_parent;
8363:             if (g.HoveredWindow == window)
8364:                 g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_HoveredWindow;
8365:         }
8366:     }
8367:     else
8368:     {
8369:         g.NextWindowData.ClearFlags(); // We behave like Begin() and need to consume those values
8370:     }
8371:     return menu_is_open;
8372: }
