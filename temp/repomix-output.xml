3237: // [SECTION] Tables: Settings (.ini data)
3238: //-------------------------------------------------------------------------
3239: // FIXME: The binding/finding/creating flow are too confusing.
3240: //-------------------------------------------------------------------------
3241: // - TableSettingsInit() [Internal]
3242: // - TableSettingsCalcChunkSize() [Internal]
3243: // - TableSettingsCreate() [Internal]
3244: // - TableSettingsFindByID() [Internal]
3245: // - TableGetBoundSettings() [Internal]
3246: // - TableResetSettings()
3247: // - TableSaveSettings() [Internal]
3248: // - TableLoadSettings() [Internal]
3249: // - TableSettingsHandler_ClearAll() [Internal]
3250: // - TableSettingsHandler_ApplyAll() [Internal]
3251: // - TableSettingsHandler_ReadOpen() [Internal]
3252: // - TableSettingsHandler_ReadLine() [Internal]
3253: // - TableSettingsHandler_WriteAll() [Internal]
3254: // - TableSettingsInstallHandler() [Internal]
3255: //-------------------------------------------------------------------------
3256: // [Init] 1: TableSettingsHandler_ReadXXXX()   Load and parse .ini file into TableSettings.
3257: // [Main] 2: TableLoadSettings()               When table is created, bind Table to TableSettings, serialize TableSettings data into Table.
3258: // [Main] 3: TableSaveSettings()               When table properties are modified, serialize Table data into bound or new TableSettings, mark .ini as dirty.
3259: // [Main] 4: TableSettingsHandler_WriteAll()   When .ini file is dirty (which can come from other source), save TableSettings into .ini file.
3260: //-------------------------------------------------------------------------
3261: // Clear and initialize empty settings instance
3262: static void TableSettingsInit(ImGuiTableSettings* settings, ImGuiID id, int columns_count, int columns_count_max)
3263: {
3264:     IM_PLACEMENT_NEW(settings) ImGuiTableSettings();
3265:     ImGuiTableColumnSettings* settings_column = settings->GetColumnSettings();
3266:     for (int n = 0; n < columns_count_max; n++, settings_column++)
3267:         IM_PLACEMENT_NEW(settings_column) ImGuiTableColumnSettings();
3268:     settings->ID = id;
3269:     settings->ColumnsCount = (ImGuiTableColumnIdx)columns_count;
3270:     settings->ColumnsCountMax = (ImGuiTableColumnIdx)columns_count_max;
3271:     settings->WantApply = true;
3272: }
3273: static size_t TableSettingsCalcChunkSize(int columns_count)
3274: {
3275:     return sizeof(ImGuiTableSettings) + (size_t)columns_count * sizeof(ImGuiTableColumnSettings);
3276: }
3277: ImGuiTableSettings* ImGui::TableSettingsCreate(ImGuiID id, int columns_count)
3278: {
3279:     ImGuiContext& g = *GImGui;
3280:     ImGuiTableSettings* settings = g.SettingsTables.alloc_chunk(TableSettingsCalcChunkSize(columns_count));
3281:     TableSettingsInit(settings, id, columns_count, columns_count);
3282:     return settings;
3283: }
3284: // Find existing settings
3285: ImGuiTableSettings* ImGui::TableSettingsFindByID(ImGuiID id)
3286: {
3287:     // FIXME-OPT: Might want to store a lookup map for this?
3288:     ImGuiContext& g = *GImGui;
3289:     for (ImGuiTableSettings* settings = g.SettingsTables.begin(); settings != NULL; settings = g.SettingsTables.next_chunk(settings))
3290:         if (settings->ID == id)
3291:             return settings;
3292:     return NULL;
3293: }
3294: // Get settings for a given table, NULL if none
3295: ImGuiTableSettings* ImGui::TableGetBoundSettings(ImGuiTable* table)
3296: {
3297:     if (table->SettingsOffset != -1)
3298:     {
3299:         ImGuiContext& g = *GImGui;
3300:         ImGuiTableSettings* settings = g.SettingsTables.ptr_from_offset(table->SettingsOffset);
3301:         IM_ASSERT(settings->ID == table->ID);
3302:         if (settings->ColumnsCountMax >= table->ColumnsCount)
3303:             return settings; // OK
3304:         settings->ID = 0; // Invalidate storage, we won't fit because of a count change
3305:     }
3306:     return NULL;
3307: }
3308: // Restore initial state of table (with or without saved settings)
3309: void ImGui::TableResetSettings(ImGuiTable* table)
3310: {
3311:     table->IsInitializing = table->IsSettingsDirty = true;
3312:     table->IsResetAllRequest = false;
3313:     table->IsSettingsRequestLoad = false;                   // Don't reload from ini
3314:     table->SettingsLoadedFlags = ImGuiTableFlags_None;      // Mark as nothing loaded so our initialized data becomes authoritative
3315: }
3316: void ImGui::TableSaveSettings(ImGuiTable* table)
3317: {
3318:     table->IsSettingsDirty = false;
3319:     if (table->Flags & ImGuiTableFlags_NoSavedSettings)
3320:         return;
3321:     // Bind or create settings data
3322:     ImGuiContext& g = *GImGui;
3323:     ImGuiTableSettings* settings = TableGetBoundSettings(table);
3324:     if (settings == NULL)
3325:     {
3326:         settings = TableSettingsCreate(table->ID, table->ColumnsCount);
3327:         table->SettingsOffset = g.SettingsTables.offset_from_ptr(settings);
3328:     }
3329:     settings->ColumnsCount = (ImGuiTableColumnIdx)table->ColumnsCount;
3330:     // Serialize ImGuiTable/ImGuiTableColumn into ImGuiTableSettings/ImGuiTableColumnSettings
3331:     IM_ASSERT(settings->ID == table->ID);
3332:     IM_ASSERT(settings->ColumnsCount == table->ColumnsCount && settings->ColumnsCountMax >= settings->ColumnsCount);
3333:     ImGuiTableColumn* column = table->Columns.Data;
3334:     ImGuiTableColumnSettings* column_settings = settings->GetColumnSettings();
3335:     bool save_ref_scale = false;
3336:     settings->SaveFlags = ImGuiTableFlags_None;
3337:     for (int n = 0; n < table->ColumnsCount; n++, column++, column_settings++)
3338:     {
3339:         const float width_or_weight = (column->Flags & ImGuiTableColumnFlags_WidthStretch) ? column->StretchWeight : column->WidthRequest;
3340:         column_settings->WidthOrWeight = width_or_weight;
3341:         column_settings->Index = (ImGuiTableColumnIdx)n;
3342:         column_settings->DisplayOrder = column->DisplayOrder;
3343:         column_settings->SortOrder = column->SortOrder;
3344:         column_settings->SortDirection = column->SortDirection;
3345:         column_settings->IsEnabled = column->IsUserEnabled;
3346:         column_settings->IsStretch = (column->Flags & ImGuiTableColumnFlags_WidthStretch) ? 1 : 0;
3347:         if ((column->Flags & ImGuiTableColumnFlags_WidthStretch) == 0)
3348:             save_ref_scale = true;
3349:         // We skip saving some data in the .ini file when they are unnecessary to restore our state.
3350:         // Note that fixed width where initial width was derived from auto-fit will always be saved as InitStretchWeightOrWidth will be 0.0f.
3351:         // FIXME-TABLE: We don't have logic to easily compare SortOrder to DefaultSortOrder yet so it's always saved when present.
3352:         if (width_or_weight != column->InitStretchWeightOrWidth)
3353:             settings->SaveFlags |= ImGuiTableFlags_Resizable;
3354:         if (column->DisplayOrder != n)
3355:             settings->SaveFlags |= ImGuiTableFlags_Reorderable;
3356:         if (column->SortOrder != -1)
3357:             settings->SaveFlags |= ImGuiTableFlags_Sortable;
3358:         if (column->IsUserEnabled != ((column->Flags & ImGuiTableColumnFlags_DefaultHide) == 0))
3359:             settings->SaveFlags |= ImGuiTableFlags_Hideable;
3360:     }
3361:     settings->SaveFlags &= table->Flags;
3362:     settings->RefScale = save_ref_scale ? table->RefScale : 0.0f;
3363:     MarkIniSettingsDirty();
3364: }
3365: void ImGui::TableLoadSettings(ImGuiTable* table)
3366: {
3367:     ImGuiContext& g = *GImGui;
3368:     table->IsSettingsRequestLoad = false;
3369:     if (table->Flags & ImGuiTableFlags_NoSavedSettings)
3370:         return;
3371:     // Bind settings
3372:     ImGuiTableSettings* settings;
3373:     if (table->SettingsOffset == -1)
3374:     {
3375:         settings = TableSettingsFindByID(table->ID);
3376:         if (settings == NULL)
3377:             return;
3378:         if (settings->ColumnsCount != table->ColumnsCount) // Allow settings if columns count changed. We could otherwise decide to return...
3379:             table->IsSettingsDirty = true;
3380:         table->SettingsOffset = g.SettingsTables.offset_from_ptr(settings);
3381:     }
3382:     else
3383:     {
3384:         settings = TableGetBoundSettings(table);
3385:     }
3386:     table->SettingsLoadedFlags = settings->SaveFlags;
3387:     table->RefScale = settings->RefScale;
3388:     // Initialize default columns settings
3389:     for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
3390:     {
3391:         ImGuiTableColumn* column = &table->Columns[column_n];
3392:         TableInitColumnDefaults(table, column, ~0);
3393:         column->AutoFitQueue = 0x00;
3394:     }
3395:     // Serialize ImGuiTableSettings/ImGuiTableColumnSettings into ImGuiTable/ImGuiTableColumn
3396:     ImGuiTableColumnSettings* column_settings = settings->GetColumnSettings();
3397:     for (int data_n = 0; data_n < settings->ColumnsCount; data_n++, column_settings++)
3398:     {
3399:         int column_n = column_settings->Index;
3400:         if (column_n < 0 || column_n >= table->ColumnsCount)
3401:             continue;
3402:         ImGuiTableColumn* column = &table->Columns[column_n];
3403:         if (settings->SaveFlags & ImGuiTableFlags_Resizable)
3404:         {
3405:             if (column_settings->IsStretch)
3406:                 column->StretchWeight = column_settings->WidthOrWeight;
3407:             else
3408:                 column->WidthRequest = column_settings->WidthOrWeight;
3409:         }
3410:         if (settings->SaveFlags & ImGuiTableFlags_Reorderable)
3411:             column->DisplayOrder = column_settings->DisplayOrder;
3412:         if ((settings->SaveFlags & ImGuiTableFlags_Hideable) && column_settings->IsEnabled != -1)
3413:             column->IsUserEnabled = column->IsUserEnabledNextFrame = column_settings->IsEnabled == 1;
3414:         column->SortOrder = column_settings->SortOrder;
3415:         column->SortDirection = column_settings->SortDirection;
3416:     }
3417:     // Fix display order and build index
3418:     if (settings->SaveFlags & ImGuiTableFlags_Reorderable)
3419:         TableFixDisplayOrder(table);
3420:     for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
3421:         table->DisplayOrderToIndex[table->Columns[column_n].DisplayOrder] = (ImGuiTableColumnIdx)column_n;
3422: }
3423: struct ImGuiTableFixDisplayOrderColumnData
3424: {
3425:     ImGuiTableColumnIdx     Idx;
3426:     ImGuiTable*             Table;  // This is unfortunate but we don't have userdata in qsort api.
3427: };
3428: // Sort by DisplayOrder and then Index
3429: static int IMGUI_CDECL TableFixDisplayOrderComparer(const void* lhs, const void* rhs)
3430: {
3431:     const ImGuiTable* table = ((const ImGuiTableFixDisplayOrderColumnData*)lhs)->Table;
3432:     const ImGuiTableColumnIdx lhs_idx = ((const ImGuiTableFixDisplayOrderColumnData*)lhs)->Idx;
3433:     const ImGuiTableColumnIdx rhs_idx = ((const ImGuiTableFixDisplayOrderColumnData*)rhs)->Idx;
3434:     const int order_delta = (table->Columns[lhs_idx].DisplayOrder - table->Columns[rhs_idx].DisplayOrder);
3435:     return (order_delta > 0) ? +1 : (order_delta < 0) ? -1 : (lhs_idx > rhs_idx) ? +1 : -1;
3436: }
3437: // Fix invalid display order data: compact values (0,1,3 -> 0,1,2); preserve relative order (0,3,1 -> 0,2,1); deduplicate (0,4,1,1 -> 0,3,1,2)
3438: void ImGui::TableFixDisplayOrder(ImGuiTable* table)
3439: {
3440:     ImGuiContext& g = *GImGui;
3441:     g.TempBuffer.reserve((int)(sizeof(ImGuiTableFixDisplayOrderColumnData) * table->ColumnsCount)); // FIXME: Maybe wrap those two lines as a helper.
3442:     ImGuiTableFixDisplayOrderColumnData* fdo_columns = (ImGuiTableFixDisplayOrderColumnData*)g.TempBuffer.Data;
3443:     for (int n = 0; n < table->ColumnsCount; n++)
3444:     {
3445:         fdo_columns[n].Idx = (ImGuiTableColumnIdx)n;
3446:         fdo_columns[n].Table = table;
3447:     }
3448:     ImQsort(fdo_columns, (size_t)table->ColumnsCount, sizeof(ImGuiTableFixDisplayOrderColumnData), TableFixDisplayOrderComparer);
3449:     for (int n = 0; n < table->ColumnsCount; n++)
3450:         table->Columns[fdo_columns[n].Idx].DisplayOrder = (ImGuiTableColumnIdx)n;
3451: }
3452: static void TableSettingsHandler_ClearAll(ImGuiContext* ctx, ImGuiSettingsHandler*)
3453: {
3454:     ImGuiContext& g = *ctx;
3455:     for (int i = 0; i != g.Tables.GetMapSize(); i++)
3456:         if (ImGuiTable* table = g.Tables.TryGetMapData(i))
3457:             table->SettingsOffset = -1;
3458:     g.SettingsTables.clear();
3459: }
3460: // Apply to existing windows (if any)
3461: static void TableSettingsHandler_ApplyAll(ImGuiContext* ctx, ImGuiSettingsHandler*)
3462: {
3463:     ImGuiContext& g = *ctx;
3464:     for (int i = 0; i != g.Tables.GetMapSize(); i++)
3465:         if (ImGuiTable* table = g.Tables.TryGetMapData(i))
3466:         {
3467:             table->IsSettingsRequestLoad = true;
3468:             table->SettingsOffset = -1;
3469:         }
3470: }
3471: static void* TableSettingsHandler_ReadOpen(ImGuiContext*, ImGuiSettingsHandler*, const char* name)
3472: {
3473:     ImGuiID id = 0;
3474:     int columns_count = 0;
3475:     if (sscanf(name, "0x%08X,%d", &id, &columns_count) < 2)
3476:         return NULL;
3477:     if (ImGuiTableSettings* settings = ImGui::TableSettingsFindByID(id))
3478:     {
3479:         if (settings->ColumnsCountMax >= columns_count)
3480:         {
3481:             TableSettingsInit(settings, id, columns_count, settings->ColumnsCountMax); // Recycle
3482:             return settings;
3483:         }
3484:         settings->ID = 0; // Invalidate storage, we won't fit because of a count change
3485:     }
3486:     return ImGui::TableSettingsCreate(id, columns_count);
3487: }
3488: static void TableSettingsHandler_ReadLine(ImGuiContext*, ImGuiSettingsHandler*, void* entry, const char* line)
3489: {
3490:     // "Column 0  UserID=0x42AD2D21 Width=100 Visible=1 Order=0 Sort=0v"
3491:     ImGuiTableSettings* settings = (ImGuiTableSettings*)entry;
3492:     float f = 0.0f;
3493:     int column_n = 0, r = 0, n = 0;
3494:     if (sscanf(line, "RefScale=%f", &f) == 1) { settings->RefScale = f; return; }
3495:     if (sscanf(line, "Column %d%n", &column_n, &r) == 1)
3496:     {
3497:         if (column_n < 0 || column_n >= settings->ColumnsCount)
3498:             return;
3499:         line = ImStrSkipBlank(line + r);
3500:         char c = 0;
3501:         ImGuiTableColumnSettings* column = settings->GetColumnSettings() + column_n;
3502:         column->Index = (ImGuiTableColumnIdx)column_n;
3503:         if (sscanf(line, "UserID=0x%08X%n", (ImU32*)&n, &r)==1) { line = ImStrSkipBlank(line + r); column->UserID = (ImGuiID)n; }
3504:         if (sscanf(line, "Width=%d%n", &n, &r) == 1)            { line = ImStrSkipBlank(line + r); column->WidthOrWeight = (float)n; column->IsStretch = 0; settings->SaveFlags |= ImGuiTableFlags_Resizable; }
3505:         if (sscanf(line, "Weight=%f%n", &f, &r) == 1)           { line = ImStrSkipBlank(line + r); column->WidthOrWeight = f; column->IsStretch = 1; settings->SaveFlags |= ImGuiTableFlags_Resizable; }
3506:         if (sscanf(line, "Visible=%d%n", &n, &r) == 1)          { line = ImStrSkipBlank(line + r); column->IsEnabled = (ImU8)n; settings->SaveFlags |= ImGuiTableFlags_Hideable; }
3507:         if (sscanf(line, "Order=%d%n", &n, &r) == 1)            { line = ImStrSkipBlank(line + r); column->DisplayOrder = (ImGuiTableColumnIdx)n; settings->SaveFlags |= ImGuiTableFlags_Reorderable; }
3508:         if (sscanf(line, "Sort=%d%c%n", &n, &c, &r) == 2)       { line = ImStrSkipBlank(line + r); column->SortOrder = (ImGuiTableColumnIdx)n; column->SortDirection = (c == '^') ? ImGuiSortDirection_Descending : ImGuiSortDirection_Ascending; settings->SaveFlags |= ImGuiTableFlags_Sortable; }
3509:     }
3510: }
3511: static void TableSettingsHandler_WriteAll(ImGuiContext* ctx, ImGuiSettingsHandler* handler, ImGuiTextBuffer* buf)
3512: {
3513:     ImGuiContext& g = *ctx;
3514:     for (ImGuiTableSettings* settings = g.SettingsTables.begin(); settings != NULL; settings = g.SettingsTables.next_chunk(settings))
3515:     {
3516:         if (settings->ID == 0) // Skip ditched settings
3517:             continue;
3518:         // TableSaveSettings() may clear some of those flags when we establish that the data can be stripped
3519:         // (e.g. Order was unchanged)
3520:         const bool save_size    = (settings->SaveFlags & ImGuiTableFlags_Resizable) != 0;
3521:         const bool save_visible = (settings->SaveFlags & ImGuiTableFlags_Hideable) != 0;
3522:         const bool save_order   = (settings->SaveFlags & ImGuiTableFlags_Reorderable) != 0;
3523:         const bool save_sort    = (settings->SaveFlags & ImGuiTableFlags_Sortable) != 0;
3524:         // We need to save the [Table] entry even if all the bools are false, since this records a table with "default settings".
3525:         buf->reserve(buf->size() + 30 + settings->ColumnsCount * 50); // ballpark reserve
3526:         buf->appendf("[%s][0x%08X,%d]\n", handler->TypeName, settings->ID, settings->ColumnsCount);
3527:         if (settings->RefScale != 0.0f)
3528:             buf->appendf("RefScale=%g\n", settings->RefScale);
3529:         ImGuiTableColumnSettings* column = settings->GetColumnSettings();
3530:         for (int column_n = 0; column_n < settings->ColumnsCount; column_n++, column++)
3531:         {
3532:             // "Column 0  UserID=0x42AD2D21 Width=100 Visible=1 Order=0 Sort=0v"
3533:             bool save_column = column->UserID != 0 || save_size || save_visible || save_order || (save_sort && column->SortOrder != -1);
3534:             if (!save_column)
3535:                 continue;
3536:             buf->appendf("Column %-2d", column_n);
3537:             if (column->UserID != 0)                    { buf->appendf(" UserID=%08X", column->UserID); }
3538:             if (save_size && column->IsStretch)         { buf->appendf(" Weight=%.4f", column->WidthOrWeight); }
3539:             if (save_size && !column->IsStretch)        { buf->appendf(" Width=%d", (int)column->WidthOrWeight); }
3540:             if (save_visible)                           { buf->appendf(" Visible=%d", column->IsEnabled); }
3541:             if (save_order)                             { buf->appendf(" Order=%d", column->DisplayOrder); }
3542:             if (save_sort && column->SortOrder != -1)   { buf->appendf(" Sort=%d%c", column->SortOrder, (column->SortDirection == ImGuiSortDirection_Ascending) ? 'v' : '^'); }
3543:             buf->append("\n");
3544:         }
3545:         buf->append("\n");
3546:     }
3547: }
