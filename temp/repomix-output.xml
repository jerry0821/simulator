3102: // Render a white-colored bitmap encoded in a string
3103: void ImFontAtlasBuildRenderBitmapFromString(ImFontAtlas* atlas, int x, int y, int w, int h, const char* in_str, char in_marker_char)
3104: {
3105:     ImTextureData* tex = atlas->TexData;
3106:     IM_ASSERT(x >= 0 && x + w <= tex->Width);
3107:     IM_ASSERT(y >= 0 && y + h <= tex->Height);
3108:     switch (tex->Format)
3109:     {
3110:     case ImTextureFormat_Alpha8:
3111:     {
3112:         ImU8* out_p = (ImU8*)tex->GetPixelsAt(x, y);
3113:         for (int off_y = 0; off_y < h; off_y++, out_p += tex->Width, in_str += w)
3114:             for (int off_x = 0; off_x < w; off_x++)
3115:                 out_p[off_x] = (in_str[off_x] == in_marker_char) ? 0xFF : 0x00;
3116:         break;
3117:     }
3118:     case ImTextureFormat_RGBA32:
3119:     {
3120:         ImU32* out_p = (ImU32*)tex->GetPixelsAt(x, y);
3121:         for (int off_y = 0; off_y < h; off_y++, out_p += tex->Width, in_str += w)
3122:             for (int off_x = 0; off_x < w; off_x++)
3123:                 out_p[off_x] = (in_str[off_x] == in_marker_char) ? IM_COL32_WHITE : IM_COL32_BLACK_TRANS;
3124:         break;
3125:     }
3126:     }
3127: }
3128: static void ImFontAtlasBuildUpdateBasicTexData(ImFontAtlas* atlas)
3129: {
3130:     // Pack and store identifier so we can refresh UV coordinates on texture resize.
3131:     // FIXME-NEWATLAS: User/custom rects where user code wants to store UV coordinates will need to do the same thing.
3132:     ImFontAtlasBuilder* builder = atlas->Builder;
3133:     ImVec2i pack_size = (atlas->Flags & ImFontAtlasFlags_NoMouseCursors) ? ImVec2i(2, 2) : ImVec2i(FONT_ATLAS_DEFAULT_TEX_DATA_W * 2 + 1, FONT_ATLAS_DEFAULT_TEX_DATA_H);
3134:     ImFontAtlasRect r;
3135:     bool add_and_draw = (atlas->GetCustomRect(builder->PackIdMouseCursors, &r) == false);
3136:     if (add_and_draw)
3137:     {
3138:         builder->PackIdMouseCursors = atlas->AddCustomRect(pack_size.x, pack_size.y, &r);
3139:         IM_ASSERT(builder->PackIdMouseCursors != ImFontAtlasRectId_Invalid);
3140:         // Draw to texture
3141:         if (atlas->Flags & ImFontAtlasFlags_NoMouseCursors)
3142:         {
3143:             // 2x2 white pixels
3144:             ImFontAtlasBuildRenderBitmapFromString(atlas, r.x, r.y, 2, 2, "XX" "XX", 'X');
3145:         }
3146:         else
3147:         {
3148:             // 2x2 white pixels + mouse cursors
3149:             const int x_for_white = r.x;
3150:             const int x_for_black = r.x + FONT_ATLAS_DEFAULT_TEX_DATA_W + 1;
3151:             ImFontAtlasBuildRenderBitmapFromString(atlas, x_for_white, r.y, FONT_ATLAS_DEFAULT_TEX_DATA_W, FONT_ATLAS_DEFAULT_TEX_DATA_H, FONT_ATLAS_DEFAULT_TEX_DATA_PIXELS, '.');
3152:             ImFontAtlasBuildRenderBitmapFromString(atlas, x_for_black, r.y, FONT_ATLAS_DEFAULT_TEX_DATA_W, FONT_ATLAS_DEFAULT_TEX_DATA_H, FONT_ATLAS_DEFAULT_TEX_DATA_PIXELS, 'X');
3153:         }
3154:     }
3155:     // Refresh UV coordinates
3156:     atlas->TexUvWhitePixel = ImVec2((r.x + 0.5f) * atlas->TexUvScale.x, (r.y + 0.5f) * atlas->TexUvScale.y);
3157: }
3158: static void ImFontAtlasBuildUpdateLinesTexData(ImFontAtlas* atlas)
3159: {
3160:     if (atlas->Flags & ImFontAtlasFlags_NoBakedLines)
3161:         return;
3162:     // Pack and store identifier so we can refresh UV coordinates on texture resize.
3163:     ImTextureData* tex = atlas->TexData;
3164:     ImFontAtlasBuilder* builder = atlas->Builder;
3165:     ImFontAtlasRect r;
3166:     bool add_and_draw = atlas->GetCustomRect(builder->PackIdLinesTexData, &r) == false;
3167:     if (add_and_draw)
3168:     {
3169:         ImVec2i pack_size = ImVec2i(IM_DRAWLIST_TEX_LINES_WIDTH_MAX + 2, IM_DRAWLIST_TEX_LINES_WIDTH_MAX + 1);
3170:         builder->PackIdLinesTexData = atlas->AddCustomRect(pack_size.x, pack_size.y, &r);
3171:         IM_ASSERT(builder->PackIdLinesTexData != ImFontAtlasRectId_Invalid);
3172:     }
3173:     // Register texture region for thick lines
3174:     // The +2 here is to give space for the end caps, whilst height +1 is to accommodate the fact we have a zero-width row
3175:     // This generates a triangular shape in the texture, with the various line widths stacked on top of each other to allow interpolation between them
3176:     for (int n = 0; n < IM_DRAWLIST_TEX_LINES_WIDTH_MAX + 1; n++) // +1 because of the zero-width row
3177:     {
3178:         // Each line consists of at least two empty pixels at the ends, with a line of solid pixels in the middle
3179:         const int y = n;
3180:         const int line_width = n;
3181:         const int pad_left = (r.w - line_width) / 2;
3182:         const int pad_right = r.w - (pad_left + line_width);
3183:         IM_ASSERT(pad_left + line_width + pad_right == r.w && y < r.h); // Make sure we're inside the texture bounds before we start writing pixels
3184:         // Write each slice
3185:         if (add_and_draw && tex->Format == ImTextureFormat_Alpha8)
3186:         {
3187:             ImU8* write_ptr = (ImU8*)tex->GetPixelsAt(r.x, r.y + y);
3188:             for (int i = 0; i < pad_left; i++)
3189:                 *(write_ptr + i) = 0x00;
3190:             for (int i = 0; i < line_width; i++)
3191:                 *(write_ptr + pad_left + i) = 0xFF;
3192:             for (int i = 0; i < pad_right; i++)
3193:                 *(write_ptr + pad_left + line_width + i) = 0x00;
3194:         }
3195:         else if (add_and_draw && tex->Format == ImTextureFormat_RGBA32)
3196:         {
3197:             ImU32* write_ptr = (ImU32*)(void*)tex->GetPixelsAt(r.x, r.y + y);
3198:             for (int i = 0; i < pad_left; i++)
3199:                 *(write_ptr + i) = IM_COL32(255, 255, 255, 0);
3200:             for (int i = 0; i < line_width; i++)
3201:                 *(write_ptr + pad_left + i) = IM_COL32_WHITE;
3202:             for (int i = 0; i < pad_right; i++)
3203:                 *(write_ptr + pad_left + line_width + i) = IM_COL32(255, 255, 255, 0);
3204:         }
3205:         // Refresh UV coordinates
3206:         ImVec2 uv0 = ImVec2((float)(r.x + pad_left - 1), (float)(r.y + y)) * atlas->TexUvScale;
3207:         ImVec2 uv1 = ImVec2((float)(r.x + pad_left + line_width + 1), (float)(r.y + y + 1)) * atlas->TexUvScale;
3208:         float half_v = (uv0.y + uv1.y) * 0.5f; // Calculate a constant V in the middle of the row to avoid sampling artifacts
3209:         atlas->TexUvLines[n] = ImVec4(uv0.x, half_v, uv1.x, half_v);
3210:     }
3211: }
