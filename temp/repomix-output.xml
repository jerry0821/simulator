11194:         for (int n = (*last_dir != ImGuiDir_None) ? -1 : 0; n < ImGuiDir_COUNT; n++)
11195:         {
11196:             const ImGuiDir dir = (n == -1) ? *last_dir : dir_preferred_order[n];
11197:             if (n != -1 && dir == *last_dir) // Already tried this direction?
11198:                 continue;
11199:             ImVec2 pos;
11200:             if (dir == ImGuiDir_Down)  pos = ImVec2(r_avoid.Min.x, r_avoid.Max.y);          // Below, Toward Right (default)
11201:             if (dir == ImGuiDir_Right) pos = ImVec2(r_avoid.Min.x, r_avoid.Min.y - size.y); // Above, Toward Right
11202:             if (dir == ImGuiDir_Left)  pos = ImVec2(r_avoid.Max.x - size.x, r_avoid.Max.y); // Below, Toward Left
11203:             if (dir == ImGuiDir_Up)    pos = ImVec2(r_avoid.Max.x - size.x, r_avoid.Min.y - size.y); // Above, Toward Left
11204:             if (!r_outer.Contains(ImRect(pos, pos + size)))
11205:                 continue;
11206:             *last_dir = dir;
11207:             return pos;
11208:         }
11209:     }
11210:     // Tooltip and Default popup policy
11211:     // (Always first try the direction we used on the last frame, if any)
11212:     if (policy == ImGuiPopupPositionPolicy_Tooltip || policy == ImGuiPopupPositionPolicy_Default)
11213:     {
11214:         const ImGuiDir dir_preferred_order[ImGuiDir_COUNT] = { ImGuiDir_Right, ImGuiDir_Down, ImGuiDir_Up, ImGuiDir_Left };
11215:         for (int n = (*last_dir != ImGuiDir_None) ? -1 : 0; n < ImGuiDir_COUNT; n++)
11216:         {
11217:             const ImGuiDir dir = (n == -1) ? *last_dir : dir_preferred_order[n];
11218:             if (n != -1 && dir == *last_dir) // Already tried this direction?
11219:                 continue;
11220:             const float avail_w = (dir == ImGuiDir_Left ? r_avoid.Min.x : r_outer.Max.x) - (dir == ImGuiDir_Right ? r_avoid.Max.x : r_outer.Min.x);
11221:             const float avail_h = (dir == ImGuiDir_Up ? r_avoid.Min.y : r_outer.Max.y) - (dir == ImGuiDir_Down ? r_avoid.Max.y : r_outer.Min.y);
11222:             // If there's not enough room on one axis, there's no point in positioning on a side on this axis (e.g. when not enough width, use a top/bottom position to maximize available width)
11223:             if (avail_w < size.x && (dir == ImGuiDir_Left || dir == ImGuiDir_Right))
11224:                 continue;
11225:             if (avail_h < size.y && (dir == ImGuiDir_Up || dir == ImGuiDir_Down))
11226:                 continue;
11227:             ImVec2 pos;
11228:             pos.x = (dir == ImGuiDir_Left) ? r_avoid.Min.x - size.x : (dir == ImGuiDir_Right) ? r_avoid.Max.x : base_pos_clamped.x;
11229:             pos.y = (dir == ImGuiDir_Up) ? r_avoid.Min.y - size.y : (dir == ImGuiDir_Down) ? r_avoid.Max.y : base_pos_clamped.y;
11230:             // Clamp top-left corner of popup
11231:             pos.x = ImMax(pos.x, r_outer.Min.x);
11232:             pos.y = ImMax(pos.y, r_outer.Min.y);
