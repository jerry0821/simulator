35:     int y;
36:     int scrollWheelValue;
37:     Mouse_PositionMode positionMode;
38: } Mouse_State;
39: // マウスモジュールの初期化
40: void Mouse_Initialize(HWND window);
41: // マウスモジュールの終了処理
