 17: void PadLogger_Update()
 18: {
 19: 	for(int i=0;i<4;i++)
 20: 	{
 21: 		XInputGetState(i, &g_State[i]);
 22: 		g_ButtonTrigger[i] = (g_ButtonPrev[i] ^ g_State[i].Gamepad.wButtons) & g_State[i].Gamepad.wButtons; // (0^1)&1 = 1
 23: 		g_ButtonRelease[i] = (g_ButtonPrev[i] ^ g_State[i].Gamepad.wButtons) & g_ButtonPrev[i]; // (1^0)&1 = 1
 24: 		g_ButtonPrev[i] = g_State[i].Gamepad.wButtons;
 25: 	}
 26: }
