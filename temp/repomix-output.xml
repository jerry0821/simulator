5304: void ImGui::RenderRectFilledInRangeH(ImDrawList* draw_list, const ImRect& rect, ImU32 col, float fill_x0, float fill_x1, float rounding)
5305: {
5306:     if (fill_x0 > fill_x1)
5307:         return;
5308:     ImVec2 p0 = ImVec2(fill_x0, rect.Min.y);
5309:     ImVec2 p1 = ImVec2(fill_x1, rect.Max.y);
5310:     if (rounding == 0.0f)
5311:     {
5312:         draw_list->AddRectFilled(p0, p1, col, 0.0f);
5313:         return;
5314:     }
5315:     rounding = ImClamp(ImMin((rect.Max.x - rect.Min.x) * 0.5f, (rect.Max.y - rect.Min.y) * 0.5f) - 1.0f, 0.0f, rounding);
5316:     const float inv_rounding = 1.0f / rounding;
5317:     const float arc0_b = ImAcos01(1.0f - (p0.x - rect.Min.x) * inv_rounding);
5318:     const float arc0_e = ImAcos01(1.0f - (p1.x - rect.Min.x) * inv_rounding);
5319:     const float half_pi = IM_PI * 0.5f; // We will == compare to this because we know this is the exact value ImAcos01 can return.
5320:     const float x0 = ImMax(p0.x, rect.Min.x + rounding);
5321:     if (arc0_b == arc0_e)
5322:     {
5323:         draw_list->PathLineTo(ImVec2(x0, p1.y));
5324:         draw_list->PathLineTo(ImVec2(x0, p0.y));
5325:     }
5326:     else if (arc0_b == 0.0f && arc0_e == half_pi)
5327:     {
5328:         draw_list->PathArcToFast(ImVec2(x0, p1.y - rounding), rounding, 3, 6); // BL
5329:         draw_list->PathArcToFast(ImVec2(x0, p0.y + rounding), rounding, 6, 9); // TR
5330:     }
5331:     else
5332:     {
5333:         draw_list->PathArcTo(ImVec2(x0, p1.y - rounding), rounding, IM_PI - arc0_e, IM_PI - arc0_b); // BL
5334:         draw_list->PathArcTo(ImVec2(x0, p0.y + rounding), rounding, IM_PI + arc0_b, IM_PI + arc0_e); // TR
5335:     }
5336:     if (p1.x > rect.Min.x + rounding)
5337:     {
5338:         const float arc1_b = ImAcos01(1.0f - (rect.Max.x - p1.x) * inv_rounding);
5339:         const float arc1_e = ImAcos01(1.0f - (rect.Max.x - p0.x) * inv_rounding);
5340:         const float x1 = ImMin(p1.x, rect.Max.x - rounding);
5341:         if (arc1_b == arc1_e)
5342:         {
5343:             draw_list->PathLineTo(ImVec2(x1, p0.y));
5344:             draw_list->PathLineTo(ImVec2(x1, p1.y));
5345:         }
5346:         else if (arc1_b == 0.0f && arc1_e == half_pi)
5347:         {
5348:             draw_list->PathArcToFast(ImVec2(x1, p0.y + rounding), rounding, 9, 12); // TR
5349:             draw_list->PathArcToFast(ImVec2(x1, p1.y - rounding), rounding, 0, 3);  // BR
5350:         }
5351:         else
5352:         {
5353:             draw_list->PathArcTo(ImVec2(x1, p0.y + rounding), rounding, -arc1_e, -arc1_b); // TR
5354:             draw_list->PathArcTo(ImVec2(x1, p1.y - rounding), rounding, +arc1_b, +arc1_e); // BR
5355:         }
5356:     }
5357:     draw_list->PathFillConvex(col);
5358: }
