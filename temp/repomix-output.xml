14340: // Draw an arbitrary US keyboard layout to visualize translated keys
14341: void ImGui::DebugRenderKeyboardPreview(ImDrawList* draw_list)
14342: {
14343:     const float scale = ImGui::GetFontSize() / 13.0f;
14344:     const ImVec2 key_size = ImVec2(35.0f, 35.0f) * scale;
14345:     const float  key_rounding = 3.0f * scale;
14346:     const ImVec2 key_face_size = ImVec2(25.0f, 25.0f) * scale;
14347:     const ImVec2 key_face_pos = ImVec2(5.0f, 3.0f) * scale;
14348:     const float  key_face_rounding = 2.0f * scale;
14349:     const ImVec2 key_label_pos = ImVec2(7.0f, 4.0f) * scale;
14350:     const ImVec2 key_step = ImVec2(key_size.x - 1.0f, key_size.y - 1.0f);
14351:     const float  key_row_offset = 9.0f * scale;
14352:     ImVec2 board_min = GetCursorScreenPos();
14353:     ImVec2 board_max = ImVec2(board_min.x + 3 * key_step.x + 2 * key_row_offset + 10.0f, board_min.y + 3 * key_step.y + 10.0f);
14354:     ImVec2 start_pos = ImVec2(board_min.x + 5.0f - key_step.x, board_min.y);
14355:     struct KeyLayoutData { int Row, Col; const char* Label; ImGuiKey Key; };
14356:     const KeyLayoutData keys_to_display[] =
14357:     {
14358:         { 0, 0, "", ImGuiKey_Tab },      { 0, 1, "Q", ImGuiKey_Q }, { 0, 2, "W", ImGuiKey_W }, { 0, 3, "E", ImGuiKey_E }, { 0, 4, "R", ImGuiKey_R },
14359:         { 1, 0, "", ImGuiKey_CapsLock }, { 1, 1, "A", ImGuiKey_A }, { 1, 2, "S", ImGuiKey_S }, { 1, 3, "D", ImGuiKey_D }, { 1, 4, "F", ImGuiKey_F },
14360:         { 2, 0, "", ImGuiKey_LeftShift },{ 2, 1, "Z", ImGuiKey_Z }, { 2, 2, "X", ImGuiKey_X }, { 2, 3, "C", ImGuiKey_C }, { 2, 4, "V", ImGuiKey_V }
14361:     };
14362:     // Elements rendered manually via ImDrawList API are not clipped automatically.
14363:     // While not strictly necessary, here IsItemVisible() is used to avoid rendering these shapes when they are out of view.
14364:     Dummy(board_max - board_min);
14365:     if (!IsItemVisible())
14366:         return;
14367:     draw_list->PushClipRect(board_min, board_max, true);
14368:     for (int n = 0; n < IM_ARRAYSIZE(keys_to_display); n++)
14369:     {
14370:         const KeyLayoutData* key_data = &keys_to_display[n];
14371:         ImVec2 key_min = ImVec2(start_pos.x + key_data->Col * key_step.x + key_data->Row * key_row_offset, start_pos.y + key_data->Row * key_step.y);
14372:         ImVec2 key_max = key_min + key_size;
14373:         draw_list->AddRectFilled(key_min, key_max, IM_COL32(204, 204, 204, 255), key_rounding);
14374:         draw_list->AddRect(key_min, key_max, IM_COL32(24, 24, 24, 255), key_rounding);
14375:         ImVec2 face_min = ImVec2(key_min.x + key_face_pos.x, key_min.y + key_face_pos.y);
14376:         ImVec2 face_max = ImVec2(face_min.x + key_face_size.x, face_min.y + key_face_size.y);
14377:         draw_list->AddRect(face_min, face_max, IM_COL32(193, 193, 193, 255), key_face_rounding, ImDrawFlags_None, 2.0f);
14378:         draw_list->AddRectFilled(face_min, face_max, IM_COL32(252, 252, 252, 255), key_face_rounding);
14379:         ImVec2 label_min = ImVec2(key_min.x + key_label_pos.x, key_min.y + key_label_pos.y);
14380:         draw_list->AddText(label_min, IM_COL32(64, 64, 64, 255), key_data->Label);
14381:         if (IsKeyDown(key_data->Key))
14382:             draw_list->AddRectFilled(key_min, key_max, IM_COL32(255, 0, 0, 128), key_rounding);
14383:     }
14384:     draw_list->PopClipRect();
14385: }
14386: // Helper tool to diagnose between text encoding issues and font loading issues. Pass your UTF-8 string and verify that there are correct.
14387: void ImGui::DebugTextEncoding(const char* str)
14388: {
14389:     Text("Text: \"%s\"", str);
14390:     if (!BeginTable("##DebugTextEncoding", 4, ImGuiTableFlags_Borders | ImGuiTableFlags_RowBg | ImGuiTableFlags_SizingFixedFit | ImGuiTableFlags_Resizable))
14391:         return;
14392:     TableSetupColumn("Offset");
14393:     TableSetupColumn("UTF-8");
14394:     TableSetupColumn("Glyph");
14395:     TableSetupColumn("Codepoint");
14396:     TableHeadersRow();
14397:     const char* str_end = str + strlen(str); // As we may receive malformed UTF-8, pass an explicit end instead of relying on ImTextCharFromUtf8() assuming enough space.
14398:     for (const char* p = str; *p != 0; )
14399:     {
14400:         unsigned int c;
14401:         const int c_utf8_len = ImTextCharFromUtf8(&c, p, str_end);
14402:         TableNextColumn();
14403:         Text("%d", (int)(p - str));
14404:         TableNextColumn();
14405:         for (int byte_index = 0; byte_index < c_utf8_len; byte_index++)
14406:         {
14407:             if (byte_index > 0)
14408:                 SameLine();
14409:             Text("0x%02X", (int)(unsigned char)p[byte_index]);
14410:         }
14411:         TableNextColumn();
14412:         TextUnformatted(p, p + c_utf8_len);
14413:         if (!GetFont()->IsGlyphInFont((ImWchar)c))
14414:         {
14415:             SameLine();
14416:             TextUnformatted("[missing]");
14417:         }
14418:         TableNextColumn();
14419:         Text("U+%04X", (int)c);
14420:         p += c_utf8_len;
14421:     }
14422:     EndTable();
14423: }
