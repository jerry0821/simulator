 849: // Return scrollbar rectangle, must only be called for corresponding axis if window->ScrollbarX/Y is set.
 850: ImRect ImGui::GetWindowScrollbarRect(ImGuiWindow* window, ImGuiAxis axis)
 851: {
 852:     ImGuiContext& g = *GImGui;
 853:     const ImRect outer_rect = window->Rect();
 854:     const ImRect inner_rect = window->InnerRect;
 855:     const float scrollbar_size = window->ScrollbarSizes[axis ^ 1]; // (ScrollbarSizes.x = width of Y scrollbar; ScrollbarSizes.y = height of X scrollbar)
 856:     IM_ASSERT(scrollbar_size >= 0.0f);
 857:     const float border_size = IM_ROUND(window->WindowBorderSize * 0.5f);
 858:     const float border_top = (window->Flags & ImGuiWindowFlags_MenuBar) ? IM_ROUND(g.Style.FrameBorderSize * 0.5f) : 0.0f;
 859:     if (axis == ImGuiAxis_X)
 860:         return ImRect(inner_rect.Min.x + border_size, ImMax(outer_rect.Min.y + border_size, outer_rect.Max.y - border_size - scrollbar_size), inner_rect.Max.x - border_size, outer_rect.Max.y - border_size);
 861:     else
 862:         return ImRect(ImMax(outer_rect.Min.x, outer_rect.Max.x - border_size - scrollbar_size), inner_rect.Min.y + border_top, outer_rect.Max.x - border_size, inner_rect.Max.y - border_size);
