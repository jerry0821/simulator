745: _Use_decl_annotations_
746: HRESULT DirectX::CreateWICTextureFromMemoryEx(
747:     ID3D11Device* d3dDevice,
748:     ID3D11DeviceContext* d3dContext,
749:     const uint8_t* wicData,
750:     size_t wicDataSize,
751:     size_t maxsize,
752:     D3D11_USAGE usage,
753:     unsigned int bindFlags,
754:     unsigned int cpuAccessFlags,
755:     unsigned int miscFlags,
756:     WIC_LOADER_FLAGS loadFlags,
757:     ID3D11Resource** texture,
758:     ID3D11ShaderResourceView** textureView) noexcept
759: {
760:     if (texture)
761:     {
762:         *texture = nullptr;
763:     }
764:     if (textureView)
765:     {
766:         *textureView = nullptr;
767:     }
768:     if (!d3dDevice || !wicData || (!texture && !textureView))
769:     {
770:         return E_INVALIDARG;
771:     }
772:     if (textureView && !(bindFlags & D3D11_BIND_SHADER_RESOURCE))
773:     {
774:         return E_INVALIDARG;
775:     }
776:     if (!wicDataSize)
777:         return E_FAIL;
778:     if (wicDataSize > UINT32_MAX)
779:         return HRESULT_FROM_WIN32(ERROR_FILE_TOO_LARGE);
780:     auto pWIC = GetWIC();
781:     if (!pWIC)
782:         return E_NOINTERFACE;
783:     // Create input stream for memory
784:     ComPtr<IWICStream> stream;
785:     HRESULT hr = pWIC->CreateStream(stream.GetAddressOf());
786:     if (FAILED(hr))
787:         return hr;
788:     hr = stream->InitializeFromMemory(const_cast<uint8_t*>(wicData), static_cast<DWORD>(wicDataSize));
789:     if (FAILED(hr))
790:         return hr;
791:     // Initialize WIC
792:     ComPtr<IWICBitmapDecoder> decoder;
793:     hr = pWIC->CreateDecoderFromStream(stream.Get(), nullptr, WICDecodeMetadataCacheOnDemand, decoder.GetAddressOf());
794:     if (FAILED(hr))
795:         return hr;
796:     ComPtr<IWICBitmapFrameDecode> frame;
797:     hr = decoder->GetFrame(0, frame.GetAddressOf());
798:     if (FAILED(hr))
799:         return hr;
800:     hr = CreateTextureFromWIC(d3dDevice, d3dContext,
801:         frame.Get(),
802:         maxsize,
803:         usage, bindFlags, cpuAccessFlags, miscFlags,
804:         loadFlags,
805:         texture, textureView);
806:     if (FAILED(hr))
807:         return hr;
808:     if (texture && *texture)
809:     {
810:         SetDebugObjectName(*texture, "WICTextureLoader");
811:     }
812:     if (textureView && *textureView)
813:     {
814:         SetDebugObjectName(*textureView, "WICTextureLoader");
815:     }
816:     return hr;
817: }
