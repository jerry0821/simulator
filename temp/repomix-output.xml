3364:         style.FramePadding.x = style.FramePadding.y;
3365:         if (flags & ImGuiInputTextFlags_ReadOnly)
3366:             BeginDisabled();
3367:         PushItemFlag(ImGuiItemFlags_ButtonRepeat, true);
3368:         SameLine(0, style.ItemInnerSpacing.x);
3369:         if (ButtonEx("-", ImVec2(button_size, button_size)))
3370:         {
3371:             DataTypeApplyOp(data_type, '-', p_data, p_data, g.IO.KeyCtrl && p_step_fast ? p_step_fast : p_step);
3372:             value_changed = true;
3373:         }
3374:         SameLine(0, style.ItemInnerSpacing.x);
3375:         if (ButtonEx("+", ImVec2(button_size, button_size)))
3376:         {
3377:             DataTypeApplyOp(data_type, '+', p_data, p_data, g.IO.KeyCtrl && p_step_fast ? p_step_fast : p_step);
3378:             value_changed = true;
3379:         }
3380:         PopItemFlag();
3381:         if (flags & ImGuiInputTextFlags_ReadOnly)
3382:             EndDisabled();
