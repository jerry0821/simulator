3162: // Specs and pixel storage for a texture used by Dear ImGui.
3163: // This is only useful for (1) core library and (2) backends. End-user/applications do not need to care about this.
3164: // Renderer Backends will create a GPU-side version of this.
3165: // Why does we store two identifiers: TexID and BackendUserData?
3166: // - ImTextureID    TexID           = lower-level identifier stored in ImDrawCmd. ImDrawCmd can refer to textures not created by the backend, and for which there's no ImTextureData.
3167: // - void*          BackendUserData = higher-level opaque storage for backend own book-keeping. Some backends may have enough with TexID and not need both.
3168:  // In columns below: who reads/writes each fields? 'r'=read, 'w'=write, 'core'=main library, 'backend'=renderer backend
3169: struct ImTextureData
3170: {
3171:     //------------------------------------------ core / backend ---------------------------------------
3172:     int                 UniqueID;               // w    -   // [DEBUG] Sequential index to facilitate identifying a texture when debugging/printing. Unique per atlas.
3173:     ImTextureStatus     Status;                 // rw   rw  // ImTextureStatus_OK/_WantCreate/_WantUpdates/_WantDestroy. Always use SetStatus() to modify!
3174:     void*               BackendUserData;        // -    rw  // Convenience storage for backend. Some backends may have enough with TexID.
3175:     ImTextureID         TexID;                  // r    w   // Backend-specific texture identifier. Always use SetTexID() to modify! The identifier will stored in ImDrawCmd::GetTexID() and passed to backend's RenderDrawData function.
3176:     ImTextureFormat     Format;                 // w    r   // ImTextureFormat_RGBA32 (default) or ImTextureFormat_Alpha8
3177:     int                 Width;                  // w    r   // Texture width
3178:     int                 Height;                 // w    r   // Texture height
3179:     int                 BytesPerPixel;          // w    r   // 4 or 1
3180:     unsigned char*      Pixels;                 // w    r   // Pointer to buffer holding 'Width*Height' pixels and 'Width*Height*BytesPerPixels' bytes.
3181:     ImTextureRect       UsedRect;               // w    r   // Bounding box encompassing all past and queued Updates[].
3182:     ImTextureRect       UpdateRect;             // w    r   // Bounding box encompassing all queued Updates[].
3183:     ImVector<ImTextureRect> Updates;            // w    r   // Array of individual updates.
3184:     int                 UnusedFrames;           // w    r   // In order to facilitate handling Status==WantDestroy in some backend: this is a count successive frames where the texture was not used. Always >0 when Status==WantDestroy.
3185:     unsigned short      RefCount;               // w    r   // Number of contexts using this texture. Used during backend shutdown.
3186:     bool                UseColors;              // w    r   // Tell whether our texture data is known to use colors (rather than just white + alpha).
3187:     bool                WantDestroyNextFrame;   // rw   -   // [Internal] Queued to set ImTextureStatus_WantDestroy next frame. May still be used in the current frame.
3188:     // Functions
3189:     ImTextureData()     { memset(this, 0, sizeof(*this)); Status = ImTextureStatus_Destroyed; TexID = ImTextureID_Invalid; }
3190:     ~ImTextureData()    { DestroyPixels(); }
3191:     IMGUI_API void      Create(ImTextureFormat format, int w, int h);
3192:     IMGUI_API void      DestroyPixels();
3193:     void*               GetPixels()                 { IM_ASSERT(Pixels != NULL); return Pixels; }
3194:     void*               GetPixelsAt(int x, int y)   { IM_ASSERT(Pixels != NULL); return Pixels + (x + y * Width) * BytesPerPixel; }
3195:     int                 GetSizeInBytes() const      { return Width * Height * BytesPerPixel; }
3196:     int                 GetPitch() const            { return Width * BytesPerPixel; }
3197:     ImTextureRef        GetTexRef()                 { ImTextureRef tex_ref; tex_ref._TexData = this; tex_ref._TexID = ImTextureID_Invalid; return tex_ref; }
3198:     ImTextureID         GetTexID() const            { return TexID; }
3199:     // Called by Renderer backend
3200:     // - Call SetTexID() and SetStatus() after honoring texture requests. Never modify TexID and Status directly!
3201:     // - A backend may decide to destroy a texture that we did not request to destroy, which is fine (e.g. freeing resources), but we immediately set the texture back in _WantCreate mode.
3202:     void    SetTexID(ImTextureID tex_id)            { TexID = tex_id; }
3203:     void    SetStatus(ImTextureStatus status)       { Status = status; if (status == ImTextureStatus_Destroyed && !WantDestroyNextFrame) Status = ImTextureStatus_WantCreate; }
3204: };
