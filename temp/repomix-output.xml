 21: /*------------------------------------------------------------------------------
 22:    関数定義
 23: ------------------------------------------------------------------------------*/
 24: // システムタイマーの初期化
 25: void SystemTimer_Initialize(void)
 26: {
 27:     g_bTimerStopped = true;
 28:     g_TicksPerSec = 0;
 29:     g_StopTime = 0;
 30:     g_LastElapsedTime = 0;
 31:     g_BaseTime = 0;
 32:     // 高分解能パフォーマンスカウンタ周波数の取得
 33:     LARGE_INTEGER ticksPerSec = { 0 };
 34:     QueryPerformanceFrequency(&ticksPerSec);
 35:     g_TicksPerSec = ticksPerSec.QuadPart;
 36: }
 37: // システムタイマーのリセット
 38: void SystemTimer_Reset(void)
 39: {
 40:     LARGE_INTEGER time = GetAdjustedCurrentTime();
 41:     g_BaseTime = g_LastElapsedTime = time.QuadPart;
 42:     g_StopTime = 0;
 43:     g_bTimerStopped = false;
 44: }
 45: // システムタイマーのスタート
 46: void SystemTimer_Start(void)
 47: {
 48:     // 現在の時間を取得
 49:     LARGE_INTEGER time = { 0 };
 50:     QueryPerformanceCounter(&time);
 51:     // 今まで計測がストップしていたら
 52:     if( g_bTimerStopped ) {
 53:         // 止まっていた時間を差し引いて基本時間を更新
 54:         g_BaseTime += time.QuadPart - g_StopTime;
 55:     }
 56:     g_StopTime = 0;
 57:     g_LastElapsedTime = time.QuadPart;
 58:     g_bTimerStopped = false;
 59: }
 60: // システムタイマーのストップ
 61: void SystemTimer_Stop(void)
 62: {
 63:     if( g_bTimerStopped ) return;
 64:     LARGE_INTEGER time = { 0 };
 65:     QueryPerformanceCounter(&time);
 66:     g_LastElapsedTime = g_StopTime = time.QuadPart; // 停止時間を記録
 67:     g_bTimerStopped = true;
 68: }
 69: // システムタイマーを0.1秒進める
 70: void SystemTimer_Advance(void)
 71: {
 72:     g_StopTime += g_TicksPerSec / 10;
 73: }
 74: // 計測時間を取得
 75: double SystemTimer_GetTime(void)
 76: {
 77:     LARGE_INTEGER time = GetAdjustedCurrentTime();
 78:     return (double)(time.QuadPart - g_BaseTime) / (double)g_TicksPerSec;
 79: }
 80: // 現在の時間を取得
 81: double SystemTimer_GetAbsoluteTime(void)
 82: {
 83:     LARGE_INTEGER time = { 0 };
 84:     QueryPerformanceCounter(&time);
 85:     return time.QuadPart / (double)g_TicksPerSec;
 86: }
 87: // 経過時間の取得
 88: double SystemTimer_GetElapsedTime(void)
 89: {
 90:     LARGE_INTEGER time = GetAdjustedCurrentTime();
 91:     double elapsed_time = (double)(time.QuadPart - g_LastElapsedTime) / (double)g_TicksPerSec;
 92:     g_LastElapsedTime = time.QuadPart;
 93:     // タイマーが正確であることを保証するために、更新時間を０にクランプする。
 94:     // elapsed_timeは、プロセッサが節電モードに入るか、何らかの形で別のプロセッサにシャッフルされると、この範囲外になる可能性がある。
 95:     // よって、メインスレッドはSetThreadAffinityMaskを呼び出して、別のプロセッサにシャッフルされないようにする必要がある。
 96:     // 他のワーカースレッドはSetThreadAffinityMaskを呼び出すべきではなく、メインスレッドから収集されたタイマーデータの共有コピーを使用すること。
 97:     if( elapsed_time < 0.0 ) {
 98:         elapsed_time = 0.0;
 99:     }
100:     return elapsed_time;
101: }
102: // システムタイマーが止まっているか？
103: bool SystemTimer_IsStoped(void)
104: {
105:     return g_bTimerStopped;
106: }
107: // 現在のスレッドを1つのプロセッサ（現在のスレッド）に制限
108: void LimitThreadAffinityToCurrentProc(void)
109: {
110:     HANDLE hCurrentProcess = GetCurrentProcess();
111:     // Get the processor affinity mask for this process
112:     DWORD_PTR dwProcessAffinityMask = 0;
113:     DWORD_PTR dwSystemAffinityMask = 0;
114:     if( GetProcessAffinityMask(hCurrentProcess, &dwProcessAffinityMask, &dwSystemAffinityMask) != 0 && dwProcessAffinityMask ) {
115:         // Find the lowest processor that our process is allows to run against
116:         DWORD_PTR dwAffinityMask = (dwProcessAffinityMask & ((~dwProcessAffinityMask) + 1));
117:         // Set this as the processor that our thread must always run against
118:         // This must be a subset of the process affinity mask
119:         HANDLE hCurrentThread = GetCurrentThread();
120:         if( INVALID_HANDLE_VALUE != hCurrentThread ) {
121:             SetThreadAffinityMask(hCurrentThread, dwAffinityMask);
122:             CloseHandle(hCurrentThread);
123:         }
124:     }
125:     CloseHandle(hCurrentProcess);
126: }
127: // 停止していれば停止時間、そうでなければ現在の時間の取得
128: LARGE_INTEGER GetAdjustedCurrentTime(void)
129: {
130:     LARGE_INTEGER time;
131:     if( g_StopTime != 0 ) {
132:         time.QuadPart = g_StopTime;
133:     }
134:     else {
135:         QueryPerformanceCounter(&time);
136:     }
137:     return time;
138: }
