2249: // Allocate draw channels. Called by TableUpdateLayout()
2250: // - We allocate them following storage order instead of display order so reordering columns won't needlessly
2251: //   increase overall dormant memory cost.
2252: // - We isolate headers draw commands in their own channels instead of just altering clip rects.
2253: //   This is in order to facilitate merging of draw commands.
2254: // - After crossing FreezeRowsCount, all columns see their current draw channel changed to a second set of channels.
2255: // - We only use the dummy draw channel so we can push a null clipping rectangle into it without affecting other
2256: //   channels, while simplifying per-row/per-cell overhead. It will be empty and discarded when merged.
2257: // - We allocate 1 or 2 background draw channels. This is because we know TablePushBackgroundChannel() is only used for
2258: //   horizontal spanning. If we allowed vertical spanning we'd need one background draw channel per merge group (1-4).
2259: // Draw channel allocation (before merging):
2260: // - NoClip                       --> 2+D+1 channels: bg0/1 + bg2 + foreground (same clip rect == always 1 draw call)
2261: // - Clip                         --> 2+D+N channels
2262: // - FreezeRows                   --> 2+D+N*2 (unless scrolling value is zero)
2263: // - FreezeRows || FreezeColumns  --> 3+D+N*2 (unless scrolling value is zero)
2264: // Where D is 1 if any column is clipped or hidden (dummy channel) otherwise 0.
2265: void ImGui::TableSetupDrawChannels(ImGuiTable* table)
2266: {
2267:     const int freeze_row_multiplier = (table->FreezeRowsCount > 0) ? 2 : 1;
2268:     const int channels_for_row = (table->Flags & ImGuiTableFlags_NoClip) ? 1 : table->ColumnsEnabledCount;
2269:     const int channels_for_bg = 1 + 1 * freeze_row_multiplier;
2270:     const int channels_for_dummy = (table->ColumnsEnabledCount < table->ColumnsCount || (memcmp(table->VisibleMaskByIndex, table->EnabledMaskByIndex, ImBitArrayGetStorageSizeInBytes(table->ColumnsCount)) != 0)) ? +1 : 0;
2271:     const int channels_total = channels_for_bg + (channels_for_row * freeze_row_multiplier) + channels_for_dummy;
2272:     table->DrawSplitter->Split(table->InnerWindow->DrawList, channels_total);
2273:     table->DummyDrawChannel = (ImGuiTableDrawChannelIdx)((channels_for_dummy > 0) ? channels_total - 1 : -1);
2274:     table->Bg2DrawChannelCurrent = TABLE_DRAW_CHANNEL_BG2_FROZEN;
2275:     table->Bg2DrawChannelUnfrozen = (ImGuiTableDrawChannelIdx)((table->FreezeRowsCount > 0) ? 2 + channels_for_row : TABLE_DRAW_CHANNEL_BG2_FROZEN);
2276:     int draw_channel_current = 2;
2277:     for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
2278:     {
2279:         ImGuiTableColumn* column = &table->Columns[column_n];
2280:         if (column->IsVisibleX && column->IsVisibleY)
2281:         {
2282:             column->DrawChannelFrozen = (ImGuiTableDrawChannelIdx)(draw_channel_current);
2283:             column->DrawChannelUnfrozen = (ImGuiTableDrawChannelIdx)(draw_channel_current + (table->FreezeRowsCount > 0 ? channels_for_row + 1 : 0));
2284:             if (!(table->Flags & ImGuiTableFlags_NoClip))
2285:                 draw_channel_current++;
2286:         }
2287:         else
2288:         {
2289:             column->DrawChannelFrozen = column->DrawChannelUnfrozen = table->DummyDrawChannel;
2290:         }
2291:         column->DrawChannelCurrent = column->DrawChannelFrozen;
2292:     }
2293:     // Initial draw cmd starts with a BgClipRect that matches the one of its host, to facilitate merge draw commands by default.
2294:     // All our cell highlight are manually clipped with BgClipRect. When unfreezing it will be made smaller to fit scrolling rect.
2295:     // (This technically isn't part of setting up draw channels, but is reasonably related to be done here)
2296:     table->BgClipRect = table->InnerClipRect;
2297:     table->Bg0ClipRectForDrawCmd = table->OuterWindow->ClipRect;
2298:     table->Bg2ClipRectForDrawCmd = table->HostClipRect;
2299:     IM_ASSERT(table->BgClipRect.Min.y <= table->BgClipRect.Max.y);
2300: }
2301: // This function reorder draw channels based on matching clip rectangle, to facilitate merging them. Called by EndTable().
2302: // For simplicity we call it TableMergeDrawChannels() but in fact it only reorder channels + overwrite ClipRect,
2303: // actual merging is done by table->DrawSplitter.Merge() which is called right after TableMergeDrawChannels().
2304: //
2305: // Columns where the contents didn't stray off their local clip rectangle can be merged. To achieve
2306: // this we merge their clip rect and make them contiguous in the channel list, so they can be merged
2307: // by the call to DrawSplitter.Merge() following to the call to this function.
2308: // We reorder draw commands by arranging them into a maximum of 4 distinct groups:
2309: //
2310: //   1 group:               2 groups:              2 groups:              4 groups:
2311: //   [ 0. ] no freeze       [ 0. ] row freeze      [ 01 ] col freeze      [ 01 ] row+col freeze
2312: //   [ .. ]  or no scroll   [ 2. ]  and v-scroll   [ .. ]  and h-scroll   [ 23 ]  and v+h-scroll
2313: //
2314: // Each column itself can use 1 channel (row freeze disabled) or 2 channels (row freeze enabled).
2315: // When the contents of a column didn't stray off its limit, we move its channels into the corresponding group
2316: // based on its position (within frozen rows/columns groups or not).
2317: // At the end of the operation our 1-4 groups will each have a ImDrawCmd using the same ClipRect.
2318: // This function assume that each column are pointing to a distinct draw channel,
2319: // otherwise merge_group->ChannelsCount will not match set bit count of merge_group->ChannelsMask.
2320: //
2321: // Column channels will not be merged into one of the 1-4 groups in the following cases:
2322: // - The contents stray off its clipping rectangle (we only compare the MaxX value, not the MinX value).
2323: //   Direct ImDrawList calls won't be taken into account by default, if you use them make sure the ImGui:: bounds
2324: //   matches, by e.g. calling SetCursorScreenPos().
2325: // - The channel uses more than one draw command itself. We drop all our attempt at merging stuff here..
2326: //   we could do better but it's going to be rare and probably not worth the hassle.
2327: // Columns for which the draw channel(s) haven't been merged with other will use their own ImDrawCmd.
2328: //
2329: // This function is particularly tricky to understand.. take a breath.
2330: void ImGui::TableMergeDrawChannels(ImGuiTable* table)
2331: {
2332:     ImGuiContext& g = *GImGui;
2333:     ImDrawListSplitter* splitter = table->DrawSplitter;
2334:     const bool has_freeze_v = (table->FreezeRowsCount > 0);
2335:     const bool has_freeze_h = (table->FreezeColumnsCount > 0);
2336:     IM_ASSERT(splitter->_Current == 0);
2337:     // Track which groups we are going to attempt to merge, and which channels goes into each group.
2338:     struct MergeGroup
2339:     {
2340:         ImRect          ClipRect;
2341:         int             ChannelsCount = 0;
2342:         ImBitArrayPtr   ChannelsMask = NULL;
2343:     };
2344:     int merge_group_mask = 0x00;
2345:     MergeGroup merge_groups[4];
2346:     // Use a reusable temp buffer for the merge masks as they are dynamically sized.
2347:     const int max_draw_channels = (4 + table->ColumnsCount * 2);
2348:     const int size_for_masks_bitarrays_one = (int)ImBitArrayGetStorageSizeInBytes(max_draw_channels);
2349:     g.TempBuffer.reserve(size_for_masks_bitarrays_one * 5);
2350:     memset(g.TempBuffer.Data, 0, size_for_masks_bitarrays_one * 5);
