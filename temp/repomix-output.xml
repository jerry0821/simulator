146: static bool ImGui_ImplWin32_InitEx(void* hwnd, bool platform_has_own_dc)
147: {
148:     ImGuiIO& io = ImGui::GetIO();
149:     IMGUI_CHECKVERSION();
150:     IM_ASSERT(io.BackendPlatformUserData == nullptr && "Already initialized a platform backend!");
151:     INT64 perf_frequency, perf_counter;
152:     if (!::QueryPerformanceFrequency((LARGE_INTEGER*)&perf_frequency))
153:         return false;
154:     if (!::QueryPerformanceCounter((LARGE_INTEGER*)&perf_counter))
155:         return false;
156:     // Setup backend capabilities flags
157:     ImGui_ImplWin32_Data* bd = IM_NEW(ImGui_ImplWin32_Data)();
158:     io.BackendPlatformUserData = (void*)bd;
159:     io.BackendPlatformName = "imgui_impl_win32";
160:     io.BackendFlags |= ImGuiBackendFlags_HasMouseCursors;         // We can honor GetMouseCursor() values (optional)
161:     io.BackendFlags |= ImGuiBackendFlags_HasSetMousePos;          // We can honor io.WantSetMousePos requests (optional, rarely used)
162:     bd->hWnd = (HWND)hwnd;
163:     bd->TicksPerSecond = perf_frequency;
164:     bd->Time = perf_counter;
165:     bd->LastMouseCursor = ImGuiMouseCursor_COUNT;
166:     ImGui_ImplWin32_UpdateKeyboardCodePage(io);
167:     // Set platform dependent data in viewport
168:     ImGuiViewport* main_viewport = ImGui::GetMainViewport();
169:     main_viewport->PlatformHandle = main_viewport->PlatformHandleRaw = (void*)bd->hWnd;
170:     IM_UNUSED(platform_has_own_dc); // Used in 'docking' branch
171:     // Dynamically load XInput library
172: #ifndef IMGUI_IMPL_WIN32_DISABLE_GAMEPAD
173:     bd->WantUpdateHasGamepad = true;
174:     const char* xinput_dll_names[] =
175:     {
176:         "xinput1_4.dll",   // Windows 8+
177:         "xinput1_3.dll",   // DirectX SDK
178:         "xinput9_1_0.dll", // Windows Vista, Windows 7
179:         "xinput1_2.dll",   // DirectX SDK
180:         "xinput1_1.dll"    // DirectX SDK
181:     };
182:     for (int n = 0; n < IM_ARRAYSIZE(xinput_dll_names); n++)
183:         if (HMODULE dll = ::LoadLibraryA(xinput_dll_names[n]))
184:         {
185:             bd->XInputDLL = dll;
186:             bd->XInputGetCapabilities = (PFN_XInputGetCapabilities)::GetProcAddress(dll, "XInputGetCapabilities");
187:             bd->XInputGetState = (PFN_XInputGetState)::GetProcAddress(dll, "XInputGetState");
188:             break;
189:         }
190: #endif // IMGUI_IMPL_WIN32_DISABLE_GAMEPAD
191:     return true;
192: }
