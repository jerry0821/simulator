6438: // CollapsingHeader returns true when opened but do not indent nor push into the ID stack (because of the ImGuiTreeNodeFlags_NoTreePushOnOpen flag).
6439: // This is basically the same as calling TreeNodeEx(label, ImGuiTreeNodeFlags_CollapsingHeader). You can remove the _NoTreePushOnOpen flag if you want behavior closer to normal TreeNode().
6440: bool ImGui::CollapsingHeader(const char* label, ImGuiTreeNodeFlags flags)
6441: {
6442:     ImGuiWindow* window = GetCurrentWindow();
6443:     if (window->SkipItems)
6444:         return false;
6445:     ImGuiID id = window->GetID(label);
6446:     return TreeNodeBehavior(id, flags | ImGuiTreeNodeFlags_CollapsingHeader, label);
6447: }
6448: // p_visible == NULL                        : regular collapsing header
6449: // p_visible != NULL && *p_visible == true  : show a small close button on the corner of the header, clicking the button will set *p_visible = false
6450: // p_visible != NULL && *p_visible == false : do not show the header at all
6451: // Do not mistake this with the Open state of the header itself, which you can adjust with SetNextItemOpen() or ImGuiTreeNodeFlags_DefaultOpen.
6452: bool ImGui::CollapsingHeader(const char* label, bool* p_visible, ImGuiTreeNodeFlags flags)
6453: {
6454:     ImGuiWindow* window = GetCurrentWindow();
6455:     if (window->SkipItems)
6456:         return false;
6457:     if (p_visible && !*p_visible)
6458:         return false;
6459:     ImGuiID id = window->GetID(label);
6460:     flags |= ImGuiTreeNodeFlags_CollapsingHeader;
6461:     if (p_visible)
6462:         flags |= ImGuiTreeNodeFlags_AllowOverlap | (ImGuiTreeNodeFlags)ImGuiTreeNodeFlags_ClipLabelForTrailingButton;
6463:     bool is_open = TreeNodeBehavior(id, flags, label);
6464:     if (p_visible != NULL)
6465:     {
6466:         // Create a small overlapping close button
6467:         // FIXME: We can evolve this into user accessible helpers to add extra buttons on title bars, headers, etc.
6468:         // FIXME: CloseButton can overlap into text, need find a way to clip the text somehow.
6469:         ImGuiContext& g = *GImGui;
6470:         ImGuiLastItemData last_item_backup = g.LastItemData;
6471:         float button_size = g.FontSize;
6472:         float button_x = ImMax(g.LastItemData.Rect.Min.x, g.LastItemData.Rect.Max.x - g.Style.FramePadding.x - button_size);
6473:         float button_y = g.LastItemData.Rect.Min.y + g.Style.FramePadding.y;
6474:         ImGuiID close_button_id = GetIDWithSeed("#CLOSE", NULL, id);
6475:         if (CloseButton(close_button_id, ImVec2(button_x, button_y)))
6476:             *p_visible = false;
6477:         g.LastItemData = last_item_backup;
6478:     }
6479:     return is_open;
6480: }
6481: //-------------------------------------------------------------------------
6482: // [SECTION] Widgets: Selectable
6483: //-------------------------------------------------------------------------
6484: // - Selectable()
6485: //-------------------------------------------------------------------------
6486: // Tip: pass a non-visible label (e.g. "##hello") then you can use the space to draw other text or image.
6487: // But you need to make sure the ID is unique, e.g. enclose calls in PushID/PopID or use ##unique_id.
6488: // With this scheme, ImGuiSelectableFlags_SpanAllColumns and ImGuiSelectableFlags_AllowOverlap are also frequently used flags.
6489: // FIXME: Selectable() with (size.x == 0.0f) and (SelectableTextAlign.x > 0.0f) followed by SameLine() is currently not supported.
6490: bool ImGui::Selectable(const char* label, bool selected, ImGuiSelectableFlags flags, const ImVec2& size_arg)
6491: {
6492:     ImGuiWindow* window = GetCurrentWindow();
6493:     if (window->SkipItems)
6494:         return false;
6495:     ImGuiContext& g = *GImGui;
6496:     const ImGuiStyle& style = g.Style;
6497:     // Submit label or explicit size to ItemSize(), whereas ItemAdd() will submit a larger/spanning rectangle.
6498:     ImGuiID id = window->GetID(label);
6499:     ImVec2 label_size = CalcTextSize(label, NULL, true);
6500:     ImVec2 size(size_arg.x != 0.0f ? size_arg.x : label_size.x, size_arg.y != 0.0f ? size_arg.y : label_size.y);
6501:     ImVec2 pos = window->DC.CursorPos;
6502:     pos.y += window->DC.CurrLineTextBaseOffset;
6503:     ItemSize(size, 0.0f);
6504:     // Fill horizontal space
6505:     // We don't support (size < 0.0f) in Selectable() because the ItemSpacing extension would make explicitly right-aligned sizes not visibly match other widgets.
6506:     const bool span_all_columns = (flags & ImGuiSelectableFlags_SpanAllColumns) != 0;
6507:     const float min_x = span_all_columns ? window->ParentWorkRect.Min.x : pos.x;
6508:     const float max_x = span_all_columns ? window->ParentWorkRect.Max.x : window->WorkRect.Max.x;
6509:     if (size_arg.x == 0.0f || (flags & ImGuiSelectableFlags_SpanAvailWidth))
6510:         size.x = ImMax(label_size.x, max_x - min_x);
6511:     // Selectables are meant to be tightly packed together with no click-gap, so we extend their box to cover spacing between selectable.
6512:     // FIXME: Not part of layout so not included in clipper calculation, but ItemSize currently doesn't allow offsetting CursorPos.
6513:     ImRect bb(min_x, pos.y, min_x + size.x, pos.y + size.y);
6514:     if ((flags & ImGuiSelectableFlags_NoPadWithHalfSpacing) == 0)
6515:     {
6516:         const float spacing_x = span_all_columns ? 0.0f : style.ItemSpacing.x;
6517:         const float spacing_y = style.ItemSpacing.y;
6518:         const float spacing_L = IM_TRUNC(spacing_x * 0.50f);
6519:         const float spacing_U = IM_TRUNC(spacing_y * 0.50f);
6520:         bb.Min.x -= spacing_L;
6521:         bb.Min.y -= spacing_U;
6522:         bb.Max.x += (spacing_x - spacing_L);
6523:         bb.Max.y += (spacing_y - spacing_U);
6524:     }
6525:     //if (g.IO.KeyCtrl) { GetForegroundDrawList()->AddRect(bb.Min, bb.Max, IM_COL32(0, 255, 0, 255)); }
6526:     const bool disabled_item = (flags & ImGuiSelectableFlags_Disabled) != 0;
6527:     const ImGuiItemFlags extra_item_flags = disabled_item ? (ImGuiItemFlags)ImGuiItemFlags_Disabled : ImGuiItemFlags_None;
6528:     bool is_visible;
6529:     if (span_all_columns)
6530:     {
6531:         // Modify ClipRect for the ItemAdd(), faster than doing a PushColumnsBackground/PushTableBackgroundChannel for every Selectable..
6532:         const float backup_clip_rect_min_x = window->ClipRect.Min.x;
6533:         const float backup_clip_rect_max_x = window->ClipRect.Max.x;
6534:         window->ClipRect.Min.x = window->ParentWorkRect.Min.x;
6535:         window->ClipRect.Max.x = window->ParentWorkRect.Max.x;
6536:         is_visible = ItemAdd(bb, id, NULL, extra_item_flags);
6537:         window->ClipRect.Min.x = backup_clip_rect_min_x;
6538:         window->ClipRect.Max.x = backup_clip_rect_max_x;
6539:     }
6540:     else
6541:     {
6542:         is_visible = ItemAdd(bb, id, NULL, extra_item_flags);
6543:     }
6544:     const bool is_multi_select = (g.LastItemData.ItemFlags & ImGuiItemFlags_IsMultiSelect) != 0;
6545:     if (!is_visible)
6546:         if (!is_multi_select || !g.BoxSelectState.UnclipMode || !g.BoxSelectState.UnclipRect.Overlaps(bb)) // Extra layer of "no logic clip" for box-select support (would be more overhead to add to ItemAdd)
6547:             return false;
6548:     const bool disabled_global = (g.CurrentItemFlags & ImGuiItemFlags_Disabled) != 0;
6549:     if (disabled_item && !disabled_global) // Only testing this as an optimization
6550:         BeginDisabled();
6551:     // FIXME: We can standardize the behavior of those two, we could also keep the fast path of override ClipRect + full push on render only,
6552:     // which would be advantageous since most selectable are not selected.
6553:     if (span_all_columns)
6554:     {
6555:         if (g.CurrentTable)
6556:             TablePushBackgroundChannel();
6557:         else if (window->DC.CurrentColumns)
6558:             PushColumnsBackground();
6559:         g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_HasClipRect;
6560:         g.LastItemData.ClipRect = window->ClipRect;
6561:     }
6562:     // We use NoHoldingActiveID on menus so user can click and _hold_ on a menu then drag to browse child entries
6563:     ImGuiButtonFlags button_flags = 0;
6564:     if (flags & ImGuiSelectableFlags_NoHoldingActiveID) { button_flags |= ImGuiButtonFlags_NoHoldingActiveId; }
6565:     if (flags & ImGuiSelectableFlags_NoSetKeyOwner)     { button_flags |= ImGuiButtonFlags_NoSetKeyOwner; }
6566:     if (flags & ImGuiSelectableFlags_SelectOnClick)     { button_flags |= ImGuiButtonFlags_PressedOnClick; }
6567:     if (flags & ImGuiSelectableFlags_SelectOnRelease)   { button_flags |= ImGuiButtonFlags_PressedOnRelease; }
6568:     if (flags & ImGuiSelectableFlags_AllowDoubleClick)  { button_flags |= ImGuiButtonFlags_PressedOnClickRelease | ImGuiButtonFlags_PressedOnDoubleClick; }
6569:     if ((flags & ImGuiSelectableFlags_AllowOverlap) || (g.LastItemData.ItemFlags & ImGuiItemFlags_AllowOverlap)) { button_flags |= ImGuiButtonFlags_AllowOverlap; }
6570:     // Multi-selection support (header)
6571:     const bool was_selected = selected;
6572:     if (is_multi_select)
6573:     {
6574:         // Handle multi-select + alter button flags for it
6575:         MultiSelectItemHeader(id, &selected, &button_flags);
6576:     }
6577:     bool hovered, held;
6578:     bool pressed = ButtonBehavior(bb, id, &hovered, &held, button_flags);
6579:     bool auto_selected = false;
6580:     // Multi-selection support (footer)
6581:     if (is_multi_select)
6582:     {
6583:         MultiSelectItemFooter(id, &selected, &pressed);
6584:     }
6585:     else
6586:     {
6587:         // Auto-select when moved into
6588:         // - This will be more fully fleshed in the range-select branch
6589:         // - This is not exposed as it won't nicely work with some user side handling of shift/control
6590:         // - We cannot do 'if (g.NavJustMovedToId != id) { selected = false; pressed = was_selected; }' for two reasons
6591:         //   - (1) it would require focus scope to be set, need exposing PushFocusScope() or equivalent (e.g. BeginSelection() calling PushFocusScope())
6592:         //   - (2) usage will fail with clipped items
6593:         //   The multi-select API aim to fix those issues, e.g. may be replaced with a BeginSelection() API.
6594:         if ((flags & ImGuiSelectableFlags_SelectOnNav) && g.NavJustMovedToId != 0 && g.NavJustMovedToFocusScopeId == g.CurrentFocusScopeId)
6595:             if (g.NavJustMovedToId == id && (g.NavJustMovedToKeyMods & ImGuiMod_Ctrl) == 0)
6596:                 selected = pressed = auto_selected = true;
6597:     }
6598:     // Update NavId when clicking or when Hovering (this doesn't happen on most widgets), so navigation can be resumed with keyboard/gamepad
6599:     if (pressed || (hovered && (flags & ImGuiSelectableFlags_SetNavIdOnHover)))
6600:     {
6601:         if (!g.NavHighlightItemUnderNav && g.NavWindow == window && g.NavLayer == window->DC.NavLayerCurrent)
6602:         {
6603:             SetNavID(id, window->DC.NavLayerCurrent, g.CurrentFocusScopeId, WindowRectAbsToRel(window, bb)); // (bb == NavRect)
6604:             if (g.IO.ConfigNavCursorVisibleAuto)
6605:                 g.NavCursorVisible = false;
6606:         }
6607:     }
6608:     if (pressed)
6609:         MarkItemEdited(id);
6610:     if (selected != was_selected)
6611:         g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_ToggledSelection;
6612:     // Render
6613:     if (is_visible)
6614:     {
6615:         const bool highlighted = hovered || (flags & ImGuiSelectableFlags_Highlight);
6616:         if (highlighted || selected)
6617:         {
6618:             // Between 1.91.0 and 1.91.4 we made selected Selectable use an arbitrary lerp between _Header and _HeaderHovered. Removed that now. (#8106)
6619:             ImU32 col = GetColorU32((held && highlighted) ? ImGuiCol_HeaderActive : highlighted ? ImGuiCol_HeaderHovered : ImGuiCol_Header);
6620:             RenderFrame(bb.Min, bb.Max, col, false, 0.0f);
6621:         }
6622:         if (g.NavId == id)
6623:         {
6624:             ImGuiNavRenderCursorFlags nav_render_cursor_flags = ImGuiNavRenderCursorFlags_Compact | ImGuiNavRenderCursorFlags_NoRounding;
6625:             if (is_multi_select)
6626:                 nav_render_cursor_flags |= ImGuiNavRenderCursorFlags_AlwaysDraw; // Always show the nav rectangle
6627:             RenderNavCursor(bb, id, nav_render_cursor_flags);
6628:         }
6629:     }
6630:     if (span_all_columns)
6631:     {
6632:         if (g.CurrentTable)
6633:             TablePopBackgroundChannel();
6634:         else if (window->DC.CurrentColumns)
6635:             PopColumnsBackground();
6636:     }
6637:     // Text stays at the submission position. Alignment/clipping extents ignore SpanAllColumns.
6638:     if (is_visible)
6639:         RenderTextClipped(pos, ImVec2(ImMin(pos.x + size.x, window->WorkRect.Max.x), pos.y + size.y), label, NULL, &label_size, style.SelectableTextAlign, &bb);
6640:     // Automatically close popups
6641:     if (pressed && !auto_selected && (window->Flags & ImGuiWindowFlags_Popup) && !(flags & ImGuiSelectableFlags_NoAutoClosePopups) && (g.LastItemData.ItemFlags & ImGuiItemFlags_AutoClosePopups))
6642:         CloseCurrentPopup();
6643:     if (disabled_item && !disabled_global)
6644:         EndDisabled();
6645:     // Selectable() always returns a pressed state!
6646:     // Users of BeginMultiSelect()/EndMultiSelect() scope: you may call ImGui::IsItemToggledSelection() to retrieve
6647:     // selection toggle, only useful if you need that state updated (e.g. for rendering purpose) before reaching EndMultiSelect().
6648:     IMGUI_TEST_ENGINE_ITEM_INFO(id, label, g.LastItemData.StatusFlags);
6649:     return pressed; //-V1020
6650: }
