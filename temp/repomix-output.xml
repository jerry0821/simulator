 4726: void ImGui::UpdateMouseMovingWindowEndFrame()
 4727: {
 4728:     ImGuiContext& g = *GImGui;
 4729:     if (g.ActiveId != 0 || (g.HoveredId != 0 && !g.HoveredIdIsDisabled))
 4730:         return;
 4731:     // Unless we just made a window/popup appear
 4732:     if (g.NavWindow && g.NavWindow->Appearing)
 4733:         return;
 4734:     ImGuiWindow* hovered_window = g.HoveredWindow;
 4735:     // Click on empty space to focus window and start moving
 4736:     // (after we're done with all our widgets)
 4737:     if (g.IO.MouseClicked[0])
 4738:     {
 4739:         // Handle the edge case of a popup being closed while clicking in its empty space.
 4740:         // If we try to focus it, FocusWindow() > ClosePopupsOverWindow() will accidentally close any parent popups because they are not linked together any more.
 4741:         ImGuiWindow* hovered_root = hovered_window ? hovered_window->RootWindow : NULL;
 4742:         const bool is_closed_popup = hovered_root && (hovered_root->Flags & ImGuiWindowFlags_Popup) && !IsPopupOpen(hovered_root->PopupId, ImGuiPopupFlags_AnyPopupLevel);
 4743:         if (hovered_window != NULL && !is_closed_popup)
 4744:         {
 4745:             StartMouseMovingWindow(hovered_window); //-V595
 4746:             // FIXME: In principle we might be able to call StopMouseMovingWindow() below.
 4747:             // Please note how StartMouseMovingWindow() and StopMouseMovingWindow() and not entirely symetrical, at the later doesn't clear ActiveId.
 4748:             // Cancel moving if clicked outside of title bar
 4749:             if ((hovered_window->BgClickFlags & ImGuiWindowBgClickFlags_Move) == 0) // set by io.ConfigWindowsMoveFromTitleBarOnly
 4750:                 if (!(hovered_root->Flags & ImGuiWindowFlags_NoTitleBar))
 4751:                     if (!hovered_root->TitleBarRect().Contains(g.IO.MouseClickedPos[0]))
 4752:                         g.MovingWindow = NULL;
 4753:             // Cancel moving if clicked over an item which was disabled or inhibited by popups
 4754:             // (when g.HoveredIdIsDisabled == true && g.HoveredId == 0 we are inhibited by popups, when g.HoveredIdIsDisabled == true && g.HoveredId != 0 we are over a disabled item)
 4755:             if (g.HoveredIdIsDisabled)
 4756:             {
 4757:                 g.MovingWindow = NULL;
 4758:                 g.ActiveIdDisabledId = g.HoveredId;
 4759:             }
 4760:         }
 4761:         else if (hovered_window == NULL && g.NavWindow != NULL)
 4762:         {
 4763:             // Clicking on void disable focus
 4764:             FocusWindow(NULL, ImGuiFocusRequestFlags_UnlessBelowModal);
 4765:         }
 4766:     }
 4767:     // With right mouse button we close popups without changing focus based on where the mouse is aimed
 4768:     // Instead, focus will be restored to the window under the bottom-most closed popup.
 4769:     // (The left mouse button path calls FocusWindow on the hovered window, which will lead NewFrame->ClosePopupsOverWindow to trigger)
 4770:     if (g.IO.MouseClicked[1] && g.HoveredId == 0)
 4771:     {
 4772:         // Find the top-most window between HoveredWindow and the top-most Modal Window.
 4773:         // This is where we can trim the popup stack.
 4774:         ImGuiWindow* modal = GetTopMostPopupModal();
 4775:         bool hovered_window_above_modal = hovered_window && (modal == NULL || IsWindowAbove(hovered_window, modal));
 4776:         ClosePopupsOverWindow(hovered_window_above_modal ? hovered_window : modal, true);
 4777:     }
 4778: }
