 1498: // UTF16 strings use surrogate pairs to encode codepoints >= 0x10000, so
 1499: // we should save the high surrogate.
 1500: void ImGuiIO::AddInputCharacterUTF16(ImWchar16 c)
 1501: {
 1502:     if ((c == 0 && InputQueueSurrogate == 0) || !AppAcceptingEvents)
 1503:         return;
 1504:     if ((c & 0xFC00) == 0xD800) // High surrogate, must save
 1505:     {
 1506:         if (InputQueueSurrogate != 0)
 1507:             AddInputCharacter(IM_UNICODE_CODEPOINT_INVALID);
 1508:         InputQueueSurrogate = c;
 1509:         return;
 1510:     }
 1511:     ImWchar cp = c;
 1512:     if (InputQueueSurrogate != 0)
 1513:     {
 1514:         if ((c & 0xFC00) != 0xDC00) // Invalid low surrogate
 1515:         {
 1516:             AddInputCharacter(IM_UNICODE_CODEPOINT_INVALID);
 1517:         }
 1518:         else
 1519:         {
 1520: #if IM_UNICODE_CODEPOINT_MAX == 0xFFFF
 1521:             cp = IM_UNICODE_CODEPOINT_INVALID; // Codepoint will not fit in ImWchar
 1522: #else
 1523:             cp = (ImWchar)(((InputQueueSurrogate - 0xD800) << 10) + (c - 0xDC00) + 0x10000);
 1524: #endif
 1525:         }
 1526:         InputQueueSurrogate = 0;
 1527:     }
 1528:     AddInputCharacter((unsigned)cp);
 1529: }
