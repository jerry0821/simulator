4682: // Find glyph, load if necessary, return fallback if missing
4683: ImFontGlyph* ImFontBaked::FindGlyph(ImWchar c)
4684: {
4685:     if (c < (size_t)IndexLookup.Size) IM_LIKELY
4686:     {
4687:         const int i = (int)IndexLookup.Data[c];
4688:         if (i == IM_FONTGLYPH_INDEX_NOT_FOUND)
4689:             return &Glyphs.Data[FallbackGlyphIndex];
4690:         if (i != IM_FONTGLYPH_INDEX_UNUSED)
4691:             return &Glyphs.Data[i];
4692:     }
4693:     ImFontGlyph* glyph = ImFontBaked_BuildLoadGlyph(this, c, NULL);
4694:     return glyph ? glyph : &Glyphs.Data[FallbackGlyphIndex];
4695: }
4696: // Attempt to load but when missing, return NULL instead of FallbackGlyph
4697: ImFontGlyph* ImFontBaked::FindGlyphNoFallback(ImWchar c)
4698: {
4699:     if (c < (size_t)IndexLookup.Size) IM_LIKELY
4700:     {
4701:         const int i = (int)IndexLookup.Data[c];
4702:         if (i == IM_FONTGLYPH_INDEX_NOT_FOUND)
4703:             return NULL;
4704:         if (i != IM_FONTGLYPH_INDEX_UNUSED)
4705:             return &Glyphs.Data[i];
4706:     }
4707:     LoadNoFallback = true; // This is actually a rare call, not done in hot-loop, so we prioritize not adding extra cruft to ImFontBaked_BuildLoadGlyph() call sites.
4708:     ImFontGlyph* glyph = ImFontBaked_BuildLoadGlyph(this, c, NULL);
4709:     LoadNoFallback = false;
4710:     return glyph;
4711: }
4712: bool ImFontBaked::IsGlyphLoaded(ImWchar c)
4713: {
4714:     if (c < (size_t)IndexLookup.Size) IM_LIKELY
4715:     {
4716:         const int i = (int)IndexLookup.Data[c];
4717:         if (i == IM_FONTGLYPH_INDEX_NOT_FOUND)
4718:             return false;
4719:         if (i != IM_FONTGLYPH_INDEX_UNUSED)
4720:             return true;
4721:     }
4722:     return false;
4723: }
4724: // This is not fast query
4725: bool ImFont::IsGlyphInFont(ImWchar c)
4726: {
4727:     ImFontAtlas* atlas = OwnerAtlas;
4728:     ImFontAtlas_FontHookRemapCodepoint(atlas, this, &c);
4729:     for (ImFontConfig* src : Sources)
4730:     {
4731:         const ImFontLoader* loader = src->FontLoader ? src->FontLoader : atlas->FontLoader;
4732:         if (loader->FontSrcContainsGlyph != NULL && loader->FontSrcContainsGlyph(atlas, src, c))
4733:             return true;
4734:     }
4735:     return false;
4736: }
