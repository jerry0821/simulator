3146: enum ImTextureStatus
3147: {
3148:     ImTextureStatus_OK,
3149:     ImTextureStatus_Destroyed,      // Backend destroyed the texture.
3150:     ImTextureStatus_WantCreate,     // Requesting backend to create the texture. Set status OK when done.
3151:     ImTextureStatus_WantUpdates,    // Requesting backend to update specific blocks of pixels (write to texture portions which have never been used before). Set status OK when done.
3152:     ImTextureStatus_WantDestroy,    // Requesting backend to destroy the texture. Set status to Destroyed when done.
3153: };
