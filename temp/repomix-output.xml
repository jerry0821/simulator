3536: void ImFontAtlasUpdateDrawListsSharedData(ImFontAtlas* atlas)
3537: {
3538:     for (ImDrawListSharedData* shared_data : atlas->DrawListSharedDatas)
3539:         if (shared_data->FontAtlas == atlas)
3540:         {
3541:             shared_data->TexUvWhitePixel = atlas->TexUvWhitePixel;
3542:             shared_data->TexUvLines = atlas->TexUvLines;
3543:         }
3544: }
3545: // Set current texture. This is mostly called from AddTexture() + to handle a failed resize.
3546: static void ImFontAtlasBuildSetTexture(ImFontAtlas* atlas, ImTextureData* tex)
3547: {
3548:     ImTextureRef old_tex_ref = atlas->TexRef;
3549:     atlas->TexData = tex;
3550:     atlas->TexUvScale = ImVec2(1.0f / tex->Width, 1.0f / tex->Height);
3551:     atlas->TexRef._TexData = tex;
3552:     //atlas->TexRef._TexID = tex->TexID; // <-- We intentionally don't do that. It would be misleading and betray promise that both fields aren't set.
3553:     ImFontAtlasUpdateDrawListsTextures(atlas, old_tex_ref, atlas->TexRef);
3554: }
