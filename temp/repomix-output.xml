2523: // Helper: Key->Value storage
2524: // Typically you don't have to worry about this since a storage is held within each Window.
2525: // We use it to e.g. store collapse state for a tree (Int 0/1)
2526: // This is optimized for efficient lookup (dichotomy into a contiguous buffer) and rare insertion (typically tied to user interactions aka max once a frame)
2527: // You can use it as custom user storage for temporary values. Declare your own storage if, for example:
2528: // - You want to manipulate the open/close state of a particular sub-tree in your interface (tree node uses Int 0/1 to store their state).
2529: // - You want to store custom debug data easily without adding or editing structures in your code (probably not efficient, but convenient)
2530: // Types are NOT stored, so it is up to you to make sure your Key don't collide with different types.
2531: struct ImGuiStorage
2532: {
2533:     // [Internal]
2534:     ImVector<ImGuiStoragePair>      Data;
2535:     // - Get***() functions find pair, never add/allocate. Pairs are sorted so a query is O(log N)
2536:     // - Set***() functions find pair, insertion on demand if missing.
2537:     // - Sorted insertion is costly, paid once. A typical frame shouldn't need to insert any new pair.
2538:     void                Clear() { Data.clear(); }
2539:     IMGUI_API int       GetInt(ImGuiID key, int default_val = 0) const;
2540:     IMGUI_API void      SetInt(ImGuiID key, int val);
2541:     IMGUI_API bool      GetBool(ImGuiID key, bool default_val = false) const;
2542:     IMGUI_API void      SetBool(ImGuiID key, bool val);
2543:     IMGUI_API float     GetFloat(ImGuiID key, float default_val = 0.0f) const;
2544:     IMGUI_API void      SetFloat(ImGuiID key, float val);
2545:     IMGUI_API void*     GetVoidPtr(ImGuiID key) const; // default_val is NULL
2546:     IMGUI_API void      SetVoidPtr(ImGuiID key, void* val);
2547:     // - Get***Ref() functions finds pair, insert on demand if missing, return pointer. Useful if you intend to do Get+Set.
2548:     // - References are only valid until a new value is added to the storage. Calling a Set***() function or a Get***Ref() function invalidates the pointer.
2549:     // - A typical use case where this is convenient for quick hacking (e.g. add storage during a live Edit&Continue session if you can't modify existing struct)
2550:     //      float* pvar = ImGui::GetFloatRef(key); ImGui::SliderFloat("var", pvar, 0, 100.0f); some_var += *pvar;
2551:     IMGUI_API int*      GetIntRef(ImGuiID key, int default_val = 0);
2552:     IMGUI_API bool*     GetBoolRef(ImGuiID key, bool default_val = false);
2553:     IMGUI_API float*    GetFloatRef(ImGuiID key, float default_val = 0.0f);
2554:     IMGUI_API void**    GetVoidPtrRef(ImGuiID key, void* default_val = NULL);
2555:     // Advanced: for quicker full rebuild of a storage (instead of an incremental one), you may add all your contents and then sort once.
2556:     IMGUI_API void      BuildSortByKey();
2557:     // Obsolete: use on your own storage if you know only integer are being stored (open/close all tree nodes)
2558:     IMGUI_API void      SetAllInt(int val);
2559: #ifndef IMGUI_DISABLE_OBSOLETE_FUNCTIONS
2560:     //typedef ::ImGuiStoragePair ImGuiStoragePair;  // 1.90.8: moved type outside struct
2561: #endif
2562: };
