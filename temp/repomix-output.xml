 744: // [SECTION] ImDrawList support
 745: //-----------------------------------------------------------------------------
 746: // ImDrawList: Helper function to calculate a circle's segment count given its radius and a "maximum error" value.
 747: // Estimation of number of circle segment based on error is derived using method described in https://stackoverflow.com/a/2244088/15194693
 748: // Number of segments (N) is calculated using equation:
 749: //   N = ceil ( pi / acos(1 - error / r) )     where r > 0, error <= r
 750: // Our equation is significantly simpler that one in the post thanks for choosing segment that is
 751: // perpendicular to X axis. Follow steps in the article from this starting condition and you will
 752: // will get this result.
 753: //
 754: // Rendering circles with an odd number of segments, while mathematically correct will produce
 755: // asymmetrical results on the raster grid. Therefore we're rounding N to next even number (7->8, 8->8, 9->10 etc.)
 756: #define IM_ROUNDUP_TO_EVEN(_V)                                  ((((_V) + 1) / 2) * 2)
 757: #define IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_MIN                     4
 758: #define IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_MAX                     512
 759: #define IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_CALC(_RAD,_MAXERROR)    ImClamp(IM_ROUNDUP_TO_EVEN((int)ImCeil(IM_PI / ImAcos(1 - ImMin((_MAXERROR), (_RAD)) / (_RAD)))), IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_MIN, IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_MAX)
 760: // Raw equation from IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_CALC rewritten for 'r' and 'error'.
 761: #define IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_CALC_R(_N,_MAXERROR)    ((_MAXERROR) / (1 - ImCos(IM_PI / ImMax((float)(_N), IM_PI))))
 762: #define IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_CALC_ERROR(_N,_RAD)     ((1 - ImCos(IM_PI / ImMax((float)(_N), IM_PI))) / (_RAD))
 763: // ImDrawList: Lookup table size for adaptive arc drawing, cover full circle.
 764: #ifndef IM_DRAWLIST_ARCFAST_TABLE_SIZE
 765: #define IM_DRAWLIST_ARCFAST_TABLE_SIZE                          48 // Number of samples in lookup table.
 766: #endif
 767: #define IM_DRAWLIST_ARCFAST_SAMPLE_MAX                          IM_DRAWLIST_ARCFAST_TABLE_SIZE // Sample index _PathArcToFastEx() for 360 angle.
 768: // Data shared between all ImDrawList instances
 769: // Conceptually this could have been called e.g. ImDrawListSharedContext
 770: // Typically one ImGui context would create and maintain one of this.
 771: // You may want to create your own instance of you try to ImDrawList completely without ImGui. In that case, watch out for future changes to this structure.
 772: struct IMGUI_API ImDrawListSharedData
 773: {
 774:     ImVec2          TexUvWhitePixel;            // UV of white pixel in the atlas (== FontAtlas->TexUvWhitePixel)
 775:     const ImVec4*   TexUvLines;                 // UV of anti-aliased lines in the atlas (== FontAtlas->TexUvLines)
 776:     ImFontAtlas*    FontAtlas;                  // Current font atlas
 777:     ImFont*         Font;                       // Current font (used for simplified AddText overload)
 778:     float           FontSize;                   // Current font size (used for for simplified AddText overload)
 779:     float           FontScale;                  // Current font scale (== FontSize / Font->FontSize)
 780:     float           CurveTessellationTol;       // Tessellation tolerance when using PathBezierCurveTo()
 781:     float           CircleSegmentMaxError;      // Number of circle segments to use per pixel of radius for AddCircle() etc
 782:     float           InitialFringeScale;         // Initial scale to apply to AA fringe
 783:     ImDrawListFlags InitialFlags;               // Initial flags at the beginning of the frame (it is possible to alter flags on a per-drawlist basis afterwards)
 784:     ImVec4          ClipRectFullscreen;         // Value for PushClipRectFullscreen()
 785:     ImVector<ImVec2> TempBuffer;                // Temporary write buffer
 786:     ImVector<ImDrawList*> DrawLists;            // All draw lists associated to this ImDrawListSharedData
 787:     ImGuiContext*   Context;                    // [OPTIONAL] Link to Dear ImGui context. 99% of ImDrawList/ImFontAtlas can function without an ImGui context, but this facilitate handling one legacy edge case.
 788:     // Lookup tables
 789:     ImVec2          ArcFastVtx[IM_DRAWLIST_ARCFAST_TABLE_SIZE]; // Sample points on the quarter of the circle.
 790:     float           ArcFastRadiusCutoff;                        // Cutoff radius after which arc drawing will fallback to slower PathArcTo()
 791:     ImU8            CircleSegmentCounts[64];    // Precomputed segment count for given radius before we calculate it dynamically (to avoid calculation overhead)
 792:     ImDrawListSharedData();
 793:     ~ImDrawListSharedData();
 794:     void SetCircleTessellationMaxError(float max_error);
 795: };
