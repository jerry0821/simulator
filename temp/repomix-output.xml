881:     ID3D11ShaderResourceView** textureView) noexcept
882: {
883:     if (texture)
884:     {
885:         *texture = nullptr;
886:     }
887:     if (textureView)
888:     {
889:         *textureView = nullptr;
890:     }
891:     if (!d3dDevice || !fileName || (!texture && !textureView))
892:     {
893:         return E_INVALIDARG;
894:     }
895:     if (textureView && !(bindFlags & D3D11_BIND_SHADER_RESOURCE))
896:     {
897:         return E_INVALIDARG;
898:     }
899:     auto pWIC = GetWIC();
900:     if (!pWIC)
901:         return E_NOINTERFACE;
902:     // Initialize WIC
903:     ComPtr<IWICBitmapDecoder> decoder;
904:     HRESULT hr = pWIC->CreateDecoderFromFilename(fileName,
905:         nullptr,
906:         GENERIC_READ,
907:         WICDecodeMetadataCacheOnDemand,
908:         decoder.GetAddressOf());
909:     if (FAILED(hr))
910:         return hr;
911:     ComPtr<IWICBitmapFrameDecode> frame;
912:     hr = decoder->GetFrame(0, frame.GetAddressOf());
913:     if (FAILED(hr))
914:         return hr;
915:     hr = CreateTextureFromWIC(d3dDevice, d3dContext,
916:         frame.Get(),
917:         maxsize,
918:         usage, bindFlags, cpuAccessFlags, miscFlags,
919:         loadFlags,
920:         texture, textureView);
921:     if (SUCCEEDED(hr))
922:     {
923:         SetDebugTextureInfo(fileName, texture, textureView);
924:     }
925:     return hr;
926: }
