 2516: // Convert rgb floats ([0-1],[0-1],[0-1]) to hsv floats ([0-1],[0-1],[0-1]), from Foley & van Dam p592
 2517: // Optimized http://lolengine.net/blog/2013/01/13/fast-rgb-to-hsv
 2518: void ImGui::ColorConvertRGBtoHSV(float r, float g, float b, float& out_h, float& out_s, float& out_v)
 2519: {
 2520:     float K = 0.f;
 2521:     if (g < b)
 2522:     {
 2523:         ImSwap(g, b);
 2524:         K = -1.f;
 2525:     }
 2526:     if (r < g)
 2527:     {
 2528:         ImSwap(r, g);
 2529:         K = -2.f / 6.f - K;
 2530:     }
 2531:     const float chroma = r - (g < b ? g : b);
 2532:     out_h = ImFabs(K + (g - b) / (6.f * chroma + 1e-20f));
 2533:     out_s = chroma / (r + 1e-20f);
 2534:     out_v = r;
 2535: }
 2536: // Convert hsv floats ([0-1],[0-1],[0-1]) to rgb floats ([0-1],[0-1],[0-1]), from Foley & van Dam p593
 2537: // also http://en.wikipedia.org/wiki/HSL_and_HSV
 2538: void ImGui::ColorConvertHSVtoRGB(float h, float s, float v, float& out_r, float& out_g, float& out_b)
 2539: {
 2540:     if (s == 0.0f)
 2541:     {
 2542:         // gray
 2543:         out_r = out_g = out_b = v;
 2544:         return;
 2545:     }
 2546:     h = ImFmod(h, 1.0f) / (60.0f / 360.0f);
 2547:     int   i = (int)h;
 2548:     float f = h - (float)i;
 2549:     float p = v * (1.0f - s);
 2550:     float q = v * (1.0f - s * f);
 2551:     float t = v * (1.0f - s * (1.0f - f));
 2552:     switch (i)
 2553:     {
 2554:     case 0: out_r = v; out_g = t; out_b = p; break;
 2555:     case 1: out_r = q; out_g = v; out_b = p; break;
 2556:     case 2: out_r = p; out_g = v; out_b = t; break;
 2557:     case 3: out_r = p; out_g = q; out_b = v; break;
 2558:     case 4: out_r = t; out_g = p; out_b = v; break;
 2559:     case 5: default: out_r = v; out_g = p; out_b = q; break;
 2560:     }
 2561: }
