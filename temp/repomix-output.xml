8000:     Widths[1] = ImMax(Widths[1], (ImU16)w_label);
8001:     Widths[2] = ImMax(Widths[2], (ImU16)w_shortcut);
8002:     Widths[3] = ImMax(Widths[3], (ImU16)w_mark);
8003:     CalcNextTotalWidth(false);
8004:     return (float)ImMax(TotalWidth, NextTotalWidth);
