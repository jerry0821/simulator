<file path="shader_pixel_toon.hlsl">
 1: Texture2D MainTex : register(t0);
 2: SamplerState Sampler : register(s0);
 3: 
 4: cbuffer CB_PS : register(b0)
 5: {
 6:     float4 materialColor;
 7:     float4 outlineColor;
 8:     int stepCount;
 9:     float3 padding_ps; 
10: };
11: 
12: cbuffer CB_AMBIENT : register(b1)
13: {
14:     float4 ambient_color;
15: };
16: 
17: cbuffer CB_DIRECTIONAL : register(b2)
18: {
19:     float4 directional_world_vector;
20:     float4 directional_color;
21: };
22: 
23: cbuffer CB_SPECULAR : register(b3)
24: {
25:     float3 eye_posW;
26:     float specular_power;
27:     float4 specular_color;
28: };
29: 
30: struct PS_INPUT
31: {
32:     float4 posH : SV_POSITION;
33:     float4 posW : POSITION;
34:     float4 normal : NORMAL;
35:     float4 color : COLOR;
36:     float2 uv : TEXCOORD;
37: };
38: 
39: float4 main(PS_INPUT input) : SV_TARGET
40: {
41:     float4 texColor = MainTex.Sample(Sampler, input.uv);
42:     float3 n = normalize(input.normal.xyz);
43:     float3 l = normalize(-directional_world_vector.xyz);
44: 
45:     float NdotL = dot(n, l);
46:     float threshold = 0.0;
47:     float intensity = floor((NdotL + threshold) * stepCount) / max(stepCount - 1, 1);
48:     intensity = clamp(intensity, 0.25, 1.0);
49: 
50:     //float3 v = normalize(float3(0.0, 0.5, 1.0));
51:     //float3 h = normalize(l + v);
52:     //float NdotH = max(dot(n, l), 0.0);
53:     
54:     float3 viewDir = normalize(eye_posW - input.posW.xyz); 
55: 
56:     float3 halfVector = normalize(l + viewDir);
57: 
58:     float NdotH = max(dot(n, halfVector), 0.0);
59: 
60:     // specŒvŽZ
61:     float specFactor = pow(NdotH, max(1.0, specular_power));
62:     float toonSpec = smoothstep(0.5, 0.52, specFactor);
63: 
64:     float3 diffuse = texColor.rgb * materialColor.rgb * directional_color.rgb * intensity;
65:     float3 ambient = texColor.rgb * ambient_color.rgb;
66:     float3 specular = specular_color.rgb * toonSpec;
67:     float specularIntensity = input.color.g == 0 ? 0 : pow(NdotH, input.color.g * 500);
68: 
69:     float3 finalColor = diffuse + ambient + specularIntensity;
70:     return float4(finalColor, texColor.a);
71: }
</file>

<file path="shader_vertex_field.hlsl">
 1: /*==============================================================================
