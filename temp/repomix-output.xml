 940:                float dx = STB_TEXTEDIT_GETWIDTH(str, find.prev_first, i);
 941:                int next = IMSTB_TEXTEDIT_GETNEXTCHARINDEX(str, state->cursor);
 942:                #ifdef IMSTB_TEXTEDIT_GETWIDTH_NEWLINE
 943:                if (dx == IMSTB_TEXTEDIT_GETWIDTH_NEWLINE)
