 2854: static void ImGuiListClipper_SortAndFuseRanges(ImVector<ImGuiListClipperRange>& ranges, int offset = 0)
 2855: {
 2856:     if (ranges.Size - offset <= 1)
 2857:         return;
 2858:     // Helper to order ranges and fuse them together if possible (bubble sort is fine as we are only sorting 2-3 entries)
 2859:     for (int sort_end = ranges.Size - offset - 1; sort_end > 0; --sort_end)
 2860:         for (int i = offset; i < sort_end + offset; ++i)
 2861:             if (ranges[i].Min > ranges[i + 1].Min)
 2862:                 ImSwap(ranges[i], ranges[i + 1]);
 2863:     // Now fuse ranges together as much as possible.
 2864:     for (int i = 1 + offset; i < ranges.Size; i++)
 2865:     {
 2866:         IM_ASSERT(!ranges[i].PosToIndexConvert && !ranges[i - 1].PosToIndexConvert);
 2867:         if (ranges[i - 1].Max < ranges[i].Min)
 2868:             continue;
 2869:         ranges[i - 1].Min = ImMin(ranges[i - 1].Min, ranges[i].Min);
 2870:         ranges[i - 1].Max = ImMax(ranges[i - 1].Max, ranges[i].Max);
 2871:         ranges.erase(ranges.Data + i);
 2872:         i--;
 2873:     }
 2874: }
 2875: static void ImGuiListClipper_SeekCursorAndSetupPrevLine(ImGuiListClipper* clipper, float pos_y, float line_height)
 2876: {
 2877:     // Set cursor position and a few other things so that SetScrollHereY() and Columns() can work when seeking cursor.
 2878:     // FIXME: It is problematic that we have to do that here, because custom/equivalent end-user code would stumble on the same issue.
 2879:     // The clipper should probably have a final step to display the last item in a regular manner, maybe with an opt-out flag for data sets which may have costly seek?
 2880:     ImGuiContext& g = *GImGui;
 2881:     ImGuiWindow* window = g.CurrentWindow;
 2882:     float off_y = pos_y - window->DC.CursorPos.y;
 2883:     window->DC.CursorPos.y = pos_y;
 2884:     window->DC.CursorMaxPos.y = ImMax(window->DC.CursorMaxPos.y, pos_y - g.Style.ItemSpacing.y);
 2885:     window->DC.CursorPosPrevLine.y = window->DC.CursorPos.y - line_height;  // Setting those fields so that SetScrollHereY() can properly function after the end of our clipper usage.
 2886:     window->DC.PrevLineSize.y = (line_height - g.Style.ItemSpacing.y);      // If we end up needing more accurate data (to e.g. use SameLine) we may as well make the clipper have a fourth step to let user process and display the last item in their list.
 2887:     if (ImGuiOldColumns* columns = window->DC.CurrentColumns)
 2888:         columns->LineMinY = window->DC.CursorPos.y;                         // Setting this so that cell Y position are set properly
 2889:     if (ImGuiTable* table = g.CurrentTable)
 2890:     {
 2891:         if (table->IsInsideRow)
 2892:             ImGui::TableEndRow(table);
 2893:         const int row_increase = (int)((off_y / line_height) + 0.5f);
 2894:         if (row_increase > 0 && (clipper->Flags & ImGuiListClipperFlags_NoSetTableRowCounters) == 0) // If your clipper item height is != from actual table row height, consider using ImGuiListClipperFlags_NoSetTableRowCounters. See #8886.
 2895:         {
 2896:             table->CurrentRow += row_increase;
 2897:             table->RowBgColorCounter += row_increase;
 2898:         }
 2899:         table->RowPosY2 = window->DC.CursorPos.y;
