1499: void ImGui::SeparatorTextEx(ImGuiID id, const char* label, const char* label_end, float extra_w)
1500: {
1501:     ImGuiContext& g = *GImGui;
1502:     ImGuiWindow* window = g.CurrentWindow;
1503:     ImGuiStyle& style = g.Style;
1504:     const ImVec2 label_size = CalcTextSize(label, label_end, false);
1505:     const ImVec2 pos = window->DC.CursorPos;
1506:     const ImVec2 padding = style.SeparatorTextPadding;
1507:     const float separator_thickness = style.SeparatorTextBorderSize;
1508:     const ImVec2 min_size(label_size.x + extra_w + padding.x * 2.0f, ImMax(label_size.y + padding.y * 2.0f, separator_thickness));
