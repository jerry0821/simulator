4095: static bool ImGui_ImplStbTrueType_FontSrcInit(ImFontAtlas* atlas, ImFontConfig* src)
4096: {
4097:     IM_UNUSED(atlas);
4098:     ImGui_ImplStbTrueType_FontSrcData* bd_font_data = IM_NEW(ImGui_ImplStbTrueType_FontSrcData);
4099:     IM_ASSERT(src->FontLoaderData == NULL);
4100:     // Initialize helper structure for font loading and verify that the TTF/OTF data is correct
4101:     const int font_offset = stbtt_GetFontOffsetForIndex((const unsigned char*)src->FontData, src->FontNo);
4102:     if (font_offset < 0)
4103:     {
4104:         IM_DELETE(bd_font_data);
4105:         IM_ASSERT_USER_ERROR(0, "stbtt_GetFontOffsetForIndex(): FontData is incorrect, or FontNo cannot be found.");
4106:         return false;
4107:     }
4108:     if (!stbtt_InitFont(&bd_font_data->FontInfo, (const unsigned char*)src->FontData, font_offset))
4109:     {
4110:         IM_DELETE(bd_font_data);
4111:         IM_ASSERT_USER_ERROR(0, "stbtt_InitFont(): failed to parse FontData. It is correct and complete? Check FontDataSize.");
4112:         return false;
4113:     }
4114:     src->FontLoaderData = bd_font_data;
4115:     const float ref_size = src->DstFont->Sources[0]->SizePixels;
4116:     if (src->MergeMode && src->SizePixels == 0.0f)
4117:         src->SizePixels = ref_size;
4118:     bd_font_data->ScaleFactor = stbtt_ScaleForPixelHeight(&bd_font_data->FontInfo, 1.0f);
4119:     if (src->MergeMode && src->SizePixels != 0.0f && ref_size != 0.0f)
4120:         bd_font_data->ScaleFactor *= src->SizePixels / ref_size; // FIXME-NEWATLAS: Should tidy up that a bit
4121:     return true;
4122: }
