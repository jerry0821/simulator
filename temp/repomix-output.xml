  9: 
 10: cbuffer PS_CONSTANT_BUFFER : register(b0)
 11: {
 12:     float4 diffuse_color;
 13: };
 14: 
 15: cbuffer PS_CONSTANT_BUFFER : register(b1)
 16: {
 17:     float4 ambient_color;
 18: };
 19: 
 20: cbuffer PS_CONSTANT_BUFFER : register(b2)
 21: {
 22:     float4 directional_world_vector;
 23:     float4 directional_color;
 24: }
 25: 
 26: cbuffer PS_CONSTANT_BUFFER : register(b3)
 27: {
 28:     float3 eye_posW;
 29:     float  specular_power;
 30:     float4 specular_color;
 31: };
 32: 
 33: struct PS_INPUT
 34: {
 35:     float4 posH : SV_POSITION;
 36:     float4 posW : POSITION0;
 37:     float4 normalW : NORMAL0;
 38:     float4 blend : COLOR0;
 39:     float2 uv : TEXCOORD0;
 40: 
 41:     float4 shadowPos : TEXCOORD1;
 42: };
 43: 
 44: Texture2D tex0 : register(t0); // eNX` dirt
 45: Texture2D tex1 : register(t1); // eNX` grass
 46: 
 47: Texture2D g_ShadowMap : register(t2);
 48: 
 49: SamplerState samp : register(s0); // eNX`łńv
 50: SamplerState shadowSamp : register(s1);
 51: 
 52: float4 CalcTriplanar(Texture2D tex, SamplerState samp, float3 posW, float3 normalW, float scale)
 53: {
 54:     float3 blendWeights = abs(normalW);
 55: 
 56:     blendWeights = pow(blendWeights, 4.0f);
 57: 
 58:     blendWeights = blendWeights / (blendWeights.x + blendWeights.y + blendWeights.z);
 59: 
 60:     //float scale = 1.0f;
 61: 
 62:     float2 uvX = posW.zy * scale;
 63:     float2 uvY = posW.xz * scale;
 64:     float2 uvZ = posW.xy * scale;
 65: 
 66:     float4 colX = tex.Sample(samp, uvX);
 67:     float4 colY = tex.Sample(samp, uvY);
 68:     float4 colZ = tex.Sample(samp, uvZ);
 69: 
 70:     return colX * blendWeights.x + colY * blendWeights.y + colZ * blendWeights.z;
 71: }
 72: 
 73: float4 main(PS_INPUT ps_in) : SV_TARGET
 74: {
 75:     // UVń]
 76:     //float2 uv;
 77:     //float angle = 3.14159f * 45.0f / 180.0f; // 45xń]
 78: 
 79:     //uv.x = cos(angle) * ps_in.uv.x + sin(angle) * ps_in.uv.y;
 80:     //uv.y = -sin(angle) * ps_in.uv.x + cos(angle) * ps_in.uv.y;
 81: 
 82:     float3 N = normalize(ps_in.normalW.xyz);
 83: 
 84:     float4 colorDirt = CalcTriplanar(tex0, samp, ps_in.posW.xyz, N, 1.0f); // triplanar mapping
 85:     float4 colorGrass1 = CalcTriplanar(tex1, samp, ps_in.posW.xyz, N, 0.5f);
 86:     float4 colorGrass2 = CalcTriplanar(tex1, samp, ps_in.posW.xyz, N, 0.05f);
 87: 
 88: 
 89: 
 90:     float4 colorGrass = colorGrass1 * 0.5f + colorGrass2 * 0.5f ;
 91:     //float4 colorDirt = tex0.Sample(samp, ps_in.uv * 20.0f);
 92:     //float4 colorGrass = tex1.Sample(samp, ps_in.uv * 20.0f);
 93: 
 94:     float slope = saturate(N.y);
 95: 
 96:     // ¤p noiseiworld-basedj
 97:     float noise = tex0.Sample(samp, ps_in.posW.xz * 0.1f).r;
 98: 
 99:     float grassMask = smoothstep(0.6f, 0.85f, slope + (noise - 0.5f) * 0.2f);
100: 
101:     float4 tex_color = lerp(colorDirt, colorGrass, grassMask);
102: 
103: 
104:     //float4 tex_color = tex0.Sample(samp, uv) * ps_in.blend.g ;
105: 
106:     // ŢżĚF
107:     float3 material_color = tex_color.rgb * diffuse_color.rgb;
108: 
109: 
110:     float shadowFactor = 1.0f;
111:     float3 sPos = ps_in.shadowPos.xyz / ps_in.shadowPos.w;
112: 
113:     float2 shadowUV;
114:     shadowUV.x = 0.5f * sPos.x + 0.5f;
115:     shadowUV.y = -0.5f * sPos.y + 0.5f;
116:     if (shadowUV.x >= 0.0f && shadowUV.x <= 1.0f &&
117:         shadowUV.y >= 0.0f && shadowUV.y <= 1.0f &&
118:         sPos.z >= 0.0f && sPos.z <= 1.0f)
119:     {
120:         float closestDepth = g_ShadowMap.Sample(samp, shadowUV).r;
121:         float currentDepth = sPos.z;
122:         
123:         float3 N = normalize(ps_in.normalW.xyz);
124:         float3 L = normalize(-directional_world_vector.xyz);
125:         float cosTheta = saturate(dot(N, L));
126:         float bias = max(0.005f * (1.0f - cosTheta), 0.001f);
127: 
128:         shadowFactor = 0.0f;
129:         float2 texelSize = 1.0f / float2(2048.0f, 2048.0f);
130:         
131:         for (int x = -1; x <= 1; ++x)
132:         {
133:             for (int y = -1; y <= 1; ++y)
134:             {
135:                 float2 offset = float2(x, y) * texelSize;
136:                 float pcfDepth = g_ShadowMap.Sample(shadowSamp, shadowUV + offset).r;
137:                 shadowFactor += (currentDepth - bias) > pcfDepth ? 0.0f : 1.0f;
138:             }
139:         }
140:         shadowFactor /= 9.0f;
141:         shadowFactor = lerp(0.4f, 1.0f, shadowFactor);
142:     }
143: 
144:     // Ŕsőš(diffuse light)
145:     float4 normalW = normalize(ps_in.normalW);
146:     float3 lightVec = normalize(-directional_world_vector.xyz);
147:     //float dl = max(0, dot(lightVec, normalW.xyz)); // ĘíĚgUővZ
148:     float dl = (dot(lightVec, normalW.xyz) + 1.0f) * 0.5f; // źŞĚžéłđÁZ(ÂŤőĚăíč)
149:     float3 diffuse = material_color * directional_color.rgb * dl * shadowFactor;
150: 
151:     // ÂŤő(ambient light)
152:     float3 ambient = ambient_color.rgb * material_color;
153: 
154:     // XyLvZ
155:     //float3 toEye = normalize(eye_posW - ps_in.posW.xyz);
156:     //float3 r = reflect(-lightVec, normalW.xyz).xyz;
157:     //float t = pow(max(dot(r, toEye), 0.0f), specular_power); //˝ËĺŹ
158:     //float3 specular = specular_color * t;
159: 
160:     float shadow = (dl > 0.0f) ? 1.0f : 0.0f;
161:     // ĹIFĚvZ
162:     //float alpha = tex_color.a * ps_in.blend.a * diffuse_color.a; //nĘĘís§ž
163:     float3 final_color = ambient + diffuse ;
164: 
165:     return float4(final_color, 1.0f);
166:     //return tex0.Sample(samp, uv) * 0.5f + tex1.Sample(samp, ps_in.uv * 0.1f) * 0.5f; //* ps_in.color;
167:     // dágÁĘ
168:     //return ps_in.blend;
169: }
