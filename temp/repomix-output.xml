 1950: // Find end-of-line. Return pointer will point to either first \n, either str_end.
 1951: const char* ImStreolRange(const char* str, const char* str_end)
 1952: {
 1953:     const char* p = (const char*)ImMemchr(str, '\n', str_end - str);
 1954:     return p ? p : str_end;
 1955: }
 1956: const char* ImStrbol(const char* buf_mid_line, const char* buf_begin) // find beginning-of-line
 1957: {
 1958:     IM_ASSERT_PARANOID(buf_mid_line >= buf_begin && buf_mid_line <= buf_begin + ImStrlen(buf_begin));
 1959:     while (buf_mid_line > buf_begin && buf_mid_line[-1] != '\n')
 1960:         buf_mid_line--;
 1961:     return buf_mid_line;
 1962: }
 1963: const char* ImStristr(const char* haystack, const char* haystack_end, const char* needle, const char* needle_end)
 1964: {
 1965:     if (!needle_end)
 1966:         needle_end = needle + ImStrlen(needle);
 1967:     const char un0 = (char)ImToUpper(*needle);
 1968:     while ((!haystack_end && *haystack) || (haystack_end && haystack < haystack_end))
 1969:     {
 1970:         if (ImToUpper(*haystack) == un0)
 1971:         {
 1972:             const char* b = needle + 1;
 1973:             for (const char* a = haystack + 1; b < needle_end; a++, b++)
 1974:                 if (ImToUpper(*a) != ImToUpper(*b))
 1975:                     break;
 1976:             if (b == needle_end)
 1977:                 return haystack;
 1978:         }
 1979:         haystack++;
 1980:     }
 1981:     return NULL;
 1982: }
 1983: // Trim str by offsetting contents when there's leading data + writing a \0 at the trailing position. We use this in situation where the cost is negligible.
 1984: void ImStrTrimBlanks(char* buf)
 1985: {
 1986:     char* p = buf;
 1987:     while (p[0] == ' ' || p[0] == '\t')     // Leading blanks
 1988:         p++;
 1989:     char* p_start = p;
 1990:     while (*p != 0)                         // Find end of string
 1991:         p++;
 1992:     while (p > p_start && (p[-1] == ' ' || p[-1] == '\t'))  // Trailing blanks
 1993:         p--;
 1994:     if (p_start != buf)                     // Copy memory if we had leading blanks
 1995:         memmove(buf, p_start, p - p_start);
 1996:     buf[p - p_start] = 0;                   // Zero terminate
 1997: }
 1998: const char* ImStrSkipBlank(const char* str)
 1999: {
 2000:     while (str[0] == ' ' || str[0] == '\t')
 2001:         str++;
 2002:     return str;
 2003: }
