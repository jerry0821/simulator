1820: // Macros used by Recoverable Error handling
1821: // - Only dispatch error if _EXPR: evaluate as assert (similar to an assert macro).
1822: // - The message will always be a string literal, in order to increase likelihood of being display by an assert handler.
1823: // - See 'Demo->Configuration->Error Handling' and ImGuiIO definitions for details on error handling.
1824: // - Read https://github.com/ocornut/imgui/wiki/Error-Handling for details on error handling.
1825: #ifndef IM_ASSERT_USER_ERROR
1826: #define IM_ASSERT_USER_ERROR(_EXPR,_MSG)    do { if (!(_EXPR) && ImGui::ErrorLog(_MSG)) { IM_ASSERT((_EXPR) && _MSG); } } while (0)    // Recoverable User Error
1827: #endif
1828: // The error callback is currently not public, as it is expected that only advanced users will rely on it.
