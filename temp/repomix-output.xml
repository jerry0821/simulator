 9351:                 text_inputted = true;
 9352:         }
 9353:         else if (e->Type == ImGuiInputEventType_Focus)
 9354:         {
 9355:             // We intentionally overwrite this and process in NewFrame(), in order to give a chance
 9356:             // to multi-viewports backends to queue AddFocusEvent(false) + AddFocusEvent(true) in same frame.
 9357:             const bool focus_lost = !e->AppFocused.Focused;
 9358:             io.AppFocusLost = focus_lost;
 9359:         }
 9360:         else
 9361:         {
 9362:             IM_ASSERT(0 && "Unknown event!");
 9363:         }
 9364:     }
 9365:     // Record trail (for domain-specific applications wanting to access a precise trail)
 9366:     //if (event_n != 0) IMGUI_DEBUG_LOG_IO("Processed: %d / Remaining: %d\n", event_n, g.InputEventsQueue.Size - event_n);
 9367:     for (int n = 0; n < event_n; n++)
 9368:         g.InputEventsTrail.push_back(g.InputEventsQueue[n]);
 9369:     // [DEBUG]
 9370: #ifndef IMGUI_DISABLE_DEBUG_TOOLS
 9371:     if (event_n != 0 && (g.DebugLogFlags & ImGuiDebugLogFlags_EventIO))
 9372:         for (int n = 0; n < g.InputEventsQueue.Size; n++)
 9373:             DebugPrintInputEvent(n < event_n ? "Processed" : "Remaining", &g.InputEventsQueue[n]);
 9374: #endif
 9375:     // Remaining events will be processed on the next frame
 9376:     if (event_n == g.InputEventsQueue.Size)
 9377:         g.InputEventsQueue.resize(0);
 9378:     else
 9379:         g.InputEventsQueue.erase(g.InputEventsQueue.Data, g.InputEventsQueue.Data + event_n);
