 4: cbuffer ConstantBuffer : register(b0)
 5: {
 6:     matrix mWorld; 
 7:     float outlineWidth;
 8:     float3 padding;
 9: }
10: 
11: cbuffer CBView : register(b1)
12: {
13:     matrix mView;
14: }
15: 
16: cbuffer CBProj : register(b2)
17: {
18:     matrix mProj;
19: }
20: 
21: struct VS_INPUT
22: {
23:     float4 posL : POSITION;
24:     float4 normalL : NORMAL;
25:     float4 color : COLOR;
26:     float2 uv : TEXCOORD;
27: };
28: 
29: struct VS_OUTPUT
30: {
31:     float4 posH : SV_POSITION;
32:     float4 posW : POSITION;
33:     float4 normal : NORMAL;
34:     float4 color : COLOR;
35:     float2 uv : TEXCOORD;
36: };
37: 
38: VS_OUTPUT main(VS_INPUT input)
39: {
40:     VS_OUTPUT output;
41: 
42:     float4 posW = mul(input.posL, mWorld);
