 604: // Helper: ImSpan<>
 605: // Pointing to a span of data we don't own.
 606: template<typename T>
 607: struct ImSpan
 608: {
 609:     T*                  Data;
 610:     T*                  DataEnd;
 611:     // Constructors, destructor
 612:     inline ImSpan()                                 { Data = DataEnd = NULL; }
 613:     inline ImSpan(T* data, int size)                { Data = data; DataEnd = data + size; }
 614:     inline ImSpan(T* data, T* data_end)             { Data = data; DataEnd = data_end; }
 615:     inline void         set(T* data, int size)      { Data = data; DataEnd = data + size; }
 616:     inline void         set(T* data, T* data_end)   { Data = data; DataEnd = data_end; }
 617:     inline int          size() const                { return (int)(ptrdiff_t)(DataEnd - Data); }
 618:     inline int          size_in_bytes() const       { return (int)(ptrdiff_t)(DataEnd - Data) * (int)sizeof(T); }
 619:     inline T&           operator[](int i)           { T* p = Data + i; IM_ASSERT(p >= Data && p < DataEnd); return *p; }
 620:     inline const T&     operator[](int i) const     { const T* p = Data + i; IM_ASSERT(p >= Data && p < DataEnd); return *p; }
 621:     inline T*           begin()                     { return Data; }
 622:     inline const T*     begin() const               { return Data; }
 623:     inline T*           end()                       { return DataEnd; }
 624:     inline const T*     end() const                 { return DataEnd; }
 625:     // Utilities
 626:     inline int  index_from_ptr(const T* it) const   { IM_ASSERT(it >= Data && it < DataEnd); const ptrdiff_t off = it - Data; return (int)off; }
 627: };
 628: // Helper: ImSpanAllocator<>
 629: // Facilitate storing multiple chunks into a single large block (the "arena")
 630: // - Usage: call Reserve() N times, allocate GetArenaSizeInBytes() worth, pass it to SetArenaBasePtr(), call GetSpan() N times to retrieve the aligned ranges.
 631: template<int CHUNKS>
 632: struct ImSpanAllocator
 633: {
 634:     char*   BasePtr;
 635:     int     CurrOff;
 636:     int     CurrIdx;
 637:     int     Offsets[CHUNKS];
 638:     int     Sizes[CHUNKS];
 639:     ImSpanAllocator()                               { memset(this, 0, sizeof(*this)); }
 640:     inline void  Reserve(int n, size_t sz, int a=4) { IM_ASSERT(n == CurrIdx && n < CHUNKS); CurrOff = IM_MEMALIGN(CurrOff, a); Offsets[n] = CurrOff; Sizes[n] = (int)sz; CurrIdx++; CurrOff += (int)sz; }
 641:     inline int   GetArenaSizeInBytes()              { return CurrOff; }
 642:     inline void  SetArenaBasePtr(void* base_ptr)    { BasePtr = (char*)base_ptr; }
 643:     inline void* GetSpanPtrBegin(int n)             { IM_ASSERT(n >= 0 && n < CHUNKS && CurrIdx == CHUNKS); return (void*)(BasePtr + Offsets[n]); }
 644:     inline void* GetSpanPtrEnd(int n)               { IM_ASSERT(n >= 0 && n < CHUNKS && CurrIdx == CHUNKS); return (void*)(BasePtr + Offsets[n] + Sizes[n]); }
 645:     template<typename T>
 646:     inline void  GetSpan(int n, ImSpan<T>* span)    { span->set((T*)GetSpanPtrBegin(n), (T*)GetSpanPtrEnd(n)); }
 647: };
 648: // Helper: ImStableVector<>
 649: // Allocating chunks of BLOCKSIZE items. Objects pointers are never invalidated when growing, only by clear().
 650: // Important: does not destruct anything!
 651: // Implemented only the minimum set of functions we need for it.
 652: template<typename T, int BLOCKSIZE>
 653: struct ImStableVector
 654: {
 655:     int                 Size = 0;
 656:     int                 Capacity = 0;
 657:     ImVector<T*>        Blocks;
 658:     // Functions
 659:     inline ~ImStableVector()                        { for (T* block : Blocks) IM_FREE(block); }
 660:     inline void         clear()                     { Size = Capacity = 0; Blocks.clear_delete(); }
 661:     inline void         resize(int new_size)        { if (new_size > Capacity) reserve(new_size); Size = new_size; }
 662:     inline void         reserve(int new_cap)
 663:     {
 664:         new_cap = IM_MEMALIGN(new_cap, BLOCKSIZE);
 665:         int old_count = Capacity / BLOCKSIZE;
 666:         int new_count = new_cap / BLOCKSIZE;
 667:         if (new_count <= old_count)
 668:             return;
 669:         Blocks.resize(new_count);
 670:         for (int n = old_count; n < new_count; n++)
 671:             Blocks[n] = (T*)IM_ALLOC(sizeof(T) * BLOCKSIZE);
 672:         Capacity = new_cap;
 673:     }
 674:     inline T&           operator[](int i)           { IM_ASSERT(i >= 0 && i < Size); return Blocks[i / BLOCKSIZE][i % BLOCKSIZE]; }
 675:     inline const T&     operator[](int i) const     { IM_ASSERT(i >= 0 && i < Size); return Blocks[i / BLOCKSIZE][i % BLOCKSIZE]; }
 676:     inline T*           push_back(const T& v)       { int i = Size; IM_ASSERT(i >= 0); if (Size == Capacity) reserve(Capacity + BLOCKSIZE); void* ptr = &Blocks[i / BLOCKSIZE][i % BLOCKSIZE]; memcpy(ptr, &v, sizeof(v)); Size++; return (T*)ptr; }
 677: };
 678: // Helper: ImPool<>
 679: // Basic keyed storage for contiguous instances, slow/amortized insertion, O(1) indexable, O(Log N) queries by ID over a dense/hot buffer,
 680: // Honor constructor/destructor. Add/remove invalidate all pointers. Indexes have the same lifetime as the associated object.
 681: typedef int ImPoolIdx;
 682: template<typename T>
 683: struct ImPool
 684: {
 685:     ImVector<T>     Buf;        // Contiguous data
 686:     ImGuiStorage    Map;        // ID->Index
 687:     ImPoolIdx       FreeIdx;    // Next free idx to use
 688:     ImPoolIdx       AliveCount; // Number of active/alive items (for display purpose)
 689:     ImPool()    { FreeIdx = AliveCount = 0; }
 690:     ~ImPool()   { Clear(); }
 691:     T*          GetByKey(ImGuiID key)               { int idx = Map.GetInt(key, -1); return (idx != -1) ? &Buf[idx] : NULL; }
 692:     T*          GetByIndex(ImPoolIdx n)             { return &Buf[n]; }
 693:     ImPoolIdx   GetIndex(const T* p) const          { IM_ASSERT(p >= Buf.Data && p < Buf.Data + Buf.Size); return (ImPoolIdx)(p - Buf.Data); }
 694:     T*          GetOrAddByKey(ImGuiID key)          { int* p_idx = Map.GetIntRef(key, -1); if (*p_idx != -1) return &Buf[*p_idx]; *p_idx = FreeIdx; return Add(); }
 695:     bool        Contains(const T* p) const          { return (p >= Buf.Data && p < Buf.Data + Buf.Size); }
 696:     void        Clear()                             { for (int n = 0; n < Map.Data.Size; n++) { int idx = Map.Data[n].val_i; if (idx != -1) Buf[idx].~T(); } Map.Clear(); Buf.clear(); FreeIdx = AliveCount = 0; }
 697:     T*          Add()                               { int idx = FreeIdx; if (idx == Buf.Size) { Buf.resize(Buf.Size + 1); FreeIdx++; } else { FreeIdx = *(int*)&Buf[idx]; } IM_PLACEMENT_NEW(&Buf[idx]) T(); AliveCount++; return &Buf[idx]; }
 698:     void        Remove(ImGuiID key, const T* p)     { Remove(key, GetIndex(p)); }
 699:     void        Remove(ImGuiID key, ImPoolIdx idx)  { Buf[idx].~T(); *(int*)&Buf[idx] = FreeIdx; FreeIdx = idx; Map.SetInt(key, -1); AliveCount--; }
 700:     void        Reserve(int capacity)               { Buf.reserve(capacity); Map.Data.reserve(capacity); }
 701:     // To iterate a ImPool: for (int n = 0; n < pool.GetMapSize(); n++) if (T* t = pool.TryGetMapData(n)) { ... }
 702:     // Can be avoided if you know .Remove() has never been called on the pool, or AliveCount == GetMapSize()
 703:     int         GetAliveCount() const               { return AliveCount; }      // Number of active/alive items in the pool (for display purpose)
 704:     int         GetBufSize() const                  { return Buf.Size; }
 705:     int         GetMapSize() const                  { return Map.Data.Size; }   // It is the map we need iterate to find valid items, since we don't have "alive" storage anywhere
 706:     T*          TryGetMapData(ImPoolIdx n)          { int idx = Map.Data[n].val_i; if (idx == -1) return NULL; return GetByIndex(idx); }
 707: };
 708: // Helper: ImChunkStream<>
 709: // Build and iterate a contiguous stream of variable-sized structures.
 710: // This is used by Settings to store persistent data while reducing allocation count.
 711: // We store the chunk size first, and align the final size on 4 bytes boundaries.
 712: // The tedious/zealous amount of casting is to avoid -Wcast-align warnings.
 713: template<typename T>
 714: struct ImChunkStream
 715: {
 716:     ImVector<char>  Buf;
 717:     void    clear()                     { Buf.clear(); }
 718:     bool    empty() const               { return Buf.Size == 0; }
 719:     int     size() const                { return Buf.Size; }
 720:     T*      alloc_chunk(size_t sz)      { size_t HDR_SZ = 4; sz = IM_MEMALIGN(HDR_SZ + sz, 4u); int off = Buf.Size; Buf.resize(off + (int)sz); ((int*)(void*)(Buf.Data + off))[0] = (int)sz; return (T*)(void*)(Buf.Data + off + (int)HDR_SZ); }
 721:     T*      begin()                     { size_t HDR_SZ = 4; if (!Buf.Data) return NULL; return (T*)(void*)(Buf.Data + HDR_SZ); }
 722:     T*      next_chunk(T* p)            { size_t HDR_SZ = 4; IM_ASSERT(p >= begin() && p < end()); p = (T*)(void*)((char*)(void*)p + chunk_size(p)); if (p == (T*)(void*)((char*)end() + HDR_SZ)) return (T*)0; IM_ASSERT(p < end()); return p; }
 723:     int     chunk_size(const T* p)      { return ((const int*)p)[-1]; }
 724:     T*      end()                       { return (T*)(void*)(Buf.Data + Buf.Size); }
 725:     int     offset_from_ptr(const T* p) { IM_ASSERT(p >= begin() && p < end()); const ptrdiff_t off = (const char*)p - Buf.Data; return (int)off; }
 726:     T*      ptr_from_offset(int off)    { IM_ASSERT(off >= 4 && off < Buf.Size); return (T*)(void*)(Buf.Data + off); }
 727:     void    swap(ImChunkStream<T>& rhs) { rhs.Buf.swap(Buf); }
 728: };
