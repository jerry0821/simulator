3512: // Update texture identifier in all active draw lists
3513: void ImFontAtlasUpdateDrawListsTextures(ImFontAtlas* atlas, ImTextureRef old_tex, ImTextureRef new_tex)
3514: {
3515:     for (ImDrawListSharedData* shared_data : atlas->DrawListSharedDatas)
3516:     {
3517:         // If Context 2 uses font owned by Context 1 which already called EndFrame()/Render(), we don't want to mess with draw commands for Context 1
3518:         if (shared_data->Context && !shared_data->Context->WithinFrameScope)
3519:             continue;
3520:         for (ImDrawList* draw_list : shared_data->DrawLists)
3521:         {
3522:             // Replace in command-buffer
3523:             // (there is not need to replace in ImDrawListSplitter: current channel is in ImDrawList's CmdBuffer[],
3524:             //  other channels will be on SetCurrentChannel() which already needs to compare CmdHeader anyhow)
3525:             if (draw_list->CmdBuffer.Size > 0 && draw_list->_CmdHeader.TexRef == old_tex)
3526:                 draw_list->_SetTexture(new_tex);
3527:             // Replace in stack
3528:             for (ImTextureRef& stacked_tex : draw_list->_TextureStack)
3529:                 if (stacked_tex == old_tex)
3530:                     stacked_tex = new_tex;
3531:         }
3532:     }
3533: }
3534: // Update texture coordinates in all draw list shared context
