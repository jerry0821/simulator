10493: ImVec2 ImGui::ScrollToRectEx(ImGuiWindow* window, const ImRect& item_rect, ImGuiScrollFlags flags)
10494: {
10495:     ImGuiContext& g = *GImGui;
10496:     ImRect scroll_rect(window->InnerRect.Min - ImVec2(1, 1), window->InnerRect.Max + ImVec2(1, 1));
10497:     scroll_rect.Min.x = ImMin(scroll_rect.Min.x + window->DecoInnerSizeX1, scroll_rect.Max.x);
10498:     scroll_rect.Min.y = ImMin(scroll_rect.Min.y + window->DecoInnerSizeY1, scroll_rect.Max.y);
10499:     //GetForegroundDrawList(window)->AddRect(item_rect.Min, item_rect.Max, IM_COL32(255,0,0,255), 0.0f, 0, 5.0f); // [DEBUG]
10500:     //GetForegroundDrawList(window)->AddRect(scroll_rect.Min, scroll_rect.Max, IM_COL32_WHITE); // [DEBUG]
10501:     // Check that only one behavior is selected per axis
10502:     IM_ASSERT((flags & ImGuiScrollFlags_MaskX_) == 0 || ImIsPowerOfTwo(flags & ImGuiScrollFlags_MaskX_));
10503:     IM_ASSERT((flags & ImGuiScrollFlags_MaskY_) == 0 || ImIsPowerOfTwo(flags & ImGuiScrollFlags_MaskY_));
10504:     // Defaults
10505:     ImGuiScrollFlags in_flags = flags;
10506:     if ((flags & ImGuiScrollFlags_MaskX_) == 0 && window->ScrollbarX)
10507:         flags |= ImGuiScrollFlags_KeepVisibleEdgeX;
10508:     if ((flags & ImGuiScrollFlags_MaskY_) == 0)
10509:         flags |= window->Appearing ? ImGuiScrollFlags_AlwaysCenterY : ImGuiScrollFlags_KeepVisibleEdgeY;
10510:     const bool fully_visible_x = item_rect.Min.x >= scroll_rect.Min.x && item_rect.Max.x <= scroll_rect.Max.x;
10511:     const bool fully_visible_y = item_rect.Min.y >= scroll_rect.Min.y && item_rect.Max.y <= scroll_rect.Max.y;
10512:     const bool can_be_fully_visible_x = (item_rect.GetWidth() + g.Style.ItemSpacing.x * 2.0f) <= scroll_rect.GetWidth() || (window->AutoFitFramesX > 0) || (window->Flags & ImGuiWindowFlags_AlwaysAutoResize) != 0;
10513:     const bool can_be_fully_visible_y = (item_rect.GetHeight() + g.Style.ItemSpacing.y * 2.0f) <= scroll_rect.GetHeight() || (window->AutoFitFramesY > 0) || (window->Flags & ImGuiWindowFlags_AlwaysAutoResize) != 0;
10514:     if ((flags & ImGuiScrollFlags_KeepVisibleEdgeX) && !fully_visible_x)
10515:     {
10516:         if (item_rect.Min.x < scroll_rect.Min.x || !can_be_fully_visible_x)
10517:             SetScrollFromPosX(window, item_rect.Min.x - g.Style.ItemSpacing.x - window->Pos.x, 0.0f);
10518:         else if (item_rect.Max.x >= scroll_rect.Max.x)
10519:             SetScrollFromPosX(window, item_rect.Max.x + g.Style.ItemSpacing.x - window->Pos.x, 1.0f);
10520:     }
10521:     else if (((flags & ImGuiScrollFlags_KeepVisibleCenterX) && !fully_visible_x) || (flags & ImGuiScrollFlags_AlwaysCenterX))
10522:     {
10523:         if (can_be_fully_visible_x)
10524:             SetScrollFromPosX(window, ImTrunc((item_rect.Min.x + item_rect.Max.x) * 0.5f) - window->Pos.x, 0.5f);
10525:         else
10526:             SetScrollFromPosX(window, item_rect.Min.x - window->Pos.x, 0.0f);
10527:     }
10528:     if ((flags & ImGuiScrollFlags_KeepVisibleEdgeY) && !fully_visible_y)
10529:     {
10530:         if (item_rect.Min.y < scroll_rect.Min.y || !can_be_fully_visible_y)
10531:             SetScrollFromPosY(window, item_rect.Min.y - g.Style.ItemSpacing.y - window->Pos.y, 0.0f);
10532:         else if (item_rect.Max.y >= scroll_rect.Max.y)
10533:             SetScrollFromPosY(window, item_rect.Max.y + g.Style.ItemSpacing.y - window->Pos.y, 1.0f);
10534:     }
10535:     else if (((flags & ImGuiScrollFlags_KeepVisibleCenterY) && !fully_visible_y) || (flags & ImGuiScrollFlags_AlwaysCenterY))
10536:     {
10537:         if (can_be_fully_visible_y)
10538:             SetScrollFromPosY(window, ImTrunc((item_rect.Min.y + item_rect.Max.y) * 0.5f) - window->Pos.y, 0.5f);
10539:         else
10540:             SetScrollFromPosY(window, item_rect.Min.y - window->Pos.y, 0.0f);
10541:     }
10542:     ImVec2 next_scroll = CalcNextScrollFromScrollTargetAndClamp(window);
10543:     ImVec2 delta_scroll = next_scroll - window->Scroll;
10544:     // Also scroll parent window to keep us into view if necessary
10545:     if (!(flags & ImGuiScrollFlags_NoScrollParent) && (window->Flags & ImGuiWindowFlags_ChildWindow))
10546:     {
10547:         // FIXME-SCROLL: May be an option?
10548:         if ((in_flags & (ImGuiScrollFlags_AlwaysCenterX | ImGuiScrollFlags_KeepVisibleCenterX)) != 0)
10549:             in_flags = (in_flags & ~ImGuiScrollFlags_MaskX_) | ImGuiScrollFlags_KeepVisibleEdgeX;
10550:         if ((in_flags & (ImGuiScrollFlags_AlwaysCenterY | ImGuiScrollFlags_KeepVisibleCenterY)) != 0)
10551:             in_flags = (in_flags & ~ImGuiScrollFlags_MaskY_) | ImGuiScrollFlags_KeepVisibleEdgeY;
10552:         delta_scroll += ScrollToRectEx(window->ParentWindow, ImRect(item_rect.Min - delta_scroll, item_rect.Max - delta_scroll), in_flags);
10553:     }
10554:     return delta_scroll;
10555: }
