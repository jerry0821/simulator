 7219:         bool hidden_regular = (window->HiddenFramesCanSkipItems > 0) || (window->HiddenFramesCannotSkipItems > 0);
 7220:         window->Hidden = hidden_regular || (window->HiddenFramesForRenderOnly > 0);
