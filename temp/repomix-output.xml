2174: static float GetMinimumStepAtDecimalPrecision(int decimal_precision)
2175: {
2176:     static const float min_steps[10] = { 1.0f, 0.1f, 0.01f, 0.001f, 0.0001f, 0.00001f, 0.000001f, 0.0000001f, 0.00000001f, 0.000000001f };
2177:     if (decimal_precision < 0)
2178:         return FLT_MIN;
2179:     return (decimal_precision < IM_ARRAYSIZE(min_steps)) ? min_steps[decimal_precision] : ImPow(10.0f, (float)-decimal_precision);
2180: }
2181: template<typename TYPE>
2182: TYPE ImGui::RoundScalarWithFormatT(const char* format, ImGuiDataType data_type, TYPE v)
2183: {
2184:     IM_UNUSED(data_type);
2185:     IM_ASSERT(data_type == ImGuiDataType_Float || data_type == ImGuiDataType_Double);
2186:     const char* fmt_start = ImParseFormatFindStart(format);
2187:     if (fmt_start[0] != '%' || fmt_start[1] == '%') // Don't apply if the value is not visible in the format string
2188:         return v;
2189:     // Sanitize format
2190:     char fmt_sanitized[32];
2191:     ImParseFormatSanitizeForPrinting(fmt_start, fmt_sanitized, IM_ARRAYSIZE(fmt_sanitized));
2192:     fmt_start = fmt_sanitized;
2193:     // Format value with our rounding, and read back
2194:     char v_str[64];
2195:     ImFormatString(v_str, IM_ARRAYSIZE(v_str), fmt_start, v);
2196:     const char* p = v_str;
2197:     while (*p == ' ')
2198:         p++;
2199:     v = (TYPE)ImAtof(p);
2200:     return v;
2201: }
