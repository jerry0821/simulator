370: DirectX::XMMATRIX Direct3D_MatrixViewport() 
371: {
372: 	float half_width = Direct3D_GetBackBufferWidth() * 0.5f;
373: 	float half_height = Direct3D_GetBackBufferHeight() * 0.5f;
374: 	float min_depth = g_Viewport.MinDepth;
375: 	float max_depth = g_Viewport.MaxDepth;
376: 	return DirectX::XMMATRIX(
377: 		half_width, 0.0f, 0.0f, 0.0f,
378: 		0.0f, -half_height, 0.0f, 0.0f,
379: 		0.0f, 0.0f, (max_depth - min_depth), 0.0f, // [3, 2] 元素
380: 		half_width, half_height, min_depth, 1.0f  // [4, 3] 元素
381: 	);
382: }
383: DirectX::XMFLOAT3 Direct3D_ScreenToWorld(int x, int y, float depth, const DirectX::XMFLOAT4X4& view, const DirectX::XMFLOAT4X4& projection)
384: {
385: 	XMMATRIX x_view{ XMLoadFloat4x4(&view) };
386: 	XMMATRIX x_proj{ XMLoadFloat4x4(&projection)};
387: 	XMVECTOR x_point{ x,y,depth,1.0f };
388: 	XMMATRIX inv{ XMMatrixInverse(nullptr, x_view * x_proj * Direct3D_MatrixViewport()) };
389: 	x_point = XMVector3TransformCoord(x_point, inv);
390: 	XMFLOAT3 ret;
391: 	XMStoreFloat3(&ret, x_point);
392: 	return ret;
393: }
394: DirectX::XMFLOAT2 Direct3D_WorldToScreen(const DirectX::XMFLOAT3& position, const DirectX::XMFLOAT4X4& view, const DirectX::XMFLOAT4X4& projection)
395: {
396: 	XMMATRIX x_view{ XMLoadFloat4x4(&view) };
397: 	XMMATRIX x_proj{ XMLoadFloat4x4(&projection) };
398: 	XMVECTOR x_point{ XMLoadFloat3 (&position)};
399: 	x_point = XMVector3TransformCoord (x_point , x_view * x_proj * Direct3D_MatrixViewport());
400: 	XMFLOAT2 ret;
401: 	XMStoreFloat2(&ret, x_point);
402: 	return ret;
403: }
