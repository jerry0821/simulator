  7: using namespace DirectX;
  8: struct Vertex3D {
  9:   XMFLOAT3 position;
 10:   XMFLOAT3 normal;
 11:   XMFLOAT4 color;
 12:   XMFLOAT2 texcoord;
 13: };
 14: static ID3D11Buffer *g_pVertexBuffer = nullptr;
 15: static ID3D11Buffer *g_pIndexBuffer = nullptr;
 16: static int g_IndexCount = 0;
 17: static ID3D11Device *g_pDevice = nullptr;
 18: static ID3D11DeviceContext *g_pContext = nullptr;
 19: void Capsule_Initialize(ID3D11Device *pDevice, ID3D11DeviceContext *pContext) {
 20:   g_pDevice = pDevice;
 21:   g_pContext = pContext;
 22:   int slices = 32;
 23:   int rings = 16; // Half-sphere rings
 24:   float radius = 0.5f;
 25:   float cylinderHalfHeight = 0.5f;
 26:   std::vector<Vertex3D> vertices;
 27:   std::vector<unsigned short> indices;
 28:   // 1. Top Hemisphere (rings 0 to rings/2)
 29:   for (int i = 0; i <= rings / 2; ++i) {
 30:     float v = (float)i / (rings / 2.0f); // 0 (top pole) to 1 (equator)
 31:     float phi = v * XM_PIDIV2;           // 0 to PI/2
 32:     for (int j = 0; j <= slices; ++j) {
 33:       float u = (float)j / slices;
 34:       float theta = u * XM_2PI;
 35:       float x = radius * sinf(phi) * cosf(theta);
 36:       float y = radius * cosf(phi) + cylinderHalfHeight;
 37:       float z = radius * sinf(phi) * sinf(theta);
 38:       XMFLOAT3 normal = {sinf(phi) * cosf(theta), cosf(phi),
 39:                          sinf(phi) * sinf(theta)};
 40:       vertices.push_back({{x, y, z}, normal, {1, 1, 1, 1}, {u, v * 0.25f}});
 41:     }
 42:   }
 43:   // 2. Bottom Hemisphere (rings/2 to rings)
 44:   for (int i = 0; i <= rings / 2; ++i) {
 45:     float v = (float)i / (rings / 2.0f);   // 0 (equator) to 1 (bottom pole)
 46:     float phi = XM_PIDIV2 + v * XM_PIDIV2; // PI/2 to PI
 47:     for (int j = 0; j <= slices; ++j) {
 48:       float u = (float)j / slices;
 49:       float theta = u * XM_2PI;
 50:       float x = radius * sinf(phi) * cosf(theta);
 51:       float y = radius * cosf(phi) - cylinderHalfHeight;
 52:       float z = radius * sinf(phi) * sinf(theta);
 53:       XMFLOAT3 normal = {sinf(phi) * cosf(theta), cosf(phi),
 54:                          sinf(phi) * sinf(theta)};
 55:       // Map bottom hemisphere UVs
 56:       vertices.push_back(
 57:           {{x, y, z}, normal, {1, 1, 1, 1}, {u, 0.75f + v * 0.25f}});
 58:     }
 59:   }
 60:   // Connect Cylinder Body
 61:   // The equator of the top hemisphere is the last ring added in phase 1.
 62:   // The equator of the bottom hemisphere is the first ring added in phase 2.
 63:   // We just add indices for the top hemisphere, cylinder body, and bottom
 64:   // hemisphere.
 65:   // Indices for Top Hemisphere
 66:   int ringVertexCount = slices + 1;
 67:   for (int i = 0; i < rings / 2; ++i) {
 68:     for (int j = 0; j < slices; ++j) {
 69:       unsigned short v1 = i * ringVertexCount + j;
 70:       unsigned short v2 = (i + 1) * ringVertexCount + j;
 71:       unsigned short v3 = i * ringVertexCount + (j + 1);
 72:       unsigned short v4 = (i + 1) * ringVertexCount + (j + 1);
 73:       indices.push_back(v3);
 74:       indices.push_back(v2);
 75:       indices.push_back(v1);
 76:       indices.push_back(v4);
 77:       indices.push_back(v2);
 78:       indices.push_back(v3);
 79:     }
 80:   }
 81:   // Indices for Cylinder Body connecting Top Equator to Bottom Equator
 82:   int topEquatorStart = (rings / 2) * ringVertexCount;
 83:   int bottomEquatorStart = (rings / 2 + 1) * ringVertexCount;
 84:   for (int j = 0; j < slices; ++j) {
 85:     unsigned short top1 = topEquatorStart + j;
 86:     unsigned short bottom1 = bottomEquatorStart + j;
 87:     unsigned short top2 = topEquatorStart + (j + 1);
 88:     unsigned short bottom2 = bottomEquatorStart + (j + 1);
 89:     indices.push_back(top2);
 90:     indices.push_back(bottom1);
 91:     indices.push_back(top1);
 92:     indices.push_back(bottom2);
 93:     indices.push_back(bottom1);
 94:     indices.push_back(top2);
 95:   }
 96:   // Indices for Bottom Hemisphere
 97:   for (int i = 0; i < rings / 2; ++i) {
 98:     for (int j = 0; j < slices; ++j) {
 99:       unsigned short v1 = bottomEquatorStart + i * ringVertexCount + j;
100:       unsigned short v2 = bottomEquatorStart + (i + 1) * ringVertexCount + j;
101:       unsigned short v3 = bottomEquatorStart + i * ringVertexCount + (j + 1);
102:       unsigned short v4 =
103:           bottomEquatorStart + (i + 1) * ringVertexCount + (j + 1);
104:       indices.push_back(v3);
105:       indices.push_back(v2);
106:       indices.push_back(v1);
107:       indices.push_back(v4);
108:       indices.push_back(v2);
109:       indices.push_back(v3);
110:     }
111:   }
112:   g_IndexCount = (int)indices.size();
113:   // Create Vertex Buffer
114:   D3D11_BUFFER_DESC vbDesc = {};
115:   vbDesc.Usage = D3D11_USAGE_DEFAULT;
116:   vbDesc.ByteWidth = sizeof(Vertex3D) * (UINT)vertices.size();
117:   vbDesc.BindFlags = D3D11_BIND_VERTEX_BUFFER;
118:   D3D11_SUBRESOURCE_DATA vbInitData = {};
119:   vbInitData.pSysMem = vertices.data();
120:   g_pDevice->CreateBuffer(&vbDesc, &vbInitData, &g_pVertexBuffer);
121:   // Create Index Buffer
122:   D3D11_BUFFER_DESC ibDesc = {};
123:   ibDesc.Usage = D3D11_USAGE_DEFAULT;
124:   ibDesc.ByteWidth = sizeof(unsigned short) * (UINT)indices.size();
125:   ibDesc.BindFlags = D3D11_BIND_INDEX_BUFFER;
126:   D3D11_SUBRESOURCE_DATA ibInitData = {};
127:   ibInitData.pSysMem = indices.data();
128:   g_pDevice->CreateBuffer(&ibDesc, &ibInitData, &g_pIndexBuffer);
129: }
130: void Capsule_Finalize(void) {
131:   SAFE_RELEASE(g_pVertexBuffer);
132:   SAFE_RELEASE(g_pIndexBuffer);
133: }
134: void Capsule_Update(double elapsed_Time) {
135:   // Not used right now
136: }
137: void Capsule_Draw(int texId, const DirectX::XMMATRIX &mtxWorld) {
138:   if (!g_pVertexBuffer || !g_pIndexBuffer)
139:     return;
140:   Shader3D_Begin();
141:   Shader3D_SetMaterialColor({1.0f, 1.0f, 1.0f, 1.0f});
142:   UINT stride = sizeof(Vertex3D);
143:   UINT offset = 0;
144:   g_pContext->IASetVertexBuffers(0, 1, &g_pVertexBuffer, &stride, &offset);
145:   g_pContext->IASetIndexBuffer(g_pIndexBuffer, DXGI_FORMAT_R16_UINT, 0);
146:   g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
147:   Shader3D_SetWorldMatrix(mtxWorld);
148:   Texture_SetTexture(texId);
149:   g_pContext->DrawIndexed(g_IndexCount, 0, 0);
150: }
