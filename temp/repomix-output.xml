381:           XMMATRIX objWorld =
382:               XMMatrixScaling(obj->Scale.x, obj->Scale.y, obj->Scale.z) *
383:               XMMatrixRotationRollPitchYaw(obj->Rotation.x, obj->Rotation.y,
384:                                            obj->Rotation.z) *
385:               XMMatrixTranslationFromVector(XMLoadFloat3(&obj->Position));
