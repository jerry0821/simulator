 7: 
 8: ==============================================================================*/
 9: 
10: // 定数バッファ
11: cbuffer VS_CONSTANT_BUFFER : register(b0)
12: {
13:     float4x4 proj;
14: };
15: 
16: cbuffer VS_CONSTANT_BUFFER : register(b1)
17: {
18:     float4x4 world;
19: };
20:  
21:  
22: struct VS_IN
23: {
24:     float4 posL : POSITION0;
25:     float4 color : COLOR0;
26:     float2 uv : TEXCOORD0;
27: };
28:  
29: struct VS_OUT
30: {
31:     float4 posH : SV_POSITION;
32:     float4 color : COLOR0;
33:     float2 uv : TEXCOORD0;
34: };
35:  
36:  
37: //=============================================================================
38: // 頂点シェーダ
39: //=============================================================================
40: VS_OUT main(VS_IN vi)
41: {
42:  
43:     VS_OUT vo;
44:     
45:     // 座標変換
46:     
47:     float4x4 mtx = mul(world, proj);
48:     vo.posH = mul(vi.posL, mtx);
49:     
50:     
51:     vo.color = vi.color;
52:     vo.uv    = vi.uv;
53:     
54:     
55:     return vo;
56: }
