3037:     // [EXPERIMENTAL] Low-Level: Key/Input Ownership
3038:     // - The idea is that instead of "eating" a given input, we can link to an owner id.
3039:     // - Ownership is most often claimed as a result of reacting to a press/down event (but occasionally may be claimed ahead).
3040:     // - Input queries can then read input by specifying ImGuiKeyOwner_Any (== 0), ImGuiKeyOwner_NoOwner (== -1) or a custom ID.
3041:     // - Legacy input queries (without specifying an owner or _Any or _None) are equivalent to using ImGuiKeyOwner_Any (== 0).
3042:     // - Input ownership is automatically released on the frame after a key is released. Therefore:
3043:     //   - for ownership registration happening as a result of a down/press event, the SetKeyOwner() call may be done once (common case).
3044:     //   - for ownership registration happening ahead of a down/press event, the SetKeyOwner() call needs to be made every frame (happens if e.g. claiming ownership on hover).
3045:     // - SetItemKeyOwner() is a shortcut for common simple case. A custom widget will probably want to call SetKeyOwner() multiple times directly based on its interaction state.
3046:     // - This is marked experimental because not all widgets are fully honoring the Set/Test idioms. We will need to move forward step by step.
3047:     //   Please open a GitHub Issue to submit your usage scenario or if there's a use case you need solved.
3048:     IMGUI_API ImGuiID       GetKeyOwner(ImGuiKey key);
3049:     IMGUI_API void          SetKeyOwner(ImGuiKey key, ImGuiID owner_id, ImGuiInputFlags flags = 0);
3050:     IMGUI_API void          SetKeyOwnersForKeyChord(ImGuiKeyChord key, ImGuiID owner_id, ImGuiInputFlags flags = 0);
3051:     IMGUI_API void          SetItemKeyOwner(ImGuiKey key, ImGuiInputFlags flags);       // Set key owner to last item if it is hovered or active. Equivalent to 'if (IsItemHovered() || IsItemActive()) { SetKeyOwner(key, GetItemID());'.
3052:     IMGUI_API bool          TestKeyOwner(ImGuiKey key, ImGuiID owner_id);               // Test that key is either not owned, either owned by 'owner_id'
3053:     inline ImGuiKeyOwnerData* GetKeyOwnerData(ImGuiContext* ctx, ImGuiKey key)          { if (key & ImGuiMod_Mask_) key = ConvertSingleModFlagToKey(key); IM_ASSERT(IsNamedKey(key)); return &ctx->KeysOwnerData[key - ImGuiKey_NamedKey_BEGIN]; }
