11732:     // Is it in the quadrant we're interested in moving to?
11733:     bool new_best = false;
11734:     if (quadrant == move_dir)
11735:     {
11736:         // Does it beat the current best candidate?
11737:         if (dist_box < result->DistBox)
11738:         {
11739:             result->DistBox = dist_box;
11740:             result->DistCenter = dist_center;
11741:             return true;
11742:         }
11743:         if (dist_box == result->DistBox)
