1314: bool ImGui::TextLink(const char* label)
1315: {
1316:     ImGuiWindow* window = GetCurrentWindow();
1317:     if (window->SkipItems)
1318:         return false;
1319:     ImGuiContext& g = *GImGui;
1320:     const ImGuiID id = window->GetID(label);
1321:     const char* label_end = FindRenderedTextEnd(label);
1322:     ImVec2 pos(window->DC.CursorPos.x, window->DC.CursorPos.y + window->DC.CurrLineTextBaseOffset);
1323:     ImVec2 size = CalcTextSize(label, label_end, true);
1324:     ImRect bb(pos, pos + size);
1325:     ItemSize(size, 0.0f);
1326:     if (!ItemAdd(bb, id))
1327:         return false;
1328:     bool hovered, held;
1329:     bool pressed = ButtonBehavior(bb, id, &hovered, &held);
1330:     RenderNavCursor(bb, id);
1331:     if (hovered)
1332:         SetMouseCursor(ImGuiMouseCursor_Hand);
1333:     ImVec4 text_colf = g.Style.Colors[ImGuiCol_TextLink];
1334:     ImVec4 line_colf = text_colf;
1335:     {
1336:         // FIXME-STYLE: Read comments above. This widget is NOT written in the same style as some earlier widgets,
1337:         // as we are currently experimenting/planning a different styling system.
1338:         float h, s, v;
1339:         ColorConvertRGBtoHSV(text_colf.x, text_colf.y, text_colf.z, h, s, v);
1340:         if (held || hovered)
1341:         {
1342:             v = ImSaturate(v + (held ? 0.4f : 0.3f));
1343:             h = ImFmod(h + 0.02f, 1.0f);
1344:         }
1345:         ColorConvertHSVtoRGB(h, s, v, text_colf.x, text_colf.y, text_colf.z);
1346:         v = ImSaturate(v - 0.20f);
1347:         ColorConvertHSVtoRGB(h, s, v, line_colf.x, line_colf.y, line_colf.z);
1348:     }
1349:     float line_y = bb.Max.y + ImFloor(g.FontBaked->Descent * g.FontBakedScale * 0.20f);
1350:     window->DrawList->AddLine(ImVec2(bb.Min.x, line_y), ImVec2(bb.Max.x, line_y), GetColorU32(line_colf)); // FIXME-TEXT: Underline mode // FIXME-DPI
1351:     PushStyleColor(ImGuiCol_Text, GetColorU32(text_colf));
1352:     RenderText(bb.Min, label, label_end);
1353:     PopStyleColor();
1354:     IMGUI_TEST_ENGINE_ITEM_INFO(id, label, g.LastItemData.StatusFlags);
1355:     return pressed;
1356: }
