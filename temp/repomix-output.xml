 2253: // Helper: Load file content into memory
 2254: // Memory allocated with IM_ALLOC(), must be freed by user using IM_FREE() == ImGui::MemFree()
 2255: // This can't really be used with "rt" because fseek size won't match read size.
 2256: void*   ImFileLoadToMemory(const char* filename, const char* mode, size_t* out_file_size, int padding_bytes)
 2257: {
 2258:     IM_ASSERT(filename && mode);
 2259:     if (out_file_size)
 2260:         *out_file_size = 0;
 2261:     ImFileHandle f;
 2262:     if ((f = ImFileOpen(filename, mode)) == NULL)
 2263:         return NULL;
 2264:     size_t file_size = (size_t)ImFileGetSize(f);
 2265:     if (file_size == (size_t)-1)
 2266:     {
 2267:         ImFileClose(f);
 2268:         return NULL;
 2269:     }
 2270:     void* file_data = IM_ALLOC(file_size + padding_bytes);
 2271:     if (file_data == NULL)
 2272:     {
 2273:         ImFileClose(f);
 2274:         return NULL;
 2275:     }
 2276:     if (ImFileRead(file_data, 1, file_size, f) != file_size)
 2277:     {
 2278:         ImFileClose(f);
 2279:         IM_FREE(file_data);
 2280:         return NULL;
 2281:     }
 2282:     if (padding_bytes > 0)
 2283:         memset((void*)(((char*)file_data) + file_size), 0, (size_t)padding_bytes);
 2284:     ImFileClose(f);
 2285:     if (out_file_size)
 2286:         *out_file_size = file_size;
 2287:     return file_data;
 2288: }
