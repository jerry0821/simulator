  1: // --------------------------------------------
  2: // スプライトアニメーション描画 [spriteanim.h]
  3: // ============================================
  4: // Created by: Yasuda Atsushi
  5: // Date: 2025-06-17
  6: // Version: 1.0
  7: // --------------------------------------------
  8: #include "sprite_anim.h"
  9: #include "sprite.h"
 10: #include "texture.h"
 11: #include <DirectXMath.h>
 12: using namespace DirectX; // ヘッダーには書くなよ cppならいい
 13: #include "billboard.h"
 14: struct AnimPatternData
 15: {
 16: 	int m_TextureId = -1; // テクスチャID
 17: 	int m_PatternMax = 0; // パターン数
 18: 	int m_HPatternMax = 0; // 横のパターン数(Holizone)
 19: 	XMUINT2 m_StartPosition {0, 0}; // アニメーションのスタート座標
 20: 	XMUINT2 m_PatternSize { 0, 0 }; // 1パターンのサイズ
 21: 	double m_seconds_per_pattern = 0.1;
 22: 	bool m_IsLooped = false; // ループするか
 23: };
 24: struct AnimPlayData
 25: {
 26: 	int m_PatternId = -1; // アニメーションパターンID
 27: 	int m_PatternNum = 0; // 現在再生中のパターン
 28: 	double m_AccumulatedTime = 0.0; // 累積時間
 29: 	bool m_IsStopped = false; // 再生中かどうか
 30: };
 31: static constexpr int ANIM_PATTERN_MAX = 128;
 32: static AnimPatternData g_AnimPattern[ANIM_PATTERN_MAX];
 33: static constexpr int ANIM_PLAY_MAX = 256;
 34: static AnimPlayData g_AnimPlay[ANIM_PLAY_MAX];
 35: void SpriteAnim_Initialize()
 36: {
 37: 	//アニメーションパターン管理情報を初期化（すべて利用していない）状況にする
 38: 	for (AnimPatternData& data : g_AnimPattern)
 39: 	{
 40: 		data.m_TextureId = -1;
 41: 	}
 42: 	for (AnimPlayData& data : g_AnimPlay)
 43: 	{
 44: 		data.m_PatternId = -1;
 45: 		data.m_IsStopped = false;
 46: 	}
 47: }
 48: void SpriteAnim_Finalize()
 49: {
 50: }
 51: void SpriteAnim_Update(double elapsed_time)
 52: {
 53: 	for (int i = 0; i < ANIM_PLAY_MAX; i++)
 54: 	{
 55: 		if (g_AnimPlay[i].m_PatternId < 0) continue; // データが入ってない
 56: 		AnimPatternData* pAnimPatternData = &g_AnimPattern[g_AnimPlay[i].m_PatternId];
 57: 		if (g_AnimPlay[i].m_AccumulatedTime >= pAnimPatternData ->m_seconds_per_pattern){
 58: 			g_AnimPlay[i].m_PatternNum++;
 59: 			if (g_AnimPlay[i].m_PatternNum >= pAnimPatternData->m_PatternMax)
 60: 			{
 61: 				if (pAnimPatternData->m_IsLooped)
 62: 				{
 63: 					g_AnimPlay[i].m_PatternNum = 0;
 64: 				}
 65: 				else
 66: 				{
 67: 					g_AnimPlay[i].m_PatternNum = pAnimPatternData->m_PatternMax - 1;
 68: 					g_AnimPlay[i].m_IsStopped = true; // 再生が止まった
 69: 				}
 70: 			}
 71: 			g_AnimPlay[i].m_AccumulatedTime -= pAnimPatternData->m_seconds_per_pattern;
 72: 		}
 73: 		g_AnimPlay[i].m_AccumulatedTime += elapsed_time;
 74: 	}
 75: }
 76: void SpriteAnim_Draw(int playid, float dx, float dy, float dw, float dh)
 77: {
 78: 	int anim_pattern_id = g_AnimPlay[playid].m_PatternId;
 79: 	AnimPatternData* pAnimPatternData = &g_AnimPattern[anim_pattern_id];
 80: 	Sprite_Draw(pAnimPatternData->m_TextureId,
 81: 		dx, dy, dw, dh,
 82: 		pAnimPatternData->m_StartPosition.x
 83: 		+ pAnimPatternData->m_PatternSize.x
 84: 		* (g_AnimPlay[playid].m_PatternNum % pAnimPatternData->m_HPatternMax),
 85: 		pAnimPatternData->m_StartPosition.y
 86: 		+ pAnimPatternData->m_PatternSize.y
 87: 		* (g_AnimPlay[playid].m_PatternNum / pAnimPatternData->m_HPatternMax),
 88: 		pAnimPatternData->m_PatternSize.x,
 89: 		pAnimPatternData->m_PatternSize.y
 90: 	);
 91: }
 92: void BillBoardAnim_Draw(int playid, const DirectX::XMFLOAT3& position, const DirectX::XMFLOAT2& scale, const DirectX::XMFLOAT2& pivot)
 93: {
 94: 	int anim_pattern_id = g_AnimPlay[playid].m_PatternId;
 95: 	AnimPatternData* pAnimPatternData = &g_AnimPattern[anim_pattern_id];
 96: 	Billboard_Draw(pAnimPatternData->m_TextureId,
 97: 		position,scale,
 98: 		{
 99: 			pAnimPatternData->m_StartPosition.x
100: 			+ pAnimPatternData->m_PatternSize.x
101: 			* (float)(g_AnimPlay[playid].m_PatternNum % pAnimPatternData->m_HPatternMax),
102: 			pAnimPatternData->m_StartPosition.y
103: 			+ pAnimPatternData->m_PatternSize.y
104: 			* (float)(g_AnimPlay[playid].m_PatternNum / pAnimPatternData->m_HPatternMax),
105: 			(float)pAnimPatternData->m_PatternSize.x,
106: 			(float)pAnimPatternData->m_PatternSize.y
107: 		},
108: 		pivot
109: 	);
110: }
111: int SpriteAnim_RegisterPattern(int texId, int pattern_Max, int h_pattern_Max, double seconds_per_pattern, const DirectX::XMUINT2& pattern_size, const DirectX::XMUINT2& start_position, bool is_looped)
112: {
113: 	for (int i = 0; i < ANIM_PATTERN_MAX; i++)
114: 	{
115: 		// 空いてる場所を探す
116: 		if (g_AnimPattern[i].m_TextureId >= 0) continue;
117: 		g_AnimPattern[i].m_TextureId = texId;
118: 		g_AnimPattern[i].m_PatternMax = pattern_Max;
119: 		g_AnimPattern[i].m_HPatternMax = h_pattern_Max;
120: 		g_AnimPattern[i].m_seconds_per_pattern = seconds_per_pattern;
121: 		g_AnimPattern[i].m_PatternSize = pattern_size;
122: 		g_AnimPattern[i].m_StartPosition = start_position;
123: 		g_AnimPattern[i].m_IsLooped = is_looped;
124: 		return i; // これが大事
125: 	}
126: 	return -1; // 容量がないよ～～～～
127: }
128: int SpriteAnim_CreatePlayer(int anim_pattern_id)
129: {
130: 	for (int i = 0; i < ANIM_PLAY_MAX; i++) {
131: 		if (g_AnimPlay[i].m_PatternId >= 0) continue;
132: 		g_AnimPlay[i].m_PatternId = anim_pattern_id;
133: 		g_AnimPlay[i].m_AccumulatedTime = 0.0;
134: 		g_AnimPlay[i].m_PatternNum = 0;
135: 		g_AnimPlay[i].m_IsStopped = false; // 再生中にする
136: 		return i;
137: 	}
138: 	return -1;
139: }
140: bool SpriteAnim_IsStopped(int index)
141: {
142: 	return g_AnimPlay[index].m_IsStopped; // 停止中かどうかを返す
143: }
144: void SpriteAnim_DestroyPlayer(int index)
145: {
146: 	g_AnimPlay[index].m_PatternId = -1;
147: 	g_AnimPlay[index].m_IsStopped = false;
148: 	g_AnimPlay[index].m_PatternNum = 0;
149: 	g_AnimPlay[index].m_AccumulatedTime = 0.0;
150: }
