 34: /** @file Defines the StreamWriter class which writes data to
 35:  *  a binary stream with a well-defined endianness. */
 36: #pragma once
 37: #ifndef AI_STREAMWRITER_H_INCLUDED
 38: #define AI_STREAMWRITER_H_INCLUDED
 39: #ifdef __GNUC__
 40: #   pragma GCC system_header
 41: #endif
 42: #include "ByteSwapper.h"
 43: #include "IOStream.hpp>
 44: #include <memory>
 45: #include <vector>
 46: namespace Assimp {
 47: // --------------------------------------------------------------------------------------------
 48: /** Wrapper class around IOStream to allow for consistent writing of binary data in both
 49:  *  little and big endian format. Don't attempt to instance the template directly. Use
 50:  *  StreamWriterLE to write to a little-endian stream and StreamWriterBE to write to a
 51:  *  BE stream. Alternatively, there is StreamWriterAny if the endianness of the output
 52:  *  stream is to be determined at runtime.
 53:  */
 54: // --------------------------------------------------------------------------------------------
 55: template <bool SwapEndianess = false, bool RuntimeSwitch = false>
 56: class StreamWriter
 57: {
 58:     enum {
 59:         INITIAL_CAPACITY = 1024
 60:     };
 61: public:
 62:     // ---------------------------------------------------------------------
 63:     /** Construction from a given stream with a well-defined endianness.
 64:      *
 65:      *  The StreamReader holds a permanent strong reference to the
 66:      *  stream, which is released upon destruction.
 67:      *  @param stream Input stream. The stream is not re-seeked and writing
 68:           continues at the current position of the stream cursor.
 69:      *  @param le If @c RuntimeSwitch is true: specifies whether the
 70:      *    stream is in little endian byte order. Otherwise the
 71:      *    endianness information is defined by the @c SwapEndianess
 72:      *    template parameter and this parameter is meaningless.  */
 73:     StreamWriter(std::shared_ptr<IOStream> stream, bool le = false)
 74:         : stream(stream)
 75:         , le(le)
 76:         , cursor()
 77:     {
 78:         ai_assert(stream);
 79:         buffer.reserve(INITIAL_CAPACITY);
 80:     }
 81:     // ---------------------------------------------------------------------
 82:     StreamWriter(IOStream* stream, bool le = false)
 83:         : stream(std::shared_ptr<IOStream>(stream))
 84:         , le(le)
 85:         , cursor()
 86:     {
 87:         ai_assert(stream);
 88:         buffer.reserve(INITIAL_CAPACITY);
 89:     }
 90:     // ---------------------------------------------------------------------
 91:     ~StreamWriter() {
 92:         stream->Write(buffer.data(), 1, buffer.size());
 93:         stream->Flush();
 94:     }
 95: public:
 96:     // ---------------------------------------------------------------------
 97:     /** Flush the contents of the internal buffer, and the output IOStream */
 98:     void Flush()
 99:     {
100:         stream->Write(buffer.data(), 1, buffer.size());
101:         stream->Flush();
102:         buffer.clear();
103:         cursor = 0;
104:     }
105:     // ---------------------------------------------------------------------
106:     /** Seek to the given offset / origin in the output IOStream.
107:      *
108:      *  Flushes the internal buffer and the output IOStream prior to seeking. */
109:     aiReturn Seek(size_t pOffset, aiOrigin pOrigin=aiOrigin_SET)
110:     {
111:         Flush();
112:         return stream->Seek(pOffset, pOrigin);
113:     }
114:     // ---------------------------------------------------------------------
115:     /** Tell the current position in the output IOStream.
116:      *
117:      *  First flushes the internal buffer and the output IOStream. */
118:     size_t Tell()
119:     {
120:         Flush();
121:         return stream->Tell();
122:     }
123: public:
124:     // ---------------------------------------------------------------------
125:     /** Write a float to the stream  */
126:     void PutF4(float f)
127:     {
128:         Put(f);
129:     }
130:     // ---------------------------------------------------------------------
131:     /** Write a double to the stream  */
132:     void PutF8(double d)    {
133:         Put(d);
134:     }
135:     // ---------------------------------------------------------------------
136:     /** Write a signed 16 bit integer to the stream */
137:     void PutI2(int16_t n)   {
138:         Put(n);
139:     }
140:     // ---------------------------------------------------------------------
141:     /** Write a signed 8 bit integer to the stream */
142:     void PutI1(int8_t n)    {
143:         Put(n);
144:     }
145:     // ---------------------------------------------------------------------
146:     /** Write an signed 32 bit integer to the stream */
147:     void PutI4(int32_t n)   {
148:         Put(n);
149:     }
150:     // ---------------------------------------------------------------------
151:     /** Write a signed 64 bit integer to the stream */
152:     void PutI8(int64_t n)   {
153:         Put(n);
154:     }
155:     // ---------------------------------------------------------------------
156:     /** Write a unsigned 16 bit integer to the stream */
157:     void PutU2(uint16_t n)  {
158:         Put(n);
159:     }
160:     // ---------------------------------------------------------------------
161:     /** Write a unsigned 8 bit integer to the stream */
162:     void PutU1(uint8_t n)   {
163:         Put(n);
164:     }
165:     // ---------------------------------------------------------------------
166:     /** Write an unsigned 32 bit integer to the stream */
167:     void PutU4(uint32_t n)  {
168:         Put(n);
169:     }
170:     // ---------------------------------------------------------------------
171:     /** Write a unsigned 64 bit integer to the stream */
172:     void PutU8(uint64_t n)  {
173:         Put(n);
174:     }
175:     // ---------------------------------------------------------------------
176:     /** Write a single character to the stream */
177:     void PutChar(char c)    {
178:         Put(c);
179:     }
180:     // ---------------------------------------------------------------------
181:     /** Write an aiString to the stream */
182:     void PutString(const aiString& s)
183:     {
184:         // as Put(T f) below
185:         if (cursor + s.length >= buffer.size()) {
186:             buffer.resize(cursor + s.length);
187:         }
188:         void* dest = &buffer[cursor];
189:         ::memcpy(dest, s.C_Str(), s.length);
190:         cursor += s.length;
191:     }
192:     // ---------------------------------------------------------------------
193:     /** Write a std::string to the stream */
194:     void PutString(const std::string& s)
195:     {
196:         // as Put(T f) below
197:         if (cursor + s.size() >= buffer.size()) {
198:             buffer.resize(cursor + s.size());
199:         }
200:         void* dest = &buffer[cursor];
201:         ::memcpy(dest, s.c_str(), s.size());
202:         cursor += s.size();
203:     }
204: public:
205:     // ---------------------------------------------------------------------
206:     /** overload operator<< and allow chaining of MM ops. */
207:     template <typename T>
208:     StreamWriter& operator << (T f) {
209:         Put(f);
210:         return *this;
211:     }
212:     // ---------------------------------------------------------------------
213:     std::size_t GetCurrentPos() const {
214:         return cursor;
215:     }
216:     // ---------------------------------------------------------------------
217:     void SetCurrentPos(std::size_t new_cursor) {
218:         cursor = new_cursor;
219:     }
220:     // ---------------------------------------------------------------------
221:     /** Generic write method. ByteSwap::Swap(T*) *must* be defined */
222:     template <typename T>
223:     void Put(T f)   {
224:         Intern :: Getter<SwapEndianess,T,RuntimeSwitch>() (&f, le);
225:         if (cursor + sizeof(T) >= buffer.size()) {
226:             buffer.resize(cursor + sizeof(T));
227:         }
228:         void* dest = &buffer[cursor];
229:         // reinterpret_cast + assignment breaks strict aliasing rules
230:         // and generally causes trouble on platforms such as ARM that
231:         // do not silently ignore alignment faults.
232:         ::memcpy(dest, &f, sizeof(T));
233:         cursor += sizeof(T);
234:     }
235: private:
236:     std::shared_ptr<IOStream> stream;
237:     bool le;
238:     std::vector<uint8_t> buffer;
239:     std::size_t cursor;
240: };
241: // --------------------------------------------------------------------------------------------
242: // `static` StreamWriter. Their byte order is fixed and they might be a little bit faster.
243: #ifdef AI_BUILD_BIG_ENDIAN
244:     typedef StreamWriter<true>  StreamWriterLE;
245:     typedef StreamWriter<false> StreamWriterBE;
246: #else
247:     typedef StreamWriter<true>  StreamWriterBE;
248:     typedef StreamWriter<false> StreamWriterLE;
249: #endif
250: // `dynamic` StreamWriter. The byte order of the input data is specified in the
251: // c'tor. This involves runtime branching and might be a little bit slower.
252: typedef StreamWriter<true,true> StreamWriterAny;
253: } // end namespace Assimp
254: #endif // !! AI_STREAMWriter_H_INCLUDED
</file>

