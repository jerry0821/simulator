 5667: bool ImGui::BeginChildEx(const char* name, ImGuiID id, const ImVec2& size_arg, ImGuiChildFlags child_flags, ImGuiWindowFlags window_flags)
 5668: {
 5669:     ImGuiContext& g = *GImGui;
 5670:     ImGuiWindow* parent_window = g.CurrentWindow;
 5671:     IM_ASSERT(id != 0);
 5672:     // Sanity check as it is likely that some user will accidentally pass ImGuiWindowFlags into the ImGuiChildFlags argument.
 5673:     const ImGuiChildFlags ImGuiChildFlags_SupportedMask_ = ImGuiChildFlags_Borders | ImGuiChildFlags_AlwaysUseWindowPadding | ImGuiChildFlags_ResizeX | ImGuiChildFlags_ResizeY | ImGuiChildFlags_AutoResizeX | ImGuiChildFlags_AutoResizeY | ImGuiChildFlags_AlwaysAutoResize | ImGuiChildFlags_FrameStyle | ImGuiChildFlags_NavFlattened;
 5674:     IM_UNUSED(ImGuiChildFlags_SupportedMask_);
 5675:     IM_ASSERT((child_flags & ~ImGuiChildFlags_SupportedMask_) == 0 && "Illegal ImGuiChildFlags value. Did you pass ImGuiWindowFlags values instead of ImGuiChildFlags?");
 5676:     IM_ASSERT((window_flags & ImGuiWindowFlags_AlwaysAutoResize) == 0 && "Cannot specify ImGuiWindowFlags_AlwaysAutoResize for BeginChild(). Use ImGuiChildFlags_AlwaysAutoResize!");
 5677:     if (child_flags & ImGuiChildFlags_AlwaysAutoResize)
 5678:     {
 5679:         IM_ASSERT((child_flags & (ImGuiChildFlags_ResizeX | ImGuiChildFlags_ResizeY)) == 0 && "Cannot use ImGuiChildFlags_ResizeX or ImGuiChildFlags_ResizeY with ImGuiChildFlags_AlwaysAutoResize!");
 5680:         IM_ASSERT((child_flags & (ImGuiChildFlags_AutoResizeX | ImGuiChildFlags_AutoResizeY)) != 0 && "Must use ImGuiChildFlags_AutoResizeX or ImGuiChildFlags_AutoResizeY with ImGuiChildFlags_AlwaysAutoResize!");
 5681:     }
 5682: #ifndef IMGUI_DISABLE_OBSOLETE_FUNCTIONS
 5683:     //if (window_flags & ImGuiWindowFlags_AlwaysUseWindowPadding)
 5684:     //    child_flags |= ImGuiChildFlags_AlwaysUseWindowPadding;
 5685:     //if (window_flags & ImGuiWindowFlags_NavFlattened)
 5686:     //    child_flags |= ImGuiChildFlags_NavFlattened;
 5687: #endif
 5688:     if (child_flags & ImGuiChildFlags_AutoResizeX)
 5689:         child_flags &= ~ImGuiChildFlags_ResizeX;
 5690:     if (child_flags & ImGuiChildFlags_AutoResizeY)
 5691:         child_flags &= ~ImGuiChildFlags_ResizeY;
 5692:     // Set window flags
 5693:     window_flags |= ImGuiWindowFlags_ChildWindow | ImGuiWindowFlags_NoTitleBar;
 5694:     window_flags |= (parent_window->Flags & ImGuiWindowFlags_NoMove); // Inherit the NoMove flag
 5695:     if (child_flags & (ImGuiChildFlags_AutoResizeX | ImGuiChildFlags_AutoResizeY | ImGuiChildFlags_AlwaysAutoResize))
 5696:         window_flags |= ImGuiWindowFlags_AlwaysAutoResize;
 5697:     if ((child_flags & (ImGuiChildFlags_ResizeX | ImGuiChildFlags_ResizeY)) == 0)
 5698:         window_flags |= ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoSavedSettings;
 5699:     // Special framed style
 5700:     if (child_flags & ImGuiChildFlags_FrameStyle)
 5701:     {
 5702:         PushStyleColor(ImGuiCol_ChildBg, g.Style.Colors[ImGuiCol_FrameBg]);
 5703:         PushStyleVar(ImGuiStyleVar_ChildRounding, g.Style.FrameRounding);
 5704:         PushStyleVar(ImGuiStyleVar_ChildBorderSize, g.Style.FrameBorderSize);
 5705:         PushStyleVar(ImGuiStyleVar_WindowPadding, g.Style.FramePadding);
 5706:         child_flags |= ImGuiChildFlags_Borders | ImGuiChildFlags_AlwaysUseWindowPadding;
 5707:         window_flags |= ImGuiWindowFlags_NoMove;
 5708:     }
 5709:     // Forward size
 5710:     // Important: Begin() has special processing to switch condition to ImGuiCond_FirstUseEver for a given axis when ImGuiChildFlags_ResizeXXX is set.
 5711:     // (the alternative would to store conditional flags per axis, which is possible but more code)
 5712:     const ImVec2 size_avail = GetContentRegionAvail();
 5713:     const ImVec2 size_default((child_flags & ImGuiChildFlags_AutoResizeX) ? 0.0f : size_avail.x, (child_flags & ImGuiChildFlags_AutoResizeY) ? 0.0f : size_avail.y);
 5714:     ImVec2 size = CalcItemSize(size_arg, size_default.x, size_default.y);
 5715:     // A SetNextWindowSize() call always has priority (#8020)
 5716:     // (since the code in Begin() never supported SizeVal==0.0f aka auto-resize via SetNextWindowSize() call, we don't support it here for now)
 5717:     // FIXME: We only support ImGuiCond_Always in this path. Supporting other paths would requires to obtain window pointer.
 5718:     if ((g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasSize) != 0 && (g.NextWindowData.SizeCond & ImGuiCond_Always) != 0)
 5719:     {
 5720:         if (g.NextWindowData.SizeVal.x > 0.0f)
 5721:         {
 5722:             size.x = g.NextWindowData.SizeVal.x;
 5723:             child_flags &= ~ImGuiChildFlags_ResizeX;
 5724:         }
 5725:         if (g.NextWindowData.SizeVal.y > 0.0f)
 5726:         {
 5727:             size.y = g.NextWindowData.SizeVal.y;
 5728:             child_flags &= ~ImGuiChildFlags_ResizeY;
 5729:         }
 5730:     }
 5731:     SetNextWindowSize(size);
 5732:     // Forward child flags (we allow prior settings to merge but it'll only work for adding flags)
 5733:     if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasChildFlags)
 5734:         g.NextWindowData.ChildFlags |= child_flags;
 5735:     else
 5736:         g.NextWindowData.ChildFlags = child_flags;
 5737:     g.NextWindowData.HasFlags |= ImGuiNextWindowDataFlags_HasChildFlags;
 5738:     // Build up name. If you need to append to a same child from multiple location in the ID stack, use BeginChild(ImGuiID id) with a stable value.
 5739:     // FIXME: 2023/11/14: commented out shorted version. We had an issue with multiple ### in child window path names, which the trailing hash helped workaround.
 5740:     // e.g. "ParentName###ParentIdentifier/ChildName###ChildIdentifier" would get hashed incorrectly by ImHashStr(), trailing _%08X somehow fixes it.
 5741:     const char* temp_window_name;
 5742:     /*if (name && parent_window->IDStack.back() == parent_window->ID)
 5743:         ImFormatStringToTempBuffer(&temp_window_name, NULL, "%s/%s", parent_window->Name, name); // May omit ID if in root of ID stack
 5744:     else*/
 5745:     if (name)
 5746:         ImFormatStringToTempBuffer(&temp_window_name, NULL, "%s/%s_%08X", parent_window->Name, name, id);
 5747:     else
 5748:         ImFormatStringToTempBuffer(&temp_window_name, NULL, "%s/%08X", parent_window->Name, id);
 5749:     // Set style
 5750:     const float backup_border_size = g.Style.ChildBorderSize;
 5751:     if ((child_flags & ImGuiChildFlags_Borders) == 0)
 5752:         g.Style.ChildBorderSize = 0.0f;
 5753:     // Begin into window
 5754:     const bool ret = Begin(temp_window_name, NULL, window_flags);
 5755:     // Restore style
 5756:     g.Style.ChildBorderSize = backup_border_size;
 5757:     if (child_flags & ImGuiChildFlags_FrameStyle)
 5758:     {
 5759:         PopStyleVar(3);
 5760:         PopStyleColor();
 5761:     }
 5762:     ImGuiWindow* child_window = g.CurrentWindow;
 5763:     child_window->ChildId = id;
 5764:     // Set the cursor to handle case where the user called SetNextWindowPos()+BeginChild() manually.
 5765:     // While this is not really documented/defined, it seems that the expected thing to do.
 5766:     if (child_window->BeginCount == 1)
 5767:         parent_window->DC.CursorPos = child_window->Pos;
 5768:     // Process navigation-in immediately so NavInit can run on first frame
 5769:     // Can enter a child if (A) it has navigable items or (B) it can be scrolled.
 5770:     const ImGuiID temp_id_for_activation = ImHashStr("##Child", 0, id);
 5771:     if (g.ActiveId == temp_id_for_activation)
 5772:         ClearActiveID();
 5773:     if (g.NavActivateId == id && !(child_flags & ImGuiChildFlags_NavFlattened) && (child_window->DC.NavLayersActiveMask != 0 || child_window->DC.NavWindowHasScrollY))
 5774:     {
 5775:         FocusWindow(child_window);
 5776:         NavInitWindow(child_window, false);
 5777:         SetActiveID(temp_id_for_activation, child_window); // Steal ActiveId with another arbitrary id so that key-press won't activate child item
 5778:         g.ActiveIdSource = g.NavInputSource;
 5779:     }
 5780:     return ret;
 5781: }
 5782: void ImGui::EndChild()
 5783: {
 5784:     ImGuiContext& g = *GImGui;
 5785:     ImGuiWindow* child_window = g.CurrentWindow;
 5786:     const ImGuiID backup_within_end_child_id = g.WithinEndChildID;
 5787:     IM_ASSERT(child_window->Flags & ImGuiWindowFlags_ChildWindow);   // Mismatched BeginChild()/EndChild() calls
 5788:     g.WithinEndChildID = child_window->ID;
 5789:     ImVec2 child_size = child_window->Size;
 5790:     End();
 5791:     if (child_window->BeginCount == 1)
 5792:     {
 5793:         ImGuiWindow* parent_window = g.CurrentWindow;
 5794:         ImRect bb(parent_window->DC.CursorPos, parent_window->DC.CursorPos + child_size);
 5795:         ItemSize(child_size);
 5796:         const bool nav_flattened = (child_window->ChildFlags & ImGuiChildFlags_NavFlattened) != 0;
 5797:         if ((child_window->DC.NavLayersActiveMask != 0 || child_window->DC.NavWindowHasScrollY) && !nav_flattened)
 5798:         {
 5799:             ItemAdd(bb, child_window->ChildId);
 5800:             RenderNavCursor(bb, child_window->ChildId);
 5801:             // When browsing a window that has no activable items (scroll only) we keep a highlight on the child (pass g.NavId to trick into always displaying)
 5802:             if (child_window->DC.NavLayersActiveMask == 0 && child_window == g.NavWindow)
 5803:                 RenderNavCursor(ImRect(bb.Min - ImVec2(2, 2), bb.Max + ImVec2(2, 2)), g.NavId, ImGuiNavRenderCursorFlags_Compact);
 5804:         }
 5805:         else
 5806:         {
 5807:             // Not navigable into
 5808:             // - This is a bit of a fringe use case, mostly useful for undecorated, non-scrolling contents childs, or empty childs.
 5809:             // - We could later decide to not apply this path if ImGuiChildFlags_FrameStyle or ImGuiChildFlags_Borders is set.
 5810:             ItemAdd(bb, child_window->ChildId, NULL, ImGuiItemFlags_NoNav);
 5811:             // But when flattened we directly reach items, adjust active layer mask accordingly
 5812:             if (nav_flattened)
 5813:                 parent_window->DC.NavLayersActiveMaskNext |= child_window->DC.NavLayersActiveMaskNext;
 5814:         }
 5815:         if (g.HoveredWindow == child_window)
 5816:             g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_HoveredWindow;
 5817:         child_window->DC.ChildItemStatusFlags = g.LastItemData.StatusFlags;
 5818:         //SetLastItemDataForChildWindowItem(child_window, child_window->Rect()); // Not needed, effectively done by ItemAdd()
 5819:     }
 5820:     else
 5821:     {
 5822:         SetLastItemDataForChildWindowItem(child_window, child_window->Rect());
 5823:     }
 5824:     g.WithinEndChildID = backup_within_end_child_id;
 5825:     g.LogLinePosY = -FLT_MAX; // To enforce a carriage return
 5826: }
