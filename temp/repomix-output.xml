 8399: // t0 = previous time (e.g.: g.Time - g.IO.DeltaTime)
 8400: // t1 = current time (e.g.: g.Time)
 8401: // An event is triggered at:
 8402: //  t = 0.0f     t = repeat_delay,    t = repeat_delay + repeat_rate*N
 8403: int ImGui::CalcTypematicRepeatAmount(float t0, float t1, float repeat_delay, float repeat_rate)
 8404: {
 8405:     if (t1 == 0.0f)
 8406:         return 1;
 8407:     if (t0 >= t1)
 8408:         return 0;
 8409:     if (repeat_rate <= 0.0f)
 8410:         return t0 < repeat_delay && t1 >= repeat_delay;
 8411:     const int count_t0 = (t0 < repeat_delay) ? -1 : (int)((t0 - repeat_delay) / repeat_rate);
 8412:     const int count_t1 = (t1 < repeat_delay) ? -1 : (int)((t1 - repeat_delay) / repeat_rate);
 8413:     const int count = count_t1 - count_t0;
 8414:     return count;
 8415: }
 8416: void ImGui::GetTypematicRepeatRate(ImGuiInputFlags flags, float* repeat_delay, float* repeat_rate)
 8417: {
 8418:     ImGuiContext& g = *GImGui;
 8419:     switch (flags & ImGuiInputFlags_RepeatRateMask_)
 8420:     {
 8421:     case ImGuiInputFlags_RepeatRateNavMove:             *repeat_delay = g.IO.KeyRepeatDelay * 0.72f; *repeat_rate = g.IO.KeyRepeatRate * 0.80f; return;
 8422:     case ImGuiInputFlags_RepeatRateNavTweak:            *repeat_delay = g.IO.KeyRepeatDelay * 0.72f; *repeat_rate = g.IO.KeyRepeatRate * 0.30f; return;
 8423:     case ImGuiInputFlags_RepeatRateDefault: default:    *repeat_delay = g.IO.KeyRepeatDelay * 1.00f; *repeat_rate = g.IO.KeyRepeatRate * 1.00f; return;
 8424:     }
 8425: }
 8426: // Return value representing the number of presses in the last time period, for the given repeat rate
 8427: // (most often returns 0 or 1. The result is generally only >1 when RepeatRate is smaller than DeltaTime, aka large DeltaTime or fast RepeatRate)
 8428: int ImGui::GetKeyPressedAmount(ImGuiKey key, float repeat_delay, float repeat_rate)
 8429: {
 8430:     ImGuiContext& g = *GImGui;
 8431:     const ImGuiKeyData* key_data = GetKeyData(key);
 8432:     if (!key_data->Down) // In theory this should already be encoded as (DownDuration < 0.0f), but testing this facilitates eating mechanism (until we finish work on key ownership)
 8433:         return 0;
 8434:     const float t = key_data->DownDuration;
 8435:     return CalcTypematicRepeatAmount(t - g.IO.DeltaTime, t, repeat_delay, repeat_rate);
 8436: }
