15201: // Special button that doesn't take focus, doesn't take input owner, and can be activated without a click etc.
15202: // In order to reduce interferences with the contents we are trying to debug into.
15203: bool ImGui::DebugBreakButton(const char* label, const char* description_of_location)
15204: {
15205:     ImGuiWindow* window = GetCurrentWindow();
15206:     if (window->SkipItems)
15207:         return false;
15208:     ImGuiContext& g = *GImGui;
15209:     const ImGuiID id = window->GetID(label);
15210:     const ImVec2 label_size = CalcTextSize(label, NULL, true);
15211:     ImVec2 pos = window->DC.CursorPos + ImVec2(0.0f, window->DC.CurrLineTextBaseOffset);
15212:     ImVec2 size = ImVec2(label_size.x + g.Style.FramePadding.x * 2.0f, label_size.y);
15213:     const ImRect bb(pos, pos + size);
15214:     ItemSize(size, 0.0f);
15215:     if (!ItemAdd(bb, id))
15216:         return false;
15217:     // WE DO NOT USE ButtonEx() or ButtonBehavior() in order to reduce our side-effects.
15218:     bool hovered = ItemHoverable(bb, id, g.CurrentItemFlags);
15219:     bool pressed = hovered && (IsKeyChordPressed(g.DebugBreakKeyChord) || IsMouseClicked(0) || g.NavActivateId == id);
15220:     DebugBreakButtonTooltip(false, description_of_location);
15221:     ImVec4 col4f = GetStyleColorVec4(hovered ? ImGuiCol_ButtonHovered : ImGuiCol_Button);
15222:     ImVec4 hsv;
15223:     ColorConvertRGBtoHSV(col4f.x, col4f.y, col4f.z, hsv.x, hsv.y, hsv.z);
15224:     ColorConvertHSVtoRGB(hsv.x + 0.20f, hsv.y, hsv.z, col4f.x, col4f.y, col4f.z);
15225:     RenderNavCursor(bb, id);
15226:     RenderFrame(bb.Min, bb.Max, GetColorU32(col4f), true, g.Style.FrameRounding);
15227:     RenderTextClipped(bb.Min, bb.Max, label, NULL, &label_size, g.Style.ButtonTextAlign, &bb);
15228:     IMGUI_TEST_ENGINE_ITEM_INFO(id, label, g.LastItemData.StatusFlags);
15229:     return pressed;
15230: }
