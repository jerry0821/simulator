2831: // Emit a column header (text + optional sort order)
2832: // We cpu-clip text here so that all columns headers can be merged into a same draw call.
2833: // Note that because of how we cpu-clip and display sorting indicators, you _cannot_ use SameLine() after a TableHeader()
2834: void ImGui::TableHeader(const char* label)
2835: {
2836:     ImGuiContext& g = *GImGui;
2837:     ImGuiWindow* window = g.CurrentWindow;
2838:     if (window->SkipItems)
2839:         return;
2840:     ImGuiTable* table = g.CurrentTable;
2841:     if (table == NULL)
2842:     {
2843:         IM_ASSERT_USER_ERROR(table != NULL, "Call should only be done while in BeginTable() scope!");
2844:         return;
2845:     }
2846:     IM_ASSERT(table->CurrentColumn != -1);
2847:     const int column_n = table->CurrentColumn;
2848:     ImGuiTableColumn* column = &table->Columns[column_n];
2849:     // Label
2850:     if (label == NULL)
2851:         label = "";
2852:     const char* label_end = FindRenderedTextEnd(label);
2853:     ImVec2 label_size = CalcTextSize(label, label_end, true);
2854:     ImVec2 label_pos = window->DC.CursorPos;
2855:     // If we already got a row height, there's use that.
2856:     // FIXME-TABLE: Padding problem if the correct outer-padding CellBgRect strays off our ClipRect?
2857:     ImRect cell_r = TableGetCellBgRect(table, column_n);
2858:     float label_height = ImMax(label_size.y, table->RowMinHeight - table->RowCellPaddingY * 2.0f);
2859:     // Calculate ideal size for sort order arrow
2860:     float w_arrow = 0.0f;
2861:     float w_sort_text = 0.0f;
2862:     bool sort_arrow = false;
2863:     char sort_order_suf[4] = "";
2864:     const float ARROW_SCALE = 0.65f;
2865:     if ((table->Flags & ImGuiTableFlags_Sortable) && !(column->Flags & ImGuiTableColumnFlags_NoSort))
2866:     {
2867:         w_arrow = ImTrunc(g.FontSize * ARROW_SCALE + g.Style.FramePadding.x);
2868:         if (column->SortOrder != -1)
2869:             sort_arrow = true;
2870:         if (column->SortOrder > 0)
2871:         {
2872:             ImFormatString(sort_order_suf, IM_ARRAYSIZE(sort_order_suf), "%d", column->SortOrder + 1);
2873:             w_sort_text = g.Style.ItemInnerSpacing.x + CalcTextSize(sort_order_suf).x;
2874:         }
2875:     }
2876:     // We feed our unclipped width to the column without writing on CursorMaxPos, so that column is still considered for merging.
2877:     float max_pos_x = label_pos.x + label_size.x + w_sort_text + w_arrow;
2878:     column->ContentMaxXHeadersUsed = ImMax(column->ContentMaxXHeadersUsed, sort_arrow ? cell_r.Max.x : ImMin(max_pos_x, cell_r.Max.x));
2879:     column->ContentMaxXHeadersIdeal = ImMax(column->ContentMaxXHeadersIdeal, max_pos_x);
2880:     // Keep header highlighted when context menu is open.
2881:     ImGuiID id = window->GetID(label);
2882:     ImRect bb(cell_r.Min.x, cell_r.Min.y, cell_r.Max.x, ImMax(cell_r.Max.y, cell_r.Min.y + label_height + g.Style.CellPadding.y * 2.0f));
2883:     ItemSize(ImVec2(0.0f, label_height)); // Don't declare unclipped width, it'll be fed ContentMaxPosHeadersIdeal
2884:     if (!ItemAdd(bb, id))
2885:         return;
2886:     //GetForegroundDrawList()->AddRect(cell_r.Min, cell_r.Max, IM_COL32(255, 0, 0, 255)); // [DEBUG]
2887:     //GetForegroundDrawList()->AddRect(bb.Min, bb.Max, IM_COL32(255, 0, 0, 255)); // [DEBUG]
2888:     // Using AllowOverlap mode because we cover the whole cell, and we want user to be able to submit subsequent items.
2889:     const bool highlight = (table->HighlightColumnHeader == column_n);
2890:     bool hovered, held;
2891:     bool pressed = ButtonBehavior(bb, id, &hovered, &held, ImGuiButtonFlags_AllowOverlap);
2892:     if (held || hovered || highlight)
2893:     {
2894:         const ImU32 col = GetColorU32(held ? ImGuiCol_HeaderActive : hovered ? ImGuiCol_HeaderHovered : ImGuiCol_Header);
2895:         //RenderFrame(bb.Min, bb.Max, col, false, 0.0f);
2896:         TableSetBgColor(ImGuiTableBgTarget_CellBg, col, table->CurrentColumn);
2897:     }
2898:     else
2899:     {
2900:         // Submit single cell bg color in the case we didn't submit a full header row
2901:         if ((table->RowFlags & ImGuiTableRowFlags_Headers) == 0)
2902:             TableSetBgColor(ImGuiTableBgTarget_CellBg, GetColorU32(ImGuiCol_TableHeaderBg), table->CurrentColumn);
2903:     }
2904:     RenderNavCursor(bb, id, ImGuiNavRenderCursorFlags_Compact | ImGuiNavRenderCursorFlags_NoRounding);
2905:     if (held)
2906:         table->HeldHeaderColumn = (ImGuiTableColumnIdx)column_n;
2907:     window->DC.CursorPos.y -= g.Style.ItemSpacing.y * 0.5f;
2908:     // Drag and drop to re-order columns.
2909:     // FIXME-TABLE: Scroll request while reordering a column and it lands out of the scrolling zone.
2910:     if (held && (table->Flags & ImGuiTableFlags_Reorderable) && IsMouseDragging(0) && !g.DragDropActive)
2911:     {
2912:         // While moving a column it will jump on the other side of the mouse, so we also test for MouseDelta.x
2913:         table->ReorderColumn = (ImGuiTableColumnIdx)column_n;
2914:         table->InstanceInteracted = table->InstanceCurrent;
2915:         // We don't reorder: through the frozen<>unfrozen line, or through a column that is marked with ImGuiTableColumnFlags_NoReorder.
2916:         if (g.IO.MouseDelta.x < 0.0f && g.IO.MousePos.x < cell_r.Min.x)
2917:             if (ImGuiTableColumn* prev_column = (column->PrevEnabledColumn != -1) ? &table->Columns[column->PrevEnabledColumn] : NULL)
2918:                 if (!((column->Flags | prev_column->Flags) & ImGuiTableColumnFlags_NoReorder))
2919:                     if ((column->IndexWithinEnabledSet < table->FreezeColumnsRequest) == (prev_column->IndexWithinEnabledSet < table->FreezeColumnsRequest))
2920:                         table->ReorderColumnDir = -1;
2921:         if (g.IO.MouseDelta.x > 0.0f && g.IO.MousePos.x > cell_r.Max.x)
2922:             if (ImGuiTableColumn* next_column = (column->NextEnabledColumn != -1) ? &table->Columns[column->NextEnabledColumn] : NULL)
2923:                 if (!((column->Flags | next_column->Flags) & ImGuiTableColumnFlags_NoReorder))
2924:                     if ((column->IndexWithinEnabledSet < table->FreezeColumnsRequest) == (next_column->IndexWithinEnabledSet < table->FreezeColumnsRequest))
2925:                         table->ReorderColumnDir = +1;
2926:     }
2927:     // Sort order arrow
2928:     const float ellipsis_max = ImMax(cell_r.Max.x - w_arrow - w_sort_text, label_pos.x);
2929:     if ((table->Flags & ImGuiTableFlags_Sortable) && !(column->Flags & ImGuiTableColumnFlags_NoSort))
2930:     {
2931:         if (column->SortOrder != -1)
2932:         {
2933:             float x = ImMax(cell_r.Min.x, cell_r.Max.x - w_arrow - w_sort_text);
2934:             float y = label_pos.y;
2935:             if (column->SortOrder > 0)
2936:             {
2937:                 PushStyleColor(ImGuiCol_Text, GetColorU32(ImGuiCol_Text, 0.70f));
2938:                 RenderText(ImVec2(x + g.Style.ItemInnerSpacing.x, y), sort_order_suf);
2939:                 PopStyleColor();
2940:                 x += w_sort_text;
2941:             }
2942:             RenderArrow(window->DrawList, ImVec2(x, y), GetColorU32(ImGuiCol_Text), column->SortDirection == ImGuiSortDirection_Ascending ? ImGuiDir_Up : ImGuiDir_Down, ARROW_SCALE);
2943:         }
2944:         // Handle clicking on column header to adjust Sort Order
2945:         if (pressed && table->ReorderColumn != column_n)
2946:         {
2947:             ImGuiSortDirection sort_direction = TableGetColumnNextSortDirection(column);
2948:             TableSetColumnSortDirection(column_n, sort_direction, g.IO.KeyShift);
2949:         }
2950:     }
2951:     // Render clipped label. Clipping here ensure that in the majority of situations, all our header cells will
2952:     // be merged into a single draw call.
2953:     //window->DrawList->AddCircleFilled(ImVec2(ellipsis_max, label_pos.y), 40, IM_COL32_WHITE);
2954:     RenderTextEllipsis(window->DrawList, label_pos, ImVec2(ellipsis_max, bb.Max.y), ellipsis_max, label, label_end, &label_size);
2955:     const bool text_clipped = label_size.x > (ellipsis_max - label_pos.x);
2956:     if (text_clipped && hovered && g.ActiveId == 0)
2957:         SetItemTooltip("%.*s", (int)(label_end - label), label);
2958:     // We don't use BeginPopupContextItem() because we want the popup to stay up even after the column is hidden
2959:     if (IsMouseReleased(1) && IsItemHovered())
2960:         TableOpenContextMenu(column_n);
2961: }
