3151: // Output context menu into current window (generally a popup)
3152: // FIXME-TABLE: Ideally this should be writable by the user. Full programmatic access to that data?
3153: // Sections to display are pulled from 'flags_for_section_to_display', which is typically == table->Flags.
3154: // - ImGuiTableFlags_Resizable   -> display Sizing menu items
3155: // - ImGuiTableFlags_Reorderable -> display "Reset Order"
3156: ////- ImGuiTableFlags_Sortable   -> display sorting options (disabled)
3157: // - ImGuiTableFlags_Hideable    -> display columns visibility menu items
3158: // It means if you have a custom context menus you can call this section and omit some sections, and add your own.
3159: void ImGui::TableDrawDefaultContextMenu(ImGuiTable* table, ImGuiTableFlags flags_for_section_to_display)
3160: {
3161:     ImGuiContext& g = *GImGui;
3162:     ImGuiWindow* window = g.CurrentWindow;
3163:     if (window->SkipItems)
3164:         return;
3165:     bool want_separator = false;
3166:     const int column_n = (table->ContextPopupColumn >= 0 && table->ContextPopupColumn < table->ColumnsCount) ? table->ContextPopupColumn : -1;
