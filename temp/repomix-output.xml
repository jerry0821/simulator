 10: #include <string>
 11: #include "WICTextureLoader11.h"
 12: using namespace DirectX;
 13: static constexpr int TEXTURE_MAX = 1024; // テクスチャ管理最大数
 14: struct Texture
 15: {
 16: 	std::wstring filename;
 17: 	unsigned int width;
 18: 	unsigned int height;
 19: 	ID3D11Resource* pTexture = nullptr;
 20: 	ID3D11ShaderResourceView* pTextureView = nullptr;
 21: };
 22: static Texture g_Textures[TEXTURE_MAX]{};
 23: static int g_SetTextureIndex = -1;
 24: // 注意！初期化で外部から設定されるもの。Release不要。
 25: static ID3D11Device* g_pDevice = nullptr;
 26: static ID3D11DeviceContext* g_pContext = nullptr;
 27: void Texture_Initialize(ID3D11Device* pDevice, ID3D11DeviceContext* pContext)
 28: {
 29: 	for (Texture& t : g_Textures){
 30: 		t.pTexture = nullptr;
 31: 	}
 32: 	g_SetTextureIndex = -1;
 33: 	// デバイスとデバイスコンテキストの保存
 34: 	g_pDevice = pDevice;
 35: 	g_pContext = pContext;
 36: }
 37: void Texture_Finalize(void)
 38: {
 39: 	Texture_AllRelease();
 40: }
 41: int Texture_Load(const wchar_t* pFiliname)
 42: {
 43: 	// すでに読み込んだファイルは読み込まない
 44: 	for (int i = 0; i < TEXTURE_MAX; i++) {
 45: 		if (g_Textures[i].filename == pFiliname) {
 46: 			return i;
 47: 		}
 48: 	}
 49: 	// 空いている管理領域を探す
 50: 	for (int i = 0; i < TEXTURE_MAX; i++)
 51: 	{
 52: 		if (g_Textures[i].pTexture) continue; // 使用中
 53: 		HRESULT hr;
 54: 		hr = CreateWICTextureFromFile(g_pDevice, g_pContext, pFiliname, &g_Textures[i].pTexture, &g_Textures[i].pTextureView);
 55: 		ID3D11Texture2D* pTexture = (ID3D11Texture2D*)g_Textures[i].pTexture;
 56: 		D3D11_TEXTURE2D_DESC t2desc;
 57: 		pTexture->GetDesc(&t2desc);
 58: 		g_Textures[i].width = t2desc.Width;
 59: 		g_Textures[i].height = t2desc.Height;
 60: 		// テクスチャの読み込み
 61: 		//TexMetadata metadata;
 62: 		//ScratchImage image;
 63: 		//
 64: 		//HRESULT hr = LoadFromWICFile(pFiliname, WIC_FLAGS_NONE, &metadata, image);
 65: 		if (FAILED(hr)) {
 66: 			MessageBoxW(nullptr, L"テクスチャの初期化に失敗しました", pFiliname, MB_OK | MB_ICONERROR);
 67: 			return -1;
 68: 		}
 69: 		g_Textures[i].filename = pFiliname;
 70: 		//g_Textures[i].width = (unsigned int) metadata.width;
 71: 		//g_Textures[i].height = (unsigned int) metadata.height;
 72: 		//hr = CreateShaderResourceView(g_pDevice,
 73: 		//	image.GetImages(), image.GetImageCount(), metadata, &g_Textures[i].pTexture);
 74: 		return i;
 75: 	}
 76: 	return -1; // 管理領域が満杯になったら返す
 77: }
 78: void Texture_AllRelease()
 79: {
 80: 	for (Texture& t : g_Textures) {
 81: 		t.filename.clear();
 82: 		SAFE_RELEASE(t.pTexture);
 83: 		SAFE_RELEASE(t.pTextureView);
 84: 	}
 85: }
 86: void Texture_SetTexture(int texid, int slot)
 87: {
 88: 	//if (texid < 0) return;
 89: 	//
 90: 	//g_SetTextureIndex = texid;
 91: 	//
 92: 	//// テクスチャ設定
 93: 	//g_pContext->PSSetShaderResources(slot, 1, & g_Textures[texid].pTextureView);
 94: 	if (texid < 0)
 95: 	{
 96: 		ID3D11ShaderResourceView* nullSRV = nullptr;
 97: 		// 將該 Slot 設定為 NULL (清空貼圖)
 98: 		g_pContext->PSSetShaderResources(slot, 1, &nullSRV);
 99: 		g_SetTextureIndex = -1;
100: 		return;
101: 	}
102: 	g_SetTextureIndex = texid;
103: 	// テクスチャ設定
104: 	g_pContext->PSSetShaderResources(slot, 1, &g_Textures[texid].pTextureView);
105: }
106: unsigned int Texture_Width(int texid)
107: {
108: 	if (texid < 0) return 0;
109: 	return g_Textures[texid].width;
110: }
