  8: #include "light.h"
  9: using namespace DirectX;
 10: #include "direct3d.h"
 11: static ID3D11Buffer* g_pPSConstantBuffer1 = nullptr; // ambient
 12: static ID3D11Buffer* g_pPSConstantBuffer2 = nullptr; // directional
 13: static ID3D11Buffer* g_pPSConstantBuffer3 = nullptr; // specular
 14: static ID3D11Buffer* g_pPSConstantBuffer4 = nullptr; // point
 15: // 注意！初期化で外部から設定されるもの。Release不要。
 16: static ID3D11Device* g_pDevice = nullptr;
 17: static ID3D11DeviceContext* g_pContext = nullptr;
 18: static XMFLOAT4 g_CurrentLightDir = XMFLOAT4(0.0f, -1.0f, 0.0f, 0.0f);
 19: // 並行光源
 20: struct DirectionalLight 
 21: {
 22: 	XMFLOAT4 Directional;
 23: 	XMFLOAT4 Color;
 24: };
 25: // 鏡面反射光源
 26: struct SpecularLight
 27: {
 28: 	XMFLOAT3 CameraPosition;
 29: 	float Power;
 30: 	XMFLOAT4 Color;
 31: };
 32: // 点光源(ポイントライト)
 33: struct PointLight
 34: {
 35: 	XMFLOAT3 LightPosition;
 36: 	float Range;
 37: 	XMFLOAT4 Color;
 38: 	//float SpecularPower;
 39: 	//XMFLOAT3 SpecularColor;
 40: };
 41: struct PointLightList
 42: {
 43: 	PointLight light[4];
 44: 	int count;
 45: 	XMFLOAT3 dummy;
 46: };
 47: static PointLightList g_PointLights{};
 48: void Light_Initialize(ID3D11Device* pDevice, ID3D11DeviceContext* pContext)
 49: {
 50: 	// デバイスとデバイスコンテキストの保存
 51: 	g_pDevice = pDevice;
 52: 	g_pContext = pContext;
 53: 	// 頂点シェーダー用定数バッファの作成
 54: 	D3D11_BUFFER_DESC buffer_desc{};
 55: 	buffer_desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER; // バインドフラグ
 56: 	buffer_desc.ByteWidth = sizeof(XMFLOAT4); // バッファのサイズ
 57: 	g_pDevice->CreateBuffer(&buffer_desc, nullptr, &g_pPSConstantBuffer1); // ambient
 58: 	buffer_desc.ByteWidth = sizeof(DirectionalLight); // バッファのサイズ
 59: 	g_pDevice->CreateBuffer(&buffer_desc, nullptr, &g_pPSConstantBuffer2); // directional
 60: 	buffer_desc.ByteWidth = sizeof(SpecularLight); // バッファのサイズ
 61: 	g_pDevice->CreateBuffer(&buffer_desc, nullptr, &g_pPSConstantBuffer3); // specular
 62: 	buffer_desc.ByteWidth = sizeof(PointLightList); // バッファのサイズ
 63: 	g_pDevice->CreateBuffer(&buffer_desc, nullptr, &g_pPSConstantBuffer4); // point
