105: /** @def AI_INT_MERGE_SCENE_RESOLVE_CROSS_ATTACHMENTS
106:  * If attachment nodes are not found in the given master scene,
107:  * search the other imported scenes for them in an any order.
108:  */
109: #define AI_INT_MERGE_SCENE_RESOLVE_CROSS_ATTACHMENTS 0x8
110: /** @def AI_INT_MERGE_SCENE_GEN_UNIQUE_NAMES_IF_NECESSARY
111:  * Can be combined with AI_INT_MERGE_SCENE_GEN_UNIQUE_NAMES.
112:  * Unique names are generated, but only if this is absolutely
113:  * required to avoid name conflicts.
114:  */
115: #define AI_INT_MERGE_SCENE_GEN_UNIQUE_NAMES_IF_NECESSARY 0x10
116: typedef std::pair<aiBone *, unsigned int> BoneSrcIndex;
117: // ---------------------------------------------------------------------------
118: /** @brief Helper data structure for SceneCombiner::MergeBones.
119:  */
120: struct BoneWithHash : public std::pair<uint32_t, aiString *> {
121:     std::vector<BoneSrcIndex> pSrcBones;
122: };
123: // ---------------------------------------------------------------------------
124: /** @brief Utility for SceneCombiner
125:  */
126: struct SceneHelper {
127:     SceneHelper() :
128:             scene(nullptr),
129:             idlen(0) {
130:         id[0] = 0;
131:     }
132:     explicit SceneHelper(aiScene *_scene) :
133:             scene(_scene), idlen(0) {
134:         id[0] = 0;
135:     }
136:     AI_FORCE_INLINE aiScene *operator->() const {
137:         return scene;
138:     }
139:     // scene we're working on
140:     aiScene *scene;
141:     // prefix to be added to all identifiers in the scene ...
142:     char id[32];
143:     // and its strlen()
144:     unsigned int idlen;
145:     // hash table to quickly check whether a name is contained in the scene
146:     std::set<unsigned int> hashes;
147: };
148: // ---------------------------------------------------------------------------
149: /** \brief Static helper class providing various utilities to merge two
150:  *    scenes. It is intended as internal utility and NOT for use by
151:  *    applications.
152:  *
153:  * The class is currently being used by various postprocessing steps
154:  * and loaders (ie. LWS).
155:  */
156: class ASSIMP_API SceneCombiner {
157:     // class cannot be instanced
158:     SceneCombiner() {
159:         // empty
160:     }
161:     ~SceneCombiner() {
162:         // empty
163:     }
164: public:
165:     // -------------------------------------------------------------------
166:     /** Merges two or more scenes.
167:      *
168:      *  @param dest  Receives a pointer to the destination scene. If the
169:      *    pointer doesn't point to nullptr when the function is called, the
170:      *    existing scene is cleared and refilled.
171:      *  @param src Non-empty list of scenes to be merged. The function
172:      *    deletes the input scenes afterwards. There may be duplicate scenes.
173:      *  @param flags Combination of the AI_INT_MERGE_SCENE flags defined above
174:      */
175:     static void MergeScenes(aiScene **dest, std::vector<aiScene *> &src,
176:             unsigned int flags = 0);
177:     // -------------------------------------------------------------------
178:     /** Merges two or more scenes and attaches all scenes to a specific
179:      *  position in the node graph of the master scene.
180:      *
181:      *  @param dest Receives a pointer to the destination scene. If the
182:      *    pointer doesn't point to nullptr when the function is called, the
183:      *    existing scene is cleared and refilled.
184:      *  @param master Master scene. It will be deleted afterwards. All
185:      *    other scenes will be inserted in its node graph.
186:      *  @param src Non-empty list of scenes to be merged along with their
187:      *    corresponding attachment points in the master scene. The function
188:      *    deletes the input scenes afterwards. There may be duplicate scenes.
189:      *  @param flags Combination of the AI_INT_MERGE_SCENE flags defined above
190:      */
191:     static void MergeScenes(aiScene **dest, aiScene *master,
192:             std::vector<AttachmentInfo> &src,
193:             unsigned int flags = 0);
194:     // -------------------------------------------------------------------
195:     /** Merges two or more meshes
196:      *
197:      *  The meshes should have equal vertex formats. Only components
198:      *  that are provided by ALL meshes will be present in the output mesh.
199:      *  An exception is made for VColors - they are set to black. The
200:      *  meshes should have the same material indices, too. The output
201:      *  material index is always the material index of the first mesh.
202:      *
203:      *  @param dest Destination mesh. Must be empty.
204:      *  @param flags Currently no parameters
205:      *  @param begin First mesh to be processed
206:      *  @param end Points to the mesh after the last mesh to be processed
207:      */
208:     static void MergeMeshes(aiMesh **dest, unsigned int flags,
209:             std::vector<aiMesh *>::const_iterator begin,
210:             std::vector<aiMesh *>::const_iterator end);
211:     // -------------------------------------------------------------------
212:     /** Merges two or more bones
213:      *
214:      *  @param out Mesh to receive the output bone list
215:      *  @param flags Currently no parameters
216:      *  @param begin First mesh to be processed
217:      *  @param end Points to the mesh after the last mesh to be processed
218:      */
219:     static void MergeBones(aiMesh *out, std::vector<aiMesh *>::const_iterator it,
220:             std::vector<aiMesh *>::const_iterator end);
221:     // -------------------------------------------------------------------
222:     /** Merges two or more materials
223:      *
224:      *  The materials should be complementary as much as possible. In case
225:      *  of a property present in different materials, the first occurrence
226:      *  is used.
227:      *
228:      *  @param dest Destination material. Must be empty.
229:      *  @param begin First material to be processed
230:      *  @param end Points to the material after the last material to be processed
231:      */
232:     static void MergeMaterials(aiMaterial **dest,
233:             std::vector<aiMaterial *>::const_iterator begin,
234:             std::vector<aiMaterial *>::const_iterator end);
235:     // -------------------------------------------------------------------
236:     /** Builds a list of uniquely named bones in a mesh list
237:      *
238:      *  @param asBones Receives the output list
239:      *  @param it First mesh to be processed
240:      *  @param end Last mesh to be processed
241:      */
242:     static void BuildUniqueBoneList(std::list<BoneWithHash> &asBones,
243:             std::vector<aiMesh *>::const_iterator it,
244:             std::vector<aiMesh *>::const_iterator end);
245:     // -------------------------------------------------------------------
246:     /** Add a name prefix to all nodes in a scene.
247:      *
248:      *  @param Current node. This function is called recursively.
249:      *  @param prefix Prefix to be added to all nodes
250:      *  @param len STring length
251:      */
252:     static void AddNodePrefixes(aiNode *node, const char *prefix,
253:             unsigned int len);
254:     // -------------------------------------------------------------------
255:     /** Add an offset to all mesh indices in a node graph
256:      *
257:      *  @param Current node. This function is called recursively.
258:      *  @param offset Offset to be added to all mesh indices
259:      */
260:     static void OffsetNodeMeshIndices(aiNode *node, unsigned int offset);
261:     // -------------------------------------------------------------------
262:     /** Attach a list of node graphs to well-defined nodes in a master
263:      *  graph. This is a helper for MergeScenes()
264:      *
265:      *  @param master Master scene
266:      *  @param srcList List of source scenes along with their attachment
267:      *    points. If an attachment point is nullptr (or does not exist in
268:      *    the master graph), a scene is attached to the root of the master
269:      *    graph (as an additional child node)
270:      *  @duplicates List of duplicates. If elem[n] == n the scene is not
271:      *    a duplicate. Otherwise elem[n] links scene n to its first occurrence.
272:      */
273:     static void AttachToGraph(aiScene *master,
274:             std::vector<NodeAttachmentInfo> &srcList);
275:     static void AttachToGraph(aiNode *attach,
276:             std::vector<NodeAttachmentInfo> &srcList);
277:     // -------------------------------------------------------------------
278:     /** Get a deep copy of a scene
279:      *
280:      *  @param dest Receives a pointer to the destination scene
281:      *  @param src Source scene - remains unmodified.
282:      */
283:     static void CopyScene(aiScene **dest, const aiScene *source, bool allocate = true);
284:     // -------------------------------------------------------------------
285:     /** Get a flat copy of a scene
286:      *
287:      *  Only the first hierarchy layer is copied. All pointer members of
288:      *  aiScene are shared by source and destination scene.  If the
289:      *    pointer doesn't point to nullptr when the function is called, the
290:      *    existing scene is cleared and refilled.
291:      *  @param dest Receives a pointer to the destination scene
292:      *  @param src Source scene - remains unmodified.
293:      */
294:     static void CopySceneFlat(aiScene **dest, const aiScene *source);
295:     // -------------------------------------------------------------------
296:     /** Get a deep copy of a mesh
297:      *
298:      *  @param dest Receives a pointer to the destination mesh
299:      *  @param src Source mesh - remains unmodified.
300:      */
301:     static void Copy(aiMesh **dest, const aiMesh *src);
302:     // similar to Copy():
303:     static void Copy(aiAnimMesh **dest, const aiAnimMesh *src);
304:     static void Copy(aiMaterial **dest, const aiMaterial *src);
305:     static void Copy(aiTexture **dest, const aiTexture *src);
306:     static void Copy(aiAnimation **dest, const aiAnimation *src);
307:     static void Copy(aiCamera **dest, const aiCamera *src);
308:     static void Copy(aiBone **dest, const aiBone *src);
309:     static void Copy(aiLight **dest, const aiLight *src);
310:     static void Copy(aiNodeAnim **dest, const aiNodeAnim *src);
311:     static void Copy(aiMeshMorphAnim **dest, const aiMeshMorphAnim *src);
312:     static void Copy(aiMetadata **dest, const aiMetadata *src);
313:     static void Copy(aiString **dest, const aiString *src);
314:     // recursive, of course
315:     static void Copy(aiNode **dest, const aiNode *src);
316: private:
317:     // -------------------------------------------------------------------
318:     // Same as AddNodePrefixes, but with an additional check
319:     static void AddNodePrefixesChecked(aiNode *node, const char *prefix,
320:             unsigned int len,
321:             std::vector<SceneHelper> &input,
322:             unsigned int cur);
323:     // -------------------------------------------------------------------
324:     // Add node identifiers to a hashing set
325:     static void AddNodeHashes(aiNode *node, std::set<unsigned int> &hashes);
326:     // -------------------------------------------------------------------
327:     // Search for duplicate names
328:     static bool FindNameMatch(const aiString &name,
329:             std::vector<SceneHelper> &input, unsigned int cur);
330: };
331: } // namespace Assimp
332: #endif // !! AI_SCENE_COMBINER_H_INC
