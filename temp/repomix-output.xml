 9623:     IM_ASSERT(window->DC.IsSetPos);
 9624:     window->DC.IsSetPos = false;
 9625:     if (window->DC.CursorPos.x <= window->DC.CursorMaxPos.x && window->DC.CursorPos.y <= window->DC.CursorMaxPos.y)
 9626:         return;
 9627:     if (window->SkipItems)
 9628:         return;
 9629:     IM_ASSERT_USER_ERROR(0, "Code uses SetCursorPos()/SetCursorScreenPos() to extend window/parent boundaries.\nPlease submit an item e.g. Dummy() afterwards in order to grow window/parent boundaries.");
