 405: // Initialize before use in a new frame. We always have a command ready in the buffer.
 406: // In the majority of cases, you would want to call PushClipRect() and PushTexture() after this.
 407: void ImDrawList::_ResetForNewFrame()
 408: {
 409:     // Verify that the ImDrawCmd fields we want to memcmp() are contiguous in memory to match ImDrawCmdHeader.
 410:     IM_STATIC_ASSERT(offsetof(ImDrawCmd, ClipRect) == 0);
 411:     IM_STATIC_ASSERT(offsetof(ImDrawCmd, TexRef) == sizeof(ImVec4));
 412:     IM_STATIC_ASSERT(offsetof(ImDrawCmd, VtxOffset) == sizeof(ImVec4) + sizeof(ImTextureRef));
 413:     IM_STATIC_ASSERT(offsetof(ImDrawCmd, ClipRect) == offsetof(ImDrawCmdHeader, ClipRect));
 414:     IM_STATIC_ASSERT(offsetof(ImDrawCmd, TexRef) == offsetof(ImDrawCmdHeader, TexRef));
 415:     IM_STATIC_ASSERT(offsetof(ImDrawCmd, VtxOffset) == offsetof(ImDrawCmdHeader, VtxOffset));
 416:     if (_Splitter._Count > 1)
 417:         _Splitter.Merge(this);
 418:     CmdBuffer.resize(0);
 419:     IdxBuffer.resize(0);
 420:     VtxBuffer.resize(0);
 421:     Flags = _Data->InitialFlags;
 422:     memset(&_CmdHeader, 0, sizeof(_CmdHeader));
 423:     _VtxCurrentIdx = 0;
 424:     _VtxWritePtr = NULL;
 425:     _IdxWritePtr = NULL;
 426:     _ClipRectStack.resize(0);
 427:     _TextureStack.resize(0);
 428:     _CallbacksDataBuf.resize(0);
 429:     _Path.resize(0);
 430:     _Splitter.Clear();
 431:     CmdBuffer.push_back(ImDrawCmd());
 432:     _FringeScale = _Data->InitialFringeScale;
 433: }
 434: void ImDrawList::_ClearFreeMemory()
 435: {
 436:     CmdBuffer.clear();
 437:     IdxBuffer.clear();
 438:     VtxBuffer.clear();
 439:     Flags = ImDrawListFlags_None;
 440:     _VtxCurrentIdx = 0;
 441:     _VtxWritePtr = NULL;
 442:     _IdxWritePtr = NULL;
 443:     _ClipRectStack.clear();
 444:     _TextureStack.clear();
 445:     _CallbacksDataBuf.clear();
 446:     _Path.clear();
 447:     _Splitter.ClearFreeMemory();
 448: }
 449: // Note: For multi-threaded rendering, consider using `imgui_threaded_rendering` from https://github.com/ocornut/imgui_club
 450: ImDrawList* ImDrawList::CloneOutput() const
 451: {
 452:     ImDrawList* dst = IM_NEW(ImDrawList(NULL));
 453:     dst->CmdBuffer = CmdBuffer;
 454:     dst->IdxBuffer = IdxBuffer;
 455:     dst->VtxBuffer = VtxBuffer;
 456:     dst->Flags = Flags;
