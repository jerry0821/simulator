5110:         g.ColorEditCurrentID = window->IDStack.back();
5111:     // If we're not showing any slider there's no point in doing any HSV conversions
5112:     const ImGuiColorEditFlags flags_untouched = flags;
5113:     if (flags & ImGuiColorEditFlags_NoInputs)
5114:         flags = (flags & (~ImGuiColorEditFlags_DisplayMask_)) | ImGuiColorEditFlags_DisplayRGB | ImGuiColorEditFlags_NoOptions;
