14: static ID3D11SamplerState* g_pSamplerFilterLinear = nullptr;
15: static ID3D11SamplerState* g_pSamplerFilterAnisotropic = nullptr;
16: void Sampler_Initialize(ID3D11Device* pDevice, ID3D11DeviceContext* pContext)
17: {
18: 	// デバイスとデバイスコンテキストの保存
19: 	g_pDevice = pDevice;
20: 	g_pContext = pContext;
21: 	// サンプラーステート設定
22: 	D3D11_SAMPLER_DESC sampler_desc{};
23: 	// フィルタリング
24: 	sampler_desc.Filter = D3D11_FILTER_ANISOTROPIC;
25: 	sampler_desc.AddressU = D3D11_TEXTURE_ADDRESS_WRAP;
26: 	sampler_desc.AddressV = D3D11_TEXTURE_ADDRESS_WRAP;
27: 	sampler_desc.AddressW = D3D11_TEXTURE_ADDRESS_WRAP;
28: 	sampler_desc.BorderColor[0] = 0.0f;
29: 	sampler_desc.BorderColor[1] = 0.0f;
30: 	sampler_desc.BorderColor[2] = 0.0f;
31: 	sampler_desc.BorderColor[3] = 0.0f;
32: 	sampler_desc.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
33: 	sampler_desc.MipLODBias = 0;
34: 	sampler_desc.MaxAnisotropy = 16;
35: 	sampler_desc.ComparisonFunc = D3D11_COMPARISON_ALWAYS;
36: 	sampler_desc.MinLOD = 0;
37: 	sampler_desc.MaxLOD = D3D11_FLOAT32_MAX;
38: 	g_pDevice->CreateSamplerState(&sampler_desc, &g_pSamplerFilterPoint);
39: 	// フィルタリング
40: 	sampler_desc.Filter = D3D11_FILTER_MINIMUM_MIN_MAG_MIP_LINEAR;
41: 	g_pDevice->CreateSamplerState(&sampler_desc, &g_pSamplerFilterLinear);
42: 	// フィルタリング
43: 	sampler_desc.Filter = D3D11_FILTER_ANISOTROPIC;
44: 	g_pDevice->CreateSamplerState(&sampler_desc, &g_pSamplerFilterAnisotropic);
45: }
46: void Sampler_Finalize()
47: {
48: 	SAFE_RELEASE(g_pSamplerFilterAnisotropic);
49: 	SAFE_RELEASE(g_pSamplerFilterLinear);
50: 	SAFE_RELEASE(g_pSamplerFilterPoint);
51: }
52: void Sampler_SetFilterPoint()
53: {
54: 	g_pContext->PSSetSamplers(0, 1, &g_pSamplerFilterPoint);
55: 	g_pContext->VSSetSamplers(0, 1, &g_pSamplerFilterPoint);
