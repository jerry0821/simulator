 2965: void ImGuiListClipper::SeekCursorForItem(int item_n)
 2966: {
 2967:     // - Perform the add and multiply with double to allow seeking through larger ranges.
 2968:     // - StartPosY starts from ItemsFrozen, by adding SeekOffsetY we generally cancel that out (SeekOffsetY == LossynessOffset - ItemsFrozen * ItemsHeight).
 2969:     // - The reason we store SeekOffsetY instead of inferring it, is because we want to allow user to perform Seek after the last step, where ImGuiListClipperData is already done.
 2970:     float pos_y = (float)((double)StartPosY + StartSeekOffsetY + (double)item_n * ItemsHeight);
 2971:     ImGuiListClipper_SeekCursorAndSetupPrevLine(this, pos_y, ItemsHeight);
 2972: }
 2973: static bool ImGuiListClipper_StepInternal(ImGuiListClipper* clipper)
 2974: {
 2975:     ImGuiContext& g = *clipper->Ctx;
 2976:     ImGuiWindow* window = g.CurrentWindow;
 2977:     ImGuiListClipperData* data = (ImGuiListClipperData*)clipper->TempData;
 2978:     IM_ASSERT(data != NULL && "Called ImGuiListClipper::Step() too many times, or before ImGuiListClipper::Begin() ?");
 2979:     ImGuiTable* table = g.CurrentTable;
 2980:     if (table && table->IsInsideRow)
 2981:         ImGui::TableEndRow(table);
 2982:     // No items
 2983:     if (clipper->ItemsCount == 0 || GetSkipItemForListClipping())
 2984:         return false;
 2985:     // While we are in frozen row state, keep displaying items one by one, unclipped
 2986:     // FIXME: Could be stored as a table-agnostic state.
 2987:     if (data->StepNo == 0 && table != NULL && !table->IsUnfrozenRows)
 2988:     {
 2989:         clipper->DisplayStart = data->ItemsFrozen;
 2990:         clipper->DisplayEnd = ImMin(data->ItemsFrozen + 1, clipper->ItemsCount);
 2991:         if (clipper->DisplayStart < clipper->DisplayEnd)
 2992:             data->ItemsFrozen++;
 2993:         return true;
 2994:     }
 2995:     // Step 0: Let you process the first element (regardless of it being visible or not, so we can measure the element height)
 2996:     bool calc_clipping = false;
 2997:     if (data->StepNo == 0)
 2998:     {
 2999:         clipper->StartPosY = window->DC.CursorPos.y;
 3000:         if (clipper->ItemsHeight <= 0.0f)
 3001:         {
 3002:             // Submit the first item (or range) so we can measure its height (generally the first range is 0..1)
 3003:             data->Ranges.push_front(ImGuiListClipperRange::FromIndices(data->ItemsFrozen, data->ItemsFrozen + 1));
 3004:             clipper->DisplayStart = ImMax(data->Ranges[0].Min, data->ItemsFrozen);
 3005:             clipper->DisplayEnd = ImMin(data->Ranges[0].Max, clipper->ItemsCount);
 3006:             data->StepNo = 1;
 3007:             return true;
 3008:         }
 3009:         calc_clipping = true;   // If on the first step with known item height, calculate clipping.
 3010:     }
 3011:     // Step 1: Let the clipper infer height from first range
 3012:     if (clipper->ItemsHeight <= 0.0f)
 3013:     {
 3014:         IM_ASSERT(data->StepNo == 1);
 3015:         if (table)
 3016:             IM_ASSERT(table->RowPosY1 == clipper->StartPosY && table->RowPosY2 == window->DC.CursorPos.y);
 3017:         bool affected_by_floating_point_precision = ImIsFloatAboveGuaranteedIntegerPrecision((float)clipper->StartPosY) || ImIsFloatAboveGuaranteedIntegerPrecision(window->DC.CursorPos.y);
 3018:         if (affected_by_floating_point_precision)
 3019:         {
 3020:             // Mitigation/hack for very large range: assume last time height constitute line height.
 3021:             clipper->ItemsHeight = window->DC.PrevLineSize.y + g.Style.ItemSpacing.y; // FIXME: Technically wouldn't allow multi-line entries.
 3022:             window->DC.CursorPos.y = (float)(clipper->StartPosY + clipper->ItemsHeight);
 3023:         }
 3024:         else
 3025:         {
 3026:             clipper->ItemsHeight = (float)(window->DC.CursorPos.y - clipper->StartPosY) / (float)(clipper->DisplayEnd - clipper->DisplayStart);
 3027:         }
 3028:         if (clipper->ItemsHeight == 0.0f && clipper->ItemsCount == INT_MAX) // Accept that no item have been submitted if in indeterminate mode.
 3029:             return false;
 3030:         IM_ASSERT(clipper->ItemsHeight > 0.0f && "Unable to calculate item height! First item hasn't moved the cursor vertically!");
 3031:         calc_clipping = true;   // If item height had to be calculated, calculate clipping afterwards.
 3032:     }
 3033:     // Step 0 or 1: Calculate the actual ranges of visible elements.
 3034:     const int already_submitted = clipper->DisplayEnd;
 3035:     if (calc_clipping)
 3036:     {
 3037:         // Record seek offset, this is so ImGuiListClipper::Seek() can be called after ImGuiListClipperData is done
 3038:         clipper->StartSeekOffsetY = (double)data->LossynessOffset - data->ItemsFrozen * (double)clipper->ItemsHeight;
 3039:         if (g.LogEnabled)
 3040:         {
 3041:             // If logging is active, do not perform any clipping
 3042:             data->Ranges.push_back(ImGuiListClipperRange::FromIndices(0, clipper->ItemsCount));
 3043:         }
 3044:         else
 3045:         {
 3046:             // Add range selected to be included for navigation
 3047:             const bool is_nav_request = (g.NavMoveScoringItems && g.NavWindow && g.NavWindow->RootWindowForNav == window->RootWindowForNav);
 3048:             const int nav_off_min = (is_nav_request && g.NavMoveClipDir == ImGuiDir_Up) ? -1 : 0;
 3049:             const int nav_off_max = (is_nav_request && g.NavMoveClipDir == ImGuiDir_Down) ? 1 : 0;
 3050:             if (is_nav_request)
 3051:             {
 3052:                 data->Ranges.push_back(ImGuiListClipperRange::FromPositions(g.NavScoringRect.Min.y, g.NavScoringRect.Max.y, nav_off_min, nav_off_max));
 3053:                 data->Ranges.push_back(ImGuiListClipperRange::FromPositions(g.NavScoringNoClipRect.Min.y, g.NavScoringNoClipRect.Max.y, nav_off_min, nav_off_max));
 3054:             }
 3055:             if (is_nav_request && (g.NavMoveFlags & ImGuiNavMoveFlags_IsTabbing) && g.NavTabbingDir == -1)
 3056:                 data->Ranges.push_back(ImGuiListClipperRange::FromIndices(clipper->ItemsCount - 1, clipper->ItemsCount));
 3057:             // Add focused/active item
 3058:             ImRect nav_rect_abs = ImGui::WindowRectRelToAbs(window, window->NavRectRel[0]);
 3059:             if (g.NavId != 0 && window->NavLastIds[0] == g.NavId)
 3060:                 data->Ranges.push_back(ImGuiListClipperRange::FromPositions(nav_rect_abs.Min.y, nav_rect_abs.Max.y, 0, 0));
 3061:             float min_y = window->ClipRect.Min.y;
 3062:             float max_y = window->ClipRect.Max.y;
 3063:             // Add box selection range
 3064:             ImGuiBoxSelectState* bs = &g.BoxSelectState;
 3065:             if (bs->IsActive && bs->Window == window)
 3066:             {
 3067:                 // FIXME: Selectable() use of half-ItemSpacing isn't consistent in matter of layout, as ItemAdd(bb) stray above ItemSize()'s CursorPos.
 3068:                 // RangeSelect's BoxSelect relies on comparing overlap of previous and current rectangle and is sensitive to that.
 3069:                 // As a workaround we currently half ItemSpacing worth on each side.
 3070:                 min_y -= g.Style.ItemSpacing.y;
 3071:                 max_y += g.Style.ItemSpacing.y;
 3072:                 // Box-select on 2D area requires different clipping.
 3073:                 if (bs->UnclipMode)
 3074:                     data->Ranges.push_back(ImGuiListClipperRange::FromPositions(bs->UnclipRect.Min.y, bs->UnclipRect.Max.y, 0, 0));
 3075:             }
 3076:             // Add main visible range
 3077:             data->Ranges.push_back(ImGuiListClipperRange::FromPositions(min_y, max_y, nav_off_min, nav_off_max));
 3078:         }
 3079:         // Convert position ranges to item index ranges
 3080:         // - Very important: when a starting position is after our maximum item, we set Min to (ItemsCount - 1). This allows us to handle most forms of wrapping.
 3081:         // - Due to how Selectable extra padding they tend to be "unaligned" with exact unit in the item list,
 3082:         //   which with the flooring/ceiling tend to lead to 2 items instead of one being submitted.
 3083:         for (ImGuiListClipperRange& range : data->Ranges)
 3084:             if (range.PosToIndexConvert)
 3085:             {
 3086:                 int m1 = (int)(((double)range.Min - window->DC.CursorPos.y - data->LossynessOffset) / clipper->ItemsHeight);
 3087:                 int m2 = (int)((((double)range.Max - window->DC.CursorPos.y - data->LossynessOffset) / clipper->ItemsHeight) + 0.999999f);
 3088:                 range.Min = ImClamp(already_submitted + m1 + range.PosToIndexOffsetMin, already_submitted, clipper->ItemsCount - 1);
 3089:                 range.Max = ImClamp(already_submitted + m2 + range.PosToIndexOffsetMax, range.Min + 1, clipper->ItemsCount);
 3090:                 range.PosToIndexConvert = false;
 3091:             }
 3092:         ImGuiListClipper_SortAndFuseRanges(data->Ranges, data->StepNo);
 3093:     }
 3094:     // Step 0+ (if item height is given in advance) or 1+: Display the next range in line.
 3095:     while (data->StepNo < data->Ranges.Size)
 3096:     {
 3097:         clipper->DisplayStart = ImMax(data->Ranges[data->StepNo].Min, already_submitted);
 3098:         clipper->DisplayEnd = ImMin(data->Ranges[data->StepNo].Max, clipper->ItemsCount);
 3099:         data->StepNo++;
 3100:         if (clipper->DisplayStart >= clipper->DisplayEnd)
 3101:             continue;
 3102:         if (clipper->DisplayStart > already_submitted)
 3103:             clipper->SeekCursorForItem(clipper->DisplayStart);
 3104:         return true;
 3105:     }
 3106:     // After the last step: Let the clipper validate that we have reached the expected Y position (corresponding to element DisplayEnd),
 3107:     // Advance the cursor to the end of the list and then returns 'false' to end the loop.
 3108:     if (clipper->ItemsCount < INT_MAX)
 3109:         clipper->SeekCursorForItem(clipper->ItemsCount);
 3110:     return false;
 3111: }
 3112: bool ImGuiListClipper::Step()
 3113: {
 3114:     ImGuiContext& g = *Ctx;
 3115:     bool need_items_height = (ItemsHeight <= 0.0f);
 3116:     bool ret = ImGuiListClipper_StepInternal(this);
 3117:     if (ret && (DisplayStart >= DisplayEnd))
 3118:         ret = false;
 3119:     if (g.CurrentTable && g.CurrentTable->IsUnfrozenRows == false)
 3120:         IMGUI_DEBUG_LOG_CLIPPER("Clipper: Step(): inside frozen table row.\n");
 3121:     if (need_items_height && ItemsHeight > 0.0f)
 3122:         IMGUI_DEBUG_LOG_CLIPPER("Clipper: Step(): computed ItemsHeight: %.2f.\n", ItemsHeight);
 3123:     if (ret)
 3124:     {
 3125:         IMGUI_DEBUG_LOG_CLIPPER("Clipper: Step(): display %d to %d.\n", DisplayStart, DisplayEnd);
 3126:     }
 3127:     else
 3128:     {
 3129:         IMGUI_DEBUG_LOG_CLIPPER("Clipper: Step(): End.\n");
 3130:         End();
 3131:     }
 3132:     return ret;
 3133: }
 3134: // Generic helper, equivalent to old ImGui::CalcListClipping() but statelesss
 3135: void ImGui::CalcClipRectVisibleItemsY(const ImRect& clip_rect, const ImVec2& pos, float items_height, int* out_visible_start, int* out_visible_end)
 3136: {
 3137:     *out_visible_start = ImMax((int)((clip_rect.Min.y - pos.y) / items_height), 0);
 3138:     *out_visible_end = ImMax((int)ImCeil((clip_rect.Max.y - pos.y) / items_height), *out_visible_start);
 3139: }
