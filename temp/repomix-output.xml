 2451: const char* ImTextFindPreviousUtf8Codepoint(const char* in_text_start, const char* in_p)
 2452: {
 2453:     while (in_p > in_text_start)
 2454:     {
 2455:         in_p--;
 2456:         if ((*in_p & 0xC0) != 0x80)
 2457:             return in_p;
 2458:     }
