 249: // Helper
 250: inline ImGuiTableFlags TableFixFlags(ImGuiTableFlags flags, ImGuiWindow* outer_window)
 251: {
 252:     // Adjust flags: set default sizing policy
 253:     if ((flags & ImGuiTableFlags_SizingMask_) == 0)
 254:         flags |= ((flags & ImGuiTableFlags_ScrollX) || (outer_window->Flags & ImGuiWindowFlags_AlwaysAutoResize)) ? ImGuiTableFlags_SizingFixedFit : ImGuiTableFlags_SizingStretchSame;
 255:     // Adjust flags: enable NoKeepColumnsVisible when using ImGuiTableFlags_SizingFixedSame
 256:     if ((flags & ImGuiTableFlags_SizingMask_) == ImGuiTableFlags_SizingFixedSame)
 257:         flags |= ImGuiTableFlags_NoKeepColumnsVisible;
 258:     // Adjust flags: enforce borders when resizable
 259:     if (flags & ImGuiTableFlags_Resizable)
 260:         flags |= ImGuiTableFlags_BordersInnerV;
 261:     // Adjust flags: disable NoHostExtendX/NoHostExtendY if we have any scrolling going on
 262:     if (flags & (ImGuiTableFlags_ScrollX | ImGuiTableFlags_ScrollY))
 263:         flags &= ~(ImGuiTableFlags_NoHostExtendX | ImGuiTableFlags_NoHostExtendY);
 264:     // Adjust flags: NoBordersInBodyUntilResize takes priority over NoBordersInBody
 265:     if (flags & ImGuiTableFlags_NoBordersInBodyUntilResize)
 266:         flags &= ~ImGuiTableFlags_NoBordersInBody;
 267:     // Adjust flags: disable saved settings if there's nothing to save
 268:     if ((flags & (ImGuiTableFlags_Resizable | ImGuiTableFlags_Hideable | ImGuiTableFlags_Reorderable | ImGuiTableFlags_Sortable)) == 0)
 269:         flags |= ImGuiTableFlags_NoSavedSettings;
 270:     // Inherit _NoSavedSettings from top-level window (child windows always have _NoSavedSettings set)
 271:     if (outer_window->RootWindow->Flags & ImGuiWindowFlags_NoSavedSettings)
 272:         flags |= ImGuiTableFlags_NoSavedSettings;
 273:     return flags;
 274: }
