 7465: bool ImGui::IsWindowHovered(ImGuiHoveredFlags flags)
 7466: {
 7467:     ImGuiContext& g = *GImGui;
 7468:     IM_ASSERT_USER_ERROR((flags & ~ImGuiHoveredFlags_AllowedMaskForIsWindowHovered) == 0, "Invalid flags for IsWindowHovered()!");
 7469:     ImGuiWindow* ref_window = g.HoveredWindow;
 7470:     ImGuiWindow* cur_window = g.CurrentWindow;
 7471:     if (ref_window == NULL)
 7472:         return false;
 7473:     if ((flags & ImGuiHoveredFlags_AnyWindow) == 0)
 7474:     {
 7475:         IM_ASSERT(cur_window); // Not inside a Begin()/End()
 7476:         const bool popup_hierarchy = (flags & ImGuiHoveredFlags_NoPopupHierarchy) == 0;
 7477:         if (flags & ImGuiHoveredFlags_RootWindow)
 7478:             cur_window = GetCombinedRootWindow(cur_window, popup_hierarchy);
 7479:         bool result;
 7480:         if (flags & ImGuiHoveredFlags_ChildWindows)
 7481:             result = IsWindowChildOf(ref_window, cur_window, popup_hierarchy);
 7482:         else
 7483:             result = (ref_window == cur_window);
 7484:         if (!result)
 7485:             return false;
 7486:     }
 7487:     if (!IsWindowContentHoverable(ref_window, flags))
 7488:         return false;
 7489:     if (!(flags & ImGuiHoveredFlags_AllowWhenBlockedByActiveItem))
 7490:         if (g.ActiveId != 0 && !g.ActiveIdAllowOverlap && g.ActiveId != ref_window->MoveId)
 7491:             return false;
 7492:     // When changing hovered window we requires a bit of stationary delay before activating hover timer.
 7493:     // FIXME: We don't support delay other than stationary one for now, other delay would need a way
 7494:     // to fulfill the possibility that multiple IsWindowHovered() with varying flag could return true
 7495:     // for different windows of the hierarchy. Possibly need a Hash(Current+Flags) ==> (Timer) cache.
 7496:     // We can implement this for _Stationary because the data is linked to HoveredWindow rather than CurrentWindow.
 7497:     if (flags & ImGuiHoveredFlags_ForTooltip)
 7498:         flags = ApplyHoverFlagsForTooltip(flags, g.Style.HoverFlagsForTooltipMouse);
 7499:     if ((flags & ImGuiHoveredFlags_Stationary) != 0 && g.HoverWindowUnlockedStationaryId != ref_window->ID)
 7500:         return false;
 7501:     return true;
 7502: }
