 5043:     // Find hovered window
 5044:     // (needs to be before UpdateMouseMovingWindowNewFrame so we fill g.HoveredWindowUnderMovingWindow on the mouse release frame)
 5045:     // (currently needs to be done after the WasActive=Active loop and FindHoveredWindowEx uses ->Active)
 5046:     UpdateHoveredWindowAndCaptureFlags(g.IO.MousePos);
 5047:     // Handle user moving window with mouse (at the beginning of the frame to avoid input lag or sheering)
 5048:     UpdateMouseMovingWindowNewFrame();
 5049:     // Background darkening/whitening
 5050:     if (GetTopMostPopupModal() != NULL || (g.NavWindowingTarget != NULL && g.NavWindowingHighlightAlpha > 0.0f))
 5051:         g.DimBgRatio = ImMin(g.DimBgRatio + g.IO.DeltaTime * 6.0f, 1.0f);
 5052:     else
 5053:         g.DimBgRatio = ImMax(g.DimBgRatio - g.IO.DeltaTime * 10.0f, 0.0f);
 5054:     g.MouseCursor = ImGuiMouseCursor_Arrow;
 5055:     g.WantCaptureMouseNextFrame = g.WantCaptureKeyboardNextFrame = g.WantTextInputNextFrame = -1;
 5056:     // Platform IME data: reset for the frame
 5057:     g.PlatformImeDataPrev = g.PlatformImeData;
 5058:     g.PlatformImeData.WantVisible = g.PlatformImeData.WantTextInput = false;
 5059:     // Mouse wheel scrolling, scale
 5060:     UpdateMouseWheel();
 5061:     // Garbage collect transient buffers of recently unused tables
 5062:     for (int i = 0; i < g.TablesLastTimeActive.Size; i++)
 5063:         if (g.TablesLastTimeActive[i] >= 0.0f && g.TablesLastTimeActive[i] < memory_compact_start_time)
 5064:             TableGcCompactTransientBuffers(g.Tables.GetByIndex(i));
 5065:     for (ImGuiTableTempData& table_temp_data : g.TablesTempData)
 5066:         if (table_temp_data.LastTimeActive >= 0.0f && table_temp_data.LastTimeActive < memory_compact_start_time)
 5067:             TableGcCompactTransientBuffers(&table_temp_data);
 5068:     if (g.GcCompactAll)
 5069:         GcCompactTransientMiscBuffers();
 5070:     g.GcCompactAll = false;
 5071:     // Closing the focused window restore focus to the first active root window in descending z-order
 5072:     if (g.NavWindow && !g.NavWindow->WasActive)
 5073:         FocusTopMostWindowUnderOne(NULL, NULL, NULL, ImGuiFocusRequestFlags_RestoreFocusedChild);
 5074:     // No window should be open at the beginning of the frame.
 5075:     // But in order to allow the user to call NewFrame() multiple times without calling Render(), we are doing an explicit clear.
 5076:     g.CurrentWindowStack.resize(0);
 5077:     g.BeginPopupStack.resize(0);
 5078:     g.ItemFlagsStack.resize(0);
 5079:     g.ItemFlagsStack.push_back(ImGuiItemFlags_AutoClosePopups); // Default flags
 5080:     g.CurrentItemFlags = g.ItemFlagsStack.back();
 5081:     g.GroupStack.resize(0);
 5082:     // [DEBUG] Update debug features
 5083: #ifndef IMGUI_DISABLE_DEBUG_TOOLS
 5084:     UpdateDebugToolItemPicker();
 5085:     UpdateDebugToolItemPathQuery();
 5086:     UpdateDebugToolFlashStyleColor();
 5087:     if (g.DebugLocateFrames > 0 && --g.DebugLocateFrames == 0)
 5088:     {
 5089:         g.DebugLocateId = 0;
 5090:         g.DebugBreakInLocateId = false;
 5091:     }
 5092:     if (g.DebugLogAutoDisableFrames > 0 && --g.DebugLogAutoDisableFrames == 0)
 5093:     {
 5094:         DebugLog("(Debug Log: Auto-disabled some ImGuiDebugLogFlags after 2 frames)\n");
 5095:         g.DebugLogFlags &= ~g.DebugLogAutoDisableFlags;
 5096:         g.DebugLogAutoDisableFlags = ImGuiDebugLogFlags_None;
 5097:     }
 5098: #endif
 5099:     // Create implicit/fallback window - which we will only render it if the user has added something to it.
 5100:     // We don't use "Debug" to avoid colliding with user trying to create a "Debug" window with custom flags.
 5101:     // This fallback is particularly important as it prevents ImGui:: calls from crashing.
 5102:     g.WithinFrameScopeWithImplicitWindow = true;
 5103:     SetNextWindowSize(ImVec2(400, 400), ImGuiCond_FirstUseEver);
 5104:     Begin("Debug##Default");
 5105:     IM_ASSERT(g.CurrentWindow->IsFallbackWindow == true);
 5106:     // Store stack sizes
 5107:     g.ErrorCountCurrentFrame = 0;
 5108:     ErrorRecoveryStoreState(&g.StackSizesInNewFrame);
 5109:     // [DEBUG] When io.ConfigDebugBeginReturnValue is set, we make Begin()/BeginChild() return false at different level of the window-stack,
 5110:     // allowing to validate correct Begin/End behavior in user code.
 5111: #ifndef IMGUI_DISABLE_DEBUG_TOOLS
 5112:     if (g.IO.ConfigDebugBeginReturnValueLoop)
 5113:         g.DebugBeginReturnValueCullDepth = (g.DebugBeginReturnValueCullDepth == -1) ? 0 : ((g.DebugBeginReturnValueCullDepth + ((g.FrameCount % 4) == 0 ? 1 : 0)) % 10);
 5114:     else
 5115:         g.DebugBeginReturnValueCullDepth = -1;
 5116: #endif
 5117:     CallContextHooks(&g, ImGuiContextHookType_NewFramePost);
 5118: }
