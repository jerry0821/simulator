466:                   newObj->TextureId = -1;
467:                 }
468:               }
469:             }
470:           }
471:         }
472:       }
473:     }
474:   } else if (g_CurrentMode == MODE_SELECT) {
475:     // SELECT MODE LOGIC
476:     if (!ImGui::GetIO().WantCaptureMouse && !altHeld) { // Skip when Alt held
477:       if (g_DragState == DRAG_NONE) {
478:         if (curr_left && !prev_left) {
479:           int clickedIndex = -1;
480:           float closestObjDist = 100000.0f;
481:           if (g_SelectedIndex != -1) {
482:             MapObject *selObj = Map_GetObjects(g_SelectedIndex);
483:             if (selObj) {
484:               XMMATRIX selWorldRot = XMMatrixRotationRollPitchYaw(
485:                                          selObj->Rotation.x, selObj->Rotation.y,
486:                                          selObj->Rotation.z) *
487:                                      XMMatrixTranslationFromVector(
488:                                          XMLoadFloat3(&selObj->Position));
489:               // Center handle (bigger hitbox)
490:               Collision::AABB handleCenter = {{-0.2f, -0.2f, -0.2f}, {0.2f, 0.2f, 0.2f}};
491:               // Axis handles (match cone positions based on scale)
492:               float hLenX = 0.7f * selObj->Scale.x;
493:               float hLenY = 0.7f * selObj->Scale.y;
494:               float hLenZ = 0.7f * selObj->Scale.z;
495:               Collision::AABB handleAxisX = {{hLenX - 0.15f, -0.15f, -0.15f},
496:                                   {hLenX + 0.35f, 0.15f, 0.15f}};
497:               Collision::AABB handleAxisY = {{-0.15f, hLenY - 0.15f, -0.15f},
498:                                   {0.15f, hLenY + 0.35f, 0.15f}};
499:               Collision::AABB handleAxisZ = {{-0.15f, -0.15f, hLenZ - 0.15f},
500:                                   {0.15f, 0.15f, hLenZ + 0.35f}};
501:               // Check center first
502:               Collision::RayHit hitC = Collision::IntersectRayOBB(
503:                   test_near, dir, handleCenter, selWorldRot);
504:               if (hitC.isHit && hitC.distance < closestObjDist) {
505:                 closestObjDist = hitC.distance;
506:                 g_DragState = DRAG_CENTER;
507:               }
508:               // Check axis handles (override center if closer)
509:               Collision::RayHit hitX = Collision::IntersectRayOBB(test_near, dir,
510:                                                       handleAxisX, selWorldRot);
511:               if (hitX.isHit && hitX.distance < closestObjDist) {
512:                 closestObjDist = hitX.distance;
513:                 if (g_ActiveTool == TOOL_MOVE)
514:                   g_DragState = DRAG_TRANS_X;
515:                 else if (g_ActiveTool == TOOL_SCALE)
516:                   g_DragState = DRAG_SCALE_X;
517:                 else
518:                   g_DragState = DRAG_ROTATE_Y;
519:               }
520:               Collision::RayHit hitY = Collision::IntersectRayOBB(test_near, dir,
521:                                                       handleAxisY, selWorldRot);
522:               if (hitY.isHit && hitY.distance < closestObjDist) {
523:                 closestObjDist = hitY.distance;
524:                 if (g_ActiveTool == TOOL_MOVE)
525:                   g_DragState = DRAG_TRANS_Y;
526:                 else if (g_ActiveTool == TOOL_SCALE)
527:                   g_DragState = DRAG_SCALE_Y;
528:                 else
529:                   g_DragState = DRAG_ROTATE_Y;
530:               }
531:               Collision::RayHit hitZ = Collision::IntersectRayOBB(test_near, dir,
532:                                                       handleAxisZ, selWorldRot);
533:               if (hitZ.isHit && hitZ.distance < closestObjDist) {
534:                 closestObjDist = hitZ.distance;
535:                 if (g_ActiveTool == TOOL_MOVE)
536:                   g_DragState = DRAG_TRANS_Z;
537:                 else if (g_ActiveTool == TOOL_SCALE)
538:                   g_DragState = DRAG_SCALE_Z;
539:                 else
540:                   g_DragState = DRAG_ROTATE_Y;
541:               }
542:               if (g_DragState != DRAG_NONE) {
543:                 Map_PushUndoState();
544:                 g_DragStartPos = selObj->Position;
545:                 g_DragStartScale = selObj->Scale;
546:                 g_DragStartRot = selObj->Rotation;
547:                 clickedIndex = g_SelectedIndex;
548:               }
549:             }
550:           }
551:           // If no gizmo handle clicked, check for block selection
552:           if (clickedIndex == -1) {
553:             int objCount = Map_GetObjectsCount();
554:             for (int i = 0; i < objCount; ++i) {
555:               MapObject *obj = Map_GetObjects(i);
556:               if (obj && obj->KindId != FIELD) {
557:                 XMMATRIX objWorld =
558:                     XMMatrixScaling(obj->Scale.x, obj->Scale.y, obj->Scale.z) *
559:                     XMMatrixRotationRollPitchYaw(
560:                         obj->Rotation.x, obj->Rotation.y, obj->Rotation.z) *
561:                     XMMatrixTranslationFromVector(XMLoadFloat3(&obj->Position));
562:                 Collision::RayHit hit;
563:                 if (obj->KindId == SPHERE) {
564:                   hit = Collision::IntersectRaySphere(test_near, dir, 0.5f,
565:                                                      objWorld);
566:                 } else if (obj->KindId == CYLINDER) {
567:                   hit = Collision::IntersectRayCylinder(test_near, dir, 0.5f,
568:                                                        0.5f, objWorld);
569:                 } else if (obj->KindId == CAPSULE) {
570:                   hit = Collision::IntersectRayCapsule(test_near, dir, 0.5f,
571:                                                       0.5f, objWorld);
572:                 } else {
573:                   Collision::AABB localAabb = Cube_GetAABB({0.0f, 0.0f, 0.0f});
574:                   hit = Collision::IntersectRayOBB(test_near, dir, localAabb,
575:                                                   objWorld);
576:                 }
577:                 if (hit.isHit && hit.distance < closestObjDist) {
578:                   closestObjDist = hit.distance;
579:                   clickedIndex = i;
580:                 }
581:               }
582:             }
583:             // Shift+Click 追加選取 / 沒按 Shift 則清空選取
584:             bool shiftHeld = (GetAsyncKeyState(VK_SHIFT) & 0x8000) != 0;
585:             if (clickedIndex != -1) {
586:               if (shiftHeld) {
587:                 // Toggle in multi-select
588:                 auto it = std::find(g_SelectedIndices.begin(),
589:                                     g_SelectedIndices.end(), clickedIndex);
590:                 if (it != g_SelectedIndices.end()) {
591:                   g_SelectedIndices.erase(it);
592:                   g_SelectedIndex =
593:                       g_SelectedIndices.empty() ? -1 : g_SelectedIndices.back();
594:                 } else {
595:                   g_SelectedIndices.push_back(clickedIndex);
596:                   g_SelectedIndex = clickedIndex;
597:                 }
598:               } else {
599:                 g_SelectedIndices.clear();
600:                 g_SelectedIndices.push_back(clickedIndex);
601:                 g_SelectedIndex = clickedIndex;
602:               }
603:             } else if (!shiftHeld) {
604:               // 點到空白區且沒按 Shift → 開始框選
605:               g_DragBoxActive = true;
606:               g_BoxStartX = ms.x;
607:               g_BoxStartY = ms.y;
608:               g_SelectedIndices.clear();
609:               g_SelectedIndex = -1;
610:             }
611:           }
612:         }
613:       } else {
614:         // While dragging...
615:         if (g_SelectedIndex != -1) {
616:           MapObject *selObj = Map_GetObjects(g_SelectedIndex);
617:           if (selObj) {
618:             int dx = ms.x - g_prevMouseX;
619:             int dy = ms.y - g_prevMouseY;
620:             float sensitivity = 0.01f;
621:             if (g_DragState == DRAG_SCALE_X) {
622:               selObj->Scale.x =
623:                   std::max(0.1f, selObj->Scale.x + dx * sensitivity);
624:             } else if (g_DragState == DRAG_SCALE_Y) {
625:               selObj->Scale.y =
626:                   std::max(0.1f, selObj->Scale.y - dy * sensitivity);
627:             } else if (g_DragState == DRAG_SCALE_Z) {
628:               selObj->Scale.z =
629:                   std::max(0.1f, selObj->Scale.z + dx * sensitivity);
630:             } else if (g_DragState == DRAG_SCALE_UNIFORM ||
631:                        (g_DragState == DRAG_CENTER &&
632:                         g_ActiveTool == TOOL_SCALE)) {
633:               float uniScale = dx * sensitivity - dy * sensitivity;
634:               selObj->Scale.x = std::max(0.1f, selObj->Scale.x + uniScale);
635:               selObj->Scale.y = std::max(0.1f, selObj->Scale.y + uniScale);
636:               selObj->Scale.z = std::max(0.1f, selObj->Scale.z + uniScale);
637:             } else if (g_DragState == DRAG_TRANS_X) {
638:               XMFLOAT3 xDir(dx * sensitivity * 2.0f, 0, 0);
639:               XMVECTOR delta = XMVector3TransformNormal(
640:                   XMLoadFloat3(&xDir),
641:                   XMMatrixRotationRollPitchYaw(selObj->Rotation.x,
642:                                                selObj->Rotation.y,
643:                                                selObj->Rotation.z));
644:               XMFLOAT3 d;
645:               XMStoreFloat3(&d, delta);
646:               selObj->Position.x += d.x;
647:               selObj->Position.z += d.z;
648:             } else if (g_DragState == DRAG_TRANS_Y) {
649:               selObj->Position.y -= dy * sensitivity * 2.0f;
650:             } else if (g_DragState == DRAG_TRANS_Z) {
651:               XMFLOAT3 zDir(0, 0, dx * sensitivity * 2.0f);
652:               XMVECTOR delta = XMVector3TransformNormal(
653:                   XMLoadFloat3(&zDir),
654:                   XMMatrixRotationRollPitchYaw(selObj->Rotation.x,
655:                                                selObj->Rotation.y,
656:                                                selObj->Rotation.z));
657:               XMFLOAT3 d;
658:               XMStoreFloat3(&d, delta);
659:               selObj->Position.x += d.x;
660:               selObj->Position.z += d.z;
661:             } else if (g_DragState == DRAG_ROTATE_Y ||
662:                        (g_DragState == DRAG_CENTER &&
663:                         g_ActiveTool == TOOL_ROTATE)) {
664:               selObj->Rotation.y += dx * 0.01f;
665:             } else if (g_DragState == DRAG_CENTER &&
666:                        g_ActiveTool == TOOL_MOVE) {
667:               // Move on XZ plane
668:               XMFLOAT3 moveDir(dx * sensitivity * 2.0f, 0, 0);
669:               XMVECTOR delta = XMVector3TransformNormal(
670:                   XMLoadFloat3(&moveDir),
671:                   XMMatrixRotationRollPitchYaw(selObj->Rotation.x,
672:                                                selObj->Rotation.y,
673:                                                selObj->Rotation.z));
674:               XMFLOAT3 d;
675:               XMStoreFloat3(&d, delta);
676:               selObj->Position.x += d.x;
677:               selObj->Position.z += d.z;
678:               selObj->Position.y -= dy * sensitivity * 2.0f;
679:             }
680:           }
681:         }
682:       }
683:       if (!curr_left && prev_left) {
684:         if (g_DragBoxActive) {
685:           // 框選完成：投影所有物件，選取落在框內的
686:           int x0 = std::min(g_BoxStartX, ms.x);
687:           int x1 = std::max(g_BoxStartX, ms.x);
688:           int y0 = std::min(g_BoxStartY, ms.y);
689:           int y1 = std::max(g_BoxStartY, ms.y);
690:           if (x1 - x0 > 4 || y1 - y0 > 4) { // 必須包括最小面積
691:             XMFLOAT4X4 mtxV = Camera_GetMatrix();
692:             XMFLOAT4X4 mtxP = Camera_GetPerspectiveMatrix();
693:             int count = Map_GetObjectsCount();
694:             RECT viewport;
695:             GetClientRect(GetForegroundWindow(), &viewport);
696:             float vw = (float)(viewport.right - viewport.left);
697:             float vh = (float)(viewport.bottom - viewport.top);
698:             for (int i = 0; i < count; ++i) {
699:               MapObject *obj = Map_GetObjects(i);
700:               if (!obj || obj->KindId == FIELD)
701:                 continue;
702:               XMVECTOR worldPos = XMLoadFloat3(&obj->Position);
703:               XMVECTOR clip = XMVector3TransformCoord(
704:                   worldPos, XMLoadFloat4x4(&mtxV) * XMLoadFloat4x4(&mtxP));
705:               XMFLOAT3 ndc;
706:               XMStoreFloat3(&ndc, clip);
707:               int sx = (int)((ndc.x * 0.5f + 0.5f) * vw);
708:               int sy = (int)((-ndc.y * 0.5f + 0.5f) * vh);
709:               if (ndc.z > 0.0f && sx >= x0 && sx <= x1 && sy >= y0 &&
710:                   sy <= y1) {
711:                 if (std::find(g_SelectedIndices.begin(),
712:                               g_SelectedIndices.end(),
713:                               i) == g_SelectedIndices.end())
714:                   g_SelectedIndices.push_back(i);
715:               }
716:             }
717:             g_SelectedIndex =
718:                 g_SelectedIndices.empty() ? -1 : g_SelectedIndices.back();
719:             if (!g_SelectedIndices.empty())
720:               g_CurrentMode = MODE_SELECT;
721:           }
722:           g_DragBoxActive = false;
723:         }
724:         g_DragState = DRAG_NONE; // Reset drag state on mouse release
725:       }
726:     }
727:   }
728:   prev_left = curr_left;
729:   prev_right = curr_right;
730:   g_prevMouseX = ms.x;
731:   g_prevMouseY = ms.y;
732: }
