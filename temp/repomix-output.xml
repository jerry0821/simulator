3254: void ImFontAtlasFontDestroySourceData(ImFontAtlas* atlas, ImFontConfig* src)
3255: {
3256:     IM_UNUSED(atlas);
3257:     // IF YOU GET A CRASH IN THE IM_FREE() CALL HERE AND USED AddFontFromMemoryTTF():
3258:     // - DUE TO LEGACY REASON AddFontFromMemoryTTF() TRANSFERS MEMORY OWNERSHIP BY DEFAULT.
3259:     // - IT WILL THEREFORE CRASH WHEN PASSED DATA WHICH MAY NOT BE FREEED BY IMGUI.
3260:     // - USE `ImFontConfig font_cfg; font_cfg.FontDataOwnedByAtlas = false; io.Fonts->AddFontFromMemoryTTF(....., &cfg);` to disable passing ownership/
3261:     // WE WILL ADDRESS THIS IN A FUTURE REWORK OF THE API.
3262:     if (src->FontDataOwnedByAtlas)
3263:         IM_FREE(src->FontData);
3264:     src->FontData = NULL;
