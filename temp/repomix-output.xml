 141: void ImGui::TextEx(const char* text, const char* text_end, ImGuiTextFlags flags)
 142: {
 143:     ImGuiWindow* window = GetCurrentWindow();
 144:     if (window->SkipItems)
 145:         return;
 146:     ImGuiContext& g = *GImGui;
 147:     // Accept null ranges
 148:     if (text == text_end)
 149:         text = text_end = "";
 150:     // Calculate length
 151:     const char* text_begin = text;
 152:     if (text_end == NULL)
 153:         text_end = text + ImStrlen(text); // FIXME-OPT
 154:     const ImVec2 text_pos(window->DC.CursorPos.x, window->DC.CursorPos.y + window->DC.CurrLineTextBaseOffset);
 155:     const float wrap_pos_x = window->DC.TextWrapPos;
 156:     const bool wrap_enabled = (wrap_pos_x >= 0.0f);
 157:     if (text_end - text <= 2000 || wrap_enabled)
 158:     {
 159:         // Common case
 160:         const float wrap_width = wrap_enabled ? CalcWrapWidthForPos(window->DC.CursorPos, wrap_pos_x) : 0.0f;
 161:         const ImVec2 text_size = CalcTextSize(text_begin, text_end, false, wrap_width);
 162:         ImRect bb(text_pos, text_pos + text_size);
 163:         ItemSize(text_size, 0.0f);
 164:         if (!ItemAdd(bb, 0))
 165:             return;
 166:         // Render (we don't hide text after ## in this end-user function)
 167:         RenderTextWrapped(bb.Min, text_begin, text_end, wrap_width);
 168:     }
 169:     else
 170:     {
 171:         // Long text!
 172:         // Perform manual coarse clipping to optimize for long multi-line text
 173:         // - From this point we will only compute the width of lines that are visible. Optimization only available when word-wrapping is disabled.
 174:         // - We also don't vertically center the text within the line full height, which is unlikely to matter because we are likely the biggest and only item on the line.
 175:         // - We use memchr(), pay attention that well optimized versions of those str/mem functions are much faster than a casually written loop.
 176:         const char* line = text;
 177:         const float line_height = GetTextLineHeight();
 178:         ImVec2 text_size(0, 0);
 179:         // Lines to skip (can't skip when logging text)
 180:         ImVec2 pos = text_pos;
 181:         if (!g.LogEnabled)
 182:         {
 183:             int lines_skippable = (int)((window->ClipRect.Min.y - text_pos.y) / line_height);
 184:             if (lines_skippable > 0)
 185:             {
 186:                 int lines_skipped = 0;
 187:                 while (line < text_end && lines_skipped < lines_skippable)
 188:                 {
 189:                     const char* line_end = (const char*)ImMemchr(line, '\n', text_end - line);
 190:                     if (!line_end)
 191:                         line_end = text_end;
 192:                     if ((flags & ImGuiTextFlags_NoWidthForLargeClippedText) == 0)
 193:                         text_size.x = ImMax(text_size.x, CalcTextSize(line, line_end).x);
 194:                     line = line_end + 1;
 195:                     lines_skipped++;
 196:                 }
 197:                 pos.y += lines_skipped * line_height;
 198:             }
 199:         }
 200:         // Lines to render
 201:         if (line < text_end)
 202:         {
 203:             ImRect line_rect(pos, pos + ImVec2(FLT_MAX, line_height));
 204:             while (line < text_end)
 205:             {
 206:                 if (IsClippedEx(line_rect, 0))
 207:                     break;
 208:                 const char* line_end = (const char*)ImMemchr(line, '\n', text_end - line);
 209:                 if (!line_end)
 210:                     line_end = text_end;
 211:                 text_size.x = ImMax(text_size.x, CalcTextSize(line, line_end).x);
 212:                 RenderText(pos, line, line_end, false);
 213:                 line = line_end + 1;
 214:                 line_rect.Min.y += line_height;
 215:                 line_rect.Max.y += line_height;
 216:                 pos.y += line_height;
 217:             }
 218:             // Count remaining lines
 219:             int lines_skipped = 0;
 220:             while (line < text_end)
 221:             {
 222:                 const char* line_end = (const char*)ImMemchr(line, '\n', text_end - line);
 223:                 if (!line_end)
 224:                     line_end = text_end;
 225:                 if ((flags & ImGuiTextFlags_NoWidthForLargeClippedText) == 0)
 226:                     text_size.x = ImMax(text_size.x, CalcTextSize(line, line_end).x);
 227:                 line = line_end + 1;
 228:                 lines_skipped++;
 229:             }
 230:             pos.y += lines_skipped * line_height;
 231:         }
 232:         text_size.y = (pos - text_pos).y;
 233:         ImRect bb(text_pos, text_pos + text_size);
 234:         ItemSize(text_size, 0.0f);
 235:         ItemAdd(bb, 0);
 236:     }
 237: }
