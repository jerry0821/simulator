2698: // [SECTION] Multi-Select API flags and structures (ImGuiMultiSelectFlags, ImGuiSelectionRequestType, ImGuiSelectionRequest, ImGuiMultiSelectIO, ImGuiSelectionBasicStorage)
2699: //-----------------------------------------------------------------------------
2700: // Multi-selection system
2701: // Documentation at: https://github.com/ocornut/imgui/wiki/Multi-Select
2702: // - Refer to 'Demo->Widgets->Selection State & Multi-Select' for demos using this.
2703: // - This system implements standard multi-selection idioms (Ctrl+Mouse/Keyboard, Shift+Mouse/Keyboard, etc)
2704: //   with support for clipper (skipping non-visible items), box-select and many other details.
2705: // - Selectable(), Checkbox() are supported but custom widgets may use it as well.
2706: // - TreeNode() is technically supported but... using this correctly is more complicated: you need some sort of linear/random access to your tree,
2707: //   which is suited to advanced trees setups also implementing filters and clipper. We will work toward simplifying and demoing it.
2708: // - In the spirit of Dear ImGui design, your code owns actual selection data.
2709: //   This is designed to allow all kinds of selection storage you may use in your application e.g. set/map/hash.
2710: // About ImGuiSelectionBasicStorage:
2711: // - This is an optional helper to store a selection state and apply selection requests.
2712: // - It is used by our demos and provided as a convenience to quickly implement multi-selection.
2713: // Usage:
2714: // - Identify submitted items with SetNextItemSelectionUserData(), most likely using an index into your current data-set.
2715: // - Store and maintain actual selection data using persistent object identifiers.
2716: // - Usage flow:
2717: //     BEGIN - (1) Call BeginMultiSelect() and retrieve the ImGuiMultiSelectIO* result.
2718: //           - (2) Honor request list (SetAll/SetRange requests) by updating your selection data. Same code as Step 6.
2719: //           - (3) [If using clipper] You need to make sure RangeSrcItem is always submitted. Calculate its index and pass to clipper.IncludeItemByIndex(). If storing indices in ImGuiSelectionUserData, a simple clipper.IncludeItemByIndex(ms_io->RangeSrcItem) call will work.
2720: //     LOOP  - (4) Submit your items with SetNextItemSelectionUserData() + Selectable()/TreeNode() calls.
2721: //     END   - (5) Call EndMultiSelect() and retrieve the ImGuiMultiSelectIO* result.
2722: //           - (6) Honor request list (SetAll/SetRange requests) by updating your selection data. Same code as Step 2.
2723: //     If you submit all items (no clipper), Step 2 and 3 are optional and will be handled by each item themselves. It is fine to always honor those steps.
2724: // About ImGuiSelectionUserData:
2725: // - This can store an application-defined identifier (e.g. index or pointer) submitted via SetNextItemSelectionUserData().
2726: // - In return we store them into RangeSrcItem/RangeFirstItem/RangeLastItem and other fields in ImGuiMultiSelectIO.
2727: // - Most applications will store an object INDEX, hence the chosen name and type. Storing an index is natural, because
2728: //   SetRange requests will give you two end-points and you will need to iterate/interpolate between them to update your selection.
2729: // - However it is perfectly possible to store a POINTER or another IDENTIFIER inside ImGuiSelectionUserData.
2730: //   Our system never assume that you identify items by indices, it never attempts to interpolate between two values.
2731: // - If you enable ImGuiMultiSelectFlags_NoRangeSelect then it is guaranteed that you will never have to interpolate
2732: //   between two ImGuiSelectionUserData, which may be a convenient way to use part of the feature with less code work.
2733: // - As most users will want to store an index, for convenience and to reduce confusion we use ImS64 instead of void*,
2734: //   being syntactically easier to downcast. Feel free to reinterpret_cast and store a pointer inside.
2735: // Flags for BeginMultiSelect()
2736: enum ImGuiMultiSelectFlags_
2737: {
2738:     ImGuiMultiSelectFlags_None                  = 0,
2739:     ImGuiMultiSelectFlags_SingleSelect          = 1 << 0,   // Disable selecting more than one item. This is available to allow single-selection code to share same code/logic if desired. It essentially disables the main purpose of BeginMultiSelect() tho!
2740:     ImGuiMultiSelectFlags_NoSelectAll           = 1 << 1,   // Disable Ctrl+A shortcut to select all.
2741:     ImGuiMultiSelectFlags_NoRangeSelect         = 1 << 2,   // Disable Shift+selection mouse/keyboard support (useful for unordered 2D selection). With BoxSelect is also ensure contiguous SetRange requests are not combined into one. This allows not handling interpolation in SetRange requests.
2742:     ImGuiMultiSelectFlags_NoAutoSelect          = 1 << 3,   // Disable selecting items when navigating (useful for e.g. supporting range-select in a list of checkboxes).
2743:     ImGuiMultiSelectFlags_NoAutoClear           = 1 << 4,   // Disable clearing selection when navigating or selecting another one (generally used with ImGuiMultiSelectFlags_NoAutoSelect. useful for e.g. supporting range-select in a list of checkboxes).
2744:     ImGuiMultiSelectFlags_NoAutoClearOnReselect = 1 << 5,   // Disable clearing selection when clicking/selecting an already selected item.
2745:     ImGuiMultiSelectFlags_BoxSelect1d           = 1 << 6,   // Enable box-selection with same width and same x pos items (e.g. full row Selectable()). Box-selection works better with little bit of spacing between items hit-box in order to be able to aim at empty space.
2746:     ImGuiMultiSelectFlags_BoxSelect2d           = 1 << 7,   // Enable box-selection with varying width or varying x pos items support (e.g. different width labels, or 2D layout/grid). This is slower: alters clipping logic so that e.g. horizontal movements will update selection of normally clipped items.
2747:     ImGuiMultiSelectFlags_BoxSelectNoScroll     = 1 << 8,   // Disable scrolling when box-selecting near edges of scope.
2748:     ImGuiMultiSelectFlags_ClearOnEscape         = 1 << 9,   // Clear selection when pressing Escape while scope is focused.
2749:     ImGuiMultiSelectFlags_ClearOnClickVoid      = 1 << 10,  // Clear selection when clicking on empty location within scope.
2750:     ImGuiMultiSelectFlags_ScopeWindow           = 1 << 11,  // Scope for _BoxSelect and _ClearOnClickVoid is whole window (Default). Use if BeginMultiSelect() covers a whole window or used a single time in same window.
2751:     ImGuiMultiSelectFlags_ScopeRect             = 1 << 12,  // Scope for _BoxSelect and _ClearOnClickVoid is rectangle encompassing BeginMultiSelect()/EndMultiSelect(). Use if BeginMultiSelect() is called multiple times in same window.
2752:     ImGuiMultiSelectFlags_SelectOnClick         = 1 << 13,  // Apply selection on mouse down when clicking on unselected item. (Default)
2753:     ImGuiMultiSelectFlags_SelectOnClickRelease  = 1 << 14,  // Apply selection on mouse release when clicking an unselected item. Allow dragging an unselected item without altering selection.
2754:     //ImGuiMultiSelectFlags_RangeSelect2d       = 1 << 15,  // Shift+Selection uses 2d geometry instead of linear sequence, so possible to use Shift+up/down to select vertically in grid. Analogous to what BoxSelect does.
2755:     ImGuiMultiSelectFlags_NavWrapX              = 1 << 16,  // [Temporary] Enable navigation wrapping on X axis. Provided as a convenience because we don't have a design for the general Nav API for this yet. When the more general feature be public we may obsolete this flag in favor of new one.
2756:     ImGuiMultiSelectFlags_NoSelectOnRightClick  = 1 << 17,  // Disable default right-click processing, which selects item on mouse down, and is designed for context-menus.
2757: };
2758: // Main IO structure returned by BeginMultiSelect()/EndMultiSelect().
2759: // This mainly contains a list of selection requests.
2760: // - Use 'Demo->Tools->Debug Log->Selection' to see requests as they happen.
2761: // - Some fields are only useful if your list is dynamic and allows deletion (getting post-deletion focus/state right is shown in the demo)
2762: // - Below: who reads/writes each fields? 'r'=read, 'w'=write, 'ms'=multi-select code, 'app'=application/user code.
2763: struct ImGuiMultiSelectIO
2764: {
2765:     //------------------------------------------// BeginMultiSelect / EndMultiSelect
2766:     ImVector<ImGuiSelectionRequest> Requests;   //  ms:w, app:r     /  ms:w  app:r   // Requests to apply to your selection data.
2767:     ImGuiSelectionUserData      RangeSrcItem;   //  ms:w  app:r     /                // (If using clipper) Begin: Source item (often the first selected item) must never be clipped: use clipper.IncludeItemByIndex() to ensure it is submitted.
2768:     ImGuiSelectionUserData      NavIdItem;      //  ms:w, app:r     /                // (If using deletion) Last known SetNextItemSelectionUserData() value for NavId (if part of submitted items).
2769:     bool                        NavIdSelected;  //  ms:w, app:r     /        app:r   // (If using deletion) Last known selection state for NavId (if part of submitted items).
2770:     bool                        RangeSrcReset;  //        app:w     /  ms:r          // (If using deletion) Set before EndMultiSelect() to reset ResetSrcItem (e.g. if deleted selection).
2771:     int                         ItemsCount;     //  ms:w, app:r     /        app:r   // 'int items_count' parameter to BeginMultiSelect() is copied here for convenience, allowing simpler calls to your ApplyRequests handler. Not used internally.
2772: };
2773: // Selection request type
2774: enum ImGuiSelectionRequestType
2775: {
2776:     ImGuiSelectionRequestType_None = 0,
2777:     ImGuiSelectionRequestType_SetAll,           // Request app to clear selection (if Selected==false) or select all items (if Selected==true). We cannot set RangeFirstItem/RangeLastItem as its contents is entirely up to user (not necessarily an index)
2778:     ImGuiSelectionRequestType_SetRange,         // Request app to select/unselect [RangeFirstItem..RangeLastItem] items (inclusive) based on value of Selected. Only EndMultiSelect() request this, app code can read after BeginMultiSelect() and it will always be false.
2779: };
2780: // Selection request item
2781: struct ImGuiSelectionRequest
2782: {
2783:     //------------------------------------------// BeginMultiSelect / EndMultiSelect
2784:     ImGuiSelectionRequestType   Type;           //  ms:w, app:r     /  ms:w, app:r   // Request type. You'll most often receive 1 Clear + 1 SetRange with a single-item range.
2785:     bool                        Selected;       //  ms:w, app:r     /  ms:w, app:r   // Parameter for SetAll/SetRange requests (true = select, false = unselect)
2786:     ImS8                        RangeDirection; //                  /  ms:w  app:r   // Parameter for SetRange request: +1 when RangeFirstItem comes before RangeLastItem, -1 otherwise. Useful if you want to preserve selection order on a backward Shift+Click.
2787:     ImGuiSelectionUserData      RangeFirstItem; //                  /  ms:w, app:r   // Parameter for SetRange request (this is generally == RangeSrcItem when shift selecting from top to bottom).
2788:     ImGuiSelectionUserData      RangeLastItem;  //                  /  ms:w, app:r   // Parameter for SetRange request (this is generally == RangeSrcItem when shift selecting from bottom to top). Inclusive!
2789: };
2790: // Optional helper to store multi-selection state + apply multi-selection requests.
2791: // - Used by our demos and provided as a convenience to easily implement basic multi-selection.
2792: // - Iterate selection with 'void* it = NULL; ImGuiID id; while (selection.GetNextSelectedItem(&it, &id)) { ... }'
2793: //   Or you can check 'if (Contains(id)) { ... }' for each possible object if their number is not too high to iterate.
2794: // - USING THIS IS NOT MANDATORY. This is only a helper and not a required API.
2795: // To store a multi-selection, in your application you could:
2796: // - Use this helper as a convenience. We use our simple key->value ImGuiStorage as a std::set<ImGuiID> replacement.
2797: // - Use your own external storage: e.g. std::set<MyObjectId>, std::vector<MyObjectId>, interval trees, intrusively stored selection etc.
2798: // In ImGuiSelectionBasicStorage we:
2799: // - always use indices in the multi-selection API (passed to SetNextItemSelectionUserData(), retrieved in ImGuiMultiSelectIO)
2800: // - use the AdapterIndexToStorageId() indirection layer to abstract how persistent selection data is derived from an index.
2801: // - use decently optimized logic to allow queries and insertion of very large selection sets.
2802: // - do not preserve selection order.
2803: // Many combinations are possible depending on how you prefer to store your items and how you prefer to store your selection.
2804: // Large applications are likely to eventually want to get rid of this indirection layer and do their own thing.
2805: // See https://github.com/ocornut/imgui/wiki/Multi-Select for details and pseudo-code using this helper.
2806: struct ImGuiSelectionBasicStorage
2807: {
2808:     // Members
2809:     int             Size;           //          // Number of selected items, maintained by this helper.
2810:     bool            PreserveOrder;  // = false  // GetNextSelectedItem() will return ordered selection (currently implemented by two additional sorts of selection. Could be improved)
2811:     void*           UserData;       // = NULL   // User data for use by adapter function        // e.g. selection.UserData = (void*)my_items;
2812:     ImGuiID         (*AdapterIndexToStorageId)(ImGuiSelectionBasicStorage* self, int idx);      // e.g. selection.AdapterIndexToStorageId = [](ImGuiSelectionBasicStorage* self, int idx) { return ((MyItems**)self->UserData)[idx]->ID; };
2813:     int             _SelectionOrder;// [Internal] Increasing counter to store selection order
2814:     ImGuiStorage    _Storage;       // [Internal] Selection set. Think of this as similar to e.g. std::set<ImGuiID>. Prefer not accessing directly: iterate with GetNextSelectedItem().
2815:     // Methods
2816:     IMGUI_API ImGuiSelectionBasicStorage();
2817:     IMGUI_API void  ApplyRequests(ImGuiMultiSelectIO* ms_io);   // Apply selection requests coming from BeginMultiSelect() and EndMultiSelect() functions. It uses 'items_count' passed to BeginMultiSelect()
2818:     IMGUI_API bool  Contains(ImGuiID id) const;                 // Query if an item id is in selection.
2819:     IMGUI_API void  Clear();                                    // Clear selection
2820:     IMGUI_API void  Swap(ImGuiSelectionBasicStorage& r);        // Swap two selections
2821:     IMGUI_API void  SetItemSelected(ImGuiID id, bool selected); // Add/remove an item from selection (generally done by ApplyRequests() function)
2822:     IMGUI_API bool  GetNextSelectedItem(void** opaque_it, ImGuiID* out_id); // Iterate selection with 'void* it = NULL; ImGuiID id; while (selection.GetNextSelectedItem(&it, &id)) { ... }'
2823:     inline ImGuiID  GetStorageIdFromIndex(int idx)              { return AdapterIndexToStorageId(this, idx); }  // Convert index to item id based on provided adapter.
2824: };
