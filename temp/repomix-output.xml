 54: void Sprite_Begin()
 55: {
 56: 	// 頂点シェーダーに変換行列を設定
 57: 	const float SCREEN_WIDTH = (float)Direct3D_GetBackBufferWidth();
 58: 	const float SCREEN_HEIGHT = (float)Direct3D_GetBackBufferHeight();
 59: 	Shader_SetProjectionMatrix(XMMatrixOrthographicOffCenterLH(0.0f, SCREEN_WIDTH, SCREEN_HEIGHT, 0.0f, 0.0f, 1.0f));
 60: }
 61: void Sprite_Draw(int texid, float dx, float dy, const XMFLOAT4& color)
 62: {
 63: 	// シェーダーを描画パイプラインに設定
 64: 	Shader_Begin();
 65: 	// 頂点バッファをロックする
 66: 	D3D11_MAPPED_SUBRESOURCE msr;
 67: 	g_pContext->Map(g_pVertexBuffer, 0, D3D11_MAP_WRITE_DISCARD, 0, &msr);
 68: 	// 頂点バッファへの仮想ポインタを取得
 69: 	Vertex* v = (Vertex*)msr.pData;
 70: 	// 頂点情報を書き込み
 71: 	unsigned int dw = Texture_Width(texid);
 72: 	unsigned int dh = Texture_Height(texid);
 73: 	// 画面の左上から右下に向かう線分を描画する -> 時計回り
 74: 	v[0].position = { dx,		dy,		 0.0f };	// LT
 75: 	v[1].position = { dx + dw,  dy,		 0.0f };	// RT
 76: 	v[2].position = { dx,		dy + dh, 0.0f };	// LB
 77: 	v[3].position = { dx + dw,  dy + dh, 0.0f };	// RB
 78: 	v[0].color = color;
 79: 	v[1].color = color;
 80: 	v[2].color = color;
 81: 	v[3].color = color;
 82: 	v[0].uv = { 0.0f, 0.0f };
 83: 	v[1].uv = { 1.0f, 0.0f };
 84: 	v[2].uv = { 0.0f, 1.0f };
 85: 	v[3].uv = { 1.0f, 1.0f };
 86: 	// 頂点バッファのロックを解除
 87: 	g_pContext->Unmap(g_pVertexBuffer, 0);
 88: 	// ワールド変換行列を設定
 89: 	Shader_SetWorldMatrix(XMMatrixIdentity());
 90: 	// 頂点バッファを描画パイプラインに設定
 91: 	UINT stride = sizeof(Vertex);
 92: 	UINT offset = 0;
 93: 	g_pContext->IASetVertexBuffers(0, 1, &g_pVertexBuffer, &stride, &offset);
 94: 	// プリミティブトポロジ設定
 95: 	g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
 96: 	// テクスチャの設定
 97: 	Texture_SetTexture(texid);
 98: 	// ポリゴン描画命令発行
 99: 	g_pContext->Draw(NUM_VERTEX, 0);
100: }
