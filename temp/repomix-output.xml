 1893: // Consider using _stricmp/_strnicmp under Windows or strcasecmp/strncasecmp. We don't actually use either ImStricmp/ImStrnicmp in the codebase any more.
 1894: int ImStricmp(const char* str1, const char* str2)
 1895: {
 1896:     int d;
 1897:     while ((d = ImToUpper(*str2) - ImToUpper(*str1)) == 0 && *str1) { str1++; str2++; }
 1898:     return d;
 1899: }
 1900: int ImStrnicmp(const char* str1, const char* str2, size_t count)
 1901: {
 1902:     int d = 0;
 1903:     while (count > 0 && (d = ImToUpper(*str2) - ImToUpper(*str1)) == 0 && *str1) { str1++; str2++; count--; }
 1904:     return d;
 1905: }
 1906: void ImStrncpy(char* dst, const char* src, size_t count)
 1907: {
 1908:     if (count < 1)
 1909:         return;
 1910:     if (count > 1)
 1911:         strncpy(dst, src, count - 1); // FIXME-OPT: strncpy not only doesn't guarantee 0-termination, it also always writes the whole array
 1912:     dst[count - 1] = 0;
 1913: }
 1914: char* ImStrdup(const char* str)
 1915: {
 1916:     size_t len = ImStrlen(str);
 1917:     void* buf = IM_ALLOC(len + 1);
 1918:     return (char*)memcpy(buf, (const void*)str, len + 1);
 1919: }
 1920: void* ImMemdup(const void* src, size_t size)
 1921: {
 1922:     void* dst = IM_ALLOC(size);
 1923:     return memcpy(dst, src, size);
 1924: }
 1925: char* ImStrdupcpy(char* dst, size_t* p_dst_size, const char* src)
 1926: {
 1927:     size_t dst_buf_size = p_dst_size ? *p_dst_size : ImStrlen(dst) + 1;
 1928:     size_t src_size = ImStrlen(src) + 1;
 1929:     if (dst_buf_size < src_size)
 1930:     {
 1931:         IM_FREE(dst);
 1932:         dst = (char*)IM_ALLOC(src_size);
 1933:         if (p_dst_size)
 1934:             *p_dst_size = src_size;
 1935:     }
 1936:     return (char*)memcpy(dst, (const void*)src, src_size);
 1937: }
 1938: const char* ImStrchrRange(const char* str, const char* str_end, char c)
 1939: {
 1940:     const char* p = (const char*)ImMemchr(str, (int)c, str_end - str);
 1941:     return p;
 1942: }
 1943: int ImStrlenW(const ImWchar* str)
 1944: {
 1945:     //return (int)wcslen((const wchar_t*)str);  // FIXME-OPT: Could use this when wchar_t are 16-bit
 1946:     int n = 0;
 1947:     while (*str++) n++;
 1948:     return n;
