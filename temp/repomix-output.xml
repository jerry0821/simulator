 359: ImDrawListSharedData::ImDrawListSharedData()
 360: {
 361:     memset(this, 0, sizeof(*this));
 362:     InitialFringeScale = 1.0f;
 363:     for (int i = 0; i < IM_ARRAYSIZE(ArcFastVtx); i++)
 364:     {
 365:         const float a = ((float)i * 2 * IM_PI) / (float)IM_ARRAYSIZE(ArcFastVtx);
 366:         ArcFastVtx[i] = ImVec2(ImCos(a), ImSin(a));
 367:     }
 368:     ArcFastRadiusCutoff = IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_CALC_R(IM_DRAWLIST_ARCFAST_SAMPLE_MAX, CircleSegmentMaxError);
 369: }
 370: ImDrawListSharedData::~ImDrawListSharedData()
 371: {
 372:     IM_ASSERT(DrawLists.Size == 0);
 373: }
 374: void ImDrawListSharedData::SetCircleTessellationMaxError(float max_error)
 375: {
 376:     if (CircleSegmentMaxError == max_error)
 377:         return;
 378:     IM_ASSERT(max_error > 0.0f);
 379:     CircleSegmentMaxError = max_error;
 380:     for (int i = 0; i < IM_ARRAYSIZE(CircleSegmentCounts); i++)
 381:     {
 382:         const float radius = (float)i;
 383:         CircleSegmentCounts[i] = (ImU8)((i > 0) ? IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_CALC(radius, CircleSegmentMaxError) : IM_DRAWLIST_ARCFAST_SAMPLE_MAX);
 384:     }
 385:     ArcFastRadiusCutoff = IM_DRAWLIST_CIRCLE_AUTO_SEGMENT_CALC_R(IM_DRAWLIST_ARCFAST_SAMPLE_MAX, CircleSegmentMaxError);
 386: }
