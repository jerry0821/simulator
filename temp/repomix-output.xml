13727: void ImGui::LoadIniSettingsFromDisk(const char* ini_filename)
13728: {
13729:     size_t file_data_size = 0;
13730:     char* file_data = (char*)ImFileLoadToMemory(ini_filename, "rb", &file_data_size);
13731:     if (!file_data)
13732:         return;
13733:     if (file_data_size > 0)
13734:         LoadIniSettingsFromMemory(file_data, (size_t)file_data_size);
13735:     IM_FREE(file_data);
13736: }
13737: // Zero-tolerance, no error reporting, cheap .ini parsing
13738: // Set ini_size==0 to let us use strlen(ini_data). Do not call this function with a 0 if your buffer is actually empty!
13739: void ImGui::LoadIniSettingsFromMemory(const char* ini_data, size_t ini_size)
13740: {
13741:     ImGuiContext& g = *GImGui;
13742:     IM_ASSERT(g.Initialized);
13743:     //IM_ASSERT(!g.WithinFrameScope && "Cannot be called between NewFrame() and EndFrame()");
13744:     //IM_ASSERT(g.SettingsLoaded == false && g.FrameCount == 0);
13745:     // For user convenience, we allow passing a non zero-terminated string (hence the ini_size parameter).
13746:     // For our convenience and to make the code simpler, we'll also write zero-terminators within the buffer. So let's create a writable copy..
13747:     if (ini_size == 0)
13748:         ini_size = ImStrlen(ini_data);
13749:     g.SettingsIniData.Buf.resize((int)ini_size + 1);
13750:     char* const buf = g.SettingsIniData.Buf.Data;
13751:     char* const buf_end = buf + ini_size;
13752:     memcpy(buf, ini_data, ini_size);
13753:     buf_end[0] = 0;
13754:     // Call pre-read handlers
13755:     // Some types will clear their data (e.g. dock information) some types will allow merge/override (window)
13756:     for (ImGuiSettingsHandler& handler : g.SettingsHandlers)
13757:         if (handler.ReadInitFn != NULL)
13758:             handler.ReadInitFn(&g, &handler);
13759:     void* entry_data = NULL;
13760:     ImGuiSettingsHandler* entry_handler = NULL;
13761:     char* line_end = NULL;
13762:     for (char* line = buf; line < buf_end; line = line_end + 1)
13763:     {
13764:         // Skip new lines markers, then find end of the line
13765:         while (*line == '\n' || *line == '\r')
13766:             line++;
13767:         line_end = line;
13768:         while (line_end < buf_end && *line_end != '\n' && *line_end != '\r')
13769:             line_end++;
13770:         line_end[0] = 0;
13771:         if (line[0] == ';')
13772:             continue;
13773:         if (line[0] == '[' && line_end > line && line_end[-1] == ']')
13774:         {
13775:             // Parse "[Type][Name]". Note that 'Name' can itself contains [] characters, which is acceptable with the current format and parsing code.
13776:             line_end[-1] = 0;
13777:             const char* name_end = line_end - 1;
13778:             const char* type_start = line + 1;
13779:             char* type_end = (char*)(void*)ImStrchrRange(type_start, name_end, ']');
13780:             const char* name_start = type_end ? ImStrchrRange(type_end + 1, name_end, '[') : NULL;
13781:             if (!type_end || !name_start)
13782:                 continue;
13783:             *type_end = 0; // Overwrite first ']'
13784:             name_start++;  // Skip second '['
13785:             entry_handler = FindSettingsHandler(type_start);
13786:             entry_data = entry_handler ? entry_handler->ReadOpenFn(&g, entry_handler, name_start) : NULL;
13787:         }
13788:         else if (entry_handler != NULL && entry_data != NULL)
13789:         {
13790:             // Let type handler parse the line
13791:             entry_handler->ReadLineFn(&g, entry_handler, entry_data, line);
13792:         }
13793:     }
13794:     g.SettingsLoaded = true;
13795:     // [DEBUG] Restore untouched copy so it can be browsed in Metrics (not strictly necessary)
13796:     memcpy(buf, ini_data, ini_size);
13797:     // Call post-read handlers
13798:     for (ImGuiSettingsHandler& handler : g.SettingsHandlers)
13799:         if (handler.ApplyAllFn != NULL)
13800:             handler.ApplyAllFn(&g, &handler);
13801: }
13802: void ImGui::SaveIniSettingsToDisk(const char* ini_filename)
13803: {
13804:     ImGuiContext& g = *GImGui;
13805:     g.SettingsDirtyTimer = 0.0f;
13806:     if (!ini_filename)
13807:         return;
13808:     size_t ini_data_size = 0;
13809:     const char* ini_data = SaveIniSettingsToMemory(&ini_data_size);
13810:     ImFileHandle f = ImFileOpen(ini_filename, "wt");
13811:     if (!f)
13812:         return;
13813:     ImFileWrite(ini_data, sizeof(char), ini_data_size, f);
13814:     ImFileClose(f);
13815: }
13816: // Call registered handlers (e.g. SettingsHandlerWindow_WriteAll() + custom handlers) to write their stuff into a text buffer
13817: const char* ImGui::SaveIniSettingsToMemory(size_t* out_size)
13818: {
13819:     ImGuiContext& g = *GImGui;
13820:     g.SettingsDirtyTimer = 0.0f;
13821:     g.SettingsIniData.Buf.resize(0);
13822:     g.SettingsIniData.Buf.push_back(0);
13823:     for (ImGuiSettingsHandler& handler : g.SettingsHandlers)
13824:         handler.WriteAllFn(&g, &handler, &g.SettingsIniData);
13825:     if (out_size)
13826:         *out_size = (size_t)g.SettingsIniData.size();
13827:     return g.SettingsIniData.c_str();
13828: }
13829: ImGuiWindowSettings* ImGui::CreateNewWindowSettings(const char* name)
13830: {
13831:     ImGuiContext& g = *GImGui;
13832:     // Preserve the full string when ConfigDebugVerboseIniSettings is set to make .ini inspection easier.
13833:     if (g.IO.ConfigDebugIniSettings == false)
13834:         name = ImHashSkipUncontributingPrefix(name);
13835:     const size_t name_len = ImStrlen(name);
13836:     // Allocate chunk
13837:     const size_t chunk_size = sizeof(ImGuiWindowSettings) + name_len + 1;
13838:     ImGuiWindowSettings* settings = g.SettingsWindows.alloc_chunk(chunk_size);
13839:     IM_PLACEMENT_NEW(settings) ImGuiWindowSettings();
13840:     settings->ID = ImHashStr(name, name_len);
13841:     memcpy(settings->GetName(), name, name_len + 1);   // Store with zero terminator
13842:     return settings;
13843: }
13844: // We don't provide a FindWindowSettingsByName() because Docking system doesn't always hold on names.
13845: // This is called once per window .ini entry + once per newly instantiated window.
13846: ImGuiWindowSettings* ImGui::FindWindowSettingsByID(ImGuiID id)
13847: {
13848:     ImGuiContext& g = *GImGui;
13849:     for (ImGuiWindowSettings* settings = g.SettingsWindows.begin(); settings != NULL; settings = g.SettingsWindows.next_chunk(settings))
13850:         if (settings->ID == id && !settings->WantDelete)
13851:             return settings;
13852:     return NULL;
13853: }
13854: // This is faster if you are holding on a Window already as we don't need to perform a search.
13855: ImGuiWindowSettings* ImGui::FindWindowSettingsByWindow(ImGuiWindow* window)
13856: {
