765: //--------------------------------------------------------------------------------------------------------
766: // DPI-related helpers (optional)
767: //--------------------------------------------------------------------------------------------------------
768: // - Use to enable DPI awareness without having to create an application manifest.
769: // - Your own app may already do this via a manifest or explicit calls. This is mostly useful for our examples/ apps.
770: // - In theory we could call simple functions from Windows SDK such as SetProcessDPIAware(), SetProcessDpiAwareness(), etc.
771: //   but most of the functions provided by Microsoft require Windows 8.1/10+ SDK at compile time and Windows 8/10+ at runtime,
772: //   neither we want to require the user to have. So we dynamically select and load those functions to avoid dependencies.
773: //---------------------------------------------------------------------------------------------------------
774: // This is the scheme successfully used by GLFW (from which we borrowed some of the code) and other apps aiming to be highly portable.
775: // ImGui_ImplWin32_EnableDpiAwareness() is just a helper called by main.cpp, we don't call it automatically.
776: // If you are trying to implement your own backend for your own engine, you may ignore that noise.
777: //---------------------------------------------------------------------------------------------------------
778: // Perform our own check with RtlVerifyVersionInfo() instead of using functions from <VersionHelpers.h> as they
779: // require a manifest to be functional for checks above 8.1. See https://github.com/ocornut/imgui/issues/4200
780: static BOOL _IsWindowsVersionOrGreater(WORD major, WORD minor, WORD)
781: {
782:     typedef LONG(WINAPI* PFN_RtlVerifyVersionInfo)(OSVERSIONINFOEXW*, ULONG, ULONGLONG);
783:     static PFN_RtlVerifyVersionInfo RtlVerifyVersionInfoFn = nullptr;
784:     if (RtlVerifyVersionInfoFn == nullptr)
785:         if (HMODULE ntdllModule = ::GetModuleHandleA("ntdll.dll"))
786:             RtlVerifyVersionInfoFn = (PFN_RtlVerifyVersionInfo)GetProcAddress(ntdllModule, "RtlVerifyVersionInfo");
787:     if (RtlVerifyVersionInfoFn == nullptr)
788:         return FALSE;
789:     RTL_OSVERSIONINFOEXW versionInfo = { };
790:     ULONGLONG conditionMask = 0;
791:     versionInfo.dwOSVersionInfoSize = sizeof(RTL_OSVERSIONINFOEXW);
792:     versionInfo.dwMajorVersion = major;
793:     versionInfo.dwMinorVersion = minor;
794:     VER_SET_CONDITION(conditionMask, VER_MAJORVERSION, VER_GREATER_EQUAL);
795:     VER_SET_CONDITION(conditionMask, VER_MINORVERSION, VER_GREATER_EQUAL);
796:     return (RtlVerifyVersionInfoFn(&versionInfo, VER_MAJORVERSION | VER_MINORVERSION, conditionMask) == 0) ? TRUE : FALSE;
797: }
798: #define _IsWindowsVistaOrGreater()   _IsWindowsVersionOrGreater(HIBYTE(0x0600), LOBYTE(0x0600), 0) // _WIN32_WINNT_VISTA
799: #define _IsWindows8OrGreater()       _IsWindowsVersionOrGreater(HIBYTE(0x0602), LOBYTE(0x0602), 0) // _WIN32_WINNT_WIN8
800: #define _IsWindows8Point1OrGreater() _IsWindowsVersionOrGreater(HIBYTE(0x0603), LOBYTE(0x0603), 0) // _WIN32_WINNT_WINBLUE
801: #define _IsWindows10OrGreater()      _IsWindowsVersionOrGreater(HIBYTE(0x0A00), LOBYTE(0x0A00), 0) // _WIN32_WINNT_WINTHRESHOLD / _WIN32_WINNT_WIN10
802: #ifndef DPI_ENUMS_DECLARED
803: typedef enum { PROCESS_DPI_UNAWARE = 0, PROCESS_SYSTEM_DPI_AWARE = 1, PROCESS_PER_MONITOR_DPI_AWARE = 2 } PROCESS_DPI_AWARENESS;
804: typedef enum { MDT_EFFECTIVE_DPI = 0, MDT_ANGULAR_DPI = 1, MDT_RAW_DPI = 2, MDT_DEFAULT = MDT_EFFECTIVE_DPI } MONITOR_DPI_TYPE;
805: #endif
806: #ifndef _DPI_AWARENESS_CONTEXTS_
807: DECLARE_HANDLE(DPI_AWARENESS_CONTEXT);
808: #define DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE    (DPI_AWARENESS_CONTEXT)-3
809: #endif
810: #ifndef DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2
811: #define DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2 (DPI_AWARENESS_CONTEXT)-4
812: #endif
813: typedef HRESULT(WINAPI* PFN_SetProcessDpiAwareness)(PROCESS_DPI_AWARENESS);                     // Shcore.lib + dll, Windows 8.1+
814: typedef HRESULT(WINAPI* PFN_GetDpiForMonitor)(HMONITOR, MONITOR_DPI_TYPE, UINT*, UINT*);        // Shcore.lib + dll, Windows 8.1+
815: typedef DPI_AWARENESS_CONTEXT(WINAPI* PFN_SetThreadDpiAwarenessContext)(DPI_AWARENESS_CONTEXT); // User32.lib + dll, Windows 10 v1607+ (Creators Update)
816: // Helper function to enable DPI awareness without setting up a manifest
817: void ImGui_ImplWin32_EnableDpiAwareness()
818: {
819:     if (_IsWindows10OrGreater())
820:     {
821:         static HINSTANCE user32_dll = ::LoadLibraryA("user32.dll"); // Reference counted per-process
822:         if (PFN_SetThreadDpiAwarenessContext SetThreadDpiAwarenessContextFn = (PFN_SetThreadDpiAwarenessContext)::GetProcAddress(user32_dll, "SetThreadDpiAwarenessContext"))
823:         {
824:             SetThreadDpiAwarenessContextFn(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
825:             return;
826:         }
827:     }
828:     if (_IsWindows8Point1OrGreater())
829:     {
830:         static HINSTANCE shcore_dll = ::LoadLibraryA("shcore.dll"); // Reference counted per-process
831:         if (PFN_SetProcessDpiAwareness SetProcessDpiAwarenessFn = (PFN_SetProcessDpiAwareness)::GetProcAddress(shcore_dll, "SetProcessDpiAwareness"))
832:         {
833:             SetProcessDpiAwarenessFn(PROCESS_PER_MONITOR_DPI_AWARE);
834:             return;
835:         }
836:     }
837: #if _WIN32_WINNT >= 0x0600
838:     ::SetProcessDPIAware();
839: #endif
840: }
841: #if defined(_MSC_VER) && !defined(NOGDI)
842: #pragma comment(lib, "gdi32")   // Link with gdi32.lib for GetDeviceCaps(). MinGW will require linking with '-lgdi32'
843: #endif
844: float ImGui_ImplWin32_GetDpiScaleForMonitor(void* monitor)
845: {
846:     UINT xdpi = 96, ydpi = 96;
847:     if (_IsWindows8Point1OrGreater())
848:     {
849:         static HINSTANCE shcore_dll = ::LoadLibraryA("shcore.dll"); // Reference counted per-process
850:         static PFN_GetDpiForMonitor GetDpiForMonitorFn = nullptr;
851:         if (GetDpiForMonitorFn == nullptr && shcore_dll != nullptr)
852:             GetDpiForMonitorFn = (PFN_GetDpiForMonitor)::GetProcAddress(shcore_dll, "GetDpiForMonitor");
853:         if (GetDpiForMonitorFn != nullptr)
854:         {
855:             GetDpiForMonitorFn((HMONITOR)monitor, MDT_EFFECTIVE_DPI, &xdpi, &ydpi);
856:             IM_ASSERT(xdpi == ydpi); // Please contact me if you hit this assert!
857:             return xdpi / 96.0f;
858:         }
859:     }
860: #ifndef NOGDI
861:     const HDC dc = ::GetDC(nullptr);
862:     xdpi = ::GetDeviceCaps(dc, LOGPIXELSX);
863:     ydpi = ::GetDeviceCaps(dc, LOGPIXELSY);
864:     IM_ASSERT(xdpi == ydpi); // Please contact me if you hit this assert!
865:     ::ReleaseDC(nullptr, dc);
866: #endif
867:     return xdpi / 96.0f;
868: }
869: float ImGui_ImplWin32_GetDpiScaleForHwnd(void* hwnd)
870: {
871:     HMONITOR monitor = ::MonitorFromWindow((HWND)hwnd, MONITOR_DEFAULTTONEAREST);
872:     return ImGui_ImplWin32_GetDpiScaleForMonitor(monitor);
873: }
