 4292: // This is roughly matching the behavior of internal-facing ItemHoverable()
 4293: // - we allow hovering to be true when ActiveId==window->MoveID, so that clicking on non-interactive items such as a Text() item still returns true with IsItemHovered()
 4294: // - this should work even for non-interactive items that have no ID, so we cannot use LastItemId
 4295: bool ImGui::IsItemHovered(ImGuiHoveredFlags flags)
 4296: {
 4297:     ImGuiContext& g = *GImGui;
 4298:     ImGuiWindow* window = g.CurrentWindow;
 4299:     IM_ASSERT_USER_ERROR((flags & ~ImGuiHoveredFlags_AllowedMaskForIsItemHovered) == 0, "Invalid flags for IsItemHovered()!");
 4300:     if (g.NavHighlightItemUnderNav && g.NavCursorVisible && !(flags & ImGuiHoveredFlags_NoNavOverride))
 4301:     {
 4302:         if (!IsItemFocused())
 4303:             return false;
 4304:         if ((g.LastItemData.ItemFlags & ImGuiItemFlags_Disabled) && !(flags & ImGuiHoveredFlags_AllowWhenDisabled))
 4305:             return false;
 4306:         if (flags & ImGuiHoveredFlags_ForTooltip)
 4307:             flags = ApplyHoverFlagsForTooltip(flags, g.Style.HoverFlagsForTooltipNav);
 4308:     }
 4309:     else
 4310:     {
 4311:         // Test for bounding box overlap, as updated as ItemAdd()
 4312:         ImGuiItemStatusFlags status_flags = g.LastItemData.StatusFlags;
 4313:         if (!(status_flags & ImGuiItemStatusFlags_HoveredRect))
 4314:             return false;
 4315:         if (flags & ImGuiHoveredFlags_ForTooltip)
 4316:             flags = ApplyHoverFlagsForTooltip(flags, g.Style.HoverFlagsForTooltipMouse);
 4317:         // Done with rectangle culling so we can perform heavier checks now
 4318:         // Test if we are hovering the right window (our window could be behind another window)
 4319:         // [2021/03/02] Reworked / reverted the revert, finally. Note we want e.g. BeginGroup/ItemAdd/EndGroup to work as well. (#3851)
 4320:         // [2017/10/16] Reverted commit 344d48be3 and testing RootWindow instead. I believe it is correct to NOT test for RootWindow but this leaves us unable
 4321:         // to use IsItemHovered() after EndChild() itself. Until a solution is found I believe reverting to the test from 2017/09/27 is safe since this was
 4322:         // the test that has been running for a long while.
 4323:         if (g.HoveredWindow != window && (status_flags & ImGuiItemStatusFlags_HoveredWindow) == 0)
 4324:             if ((flags & ImGuiHoveredFlags_AllowWhenOverlappedByWindow) == 0)
 4325:                 return false;
 4326:         // Test if another item is active (e.g. being dragged)
 4327:         const ImGuiID id = g.LastItemData.ID;
 4328:         if ((flags & ImGuiHoveredFlags_AllowWhenBlockedByActiveItem) == 0)
 4329:             if (g.ActiveId != 0 && g.ActiveId != id && !g.ActiveIdAllowOverlap)
 4330:             {
 4331:                 // When ActiveId == MoveId it means that either:
 4332:                 // - (1) user clicked on void _or_ an item with no id, which triggers moving window (ActiveId is set even when window has _NoMove flag)
 4333:                 //   - the (id == 0) test handles it, however, IsItemHovered() will leak between id==0 items (mostly visible when using _NoMove). // FIXME: May be fixed.
 4334:                 // - (2) user clicked a disabled item. UpdateMouseMovingWindowEndFrame() uses ActiveId == MoveId to avoid interference with item logic + sets ActiveIdDisabledId.
 4335:                 bool cancel_is_hovered = true;
 4336:                 if (g.ActiveId == window->MoveId && (id == 0 || g.ActiveIdDisabledId == id))
 4337:                     cancel_is_hovered = false;
 4338:                 if (cancel_is_hovered)
 4339:                     return false;
 4340:             }
 4341:         // Test if interactions on this window are blocked by an active popup or modal.
 4342:         // The ImGuiHoveredFlags_AllowWhenBlockedByPopup flag will be tested here.
 4343:         if (!IsWindowContentHoverable(window, flags) && !(g.LastItemData.ItemFlags & ImGuiItemFlags_NoWindowHoverableCheck))
 4344:             return false;
 4345:         // Test if the item is disabled
 4346:         if ((g.LastItemData.ItemFlags & ImGuiItemFlags_Disabled) && !(flags & ImGuiHoveredFlags_AllowWhenDisabled))
 4347:             return false;
 4348:         // Special handling for calling after Begin() which represent the title bar or tab.
 4349:         // When the window is skipped/collapsed (SkipItems==true) that last item (always ->MoveId submitted by Begin)
 4350:         // will never be overwritten so we need to detect the case.
 4351:         if (id == window->MoveId && window->WriteAccessed)
 4352:             return false;
 4353:         // Test if using AllowOverlap and overlapped
 4354:         if ((g.LastItemData.ItemFlags & ImGuiItemFlags_AllowOverlap) && id != 0)
 4355:             if ((flags & ImGuiHoveredFlags_AllowWhenOverlappedByItem) == 0)
 4356:                 if (g.HoveredIdPreviousFrame != g.LastItemData.ID)
 4357:                     return false;
 4358:     }
 4359:     // Handle hover delay
 4360:     // (some ideas: https://www.nngroup.com/articles/timing-exposing-content)
 4361:     const float delay = CalcDelayFromHoveredFlags(flags);
 4362:     if (delay > 0.0f || (flags & ImGuiHoveredFlags_Stationary))
 4363:     {
 4364:         ImGuiID hover_delay_id = (g.LastItemData.ID != 0) ? g.LastItemData.ID : window->GetIDFromPos(g.LastItemData.Rect.Min);
 4365:         if ((flags & ImGuiHoveredFlags_NoSharedDelay) && (g.HoverItemDelayIdPreviousFrame != hover_delay_id))
 4366:             g.HoverItemDelayTimer = 0.0f;
 4367:         g.HoverItemDelayId = hover_delay_id;
 4368:         // When changing hovered item we requires a bit of stationary delay before activating hover timer,
 4369:         // but once unlocked on a given item we also moving.
 4370:         //if (g.HoverDelayTimer >= delay && (g.HoverDelayTimer - g.IO.DeltaTime < delay || g.MouseStationaryTimer - g.IO.DeltaTime < g.Style.HoverStationaryDelay)) { IMGUI_DEBUG_LOG("HoverDelayTimer = %f/%f, MouseStationaryTimer = %f\n", g.HoverDelayTimer, delay, g.MouseStationaryTimer); }
 4371:         if ((flags & ImGuiHoveredFlags_Stationary) != 0 && g.HoverItemUnlockedStationaryId != hover_delay_id)
 4372:             return false;
 4373:         if (g.HoverItemDelayTimer < delay)
 4374:             return false;
 4375:     }
 4376:     return true;
 4377: }
 4378: // Internal facing ItemHoverable() used when submitting widgets. THIS IS A SUBMISSION NOT A HOVER CHECK.
 4379: // Returns whether the item was hovered, logic differs slightly from IsItemHovered().
 4380: // (this does not rely on LastItemData it can be called from a ButtonBehavior() call not following an ItemAdd() call)
 4381: // FIXME-LEGACY: the 'ImGuiItemFlags item_flags' parameter was added on 2023-06-28.
 4382: // If you used this in your legacy/custom widgets code:
 4383: // - Commonly: if your ItemHoverable() call comes after an ItemAdd() call: pass 'item_flags = g.LastItemData.ItemFlags'.
 4384: // - Rare: otherwise you may pass 'item_flags = 0' (ImGuiItemFlags_None) unless you want to benefit from special behavior handled by ItemHoverable.
 4385: bool ImGui::ItemHoverable(const ImRect& bb, ImGuiID id, ImGuiItemFlags item_flags)
 4386: {
 4387:     ImGuiContext& g = *GImGui;
 4388:     ImGuiWindow* window = g.CurrentWindow;
 4389:     // Detect ID conflicts
 4390:     // (this is specifically done here by comparing on hover because it allows us a detection of duplicates that is algorithmically extra cheap, 1 u32 compare per item. No O(log N) lookup whatsoever)
 4391: #ifndef IMGUI_DISABLE_DEBUG_TOOLS
 4392:     if (id != 0 && g.HoveredIdPreviousFrame == id && (item_flags & ImGuiItemFlags_AllowDuplicateId) == 0)
 4393:     {
 4394:         g.HoveredIdPreviousFrameItemCount++;
 4395:         if (g.DebugDrawIdConflictsId == id)
 4396:             window->DrawList->AddRect(bb.Min - ImVec2(1,1), bb.Max + ImVec2(1,1), IM_COL32(255, 0, 0, 255), 0.0f, ImDrawFlags_None, 2.0f);
 4397:     }
 4398: #endif
 4399:     if (g.HoveredWindow != window)
 4400:         return false;
 4401:     if (!IsMouseHoveringRect(bb.Min, bb.Max))
 4402:         return false;
 4403:     if (g.HoveredId != 0 && g.HoveredId != id && !g.HoveredIdAllowOverlap)
 4404:         return false;
 4405:     if (g.ActiveId != 0 && g.ActiveId != id && !g.ActiveIdAllowOverlap)
 4406:         if (!g.ActiveIdFromShortcut)
 4407:             return false;
 4408:     // We are done with rectangle culling so we can perform heavier checks now.
 4409:     if (!(item_flags & ImGuiItemFlags_NoWindowHoverableCheck) && !IsWindowContentHoverable(window, ImGuiHoveredFlags_None))
 4410:     {
 4411:         g.HoveredIdIsDisabled = true;
 4412:         return false;
 4413:     }
 4414:     // We exceptionally allow this function to be called with id==0 to allow using it for easy high-level
 4415:     // hover test in widgets code. We could also decide to split this function is two.
 4416:     if (id != 0)
 4417:     {
 4418:         // Drag source doesn't report as hovered
 4419:         if (g.DragDropActive && g.DragDropPayload.SourceId == id && !(g.DragDropSourceFlags & ImGuiDragDropFlags_SourceNoDisableHover))
 4420:             return false;
 4421:         SetHoveredID(id);
 4422:         // AllowOverlap mode (rarely used) requires previous frame HoveredId to be null or to match.
 4423:         // This allows using patterns where a later submitted widget overlaps a previous one. Generally perceived as a front-to-back hit-test.
 4424:         if (item_flags & ImGuiItemFlags_AllowOverlap)
 4425:         {
 4426:             g.HoveredIdAllowOverlap = true;
 4427:             if (g.HoveredIdPreviousFrame != id)
 4428:                 return false;
 4429:         }
 4430:         // Display shortcut (only works with mouse)
 4431:         // (ImGuiItemStatusFlags_HasShortcut in LastItemData denotes we want a tooltip)
 4432:         if (id == g.LastItemData.ID && (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_HasShortcut) && g.ActiveId != id)
 4433:             if (IsItemHovered(ImGuiHoveredFlags_ForTooltip | ImGuiHoveredFlags_DelayNormal))
 4434:                 SetTooltip("%s", GetKeyChordName(g.LastItemData.Shortcut));
 4435:     }
 4436:     // When disabled we'll return false but still set HoveredId
 4437:     if (item_flags & ImGuiItemFlags_Disabled)
 4438:     {
 4439:         // Release active id if turning disabled
 4440:         if (g.ActiveId == id && id != 0)
 4441:             ClearActiveID();
 4442:         g.HoveredIdIsDisabled = true;
 4443:         return false;
 4444:     }
 4445: #ifndef IMGUI_DISABLE_DEBUG_TOOLS
 4446:     if (id != 0)
 4447:     {
 4448:         // [DEBUG] Item Picker tool!
 4449:         // We perform the check here because reaching is path is rare (1~ time a frame),
 4450:         // making the cost of this tool near-zero! We could get better call-stack and support picking non-hovered
 4451:         // items if we performed the test in ItemAdd(), but that would incur a bigger runtime cost.
 4452:         if (g.DebugItemPickerActive && g.HoveredIdPreviousFrame == id)
 4453:             GetForegroundDrawList()->AddRect(bb.Min, bb.Max, IM_COL32(255, 255, 0, 255));
 4454:         if (g.DebugItemPickerBreakId == id)
 4455:             IM_DEBUG_BREAK();
 4456:     }
 4457: #endif
 4458:     if (g.NavHighlightItemUnderNav && (item_flags & ImGuiItemFlags_NoNavDisableMouseHover) == 0)
 4459:         return false;
 4460:     return true;
 4461: }
