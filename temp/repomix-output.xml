10618:     window->ScrollTarget.y = IM_TRUNC(local_y - window->DecoOuterSizeY1 - window->DecoInnerSizeY1 + window->Scroll.y); // Convert local position to scroll offset
10619:     window->ScrollTargetCenterRatio.y = center_y_ratio;
10620:     window->ScrollTargetEdgeSnapDist.y = 0.0f;
10621: }
