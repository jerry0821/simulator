7794: int ImGui::PlotEx(ImGuiPlotType plot_type, const char* label, float (*values_getter)(void* data, int idx), void* data, int values_count, int values_offset, const char* overlay_text, float scale_min, float scale_max, const ImVec2& size_arg)
7795: {
7796:     ImGuiContext& g = *GImGui;
7797:     ImGuiWindow* window = GetCurrentWindow();
7798:     if (window->SkipItems)
7799:         return -1;
7800:     const ImGuiStyle& style = g.Style;
7801:     const ImGuiID id = window->GetID(label);
7802:     const ImVec2 label_size = CalcTextSize(label, NULL, true);
7803:     const ImVec2 frame_size = CalcItemSize(size_arg, CalcItemWidth(), label_size.y + style.FramePadding.y * 2.0f);
7804:     const ImRect frame_bb(window->DC.CursorPos, window->DC.CursorPos + frame_size);
7805:     const ImRect inner_bb(frame_bb.Min + style.FramePadding, frame_bb.Max - style.FramePadding);
7806:     const ImRect total_bb(frame_bb.Min, frame_bb.Max + ImVec2(label_size.x > 0.0f ? style.ItemInnerSpacing.x + label_size.x : 0.0f, 0));
7807:     ItemSize(total_bb, style.FramePadding.y);
7808:     if (!ItemAdd(total_bb, id, &frame_bb, ImGuiItemFlags_NoNav))
7809:         return -1;
7810:     bool hovered;
7811:     ButtonBehavior(frame_bb, id, &hovered, NULL);
7812:     // Determine scale from values if not specified
7813:     if (scale_min == FLT_MAX || scale_max == FLT_MAX)
7814:     {
7815:         float v_min = FLT_MAX;
7816:         float v_max = -FLT_MAX;
7817:         for (int i = 0; i < values_count; i++)
7818:         {
7819:             const float v = values_getter(data, i);
7820:             if (v != v) // Ignore NaN values
7821:                 continue;
7822:             v_min = ImMin(v_min, v);
7823:             v_max = ImMax(v_max, v);
7824:         }
7825:         if (scale_min == FLT_MAX)
7826:             scale_min = v_min;
7827:         if (scale_max == FLT_MAX)
7828:             scale_max = v_max;
7829:     }
7830:     RenderFrame(frame_bb.Min, frame_bb.Max, GetColorU32(ImGuiCol_FrameBg), true, style.FrameRounding);
7831:     const int values_count_min = (plot_type == ImGuiPlotType_Lines) ? 2 : 1;
7832:     int idx_hovered = -1;
7833:     if (values_count >= values_count_min)
7834:     {
7835:         int res_w = ImMin((int)frame_size.x, values_count) + ((plot_type == ImGuiPlotType_Lines) ? -1 : 0);
7836:         int item_count = values_count + ((plot_type == ImGuiPlotType_Lines) ? -1 : 0);
7837:         // Tooltip on hover
7838:         if (hovered && inner_bb.Contains(g.IO.MousePos))
7839:         {
7840:             const float t = ImClamp((g.IO.MousePos.x - inner_bb.Min.x) / (inner_bb.Max.x - inner_bb.Min.x), 0.0f, 0.9999f);
7841:             const int v_idx = (int)(t * item_count);
7842:             IM_ASSERT(v_idx >= 0 && v_idx < values_count);
7843:             const float v0 = values_getter(data, (v_idx + values_offset) % values_count);
7844:             const float v1 = values_getter(data, (v_idx + 1 + values_offset) % values_count);
7845:             if (plot_type == ImGuiPlotType_Lines)
7846:                 SetTooltip("%d: %8.4g\n%d: %8.4g", v_idx, v0, v_idx + 1, v1);
7847:             else if (plot_type == ImGuiPlotType_Histogram)
7848:                 SetTooltip("%d: %8.4g", v_idx, v0);
7849:             idx_hovered = v_idx;
7850:         }
7851:         const float t_step = 1.0f / (float)res_w;
7852:         const float inv_scale = (scale_min == scale_max) ? 0.0f : (1.0f / (scale_max - scale_min));
7853:         float v0 = values_getter(data, (0 + values_offset) % values_count);
7854:         float t0 = 0.0f;
7855:         ImVec2 tp0 = ImVec2( t0, 1.0f - ImSaturate((v0 - scale_min) * inv_scale) );                       // Point in the normalized space of our target rectangle
7856:         float histogram_zero_line_t = (scale_min * scale_max < 0.0f) ? (1 + scale_min * inv_scale) : (scale_min < 0.0f ? 0.0f : 1.0f);   // Where does the zero line stands
7857:         const ImU32 col_base = GetColorU32((plot_type == ImGuiPlotType_Lines) ? ImGuiCol_PlotLines : ImGuiCol_PlotHistogram);
7858:         const ImU32 col_hovered = GetColorU32((plot_type == ImGuiPlotType_Lines) ? ImGuiCol_PlotLinesHovered : ImGuiCol_PlotHistogramHovered);
7859:         for (int n = 0; n < res_w; n++)
7860:         {
7861:             const float t1 = t0 + t_step;
7862:             const int v1_idx = (int)(t0 * item_count + 0.5f);
7863:             IM_ASSERT(v1_idx >= 0 && v1_idx < values_count);
7864:             const float v1 = values_getter(data, (v1_idx + values_offset + 1) % values_count);
7865:             const ImVec2 tp1 = ImVec2( t1, 1.0f - ImSaturate((v1 - scale_min) * inv_scale) );
7866:             // NB: Draw calls are merged together by the DrawList system. Still, we should render our batch are lower level to save a bit of CPU.
7867:             ImVec2 pos0 = ImLerp(inner_bb.Min, inner_bb.Max, tp0);
7868:             ImVec2 pos1 = ImLerp(inner_bb.Min, inner_bb.Max, (plot_type == ImGuiPlotType_Lines) ? tp1 : ImVec2(tp1.x, histogram_zero_line_t));
7869:             if (plot_type == ImGuiPlotType_Lines)
7870:             {
7871:                 window->DrawList->AddLine(pos0, pos1, idx_hovered == v1_idx ? col_hovered : col_base);
7872:             }
7873:             else if (plot_type == ImGuiPlotType_Histogram)
7874:             {
7875:                 if (pos1.x >= pos0.x + 2.0f)
7876:                     pos1.x -= 1.0f;
7877:                 window->DrawList->AddRectFilled(pos0, pos1, idx_hovered == v1_idx ? col_hovered : col_base);
7878:             }
7879:             t0 = t1;
7880:             tp0 = tp1;
7881:         }
7882:     }
7883:     // Text overlay
7884:     if (overlay_text)
7885:         RenderTextClipped(ImVec2(frame_bb.Min.x, frame_bb.Min.y + style.FramePadding.y), frame_bb.Max, overlay_text, NULL, NULL, ImVec2(0.5f, 0.0f));
7886:     if (label_size.x > 0.0f)
7887:         RenderText(ImVec2(frame_bb.Max.x + style.ItemInnerSpacing.x, inner_bb.Min.y), label);
7888:     // Return hovered index or -1 if none are hovered.
7889:     // This is currently not exposed in the public API because we need a larger redesign of the whole thing, but in the short-term we are making it available in PlotEx().
7890:     return idx_hovered;
7891: }
