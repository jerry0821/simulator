2360:         const int merge_group_sub_count = has_freeze_v ? 2 : 1;
2361:         for (int merge_group_sub_n = 0; merge_group_sub_n < merge_group_sub_count; merge_group_sub_n++)
2362:         {
2363:             const int channel_no = (merge_group_sub_n == 0) ? column->DrawChannelFrozen : column->DrawChannelUnfrozen;
