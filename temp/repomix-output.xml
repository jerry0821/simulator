 1781: ImVec2 ImBezierCubicClosestPoint(const ImVec2& p1, const ImVec2& p2, const ImVec2& p3, const ImVec2& p4, const ImVec2& p, int num_segments)
 1782: {
 1783:     IM_ASSERT(num_segments > 0); // Use ImBezierCubicClosestPointCasteljau()
 1784:     ImVec2 p_last = p1;
 1785:     ImVec2 p_closest;
 1786:     float p_closest_dist2 = FLT_MAX;
 1787:     float t_step = 1.0f / (float)num_segments;
 1788:     for (int i_step = 1; i_step <= num_segments; i_step++)
 1789:     {
 1790:         ImVec2 p_current = ImBezierCubicCalc(p1, p2, p3, p4, t_step * i_step);
 1791:         ImVec2 p_line = ImLineClosestPoint(p_last, p_current, p);
 1792:         float dist2 = ImLengthSqr(p - p_line);
 1793:         if (dist2 < p_closest_dist2)
 1794:         {
 1795:             p_closest = p_line;
 1796:             p_closest_dist2 = dist2;
 1797:         }
 1798:         p_last = p_current;
 1799:     }
 1800:     return p_closest;
 1801: }
 1802: // Closely mimics PathBezierToCasteljau() in imgui_draw.cpp
 1803: static void ImBezierCubicClosestPointCasteljauStep(const ImVec2& p, ImVec2& p_closest, ImVec2& p_last, float& p_closest_dist2, float x1, float y1, float x2, float y2, float x3, float y3, float x4, float y4, float tess_tol, int level)
 1804: {
 1805:     float dx = x4 - x1;
 1806:     float dy = y4 - y1;
 1807:     float d2 = ((x2 - x4) * dy - (y2 - y4) * dx);
 1808:     float d3 = ((x3 - x4) * dy - (y3 - y4) * dx);
 1809:     d2 = (d2 >= 0) ? d2 : -d2;
 1810:     d3 = (d3 >= 0) ? d3 : -d3;
 1811:     if ((d2 + d3) * (d2 + d3) < tess_tol * (dx * dx + dy * dy))
 1812:     {
 1813:         ImVec2 p_current(x4, y4);
 1814:         ImVec2 p_line = ImLineClosestPoint(p_last, p_current, p);
 1815:         float dist2 = ImLengthSqr(p - p_line);
 1816:         if (dist2 < p_closest_dist2)
 1817:         {
 1818:             p_closest = p_line;
 1819:             p_closest_dist2 = dist2;
 1820:         }
 1821:         p_last = p_current;
 1822:     }
 1823:     else if (level < 10)
 1824:     {
 1825:         float x12 = (x1 + x2)*0.5f,       y12 = (y1 + y2)*0.5f;
 1826:         float x23 = (x2 + x3)*0.5f,       y23 = (y2 + y3)*0.5f;
 1827:         float x34 = (x3 + x4)*0.5f,       y34 = (y3 + y4)*0.5f;
 1828:         float x123 = (x12 + x23)*0.5f,    y123 = (y12 + y23)*0.5f;
 1829:         float x234 = (x23 + x34)*0.5f,    y234 = (y23 + y34)*0.5f;
 1830:         float x1234 = (x123 + x234)*0.5f, y1234 = (y123 + y234)*0.5f;
 1831:         ImBezierCubicClosestPointCasteljauStep(p, p_closest, p_last, p_closest_dist2, x1, y1, x12, y12, x123, y123, x1234, y1234, tess_tol, level + 1);
 1832:         ImBezierCubicClosestPointCasteljauStep(p, p_closest, p_last, p_closest_dist2, x1234, y1234, x234, y234, x34, y34, x4, y4, tess_tol, level + 1);
 1833:     }
 1834: }
 1835: // tess_tol is generally the same value you would find in ImGui::GetStyle().CurveTessellationTol
 1836: // Because those ImXXX functions are lower-level than ImGui:: we cannot access this value automatically.
 1837: ImVec2 ImBezierCubicClosestPointCasteljau(const ImVec2& p1, const ImVec2& p2, const ImVec2& p3, const ImVec2& p4, const ImVec2& p, float tess_tol)
 1838: {
 1839:     IM_ASSERT(tess_tol > 0.0f);
 1840:     ImVec2 p_last = p1;
 1841:     ImVec2 p_closest;
 1842:     float p_closest_dist2 = FLT_MAX;
 1843:     ImBezierCubicClosestPointCasteljauStep(p, p_closest, p_last, p_closest_dist2, p1.x, p1.y, p2.x, p2.y, p3.x, p3.y, p4.x, p4.y, tess_tol, 0);
 1844:     return p_closest;
 1845: }
 1846: ImVec2 ImLineClosestPoint(const ImVec2& a, const ImVec2& b, const ImVec2& p)
 1847: {
 1848:     ImVec2 ap = p - a;
 1849:     ImVec2 ab_dir = b - a;
 1850:     float dot = ap.x * ab_dir.x + ap.y * ab_dir.y;
 1851:     if (dot < 0.0f)
 1852:         return a;
 1853:     float ab_len_sqr = ab_dir.x * ab_dir.x + ab_dir.y * ab_dir.y;
 1854:     if (dot > ab_len_sqr)
 1855:         return b;
 1856:     return a + ab_dir * dot / ab_len_sqr;
 1857: }
 1858: bool ImTriangleContainsPoint(const ImVec2& a, const ImVec2& b, const ImVec2& c, const ImVec2& p)
 1859: {
 1860:     bool b1 = ((p.x - b.x) * (a.y - b.y) - (p.y - b.y) * (a.x - b.x)) < 0.0f;
 1861:     bool b2 = ((p.x - c.x) * (b.y - c.y) - (p.y - c.y) * (b.x - c.x)) < 0.0f;
 1862:     bool b3 = ((p.x - a.x) * (c.y - a.y) - (p.y - a.y) * (c.x - a.x)) < 0.0f;
 1863:     return (b1 == b2) && (b2 == b3);
 1864: }
 1865: void ImTriangleBarycentricCoords(const ImVec2& a, const ImVec2& b, const ImVec2& c, const ImVec2& p, float& out_u, float& out_v, float& out_w)
 1866: {
 1867:     ImVec2 v0 = b - a;
 1868:     ImVec2 v1 = c - a;
 1869:     ImVec2 v2 = p - a;
 1870:     const float denom = v0.x * v1.y - v1.x * v0.y;
 1871:     out_v = (v2.x * v1.y - v1.x * v2.y) / denom;
 1872:     out_w = (v0.x * v2.y - v2.x * v0.y) / denom;
 1873:     out_u = 1.0f - out_v - out_w;
 1874: }
 1875: ImVec2 ImTriangleClosestPoint(const ImVec2& a, const ImVec2& b, const ImVec2& c, const ImVec2& p)
 1876: {
 1877:     ImVec2 proj_ab = ImLineClosestPoint(a, b, p);
 1878:     ImVec2 proj_bc = ImLineClosestPoint(b, c, p);
 1879:     ImVec2 proj_ca = ImLineClosestPoint(c, a, p);
 1880:     float dist2_ab = ImLengthSqr(p - proj_ab);
 1881:     float dist2_bc = ImLengthSqr(p - proj_bc);
 1882:     float dist2_ca = ImLengthSqr(p - proj_ca);
 1883:     float m = ImMin(dist2_ab, ImMin(dist2_bc, dist2_ca));
 1884:     if (m == dist2_ab)
 1885:         return proj_ab;
 1886:     if (m == dist2_bc)
 1887:         return proj_bc;
 1888:     return proj_ca;
 1889: }
