451:           float minX = std::min(g_BuildDragStart.x, g_hitPos.x);
452:           float maxX = std::max(g_BuildDragStart.x, g_hitPos.x);
453:           float minZ = std::min(g_BuildDragStart.z, g_hitPos.z);
454:           float maxZ = std::max(g_BuildDragStart.z, g_hitPos.z);
455:           float ypos =
456:               g_BuildDragStart.y; // Keep the same height as the start point
457:           for (float x = minX; x <= maxX; x += 1.0f) {
458:             for (float z = minZ; z <= maxZ; z += 1.0f) {
459:               Map_AddShape(g_currentShape, {x, ypos, z}, g_currentRotation,
460:                            {1.0f, 1.0f, 1.0f});
