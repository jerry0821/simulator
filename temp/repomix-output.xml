<file path="sphere.cpp">
 1: #include "sphere.h"
 2: #include "direct3d.h"
 3: #include "shader3d.h"
 4: #include "texture.h"
 5: #include <cmath>
 6: #include <vector>
 7: using namespace DirectX;
 8: struct Vertex3D {
 9:   XMFLOAT3 position;
10:   XMFLOAT3 normal;
11:   XMFLOAT4 color;
12:   XMFLOAT2 texcoord;
13: };
14: static ID3D11Buffer *g_pVertexBuffer = nullptr;
15: static ID3D11Buffer *g_pIndexBuffer = nullptr;
16: static int g_IndexCount = 0;
17: static ID3D11Device *g_pDevice = nullptr;
18: static ID3D11DeviceContext *g_pContext = nullptr;
19: void Sphere_Initialize(ID3D11Device *pDevice, ID3D11DeviceContext *pContext) {
20:   g_pDevice = pDevice;
21:   g_pContext = pContext;
22:   int slices = 32;
23:   int stacks = 16;
24:   float radius = 0.5f;
25:   std::vector<Vertex3D> vertices;
26:   std::vector<unsigned short> indices;
27:   // Generate Vertices
28:   for (int i = 0; i <= stacks; ++i) {
29:     float v = (float)i / stacks;
30:     float phi = v * XM_PI;
31:     for (int j = 0; j <= slices; ++j) {
32:       float u = (float)j / slices;
33:       float theta = u * XM_2PI;
34:       float x = radius * sinf(phi) * cosf(theta);
35:       float y = radius * cosf(phi);
36:       float z = radius * sinf(phi) * sinf(theta);
37:       XMFLOAT3 pos(x, y, z);
38:       XMVECTOR n = XMVector3Normalize(XMLoadFloat3(&pos));
39:       XMFLOAT3 normal;
40:       XMStoreFloat3(&normal, n);
41:       vertices.push_back({pos, normal, {1.0f, 1.0f, 1.0f, 1.0f}, {u, v}});
42:     }
43:   }
44:   // Generate Indices
45:   for (int i = 0; i < stacks; ++i) {
46:     for (int j = 0; j < slices; ++j) {
47:       unsigned short top = i * (slices + 1) + j;
48:       unsigned short bottom = (i + 1) * (slices + 1) + j;
49:       indices.push_back(top);
50:       indices.push_back(bottom);
51:       indices.push_back(top + 1);
52:       indices.push_back(top + 1);
53:       indices.push_back(bottom);
54:       indices.push_back(bottom + 1);
55:     }
56:   }
57:   g_IndexCount = (int)indices.size();
58:   // Create Vertex Buffer
59:   D3D11_BUFFER_DESC vbDesc = {};
60:   vbDesc.Usage = D3D11_USAGE_DEFAULT;
61:   vbDesc.ByteWidth = sizeof(Vertex3D) * (UINT)vertices.size();
62:   vbDesc.BindFlags = D3D11_BIND_VERTEX_BUFFER;
63:   D3D11_SUBRESOURCE_DATA vbInitData = {};
64:   vbInitData.pSysMem = vertices.data();
65:   g_pDevice->CreateBuffer(&vbDesc, &vbInitData, &g_pVertexBuffer);
66:   // Create Index Buffer
67:   D3D11_BUFFER_DESC ibDesc = {};
68:   ibDesc.Usage = D3D11_USAGE_DEFAULT;
69:   ibDesc.ByteWidth = sizeof(unsigned short) * (UINT)indices.size();
70:   ibDesc.BindFlags = D3D11_BIND_INDEX_BUFFER;
71:   D3D11_SUBRESOURCE_DATA ibInitData = {};
72:   ibInitData.pSysMem = indices.data();
73:   g_pDevice->CreateBuffer(&ibDesc, &ibInitData, &g_pIndexBuffer);
74: }
75: void Sphere_Finalize(void) {
76:   SAFE_RELEASE(g_pVertexBuffer);
77:   SAFE_RELEASE(g_pIndexBuffer);
78: }
79: void Sphere_Draw(int texId, const DirectX::XMMATRIX &mtxWorld) {
80:   if (!g_pVertexBuffer || !g_pIndexBuffer)
81:     return;
82:   Shader3D_Begin();
83:   Shader3D_SetMaterialColor({1.0f, 1.0f, 1.0f, 1.0f});
84:   UINT stride = sizeof(Vertex3D);
85:   UINT offset = 0;
86:   g_pContext->IASetVertexBuffers(0, 1, &g_pVertexBuffer, &stride, &offset);
87:   g_pContext->IASetIndexBuffer(g_pIndexBuffer, DXGI_FORMAT_R16_UINT, 0);
88:   g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
89:   Shader3D_SetWorldMatrix(mtxWorld);
90:   Texture_SetTexture(texId);
91:   g_pContext->DrawIndexed(g_IndexCount, 0, 0);
92: }
</file>

