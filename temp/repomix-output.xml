 8960: static void ImGui::UpdateKeyboardInputs()
 8961: {
 8962:     ImGuiContext& g = *GImGui;
 8963:     ImGuiIO& io = g.IO;
 8964:     if (io.ConfigFlags & ImGuiConfigFlags_NoKeyboard)
 8965:         io.ClearInputKeys();
 8966:     // Update aliases
 8967:     for (int n = 0; n < ImGuiMouseButton_COUNT; n++)
 8968:         UpdateAliasKey(MouseButtonToKey(n), io.MouseDown[n], io.MouseDown[n] ? 1.0f : 0.0f);
 8969:     UpdateAliasKey(ImGuiKey_MouseWheelX, io.MouseWheelH != 0.0f, io.MouseWheelH);
 8970:     UpdateAliasKey(ImGuiKey_MouseWheelY, io.MouseWheel != 0.0f, io.MouseWheel);
 8971:     // Synchronize io.KeyMods and io.KeyCtrl/io.KeyShift/etc. values.
 8972:     // - New backends (1.87+): send io.AddKeyEvent(ImGuiMod_XXX) ->                                      -> (here) deriving io.KeyMods + io.KeyXXX from key array.
 8973:     // - Legacy backends:      set io.KeyXXX bools               -> (above) set key array from io.KeyXXX -> (here) deriving io.KeyMods + io.KeyXXX from key array.
 8974:     // So with legacy backends the 4 values will do a unnecessary back-and-forth but it makes the code simpler and future facing.
 8975:     const ImGuiKeyChord prev_key_mods = io.KeyMods;
 8976:     io.KeyMods = GetMergedModsFromKeys();
 8977:     io.KeyCtrl = (io.KeyMods & ImGuiMod_Ctrl) != 0;
 8978:     io.KeyShift = (io.KeyMods & ImGuiMod_Shift) != 0;
 8979:     io.KeyAlt = (io.KeyMods & ImGuiMod_Alt) != 0;
 8980:     io.KeySuper = (io.KeyMods & ImGuiMod_Super) != 0;
 8981:     if (prev_key_mods != io.KeyMods)
 8982:         g.LastKeyModsChangeTime = g.Time;
 8983:     if (prev_key_mods != io.KeyMods && prev_key_mods == 0)
 8984:         g.LastKeyModsChangeFromNoneTime = g.Time;
 8985:     // Clear gamepad data if disabled
 8986:     if ((io.BackendFlags & ImGuiBackendFlags_HasGamepad) == 0)
 8987:         for (int key = ImGuiKey_Gamepad_BEGIN; key < ImGuiKey_Gamepad_END; key++)
 8988:         {
 8989:             io.KeysData[key - ImGuiKey_NamedKey_BEGIN].Down = false;
 8990:             io.KeysData[key - ImGuiKey_NamedKey_BEGIN].AnalogValue = 0.0f;
 8991:         }
 8992:     // Update keys
 8993:     for (int key = ImGuiKey_NamedKey_BEGIN; key < ImGuiKey_NamedKey_END; key++)
 8994:     {
 8995:         ImGuiKeyData* key_data = &io.KeysData[key - ImGuiKey_NamedKey_BEGIN];
 8996:         key_data->DownDurationPrev = key_data->DownDuration;
 8997:         key_data->DownDuration = key_data->Down ? (key_data->DownDuration < 0.0f ? 0.0f : key_data->DownDuration + io.DeltaTime) : -1.0f;
 8998:         if (key_data->DownDuration == 0.0f)
 8999:         {
 9000:             if (IsKeyboardKey((ImGuiKey)key))
 9001:                 g.LastKeyboardKeyPressTime = g.Time;
 9002:             else if (key == ImGuiKey_ReservedForModCtrl || key == ImGuiKey_ReservedForModShift || key == ImGuiKey_ReservedForModAlt || key == ImGuiKey_ReservedForModSuper)
 9003:                 g.LastKeyboardKeyPressTime = g.Time;
 9004:         }
 9005:     }
 9006:     // Update keys/input owner (named keys only): one entry per key
 9007:     for (ImGuiKey key = ImGuiKey_NamedKey_BEGIN; key < ImGuiKey_NamedKey_END; key = (ImGuiKey)(key + 1))
 9008:     {
 9009:         ImGuiKeyData* key_data = &io.KeysData[key - ImGuiKey_NamedKey_BEGIN];
 9010:         ImGuiKeyOwnerData* owner_data = &g.KeysOwnerData[key - ImGuiKey_NamedKey_BEGIN];
 9011:         owner_data->OwnerCurr = owner_data->OwnerNext;
 9012:         if (!key_data->Down) // Important: ownership is released on the frame after a release. Ensure a 'MouseDown -> CloseWindow -> MouseUp' chain doesn't lead to someone else seeing the MouseUp.
 9013:             owner_data->OwnerNext = ImGuiKeyOwner_NoOwner;
 9014:         owner_data->LockThisFrame = owner_data->LockUntilRelease = owner_data->LockUntilRelease && key_data->Down;  // Clear LockUntilRelease when key is not Down anymore
 9015:     }
 9016:     // Update key routing (for e.g. shortcuts)
 9017:     UpdateKeyRoutingTable(&g.KeysRoutingTable);
 9018: }
 9019: static void ImGui::UpdateMouseInputs()
 9020: {
 9021:     ImGuiContext& g = *GImGui;
 9022:     ImGuiIO& io = g.IO;
 9023:     // Mouse Wheel swapping flag
 9024:     // As a standard behavior holding Shift while using Vertical Mouse Wheel triggers Horizontal scroll instead
 9025:     // - We avoid doing it on OSX as it the OS input layer handles this already.
 9026:     // - FIXME: However this means when running on OSX over Emscripten, Shift+WheelY will incur two swapping (1 in OS, 1 here), canceling the feature.
 9027:     // - FIXME: When we can distinguish e.g. touchpad scroll events from mouse ones, we'll set this accordingly based on input source.
 9028:     io.MouseWheelRequestAxisSwap = io.KeyShift && !io.ConfigMacOSXBehaviors;
 9029:     // Round mouse position to avoid spreading non-rounded position (e.g. UpdateManualResize doesn't support them well)
 9030:     if (IsMousePosValid(&io.MousePos))
 9031:         io.MousePos = g.MouseLastValidPos = ImFloor(io.MousePos);
 9032:     // If mouse just appeared or disappeared (usually denoted by -FLT_MAX components) we cancel out movement in MouseDelta
 9033:     if (IsMousePosValid(&io.MousePos) && IsMousePosValid(&io.MousePosPrev))
 9034:         io.MouseDelta = io.MousePos - io.MousePosPrev;
 9035:     else
 9036:         io.MouseDelta = ImVec2(0.0f, 0.0f);
 9037:     // Update stationary timer.
 9038:     // FIXME: May need to rework again to have some tolerance for occasional small movement, while being functional on high-framerates.
 9039:     const float mouse_stationary_threshold = (io.MouseSource == ImGuiMouseSource_Mouse) ? 2.0f : 3.0f; // Slightly higher threshold for ImGuiMouseSource_TouchScreen/ImGuiMouseSource_Pen, may need rework.
 9040:     const bool mouse_stationary = (ImLengthSqr(io.MouseDelta) <= mouse_stationary_threshold * mouse_stationary_threshold);
 9041:     g.MouseStationaryTimer = mouse_stationary ? (g.MouseStationaryTimer + io.DeltaTime) : 0.0f;
 9042:     //IMGUI_DEBUG_LOG("%.4f\n", g.MouseStationaryTimer);
 9043:     // If mouse moved we re-enable mouse hovering in case it was disabled by keyboard/gamepad. In theory should use a >0.0f threshold but would need to reset in everywhere we set this to true.
 9044:     if (io.MouseDelta.x != 0.0f || io.MouseDelta.y != 0.0f)
 9045:         g.NavHighlightItemUnderNav = false;
 9046:     for (int i = 0; i < IM_ARRAYSIZE(io.MouseDown); i++)
 9047:     {
 9048:         io.MouseClicked[i] = io.MouseDown[i] && io.MouseDownDuration[i] < 0.0f;
 9049:         io.MouseClickedCount[i] = 0; // Will be filled below
 9050:         io.MouseReleased[i] = !io.MouseDown[i] && io.MouseDownDuration[i] >= 0.0f;
 9051:         if (io.MouseReleased[i])
 9052:             io.MouseReleasedTime[i] = g.Time;
 9053:         io.MouseDownDurationPrev[i] = io.MouseDownDuration[i];
 9054:         io.MouseDownDuration[i] = io.MouseDown[i] ? (io.MouseDownDuration[i] < 0.0f ? 0.0f : io.MouseDownDuration[i] + io.DeltaTime) : -1.0f;
 9055:         if (io.MouseClicked[i])
 9056:         {
 9057:             bool is_repeated_click = false;
 9058:             if ((float)(g.Time - io.MouseClickedTime[i]) < io.MouseDoubleClickTime)
 9059:             {
 9060:                 ImVec2 delta_from_click_pos = IsMousePosValid(&io.MousePos) ? (io.MousePos - io.MouseClickedPos[i]) : ImVec2(0.0f, 0.0f);
 9061:                 if (ImLengthSqr(delta_from_click_pos) < io.MouseDoubleClickMaxDist * io.MouseDoubleClickMaxDist)
 9062:                     is_repeated_click = true;
 9063:             }
 9064:             if (is_repeated_click)
 9065:                 io.MouseClickedLastCount[i]++;
 9066:             else
 9067:                 io.MouseClickedLastCount[i] = 1;
 9068:             io.MouseClickedTime[i] = g.Time;
 9069:             io.MouseClickedPos[i] = io.MousePos;
 9070:             io.MouseClickedCount[i] = io.MouseClickedLastCount[i];
 9071:             io.MouseDragMaxDistanceSqr[i] = 0.0f;
 9072:         }
 9073:         else if (io.MouseDown[i])
 9074:         {
 9075:             // Maintain the maximum distance we reaching from the initial click position, which is used with dragging threshold
 9076:             float delta_sqr_click_pos = IsMousePosValid(&io.MousePos) ? ImLengthSqr(io.MousePos - io.MouseClickedPos[i]) : 0.0f;
 9077:             io.MouseDragMaxDistanceSqr[i] = ImMax(io.MouseDragMaxDistanceSqr[i], delta_sqr_click_pos);
 9078:         }
 9079:         // We provide io.MouseDoubleClicked[] as a legacy service
 9080:         io.MouseDoubleClicked[i] = (io.MouseClickedCount[i] == 2);
 9081:         // Clicking any mouse button reactivate mouse hovering which may have been deactivated by keyboard/gamepad navigation
 9082:         if (io.MouseClicked[i])
 9083:             g.NavHighlightItemUnderNav = false;
 9084:     }
 9085: }
 9086: static void LockWheelingWindow(ImGuiWindow* window, float wheel_amount)
 9087: {
 9088:     ImGuiContext& g = *GImGui;
 9089:     if (window)
 9090:         g.WheelingWindowReleaseTimer = ImMin(g.WheelingWindowReleaseTimer + ImAbs(wheel_amount) * WINDOWS_MOUSE_WHEEL_SCROLL_LOCK_TIMER, WINDOWS_MOUSE_WHEEL_SCROLL_LOCK_TIMER);
 9091:     else
 9092:         g.WheelingWindowReleaseTimer = 0.0f;
 9093:     if (g.WheelingWindow == window)
 9094:         return;
 9095:     IMGUI_DEBUG_LOG_IO("[io] LockWheelingWindow() \"%s\"\n", window ? window->Name : "NULL");
 9096:     g.WheelingWindow = window;
 9097:     g.WheelingWindowRefMousePos = g.IO.MousePos;
 9098:     if (window == NULL)
 9099:     {
 9100:         g.WheelingWindowStartFrame = -1;
 9101:         g.WheelingAxisAvg = ImVec2(0.0f, 0.0f);
 9102:     }
 9103: }
 9104: static ImGuiWindow* FindBestWheelingWindow(const ImVec2& wheel)
 9105: {
 9106:     // For each axis, find window in the hierarchy that may want to use scrolling
 9107:     ImGuiContext& g = *GImGui;
 9108:     ImGuiWindow* windows[2] = { NULL, NULL };
 9109:     for (int axis = 0; axis < 2; axis++)
 9110:         if (wheel[axis] != 0.0f)
 9111:             for (ImGuiWindow* window = windows[axis] = g.HoveredWindow; window->Flags & ImGuiWindowFlags_ChildWindow; window = windows[axis] = window->ParentWindow)
 9112:             {
 9113:                 // Bubble up into parent window if:
 9114:                 // - a child window doesn't allow any scrolling.
 9115:                 // - a child window has the ImGuiWindowFlags_NoScrollWithMouse flag.
 9116:                 //// - a child window doesn't need scrolling because it is already at the edge for the direction we are going in (FIXME-WIP)
 9117:                 const bool has_scrolling = (window->ScrollMax[axis] != 0.0f);
 9118:                 const bool inputs_disabled = (window->Flags & ImGuiWindowFlags_NoScrollWithMouse) && !(window->Flags & ImGuiWindowFlags_NoMouseInputs);
 9119:                 //const bool scrolling_past_limits = (wheel_v < 0.0f) ? (window->Scroll[axis] <= 0.0f) : (window->Scroll[axis] >= window->ScrollMax[axis]);
 9120:                 if (has_scrolling && !inputs_disabled) // && !scrolling_past_limits)
 9121:                     break; // select this window
 9122:             }
 9123:     if (windows[0] == NULL && windows[1] == NULL)
 9124:         return NULL;
 9125:     // If there's only one window or only one axis then there's no ambiguity
 9126:     if (windows[0] == windows[1] || windows[0] == NULL || windows[1] == NULL)
 9127:         return windows[1] ? windows[1] : windows[0];
 9128:     // If candidate are different windows we need to decide which one to prioritize
 9129:     // - First frame: only find a winner if one axis is zero.
 9130:     // - Subsequent frames: only find a winner when one is more than the other.
 9131:     if (g.WheelingWindowStartFrame == -1)
 9132:         g.WheelingWindowStartFrame = g.FrameCount;
 9133:     if ((g.WheelingWindowStartFrame == g.FrameCount && wheel.x != 0.0f && wheel.y != 0.0f) || (g.WheelingAxisAvg.x == g.WheelingAxisAvg.y))
 9134:     {
 9135:         g.WheelingWindowWheelRemainder = wheel;
 9136:         return NULL;
 9137:     }
 9138:     return (g.WheelingAxisAvg.x > g.WheelingAxisAvg.y) ? windows[0] : windows[1];
 9139: }
 9140: // Called by NewFrame()
 9141: void ImGui::UpdateMouseWheel()
 9142: {
 9143:     // Reset the locked window if we move the mouse or after the timer elapses.
 9144:     // FIXME: Ideally we could refactor to have one timer for "changing window w/ same axis" and a shorter timer for "changing window or axis w/ other axis" (#3795)
 9145:     ImGuiContext& g = *GImGui;
 9146:     if (g.WheelingWindow != NULL)
 9147:     {
 9148:         g.WheelingWindowReleaseTimer -= g.IO.DeltaTime;
 9149:         if (IsMousePosValid() && ImLengthSqr(g.IO.MousePos - g.WheelingWindowRefMousePos) > g.IO.MouseDragThreshold * g.IO.MouseDragThreshold)
 9150:             g.WheelingWindowReleaseTimer = 0.0f;
 9151:         if (g.WheelingWindowReleaseTimer <= 0.0f)
 9152:             LockWheelingWindow(NULL, 0.0f);
 9153:     }
 9154:     ImVec2 wheel;
 9155:     wheel.x = TestKeyOwner(ImGuiKey_MouseWheelX, ImGuiKeyOwner_NoOwner) ? g.IO.MouseWheelH : 0.0f;
 9156:     wheel.y = TestKeyOwner(ImGuiKey_MouseWheelY, ImGuiKeyOwner_NoOwner) ? g.IO.MouseWheel : 0.0f;
 9157:     //IMGUI_DEBUG_LOG("MouseWheel X:%.3f Y:%.3f\n", wheel_x, wheel_y);
 9158:     ImGuiWindow* mouse_window = g.WheelingWindow ? g.WheelingWindow : g.HoveredWindow;
 9159:     if (!mouse_window || mouse_window->Collapsed)
 9160:         return;
 9161:     // Zoom / Scale window
 9162:     // FIXME-OBSOLETE: This is an old feature, it still works but pretty much nobody is using it and may be best redesigned.
 9163:     if (wheel.y != 0.0f && g.IO.KeyCtrl && g.IO.FontAllowUserScaling)
 9164:     {
 9165:         LockWheelingWindow(mouse_window, wheel.y);
 9166:         ImGuiWindow* window = mouse_window;
 9167:         const float new_font_scale = ImClamp(window->FontWindowScale + g.IO.MouseWheel * 0.10f, 0.50f, 2.50f);
 9168:         const float scale = new_font_scale / window->FontWindowScale;
 9169:         window->FontWindowScale = new_font_scale;
 9170:         if (window == window->RootWindow)
 9171:         {
 9172:             const ImVec2 offset = window->Size * (1.0f - scale) * (g.IO.MousePos - window->Pos) / window->Size;
 9173:             SetWindowPos(window, window->Pos + offset, 0);
 9174:             window->Size = ImTrunc(window->Size * scale); // FIXME: Legacy-ish code, call SetWindowSize()?
 9175:             window->SizeFull = ImTrunc(window->SizeFull * scale);
 9176:             MarkIniSettingsDirty(window);
 9177:         }
 9178:         return;
 9179:     }
 9180:     if (g.IO.KeyCtrl)
 9181:         return;
 9182:     // Mouse wheel scrolling
 9183:     // Read about io.MouseWheelRequestAxisSwap and its issue on Mac+Emscripten in UpdateMouseInputs()
 9184:     if (g.IO.MouseWheelRequestAxisSwap)
 9185:         wheel = ImVec2(wheel.y, 0.0f);
 9186:     // Maintain a rough average of moving magnitude on both axes
 9187:     // FIXME: should by based on wall clock time rather than frame-counter
 9188:     g.WheelingAxisAvg.x = ImExponentialMovingAverage(g.WheelingAxisAvg.x, ImAbs(wheel.x), 30);
 9189:     g.WheelingAxisAvg.y = ImExponentialMovingAverage(g.WheelingAxisAvg.y, ImAbs(wheel.y), 30);
 9190:     // In the rare situation where FindBestWheelingWindow() had to defer first frame of wheeling due to ambiguous main axis, reinject it now.
 9191:     wheel += g.WheelingWindowWheelRemainder;
 9192:     g.WheelingWindowWheelRemainder = ImVec2(0.0f, 0.0f);
 9193:     if (wheel.x == 0.0f && wheel.y == 0.0f)
 9194:         return;
 9195:     // Mouse wheel scrolling: find target and apply
 9196:     // - don't renew lock if axis doesn't apply on the window.
 9197:     // - select a main axis when both axes are being moved.
 9198:     if (ImGuiWindow* window = (g.WheelingWindow ? g.WheelingWindow : FindBestWheelingWindow(wheel)))
 9199:         if (!(window->Flags & ImGuiWindowFlags_NoScrollWithMouse) && !(window->Flags & ImGuiWindowFlags_NoMouseInputs))
 9200:         {
 9201:             bool do_scroll[2] = { wheel.x != 0.0f && window->ScrollMax.x != 0.0f, wheel.y != 0.0f && window->ScrollMax.y != 0.0f };
 9202:             if (do_scroll[ImGuiAxis_X] && do_scroll[ImGuiAxis_Y])
 9203:                 do_scroll[(g.WheelingAxisAvg.x > g.WheelingAxisAvg.y) ? ImGuiAxis_Y : ImGuiAxis_X] = false;
 9204:             if (do_scroll[ImGuiAxis_X])
 9205:             {
 9206:                 LockWheelingWindow(window, wheel.x);
 9207:                 float max_step = window->InnerRect.GetWidth() * 0.67f;
 9208:                 float scroll_step = ImTrunc(ImMin(2 * window->FontRefSize, max_step));
 9209:                 SetScrollX(window, window->Scroll.x - wheel.x * scroll_step);
 9210:                 g.WheelingWindowScrolledFrame = g.FrameCount;
 9211:             }
 9212:             if (do_scroll[ImGuiAxis_Y])
 9213:             {
 9214:                 LockWheelingWindow(window, wheel.y);
 9215:                 float max_step = window->InnerRect.GetHeight() * 0.67f;
 9216:                 float scroll_step = ImTrunc(ImMin(5 * window->FontRefSize, max_step));
 9217:                 SetScrollY(window, window->Scroll.y - wheel.y * scroll_step);
 9218:                 g.WheelingWindowScrolledFrame = g.FrameCount;
 9219:             }
 9220:         }
 9221: }
