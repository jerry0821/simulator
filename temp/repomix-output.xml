2441:                 if ((merge_group_n & 1) == 0 || !has_freeze_h)
2442:                     merge_clip_rect.Min.x = ImMin(merge_clip_rect.Min.x, host_rect.Min.x);
2443:                 if ((merge_group_n & 2) == 0 || !has_freeze_v)
2444:                     merge_clip_rect.Min.y = ImMin(merge_clip_rect.Min.y, host_rect.Min.y);
2445:                 if ((merge_group_n & 1) != 0)
2446:                     merge_clip_rect.Max.x = ImMax(merge_clip_rect.Max.x, host_rect.Max.x);
2447:                 if ((merge_group_n & 2) != 0 && (table->Flags & ImGuiTableFlags_NoHostExtendY) == 0)
2448:                     merge_clip_rect.Max.y = ImMax(merge_clip_rect.Max.y, host_rect.Max.y);
2449:                 //GetForegroundDrawList()->AddRect(merge_group->ClipRect.Min, merge_group->ClipRect.Max, IM_COL32(255, 0, 0, 200), 0.0f, 0, 1.0f); // [DEBUG]
2450:                 //GetForegroundDrawList()->AddLine(merge_group->ClipRect.Min, merge_clip_rect.Min, IM_COL32(255, 100, 0, 200));
2451:                 //GetForegroundDrawList()->AddLine(merge_group->ClipRect.Max, merge_clip_rect.Max, IM_COL32(255, 100, 0, 200));
2452:                 remaining_count -= merge_group->ChannelsCount;
2453:                 for (int n = 0; n < (size_for_masks_bitarrays_one >> 2); n++)
2454:                     remaining_mask[n] &= ~merge_group->ChannelsMask[n];
2455:                 for (int n = 0; n < splitter->_Count && merge_channels_count != 0; n++)
2456:                 {
2457:                     // Copy + overwrite new clip rect
2458:                     if (!IM_BITARRAY_TESTBIT(merge_group->ChannelsMask, n))
2459:                         continue;
2460:                     IM_BITARRAY_CLEARBIT(merge_group->ChannelsMask, n);
2461:                     merge_channels_count--;
2462:                     ImDrawChannel* channel = &splitter->_Channels[n];
2463:                     IM_ASSERT(channel->_CmdBuffer.Size == 1 && merge_clip_rect.Contains(ImRect(channel->_CmdBuffer[0].ClipRect)));
2464:                     channel->_CmdBuffer[0].ClipRect = merge_clip_rect.ToVec4();
2465:                     memcpy(dst_tmp++, channel, sizeof(ImDrawChannel));
2466:                 }
2467:             }
2468:             // Make sure Bg2DrawChannelUnfrozen appears in the middle of our groups (whereas Bg0/Bg1 and Bg2 frozen are fixed to 0 and 1)
2469:             if (merge_group_n == 1 && has_freeze_v)
2470:                 memcpy(dst_tmp++, &splitter->_Channels[table->Bg2DrawChannelUnfrozen], sizeof(ImDrawChannel));
2471:         }
2472:         // Append unmergeable channels that we didn't reorder at the end of the list
2473:         for (int n = 0; n < splitter->_Count && remaining_count != 0; n++)
2474:         {
2475:             if (!IM_BITARRAY_TESTBIT(remaining_mask, n))
2476:                 continue;
2477:             ImDrawChannel* channel = &splitter->_Channels[n];
2478:             memcpy(dst_tmp++, channel, sizeof(ImDrawChannel));
2479:             remaining_count--;
2480:         }
2481:         IM_ASSERT(dst_tmp == g.DrawChannelsTempMergeBuffer.Data + g.DrawChannelsTempMergeBuffer.Size);
2482:         memcpy(splitter->_Channels.Data + LEADING_DRAW_CHANNELS, g.DrawChannelsTempMergeBuffer.Data, (splitter->_Count - LEADING_DRAW_CHANNELS) * sizeof(ImDrawChannel));
2483:     }
2484: }
2485: static ImU32 TableGetColumnBorderCol(ImGuiTable* table, int order_n, int column_n)
2486: {
2487:     const bool is_hovered = (table->HoveredColumnBorder == column_n);
2488:     const bool is_resized = (table->ResizedColumn == column_n) && (table->InstanceInteracted == table->InstanceCurrent);
2489:     const bool is_frozen_separator = (table->FreezeColumnsCount == order_n + 1);
2490:     if (is_resized || is_hovered)
2491:         return ImGui::GetColorU32(is_resized ? ImGuiCol_SeparatorActive : ImGuiCol_SeparatorHovered);
2492:     if (is_frozen_separator || (table->Flags & (ImGuiTableFlags_NoBordersInBody | ImGuiTableFlags_NoBordersInBodyUntilResize)))
2493:         return table->BorderColorStrong;
2494:     return table->BorderColorLight;
2495: }
2496: // FIXME-TABLE: This is a mess, need to redesign how we render borders (as some are also done in TableEndRow)
2497: void ImGui::TableDrawBorders(ImGuiTable* table)
2498: {
2499:     ImGuiWindow* inner_window = table->InnerWindow;
2500:     if (!table->OuterWindow->ClipRect.Overlaps(table->OuterRect))
2501:         return;
2502:     ImDrawList* inner_drawlist = inner_window->DrawList;
2503:     table->DrawSplitter->SetCurrentChannel(inner_drawlist, TABLE_DRAW_CHANNEL_BG0);
2504:     inner_drawlist->PushClipRect(table->Bg0ClipRectForDrawCmd.Min, table->Bg0ClipRectForDrawCmd.Max, false);
2505:     // Draw inner border and resizing feedback
2506:     ImGuiTableInstanceData* table_instance = TableGetInstanceData(table, table->InstanceCurrent);
2507:     const float border_size = TABLE_BORDER_SIZE;
2508:     const float draw_y1 = ImMax(table->InnerRect.Min.y, (table->FreezeRowsCount >= 1 ? table->InnerRect.Min.y : table->WorkRect.Min.y) + table->AngledHeadersHeight) + ((table->Flags & ImGuiTableFlags_BordersOuterH) ? 1.0f : 0.0f);
2509:     const float draw_y2_body = table->InnerRect.Max.y;
2510:     const float draw_y2_head = table->IsUsingHeaders ? ImMin(table->InnerRect.Max.y, (table->FreezeRowsCount >= 1 ? table->InnerRect.Min.y : table->WorkRect.Min.y) + table_instance->LastTopHeadersRowHeight) : draw_y1;
2511:     if (table->Flags & ImGuiTableFlags_BordersInnerV)
2512:     {
2513:         for (int order_n = 0; order_n < table->ColumnsCount; order_n++)
2514:         {
2515:             if (!IM_BITARRAY_TESTBIT(table->EnabledMaskByDisplayOrder, order_n))
2516:                 continue;
2517:             const int column_n = table->DisplayOrderToIndex[order_n];
2518:             ImGuiTableColumn* column = &table->Columns[column_n];
2519:             const bool is_hovered = (table->HoveredColumnBorder == column_n);
2520:             const bool is_resized = (table->ResizedColumn == column_n) && (table->InstanceInteracted == table->InstanceCurrent);
2521:             const bool is_resizable = (column->Flags & (ImGuiTableColumnFlags_NoResize | ImGuiTableColumnFlags_NoDirectResize_)) == 0;
2522:             const bool is_frozen_separator = (table->FreezeColumnsCount == order_n + 1);
2523:             if (column->MaxX > table->InnerClipRect.Max.x && !is_resized)
2524:                 continue;
2525:             // Decide whether right-most column is visible
2526:             if (column->NextEnabledColumn == -1 && !is_resizable)
2527:                 if ((table->Flags & ImGuiTableFlags_SizingMask_) != ImGuiTableFlags_SizingFixedSame || (table->Flags & ImGuiTableFlags_NoHostExtendX))
2528:                     continue;
2529:             if (column->MaxX <= column->ClipRect.Min.x) // FIXME-TABLE FIXME-STYLE: Assume BorderSize==1, this is problematic if we want to increase the border size..
2530:                 continue;
2531:             // Draw in outer window so right-most column won't be clipped
2532:             float draw_y2 = draw_y2_head;
2533:             if (is_frozen_separator)
2534:                 draw_y2 = draw_y2_body;
2535:             else if ((table->Flags & ImGuiTableFlags_NoBordersInBodyUntilResize) != 0 && (is_hovered || is_resized))
2536:                 draw_y2 = draw_y2_body;
2537:             else if ((table->Flags & (ImGuiTableFlags_NoBordersInBodyUntilResize | ImGuiTableFlags_NoBordersInBody)) == 0)
2538:                 draw_y2 = draw_y2_body;
2539:             if (draw_y2 > draw_y1)
2540:                 inner_drawlist->AddLine(ImVec2(column->MaxX, draw_y1), ImVec2(column->MaxX, draw_y2), TableGetColumnBorderCol(table, order_n, column_n), border_size);
2541:         }
2542:     }
2543:     // Draw outer border
2544:     // FIXME: could use AddRect or explicit VLine/HLine helper?
2545:     if (table->Flags & ImGuiTableFlags_BordersOuter)
2546:     {
2547:         // Display outer border offset by 1 which is a simple way to display it without adding an extra draw call
2548:         // (Without the offset, in outer_window it would be rendered behind cells, because child windows are above their
2549:         // parent. In inner_window, it won't reach out over scrollbars. Another weird solution would be to display part
2550:         // of it in inner window, and the part that's over scrollbars in the outer window..)
2551:         // Either solution currently won't allow us to use a larger border size: the border would clipped.
2552:         const ImRect outer_border = table->OuterRect;
2553:         const ImU32 outer_col = table->BorderColorStrong;
2554:         if ((table->Flags & ImGuiTableFlags_BordersOuter) == ImGuiTableFlags_BordersOuter)
2555:         {
2556:             inner_drawlist->AddRect(outer_border.Min, outer_border.Max, outer_col, 0.0f, 0, border_size);
2557:         }
2558:         else if (table->Flags & ImGuiTableFlags_BordersOuterV)
2559:         {
2560:             inner_drawlist->AddLine(outer_border.Min, ImVec2(outer_border.Min.x, outer_border.Max.y), outer_col, border_size);
2561:             inner_drawlist->AddLine(ImVec2(outer_border.Max.x, outer_border.Min.y), outer_border.Max, outer_col, border_size);
2562:         }
2563:         else if (table->Flags & ImGuiTableFlags_BordersOuterH)
2564:         {
2565:             inner_drawlist->AddLine(outer_border.Min, ImVec2(outer_border.Max.x, outer_border.Min.y), outer_col, border_size);
2566:             inner_drawlist->AddLine(ImVec2(outer_border.Min.x, outer_border.Max.y), outer_border.Max, outer_col, border_size);
2567:         }
2568:     }
2569:     if ((table->Flags & ImGuiTableFlags_BordersInnerH) && table->RowPosY2 < table->OuterRect.Max.y)
2570:     {
2571:         // Draw bottom-most row border between it is above outer border.
2572:         const float border_y = table->RowPosY2;
2573:         if (border_y >= table->BgClipRect.Min.y && border_y < table->BgClipRect.Max.y)
2574:             inner_drawlist->AddLine(ImVec2(table->BorderX1, border_y), ImVec2(table->BorderX2, border_y), table->BorderColorLight, border_size);
2575:     }
2576:     inner_drawlist->PopClipRect();
2577: }
