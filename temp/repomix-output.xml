11466: // Moving window to front of display and set focus (which happens to be back of our sorted list)
11467: void ImGui::FocusWindow(ImGuiWindow* window, ImGuiFocusRequestFlags flags)
11468: {
11469:     ImGuiContext& g = *GImGui;
11470:     // Modal check?
11471:     if ((flags & ImGuiFocusRequestFlags_UnlessBelowModal) && (g.NavWindow != window)) // Early out in common case.
11472:         if (ImGuiWindow* blocking_modal = FindBlockingModal(window))
11473:         {
11474:             // This block would typically be reached in two situations:
11475:             // - API call to FocusWindow() with a window under a modal and ImGuiFocusRequestFlags_UnlessBelowModal flag.
11476:             // - User clicking on void or anything behind a modal while a modal is open (window == NULL)
11477:             IMGUI_DEBUG_LOG_FOCUS("[focus] FocusWindow(\"%s\", UnlessBelowModal): prevented by \"%s\".\n", window ? window->Name : "<NULL>", blocking_modal->Name);
11478:             if (window && window == window->RootWindow && (window->Flags & ImGuiWindowFlags_NoBringToFrontOnFocus) == 0)
11479:                 BringWindowToDisplayBehind(window, blocking_modal); // Still bring right under modal. (FIXME: Could move in focus list too?)
11480:             ClosePopupsOverWindow(GetTopMostPopupModal(), false); // Note how we need to use GetTopMostPopupModal() aad NOT blocking_modal, to handle nested modals
11481:             return;
11482:         }
11483:     // Find last focused child (if any) and focus it instead.
11484:     if ((flags & ImGuiFocusRequestFlags_RestoreFocusedChild) && window != NULL)
11485:         window = NavRestoreLastChildNavWindow(window);
11486:     // Apply focus
11487:     if (g.NavWindow != window)
11488:     {
11489:         SetNavWindow(window);
11490:         if (window && g.NavHighlightItemUnderNav)
11491:             g.NavMousePosDirty = true;
11492:         g.NavId = window ? window->NavLastIds[0] : 0; // Restore NavId
11493:         g.NavLayer = ImGuiNavLayer_Main;
11494:         SetNavFocusScope(window ? window->NavRootFocusScopeId : 0);
11495:         g.NavIdIsAlive = false;
11496:         g.NavLastValidSelectionUserData = ImGuiSelectionUserData_Invalid;
11497:         // Close popups if any
11498:         ClosePopupsOverWindow(window, false);
11499:     }
11500:     // Move the root window to the top of the pile
11501:     IM_ASSERT(window == NULL || window->RootWindow != NULL);
11502:     ImGuiWindow* focus_front_window = window ? window->RootWindow : NULL; // NB: In docking branch this is window->RootWindowDockStop
11503:     ImGuiWindow* display_front_window = window ? window->RootWindow : NULL;
11504:     // Steal active widgets. Some of the cases it triggers includes:
11505:     // - Focus a window while an InputText in another window is active, if focus happens before the old InputText can run.
11506:     // - When using Nav to activate menu items (due to timing of activating on press->new window appears->losing ActiveId)
11507:     if (g.ActiveId != 0 && g.ActiveIdWindow && g.ActiveIdWindow->RootWindow != focus_front_window)
11508:         if (!g.ActiveIdNoClearOnFocusLoss)
11509:             ClearActiveID();
11510:     // Passing NULL allow to disable keyboard focus
11511:     if (!window)
11512:         return;
11513:     // Bring to front
11514:     BringWindowToFocusFront(focus_front_window);
11515:     if (((window->Flags | display_front_window->Flags) & ImGuiWindowFlags_NoBringToFrontOnFocus) == 0)
11516:         BringWindowToDisplayFront(display_front_window);
11517: }
11518: void ImGui::FocusTopMostWindowUnderOne(ImGuiWindow* under_this_window, ImGuiWindow* ignore_window, ImGuiViewport* filter_viewport, ImGuiFocusRequestFlags flags)
11519: {
11520:     ImGuiContext& g = *GImGui;
11521:     IM_UNUSED(filter_viewport); // Unused in master branch.
11522:     int start_idx = g.WindowsFocusOrder.Size - 1;
11523:     if (under_this_window != NULL)
11524:     {
11525:         // Aim at root window behind us, if we are in a child window that's our own root (see #4640)
11526:         int offset = -1;
11527:         while (under_this_window->Flags & ImGuiWindowFlags_ChildWindow)
11528:         {
11529:             under_this_window = under_this_window->ParentWindow;
11530:             offset = 0;
11531:         }
11532:         start_idx = FindWindowFocusIndex(under_this_window) + offset;
11533:     }
11534:     for (int i = start_idx; i >= 0; i--)
11535:     {
11536:         // We may later decide to test for different NoXXXInputs based on the active navigation input (mouse vs nav) but that may feel more confusing to the user.
11537:         ImGuiWindow* window = g.WindowsFocusOrder[i];
11538:         if (window == ignore_window || !window->WasActive)
11539:             continue;
11540:         if ((window->Flags & (ImGuiWindowFlags_NoMouseInputs | ImGuiWindowFlags_NoNavInputs)) != (ImGuiWindowFlags_NoMouseInputs | ImGuiWindowFlags_NoNavInputs))
11541:         {
11542:             FocusWindow(window, flags);
11543:             return;
11544:         }
11545:     }
11546:     FocusWindow(NULL, flags);
11547: }
