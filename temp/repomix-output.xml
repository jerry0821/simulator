13882: static void* WindowSettingsHandler_ReadOpen(ImGuiContext*, ImGuiSettingsHandler*, const char* name)
13883: {
13884:     ImGuiID id = ImHashStr(name);
13885:     ImGuiWindowSettings* settings = ImGui::FindWindowSettingsByID(id);
13886:     if (settings)
13887:         *settings = ImGuiWindowSettings(); // Clear existing if recycling previous entry
13888:     else
13889:         settings = ImGui::CreateNewWindowSettings(name);
13890:     settings->ID = id;
13891:     settings->WantApply = true;
13892:     return (void*)settings;
13893: }
13894: static void WindowSettingsHandler_ReadLine(ImGuiContext*, ImGuiSettingsHandler*, void* entry, const char* line)
13895: {
13896:     ImGuiWindowSettings* settings = (ImGuiWindowSettings*)entry;
13897:     int x, y;
13898:     int i;
13899:     if (sscanf(line, "Pos=%i,%i", &x, &y) == 2)         { settings->Pos = ImVec2ih((short)x, (short)y); }
13900:     else if (sscanf(line, "Size=%i,%i", &x, &y) == 2)   { settings->Size = ImVec2ih((short)x, (short)y); }
13901:     else if (sscanf(line, "Collapsed=%d", &i) == 1)     { settings->Collapsed = (i != 0); }
13902:     else if (sscanf(line, "IsChild=%d", &i) == 1)       { settings->IsChild = (i != 0); }
13903: }
13904: // Apply to existing windows (if any)
13905: static void WindowSettingsHandler_ApplyAll(ImGuiContext* ctx, ImGuiSettingsHandler*)
13906: {
13907:     ImGuiContext& g = *ctx;
13908:     for (ImGuiWindowSettings* settings = g.SettingsWindows.begin(); settings != NULL; settings = g.SettingsWindows.next_chunk(settings))
13909:         if (settings->WantApply)
13910:         {
13911:             if (ImGuiWindow* window = ImGui::FindWindowByID(settings->ID))
13912:                 ApplyWindowSettings(window, settings);
13913:             settings->WantApply = false;
13914:         }
13915: }
13916: static void WindowSettingsHandler_WriteAll(ImGuiContext* ctx, ImGuiSettingsHandler* handler, ImGuiTextBuffer* buf)
13917: {
13918:     // Gather data from windows that were active during this session
13919:     // (if a window wasn't opened in this session we preserve its settings)
13920:     ImGuiContext& g = *ctx;
13921:     for (ImGuiWindow* window : g.Windows)
13922:     {
13923:         if (window->Flags & ImGuiWindowFlags_NoSavedSettings)
13924:             continue;
13925:         ImGuiWindowSettings* settings = ImGui::FindWindowSettingsByWindow(window);
13926:         if (!settings)
13927:         {
13928:             settings = ImGui::CreateNewWindowSettings(window->Name);
13929:             window->SettingsOffset = g.SettingsWindows.offset_from_ptr(settings);
13930:         }
13931:         IM_ASSERT(settings->ID == window->ID);
13932:         settings->Pos = ImVec2ih(window->Pos);
13933:         settings->Size = ImVec2ih(window->SizeFull);
13934:         settings->IsChild = (window->Flags & ImGuiWindowFlags_ChildWindow) != 0;
13935:         settings->Collapsed = window->Collapsed;
13936:         settings->WantDelete = false;
13937:     }
13938:     // Write to text buffer
13939:     buf->reserve(buf->size() + g.SettingsWindows.size() * 6); // ballpark reserve
13940:     for (ImGuiWindowSettings* settings = g.SettingsWindows.begin(); settings != NULL; settings = g.SettingsWindows.next_chunk(settings))
13941:     {
13942:         if (settings->WantDelete)
13943:             continue;
13944:         const char* settings_name = settings->GetName();
13945:         buf->appendf("[%s][%s]\n", handler->TypeName, settings_name);
13946:         if (settings->IsChild)
13947:         {
13948:             buf->appendf("IsChild=1\n");
13949:             buf->appendf("Size=%d,%d\n", settings->Size.x, settings->Size.y);
13950:         }
13951:         else
13952:         {
13953:             buf->appendf("Pos=%d,%d\n", settings->Pos.x, settings->Pos.y);
13954:             buf->appendf("Size=%d,%d\n", settings->Size.x, settings->Size.y);
13955:             if (settings->Collapsed)
13956:                 buf->appendf("Collapsed=1\n");
13957:         }
13958:         buf->append("\n");
13959:     }
13960: }
