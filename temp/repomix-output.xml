2320:       xAdvance += stbtt__GetGlyphGPOSInfoAdvance(info, g1, g2);
2321:    else if (info->kern)
2322:       xAdvance += stbtt__GetGlyphKernInfoAdvance(info, g1, g2);
2323:    return xAdvance;
