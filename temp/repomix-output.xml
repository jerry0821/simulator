3672: #define STB_TEXTEDIT_MOVELINEEND        STB_TEXTEDIT_MOVELINEEND_IMPL
3673: static void STB_TEXTEDIT_DELETECHARS(ImGuiInputTextState* obj, int pos, int n)
3674: {
3675:     // Offset remaining text (+ copy zero terminator)
3676:     IM_ASSERT(obj->TextSrc == obj->TextA.Data);
3677:     char* dst = obj->TextA.Data + pos;
3678:     char* src = obj->TextA.Data + pos + n;
3679:     memmove(dst, src, obj->TextLen - n - pos + 1);
3680:     obj->Edited = true;
3681:     obj->TextLen -= n;
3682: }
3683: static int STB_TEXTEDIT_INSERTCHARS(ImGuiInputTextState* obj, int pos, const char* new_text, int new_text_len)
3684: {
3685:     const bool is_resizable = (obj->Flags & ImGuiInputTextFlags_CallbackResize) != 0;
3686:     const int text_len = obj->TextLen;
3687:     IM_ASSERT(pos <= text_len);
3688:     // We support partial insertion (with a mod in stb_textedit.h)
3689:     const int avail = obj->BufCapacity - 1 - obj->TextLen;
3690:     if (!is_resizable && new_text_len > avail)
3691:         new_text_len = (int)(ImTextFindValidUtf8CodepointEnd(new_text, new_text + new_text_len, new_text + avail) - new_text); // Truncate to closest UTF-8 codepoint. Alternative: return 0 to cancel insertion.
3692:     if (new_text_len == 0)
3693:         return 0;
3694:     // Grow internal buffer if needed
3695:     IM_ASSERT(obj->TextSrc == obj->TextA.Data);
3696:     if (text_len + new_text_len + 1 > obj->TextA.Size && is_resizable)
3697:     {
3698:         obj->TextA.resize(text_len + ImClamp(new_text_len, 32, ImMax(256, new_text_len)) + 1);
3699:         obj->TextSrc = obj->TextA.Data;
3700:     }
3701:     char* text = obj->TextA.Data;
3702:     if (pos != text_len)
3703:         memmove(text + pos + new_text_len, text + pos, (size_t)(text_len - pos));
3704:     memcpy(text + pos, new_text, (size_t)new_text_len);
3705:     obj->Edited = true;
3706:     obj->TextLen += new_text_len;
3707:     obj->TextA[obj->TextLen] = '\0';
3708:     return new_text_len;
3709: }
