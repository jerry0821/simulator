 7933:         g.Style.FontSizeBase = (font->LegacySize > 0.0f ? font->LegacySize : FONT_DEFAULT_SIZE);
 7934:     // Set initial font
 7935:     g.Font = font;
 7936:     g.FontSizeBase = g.Style.FontSizeBase;
