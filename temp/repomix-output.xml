 43:   WIN32_FIND_DATAA fd;
 44:   HANDLE hFind = FindFirstFileA("resource/texture/*.*", &fd);
 45:   if (hFind != INVALID_HANDLE_VALUE) {
 46:     do {
 47:       if (!(fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) {
 48:         std::string fname(fd.cFileName);
 49:         std::string ext;
 50:         auto dot = fname.rfind('.');
 51:         if (dot != std::string::npos)
 52:           ext = fname.substr(dot);
 53:         for (auto &c : ext)
 54:           c = (char)tolower((unsigned char)c);
 55:         if (ext == ".png" || ext == ".jpg" || ext == ".bmp")
 56:           g_TexFiles.push_back(std::string("resource/texture/") + fname);
 57:       }
 58:     } while (FindNextFileA(hFind, &fd));
 59:     FindClose(hFind);
 60:   }
 61:   std::sort(g_TexFiles.begin(), g_TexFiles.end());
 62:   g_TexScanned = true;
 63: }
