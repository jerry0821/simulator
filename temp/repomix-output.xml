1700: // [Public] Starts into the first cell of a new row
1701: void ImGui::TableNextRow(ImGuiTableRowFlags row_flags, float row_min_height)
1702: {
1703:     ImGuiContext& g = *GImGui;
1704:     ImGuiTable* table = g.CurrentTable;
1705:     if (!table->IsLayoutLocked)
1706:         TableUpdateLayout(table);
1707:     if (table->IsInsideRow)
1708:         TableEndRow(table);
1709:     table->LastRowFlags = table->RowFlags;
1710:     table->RowFlags = row_flags;
1711:     table->RowCellPaddingY = g.Style.CellPadding.y;
1712:     table->RowMinHeight = row_min_height;
1713:     TableBeginRow(table);
1714:     // We honor min_row_height requested by user, but cannot guarantee per-row maximum height,
1715:     // because that would essentially require a unique clipping rectangle per-cell.
1716:     table->RowPosY2 += table->RowCellPaddingY * 2.0f;
1717:     table->RowPosY2 = ImMax(table->RowPosY2, table->RowPosY1 + row_min_height);
1718:     // Disable output until user calls TableNextColumn()
1719:     table->InnerWindow->SkipItems = true;
1720: }
1721: // [Internal] Only called by TableNextRow()
1722: void ImGui::TableBeginRow(ImGuiTable* table)
1723: {
1724:     ImGuiWindow* window = table->InnerWindow;
1725:     IM_ASSERT(!table->IsInsideRow);
1726:     // New row
1727:     table->CurrentRow++;
1728:     table->CurrentColumn = -1;
1729:     table->RowBgColor[0] = table->RowBgColor[1] = IM_COL32_DISABLE;
1730:     table->RowCellDataCurrent = -1;
1731:     table->IsInsideRow = true;
1732:     // Begin frozen rows
1733:     float next_y1 = table->RowPosY2;
1734:     if (table->CurrentRow == 0 && table->FreezeRowsCount > 0)
1735:         next_y1 = window->DC.CursorPos.y = table->OuterRect.Min.y;
1736:     table->RowPosY1 = table->RowPosY2 = next_y1;
1737:     table->RowTextBaseline = 0.0f;
1738:     table->RowIndentOffsetX = window->DC.Indent.x - table->HostIndentX; // Lock indent
1739:     window->DC.PrevLineTextBaseOffset = 0.0f;
1740:     window->DC.CursorPosPrevLine = ImVec2(window->DC.CursorPos.x, window->DC.CursorPos.y + table->RowCellPaddingY); // This allows users to call SameLine() to share LineSize between columns.
1741:     window->DC.PrevLineSize = window->DC.CurrLineSize = ImVec2(0.0f, 0.0f); // This allows users to call SameLine() to share LineSize between columns, and to call it from first column too.
1742:     window->DC.IsSameLine = window->DC.IsSetPos = false;
1743:     window->DC.CursorMaxPos.y = next_y1;
1744:     // Making the header BG color non-transparent will allow us to overlay it multiple times when handling smooth dragging.
1745:     if (table->RowFlags & ImGuiTableRowFlags_Headers)
1746:     {
1747:         TableSetBgColor(ImGuiTableBgTarget_RowBg0, GetColorU32(ImGuiCol_TableHeaderBg));
1748:         if (table->CurrentRow == 0)
1749:             table->IsUsingHeaders = true;
1750:     }
1751: }
1752: // [Internal] Called by TableNextRow()
1753: void ImGui::TableEndRow(ImGuiTable* table)
1754: {
1755:     ImGuiContext& g = *GImGui;
1756:     ImGuiWindow* window = g.CurrentWindow;
1757:     IM_ASSERT(window == table->InnerWindow);
1758:     IM_ASSERT(table->IsInsideRow);
1759:     if (table->CurrentColumn != -1)
1760:     {
1761:         TableEndCell(table);
1762:         table->CurrentColumn = -1;
1763:     }
1764:     // Logging
1765:     if (g.LogEnabled)
1766:         LogRenderedText(NULL, "|");
1767:     // Position cursor at the bottom of our row so it can be used for e.g. clipping calculation. However it is
1768:     // likely that the next call to TableBeginCell() will reposition the cursor to take account of vertical padding.
1769:     window->DC.CursorPos.y = table->RowPosY2;
1770:     // Row background fill
1771:     const float bg_y1 = table->RowPosY1;
1772:     const float bg_y2 = table->RowPosY2;
1773:     const bool unfreeze_rows_actual = (table->CurrentRow + 1 == table->FreezeRowsCount);
1774:     const bool unfreeze_rows_request = (table->CurrentRow + 1 == table->FreezeRowsRequest);
1775:     ImGuiTableInstanceData* table_instance = TableGetInstanceData(table, table->InstanceCurrent);
1776:     if ((table->RowFlags & ImGuiTableRowFlags_Headers) && (table->CurrentRow == 0 || (table->LastRowFlags & ImGuiTableRowFlags_Headers)))
1777:         table_instance->LastTopHeadersRowHeight += bg_y2 - bg_y1;
1778:     const bool is_visible = (bg_y2 >= table->InnerClipRect.Min.y && bg_y1 <= table->InnerClipRect.Max.y);
1779:     if (is_visible)
1780:     {
1781:         // Update data for TableGetHoveredRow()
1782:         if (table->HoveredColumnBody != -1 && g.IO.MousePos.y >= bg_y1 && g.IO.MousePos.y < bg_y2 && table_instance->HoveredRowNext < 0)
1783:             table_instance->HoveredRowNext = table->CurrentRow;
1784:         // Decide of background color for the row
1785:         ImU32 bg_col0 = 0;
1786:         ImU32 bg_col1 = 0;
1787:         if (table->RowBgColor[0] != IM_COL32_DISABLE)
1788:             bg_col0 = table->RowBgColor[0];
1789:         else if (table->Flags & ImGuiTableFlags_RowBg)
1790:             bg_col0 = GetColorU32((table->RowBgColorCounter & 1) ? ImGuiCol_TableRowBgAlt : ImGuiCol_TableRowBg);
1791:         if (table->RowBgColor[1] != IM_COL32_DISABLE)
1792:             bg_col1 = table->RowBgColor[1];
1793:         // Decide of top border color
1794:         ImU32 top_border_col = 0;
1795:         const float border_size = TABLE_BORDER_SIZE;
1796:         if (table->CurrentRow > 0 && (table->Flags & ImGuiTableFlags_BordersInnerH))
1797:             top_border_col = (table->LastRowFlags & ImGuiTableRowFlags_Headers) ? table->BorderColorStrong : table->BorderColorLight;
1798:         const bool draw_cell_bg_color = table->RowCellDataCurrent >= 0;
1799:         const bool draw_strong_bottom_border = unfreeze_rows_actual;
1800:         if ((bg_col0 | bg_col1 | top_border_col) != 0 || draw_strong_bottom_border || draw_cell_bg_color)
1801:         {
1802:             // In theory we could call SetWindowClipRectBeforeSetChannel() but since we know TableEndRow() is
1803:             // always followed by a change of clipping rectangle we perform the smallest overwrite possible here.
1804:             if ((table->Flags & ImGuiTableFlags_NoClip) == 0)
1805:                 window->DrawList->_CmdHeader.ClipRect = table->Bg0ClipRectForDrawCmd.ToVec4();
1806:             table->DrawSplitter->SetCurrentChannel(window->DrawList, TABLE_DRAW_CHANNEL_BG0);
1807:         }
1808:         // Draw row background
1809:         // We soft/cpu clip this so all backgrounds and borders can share the same clipping rectangle
1810:         if (bg_col0 || bg_col1)
1811:         {
1812:             ImRect row_rect(table->WorkRect.Min.x, bg_y1, table->WorkRect.Max.x, bg_y2);
1813:             row_rect.ClipWith(table->BgClipRect);
1814:             if (bg_col0 != 0 && row_rect.Min.y < row_rect.Max.y)
1815:                 window->DrawList->AddRectFilled(row_rect.Min, row_rect.Max, bg_col0);
1816:             if (bg_col1 != 0 && row_rect.Min.y < row_rect.Max.y)
1817:                 window->DrawList->AddRectFilled(row_rect.Min, row_rect.Max, bg_col1);
1818:         }
1819:         // Draw cell background color
1820:         if (draw_cell_bg_color)
1821:         {
1822:             ImGuiTableCellData* cell_data_end = &table->RowCellData[table->RowCellDataCurrent];
1823:             for (ImGuiTableCellData* cell_data = &table->RowCellData[0]; cell_data <= cell_data_end; cell_data++)
1824:             {
1825:                 // As we render the BG here we need to clip things (for layout we would not)
1826:                 // FIXME: This cancels the OuterPadding addition done by TableGetCellBgRect(), need to keep it while rendering correctly while scrolling.
1827:                 const ImGuiTableColumn* column = &table->Columns[cell_data->Column];
1828:                 ImRect cell_bg_rect = TableGetCellBgRect(table, cell_data->Column);
1829:                 cell_bg_rect.ClipWith(table->BgClipRect);
1830:                 cell_bg_rect.Min.x = ImMax(cell_bg_rect.Min.x, column->ClipRect.Min.x);     // So that first column after frozen one gets clipped when scrolling
1831:                 cell_bg_rect.Max.x = ImMin(cell_bg_rect.Max.x, column->MaxX);
1832:                 if (cell_bg_rect.Min.y < cell_bg_rect.Max.y)
1833:                     window->DrawList->AddRectFilled(cell_bg_rect.Min, cell_bg_rect.Max, cell_data->BgColor);
1834:             }
1835:         }
1836:         // Draw top border
1837:         if (top_border_col && bg_y1 >= table->BgClipRect.Min.y && bg_y1 < table->BgClipRect.Max.y)
1838:             window->DrawList->AddLine(ImVec2(table->BorderX1, bg_y1), ImVec2(table->BorderX2, bg_y1), top_border_col, border_size);
1839:         // Draw bottom border at the row unfreezing mark (always strong)
1840:         if (draw_strong_bottom_border && bg_y2 >= table->BgClipRect.Min.y && bg_y2 < table->BgClipRect.Max.y)
1841:             window->DrawList->AddLine(ImVec2(table->BorderX1, bg_y2), ImVec2(table->BorderX2, bg_y2), table->BorderColorStrong, border_size);
1842:     }
1843:     // End frozen rows (when we are past the last frozen row line, teleport cursor and alter clipping rectangle)
1844:     // - We need to do that in TableEndRow() instead of TableBeginRow() so the list clipper can mark
1845:     //   end of row and get the new cursor position.
1846:     if (unfreeze_rows_request)
1847:     {
1848:         IM_ASSERT(table->FreezeRowsRequest > 0);
1849:         for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
1850:             table->Columns[column_n].NavLayerCurrent = table->NavLayer;
1851:         const float y0 = ImMax(table->RowPosY2 + 1, table->InnerClipRect.Min.y);
1852:         table_instance->LastFrozenHeight = y0 - table->OuterRect.Min.y;
1853:         if (unfreeze_rows_actual)
1854:         {
1855:             IM_ASSERT(table->IsUnfrozenRows == false);
1856:             table->IsUnfrozenRows = true;
1857:             // BgClipRect starts as table->InnerClipRect, reduce it now and make BgClipRectForDrawCmd == BgClipRect
1858:             table->BgClipRect.Min.y = table->Bg2ClipRectForDrawCmd.Min.y = ImMin(y0, table->InnerClipRect.Max.y);
1859:             table->BgClipRect.Max.y = table->Bg2ClipRectForDrawCmd.Max.y = table->InnerClipRect.Max.y;
1860:             table->Bg2DrawChannelCurrent = table->Bg2DrawChannelUnfrozen;
1861:             IM_ASSERT(table->Bg2ClipRectForDrawCmd.Min.y <= table->Bg2ClipRectForDrawCmd.Max.y);
1862:             float row_height = table->RowPosY2 - table->RowPosY1;
1863:             table->RowPosY2 = window->DC.CursorPos.y = table->WorkRect.Min.y + table->RowPosY2 - table->OuterRect.Min.y;
1864:             table->RowPosY1 = table->RowPosY2 - row_height;
1865:             for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
1866:             {
1867:                 ImGuiTableColumn* column = &table->Columns[column_n];
1868:                 column->DrawChannelCurrent = column->DrawChannelUnfrozen;
1869:                 column->ClipRect.Min.y = table->Bg2ClipRectForDrawCmd.Min.y;
1870:             }
1871:             // Update cliprect ahead of TableBeginCell() so clipper can access to new ClipRect->Min.y
1872:             SetWindowClipRectBeforeSetChannel(window, table->Columns[0].ClipRect);
1873:             table->DrawSplitter->SetCurrentChannel(window->DrawList, table->Columns[0].DrawChannelCurrent);
1874:         }
1875:     }
1876:     if (!(table->RowFlags & ImGuiTableRowFlags_Headers))
1877:         table->RowBgColorCounter++;
1878:     table->IsInsideRow = false;
1879: }
