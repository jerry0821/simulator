1266: #if 0
1267:     // Strip out dummy channel draw calls
1268:     // We have no way to prevent user submitting direct ImDrawList calls into a hidden column (but ImGui:: calls will be clipped out)
1269:     // Pros: remove draw calls which will have no effect. since they'll have zero-size cliprect they may be early out anyway.
1270:     // Cons: making it harder for users watching metrics/debugger to spot the wasted vertices.
1271:     if (table->DummyDrawChannel != (ImGuiTableColumnIdx)-1)
1272:     {
1273:         ImDrawChannel* dummy_channel = &table->DrawSplitter._Channels[table->DummyDrawChannel];
1274:         dummy_channel->_CmdBuffer.resize(0);
1275:         dummy_channel->_IdxBuffer.resize(0);
1276:     }
1277: #endif
1278:     // Flatten channels and merge draw calls
1279:     ImDrawListSplitter* splitter = table->DrawSplitter;
1280:     splitter->SetCurrentChannel(inner_window->DrawList, 0);
1281:     if ((table->Flags & ImGuiTableFlags_NoClip) == 0)
1282:         TableMergeDrawChannels(table);
1283:     splitter->Merge(inner_window->DrawList);
1284:     // Update ColumnsAutoFitWidth to get us ahead for host using our size to auto-resize without waiting for next BeginTable()
1285:     float auto_fit_width_for_fixed = 0.0f;
1286:     float auto_fit_width_for_stretched = 0.0f;
1287:     float auto_fit_width_for_stretched_min = 0.0f;
1288:     for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
1289:         if (IM_BITARRAY_TESTBIT(table->EnabledMaskByIndex, column_n))
1290:         {
1291:             ImGuiTableColumn* column = &table->Columns[column_n];
1292:             float column_width_request = ((column->Flags & ImGuiTableColumnFlags_WidthFixed) && !(column->Flags & ImGuiTableColumnFlags_NoResize)) ? column->WidthRequest : TableGetColumnWidthAuto(table, column);
1293:             if (column->Flags & ImGuiTableColumnFlags_WidthFixed)
1294:                 auto_fit_width_for_fixed += column_width_request;
1295:             else
1296:                 auto_fit_width_for_stretched += column_width_request;
1297:             if ((column->Flags & ImGuiTableColumnFlags_WidthStretch) && (column->Flags & ImGuiTableColumnFlags_NoResize) != 0)
1298:                 auto_fit_width_for_stretched_min = ImMax(auto_fit_width_for_stretched_min, column_width_request / (column->StretchWeight / table->ColumnsStretchSumWeights));
1299:         }
1300:     const float width_spacings = (table->OuterPaddingX * 2.0f) + (table->CellSpacingX1 + table->CellSpacingX2) * (table->ColumnsEnabledCount - 1);
1301:     table->ColumnsAutoFitWidth = width_spacings + (table->CellPaddingX * 2.0f) * table->ColumnsEnabledCount + auto_fit_width_for_fixed + ImMax(auto_fit_width_for_stretched, auto_fit_width_for_stretched_min);
1302:     // Update scroll
1303:     if ((table->Flags & ImGuiTableFlags_ScrollX) == 0 && inner_window != outer_window)
1304:     {
1305:         inner_window->Scroll.x = 0.0f;
1306:     }
1307:     else if (table->LastResizedColumn != -1 && table->ResizedColumn == -1 && inner_window->ScrollbarX && table->InstanceInteracted == table->InstanceCurrent)
1308:     {
1309:         // When releasing a column being resized, scroll to keep the resulting column in sight
1310:         const float neighbor_width_to_keep_visible = table->MinColumnWidth + table->CellPaddingX * 2.0f;
1311:         ImGuiTableColumn* column = &table->Columns[table->LastResizedColumn];
1312:         if (column->MaxX < table->InnerClipRect.Min.x)
1313:             SetScrollFromPosX(inner_window, column->MaxX - inner_window->Pos.x - neighbor_width_to_keep_visible, 1.0f);
1314:         else if (column->MaxX > table->InnerClipRect.Max.x)
1315:             SetScrollFromPosX(inner_window, column->MaxX - inner_window->Pos.x + neighbor_width_to_keep_visible, 1.0f);
1316:     }
1317:     // Apply resizing/dragging at the end of the frame
1318:     if (table->ResizedColumn != -1 && table->InstanceCurrent == table->InstanceInteracted)
1319:     {
1320:         ImGuiTableColumn* column = &table->Columns[table->ResizedColumn];
1321:         const float new_x2 = (g.IO.MousePos.x - g.ActiveIdClickOffset.x + ImTrunc(TABLE_RESIZE_SEPARATOR_HALF_THICKNESS * g.CurrentDpiScale));
1322:         const float new_width = ImTrunc(new_x2 - column->MinX - table->CellSpacingX1 - table->CellPaddingX * 2.0f);
1323:         table->ResizedColumnNextWidth = new_width;
1324:     }
1325:     table->IsActiveIdInTable = (g.ActiveIdIsAlive != 0 && table->IsActiveIdAliveBeforeTable == false);
1326:     // Pop from id stack
1327:     IM_ASSERT_USER_ERROR(inner_window->IDStack.back() == table_instance->TableInstanceID, "Mismatching PushID/PopID!");
1328:     IM_ASSERT_USER_ERROR(outer_window->DC.ItemWidthStack.Size >= temp_data->HostBackupItemWidthStackSize, "Too many PopItemWidth!");
1329:     if (table->InstanceCurrent > 0)
1330:         PopID();
1331:     PopID();
1332:     // Restore window data that we modified
1333:     const ImVec2 backup_outer_max_pos = outer_window->DC.CursorMaxPos;
1334:     inner_window->WorkRect = temp_data->HostBackupWorkRect;
1335:     inner_window->ParentWorkRect = temp_data->HostBackupParentWorkRect;
1336:     inner_window->SkipItems = table->HostSkipItems;
1337:     outer_window->DC.CursorPos = table->OuterRect.Min;
1338:     outer_window->DC.ItemWidth = temp_data->HostBackupItemWidth;
1339:     outer_window->DC.ItemWidthStack.Size = temp_data->HostBackupItemWidthStackSize;
1340:     outer_window->DC.ColumnsOffset = temp_data->HostBackupColumnsOffset;
1341:     // Layout in outer window
1342:     // (FIXME: To allow auto-fit and allow desirable effect of SameLine() we dissociate 'used' vs 'ideal' size by overriding
1343:     // CursorPosPrevLine and CursorMaxPos manually. That should be a more general layout feature, see same problem e.g. #3414)
1344:     if (inner_window != outer_window)
1345:     {
1346:         short backup_nav_layers_active_mask = inner_window->DC.NavLayersActiveMask;
1347:         inner_window->DC.NavLayersActiveMask |= 1 << table->NavLayer; // So empty table don't appear to navigate differently.
1348:         g.CurrentTable = NULL; // To avoid error recovery recursing
1349:         EndChild();
1350:         g.CurrentTable = table;
1351:         inner_window->DC.NavLayersActiveMask = backup_nav_layers_active_mask;
1352:     }
1353:     else
1354:     {
1355:         table->InnerWindow->DC.TreeDepth--;
1356:         ItemSize(table->OuterRect.GetSize());
1357:         ItemAdd(table->OuterRect, 0);
1358:     }
1359:     // Override declared contents width/height to enable auto-resize while not needlessly adding a scrollbar
1360:     if (table->Flags & ImGuiTableFlags_NoHostExtendX)
1361:     {
1362:         // FIXME-TABLE: Could we remove this section?
1363:         // ColumnsAutoFitWidth may be one frame ahead here since for Fixed+NoResize is calculated from latest contents
1364:         IM_ASSERT((table->Flags & ImGuiTableFlags_ScrollX) == 0);
1365:         outer_window->DC.CursorMaxPos.x = ImMax(backup_outer_max_pos.x, table->OuterRect.Min.x + table->ColumnsAutoFitWidth);
1366:     }
1367:     else if (temp_data->UserOuterSize.x <= 0.0f)
1368:     {
1369:         // Some references for this: #7651 + tests "table_reported_size", "table_reported_size_outer" equivalent Y block
1370:         // - Checking for ImGuiTableFlags_ScrollX/ScrollY flag makes us a frame ahead when disabling those flags.
1371:         // - FIXME-TABLE: Would make sense to pre-compute expected scrollbar visibility/sizes to generally save a frame of feedback.
1372:         const float inner_content_max_x = table->OuterRect.Min.x + table->ColumnsAutoFitWidth; // Slightly misleading name but used for code symmetry with inner_content_max_y
1373:         const float decoration_size = table->TempData->AngledHeadersExtraWidth + ((table->Flags & ImGuiTableFlags_ScrollY) ? inner_window->ScrollbarSizes.x : 0.0f);
1374:         outer_window->DC.IdealMaxPos.x = ImMax(outer_window->DC.IdealMaxPos.x, inner_content_max_x + decoration_size - temp_data->UserOuterSize.x);
1375:         outer_window->DC.CursorMaxPos.x = ImMax(backup_outer_max_pos.x, ImMin(table->OuterRect.Max.x, inner_content_max_x + decoration_size));
1376:     }
1377:     else
1378:     {
1379:         outer_window->DC.CursorMaxPos.x = ImMax(backup_outer_max_pos.x, table->OuterRect.Max.x);
1380:     }
1381:     if (temp_data->UserOuterSize.y <= 0.0f)
1382:     {
1383:         const float decoration_size = (table->Flags & ImGuiTableFlags_ScrollX) ? inner_window->ScrollbarSizes.y : 0.0f;
1384:         outer_window->DC.IdealMaxPos.y = ImMax(outer_window->DC.IdealMaxPos.y, inner_content_max_y + decoration_size - temp_data->UserOuterSize.y);
1385:         outer_window->DC.CursorMaxPos.y = ImMax(backup_outer_max_pos.y, ImMin(table->OuterRect.Max.y, inner_content_max_y + decoration_size));
1386:     }
1387:     else
1388:     {
1389:         // OuterRect.Max.y may already have been pushed downward from the initial value (unless ImGuiTableFlags_NoHostExtendY is set)
1390:         outer_window->DC.CursorMaxPos.y = ImMax(backup_outer_max_pos.y, table->OuterRect.Max.y);
1391:     }
1392:     // Save settings
1393:     if (table->IsSettingsDirty)
1394:         TableSaveSettings(table);
1395:     table->IsInitializing = false;
1396:     // Clear or restore current table, if any
1397:     IM_ASSERT(g.CurrentWindow == outer_window && g.CurrentTable == table);
1398:     IM_ASSERT(g.TablesTempDataStacked > 0);
1399:     temp_data = (--g.TablesTempDataStacked > 0) ? &g.TablesTempData[g.TablesTempDataStacked - 1] : NULL;
1400:     g.CurrentTable = temp_data && (temp_data->WindowID == outer_window->ID) ? g.Tables.GetByIndex(temp_data->TableIndex) : NULL;
1401:     if (g.CurrentTable)
1402:     {
1403:         g.CurrentTable->TempData = temp_data;
1404:         g.CurrentTable->DrawSplitter = &temp_data->DrawSplitter;
1405:     }
1406:     outer_window->DC.CurrentTableIdx = g.CurrentTable ? g.Tables.GetIndex(g.CurrentTable) : -1;
1407:     NavUpdateCurrentWindowIsScrollPushableX();
1408: }
1409: // Called in TableSetupColumn() when initializing and in TableLoadSettings() for defaults before applying stored settings.
1410: // 'init_mask' specify which fields to initialize.
1411: static void TableInitColumnDefaults(ImGuiTable* table, ImGuiTableColumn* column, ImGuiTableColumnFlags init_mask)
1412: {
1413:     ImGuiTableColumnFlags flags = column->Flags;
1414:     if (init_mask & ImGuiTableFlags_Resizable)
1415:     {
1416:         float init_width_or_weight = column->InitStretchWeightOrWidth;
1417:         column->WidthRequest = ((flags & ImGuiTableColumnFlags_WidthFixed) && init_width_or_weight > 0.0f) ? init_width_or_weight : -1.0f;
1418:         column->StretchWeight = (init_width_or_weight > 0.0f && (flags & ImGuiTableColumnFlags_WidthStretch)) ? init_width_or_weight : -1.0f;
1419:         if (init_width_or_weight > 0.0f) // Disable auto-fit if an explicit width/weight has been specified
1420:             column->AutoFitQueue = 0x00;
1421:     }
1422:     if (init_mask & ImGuiTableFlags_Reorderable)
1423:         column->DisplayOrder = (ImGuiTableColumnIdx)table->Columns.index_from_ptr(column);
1424:     if (init_mask & ImGuiTableFlags_Hideable)
1425:         column->IsUserEnabled = column->IsUserEnabledNextFrame = (flags & ImGuiTableColumnFlags_DefaultHide) ? 0 : 1;
1426:     if (init_mask & ImGuiTableFlags_Sortable)
1427:     {
1428:         // Multiple columns using _DefaultSort will be reassigned unique SortOrder values when building the sort specs.
1429:         column->SortOrder = (flags & ImGuiTableColumnFlags_DefaultSort) ? 0 : -1;
1430:         column->SortDirection = (flags & ImGuiTableColumnFlags_DefaultSort) ? ((flags & ImGuiTableColumnFlags_PreferSortDescending) ? (ImS8)ImGuiSortDirection_Descending : (ImU8)(ImGuiSortDirection_Ascending)) : (ImS8)ImGuiSortDirection_None;
1431:     }
1432: }
1433: // See "COLUMNS SIZING POLICIES" comments at the top of this file
1434: // If (init_width_or_weight <= 0.0f) it is ignored
1435: void ImGui::TableSetupColumn(const char* label, ImGuiTableColumnFlags flags, float init_width_or_weight, ImGuiID user_id)
1436: {
1437:     ImGuiContext& g = *GImGui;
1438:     ImGuiTable* table = g.CurrentTable;
1439:     if (table == NULL)
1440:     {
1441:         IM_ASSERT_USER_ERROR(table != NULL, "Call should only be done while in BeginTable() scope!");
1442:         return;
1443:     }
1444:     IM_ASSERT(table->IsLayoutLocked == false && "Need to call TableSetupColumn() before first row!");
1445:     IM_ASSERT((flags & ImGuiTableColumnFlags_StatusMask_) == 0 && "Illegal to pass StatusMask values to TableSetupColumn()");
1446:     if (table->DeclColumnsCount >= table->ColumnsCount)
1447:     {
1448:         IM_ASSERT_USER_ERROR(table->DeclColumnsCount < table->ColumnsCount, "Called TableSetupColumn() too many times!");
1449:         return;
1450:     }
1451:     ImGuiTableColumn* column = &table->Columns[table->DeclColumnsCount];
1452:     table->DeclColumnsCount++;
1453:     // Assert when passing a width or weight if policy is entirely left to default, to avoid storing width into weight and vice-versa.
1454:     // Give a grace to users of ImGuiTableFlags_ScrollX.
1455:     if (table->IsDefaultSizingPolicy && (flags & ImGuiTableColumnFlags_WidthMask_) == 0 && (flags & ImGuiTableFlags_ScrollX) == 0)
1456:         IM_ASSERT(init_width_or_weight <= 0.0f && "Can only specify width/weight if sizing policy is set explicitly in either Table or Column.");
1457:     // When passing a width automatically enforce WidthFixed policy
1458:     // (whereas TableSetupColumnFlags would default to WidthAuto if table is not resizable)
1459:     if ((flags & ImGuiTableColumnFlags_WidthMask_) == 0 && init_width_or_weight > 0.0f)
1460:         if ((table->Flags & ImGuiTableFlags_SizingMask_) == ImGuiTableFlags_SizingFixedFit || (table->Flags & ImGuiTableFlags_SizingMask_) == ImGuiTableFlags_SizingFixedSame)
1461:             flags |= ImGuiTableColumnFlags_WidthFixed;
1462:     if (flags & ImGuiTableColumnFlags_AngledHeader)
1463:     {
1464:         flags |= ImGuiTableColumnFlags_NoHeaderLabel;
1465:         table->AngledHeadersCount++;
1466:     }
1467:     TableSetupColumnFlags(table, column, flags);
1468:     column->UserID = user_id;
1469:     flags = column->Flags;
1470:     // Initialize defaults
1471:     column->InitStretchWeightOrWidth = init_width_or_weight;
1472:     if (table->IsInitializing)
1473:     {
1474:         ImGuiTableFlags init_flags = ~table->SettingsLoadedFlags;
1475:         if (column->WidthRequest < 0.0f && column->StretchWeight < 0.0f)
1476:             init_flags |= ImGuiTableFlags_Resizable;
1477:         TableInitColumnDefaults(table, column, init_flags);
1478:     }
1479:     // Store name (append with zero-terminator in contiguous buffer)
1480:     // FIXME: If we recorded the number of \n in names we could compute header row height
1481:     column->NameOffset = -1;
1482:     if (label != NULL && label[0] != 0)
1483:     {
1484:         column->NameOffset = (ImS16)table->ColumnsNames.size();
1485:         table->ColumnsNames.append(label, label + ImStrlen(label) + 1);
1486:     }
1487: }
1488: // [Public]
1489: void ImGui::TableSetupScrollFreeze(int columns, int rows)
1490: {
1491:     ImGuiContext& g = *GImGui;
1492:     ImGuiTable* table = g.CurrentTable;
1493:     if (table == NULL)
1494:     {
1495:         IM_ASSERT_USER_ERROR(table != NULL, "Call should only be done while in BeginTable() scope!");
1496:         return;
1497:     }
1498:     IM_ASSERT(table->IsLayoutLocked == false && "Need to call TableSetupColumn() before first row!");
1499:     IM_ASSERT(columns >= 0 && columns < IMGUI_TABLE_MAX_COLUMNS);
1500:     IM_ASSERT(rows >= 0 && rows < 128); // Arbitrary limit
1501:     table->FreezeColumnsRequest = (table->Flags & ImGuiTableFlags_ScrollX) ? (ImGuiTableColumnIdx)ImMin(columns, table->ColumnsCount) : 0;
1502:     table->FreezeColumnsCount = (table->InnerWindow->Scroll.x != 0.0f) ? table->FreezeColumnsRequest : 0;
1503:     table->FreezeRowsRequest = (table->Flags & ImGuiTableFlags_ScrollY) ? (ImGuiTableColumnIdx)rows : 0;
1504:     table->FreezeRowsCount = (table->InnerWindow->Scroll.y != 0.0f) ? table->FreezeRowsRequest : 0;
1505:     table->IsUnfrozenRows = (table->FreezeRowsCount == 0); // Make sure this is set before TableUpdateLayout() so ImGuiListClipper can benefit from it.b
1506:     // Ensure frozen columns are ordered in their section. We still allow multiple frozen columns to be reordered.
1507:     // FIXME-TABLE: This work for preserving 2143 into 21|43. How about 4321 turning into 21|43? (preserve relative order in each section)
1508:     for (int column_n = 0; column_n < table->FreezeColumnsRequest; column_n++)
1509:     {
1510:         int order_n = table->DisplayOrderToIndex[column_n];
1511:         if (order_n != column_n && order_n >= table->FreezeColumnsRequest)
1512:         {
1513:             ImSwap(table->Columns[table->DisplayOrderToIndex[order_n]].DisplayOrder, table->Columns[table->DisplayOrderToIndex[column_n]].DisplayOrder);
1514:             ImSwap(table->DisplayOrderToIndex[order_n], table->DisplayOrderToIndex[column_n]);
1515:         }
1516:     }
1517: }
