1991: // IM_MALLOC(), IM_FREE(), IM_NEW(), IM_PLACEMENT_NEW(), IM_DELETE()
1992: // We call C++ constructor on own allocated memory via the placement "new(ptr) Type()" syntax.
1993: // Defining a custom placement new() with a custom parameter allows us to bypass including <new> which on some platforms complains when user has disabled exceptions.
1994: //-----------------------------------------------------------------------------
1995: struct ImNewWrapper {};
1996: inline void* operator new(size_t, ImNewWrapper, void* ptr) { return ptr; }
1997: inline void  operator delete(void*, ImNewWrapper, void*)   {} // This is only required so we can use the symmetrical new()
1998: #define IM_ALLOC(_SIZE)                     ImGui::MemAlloc(_SIZE)
1999: #define IM_FREE(_PTR)                       ImGui::MemFree(_PTR)
2000: #define IM_PLACEMENT_NEW(_PTR)              new(ImNewWrapper(), _PTR)
2001: #define IM_NEW(_TYPE)                       new(ImNewWrapper(), ImGui::MemAlloc(sizeof(_TYPE))) _TYPE
2002: template<typename T> void IM_DELETE(T* p)   { if (p) { p->~T(); ImGui::MemFree(p); } }
2003: //-----------------------------------------------------------------------------
2004: // ImVector<>
2005: // Lightweight std::vector<>-like class to avoid dragging dependencies (also, some implementations of STL with debug enabled are absurdly slow, we bypass it so our code runs fast in debug).
2006: //-----------------------------------------------------------------------------
2007: // - You generally do NOT need to care or use this ever. But we need to make it available in imgui.h because some of our public structures are relying on it.
2008: // - We use std-like naming convention here, which is a little unusual for this codebase.
2009: // - Important: clear() frees memory, resize(0) keep the allocated buffer. We use resize(0) a lot to intentionally recycle allocated buffers across frames and amortize our costs.
2010: // - Important: our implementation does NOT call C++ constructors/destructors, we treat everything as raw data! This is intentional but be extra mindful of that,
2011: //   Do NOT use this class as a std::vector replacement in your own code! Many of the structures used by dear imgui can be safely initialized by a zero-memset.
2012: //-----------------------------------------------------------------------------
2013: IM_MSVC_RUNTIME_CHECKS_OFF
2014: template<typename T>
2015: struct ImVector
2016: {
2017:     int                 Size;
2018:     int                 Capacity;
2019:     T*                  Data;
2020:     // Provide standard typedefs but we don't use them ourselves.
2021:     typedef T                   value_type;
2022:     typedef value_type*         iterator;
2023:     typedef const value_type*   const_iterator;
2024:     // Constructors, destructor
2025:     inline ImVector()                                       { Size = Capacity = 0; Data = NULL; }
2026:     inline ImVector(const ImVector<T>& src)                 { Size = Capacity = 0; Data = NULL; operator=(src); }
2027:     inline ImVector<T>& operator=(const ImVector<T>& src)   { clear(); resize(src.Size); if (Data && src.Data) memcpy(Data, src.Data, (size_t)Size * sizeof(T)); return *this; }
2028:     inline ~ImVector()                                      { if (Data) IM_FREE(Data); } // Important: does not destruct anything
2029:     inline void         clear()                             { if (Data) { Size = Capacity = 0; IM_FREE(Data); Data = NULL; } }  // Important: does not destruct anything
2030:     inline void         clear_delete()                      { for (int n = 0; n < Size; n++) IM_DELETE(Data[n]); clear(); }     // Important: never called automatically! always explicit.
2031:     inline void         clear_destruct()                    { for (int n = 0; n < Size; n++) Data[n].~T(); clear(); }           // Important: never called automatically! always explicit.
2032:     inline bool         empty() const                       { return Size == 0; }
2033:     inline int          size() const                        { return Size; }
2034:     inline int          size_in_bytes() const               { return Size * (int)sizeof(T); }
2035:     inline int          max_size() const                    { return 0x7FFFFFFF / (int)sizeof(T); }
2036:     inline int          capacity() const                    { return Capacity; }
2037:     inline T&           operator[](int i)                   { IM_ASSERT(i >= 0 && i < Size); return Data[i]; }
2038:     inline const T&     operator[](int i) const             { IM_ASSERT(i >= 0 && i < Size); return Data[i]; }
2039:     inline T*           begin()                             { return Data; }
2040:     inline const T*     begin() const                       { return Data; }
2041:     inline T*           end()                               { return Data + Size; }
2042:     inline const T*     end() const                         { return Data + Size; }
2043:     inline T&           front()                             { IM_ASSERT(Size > 0); return Data[0]; }
2044:     inline const T&     front() const                       { IM_ASSERT(Size > 0); return Data[0]; }
2045:     inline T&           back()                              { IM_ASSERT(Size > 0); return Data[Size - 1]; }
2046:     inline const T&     back() const                        { IM_ASSERT(Size > 0); return Data[Size - 1]; }
2047:     inline void         swap(ImVector<T>& rhs)              { int rhs_size = rhs.Size; rhs.Size = Size; Size = rhs_size; int rhs_cap = rhs.Capacity; rhs.Capacity = Capacity; Capacity = rhs_cap; T* rhs_data = rhs.Data; rhs.Data = Data; Data = rhs_data; }
2048:     inline int          _grow_capacity(int sz) const        { int new_capacity = Capacity ? (Capacity + Capacity / 2) : 8; return new_capacity > sz ? new_capacity : sz; }
2049:     inline void         resize(int new_size)                { if (new_size > Capacity) reserve(_grow_capacity(new_size)); Size = new_size; }
2050:     inline void         resize(int new_size, const T& v)    { if (new_size > Capacity) reserve(_grow_capacity(new_size)); if (new_size > Size) for (int n = Size; n < new_size; n++) memcpy(&Data[n], &v, sizeof(v)); Size = new_size; }
2051:     inline void         shrink(int new_size)                { IM_ASSERT(new_size <= Size); Size = new_size; } // Resize a vector to a smaller size, guaranteed not to cause a reallocation
2052:     inline void         reserve(int new_capacity)           { if (new_capacity <= Capacity) return; T* new_data = (T*)IM_ALLOC((size_t)new_capacity * sizeof(T)); if (Data) { memcpy(new_data, Data, (size_t)Size * sizeof(T)); IM_FREE(Data); } Data = new_data; Capacity = new_capacity; }
2053:     inline void         reserve_discard(int new_capacity)   { if (new_capacity <= Capacity) return; if (Data) IM_FREE(Data); Data = (T*)IM_ALLOC((size_t)new_capacity * sizeof(T)); Capacity = new_capacity; }
2054:     // NB: It is illegal to call push_back/push_front/insert with a reference pointing inside the ImVector data itself! e.g. v.push_back(v[10]) is forbidden.
2055:     inline void         push_back(const T& v)               { if (Size == Capacity) reserve(_grow_capacity(Size + 1)); memcpy(&Data[Size], &v, sizeof(v)); Size++; }
2056:     inline void         pop_back()                          { IM_ASSERT(Size > 0); Size--; }
2057:     inline void         push_front(const T& v)              { if (Size == 0) push_back(v); else insert(Data, v); }
2058:     inline T*           erase(const T* it)                  { IM_ASSERT(it >= Data && it < Data + Size); const ptrdiff_t off = it - Data; memmove(Data + off, Data + off + 1, ((size_t)Size - (size_t)off - 1) * sizeof(T)); Size--; return Data + off; }
2059:     inline T*           erase(const T* it, const T* it_last){ IM_ASSERT(it >= Data && it < Data + Size && it_last >= it && it_last <= Data + Size); const ptrdiff_t count = it_last - it; const ptrdiff_t off = it - Data; memmove(Data + off, Data + off + count, ((size_t)Size - (size_t)off - (size_t)count) * sizeof(T)); Size -= (int)count; return Data + off; }
2060:     inline T*           erase_unsorted(const T* it)         { IM_ASSERT(it >= Data && it < Data + Size);  const ptrdiff_t off = it - Data; if (it < Data + Size - 1) memcpy(Data + off, Data + Size - 1, sizeof(T)); Size--; return Data + off; }
2061:     inline T*           insert(const T* it, const T& v)     { IM_ASSERT(it >= Data && it <= Data + Size); const ptrdiff_t off = it - Data; if (Size == Capacity) reserve(_grow_capacity(Size + 1)); if (off < (int)Size) memmove(Data + off + 1, Data + off, ((size_t)Size - (size_t)off) * sizeof(T)); memcpy(&Data[off], &v, sizeof(v)); Size++; return Data + off; }
2062:     inline bool         contains(const T& v) const          { const T* data = Data;  const T* data_end = Data + Size; while (data < data_end) if (*data++ == v) return true; return false; }
2063:     inline T*           find(const T& v)                    { T* data = Data;  const T* data_end = Data + Size; while (data < data_end) if (*data == v) break; else ++data; return data; }
2064:     inline const T*     find(const T& v) const              { const T* data = Data;  const T* data_end = Data + Size; while (data < data_end) if (*data == v) break; else ++data; return data; }
2065:     inline int          find_index(const T& v) const        { const T* data_end = Data + Size; const T* it = find(v); if (it == data_end) return -1; const ptrdiff_t off = it - Data; return (int)off; }
2066:     inline bool         find_erase(const T& v)              { const T* it = find(v); if (it < Data + Size) { erase(it); return true; } return false; }
2067:     inline bool         find_erase_unsorted(const T& v)     { const T* it = find(v); if (it < Data + Size) { erase_unsorted(it); return true; } return false; }
2068:     inline int          index_from_ptr(const T* it) const   { IM_ASSERT(it >= Data && it < Data + Size); const ptrdiff_t off = it - Data; return (int)off; }
2069: };
