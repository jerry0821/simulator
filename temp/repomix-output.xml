2709: ImFont* ImFontAtlas::AddFont(const ImFontConfig* font_cfg_in)
2710: {
2711:     // Sanity Checks
2712:     IM_ASSERT(!Locked && "Cannot modify a locked ImFontAtlas!");
2713:     IM_ASSERT((font_cfg_in->FontData != NULL && font_cfg_in->FontDataSize > 0) || (font_cfg_in->FontLoader != NULL));
2714:     //IM_ASSERT(font_cfg_in->SizePixels > 0.0f && "Is ImFontConfig struct correctly initialized?");
2715:     IM_ASSERT(font_cfg_in->RasterizerDensity > 0.0f && "Is ImFontConfig struct correctly initialized?");
2716:     if (font_cfg_in->GlyphOffset.x != 0.0f || font_cfg_in->GlyphOffset.y != 0.0f || font_cfg_in->GlyphMinAdvanceX != 0.0f || font_cfg_in->GlyphMaxAdvanceX != FLT_MAX)
2717:         IM_ASSERT(font_cfg_in->SizePixels != 0.0f && "Specifying glyph offset/advances requires a reference size to base it on.");
2718:     // Lazily create builder on the first call to AddFont
2719:     if (Builder == NULL)
2720:         ImFontAtlasBuildInit(this);
2721:     // Create new font
2722:     ImFont* font;
2723:     if (!font_cfg_in->MergeMode)
2724:     {
2725:         font = IM_NEW(ImFont)();
2726:         font->FontId = FontNextUniqueID++;
2727:         font->Flags = font_cfg_in->Flags;
2728:         font->LegacySize = font_cfg_in->SizePixels;
2729:         font->CurrentRasterizerDensity = font_cfg_in->RasterizerDensity;
2730:         Fonts.push_back(font);
2731:     }
2732:     else
2733:     {
2734:         IM_ASSERT(Fonts.Size > 0 && "Cannot use MergeMode for the first font"); // When using MergeMode make sure that a font has already been added before. You can use ImGui::GetIO().Fonts->AddFontDefault() to add the default imgui font.
2735:         font = font_cfg_in->DstFont ? font_cfg_in->DstFont : Fonts.back();
2736:     }
2737:     // Add to list
2738:     Sources.push_back(*font_cfg_in);
2739:     ImFontConfig* font_cfg = &Sources.back();
2740:     if (font_cfg->DstFont == NULL)
2741:         font_cfg->DstFont = font;
2742:     font->Sources.push_back(font_cfg);
2743:     ImFontAtlasBuildUpdatePointers(this); // Pointers to Sources are otherwise dangling after we called Sources.push_back().
2744:     // Sanity check
2745:     // We don't round cfg.SizePixels yet as relative size of merged fonts are used afterwards.
2746:     if (font_cfg->GlyphExcludeRanges != NULL)
2747:     {
2748:         int size = 0;
2749:         for (const ImWchar* p = font_cfg->GlyphExcludeRanges; p[0] != 0; p++, size++) {}
2750:         IM_ASSERT((size & 1) == 0 && "GlyphExcludeRanges[] size must be multiple of two!");
2751:         IM_ASSERT((size <= 64) && "GlyphExcludeRanges[] size must be small!");
2752:         font_cfg->GlyphExcludeRanges = (ImWchar*)ImMemdup(font_cfg->GlyphExcludeRanges, sizeof(font_cfg->GlyphExcludeRanges[0]) * (size + 1));
2753:     }
2754:     if (font_cfg->FontLoader != NULL)
2755:     {
2756:         IM_ASSERT(font_cfg->FontLoader->FontBakedLoadGlyph != NULL);
2757:         IM_ASSERT(font_cfg->FontLoader->LoaderInit == NULL && font_cfg->FontLoader->LoaderShutdown == NULL); // FIXME-NEWATLAS: Unsupported yet.
2758:     }
2759:     IM_ASSERT(font_cfg->FontLoaderData == NULL);
2760:     if (!ImFontAtlasFontSourceInit(this, font_cfg))
2761:     {
2762:         // Rollback (this is a fragile/rarely exercised code-path. TestSuite's "misc_atlas_add_invalid_font" aim to test this)
2763:         ImFontAtlasFontDestroySourceData(this, font_cfg);
2764:         Sources.pop_back();
2765:         font->Sources.pop_back();
2766:         if (!font_cfg->MergeMode)
2767:         {
2768:             IM_DELETE(font);
2769:             Fonts.pop_back();
2770:         }
2771:         return NULL;
2772:     }
2773:     ImFontAtlasFontSourceAddToFont(this, font, font_cfg);
2774:     return font;
2775: }
2776: // Default font TTF is compressed with stb_compress then base85 encoded (see misc/fonts/binary_to_compressed_c.cpp for encoder)
2777: static unsigned int stb_decompress_length(const unsigned char* input);
2778: static unsigned int stb_decompress(unsigned char* output, const unsigned char* input, unsigned int length);
2779: static unsigned int Decode85Byte(char c)                                    { return c >= '\\' ? c-36 : c-35; }
2780: static void         Decode85(const unsigned char* src, unsigned char* dst)
2781: {
2782:     while (*src)
2783:     {
2784:         unsigned int tmp = Decode85Byte(src[0]) + 85 * (Decode85Byte(src[1]) + 85 * (Decode85Byte(src[2]) + 85 * (Decode85Byte(src[3]) + 85 * Decode85Byte(src[4]))));
2785:         dst[0] = ((tmp >> 0) & 0xFF); dst[1] = ((tmp >> 8) & 0xFF); dst[2] = ((tmp >> 16) & 0xFF); dst[3] = ((tmp >> 24) & 0xFF);   // We can't assume little-endianness.
2786:         src += 5;
2787:         dst += 4;
2788:     }
2789: }
