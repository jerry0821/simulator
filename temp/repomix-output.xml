1603: // - AddConcavePolyFilled()
1604: //-----------------------------------------------------------------------------
1605: enum ImTriangulatorNodeType
1606: {
1607:     ImTriangulatorNodeType_Convex,
1608:     ImTriangulatorNodeType_Ear,
1609:     ImTriangulatorNodeType_Reflex
1610: };
1611: struct ImTriangulatorNode
1612: {
1613:     ImTriangulatorNodeType  Type;
1614:     int                     Index;
1615:     ImVec2                  Pos;
1616:     ImTriangulatorNode*     Next;
1617:     ImTriangulatorNode*     Prev;
1618:     void    Unlink()        { Next->Prev = Prev; Prev->Next = Next; }
1619: };
1620: struct ImTriangulatorNodeSpan
1621: {
1622:     ImTriangulatorNode**    Data = NULL;
