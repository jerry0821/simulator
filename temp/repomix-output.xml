  1: #include "particle.h"
  2: #include "texture.h"
  3: #include "debug_ostream.h"
  4: #include <vector>
  5: #include "direct3d.h"
  6: #include "billboard.h"
  7: #include "shader_particle.h"	
  8: using namespace DirectX;
  9: const int MAX_PARTICLES = 4000; // 最大粒子數
 10: struct Particle {
 11: 	bool Active;            
 12: 	XMFLOAT3 Position;      // 位置
 13: 	XMFLOAT3 Velocity;      // 速度
 14: 	XMFLOAT4 Color;         // 色
 15: 	float Size;             // 大きさ
 16: 	float Age;              
 17: 	float LifeTime;         
 18: 	float Gravity;          // 重力
 19: 	float Friction;         // 阻力
 20: 	int TextureType;        
 21: };
 22: static std::vector<Particle> g_Particles; // 粒子池
 23: static std::vector<int> g_TextureIDs;
 24: void Particle_Initialize()
 25: {
 26: 	g_Particles.resize(MAX_PARTICLES);
 27: 	for (auto& p : g_Particles) p.Active = false;
 28: 	//g_TexCirlce = Texture_Load(L"resource/texture/particle_circle.png");
 29: 	//g_TexSquare = Texture_Load(L"resource/texture/particle_square.png");
 30:     g_TextureIDs.resize(PT_MAX);
 31:     g_TextureIDs[PT_FIRE] = Texture_Load(L"resource/texture/fire.png");
 32:     //g_TextureIDs[PT_SMOKE] = Texture_Load(L"resource/texture/smoke.png");
 33:     g_TextureIDs[PT_SPARK] = Texture_Load(L"resource/texture/spark.png");
 34: 	g_TextureIDs[PT_RAIN] = Texture_Load(L"resource/texture/fire.png");
 35: 	g_TextureIDs[PT_SPLASH] = Texture_Load(L"resource/texture/fire.png");
 36: }
 37: void Particle_Finalize()
 38: {
 39:     g_Particles.clear();
 40:     g_TextureIDs.clear();
 41: }
 42: void Particle_Update(double elapsed_time)
 43: {
 44: 	for(auto& p : g_Particles)
 45:     {
 46:         if (!p.Active) continue;
 47:         // --- 1. 物理運算 ---
 48:         // 施加重力 (y軸)
 49:         p.Velocity.y -= p.Gravity * elapsed_time;
 50:         // 施加摩擦力/空氣阻力 (讓速度慢慢歸零)
 51:         // Friction = 1.0 代表 1秒後速度歸零
 52:         float frictionFactor = 1.0f - (p.Friction * elapsed_time);
 53:         if (frictionFactor < 0.0f) frictionFactor = 0.0f; // 避免變成負數
 54:         p.Velocity.x *= frictionFactor;
 55:         p.Velocity.y *= frictionFactor;
 56:         p.Velocity.z *= frictionFactor;
 57:         // 更新位置 (p = p + v * t)
 58:         XMVECTOR pos = XMLoadFloat3(&p.Position);
 59:         XMVECTOR vel = XMLoadFloat3(&p.Velocity);
 60:         pos += vel * elapsed_time;
 61:         XMStoreFloat3(&p.Position, pos);
 62:         // --- 2. 生命週期 ---
 63:         p.Age += elapsed_time;
 64:         // 淡出效果 (Alpha 隨著壽命歸零)
 65:         // 0.0(剛出生) -> Alpha = 1.0
 66:         // LifeTime(死前) -> Alpha = 0.0
 67:         float lifeRatio = 1.0f - (p.Age / p.LifeTime);
 68:         if (lifeRatio < 0.0f) lifeRatio = 0.0f;
 69:         p.Color.w = lifeRatio;
 70:         // 死亡判定
 71:         if (p.Age >= p.LifeTime)
 72:         {
 73:             p.Active = false;
 74:         }
 75: 		// --- 3. 特殊效果判定 ---
 76:         if (p.TextureType == PT_RAIN)
 77:         {
 78:             // もし地面より下に行ったら
 79:             if (p.Position.y <= 0.0f)
 80:             {
 81:                 // 1. 雨粒は死ぬ
 82:                 p.Active = false;
 83:                 // 2. その場所に「水しぶき」を生成！
 84:                 // (地面スレスレに配置)
 85:                 XMFLOAT3 splashPos = { p.Position.x, 0.05f, p.Position.z };
 86:                 // 水しぶきは動かなくていいので速度0、寿命は一瞬
 87:                 Particle_Spawn(
 88:                     splashPos,
 89:                     { 0,0,0 },             // 速度なし
 90:                     { 0.8f, 0.8f, 1.0f, 0.8f }, // 少し青っぽい白
 91:                     0.1f,                // サイズ
 92:                     0.2f,                // 寿命 (0.2秒で消える)
 93:                     PT_SPLASH,           // 水しぶき画像
 94:                     0.0f, 0.0f
 95:                 );
 96:             }
 97:         }
 98:     }
 99: }
100: void Particle_Draw(const DirectX::XMMATRIX& view, const DirectX::XMMATRIX& projection)
101: {
102:     ShaderParticle_Begin();
103:     ShaderParticle_SetWorldMatrix(XMMatrixIdentity());
104:     ShaderParticle_SetViewMatrix(view);
105:     ShaderParticle_SetProjectionMatrix(projection);
106:     Direct3D_SetAlphaBlendAdd();
107:     Direct3D_SetDepthEnable(true);
108:     Direct3D_SetDepthWrite(false);
109:     //Direct3D_SetDepthEnable(false);
110:     XMMATRIX invView = XMMatrixInverse(nullptr, view);
111:     XMFLOAT3 camRight = { XMVectorGetX(invView.r[0]), XMVectorGetY(invView.r[0]), XMVectorGetZ(invView.r[0]) };
112:     XMFLOAT3 camUp = { XMVectorGetX(invView.r[1]), XMVectorGetY(invView.r[1]), XMVectorGetZ(invView.r[1]) };
113: 	static std::vector<VertexParticle> batchVertices; // バッチ用頂点配列
114: 	batchVertices.reserve(MAX_PARTICLES * 6); // 1粒子あたり6頂点分確保
115:     for (int type = 0; type < PT_MAX; type++)
116:     {
117:         batchVertices.clear();
118:         int texID = g_TextureIDs[type];
119:         if (texID == -1) continue;
120:         for (const auto& p : g_Particles)
121:         {
122:             if (!p.Active || p.TextureType != type) continue;
123:             float halfSize = p.Size * 0.5f;
124:             float widthScale = 1.0f;
125:             float heightScale = 1.0f;
126: 			if (type == PT_FIRE) // fire particles
127:             {
128:                 float ratio = p.Age / p.LifeTime;
129:                 float taperFactor = 1.0f - ratio;
130:                 widthScale = 0.5f * taperFactor;
131:                 heightScale = 4.0f;
132:             }
133:             else if (type == PT_SPARK)
134:             {
135:                 widthScale = 0.8f;
136:                 heightScale = 1.5f;
137:             }
138:             XMVECTOR P = XMLoadFloat3(&p.Position);
139:             XMVECTOR R = XMLoadFloat3(&camRight) * halfSize * widthScale;
140:             XMVECTOR U = XMLoadFloat3(&camUp) * halfSize * heightScale;
141:             XMFLOAT3 p1, p2, p3, p4;
142:             XMStoreFloat3(&p1, P - R + U);
143:             XMStoreFloat3(&p2, P + R + U);
144:             XMStoreFloat3(&p3, P - R - U);
145:             XMStoreFloat3(&p4, P + R - U);
146:             batchVertices.push_back({ p1, p.Color, {0.0f, 0.0f} });
147:             batchVertices.push_back({ p2, p.Color, {1.0f, 0.0f} });
148:             batchVertices.push_back({ p3, p.Color, {0.0f, 1.0f} });
149:             batchVertices.push_back({ p3, p.Color, {0.0f, 1.0f} });
150:             batchVertices.push_back({ p2, p.Color, {1.0f, 0.0f} });
151:             batchVertices.push_back({ p4, p.Color, {1.0f, 1.0f} });
152:         }
153:         if (!batchVertices.empty())
154:         {
155:             ShaderParticle_DrawBatch(batchVertices, texID);
156:         }
157:     }
158:     Direct3D_SetAlphaBlendTransparent();
159:     //Direct3D_SetDepthEnable(true);
160: }
161: void Particle_Spawn(DirectX::XMFLOAT3 pos, DirectX::XMFLOAT3 vel, DirectX::XMFLOAT4 color, float size, float lifeTime, int type, float gravity, float friction)
162: {
163: 	for (auto& p : g_Particles)
164: 	{
165: 		if (!p.Active)
166: 		{
167: 			p.Active = true;
168: 			p.Position = pos;
169: 			p.Velocity = vel;
170: 			p.Color = color;
171: 			p.Size = size;
172: 			p.LifeTime = lifeTime;
173: 			p.Age = 0.0f;
174: 			p.TextureType = type;
175: 			p.Gravity = gravity;
176: 			p.Friction = friction;
177: 			return;
178: 		}
179: 	}
180: }
