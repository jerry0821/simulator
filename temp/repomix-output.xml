8377: void ImGui::EndMenu()
8378: {
8379:     // Nav: When a left move request our menu failed, close ourselves.
8380:     ImGuiContext& g = *GImGui;
8381:     ImGuiWindow* window = g.CurrentWindow;
8382:     IM_ASSERT(window->Flags & ImGuiWindowFlags_Popup);  // Mismatched BeginMenu()/EndMenu() calls
8383:     ImGuiWindow* parent_window = window->ParentWindow;  // Should always be != NULL is we passed assert.
8384:     if (window->BeginCount == window->BeginCountPreviousFrame)
8385:         if (g.NavMoveDir == ImGuiDir_Left && NavMoveRequestButNoResultYet())
8386:             if (g.NavWindow && (g.NavWindow->RootWindowForNav == window) && parent_window->DC.LayoutType == ImGuiLayoutType_Vertical)
8387:             {
8388:                 ClosePopupToLevel(g.BeginPopupStack.Size - 1, true);
8389:                 NavMoveRequestCancel();
8390:             }
8391:     EndPopup();
8392: }
8393: bool ImGui::MenuItemEx(const char* label, const char* icon, const char* shortcut, bool selected, bool enabled)
8394: {
8395:     ImGuiWindow* window = GetCurrentWindow();
8396:     if (window->SkipItems)
8397:         return false;
8398:     ImGuiContext& g = *GImGui;
8399:     ImGuiStyle& style = g.Style;
8400:     ImVec2 pos = window->DC.CursorPos;
8401:     ImVec2 label_size = CalcTextSize(label, NULL, true);
8402:     // See BeginMenuEx() for comments about this.
8403:     const bool menuset_is_open = IsRootOfOpenMenuSet();
8404:     if (menuset_is_open)
8405:         PushItemFlag(ImGuiItemFlags_NoWindowHoverableCheck, true);
8406:     // We've been using the equivalent of ImGuiSelectableFlags_SetNavIdOnHover on all Selectable() since early Nav system days (commit 43ee5d73),
8407:     // but I am unsure whether this should be kept at all. For now moved it to be an opt-in feature used by menus only.
8408:     bool pressed;
8409:     PushID(label);
8410:     if (!enabled)
8411:         BeginDisabled();
8412:     // We use ImGuiSelectableFlags_NoSetKeyOwner to allow down on one menu item, move, up on another.
8413:     const ImGuiSelectableFlags selectable_flags = ImGuiSelectableFlags_SelectOnRelease | ImGuiSelectableFlags_NoSetKeyOwner | ImGuiSelectableFlags_SetNavIdOnHover;
8414:     const ImGuiMenuColumns* offsets = &window->DC.MenuColumns;
8415:     if (window->DC.LayoutType == ImGuiLayoutType_Horizontal)
8416:     {
8417:         // Mimic the exact layout spacing of BeginMenu() to allow MenuItem() inside a menu bar, which is a little misleading but may be useful
8418:         // Note that in this situation: we don't render the shortcut, we render a highlight instead of the selected tick mark.
8419:         float w = label_size.x;
8420:         window->DC.CursorPos.x += IM_TRUNC(style.ItemSpacing.x * 0.5f);
8421:         ImVec2 text_pos(window->DC.CursorPos.x + offsets->OffsetLabel, window->DC.CursorPos.y + window->DC.CurrLineTextBaseOffset);
8422:         PushStyleVarX(ImGuiStyleVar_ItemSpacing, style.ItemSpacing.x * 2.0f);
8423:         pressed = Selectable("", selected, selectable_flags, ImVec2(w, 0.0f));
8424:         PopStyleVar();
8425:         if (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_Visible)
8426:             RenderText(text_pos, label);
8427:         window->DC.CursorPos.x += IM_TRUNC(style.ItemSpacing.x * (-1.0f + 0.5f)); // -1 spacing to compensate the spacing added when Selectable() did a SameLine(). It would also work to call SameLine() ourselves after the PopStyleVar().
8428:     }
8429:     else
8430:     {
8431:         // Menu item inside a vertical menu
8432:         // (In a typical menu window where all items are BeginMenu() or MenuItem() calls, extra_w will always be 0.0f.
8433:         //  Only when they are other items sticking out we're going to add spacing, yet only register minimum width into the layout system.)
8434:         float icon_w = (icon && icon[0]) ? CalcTextSize(icon, NULL).x : 0.0f;
8435:         float shortcut_w = (shortcut && shortcut[0]) ? CalcTextSize(shortcut, NULL).x : 0.0f;
8436:         float checkmark_w = IM_TRUNC(g.FontSize * 1.20f);
8437:         float min_w = window->DC.MenuColumns.DeclColumns(icon_w, label_size.x, shortcut_w, checkmark_w); // Feedback for next frame
8438:         float stretch_w = ImMax(0.0f, GetContentRegionAvail().x - min_w);
8439:         ImVec2 text_pos(pos.x, pos.y + window->DC.CurrLineTextBaseOffset);
8440:         pressed = Selectable("", false, selectable_flags | ImGuiSelectableFlags_SpanAvailWidth, ImVec2(min_w, label_size.y));
8441:         if (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_Visible)
8442:         {
8443:             RenderText(text_pos + ImVec2(offsets->OffsetLabel, 0.0f), label);
8444:             if (icon_w > 0.0f)
8445:                 RenderText(text_pos + ImVec2(offsets->OffsetIcon, 0.0f), icon);
8446:             if (shortcut_w > 0.0f)
8447:             {
8448:                 PushStyleColor(ImGuiCol_Text, style.Colors[ImGuiCol_TextDisabled]);
8449:                 LogSetNextTextDecoration("(", ")");
8450:                 RenderText(text_pos + ImVec2(offsets->OffsetShortcut + stretch_w, 0.0f), shortcut, NULL, false);
8451:                 PopStyleColor();
8452:             }
8453:             if (selected)
8454:                 RenderCheckMark(window->DrawList, text_pos + ImVec2(offsets->OffsetMark + stretch_w + g.FontSize * 0.40f, g.FontSize * 0.134f * 0.5f), GetColorU32(ImGuiCol_Text), g.FontSize * 0.866f);
8455:         }
8456:     }
8457:     IMGUI_TEST_ENGINE_ITEM_INFO(g.LastItemData.ID, label, g.LastItemData.StatusFlags | ImGuiItemStatusFlags_Checkable | (selected ? ImGuiItemStatusFlags_Checked : 0));
8458:     if (!enabled)
8459:         EndDisabled();
8460:     PopID();
8461:     if (menuset_is_open)
8462:         PopItemFlag();
8463:     return pressed;
8464: }
