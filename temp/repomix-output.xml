 13: namespace Collision {
 14: struct Sphere {
 15:   DirectX::XMFLOAT3 center; // 中心位置
 16:   float radius;             // 半径
 17:   bool Intersects(const Sphere &other) const;
 18:   bool Intersects(const DirectX::XMFLOAT3 &point) const;
 19: };
 20: struct Circle {
 21:   DirectX::XMFLOAT2 center; // 中心位置
 22:   float radius;             // 半径
 23:   bool Intersects(const Circle &other) const;
 24: };
 25: struct Box {
 26:   DirectX::XMFLOAT2 center;
 27:   float half_width;  // 幅
 28:   float half_height; // 高さ
 29:   bool Intersects(const Box &other) const;
 30: };
 31: struct Hit {
 32:   bool isHit;               // 当たったかどうか
 33:   DirectX::XMFLOAT3 normal; // 法線ベクトル
 34: };
 35: struct RayHit {
 36:   bool isHit;
 37:   float distance;
 38:   DirectX::XMFLOAT3 normal;
 39: };
 40: struct AABB {
 41:   DirectX::XMFLOAT3 min; // 最小座標 (左前下)
 42:   DirectX::XMFLOAT3 max; // 最大座標 (右後上)
 43:   DirectX::XMFLOAT3 GetCenter() const {
 44:     return DirectX::XMFLOAT3{(min.x + max.x) * 0.5f, (min.y + max.y) * 0.5f,
 45:                              (min.z + max.z) * 0.5f};
 46:   }
 47:   // インライン関数で半分の大きさを取得
 48:   DirectX::XMFLOAT3 GetHalfSize() const {
 49:     DirectX::XMFLOAT3 half_size;
 50:     half_size.x = (max.x - min.x) * 0.5f;
