<file path="shader3d_unlit.cpp">
  1: // ----------------------------------------------------
  2: // シェーダー3D(ライトなし)  [shader3d_unlit.cpp]
  3: // ====================================================
  4: // Created by: Jerry
  5: // Date: 2025-11-21
  6: // ----------------------------------------------------
  7: #include "shader3d_unlit.h"
  8: #include <d3d11.h>
  9: #include "debug_ostream.h"
 10: #include <DirectXMath.h>
 11: using namespace DirectX;
 12: #include "direct3d.h"
 13: #include <fstream>
 14: #include "sampler.h"
 15: static ID3D11VertexShader* g_pVertexShader = nullptr;
 16: static ID3D11InputLayout* g_pInputLayout = nullptr;
 17: static ID3D11Buffer* g_pVSConstantBuffer0 = nullptr; // 定数バッファb0
 18: static ID3D11Buffer* g_pPSConstantBuffer0 = nullptr; // Material
 19: static ID3D11PixelShader* g_pPixelShader = nullptr;
 20: bool Shader3D_Unlit_Initialize()
 21: {
 22: 	HRESULT hr; // 戻り値格納用
 23: 	// 事前コンパイル済み頂点シェーダーの読み込み
 24: 	std::ifstream ifs_vs("resource/shader/shader_vertex_3d_unlit.cso", std::ios::binary);
 25: 	if (!ifs_vs) {
 26: 		MessageBox(nullptr, "頂点シェーダーの読み込みに失敗しました\n\nshader_vertex_3d_unlit.cso", "エラー", MB_OK);
 27: 		return false;
 28: 	}
 29: 	// ファイルサイズを取得
 30: 	ifs_vs.seekg(0, std::ios::end); // ファイルポインタを末尾に移動
 31: 	std::streamsize filesize = ifs_vs.tellg(); // ファイルポインタの位置を取得（つまりファイルサイズ）
 32: 	ifs_vs.seekg(0, std::ios::beg); // ファイルポインタを先頭に戻す
 33: 	// バイナリデータを格納するためのバッファを確保
 34: 	unsigned char* vsbinary_pointer = new unsigned char[filesize];
 35: 	ifs_vs.read((char*)vsbinary_pointer, filesize); // バイナリデータを読み込む
 36: 	ifs_vs.close(); // ファイルを閉じる
 37: 	// 頂点シェーダーの作成
 38: 	hr = Direct3D_GetDevice()->CreateVertexShader(vsbinary_pointer, filesize, nullptr, &g_pVertexShader);
 39: 	if (FAILED(hr)) {
 40: 		hal::dout << "Shader3D_Unlit_Initialize() : 頂点シェーダーの作成に失敗しました" << std::endl;
 41: 		delete[] vsbinary_pointer; // メモリリークしないようにバイナリデータのバッファを解放
 42: 		return false;
 43: 	}
 44: 	// 頂点レイアウトの定義
 45: 	D3D11_INPUT_ELEMENT_DESC layout[] = {
 46: 		{ "POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT,		0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 },
 47: 		{ "NORMAL",	  0, DXGI_FORMAT_R32G32B32_FLOAT,		0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 },
 48: 		{ "COLOR",	  0, DXGI_FORMAT_R32G32B32A32_FLOAT,    0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 },
 49: 		{ "TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT,			0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 }
 50: 	};
 51: 	UINT num_elements = ARRAYSIZE(layout); // 配列の要素数を取得
 52: 	// 頂点レイアウトの作成
 53: 	hr = Direct3D_GetDevice()->CreateInputLayout(layout, num_elements, vsbinary_pointer, filesize, &g_pInputLayout);
 54: 	delete[] vsbinary_pointer; // バイナリデータのバッファを解放
 55: 	if (FAILED(hr)) {
 56: 		hal::dout << "Shader3D_Unlit_Initialize() : 頂点レイアウトの作成に失敗しました" << std::endl;
 57: 		return false;
 58: 	}
 59: 	// 頂点シェーダー用定数バッファの作成
 60: 	D3D11_BUFFER_DESC buffer_desc{};
 61: 	buffer_desc.ByteWidth = sizeof(XMFLOAT4X4); // バッファのサイズ
 62: 	buffer_desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER; // バインドフラグ
 63: 	Direct3D_GetDevice()->CreateBuffer(&buffer_desc, nullptr, &g_pVSConstantBuffer0);
 64: 	// 事前コンパイル済みピクセルシェーダーの読み込み
 65: 	std::ifstream ifs_ps("resource/shader/shader_pixel_3d_unlit.cso", std::ios::binary);
 66: 	if (!ifs_ps) {
 67: 		MessageBox(nullptr, "ピクセルシェーダーの読み込みに失敗しました\n\nshader_pixel_3d.cso", "エラー", MB_OK);
 68: 		return false;
 69: 	}
 70: 	ifs_ps.seekg(0, std::ios::end);
 71: 	filesize = ifs_ps.tellg();
 72: 	ifs_ps.seekg(0, std::ios::beg);
 73: 	unsigned char* psbinary_pointer = new unsigned char[filesize];
 74: 	ifs_ps.read((char*)psbinary_pointer, filesize);
 75: 	ifs_ps.close();
 76: 	// ピクセルシェーダーの作成
 77: 	hr = Direct3D_GetDevice()->CreatePixelShader(psbinary_pointer, filesize, nullptr, &g_pPixelShader);
 78: 	delete[] psbinary_pointer; // バイナリデータのバッファを解放
 79: 	if (FAILED(hr)) {
 80: 		hal::dout << "Shader3D_Unlit_Initialize() : ピクセルシェーダーの作成に失敗しました" << std::endl;
 81: 		return false;
 82: 	}
 83: 	// ピクセルシェーダー用定数バッファの作成
 84: 	buffer_desc.ByteWidth = sizeof(XMFLOAT4); // バッファのサイズ
 85: 	Direct3D_GetDevice()->CreateBuffer(&buffer_desc, nullptr, &g_pPSConstantBuffer0);
 86: 	return true;
 87: }
 88: void Shader3D_Unlit_Finalize()
 89: {
 90: 	SAFE_RELEASE(g_pPixelShader);
 91: 	SAFE_RELEASE(g_pPSConstantBuffer0);
 92: 	SAFE_RELEASE(g_pVSConstantBuffer0);
 93: 	SAFE_RELEASE(g_pInputLayout);
 94: 	SAFE_RELEASE(g_pVertexShader);
 95: }
 96: void Shader3D_Unlit_SetWorldMatrix(const DirectX::XMMATRIX& matrix)
 97: {
 98: 	// 定数バッファ格納用行列の構造体を定義
 99: 	XMFLOAT4X4 transpose;
100: 	// 行列を転置して定数バッファ格納用行列に変換
101: 	XMStoreFloat4x4(&transpose, XMMatrixTranspose(matrix));
102: 	// 定数バッファに行列をセット
103: 	Direct3D_GetContext()->UpdateSubresource(g_pVSConstantBuffer0, 0, nullptr, &transpose, 0, 0);
104: }
105: void Shader3D_Unlit_SetMaterialColor(const DirectX::XMFLOAT4& material_color)
106: {
107: 	//定数バッファに行列をセット
108: 	Direct3D_GetContext()->UpdateSubresource(g_pPSConstantBuffer0, 0, nullptr, &material_color, 0, 0);
109: }
110: void Shader3D_Unlit_Begin()
111: {	
112: 	// 頂点シェーダーとピクセルシェーダーを描画パイプラインに設定
113: 	Direct3D_GetContext()->VSSetShader(g_pVertexShader, nullptr, 0);
114: 	Direct3D_GetContext()->PSSetShader(g_pPixelShader, nullptr, 0);
115: 	// 頂点レイアウトを描画パイプラインに設定
116: 	Direct3D_GetContext()->IASetInputLayout(g_pInputLayout);
117: 	// 定数バッファを描画パイプラインに設定
118: 	Direct3D_GetContext()->VSSetConstantBuffers(0, 1, &g_pVSConstantBuffer0);
119: 	Direct3D_GetContext()->PSSetConstantBuffers(0, 1, &g_pPSConstantBuffer0);
120: }
</file>

