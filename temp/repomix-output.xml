 72: static bool MakeRenderTarget(int w, int h,
 73: 	ID3D11Texture2D** ppTex,
 74: 	ID3D11RenderTargetView** ppRTV,
 75: 	ID3D11ShaderResourceView** ppSRV,
 76: 	ID3D11Texture2D** ppDepthTex,
 77: 	ID3D11DepthStencilView** ppDSV,
 78: 	D3D11_VIEWPORT* pViewport);
 79: static bool MakeRenderTarget(int w, int h,
 80: 	ID3D11Texture2D** ppTex,
 81: 	ID3D11RenderTargetView** ppRTV,
 82: 	ID3D11ShaderResourceView** ppSRV,
 83: 	ID3D11Texture2D** ppDepthTex,
 84: 	ID3D11DepthStencilView** ppDSV,
 85: 	D3D11_VIEWPORT* pViewport)
 86: {
 87: 	HRESULT hr;
 88: 	D3D11_TEXTURE2D_DESC texDesc = {};
 89: 	texDesc.Width = w;
 90: 	texDesc.Height = h;
 91: 	texDesc.MipLevels = 1;
 92: 	texDesc.ArraySize = 1;
 93: 	texDesc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
 94: 	texDesc.SampleDesc.Count = 1;
 95: 	texDesc.SampleDesc.Quality = 0;
 96: 	texDesc.Usage = D3D11_USAGE_DEFAULT;
 97: 	texDesc.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
 98: 	texDesc.CPUAccessFlags = 0;
 99: 	texDesc.MiscFlags = 0;
100: 	hr = g_pDevice->CreateTexture2D(&texDesc, nullptr, ppTex);
101: 	if (FAILED(hr)) return false;
102: 	hr = g_pDevice->CreateRenderTargetView(*ppTex, nullptr, ppRTV);
103: 	if (FAILED(hr)) return false;
104: 	hr = g_pDevice->CreateShaderResourceView(*ppTex, nullptr, ppSRV);
105: 	if (FAILED(hr)) return false;
106: 	// デプスステンシルバッファの生成
107: 	D3D11_TEXTURE2D_DESC depthDesc = texDesc;
108: 	depthDesc.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
109: 	depthDesc.BindFlags = D3D11_BIND_DEPTH_STENCIL;
110: 	hr = g_pDevice->CreateTexture2D(&depthDesc, nullptr, ppDepthTex);
111: 	if (FAILED(hr)) return false;
112: 	hr = g_pDevice->CreateDepthStencilView(*ppDepthTex, nullptr, ppDSV);
113: 	if (FAILED(hr)) return false;
114: 	// ビューポートの設定
115: 	pViewport->TopLeftX = 0.0f;
116: 	pViewport->TopLeftY = 0.0f;
117: 	pViewport->Width = static_cast<FLOAT>(w);
118: 	pViewport->Height = static_cast<FLOAT>(h);
119: 	pViewport->MinDepth = 0.0f;
120: 	pViewport->MaxDepth = 1.0f;
121: 	return true;
122: }
