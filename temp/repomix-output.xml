875: // Transparency related helpers (optional)
876: //--------------------------------------------------------------------------------------------------------
877: #if defined(_MSC_VER)
878: #pragma comment(lib, "dwmapi")  // Link with dwmapi.lib. MinGW will require linking with '-ldwmapi'
879: #endif
880: // [experimental]
881: // Borrowed from GLFW's function updateFramebufferTransparency() in src/win32_window.c
882: // (the Dwm* functions are Vista era functions but we are borrowing logic from GLFW)
883: void ImGui_ImplWin32_EnableAlphaCompositing(void* hwnd)
884: {
885:     if (!_IsWindowsVistaOrGreater())
886:         return;
887:     BOOL composition;
888:     if (FAILED(::DwmIsCompositionEnabled(&composition)) || !composition)
889:         return;
890:     BOOL opaque;
891:     DWORD color;
892:     if (_IsWindows8OrGreater() || (SUCCEEDED(::DwmGetColorizationColor(&color, &opaque)) && !opaque))
893:     {
894:         HRGN region = ::CreateRectRgn(0, 0, -1, -1);
895:         DWM_BLURBEHIND bb = {};
896:         bb.dwFlags = DWM_BB_ENABLE | DWM_BB_BLURREGION;
897:         bb.hRgnBlur = region;
898:         bb.fEnable = TRUE;
899:         ::DwmEnableBlurBehindWindow((HWND)hwnd, &bb);
900:         ::DeleteObject(region);
901:     }
902:     else
903:     {
904:         DWM_BLURBEHIND bb = {};
905:         bb.dwFlags = DWM_BB_ENABLE;
906:         ::DwmEnableBlurBehindWindow((HWND)hwnd, &bb);
907:     }
908: }
