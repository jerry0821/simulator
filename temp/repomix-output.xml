9266: bool    ImGui::TabItemEx(ImGuiTabBar* tab_bar, const char* label, bool* p_open, ImGuiTabItemFlags flags, ImGuiWindow* docked_window)
9267: {
9268:     // Layout whole tab bar if not already done
9269:     ImGuiContext& g = *GImGui;
9270:     if (tab_bar->WantLayout)
9271:     {
9272:         ImGuiNextItemData backup_next_item_data = g.NextItemData;
9273:         TabBarLayout(tab_bar);
9274:         g.NextItemData = backup_next_item_data;
9275:     }
9276:     ImGuiWindow* window = g.CurrentWindow;
9277:     if (window->SkipItems)
9278:         return false;
9279:     const ImGuiStyle& style = g.Style;
9280:     const ImGuiID id = TabBarCalcTabID(tab_bar, label, docked_window);
9281:     // If the user called us with *p_open == false, we early out and don't render.
9282:     // We make a call to ItemAdd() so that attempts to use a contextual popup menu with an implicit ID won't use an older ID.
9283:     IMGUI_TEST_ENGINE_ITEM_INFO(id, label, g.LastItemData.StatusFlags);
9284:     if (p_open && !*p_open)
9285:     {
9286:         ItemAdd(ImRect(), id, NULL, ImGuiItemFlags_NoNav);
9287:         return false;
9288:     }
9289:     IM_ASSERT(!p_open || !(flags & ImGuiTabItemFlags_Button));
9290:     IM_ASSERT((flags & (ImGuiTabItemFlags_Leading | ImGuiTabItemFlags_Trailing)) != (ImGuiTabItemFlags_Leading | ImGuiTabItemFlags_Trailing)); // Can't use both Leading and Trailing
9291:     // Store into ImGuiTabItemFlags_NoCloseButton, also honor ImGuiTabItemFlags_NoCloseButton passed by user (although not documented)
9292:     if (flags & ImGuiTabItemFlags_NoCloseButton)
9293:         p_open = NULL;
9294:     else if (p_open == NULL)
9295:         flags |= ImGuiTabItemFlags_NoCloseButton;
9296:     // Acquire tab data
9297:     ImGuiTabItem* tab = TabBarFindTabByID(tab_bar, id);
9298:     bool tab_is_new = false;
9299:     if (tab == NULL)
9300:     {
9301:         tab_bar->Tabs.push_back(ImGuiTabItem());
9302:         tab = &tab_bar->Tabs.back();
9303:         tab->ID = id;
9304:         tab_bar->TabsAddedNew = tab_is_new = true;
9305:     }
9306:     tab_bar->LastTabItemIdx = (ImS16)tab_bar->Tabs.index_from_ptr(tab);
9307:     // Calculate tab contents size
9308:     ImVec2 size = TabItemCalcSize(label, (p_open != NULL) || (flags & ImGuiTabItemFlags_UnsavedDocument));
9309:     tab->RequestedWidth = -1.0f;
9310:     if (g.NextItemData.HasFlags & ImGuiNextItemDataFlags_HasWidth)
9311:         size.x = tab->RequestedWidth = g.NextItemData.Width;
9312:     if (tab_is_new)
9313:         tab->Width = ImMax(1.0f, size.x);
9314:     tab->ContentWidth = size.x;
9315:     tab->BeginOrder = tab_bar->TabsActiveCount++;
9316:     const bool tab_bar_appearing = (tab_bar->PrevFrameVisible + 1 < g.FrameCount);
9317:     const bool tab_bar_focused = (tab_bar->Flags & ImGuiTabBarFlags_IsFocused) != 0;
9318:     const bool tab_appearing = (tab->LastFrameVisible + 1 < g.FrameCount);
9319:     const bool tab_just_unsaved = (flags & ImGuiTabItemFlags_UnsavedDocument) && !(tab->Flags & ImGuiTabItemFlags_UnsavedDocument);
9320:     const bool is_tab_button = (flags & ImGuiTabItemFlags_Button) != 0;
9321:     tab->LastFrameVisible = g.FrameCount;
9322:     tab->Flags = flags;
9323:     // Append name _WITH_ the zero-terminator
9324:     if (docked_window != NULL)
9325:     {
9326:         IM_ASSERT(docked_window == NULL); // master branch only
9327:     }
9328:     else
9329:     {
9330:         tab->NameOffset = (ImS32)tab_bar->TabsNames.size();
9331:         tab_bar->TabsNames.append(label, label + ImStrlen(label) + 1);
9332:     }
9333:     // Update selected tab
9334:     if (!is_tab_button)
9335:     {
9336:         if (tab_appearing && (tab_bar->Flags & ImGuiTabBarFlags_AutoSelectNewTabs) && tab_bar->NextSelectedTabId == 0)
9337:             if (!tab_bar_appearing || tab_bar->SelectedTabId == 0)
9338:                 TabBarQueueFocus(tab_bar, tab); // New tabs gets activated
9339:         if ((flags & ImGuiTabItemFlags_SetSelected) && (tab_bar->SelectedTabId != id)) // _SetSelected can only be passed on explicit tab bar
9340:             TabBarQueueFocus(tab_bar, tab);
9341:     }
