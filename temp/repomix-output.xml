3139: // We don't use strchr() because our strings are usually very short and often start with '%'
3140: const char* ImParseFormatFindStart(const char* fmt)
3141: {
3142:     while (char c = fmt[0])
3143:     {
3144:         if (c == '%' && fmt[1] != '%')
3145:             return fmt;
3146:         else if (c == '%')
3147:             fmt++;
3148:         fmt++;
3149:     }
3150:     return fmt;
3151: }
3152: const char* ImParseFormatFindEnd(const char* fmt)
3153: {
3154:     // Printf/scanf types modifiers: I/L/h/j/l/t/w/z. Other uppercase letters qualify as types aka end of the format.
3155:     if (fmt[0] != '%')
3156:         return fmt;
3157:     const unsigned int ignored_uppercase_mask = (1 << ('I'-'A')) | (1 << ('L'-'A'));
3158:     const unsigned int ignored_lowercase_mask = (1 << ('h'-'a')) | (1 << ('j'-'a')) | (1 << ('l'-'a')) | (1 << ('t'-'a')) | (1 << ('w'-'a')) | (1 << ('z'-'a'));
3159:     for (char c; (c = *fmt) != 0; fmt++)
3160:     {
3161:         if (c >= 'A' && c <= 'Z' && ((1 << (c - 'A')) & ignored_uppercase_mask) == 0)
3162:             return fmt + 1;
3163:         if (c >= 'a' && c <= 'z' && ((1 << (c - 'a')) & ignored_lowercase_mask) == 0)
3164:             return fmt + 1;
3165:     }
3166:     return fmt;
3167: }
3168: // Extract the format out of a format string with leading or trailing decorations
3169: //  fmt = "blah blah"  -> return ""
3170: //  fmt = "%.3f"       -> return fmt
3171: //  fmt = "hello %.3f" -> return fmt + 6
3172: //  fmt = "%.3f hello" -> return buf written with "%.3f"
3173: const char* ImParseFormatTrimDecorations(const char* fmt, char* buf, size_t buf_size)
3174: {
3175:     const char* fmt_start = ImParseFormatFindStart(fmt);
3176:     if (fmt_start[0] != '%')
3177:         return "";
3178:     const char* fmt_end = ImParseFormatFindEnd(fmt_start);
3179:     if (fmt_end[0] == 0) // If we only have leading decoration, we don't need to copy the data.
3180:         return fmt_start;
3181:     ImStrncpy(buf, fmt_start, ImMin((size_t)(fmt_end - fmt_start) + 1, buf_size));
3182:     return buf;
3183: }
3184: // Sanitize format
3185: // - Zero terminate so extra characters after format (e.g. "%f123") don't confuse atof/atoi
3186: // - stb_sprintf.h supports several new modifiers which format numbers in a way that also makes them incompatible atof/atoi.
3187: void ImParseFormatSanitizeForPrinting(const char* fmt_in, char* fmt_out, size_t fmt_out_size)
3188: {
3189:     const char* fmt_end = ImParseFormatFindEnd(fmt_in);
3190:     IM_UNUSED(fmt_out_size);
3191:     IM_ASSERT((size_t)(fmt_end - fmt_in + 1) < fmt_out_size); // Format is too long, let us know if this happens to you!
3192:     while (fmt_in < fmt_end)
3193:     {
3194:         char c = *fmt_in++;
3195:         if (c != '\'' && c != '$' && c != '_') // Custom flags provided by stb_sprintf.h. POSIX 2008 also supports '.
3196:             *(fmt_out++) = c;
3197:     }
3198:     *fmt_out = 0; // Zero-terminate
3199: }
3200: // - For scanning we need to remove all width and precision fields and flags "%+3.7f" -> "%f". BUT don't strip types like "%I64d" which includes digits. ! "%07I64d" -> "%I64d"
3201: const char* ImParseFormatSanitizeForScanning(const char* fmt_in, char* fmt_out, size_t fmt_out_size)
3202: {
3203:     const char* fmt_end = ImParseFormatFindEnd(fmt_in);
3204:     const char* fmt_out_begin = fmt_out;
3205:     IM_UNUSED(fmt_out_size);
3206:     IM_ASSERT((size_t)(fmt_end - fmt_in + 1) < fmt_out_size); // Format is too long, let us know if this happens to you!
3207:     bool has_type = false;
3208:     while (fmt_in < fmt_end)
3209:     {
3210:         char c = *fmt_in++;
3211:         if (!has_type && ((c >= '0' && c <= '9') || c == '.' || c == '+' || c == '#'))
3212:             continue;
3213:         has_type |= ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')); // Stop skipping digits
3214:         if (c != '\'' && c != '$' && c != '_') // Custom flags provided by stb_sprintf.h. POSIX 2008 also supports '.
3215:             *(fmt_out++) = c;
3216:     }
3217:     *fmt_out = 0; // Zero-terminate
3218:     return fmt_out_begin;
3219: }
3220: template<typename TYPE>
3221: static const char* ImAtoi(const char* src, TYPE* output)
3222: {
3223:     int negative = 0;
3224:     if (*src == '-') { negative = 1; src++; }
3225:     if (*src == '+') { src++; }
3226:     TYPE v = 0;
3227:     while (*src >= '0' && *src <= '9')
3228:         v = (v * 10) + (*src++ - '0');
3229:     *output = negative ? -v : v;
3230:     return src;
3231: }
3232: // Parse display precision back from the display format string
3233: // FIXME: This is still used by some navigation code path to infer a minimum tweak step, but we should aim to rework widgets so it isn't needed.
3234: int ImParseFormatPrecision(const char* fmt, int default_precision)
3235: {
3236:     fmt = ImParseFormatFindStart(fmt);
3237:     if (fmt[0] != '%')
3238:         return default_precision;
3239:     fmt++;
3240:     while (*fmt >= '0' && *fmt <= '9')
3241:         fmt++;
3242:     int precision = INT_MAX;
3243:     if (*fmt == '.')
3244:     {
3245:         fmt = ImAtoi<int>(fmt + 1, &precision);
3246:         if (precision < 0 || precision > 99)
3247:             precision = default_precision;
3248:     }
3249:     if (*fmt == 'e' || *fmt == 'E') // Maximum precision with scientific notation
3250:         precision = -1;
3251:     if ((*fmt == 'g' || *fmt == 'G') && precision == INT_MAX)
3252:         precision = -1;
3253:     return (precision == INT_MAX) ? default_precision : precision;
3254: }
