9044: void ImGui::TabBarQueueReorderFromMousePos(ImGuiTabBar* tab_bar, ImGuiTabItem* src_tab, ImVec2 mouse_pos)
9045: {
9046:     ImGuiContext& g = *GImGui;
9047:     IM_ASSERT(tab_bar->ReorderRequestTabId == 0);
9048:     if ((tab_bar->Flags & ImGuiTabBarFlags_Reorderable) == 0)
9049:         return;
9050:     const bool is_central_section = (src_tab->Flags & ImGuiTabItemFlags_SectionMask_) == 0;
9051:     const float bar_offset = tab_bar->BarRect.Min.x - (is_central_section ? tab_bar->ScrollingTarget : 0);
9052:     // Count number of contiguous tabs we are crossing over
9053:     const int dir = (bar_offset + src_tab->Offset) > mouse_pos.x ? -1 : +1;
9054:     const int src_idx = tab_bar->Tabs.index_from_ptr(src_tab);
9055:     int dst_idx = src_idx;
9056:     for (int i = src_idx; i >= 0 && i < tab_bar->Tabs.Size; i += dir)
9057:     {
9058:         // Reordered tabs must share the same section
9059:         const ImGuiTabItem* dst_tab = &tab_bar->Tabs[i];
9060:         if (dst_tab->Flags & ImGuiTabItemFlags_NoReorder)
9061:             break;
9062:         if ((dst_tab->Flags & ImGuiTabItemFlags_SectionMask_) != (src_tab->Flags & ImGuiTabItemFlags_SectionMask_))
9063:             break;
9064:         dst_idx = i;
9065:         // Include spacing after tab, so when mouse cursor is between tabs we would not continue checking further tabs that are not hovered.
9066:         const float x1 = bar_offset + dst_tab->Offset - g.Style.ItemInnerSpacing.x;
9067:         const float x2 = bar_offset + dst_tab->Offset + dst_tab->Width + g.Style.ItemInnerSpacing.x;
9068:         //GetForegroundDrawList()->AddRect(ImVec2(x1, tab_bar->BarRect.Min.y), ImVec2(x2, tab_bar->BarRect.Max.y), IM_COL32(255, 0, 0, 255));
9069:         if ((dir < 0 && mouse_pos.x > x1) || (dir > 0 && mouse_pos.x < x2))
9070:             break;
9071:     }
9072:     if (dst_idx != src_idx)
9073:         TabBarQueueReorder(tab_bar, src_tab, dst_idx - src_idx);
9074: }
9075: bool ImGui::TabBarProcessReorder(ImGuiTabBar* tab_bar)
9076: {
9077:     ImGuiTabItem* tab1 = TabBarFindTabByID(tab_bar, tab_bar->ReorderRequestTabId);
9078:     if (tab1 == NULL || (tab1->Flags & ImGuiTabItemFlags_NoReorder))
9079:         return false;
9080:     //IM_ASSERT(tab_bar->Flags & ImGuiTabBarFlags_Reorderable); // <- this may happen when using debug tools
9081:     int tab2_order = TabBarGetTabOrder(tab_bar, tab1) + tab_bar->ReorderRequestOffset;
9082:     if (tab2_order < 0 || tab2_order >= tab_bar->Tabs.Size)
9083:         return false;
9084:     // Reordered tabs must share the same section
9085:     // (Note: TabBarQueueReorderFromMousePos() also has a similar test but since we allow direct calls to TabBarQueueReorder() we do it here too)
9086:     ImGuiTabItem* tab2 = &tab_bar->Tabs[tab2_order];
9087:     if (tab2->Flags & ImGuiTabItemFlags_NoReorder)
9088:         return false;
9089:     if ((tab1->Flags & ImGuiTabItemFlags_SectionMask_) != (tab2->Flags & ImGuiTabItemFlags_SectionMask_))
9090:         return false;
9091:     ImGuiTabItem item_tmp = *tab1;
9092:     ImGuiTabItem* src_tab = (tab_bar->ReorderRequestOffset > 0) ? tab1 + 1 : tab2;
9093:     ImGuiTabItem* dst_tab = (tab_bar->ReorderRequestOffset > 0) ? tab1 : tab2 + 1;
9094:     const int move_count = (tab_bar->ReorderRequestOffset > 0) ? tab_bar->ReorderRequestOffset : -tab_bar->ReorderRequestOffset;
9095:     memmove(dst_tab, src_tab, move_count * sizeof(ImGuiTabItem));
9096:     *tab2 = item_tmp;
9097:     if (tab_bar->Flags & ImGuiTabBarFlags_SaveSettings)
9098:         MarkIniSettingsDirty();
9099:     return true;
9100: }
9101: static ImGuiTabItem* ImGui::TabBarScrollingButtons(ImGuiTabBar* tab_bar)
9102: {
9103:     ImGuiContext& g = *GImGui;
9104:     ImGuiWindow* window = g.CurrentWindow;
9105:     const ImVec2 arrow_button_size(g.FontSize - 2.0f, g.FontSize + g.Style.FramePadding.y * 2.0f);
9106:     const float scrolling_buttons_width = arrow_button_size.x * 2.0f;
9107:     const ImVec2 backup_cursor_pos = window->DC.CursorPos;
9108:     //window->DrawList->AddRect(ImVec2(tab_bar->BarRect.Max.x - scrolling_buttons_width, tab_bar->BarRect.Min.y), ImVec2(tab_bar->BarRect.Max.x, tab_bar->BarRect.Max.y), IM_COL32(255,0,0,255));
9109:     int select_dir = 0;
9110:     ImVec4 arrow_col = g.Style.Colors[ImGuiCol_Text];
9111:     arrow_col.w *= 0.5f;
9112:     PushStyleColor(ImGuiCol_Text, arrow_col);
9113:     PushStyleColor(ImGuiCol_Button, ImVec4(0, 0, 0, 0));
9114:     PushItemFlag(ImGuiItemFlags_ButtonRepeat | ImGuiItemFlags_NoNav, true);
9115:     const float backup_repeat_delay = g.IO.KeyRepeatDelay;
9116:     const float backup_repeat_rate = g.IO.KeyRepeatRate;
9117:     g.IO.KeyRepeatDelay = 0.250f;
9118:     g.IO.KeyRepeatRate = 0.200f;
9119:     float x = ImMax(tab_bar->BarRect.Min.x, tab_bar->BarRect.Max.x - scrolling_buttons_width);
9120:     window->DC.CursorPos = ImVec2(x, tab_bar->BarRect.Min.y);
9121:     if (ArrowButtonEx("##<", ImGuiDir_Left, arrow_button_size, ImGuiButtonFlags_PressedOnClick))
9122:         select_dir = -1;
9123:     window->DC.CursorPos = ImVec2(x + arrow_button_size.x, tab_bar->BarRect.Min.y);
9124:     if (ArrowButtonEx("##>", ImGuiDir_Right, arrow_button_size, ImGuiButtonFlags_PressedOnClick))
9125:         select_dir = +1;
9126:     PopItemFlag();
9127:     PopStyleColor(2);
9128:     g.IO.KeyRepeatRate = backup_repeat_rate;
9129:     g.IO.KeyRepeatDelay = backup_repeat_delay;
9130:     ImGuiTabItem* tab_to_scroll_to = NULL;
9131:     if (select_dir != 0)
9132:         if (ImGuiTabItem* tab_item = TabBarFindTabByID(tab_bar, tab_bar->SelectedTabId))
9133:         {
9134:             int selected_order = TabBarGetTabOrder(tab_bar, tab_item);
9135:             int target_order = selected_order + select_dir;
9136:             // Skip tab item buttons until another tab item is found or end is reached
9137:             while (tab_to_scroll_to == NULL)
9138:             {
9139:                 // If we are at the end of the list, still scroll to make our tab visible
9140:                 tab_to_scroll_to = &tab_bar->Tabs[(target_order >= 0 && target_order < tab_bar->Tabs.Size) ? target_order : selected_order];
9141:                 // Cross through buttons
9142:                 // (even if first/last item is a button, return it so we can update the scroll)
9143:                 if (tab_to_scroll_to->Flags & ImGuiTabItemFlags_Button)
9144:                 {
9145:                     target_order += select_dir;
9146:                     selected_order += select_dir;
9147:                     tab_to_scroll_to = (target_order < 0 || target_order >= tab_bar->Tabs.Size) ? tab_to_scroll_to : NULL;
9148:                 }
9149:             }
9150:         }
9151:     window->DC.CursorPos = backup_cursor_pos;
9152:     tab_bar->BarRect.Max.x -= scrolling_buttons_width + 1.0f;
9153:     return tab_to_scroll_to;
9154: }
