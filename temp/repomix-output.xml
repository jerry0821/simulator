 286: bool    ImGui::BeginTableEx(const char* name, ImGuiID id, int columns_count, ImGuiTableFlags flags, const ImVec2& outer_size, float inner_width)
 287: {
 288:     ImGuiContext& g = *GImGui;
 289:     ImGuiWindow* outer_window = GetCurrentWindow();
 290:     if (outer_window->SkipItems) // Consistent with other tables + beneficial side effect that assert on miscalling EndTable() will be more visible.
 291:         return false;
 292:     // Sanity checks
 293:     IM_ASSERT(columns_count > 0 && columns_count < IMGUI_TABLE_MAX_COLUMNS);
 294:     if (flags & ImGuiTableFlags_ScrollX)
 295:         IM_ASSERT(inner_width >= 0.0f);
 296:     // If an outer size is specified ahead we will be able to early out when not visible. Exact clipping criteria may evolve.
 297:     // FIXME: coarse clipping because access to table data causes two issues:
 298:     // - instance numbers varying/unstable. may not be a direct problem for users, but could make outside access broken or confusing, e.g. TestEngine.
 299:     // - can't implement support for ImGuiChildFlags_ResizeY as we need to somehow pull the height data from somewhere. this also needs stable instance numbers.
 300:     // The side-effects of accessing table data on coarse clip would be:
 301:     // - always reserving the pooled ImGuiTable data ahead for a fully clipped table (minor IMHO). Also the 'outer_window_is_measuring_size' criteria may already be defeating this in some situations.
 302:     // - always performing the GetOrAddByKey() O(log N) query in g.Tables.Map[].
 303:     const bool use_child_window = (flags & (ImGuiTableFlags_ScrollX | ImGuiTableFlags_ScrollY)) != 0;
 304:     const ImVec2 avail_size = GetContentRegionAvail();
 305:     const ImVec2 actual_outer_size = ImTrunc(CalcItemSize(outer_size, ImMax(avail_size.x, IMGUI_WINDOW_HARD_MIN_SIZE), use_child_window ? ImMax(avail_size.y, IMGUI_WINDOW_HARD_MIN_SIZE) : 0.0f));
 306:     const ImRect outer_rect(outer_window->DC.CursorPos, outer_window->DC.CursorPos + actual_outer_size);
 307:     const bool outer_window_is_measuring_size = (outer_window->AutoFitFramesX > 0) || (outer_window->AutoFitFramesY > 0); // Doesn't apply to AlwaysAutoResize windows!
 308:     if (use_child_window && IsClippedEx(outer_rect, 0) && !outer_window_is_measuring_size)
 309:     {
 310:         ItemSize(outer_rect);
 311:         ItemAdd(outer_rect, id);
 312:         g.NextWindowData.ClearFlags();
 313:         return false;
 314:     }
 315:     // [DEBUG] Debug break requested by user
 316:     if (g.DebugBreakInTable == id)
 317:         IM_DEBUG_BREAK();
 318:     // Acquire storage for the table
 319:     ImGuiTable* table = g.Tables.GetOrAddByKey(id);
 320:     // Acquire temporary buffers
 321:     const int table_idx = g.Tables.GetIndex(table);
 322:     if (++g.TablesTempDataStacked > g.TablesTempData.Size)
 323:         g.TablesTempData.resize(g.TablesTempDataStacked, ImGuiTableTempData());
 324:     ImGuiTableTempData* temp_data = table->TempData = &g.TablesTempData[g.TablesTempDataStacked - 1];
 325:     temp_data->TableIndex = table_idx;
 326:     table->DrawSplitter = &table->TempData->DrawSplitter;
 327:     table->DrawSplitter->Clear();
 328:     // Fix flags
 329:     table->IsDefaultSizingPolicy = (flags & ImGuiTableFlags_SizingMask_) == 0;
 330:     flags = TableFixFlags(flags, outer_window);
 331:     // Initialize
 332:     const int previous_frame_active = table->LastFrameActive;
 333:     const int instance_no = (previous_frame_active != g.FrameCount) ? 0 : table->InstanceCurrent + 1;
 334:     const ImGuiTableFlags previous_flags = table->Flags;
 335:     table->ID = id;
 336:     table->Flags = flags;
 337:     table->LastFrameActive = g.FrameCount;
 338:     table->OuterWindow = table->InnerWindow = outer_window;
 339:     table->ColumnsCount = columns_count;
 340:     table->IsLayoutLocked = false;
 341:     table->InnerWidth = inner_width;
 342:     table->NavLayer = (ImS8)outer_window->DC.NavLayerCurrent;
 343:     temp_data->UserOuterSize = outer_size;
 344:     // Instance data (for instance 0, TableID == TableInstanceID)
 345:     ImGuiID instance_id;
 346:     table->InstanceCurrent = (ImS16)instance_no;
 347:     if (instance_no > 0)
 348:     {
 349:         IM_ASSERT(table->ColumnsCount == columns_count && "BeginTable(): Cannot change columns count mid-frame while preserving same ID");
 350:         if (table->InstanceDataExtra.Size < instance_no)
 351:             table->InstanceDataExtra.push_back(ImGuiTableInstanceData());
 352:         instance_id = GetIDWithSeed(instance_no, GetIDWithSeed("##Instances", NULL, id)); // Push "##Instances" followed by (int)instance_no in ID stack.
 353:     }
 354:     else
 355:     {
 356:         instance_id = id;
 357:     }
 358:     ImGuiTableInstanceData* table_instance = TableGetInstanceData(table, table->InstanceCurrent);
 359:     table_instance->TableInstanceID = instance_id;
 360:     // When not using a child window, WorkRect.Max will grow as we append contents.
 361:     if (use_child_window)
 362:     {
 363:         // Ensure no vertical scrollbar appears if we only want horizontal one, to make flag consistent
 364:         // (we have no other way to disable vertical scrollbar of a window while keeping the horizontal one showing)
 365:         ImVec2 override_content_size(FLT_MAX, FLT_MAX);
 366:         if ((flags & ImGuiTableFlags_ScrollX) && !(flags & ImGuiTableFlags_ScrollY))
 367:             override_content_size.y = FLT_MIN;
 368:         // Ensure specified width (when not specified, Stretched columns will act as if the width == OuterWidth and
 369:         // never lead to any scrolling). We don't handle inner_width < 0.0f, we could potentially use it to right-align
 370:         // based on the right side of the child window work rect, which would require knowing ahead if we are going to
 371:         // have decoration taking horizontal spaces (typically a vertical scrollbar).
 372:         if ((flags & ImGuiTableFlags_ScrollX) && inner_width > 0.0f)
 373:             override_content_size.x = inner_width;
 374:         if (override_content_size.x != FLT_MAX || override_content_size.y != FLT_MAX)
 375:             SetNextWindowContentSize(ImVec2(override_content_size.x != FLT_MAX ? override_content_size.x : 0.0f, override_content_size.y != FLT_MAX ? override_content_size.y : 0.0f));
 376:         // Reset scroll if we are reactivating it
 377:         if ((previous_flags & (ImGuiTableFlags_ScrollX | ImGuiTableFlags_ScrollY)) == 0)
 378:             if ((g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasScroll) == 0)
 379:                 SetNextWindowScroll(ImVec2(0.0f, 0.0f));
 380:         // Create scrolling region (without border and zero window padding)
 381:         ImGuiChildFlags child_child_flags = (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasChildFlags) ? g.NextWindowData.ChildFlags : ImGuiChildFlags_None;
 382:         ImGuiWindowFlags child_window_flags = (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasWindowFlags) ? g.NextWindowData.WindowFlags : ImGuiWindowFlags_None;
 383:         if (flags & ImGuiTableFlags_ScrollX)
 384:             child_window_flags |= ImGuiWindowFlags_HorizontalScrollbar;
 385:         BeginChildEx(name, instance_id, outer_rect.GetSize(), child_child_flags, child_window_flags);
 386:         table->InnerWindow = g.CurrentWindow;
 387:         table->WorkRect = table->InnerWindow->WorkRect;
 388:         table->OuterRect = table->InnerWindow->Rect();
 389:         table->InnerRect = table->InnerWindow->InnerRect;
 390:         IM_ASSERT(table->InnerWindow->WindowPadding.x == 0.0f && table->InnerWindow->WindowPadding.y == 0.0f && table->InnerWindow->WindowBorderSize == 0.0f);
 391:         // Allow submitting when host is measuring
 392:         if (table->InnerWindow->SkipItems && outer_window_is_measuring_size)
 393:             table->InnerWindow->SkipItems = false;
 394:         // When using multiple instances, ensure they have the same amount of horizontal decorations (aka vertical scrollbar) so stretched columns can be aligned
 395:         if (instance_no == 0)
 396:         {
 397:             table->HasScrollbarYPrev = table->HasScrollbarYCurr;
 398:             table->HasScrollbarYCurr = false;
 399:         }
 400:         table->HasScrollbarYCurr |= table->InnerWindow->ScrollbarY;
 401:     }
 402:     else
 403:     {
 404:         // For non-scrolling tables, WorkRect == OuterRect == InnerRect.
 405:         // But at this point we do NOT have a correct value for .Max.y (unless a height has been explicitly passed in). It will only be updated in EndTable().
 406:         table->WorkRect = table->OuterRect = table->InnerRect = outer_rect;
 407:         table->HasScrollbarYPrev = table->HasScrollbarYCurr = false;
 408:         table->InnerWindow->DC.TreeDepth++; // This is designed to always linking ImGuiTreeNodeFlags_DrawLines linking across a table
 409:     }
 410:     // Push a standardized ID for both child-using and not-child-using tables
 411:     PushOverrideID(id);
 412:     if (instance_no > 0)
 413:         PushOverrideID(instance_id); // FIXME: Somehow this is not resolved by stack-tool, even tho GetIDWithSeed() submitted the symbol.
 414:     // Backup a copy of host window members we will modify
 415:     ImGuiWindow* inner_window = table->InnerWindow;
 416:     table->HostIndentX = inner_window->DC.Indent.x;
 417:     table->HostClipRect = inner_window->ClipRect;
 418:     table->HostSkipItems = inner_window->SkipItems;
 419:     temp_data->WindowID = inner_window->ID;
 420:     temp_data->HostBackupWorkRect = inner_window->WorkRect;
 421:     temp_data->HostBackupParentWorkRect = inner_window->ParentWorkRect;
 422:     temp_data->HostBackupColumnsOffset = outer_window->DC.ColumnsOffset;
 423:     temp_data->HostBackupPrevLineSize = inner_window->DC.PrevLineSize;
 424:     temp_data->HostBackupCurrLineSize = inner_window->DC.CurrLineSize;
 425:     temp_data->HostBackupCursorMaxPos = inner_window->DC.CursorMaxPos;
 426:     temp_data->HostBackupItemWidth = outer_window->DC.ItemWidth;
 427:     temp_data->HostBackupItemWidthStackSize = outer_window->DC.ItemWidthStack.Size;
 428:     inner_window->DC.PrevLineSize = inner_window->DC.CurrLineSize = ImVec2(0.0f, 0.0f);
 429:     // Make borders not overlap our contents by offsetting HostClipRect (#6765, #7428, #3752)
 430:     // (we normally shouldn't alter HostClipRect as we rely on TableMergeDrawChannels() expanding non-clipped column toward the
 431:     // limits of that rectangle, in order for ImDrawListSplitter::Merge() to merge the draw commands. However since the overlap
 432:     // problem only affect scrolling tables in this case we can get away with doing it without extra cost).
 433:     if (inner_window != outer_window)
 434:     {
 435:         // FIXME: Because inner_window's Scrollbar doesn't know about border size, since it's not encoded in window->WindowBorderSize,
 436:         // it already overlaps it and doesn't need an extra offset. Ideally we should be able to pass custom border size with
 437:         // different x/y values to BeginChild().
 438:         if (flags & ImGuiTableFlags_BordersOuterV)
 439:         {
 440:             table->HostClipRect.Min.x = ImMin(table->HostClipRect.Min.x + TABLE_BORDER_SIZE, table->HostClipRect.Max.x);
 441:             if (inner_window->DecoOuterSizeX2 == 0.0f)
 442:                 table->HostClipRect.Max.x = ImMax(table->HostClipRect.Max.x - TABLE_BORDER_SIZE, table->HostClipRect.Min.x);
 443:         }
 444:         if (flags & ImGuiTableFlags_BordersOuterH)
 445:         {
 446:             table->HostClipRect.Min.y = ImMin(table->HostClipRect.Min.y + TABLE_BORDER_SIZE, table->HostClipRect.Max.y);
 447:             if (inner_window->DecoOuterSizeY2 == 0.0f)
 448:                 table->HostClipRect.Max.y = ImMax(table->HostClipRect.Max.y - TABLE_BORDER_SIZE, table->HostClipRect.Min.y);
 449:         }
 450:     }
 451:     // Padding and Spacing
 452:     // - None               ........Content..... Pad .....Content........
 453:     // - PadOuter           | Pad ..Content..... Pad .....Content.. Pad |
 454:     // - PadInner           ........Content.. Pad | Pad ..Content........
 455:     // - PadOuter+PadInner  | Pad ..Content.. Pad | Pad ..Content.. Pad |
 456:     const bool pad_outer_x = (flags & ImGuiTableFlags_NoPadOuterX) ? false : (flags & ImGuiTableFlags_PadOuterX) ? true : (flags & ImGuiTableFlags_BordersOuterV) != 0;
 457:     const bool pad_inner_x = (flags & ImGuiTableFlags_NoPadInnerX) ? false : true;
 458:     const float inner_spacing_for_border = (flags & ImGuiTableFlags_BordersInnerV) ? TABLE_BORDER_SIZE : 0.0f;
 459:     const float inner_spacing_explicit = (pad_inner_x && (flags & ImGuiTableFlags_BordersInnerV) == 0) ? g.Style.CellPadding.x : 0.0f;
 460:     const float inner_padding_explicit = (pad_inner_x && (flags & ImGuiTableFlags_BordersInnerV) != 0) ? g.Style.CellPadding.x : 0.0f;
 461:     table->CellSpacingX1 = inner_spacing_explicit + inner_spacing_for_border;
 462:     table->CellSpacingX2 = inner_spacing_explicit;
 463:     table->CellPaddingX = inner_padding_explicit;
 464:     const float outer_padding_for_border = (flags & ImGuiTableFlags_BordersOuterV) ? TABLE_BORDER_SIZE : 0.0f;
 465:     const float outer_padding_explicit = pad_outer_x ? g.Style.CellPadding.x : 0.0f;
 466:     table->OuterPaddingX = (outer_padding_for_border + outer_padding_explicit) - table->CellPaddingX;
 467:     table->CurrentColumn = -1;
 468:     table->CurrentRow = -1;
 469:     table->RowBgColorCounter = 0;
 470:     table->LastRowFlags = ImGuiTableRowFlags_None;
 471:     table->InnerClipRect = (inner_window == outer_window) ? table->WorkRect : inner_window->ClipRect;
 472:     table->InnerClipRect.ClipWith(table->WorkRect);     // We need this to honor inner_width
 473:     table->InnerClipRect.ClipWithFull(table->HostClipRect);
 474:     table->InnerClipRect.Max.y = (flags & ImGuiTableFlags_NoHostExtendY) ? ImMin(table->InnerClipRect.Max.y, inner_window->WorkRect.Max.y) : table->HostClipRect.Max.y;
 475:     table->RowPosY1 = table->RowPosY2 = table->WorkRect.Min.y; // This is needed somehow
 476:     table->RowTextBaseline = 0.0f; // This will be cleared again by TableBeginRow()
 477:     table->RowCellPaddingY = 0.0f;
 478:     table->FreezeRowsRequest = table->FreezeRowsCount = 0; // This will be setup by TableSetupScrollFreeze(), if any
 479:     table->FreezeColumnsRequest = table->FreezeColumnsCount = 0;
 480:     table->IsUnfrozenRows = true;
 481:     table->DeclColumnsCount = table->AngledHeadersCount = 0;
 482:     if (previous_frame_active + 1 < g.FrameCount)
 483:         table->IsActiveIdInTable = false;
 484:     table->AngledHeadersHeight = 0.0f;
 485:     temp_data->AngledHeadersExtraWidth = 0.0f;
 486:     // Using opaque colors facilitate overlapping lines of the grid, otherwise we'd need to improve TableDrawBorders()
 487:     table->BorderColorStrong = GetColorU32(ImGuiCol_TableBorderStrong);
 488:     table->BorderColorLight = GetColorU32(ImGuiCol_TableBorderLight);
 489:     // Make table current
 490:     g.CurrentTable = table;
 491:     inner_window->DC.NavIsScrollPushableX = false; // Shortcut for NavUpdateCurrentWindowIsScrollPushableX();
 492:     outer_window->DC.CurrentTableIdx = table_idx;
 493:     if (inner_window != outer_window) // So EndChild() within the inner window can restore the table properly.
 494:         inner_window->DC.CurrentTableIdx = table_idx;
 495:     if ((previous_flags & ImGuiTableFlags_Reorderable) && (flags & ImGuiTableFlags_Reorderable) == 0)
 496:         table->IsResetDisplayOrderRequest = true;
 497:     // Mark as used to avoid GC
 498:     if (table_idx >= g.TablesLastTimeActive.Size)
 499:         g.TablesLastTimeActive.resize(table_idx + 1, -1.0f);
 500:     g.TablesLastTimeActive[table_idx] = (float)g.Time;
 501:     temp_data->LastTimeActive = (float)g.Time;
 502:     table->MemoryCompacted = false;
 503:     // Setup memory buffer (clear data if columns count changed)
 504:     ImGuiTableColumn* old_columns_to_preserve = NULL;
 505:     void* old_columns_raw_data = NULL;
 506:     const int old_columns_count = table->Columns.size();
 507:     if (old_columns_count != 0 && old_columns_count != columns_count)
 508:     {
 509:         // Attempt to preserve width on column count change (#4046)
 510:         old_columns_to_preserve = table->Columns.Data;
 511:         old_columns_raw_data = table->RawData; // Free at end of function
 512:         table->RawData = NULL;
 513:     }
 514:     if (table->RawData == NULL)
 515:     {
 516:         TableBeginInitMemory(table, columns_count);
 517:         table->IsInitializing = table->IsSettingsRequestLoad = true;
 518:     }
 519:     if (table->IsResetAllRequest)
 520:         TableResetSettings(table);
 521:     if (table->IsInitializing)
 522:     {
 523:         // Initialize
 524:         table->SettingsOffset = -1;
 525:         table->IsSortSpecsDirty = true;
 526:         table->IsSettingsDirty = true; // Records itself into .ini file even when in default state (#7934)
 527:         table->InstanceInteracted = -1;
 528:         table->ContextPopupColumn = -1;
 529:         table->ReorderColumn = table->ResizedColumn = table->LastResizedColumn = -1;
 530:         table->AutoFitSingleColumn = -1;
 531:         table->HoveredColumnBody = table->HoveredColumnBorder = -1;
 532:         for (int n = 0; n < columns_count; n++)
 533:         {
 534:             ImGuiTableColumn* column = &table->Columns[n];
 535:             if (old_columns_to_preserve && n < old_columns_count)
 536:             {
 537:                 *column = old_columns_to_preserve[n];
 538:             }
 539:             else
 540:             {
 541:                 float width_auto = column->WidthAuto;
 542:                 *column = ImGuiTableColumn();
 543:                 column->WidthAuto = width_auto;
 544:                 column->IsPreserveWidthAuto = true; // Preserve WidthAuto when reinitializing a live table: not technically necessary but remove a visible flicker
 545:                 column->IsEnabled = column->IsUserEnabled = column->IsUserEnabledNextFrame = true;
 546:                 column->DisplayOrder = (ImGuiTableColumnIdx)n;
 547:             }
 548:             table->DisplayOrderToIndex[n] = column->DisplayOrder;
 549:         }
 550:     }
 551:     if (old_columns_raw_data)
 552:         IM_FREE(old_columns_raw_data);
 553:     // Load settings
 554:     if (table->IsSettingsRequestLoad)
 555:         TableLoadSettings(table);
 556:     // Handle DPI/font resize
 557:     // This is designed to facilitate DPI changes with the assumption that e.g. style.CellPadding has been scaled as well.
 558:     // It will also react to changing fonts with mixed results. It doesn't need to be perfect but merely provide a decent transition.
 559:     // FIXME-DPI: Provide consistent standards for reference size. Perhaps using g.CurrentDpiScale would be more self explanatory.
 560:     // This is will lead us to non-rounded WidthRequest in columns, which should work but is a poorly tested path.
 561:     const float new_ref_scale_unit = g.FontSize; // g.Font->GetCharAdvance('A') ?
 562:     if (table->RefScale != 0.0f && table->RefScale != new_ref_scale_unit)
 563:     {
 564:         const float scale_factor = new_ref_scale_unit / table->RefScale;
 565:         //IMGUI_DEBUG_PRINT("[table] %08X RefScaleUnit %.3f -> %.3f, scaling width by %.3f\n", table->ID, table->RefScaleUnit, new_ref_scale_unit, scale_factor);
 566:         for (int n = 0; n < columns_count; n++)
 567:             table->Columns[n].WidthRequest = table->Columns[n].WidthRequest * scale_factor;
 568:     }
 569:     table->RefScale = new_ref_scale_unit;
 570:     // Disable output until user calls TableNextRow() or TableNextColumn() leading to the TableUpdateLayout() call..
 571:     // This is not strictly necessary but will reduce cases were "out of table" output will be misleading to the user.
 572:     // Because we cannot safely assert in EndTable() when no rows have been created, this seems like our best option.
 573:     inner_window->SkipItems = true;
 574:     // Clear names
 575:     // At this point the ->NameOffset field of each column will be invalid until TableUpdateLayout() or the first call to TableSetupColumn()
 576:     if (table->ColumnsNames.Buf.Size > 0)
 577:         table->ColumnsNames.Buf.resize(0);
 578:     // Apply queued resizing/reordering/hiding requests
 579:     TableBeginApplyRequests(table);
 580:     return true;
 581: }
 582: // For reference, the average total _allocation count_ for a table is:
 583: // + 0 (for ImGuiTable instance, we are pooling allocations in g.Tables[])
 584: // + 1 (for table->RawData allocated below)
 585: // + 1 (for table->ColumnsNames, if names are used)
 586: // Shared allocations for the maximum number of simultaneously nested tables (generally a very small number)
 587: // + 1 (for table->Splitter._Channels)
 588: // + 2 * active_channels_count (for ImDrawCmd and ImDrawIdx buffers inside channels)
 589: // Where active_channels_count is variable but often == columns_count or == columns_count + 1, see TableSetupDrawChannels() for details.
 590: // Unused channels don't perform their +2 allocations.
 591: void ImGui::TableBeginInitMemory(ImGuiTable* table, int columns_count)
 592: {
 593:     // Allocate single buffer for our arrays
 594:     const int columns_bit_array_size = (int)ImBitArrayGetStorageSizeInBytes(columns_count);
 595:     ImSpanAllocator<6> span_allocator;
 596:     span_allocator.Reserve(0, columns_count * sizeof(ImGuiTableColumn));
 597:     span_allocator.Reserve(1, columns_count * sizeof(ImGuiTableColumnIdx));
 598:     span_allocator.Reserve(2, columns_count * sizeof(ImGuiTableCellData), 4);
 599:     for (int n = 3; n < 6; n++)
 600:         span_allocator.Reserve(n, columns_bit_array_size);
 601:     table->RawData = IM_ALLOC(span_allocator.GetArenaSizeInBytes());
 602:     memset(table->RawData, 0, span_allocator.GetArenaSizeInBytes());
 603:     span_allocator.SetArenaBasePtr(table->RawData);
 604:     span_allocator.GetSpan(0, &table->Columns);
 605:     span_allocator.GetSpan(1, &table->DisplayOrderToIndex);
 606:     span_allocator.GetSpan(2, &table->RowCellData);
 607:     table->EnabledMaskByDisplayOrder = (ImU32*)span_allocator.GetSpanPtrBegin(3);
 608:     table->EnabledMaskByIndex = (ImU32*)span_allocator.GetSpanPtrBegin(4);
 609:     table->VisibleMaskByIndex = (ImU32*)span_allocator.GetSpanPtrBegin(5);
 610: }
 611: // Apply queued resizing/reordering/hiding requests
 612: void ImGui::TableBeginApplyRequests(ImGuiTable* table)
 613: {
 614:     // Handle resizing request
 615:     // (We process this in the TableBegin() of the first instance of each table)
 616:     // FIXME-TABLE: Contains columns if our work area doesn't allow for scrolling?
 617:     if (table->InstanceCurrent == 0)
 618:     {
 619:         if (table->ResizedColumn != -1 && table->ResizedColumnNextWidth != FLT_MAX)
 620:             TableSetColumnWidth(table->ResizedColumn, table->ResizedColumnNextWidth);
 621:         table->LastResizedColumn = table->ResizedColumn;
 622:         table->ResizedColumnNextWidth = FLT_MAX;
 623:         table->ResizedColumn = -1;
 624:         // Process auto-fit for single column, which is a special case for stretch columns and fixed columns with FixedSame policy.
 625:         // FIXME-TABLE: Would be nice to redistribute available stretch space accordingly to other weights, instead of giving it all to siblings.
 626:         if (table->AutoFitSingleColumn != -1)
 627:         {
 628:             TableSetColumnWidth(table->AutoFitSingleColumn, table->Columns[table->AutoFitSingleColumn].WidthAuto);
 629:             table->AutoFitSingleColumn = -1;
 630:         }
 631:     }
 632:     // Handle reordering request
 633:     // Note: we don't clear ReorderColumn after handling the request.
 634:     if (table->InstanceCurrent == 0)
 635:     {
 636:         if (table->HeldHeaderColumn == -1 && table->ReorderColumn != -1)
 637:             table->ReorderColumn = -1;
 638:         table->HeldHeaderColumn = -1;
 639:         if (table->ReorderColumn != -1 && table->ReorderColumnDir != 0)
 640:         {
 641:             // We need to handle reordering across hidden columns.
 642:             // In the configuration below, moving C to the right of E will lead to:
 643:             //    ... C [D] E  --->  ... [D] E  C   (Column name/index)
 644:             //    ... 2  3  4        ...  2  3  4   (Display order)
 645:             const int reorder_dir = table->ReorderColumnDir;
 646:             IM_ASSERT(reorder_dir == -1 || reorder_dir == +1);
 647:             IM_ASSERT(table->Flags & ImGuiTableFlags_Reorderable);
 648:             ImGuiTableColumn* src_column = &table->Columns[table->ReorderColumn];
 649:             ImGuiTableColumn* dst_column = &table->Columns[(reorder_dir == -1) ? src_column->PrevEnabledColumn : src_column->NextEnabledColumn];
 650:             IM_UNUSED(dst_column);
 651:             const int src_order = src_column->DisplayOrder;
 652:             const int dst_order = dst_column->DisplayOrder;
 653:             src_column->DisplayOrder = (ImGuiTableColumnIdx)dst_order;
 654:             for (int order_n = src_order + reorder_dir; order_n != dst_order + reorder_dir; order_n += reorder_dir)
 655:                 table->Columns[table->DisplayOrderToIndex[order_n]].DisplayOrder -= (ImGuiTableColumnIdx)reorder_dir;
 656:             IM_ASSERT(dst_column->DisplayOrder == dst_order - reorder_dir);
 657:             // Display order is stored in both columns->IndexDisplayOrder and table->DisplayOrder[]. Rebuild later from the former.
 658:             for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
 659:                 table->DisplayOrderToIndex[table->Columns[column_n].DisplayOrder] = (ImGuiTableColumnIdx)column_n;
 660:             table->ReorderColumnDir = 0;
 661:             table->IsSettingsDirty = true;
 662:         }
 663:     }
 664:     // Handle display order reset request
 665:     if (table->IsResetDisplayOrderRequest)
 666:     {
 667:         for (int n = 0; n < table->ColumnsCount; n++)
 668:             table->DisplayOrderToIndex[n] = table->Columns[n].DisplayOrder = (ImGuiTableColumnIdx)n;
 669:         table->IsResetDisplayOrderRequest = false;
 670:         table->IsSettingsDirty = true;
 671:     }
 672: }
 673: // Adjust flags: default width mode + stretch columns are not allowed when auto extending
 674: static void TableSetupColumnFlags(ImGuiTable* table, ImGuiTableColumn* column, ImGuiTableColumnFlags flags_in)
 675: {
 676:     ImGuiTableColumnFlags flags = flags_in;
 677:     // Sizing Policy
 678:     if ((flags & ImGuiTableColumnFlags_WidthMask_) == 0)
 679:     {
 680:         const ImGuiTableFlags table_sizing_policy = (table->Flags & ImGuiTableFlags_SizingMask_);
 681:         if (table_sizing_policy == ImGuiTableFlags_SizingFixedFit || table_sizing_policy == ImGuiTableFlags_SizingFixedSame)
 682:             flags |= ImGuiTableColumnFlags_WidthFixed;
 683:         else
 684:             flags |= ImGuiTableColumnFlags_WidthStretch;
 685:     }
 686:     else
 687:     {
 688:         IM_ASSERT(ImIsPowerOfTwo(flags & ImGuiTableColumnFlags_WidthMask_)); // Check that only 1 of each set is used.
 689:     }
 690:     // Resize
 691:     if ((table->Flags & ImGuiTableFlags_Resizable) == 0)
 692:         flags |= ImGuiTableColumnFlags_NoResize;
 693:     // Sorting
 694:     if ((flags & ImGuiTableColumnFlags_NoSortAscending) && (flags & ImGuiTableColumnFlags_NoSortDescending))
 695:         flags |= ImGuiTableColumnFlags_NoSort;
 696:     // Indentation
 697:     if ((flags & ImGuiTableColumnFlags_IndentMask_) == 0)
 698:         flags |= (table->Columns.index_from_ptr(column) == 0) ? ImGuiTableColumnFlags_IndentEnable : ImGuiTableColumnFlags_IndentDisable;
 699:     // Alignment
 700:     //if ((flags & ImGuiTableColumnFlags_AlignMask_) == 0)
 701:     //    flags |= ImGuiTableColumnFlags_AlignCenter;
 702:     //IM_ASSERT(ImIsPowerOfTwo(flags & ImGuiTableColumnFlags_AlignMask_)); // Check that only 1 of each set is used.
 703:     // Preserve status flags
 704:     column->Flags = flags | (column->Flags & ImGuiTableColumnFlags_StatusMask_);
 705:     // Build an ordered list of available sort directions
 706:     column->SortDirectionsAvailCount = column->SortDirectionsAvailMask = column->SortDirectionsAvailList = 0;
 707:     if (table->Flags & ImGuiTableFlags_Sortable)
 708:     {
 709:         int count = 0, mask = 0, list = 0;
 710:         if ((flags & ImGuiTableColumnFlags_PreferSortAscending)  != 0 && (flags & ImGuiTableColumnFlags_NoSortAscending)  == 0) { mask |= 1 << ImGuiSortDirection_Ascending;  list |= ImGuiSortDirection_Ascending  << (count << 1); count++; }
 711:         if ((flags & ImGuiTableColumnFlags_PreferSortDescending) != 0 && (flags & ImGuiTableColumnFlags_NoSortDescending) == 0) { mask |= 1 << ImGuiSortDirection_Descending; list |= ImGuiSortDirection_Descending << (count << 1); count++; }
 712:         if ((flags & ImGuiTableColumnFlags_PreferSortAscending)  == 0 && (flags & ImGuiTableColumnFlags_NoSortAscending)  == 0) { mask |= 1 << ImGuiSortDirection_Ascending;  list |= ImGuiSortDirection_Ascending  << (count << 1); count++; }
 713:         if ((flags & ImGuiTableColumnFlags_PreferSortDescending) == 0 && (flags & ImGuiTableColumnFlags_NoSortDescending) == 0) { mask |= 1 << ImGuiSortDirection_Descending; list |= ImGuiSortDirection_Descending << (count << 1); count++; }
 714:         if ((table->Flags & ImGuiTableFlags_SortTristate) || count == 0) { mask |= 1 << ImGuiSortDirection_None; count++; }
 715:         column->SortDirectionsAvailList = (ImU8)list;
 716:         column->SortDirectionsAvailMask = (ImU8)mask;
 717:         column->SortDirectionsAvailCount = (ImU8)count;
 718:         ImGui::TableFixColumnSortDirection(table, column);
 719:     }
 720: }
 721: // Layout columns for the frame. This is in essence the followup to BeginTable() and this is our largest function.
 722: // Runs on the first call to TableNextRow(), to give a chance for TableSetupColumn() and other TableSetupXXXXX() functions to be called first.
 723: // FIXME-TABLE: Our width (and therefore our WorkRect) will be minimal in the first frame for _WidthAuto columns.
 724: // Increase feedback side-effect with widgets relying on WorkRect.Max.x... Maybe provide a default distribution for _WidthAuto columns?
 725: void ImGui::TableUpdateLayout(ImGuiTable* table)
 726: {
 727:     ImGuiContext& g = *GImGui;
 728:     IM_ASSERT(table->IsLayoutLocked == false);
 729:     const ImGuiTableFlags table_sizing_policy = (table->Flags & ImGuiTableFlags_SizingMask_);
 730:     table->IsDefaultDisplayOrder = true;
 731:     table->ColumnsEnabledCount = 0;
 732:     ImBitArrayClearAllBits(table->EnabledMaskByIndex, table->ColumnsCount);
 733:     ImBitArrayClearAllBits(table->EnabledMaskByDisplayOrder, table->ColumnsCount);
 734:     table->LeftMostEnabledColumn = -1;
 735:     table->MinColumnWidth = ImMax(1.0f, g.Style.FramePadding.x * 1.0f); // g.Style.ColumnsMinSpacing; // FIXME-TABLE
 736:     // [Part 1] Apply/lock Enabled and Order states. Calculate auto/ideal width for columns. Count fixed/stretch columns.
 737:     // Process columns in their visible orders as we are building the Prev/Next indices.
 738:     int count_fixed = 0;                // Number of columns that have fixed sizing policies
 739:     int count_stretch = 0;              // Number of columns that have stretch sizing policies
 740:     int prev_visible_column_idx = -1;
 741:     bool has_auto_fit_request = false;
 742:     bool has_resizable = false;
 743:     float stretch_sum_width_auto = 0.0f;
 744:     float fixed_max_width_auto = 0.0f;
 745:     for (int order_n = 0; order_n < table->ColumnsCount; order_n++)
 746:     {
 747:         const int column_n = table->DisplayOrderToIndex[order_n];
 748:         if (column_n != order_n)
 749:             table->IsDefaultDisplayOrder = false;
 750:         ImGuiTableColumn* column = &table->Columns[column_n];
 751:         // Clear column setup if not submitted by user. Currently we make it mandatory to call TableSetupColumn() every frame.
 752:         // It would easily work without but we're not ready to guarantee it since e.g. names need resubmission anyway.
 753:         // We take a slight shortcut but in theory we could be calling TableSetupColumn() here with dummy values, it should yield the same effect.
 754:         if (table->DeclColumnsCount <= column_n)
 755:         {
 756:             TableSetupColumnFlags(table, column, ImGuiTableColumnFlags_None);
 757:             column->NameOffset = -1;
 758:             column->UserID = 0;
 759:             column->InitStretchWeightOrWidth = -1.0f;
 760:         }
 761:         // Update Enabled state, mark settings and sort specs dirty
 762:         if (!(table->Flags & ImGuiTableFlags_Hideable) || (column->Flags & ImGuiTableColumnFlags_NoHide))
 763:             column->IsUserEnabledNextFrame = true;
 764:         if (column->IsUserEnabled != column->IsUserEnabledNextFrame)
 765:         {
 766:             column->IsUserEnabled = column->IsUserEnabledNextFrame;
 767:             table->IsSettingsDirty = true;
 768:         }
 769:         column->IsEnabled = column->IsUserEnabled && (column->Flags & ImGuiTableColumnFlags_Disabled) == 0;
 770:         if (column->SortOrder != -1 && !column->IsEnabled)
 771:             table->IsSortSpecsDirty = true;
 772:         if (column->SortOrder > 0 && !(table->Flags & ImGuiTableFlags_SortMulti))
 773:             table->IsSortSpecsDirty = true;
 774:         // Auto-fit unsized columns
 775:         const bool start_auto_fit = (column->Flags & ImGuiTableColumnFlags_WidthFixed) ? (column->WidthRequest < 0.0f) : (column->StretchWeight < 0.0f);
 776:         if (start_auto_fit)
 777:             column->AutoFitQueue = column->CannotSkipItemsQueue = (1 << 3) - 1; // Fit for three frames
 778:         if (!column->IsEnabled)
 779:         {
 780:             column->IndexWithinEnabledSet = -1;
 781:             continue;
 782:         }
 783:         // Mark as enabled and link to previous/next enabled column
 784:         column->PrevEnabledColumn = (ImGuiTableColumnIdx)prev_visible_column_idx;
 785:         column->NextEnabledColumn = -1;
 786:         if (prev_visible_column_idx != -1)
 787:             table->Columns[prev_visible_column_idx].NextEnabledColumn = (ImGuiTableColumnIdx)column_n;
 788:         else
 789:             table->LeftMostEnabledColumn = (ImGuiTableColumnIdx)column_n;
 790:         column->IndexWithinEnabledSet = table->ColumnsEnabledCount++;
 791:         ImBitArraySetBit(table->EnabledMaskByIndex, column_n);
 792:         ImBitArraySetBit(table->EnabledMaskByDisplayOrder, column->DisplayOrder);
 793:         prev_visible_column_idx = column_n;
 794:         IM_ASSERT(column->IndexWithinEnabledSet <= column->DisplayOrder);
 795:         // Calculate ideal/auto column width (that's the width required for all contents to be visible without clipping)
 796:         // Combine width from regular rows + width from headers unless requested not to.
 797:         if (!column->IsPreserveWidthAuto && table->InstanceCurrent == 0)
 798:             column->WidthAuto = TableGetColumnWidthAuto(table, column);
 799:         // Non-resizable columns keep their requested width (apply user value regardless of IsPreserveWidthAuto)
 800:         const bool column_is_resizable = (column->Flags & ImGuiTableColumnFlags_NoResize) == 0;
 801:         if (column_is_resizable)
 802:             has_resizable = true;
 803:         if ((column->Flags & ImGuiTableColumnFlags_WidthFixed) && column->InitStretchWeightOrWidth > 0.0f && !column_is_resizable)
 804:             column->WidthAuto = column->InitStretchWeightOrWidth;
 805:         if (column->AutoFitQueue != 0x00)
 806:             has_auto_fit_request = true;
 807:         if (column->Flags & ImGuiTableColumnFlags_WidthStretch)
 808:         {
 809:             stretch_sum_width_auto += column->WidthAuto;
 810:             count_stretch++;
 811:         }
 812:         else
 813:         {
 814:             fixed_max_width_auto = ImMax(fixed_max_width_auto, column->WidthAuto);
 815:             count_fixed++;
 816:         }
 817:     }
 818:     if ((table->Flags & ImGuiTableFlags_Sortable) && table->SortSpecsCount == 0 && !(table->Flags & ImGuiTableFlags_SortTristate))
 819:         table->IsSortSpecsDirty = true;
 820:     table->RightMostEnabledColumn = (ImGuiTableColumnIdx)prev_visible_column_idx;
 821:     IM_ASSERT(table->LeftMostEnabledColumn >= 0 && table->RightMostEnabledColumn >= 0);
 822:     // [Part 2] Disable child window clipping while fitting columns. This is not strictly necessary but makes it possible to avoid
 823:     // the column fitting having to wait until the first visible frame of the child container (may or not be a good thing). Also see #6510.
 824:     // FIXME-TABLE: for always auto-resizing columns may not want to do that all the time.
 825:     if (has_auto_fit_request && table->OuterWindow != table->InnerWindow)
 826:         table->InnerWindow->SkipItems = false;
 827:     if (has_auto_fit_request)
 828:         table->IsSettingsDirty = true;
 829:     // [Part 3] Fix column flags and record a few extra information.
 830:     float sum_width_requests = 0.0f;    // Sum of all width for fixed and auto-resize columns, excluding width contributed by Stretch columns but including spacing/padding.
 831:     float stretch_sum_weights = 0.0f;   // Sum of all weights for stretch columns.
 832:     table->LeftMostStretchedColumn = table->RightMostStretchedColumn = -1;
 833:     for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
 834:     {
 835:         if (!IM_BITARRAY_TESTBIT(table->EnabledMaskByIndex, column_n))
 836:             continue;
 837:         ImGuiTableColumn* column = &table->Columns[column_n];
 838:         const bool column_is_resizable = (column->Flags & ImGuiTableColumnFlags_NoResize) == 0;
 839:         if (column->Flags & ImGuiTableColumnFlags_WidthFixed)
 840:         {
 841:             // Apply same widths policy
 842:             float width_auto = column->WidthAuto;
 843:             if (table_sizing_policy == ImGuiTableFlags_SizingFixedSame && (column->AutoFitQueue != 0x00 || !column_is_resizable))
 844:                 width_auto = fixed_max_width_auto;
 845:             // Apply automatic width
 846:             // Latch initial size for fixed columns and update it constantly for auto-resizing column (unless clipped!)
 847:             if (column->AutoFitQueue != 0x00)
 848:                 column->WidthRequest = width_auto;
 849:             else if ((column->Flags & ImGuiTableColumnFlags_WidthFixed) && !column_is_resizable && column->IsRequestOutput)
 850:                 column->WidthRequest = width_auto;
 851:             // FIXME-TABLE: Increase minimum size during init frame to avoid biasing auto-fitting widgets
 852:             // (e.g. TextWrapped) too much. Otherwise what tends to happen is that TextWrapped would output a very
 853:             // large height (= first frame scrollbar display very off + clipper would skip lots of items).
 854:             // This is merely making the side-effect less extreme, but doesn't properly fixes it.
 855:             // FIXME: Move this to ->WidthGiven to avoid temporary lossyness?
 856:             // FIXME: This break IsPreserveWidthAuto from not flickering if the stored WidthAuto was smaller.
 857:             if (column->AutoFitQueue > 0x01 && table->IsInitializing && !column->IsPreserveWidthAuto)
 858:                 column->WidthRequest = ImMax(column->WidthRequest, table->MinColumnWidth * 4.0f); // FIXME-TABLE: Another constant/scale?
 859:             sum_width_requests += column->WidthRequest;
 860:         }
 861:         else
 862:         {
 863:             // Initialize stretch weight
 864:             if (column->AutoFitQueue != 0x00 || column->StretchWeight < 0.0f || !column_is_resizable)
 865:             {
 866:                 if (column->InitStretchWeightOrWidth > 0.0f)
 867:                     column->StretchWeight = column->InitStretchWeightOrWidth;
 868:                 else if (table_sizing_policy == ImGuiTableFlags_SizingStretchProp)
 869:                     column->StretchWeight = (column->WidthAuto / stretch_sum_width_auto) * count_stretch;
 870:                 else
 871:                     column->StretchWeight = 1.0f;
 872:             }
 873:             stretch_sum_weights += column->StretchWeight;
 874:             if (table->LeftMostStretchedColumn == -1 || table->Columns[table->LeftMostStretchedColumn].DisplayOrder > column->DisplayOrder)
 875:                 table->LeftMostStretchedColumn = (ImGuiTableColumnIdx)column_n;
 876:             if (table->RightMostStretchedColumn == -1 || table->Columns[table->RightMostStretchedColumn].DisplayOrder < column->DisplayOrder)
 877:                 table->RightMostStretchedColumn = (ImGuiTableColumnIdx)column_n;
 878:         }
 879:         column->IsPreserveWidthAuto = false;
 880:         sum_width_requests += table->CellPaddingX * 2.0f;
 881:     }
 882:     table->ColumnsEnabledFixedCount = (ImGuiTableColumnIdx)count_fixed;
 883:     table->ColumnsStretchSumWeights = stretch_sum_weights;
 884:     // [Part 4] Apply final widths based on requested widths
 885:     const ImRect work_rect = table->WorkRect;
 886:     const float width_spacings = (table->OuterPaddingX * 2.0f) + (table->CellSpacingX1 + table->CellSpacingX2) * (table->ColumnsEnabledCount - 1);
 887:     const float width_removed = (table->HasScrollbarYPrev && !table->InnerWindow->ScrollbarY) ? g.Style.ScrollbarSize : 0.0f; // To synchronize decoration width of synced tables with mismatching scrollbar state (#5920)
 888:     const float width_avail = ImMax(1.0f, (((table->Flags & ImGuiTableFlags_ScrollX) && table->InnerWidth == 0.0f) ? table->InnerClipRect.GetWidth() : work_rect.GetWidth()) - width_removed);
 889:     const float width_avail_for_stretched_columns = width_avail - width_spacings - sum_width_requests;
 890:     float width_remaining_for_stretched_columns = width_avail_for_stretched_columns;
 891:     table->ColumnsGivenWidth = width_spacings + (table->CellPaddingX * 2.0f) * table->ColumnsEnabledCount;
 892:     for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
 893:     {
 894:         if (!IM_BITARRAY_TESTBIT(table->EnabledMaskByIndex, column_n))
 895:             continue;
 896:         ImGuiTableColumn* column = &table->Columns[column_n];
 897:         // Allocate width for stretched/weighted columns (StretchWeight gets converted into WidthRequest)
 898:         if (column->Flags & ImGuiTableColumnFlags_WidthStretch)
 899:         {
 900:             float weight_ratio = column->StretchWeight / stretch_sum_weights;
 901:             column->WidthRequest = IM_TRUNC(ImMax(width_avail_for_stretched_columns * weight_ratio, table->MinColumnWidth) + 0.01f);
 902:             width_remaining_for_stretched_columns -= column->WidthRequest;
 903:         }
 904:         // [Resize Rule 1] The right-most Visible column is not resizable if there is at least one Stretch column
 905:         // See additional comments in TableSetColumnWidth().
 906:         if (column->NextEnabledColumn == -1 && table->LeftMostStretchedColumn != -1)
 907:             column->Flags |= ImGuiTableColumnFlags_NoDirectResize_;
 908:         // Assign final width, record width in case we will need to shrink
 909:         column->WidthGiven = ImTrunc(ImMax(column->WidthRequest, table->MinColumnWidth));
 910:         table->ColumnsGivenWidth += column->WidthGiven;
 911:     }
 912:     // [Part 5] Redistribute stretch remainder width due to rounding (remainder width is < 1.0f * number of Stretch column).
 913:     // Using right-to-left distribution (more likely to match resizing cursor).
 914:     if (width_remaining_for_stretched_columns >= 1.0f && !(table->Flags & ImGuiTableFlags_PreciseWidths))
 915:         for (int order_n = table->ColumnsCount - 1; stretch_sum_weights > 0.0f && width_remaining_for_stretched_columns >= 1.0f && order_n >= 0; order_n--)
 916:         {
 917:             if (!IM_BITARRAY_TESTBIT(table->EnabledMaskByDisplayOrder, order_n))
 918:                 continue;
 919:             ImGuiTableColumn* column = &table->Columns[table->DisplayOrderToIndex[order_n]];
 920:             if (!(column->Flags & ImGuiTableColumnFlags_WidthStretch))
 921:                 continue;
 922:             column->WidthRequest += 1.0f;
 923:             column->WidthGiven += 1.0f;
 924:             width_remaining_for_stretched_columns -= 1.0f;
 925:         }
 926:     // Determine if table is hovered which will be used to flag columns as hovered.
 927:     // - In principle we'd like to use the equivalent of IsItemHovered(ImGuiHoveredFlags_AllowWhenBlockedByActiveItem),
