4020: void ImGui::EndColumns()
4021: {
4022:     ImGuiContext& g = *GImGui;
4023:     ImGuiWindow* window = GetCurrentWindow();
4024:     ImGuiOldColumns* columns = window->DC.CurrentColumns;
4025:     IM_ASSERT(columns != NULL);
4026:     PopItemWidth();
4027:     if (columns->Count > 1)
4028:     {
4029:         PopClipRect();
4030:         columns->Splitter.Merge(window->DrawList);
4031:     }
4032:     const ImGuiOldColumnFlags flags = columns->Flags;
4033:     columns->LineMaxY = ImMax(columns->LineMaxY, window->DC.CursorPos.y);
4034:     window->DC.CursorPos.y = columns->LineMaxY;
4035:     if (!(flags & ImGuiOldColumnFlags_GrowParentContentsSize))
4036:         window->DC.CursorMaxPos.x = columns->HostCursorMaxPosX;  // Restore cursor max pos, as columns don't grow parent
4037:     // Draw columns borders and handle resize
4038:     // The IsBeingResized flag ensure we preserve pre-resize columns width so back-and-forth are not lossy
4039:     bool is_being_resized = false;
4040:     if (!(flags & ImGuiOldColumnFlags_NoBorder) && !window->SkipItems)
4041:     {
4042:         // We clip Y boundaries CPU side because very long triangles are mishandled by some GPU drivers.
4043:         const float y1 = ImMax(columns->HostCursorPosY, window->ClipRect.Min.y);
4044:         const float y2 = ImMin(window->DC.CursorPos.y, window->ClipRect.Max.y);
4045:         int dragging_column = -1;
4046:         for (int n = 1; n < columns->Count; n++)
4047:         {
4048:             ImGuiOldColumnData* column = &columns->Columns[n];
4049:             float x = window->Pos.x + GetColumnOffset(n);
4050:             const ImGuiID column_id = columns->ID + ImGuiID(n);
4051:             const float column_hit_hw = ImTrunc(COLUMNS_HIT_RECT_HALF_THICKNESS * g.CurrentDpiScale);
4052:             const ImRect column_hit_rect(ImVec2(x - column_hit_hw, y1), ImVec2(x + column_hit_hw, y2));
4053:             if (!ItemAdd(column_hit_rect, column_id, NULL, ImGuiItemFlags_NoNav))
4054:                 continue;
4055:             bool hovered = false, held = false;
4056:             if (!(flags & ImGuiOldColumnFlags_NoResize))
4057:             {
4058:                 ButtonBehavior(column_hit_rect, column_id, &hovered, &held);
4059:                 if (hovered || held)
4060:                     SetMouseCursor(ImGuiMouseCursor_ResizeEW);
4061:                 if (held && !(column->Flags & ImGuiOldColumnFlags_NoResize))
4062:                     dragging_column = n;
4063:             }
4064:             // Draw column
4065:             const ImU32 col = GetColorU32(held ? ImGuiCol_SeparatorActive : hovered ? ImGuiCol_SeparatorHovered : ImGuiCol_Separator);
4066:             const float xi = IM_TRUNC(x);
4067:             window->DrawList->AddLine(ImVec2(xi, y1 + 1.0f), ImVec2(xi, y2), col);
4068:         }
4069:         // Apply dragging after drawing the column lines, so our rendered lines are in sync with how items were displayed during the frame.
4070:         if (dragging_column != -1)
4071:         {
4072:             if (!columns->IsBeingResized)
4073:                 for (int n = 0; n < columns->Count + 1; n++)
4074:                     columns->Columns[n].OffsetNormBeforeResize = columns->Columns[n].OffsetNorm;
4075:             columns->IsBeingResized = is_being_resized = true;
4076:             float x = GetDraggedColumnOffset(columns, dragging_column);
4077:             SetColumnOffset(dragging_column, x);
4078:         }
4079:     }
4080:     columns->IsBeingResized = is_being_resized;
4081:     window->WorkRect = window->ParentWorkRect;
4082:     window->ParentWorkRect = columns->HostBackupParentWorkRect;
4083:     window->DC.CurrentColumns = NULL;
4084:     window->DC.ColumnsOffset.x = 0.0f;
4085:     window->DC.CursorPos.x = IM_TRUNC(window->Pos.x + window->DC.Indent.x + window->DC.ColumnsOffset.x);
4086:     NavUpdateCurrentWindowIsScrollPushableX();
4087: }
4088: void ImGui::Columns(int columns_count, const char* id, bool borders)
4089: {
4090:     ImGuiWindow* window = GetCurrentWindow();
4091:     IM_ASSERT(columns_count >= 1);
4092:     ImGuiOldColumnFlags flags = (borders ? 0 : ImGuiOldColumnFlags_NoBorder);
4093:     //flags |= ImGuiOldColumnFlags_NoPreserveWidths; // NB: Legacy behavior
4094:     ImGuiOldColumns* columns = window->DC.CurrentColumns;
4095:     if (columns != NULL && columns->Count == columns_count && columns->Flags == flags)
4096:         return;
4097:     if (columns != NULL)
4098:         EndColumns();
4099:     if (columns_count != 1)
4100:         BeginColumns(id, columns_count, flags);
4101: }
