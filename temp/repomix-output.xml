 959: // - We intentionally avoid using ImVec2 and its math operators here to reduce cost to a minimum for debug/non-inlined builds.
 960: // - Filled shapes must always use clockwise winding order. The anti-aliasing fringe depends on it. Counter-clockwise shapes will have "inward" anti-aliasing.
 961: void ImDrawList::AddConvexPolyFilled(const ImVec2* points, const int points_count, ImU32 col)
 962: {
 963:     if (points_count < 3 || (col & IM_COL32_A_MASK) == 0)
 964:         return;
 965:     const ImVec2 uv = _Data->TexUvWhitePixel;
 966:     if (Flags & ImDrawListFlags_AntiAliasedFill)
 967:     {
 968:         // Anti-aliased Fill
 969:         const float AA_SIZE = _FringeScale;
 970:         const ImU32 col_trans = col & ~IM_COL32_A_MASK;
 971:         const int idx_count = (points_count - 2)*3 + points_count * 6;
 972:         const int vtx_count = (points_count * 2);
 973:         PrimReserve(idx_count, vtx_count);
 974:         // Add indexes for fill
 975:         unsigned int vtx_inner_idx = _VtxCurrentIdx;
 976:         unsigned int vtx_outer_idx = _VtxCurrentIdx + 1;
 977:         for (int i = 2; i < points_count; i++)
 978:         {
 979:             _IdxWritePtr[0] = (ImDrawIdx)(vtx_inner_idx); _IdxWritePtr[1] = (ImDrawIdx)(vtx_inner_idx + ((i - 1) << 1)); _IdxWritePtr[2] = (ImDrawIdx)(vtx_inner_idx + (i << 1));
 980:             _IdxWritePtr += 3;
 981:         }
 982:         // Compute normals
 983:         _Data->TempBuffer.reserve_discard(points_count);
 984:         ImVec2* temp_normals = _Data->TempBuffer.Data;
 985:         for (int i0 = points_count - 1, i1 = 0; i1 < points_count; i0 = i1++)
 986:         {
 987:             const ImVec2& p0 = points[i0];
 988:             const ImVec2& p1 = points[i1];
 989:             float dx = p1.x - p0.x;
 990:             float dy = p1.y - p0.y;
 991:             IM_NORMALIZE2F_OVER_ZERO(dx, dy);
 992:             temp_normals[i0].x = dy;
 993:             temp_normals[i0].y = -dx;
 994:         }
 995:         for (int i0 = points_count - 1, i1 = 0; i1 < points_count; i0 = i1++)
 996:         {
 997:             // Average normals
 998:             const ImVec2& n0 = temp_normals[i0];
 999:             const ImVec2& n1 = temp_normals[i1];
1000:             float dm_x = (n0.x + n1.x) * 0.5f;
1001:             float dm_y = (n0.y + n1.y) * 0.5f;
1002:             IM_FIXNORMAL2F(dm_x, dm_y);
1003:             dm_x *= AA_SIZE * 0.5f;
1004:             dm_y *= AA_SIZE * 0.5f;
1005:             // Add vertices
1006:             _VtxWritePtr[0].pos.x = (points[i1].x - dm_x); _VtxWritePtr[0].pos.y = (points[i1].y - dm_y); _VtxWritePtr[0].uv = uv; _VtxWritePtr[0].col = col;        // Inner
1007:             _VtxWritePtr[1].pos.x = (points[i1].x + dm_x); _VtxWritePtr[1].pos.y = (points[i1].y + dm_y); _VtxWritePtr[1].uv = uv; _VtxWritePtr[1].col = col_trans;  // Outer
1008:             _VtxWritePtr += 2;
1009:             // Add indexes for fringes
1010:             _IdxWritePtr[0] = (ImDrawIdx)(vtx_inner_idx + (i1 << 1)); _IdxWritePtr[1] = (ImDrawIdx)(vtx_inner_idx + (i0 << 1)); _IdxWritePtr[2] = (ImDrawIdx)(vtx_outer_idx + (i0 << 1));
1011:             _IdxWritePtr[3] = (ImDrawIdx)(vtx_outer_idx + (i0 << 1)); _IdxWritePtr[4] = (ImDrawIdx)(vtx_outer_idx + (i1 << 1)); _IdxWritePtr[5] = (ImDrawIdx)(vtx_inner_idx + (i1 << 1));
1012:             _IdxWritePtr += 6;
1013:         }
1014:         _VtxCurrentIdx += (ImDrawIdx)vtx_count;
1015:     }
1016:     else
1017:     {
1018:         // Non Anti-aliased Fill
1019:         const int idx_count = (points_count - 2)*3;
1020:         const int vtx_count = points_count;
1021:         PrimReserve(idx_count, vtx_count);
1022:         for (int i = 0; i < vtx_count; i++)
1023:         {
1024:             _VtxWritePtr[0].pos = points[i]; _VtxWritePtr[0].uv = uv; _VtxWritePtr[0].col = col;
1025:             _VtxWritePtr++;
1026:         }
1027:         for (int i = 2; i < points_count; i++)
1028:         {
1029:             _IdxWritePtr[0] = (ImDrawIdx)(_VtxCurrentIdx); _IdxWritePtr[1] = (ImDrawIdx)(_VtxCurrentIdx + i - 1); _IdxWritePtr[2] = (ImDrawIdx)(_VtxCurrentIdx + i);
1030:             _IdxWritePtr += 3;
1031:         }
1032:         _VtxCurrentIdx += (ImDrawIdx)vtx_count;
1033:     }
1034: }
1035: void ImDrawList::_PathArcToFastEx(const ImVec2& center, float radius, int a_min_sample, int a_max_sample, int a_step)
1036: {
1037:     if (radius < 0.5f)
1038:     {
1039:         _Path.push_back(center);
1040:         return;
1041:     }
1042:     // Calculate arc auto segment step size
1043:     if (a_step <= 0)
1044:         a_step = IM_DRAWLIST_ARCFAST_SAMPLE_MAX / _CalcCircleAutoSegmentCount(radius);
1045:     // Make sure we never do steps larger than one quarter of the circle
1046:     a_step = ImClamp(a_step, 1, IM_DRAWLIST_ARCFAST_TABLE_SIZE / 4);
1047:     const int sample_range = ImAbs(a_max_sample - a_min_sample);
1048:     const int a_next_step = a_step;
1049:     int samples = sample_range + 1;
1050:     bool extra_max_sample = false;
1051:     if (a_step > 1)
1052:     {
1053:         samples            = sample_range / a_step + 1;
1054:         const int overstep = sample_range % a_step;
1055:         if (overstep > 0)
1056:         {
1057:             extra_max_sample = true;
1058:             samples++;
1059:             // When we have overstep to avoid awkwardly looking one long line and one tiny one at the end,
1060:             // distribute first step range evenly between them by reducing first step size.
1061:             if (sample_range > 0)
1062:                 a_step -= (a_step - overstep) / 2;
1063:         }
1064:     }
1065:     _Path.resize(_Path.Size + samples);
1066:     ImVec2* out_ptr = _Path.Data + (_Path.Size - samples);
1067:     int sample_index = a_min_sample;
1068:     if (sample_index < 0 || sample_index >= IM_DRAWLIST_ARCFAST_SAMPLE_MAX)
1069:     {
1070:         sample_index = sample_index % IM_DRAWLIST_ARCFAST_SAMPLE_MAX;
1071:         if (sample_index < 0)
1072:             sample_index += IM_DRAWLIST_ARCFAST_SAMPLE_MAX;
1073:     }
1074:     if (a_max_sample >= a_min_sample)
1075:     {
1076:         for (int a = a_min_sample; a <= a_max_sample; a += a_step, sample_index += a_step, a_step = a_next_step)
1077:         {
1078:             // a_step is clamped to IM_DRAWLIST_ARCFAST_SAMPLE_MAX, so we have guaranteed that it will not wrap over range twice or more
1079:             if (sample_index >= IM_DRAWLIST_ARCFAST_SAMPLE_MAX)
1080:                 sample_index -= IM_DRAWLIST_ARCFAST_SAMPLE_MAX;
1081:             const ImVec2 s = _Data->ArcFastVtx[sample_index];
1082:             out_ptr->x = center.x + s.x * radius;
1083:             out_ptr->y = center.y + s.y * radius;
1084:             out_ptr++;
1085:         }
1086:     }
1087:     else
1088:     {
1089:         for (int a = a_min_sample; a >= a_max_sample; a -= a_step, sample_index -= a_step, a_step = a_next_step)
1090:         {
1091:             // a_step is clamped to IM_DRAWLIST_ARCFAST_SAMPLE_MAX, so we have guaranteed that it will not wrap over range twice or more
1092:             if (sample_index < 0)
1093:                 sample_index += IM_DRAWLIST_ARCFAST_SAMPLE_MAX;
1094:             const ImVec2 s = _Data->ArcFastVtx[sample_index];
1095:             out_ptr->x = center.x + s.x * radius;
1096:             out_ptr->y = center.y + s.y * radius;
1097:             out_ptr++;
1098:         }
1099:     }
1100:     if (extra_max_sample)
1101:     {
1102:         int normalized_max_sample = a_max_sample % IM_DRAWLIST_ARCFAST_SAMPLE_MAX;
1103:         if (normalized_max_sample < 0)
1104:             normalized_max_sample += IM_DRAWLIST_ARCFAST_SAMPLE_MAX;
1105:         const ImVec2 s = _Data->ArcFastVtx[normalized_max_sample];
1106:         out_ptr->x = center.x + s.x * radius;
1107:         out_ptr->y = center.y + s.y * radius;
1108:         out_ptr++;
1109:     }
1110:     IM_ASSERT_PARANOID(_Path.Data + _Path.Size == out_ptr);
1111: }
1112: void ImDrawList::_PathArcToN(const ImVec2& center, float radius, float a_min, float a_max, int num_segments)
1113: {
1114:     if (radius < 0.5f)
1115:     {
1116:         _Path.push_back(center);
1117:         return;
1118:     }
1119:     // Note that we are adding a point at both a_min and a_max.
1120:     // If you are trying to draw a full closed circle you don't want the overlapping points!
1121:     _Path.reserve(_Path.Size + (num_segments + 1));
1122:     for (int i = 0; i <= num_segments; i++)
1123:     {
1124:         const float a = a_min + ((float)i / (float)num_segments) * (a_max - a_min);
1125:         _Path.push_back(ImVec2(center.x + ImCos(a) * radius, center.y + ImSin(a) * radius));
1126:     }
1127: }
1128: // 0: East, 3: South, 6: West, 9: North, 12: East
1129: void ImDrawList::PathArcToFast(const ImVec2& center, float radius, int a_min_of_12, int a_max_of_12)
1130: {
1131:     if (radius < 0.5f)
1132:     {
1133:         _Path.push_back(center);
1134:         return;
1135:     }
1136:     _PathArcToFastEx(center, radius, a_min_of_12 * IM_DRAWLIST_ARCFAST_SAMPLE_MAX / 12, a_max_of_12 * IM_DRAWLIST_ARCFAST_SAMPLE_MAX / 12, 0);
1137: }
1138: void ImDrawList::PathArcTo(const ImVec2& center, float radius, float a_min, float a_max, int num_segments)
1139: {
1140:     if (radius < 0.5f)
1141:     {
1142:         _Path.push_back(center);
1143:         return;
1144:     }
1145:     if (num_segments > 0)
1146:     {
1147:         _PathArcToN(center, radius, a_min, a_max, num_segments);
1148:         return;
1149:     }
1150:     // Automatic segment count
1151:     if (radius <= _Data->ArcFastRadiusCutoff)
1152:     {
1153:         const bool a_is_reverse = a_max < a_min;
1154:         // We are going to use precomputed values for mid samples.
1155:         // Determine first and last sample in lookup table that belong to the arc.
1156:         const float a_min_sample_f = IM_DRAWLIST_ARCFAST_SAMPLE_MAX * a_min / (IM_PI * 2.0f);
1157:         const float a_max_sample_f = IM_DRAWLIST_ARCFAST_SAMPLE_MAX * a_max / (IM_PI * 2.0f);
1158:         const int a_min_sample = a_is_reverse ? (int)ImFloor(a_min_sample_f) : (int)ImCeil(a_min_sample_f);
1159:         const int a_max_sample = a_is_reverse ? (int)ImCeil(a_max_sample_f) : (int)ImFloor(a_max_sample_f);
1160:         const int a_mid_samples = a_is_reverse ? ImMax(a_min_sample - a_max_sample, 0) : ImMax(a_max_sample - a_min_sample, 0);
1161:         const float a_min_segment_angle = a_min_sample * IM_PI * 2.0f / IM_DRAWLIST_ARCFAST_SAMPLE_MAX;
1162:         const float a_max_segment_angle = a_max_sample * IM_PI * 2.0f / IM_DRAWLIST_ARCFAST_SAMPLE_MAX;
1163:         const bool a_emit_start = ImAbs(a_min_segment_angle - a_min) >= 1e-5f;
1164:         const bool a_emit_end = ImAbs(a_max - a_max_segment_angle) >= 1e-5f;
1165:         _Path.reserve(_Path.Size + (a_mid_samples + 1 + (a_emit_start ? 1 : 0) + (a_emit_end ? 1 : 0)));
1166:         if (a_emit_start)
1167:             _Path.push_back(ImVec2(center.x + ImCos(a_min) * radius, center.y + ImSin(a_min) * radius));
1168:         if (a_mid_samples > 0)
1169:             _PathArcToFastEx(center, radius, a_min_sample, a_max_sample, 0);
1170:         if (a_emit_end)
1171:             _Path.push_back(ImVec2(center.x + ImCos(a_max) * radius, center.y + ImSin(a_max) * radius));
1172:     }
1173:     else
1174:     {
1175:         const float arc_length = ImAbs(a_max - a_min);
1176:         const int circle_segment_count = _CalcCircleAutoSegmentCount(radius);
1177:         const int arc_segment_count = ImMax((int)ImCeil(circle_segment_count * arc_length / (IM_PI * 2.0f)), (int)(2.0f * IM_PI / arc_length));
1178:         _PathArcToN(center, radius, a_min, a_max, arc_segment_count);
1179:     }
1180: }
1181: void ImDrawList::PathEllipticalArcTo(const ImVec2& center, const ImVec2& radius, float rot, float a_min, float a_max, int num_segments)
1182: {
1183:     if (num_segments <= 0)
1184:         num_segments = _CalcCircleAutoSegmentCount(ImMax(radius.x, radius.y)); // A bit pessimistic, maybe there's a better computation to do here.
1185:     _Path.reserve(_Path.Size + (num_segments + 1));
1186:     const float cos_rot = ImCos(rot);
1187:     const float sin_rot = ImSin(rot);
1188:     for (int i = 0; i <= num_segments; i++)
1189:     {
1190:         const float a = a_min + ((float)i / (float)num_segments) * (a_max - a_min);
1191:         ImVec2 point(ImCos(a) * radius.x, ImSin(a) * radius.y);
1192:         const ImVec2 rel((point.x * cos_rot) - (point.y * sin_rot), (point.x * sin_rot) + (point.y * cos_rot));
1193:         point.x = rel.x + center.x;
1194:         point.y = rel.y + center.y;
1195:         _Path.push_back(point);
1196:     }
1197: }
1198: ImVec2 ImBezierCubicCalc(const ImVec2& p1, const ImVec2& p2, const ImVec2& p3, const ImVec2& p4, float t)
1199: {
1200:     float u = 1.0f - t;
1201:     float w1 = u * u * u;
1202:     float w2 = 3 * u * u * t;
1203:     float w3 = 3 * u * t * t;
1204:     float w4 = t * t * t;
1205:     return ImVec2(w1 * p1.x + w2 * p2.x + w3 * p3.x + w4 * p4.x, w1 * p1.y + w2 * p2.y + w3 * p3.y + w4 * p4.y);
1206: }
1207: ImVec2 ImBezierQuadraticCalc(const ImVec2& p1, const ImVec2& p2, const ImVec2& p3, float t)
1208: {
1209:     float u = 1.0f - t;
1210:     float w1 = u * u;
1211:     float w2 = 2 * u * t;
1212:     float w3 = t * t;
1213:     return ImVec2(w1 * p1.x + w2 * p2.x + w3 * p3.x, w1 * p1.y + w2 * p2.y + w3 * p3.y);
1214: }
1215: // Closely mimics ImBezierCubicClosestPointCasteljau() in imgui.cpp
1216: static void PathBezierCubicCurveToCasteljau(ImVector<ImVec2>* path, float x1, float y1, float x2, float y2, float x3, float y3, float x4, float y4, float tess_tol, int level)
1217: {
1218:     float dx = x4 - x1;
1219:     float dy = y4 - y1;
1220:     float d2 = (x2 - x4) * dy - (y2 - y4) * dx;
1221:     float d3 = (x3 - x4) * dy - (y3 - y4) * dx;
1222:     d2 = (d2 >= 0) ? d2 : -d2;
1223:     d3 = (d3 >= 0) ? d3 : -d3;
1224:     if ((d2 + d3) * (d2 + d3) < tess_tol * (dx * dx + dy * dy))
1225:     {
1226:         path->push_back(ImVec2(x4, y4));
1227:     }
1228:     else if (level < 10)
1229:     {
1230:         float x12 = (x1 + x2) * 0.5f, y12 = (y1 + y2) * 0.5f;
1231:         float x23 = (x2 + x3) * 0.5f, y23 = (y2 + y3) * 0.5f;
1232:         float x34 = (x3 + x4) * 0.5f, y34 = (y3 + y4) * 0.5f;
1233:         float x123 = (x12 + x23) * 0.5f, y123 = (y12 + y23) * 0.5f;
1234:         float x234 = (x23 + x34) * 0.5f, y234 = (y23 + y34) * 0.5f;
1235:         float x1234 = (x123 + x234) * 0.5f, y1234 = (y123 + y234) * 0.5f;
1236:         PathBezierCubicCurveToCasteljau(path, x1, y1, x12, y12, x123, y123, x1234, y1234, tess_tol, level + 1);
1237:         PathBezierCubicCurveToCasteljau(path, x1234, y1234, x234, y234, x34, y34, x4, y4, tess_tol, level + 1);
1238:     }
1239: }
1240: static void PathBezierQuadraticCurveToCasteljau(ImVector<ImVec2>* path, float x1, float y1, float x2, float y2, float x3, float y3, float tess_tol, int level)
1241: {
1242:     float dx = x3 - x1, dy = y3 - y1;
1243:     float det = (x2 - x3) * dy - (y2 - y3) * dx;
1244:     if (det * det * 4.0f < tess_tol * (dx * dx + dy * dy))
1245:     {
1246:         path->push_back(ImVec2(x3, y3));
1247:     }
1248:     else if (level < 10)
1249:     {
1250:         float x12 = (x1 + x2) * 0.5f, y12 = (y1 + y2) * 0.5f;
1251:         float x23 = (x2 + x3) * 0.5f, y23 = (y2 + y3) * 0.5f;
1252:         float x123 = (x12 + x23) * 0.5f, y123 = (y12 + y23) * 0.5f;
