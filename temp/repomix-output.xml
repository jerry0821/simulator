 1: #pragma once
 2: #include <DirectXMath.h>	
 3: class EasingCube
 4: {
 5: private:
 6: 	double m_AccumulatedTime{};
 7: 	double m_Duration = {};
 8: 	DirectX::XMFLOAT3 m_StartPosition{};
 9: 	DirectX::XMFLOAT3 m_EndPosition{};
10: 	bool m_IsStart = false;
11: private:
12: 	double easeOutCubic(double t) const
13: 	{
14: 		t -= 1.0;
15: 		return t * t * t + 1.0;
16: 	}
17: public:
18: 	EasingCube(const DirectX::XMFLOAT3& start,const DirectX::XMFLOAT3& end, double time)
19: 		:m_StartPosition(start),m_EndPosition(end), m_Duration(time)
20: 	{
21: 	}
22: 	void Start() { m_IsStart = true; }
23: 	void Update(double elapsed_time);
24: 	void Draw() const;
25: };
