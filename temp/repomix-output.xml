13587:         return;
13588:     LogText(IM_NEWLINE);
13589:     switch (g.LogFlags & ImGuiLogFlags_OutputMask_)
13590:     {
13591:     case ImGuiLogFlags_OutputTTY:
13592: #ifndef IMGUI_DISABLE_TTY_FUNCTIONS
13593:         fflush(g.LogFile);
