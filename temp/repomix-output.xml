 84: 	case WM_RBUTTONUP:
 85: 	case WM_MBUTTONDOWN:
 86: 	case WM_MBUTTONUP:
 87: 	case WM_MOUSEWHEEL:
 88: 	case WM_XBUTTONDOWN:
 89: 	case WM_XBUTTONUP:
 90: 	case WM_MOUSEHOVER:
 91: 	    Mouse_ProcessMessage(message, wParam, lParam);
 92: 	    break;
 93: 	case WM_KEYDOWN:
 94: 		if (wParam == VK_ESCAPE)
 95: 		{
 96: 			SendMessage(hWnd, WM_CLOSE, 0, 0);
 97: 		}
 98: 	case WM_SYSKEYDOWN:
 99: 	case WM_KEYUP:
100: 	case WM_SYSKEYUP:
101: 	    Keyboard_ProcessMessage(message, wParam, lParam);
102: 	    break;
103: 	case WM_CLOSE:
104: 		if (MessageBox(hWnd, "本当に終了してよろしいですか？", "確認", MB_YESNO | MB_DEFBUTTON2) == IDYES)
105: 		{
106: 			DestroyWindow(hWnd);
107: 		}
108: 		break;
109: 	case WM_DESTROY:
110: 		PostQuitMessage(0);
111: 		break;
112: 	default:
113: 		return DefWindowProc(hWnd, message, wParam, lParam);
114: 	}
115: 	return 0;
116: }
