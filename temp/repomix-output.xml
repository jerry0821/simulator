3881: // Return false to discard a character.
3882: static bool InputTextFilterCharacter(ImGuiContext* ctx, unsigned int* p_char, ImGuiInputTextFlags flags, ImGuiInputTextCallback callback, void* user_data, bool input_source_is_clipboard)
3883: {
3884:     unsigned int c = *p_char;
3885:     // Filter non-printable (NB: isprint is unreliable! see #2467)
3886:     bool apply_named_filters = true;
3887:     if (c < 0x20)
3888:     {
3889:         bool pass = false;
3890:         pass |= (c == '\n') && (flags & ImGuiInputTextFlags_Multiline) != 0;    // Note that an Enter KEY will emit \r and be ignored (we poll for KEY in InputText() code)
3891:         if (c == '\n' && input_source_is_clipboard && (flags & ImGuiInputTextFlags_Multiline) == 0) // In single line mode, replace \n with a space
3892:         {
3893:             c = *p_char = ' ';
3894:             pass = true;
3895:         }
3896:         pass |= (c == '\n') && (flags & ImGuiInputTextFlags_Multiline) != 0;
3897:         pass |= (c == '\t') && (flags & ImGuiInputTextFlags_AllowTabInput) != 0;
3898:         if (!pass)
3899:             return false;
3900:         apply_named_filters = false; // Override named filters below so newline and tabs can still be inserted.
3901:     }
3902:     if (input_source_is_clipboard == false)
3903:     {
3904:         // We ignore Ascii representation of delete (emitted from Backspace on OSX, see #2578, #2817)
3905:         if (c == 127)
3906:             return false;
3907:         // Filter private Unicode range. GLFW on OSX seems to send private characters for special keys like arrow keys (FIXME)
3908:         if (c >= 0xE000 && c <= 0xF8FF)
3909:             return false;
3910:     }
3911:     // Filter Unicode ranges we are not handling in this build
3912:     if (c > IM_UNICODE_CODEPOINT_MAX)
3913:         return false;
3914:     // Generic named filters
3915:     if (apply_named_filters && (flags & (ImGuiInputTextFlags_CharsDecimal | ImGuiInputTextFlags_CharsHexadecimal | ImGuiInputTextFlags_CharsUppercase | ImGuiInputTextFlags_CharsNoBlank | ImGuiInputTextFlags_CharsScientific | (ImGuiInputTextFlags)ImGuiInputTextFlags_LocalizeDecimalPoint)))
3916:     {
3917:         // The libc allows overriding locale, with e.g. 'setlocale(LC_NUMERIC, "de_DE.UTF-8");' which affect the output/input of printf/scanf to use e.g. ',' instead of '.'.
3918:         // The standard mandate that programs starts in the "C" locale where the decimal point is '.'.
3919:         // We don't really intend to provide widespread support for it, but out of empathy for people stuck with using odd API, we support the bare minimum aka overriding the decimal point.
3920:         // Change the default decimal_point with:
3921:         //   ImGui::GetPlatformIO()->Platform_LocaleDecimalPoint = *localeconv()->decimal_point;
3922:         // Users of non-default decimal point (in particular ',') may be affected by word-selection logic (is_word_boundary_from_right/is_word_boundary_from_left) functions.
3923:         ImGuiContext& g = *ctx;
3924:         const unsigned c_decimal_point = (unsigned int)g.PlatformIO.Platform_LocaleDecimalPoint;
3925:         if (flags & (ImGuiInputTextFlags_CharsDecimal | ImGuiInputTextFlags_CharsScientific | (ImGuiInputTextFlags)ImGuiInputTextFlags_LocalizeDecimalPoint))
3926:             if (c == '.' || c == ',')
3927:                 c = c_decimal_point;
3928:         // Full-width -> half-width conversion for numeric fields: https://en.wikipedia.org/wiki/Halfwidth_and_Fullwidth_Forms_(Unicode_block)
3929:         // While this is mostly convenient, this has the side-effect for uninformed users accidentally inputting full-width characters that they may
3930:         // scratch their head as to why it works in numerical fields vs in generic text fields it would require support in the font.
3931:         if (flags & (ImGuiInputTextFlags_CharsDecimal | ImGuiInputTextFlags_CharsScientific | ImGuiInputTextFlags_CharsHexadecimal))
3932:             if (c >= 0xFF01 && c <= 0xFF5E)
3933:                 c = c - 0xFF01 + 0x21;
3934:         // Allow 0-9 . - + * /
3935:         if (flags & ImGuiInputTextFlags_CharsDecimal)
3936:             if (!(c >= '0' && c <= '9') && (c != c_decimal_point) && (c != '-') && (c != '+') && (c != '*') && (c != '/'))
3937:                 return false;
3938:         // Allow 0-9 . - + * / e E
3939:         if (flags & ImGuiInputTextFlags_CharsScientific)
3940:             if (!(c >= '0' && c <= '9') && (c != c_decimal_point) && (c != '-') && (c != '+') && (c != '*') && (c != '/') && (c != 'e') && (c != 'E'))
3941:                 return false;
3942:         // Allow 0-9 a-F A-F
3943:         if (flags & ImGuiInputTextFlags_CharsHexadecimal)
3944:             if (!(c >= '0' && c <= '9') && !(c >= 'a' && c <= 'f') && !(c >= 'A' && c <= 'F'))
3945:                 return false;
3946:         // Turn a-z into A-Z
3947:         if (flags & ImGuiInputTextFlags_CharsUppercase)
3948:             if (c >= 'a' && c <= 'z')
3949:                 c += (unsigned int)('A' - 'a');
3950:         if (flags & ImGuiInputTextFlags_CharsNoBlank)
3951:             if (ImCharIsBlankW(c))
3952:                 return false;
3953:         *p_char = c;
3954:     }
3955:     // Custom callback filter
3956:     if (flags & ImGuiInputTextFlags_CallbackCharFilter)
3957:     {
3958:         ImGuiContext& g = *GImGui;
3959:         ImGuiInputTextCallbackData callback_data;
3960:         callback_data.Ctx = &g;
3961:         callback_data.EventFlag = ImGuiInputTextFlags_CallbackCharFilter;
3962:         callback_data.EventChar = (ImWchar)c;
3963:         callback_data.Flags = flags;
3964:         callback_data.UserData = user_data;
3965:         if (callback(&callback_data) != 0)
3966:             return false;
3967:         *p_char = callback_data.EventChar;
3968:         if (!callback_data.EventChar)
3969:             return false;
3970:     }
3971:     return true;
3972: }
3973: // Find the shortest single replacement we can make to get from old_buf to new_buf
3974: // Note that this doesn't directly alter state->TextA, state->TextLen. They are expected to be made valid separately.
3975: // FIXME: Ideally we should transition toward (1) making InsertChars()/DeleteChars() update undo-stack (2) discourage (and keep reconcile) or obsolete (and remove reconcile) accessing buffer directly.
3976: static void InputTextReconcileUndoState(ImGuiInputTextState* state, const char* old_buf, int old_length, const char* new_buf, int new_length)
3977: {
3978:     const int shorter_length = ImMin(old_length, new_length);
3979:     int first_diff;
3980:     for (first_diff = 0; first_diff < shorter_length; first_diff++)
3981:         if (old_buf[first_diff] != new_buf[first_diff])
3982:             break;
3983:     if (first_diff == old_length && first_diff == new_length)
3984:         return;
3985:     int old_last_diff = old_length   - 1;
3986:     int new_last_diff = new_length - 1;
3987:     for (; old_last_diff >= first_diff && new_last_diff >= first_diff; old_last_diff--, new_last_diff--)
3988:         if (old_buf[old_last_diff] != new_buf[new_last_diff])
3989:             break;
3990:     const int insert_len = new_last_diff - first_diff + 1;
3991:     const int delete_len = old_last_diff - first_diff + 1;
3992:     if (insert_len > 0 || delete_len > 0)
3993:         if (IMSTB_TEXTEDIT_CHARTYPE* p = stb_text_createundo(&state->Stb->undostate, first_diff, delete_len, insert_len))
3994:             for (int i = 0; i < delete_len; i++)
3995:                 p[i] = old_buf[first_diff + i];
3996: }
3997: // As InputText() retain textual data and we currently provide a path for user to not retain it (via local variables)
3998: // we need some form of hook to reapply data back to user buffer on deactivation frame. (#4714)
3999: // It would be more desirable that we discourage users from taking advantage of the "user not retaining data" trick,
4000: // but that more likely be attractive when we do have _NoLiveEdit flag available.
4001: void ImGui::InputTextDeactivateHook(ImGuiID id)
4002: {
4003:     ImGuiContext& g = *GImGui;
4004:     ImGuiInputTextState* state = &g.InputTextState;
4005:     if (id == 0 || state->ID != id)
4006:         return;
