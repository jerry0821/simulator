 9971: // Declare item bounding box for clipping and interaction.
 9972: // Note that the size can be different than the one provided to ItemSize(). Typically, widgets that spread over available surface
 9973: // declare their minimum size requirement to ItemSize() and provide a larger region to ItemAdd() which is used drawing/interaction.
 9974: // THIS IS IN THE PERFORMANCE CRITICAL PATH (UNTIL THE CLIPPING TEST AND EARLY-RETURN)
 9975: IM_MSVC_RUNTIME_CHECKS_OFF
 9976: bool ImGui::ItemAdd(const ImRect& bb, ImGuiID id, const ImRect* nav_bb_arg, ImGuiItemFlags extra_flags)
 9977: {
 9978:     ImGuiContext& g = *GImGui;
 9979:     ImGuiWindow* window = g.CurrentWindow;
 9980:     // Set item data
 9981:     // (DisplayRect is left untouched, made valid when ImGuiItemStatusFlags_HasDisplayRect is set)
 9982:     g.LastItemData.ID = id;
 9983:     g.LastItemData.Rect = bb;
 9984:     g.LastItemData.NavRect = nav_bb_arg ? *nav_bb_arg : bb;
 9985:     g.LastItemData.ItemFlags = g.CurrentItemFlags | g.NextItemData.ItemFlags | extra_flags;
 9986:     g.LastItemData.StatusFlags = ImGuiItemStatusFlags_None;
 9987:     // Note: we don't copy 'g.NextItemData.SelectionUserData' to an hypothetical g.LastItemData.SelectionUserData: since the former is not cleared.
 9988:     if (id != 0)
 9989:     {
 9990:         KeepAliveID(id);
 9991:         // Directional navigation processing
 9992:         // Runs prior to clipping early-out
 9993:         //  (a) So that NavInitRequest can be honored, for newly opened windows to select a default widget
 9994:         //  (b) So that we can scroll up/down past clipped items. This adds a small O(N) cost to regular navigation requests
 9995:         //      unfortunately, but it is still limited to one window. It may not scale very well for windows with ten of
 9996:         //      thousands of item, but at least NavMoveRequest is only set on user interaction, aka maximum once a frame.
 9997:         //      We could early out with "if (is_clipped && !g.NavInitRequest) return false;" but when we wouldn't be able
 9998:         //      to reach unclipped widgets. This would work if user had explicit scrolling control (e.g. mapped on a stick).
 9999:         // We intentionally don't check if g.NavWindow != NULL because g.NavAnyRequest should only be set when it is non null.
10000:         // If we crash on a NULL g.NavWindow we need to fix the bug elsewhere.
10001:         if (!(g.LastItemData.ItemFlags & ImGuiItemFlags_NoNav))
10002:         {
10003:             // FIXME-NAV: investigate changing the window tests into a simple 'if (g.NavFocusScopeId == g.CurrentFocusScopeId)' test.
10004:             window->DC.NavLayersActiveMaskNext |= (1 << window->DC.NavLayerCurrent);
10005:             if (g.NavId == id || g.NavAnyRequest)
10006:                 if (g.NavWindow->RootWindowForNav == window->RootWindowForNav)
10007:                     if (window == g.NavWindow || ((window->ChildFlags | g.NavWindow->ChildFlags) & ImGuiChildFlags_NavFlattened))
10008:                         NavProcessItem();
10009:         }
10010:         if (g.NextItemData.HasFlags & ImGuiNextItemDataFlags_HasShortcut)
10011:             ItemHandleShortcut(id);
10012:     }
10013:     // Lightweight clear of SetNextItemXXX data.
10014:     g.NextItemData.HasFlags = ImGuiNextItemDataFlags_None;
10015:     g.NextItemData.ItemFlags = ImGuiItemFlags_None;
10016: #ifdef IMGUI_ENABLE_TEST_ENGINE
10017:     if (id != 0)
10018:         IMGUI_TEST_ENGINE_ITEM_ADD(id, g.LastItemData.NavRect, &g.LastItemData);
10019: #endif
10020:     // Clipping test
10021:     // (this is an inline copy of IsClippedEx() so we can reuse the is_rect_visible value, otherwise we'd do 'if (IsClippedEx(bb, id)) return false')
10022:     // g.NavActivateId is not necessarily == g.NavId, in the case of remote activation (e.g. shortcuts)
10023:     const bool is_rect_visible = bb.Overlaps(window->ClipRect);
10024:     if (!is_rect_visible)
10025:         if (id == 0 || (id != g.ActiveId && id != g.ActiveIdPreviousFrame && id != g.NavId && id != g.NavActivateId))
10026:             if (!g.ItemUnclipByLog)
10027:                 return false;
10028:     // [DEBUG]
10029: #ifndef IMGUI_DISABLE_DEBUG_TOOLS
10030:     if (id != 0)
10031:     {
10032:         if (id == g.DebugLocateId)
10033:             DebugLocateItemResolveWithLastItem();
10034:         // [DEBUG] People keep stumbling on this problem and using "" as identifier in the root of a window instead of "##something".
10035:         // Empty identifier are valid and useful in a small amount of cases, but 99.9% of the time you want to use "##something".
10036:         // READ THE FAQ: https://dearimgui.com/faq
10037:         IM_ASSERT(id != window->ID && "Cannot have an empty ID at the root of a window. If you need an empty label, use ## and read the FAQ about how the ID Stack works!");
10038:         // [DEBUG] Highlight all conflicts WITHOUT needing to hover. THIS WILL SLOW DOWN DEAR IMGUI. DON'T KEEP ACTIVATED.
10039:         // This will only work for items submitted with ItemAdd(). Some very rare/odd/unrecommended code patterns are calling ButtonBehavior() without ItemAdd().
10040: #ifdef IMGUI_DEBUG_HIGHLIGHT_ALL_ID_CONFLICTS
10041:         if ((g.LastItemData.ItemFlags & ImGuiItemFlags_AllowDuplicateId) == 0)
10042:         {
10043:             int* p_alive = g.DebugDrawIdConflictsAliveCount.GetIntRef(id, -1); // Could halve lookups if we knew ImGuiStorage can store 64-bit, or by storing FrameCount as 30-bits + highlight as 2-bits. But the point is that we should not pretend that this is fast.
10044:             int* p_highlight = g.DebugDrawIdConflictsHighlightSet.GetIntRef(id, -1);
10045:             if (*p_alive == g.FrameCount)
10046:                 *p_highlight = g.FrameCount;
10047:             *p_alive = g.FrameCount;
10048:             if (*p_highlight >= g.FrameCount - 1)
10049:                 window->DrawList->AddRect(bb.Min - ImVec2(1, 1), bb.Max + ImVec2(1, 1), IM_COL32(255, 0, 0, 255), 0.0f, ImDrawFlags_None, 2.0f);
10050:         }
10051: #endif
10052:     }
10053:     //if (g.IO.KeyAlt) window->DrawList->AddRect(bb.Min, bb.Max, IM_COL32(255,255,0,120)); // [DEBUG]
10054:     //if ((g.LastItemData.ItemFlags & ImGuiItemFlags_NoNav) == 0)
10055:     //    window->DrawList->AddRect(g.LastItemData.NavRect.Min, g.LastItemData.NavRect.Max, IM_COL32(255,255,0,255)); // [DEBUG]
