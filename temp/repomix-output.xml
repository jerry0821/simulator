 33: /// @file Definition of the base class for all importer worker classes.
 34: #pragma once
 35: #ifndef INCLUDED_AI_BASEIMPORTER_H
 36: #define INCLUDED_AI_BASEIMPORTER_H
 37: #ifdef __GNUC__
 38: #pragma GCC system_header
 39: #endif
 40: #include "Exceptional.h"
 41: #include "types.h"
 42: #include "ProgressHandler.hpp>
 43: #include <set>
 44: #include <vector>
 45: #include <memory>
 46: struct aiScene;
 47: struct aiImporterDesc;
 48: namespace Assimp {
 49: class Importer;
 50: class IOSystem;
 51: class BaseProcess;
 52: class SharedPostProcessInfo;
 53: class IOStream;
 54: // utility to do char4 to uint32 in a portable manner
 55: #define AI_MAKE_MAGIC(string) ((uint32_t)((string[0] << 24) + \
 56:                                           (string[1] << 16) + (string[2] << 8) + string[3]))
 57: // ---------------------------------------------------------------------------
 58: /** FOR IMPORTER PLUGINS ONLY: The BaseImporter defines a common interface
 59:  *  for all importer worker classes.
 60:  *
 61:  * The interface defines two functions: CanRead() is used to check if the
 62:  * importer can handle the format of the given file. If an implementation of
 63:  * this function returns true, the importer then calls ReadFile() which
 64:  * imports the given file. ReadFile is not overridable, it just calls
 65:  * InternReadFile() and catches any ImportErrorException that might occur.
 66:  */
 67: class ASSIMP_API BaseImporter {
 68:     friend class Importer;
 69: public:
 70:     /** Constructor to be privately used by #Importer */
 71:     BaseImporter() AI_NO_EXCEPT;
 72:     /** Destructor, private as well */
 73:     virtual ~BaseImporter();
 74:     // -------------------------------------------------------------------
 75:     /** Returns whether the class can handle the format of the given file.
 76:      *
 77:      * The implementation is expected to perform a full check of the file
 78:      * structure, possibly searching the first bytes of the file for magic
 79:      * identifiers or keywords.
 80:      *
 81:      * @param pFile Path and file name of the file to be examined.
 82:      * @param pIOHandler The IO handler to use for accessing any file.
 83:      * @param checkSig Legacy; do not use.
 84:      * @return true if the class can read this file, false if not or if
 85:      * unsure.
 86:      */
 87:     virtual bool CanRead(
 88:             const std::string &pFile,
 89:             IOSystem *pIOHandler,
 90:             bool checkSig) const = 0;
 91:     // -------------------------------------------------------------------
 92:     /** Imports the given file and returns the imported data.
 93:      * If the import succeeds, ownership of the data is transferred to
 94:      * the caller. If the import fails, nullptr is returned. The function
 95:      * takes care that any partially constructed data is destroyed
 96:      * beforehand.
 97:      *
 98:      * @param pImp #Importer object hosting this loader.
 99:      * @param pFile Path of the file to be imported.
100:      * @param pIOHandler IO-Handler used to open this and possible other files.
101:      * @return The imported data or nullptr if failed. If it failed a
102:      * human-readable error description can be retrieved by calling
103:      * GetErrorText()
104:      *
105:      * @note This function is not intended to be overridden. Implement
106:      * InternReadFile() to do the import. If an exception is thrown somewhere
107:      * in InternReadFile(), this function will catch it and transform it into
108:      *  a suitable response to the caller.
109:      */
110:     aiScene *ReadFile(
111:             Importer *pImp,
112:             const std::string &pFile,
113:             IOSystem *pIOHandler);
114:     // -------------------------------------------------------------------
115:     /** Returns the error description of the last error that occurred.
116:      * If the error is due to a std::exception, this will return the message.
117:      * Exceptions can also be accessed with GetException().
118:      * @return A description of the last error that occurred. An empty
119:      * string if there was no error.
120:      */
121:     const std::string &GetErrorText() const {
122:         return m_ErrorText;
123:     }
124:     // -------------------------------------------------------------------
125:     /** Returns the exception of the last exception that occurred.
126:      * Note: Exceptions are not the only source of error details, so GetErrorText
127:      * should be consulted too.
128:      * @return The last exception that occurred.
129:      */
130:     const std::exception_ptr& GetException() const {
131:         return m_Exception;
132:     }
133:     // -------------------------------------------------------------------
134:     /** Called prior to ReadFile().
135:      * The function is a request to the importer to update its configuration
136:      * basing on the Importer's configuration property list.
137:      * @param pImp Importer instance
138:      */
139:     virtual void SetupProperties(
140:             const Importer *pImp);
141:     // -------------------------------------------------------------------
142:     /** Called by #Importer::GetImporterInfo to get a description of
143:      *  some loader features. Importers must provide this information. */
144:     virtual const aiImporterDesc *GetInfo() const = 0;
145:     /**
146:      * Will be called only by scale process when scaling is requested.
147:      */
148:     void SetFileScale(double scale) {
149:         fileScale = scale;
150:     }
151:     // -------------------------------------------------------------------
152:     /** Called by #Importer::GetExtensionList for each loaded importer.
153:      *  Take the extension list contained in the structure returned by
154:      *  #GetInfo and insert all file extensions into the given set.
155:      *  @param extension set to collect file extensions in*/
156:     void GetExtensionList(std::set<std::string> &extensions);
157: protected:
158:     double importerScale = 1.0;
159:     double fileScale = 1.0;
160:     // -------------------------------------------------------------------
161:     /** Imports the given file into the given scene structure. The
162:      * function is expected to throw an ImportErrorException if there is
163:      * an error. If it terminates normally, the data in aiScene is
164:      * expected to be correct. Override this function to implement the
165:      * actual importing.
166:      * <br>
167:      *  The output scene must meet the following requirements:<br>
168:      * <ul>
169:      * <li>At least a root node must be there, even if its only purpose
170:      *     is to reference one mesh.</li>
171:      * <li>aiMesh::mPrimitiveTypes may be 0. The types of primitives
172:      *   in the mesh are determined automatically in this case.</li>
173:      * <li>the vertex data is stored in a pseudo-indexed "verbose" format.
174:      *   In fact this means that every vertex that is referenced by
175:      *   a face is unique. Or the other way round: a vertex index may
176:      *   not occur twice in a single aiMesh.</li>
177:      * <li>aiAnimation::mDuration may be -1. Assimp determines the length
178:      *   of the animation automatically in this case as the length of
179:      *   the longest animation channel.</li>
180:      * <li>aiMesh::mBitangents may be nullptr if tangents and normals are
181:      *   given. In this case bitangents are computed as the cross product
182:      *   between normal and tangent.</li>
183:      * <li>There needn't be a material. If none is there a default material
184:      *   is generated. However, it is recommended practice for loaders
185:      *   to generate a default material for yourself that matches the
186:      *   default material setting for the file format better than Assimp's
187:      *   generic default material. Note that default materials *should*
188:      *   be named AI_DEFAULT_MATERIAL_NAME if they're just color-shaded
189:      *   or AI_DEFAULT_TEXTURED_MATERIAL_NAME if they define a (dummy)
190:      *   texture. </li>
191:      * </ul>
192:      * If the AI_SCENE_FLAGS_INCOMPLETE-Flag is <b>not</b> set:<ul>
193:      * <li> at least one mesh must be there</li>
194:      * <li> there may be no meshes with 0 vertices or faces</li>
195:      * </ul>
196:      * This won't be checked (except by the validation step): Assimp will
197:      * crash if one of the conditions is not met!
198:      *
199:      * @param pFile Path of the file to be imported.
200:      * @param pScene The scene object to hold the imported data.
201:      * nullptr is not a valid parameter.
202:      * @param pIOHandler The IO handler to use for any file access.
203:      * nullptr is not a valid parameter. */
204:     virtual void InternReadFile(
205:             const std::string &pFile,
206:             aiScene *pScene,
207:             IOSystem *pIOHandler) = 0;
208: public: // static utilities
209:     // -------------------------------------------------------------------
210:     /** A utility for CanRead().
211:      *
212:      *  The function searches the header of a file for a specific token
213:      *  and returns true if this token is found. This works for text
214:      *  files only. There is a rudimentary handling of UNICODE files.
215:      *  The comparison is case independent.
216:      *
217:      *  @param pIOSystem IO System to work with
218:      *  @param file File name of the file
219:      *  @param tokens List of tokens to search for
220:      *  @param numTokens Size of the token array
221:      *  @param searchBytes Number of bytes to be searched for the tokens.
222:      */
223:     static bool SearchFileHeaderForToken(
224:             IOSystem *pIOSystem,
225:             const std::string &file,
226:             const char **tokens,
227:             std::size_t numTokens,
228:             unsigned int searchBytes = 200,
229:             bool tokensSol = false,
230:             bool noAlphaBeforeTokens = false);
231:     // -------------------------------------------------------------------
232:     /** @brief Check whether a file has a specific file extension
233:      *  @param pFile Input file
234:      *  @param ext0 Extension to check for. Lowercase characters only, no dot!
235:      *  @param ext1 Optional second extension
236:      *  @param ext2 Optional third extension
237:      *  @note Case-insensitive
238:      */
239:     static bool SimpleExtensionCheck(
240:             const std::string &pFile,
241:             const char *ext0,
242:             const char *ext1 = nullptr,
243:             const char *ext2 = nullptr);
244:     // -------------------------------------------------------------------
245:     /** @brief Extract file extension from a string
246:      *  @param pFile Input file
247:      *  @return Extension without trailing dot, all lowercase
248:      */
249:     static std::string GetExtension(
250:             const std::string &pFile);
251:     // -------------------------------------------------------------------
252:     /** @brief Check whether a file starts with one or more magic tokens
253:      *  @param pFile Input file
254:      *  @param pIOHandler IO system to be used
255:      *  @param magic n magic tokens
256:      *  @params num Size of magic
257:      *  @param offset Offset from file start where tokens are located
258:      *  @param Size of one token, in bytes. Maximally 16 bytes.
259:      *  @return true if one of the given tokens was found
260:      *
261:      *  @note For convenience, the check is also performed for the
262:      *  byte-swapped variant of all tokens (big endian). Only for
263:      *  tokens of size 2,4.
264:      */
265:     static bool CheckMagicToken(
266:             IOSystem *pIOHandler,
267:             const std::string &pFile,
268:             const void *magic,
269:             std::size_t num,
270:             unsigned int offset = 0,
271:             unsigned int size = 4);
272:     // -------------------------------------------------------------------
273:     /** An utility for all text file loaders. It converts a file to our
274:      *   UTF8 character set. Errors are reported, but ignored.
275:      *
276:      *  @param data File buffer to be converted to UTF8 data. The buffer
277:      *  is resized as appropriate. */
278:     static void ConvertToUTF8(
279:             std::vector<char> &data);
280:     // -------------------------------------------------------------------
281:     /** An utility for all text file loaders. It converts a file from our
282:      *   UTF8 character set back to ISO-8859-1. Errors are reported, but ignored.
283:      *
284:      *  @param data File buffer to be converted from UTF8 to ISO-8859-1. The buffer
285:      *  is resized as appropriate. */
286:     static void ConvertUTF8toISO8859_1(
287:             std::string &data);
288:     // -------------------------------------------------------------------
289:     /// @brief  Enum to define, if empty files are ok or not.
290:     enum TextFileMode {
291:         ALLOW_EMPTY,
292:         FORBID_EMPTY
293:     };
294:     // -------------------------------------------------------------------
295:     /** Utility for text file loaders which copies the contents of the
296:      *  file into a memory buffer and converts it to our UTF8
297:      *  representation.
298:      *  @param stream Stream to read from.
299:      *  @param data Output buffer to be resized and filled with the
300:      *   converted text file data. The buffer is terminated with
301:      *   a binary 0.
302:      *  @param mode Whether it is OK to load empty text files. */
303:     static void TextFileToBuffer(
304:             IOStream *stream,
305:             std::vector<char> &data,
306:             TextFileMode mode = FORBID_EMPTY);
307:     // -------------------------------------------------------------------
308:     /** Utility function to move a std::vector into a aiScene array
309:     *  @param vec The vector to be moved
310:     *  @param out The output pointer to the allocated array.
311:     *  @param numOut The output count of elements copied. */
312:     template <typename T>
313:     AI_FORCE_INLINE static void CopyVector(
314:             std::vector<T> &vec,
315:             T *&out,
316:             unsigned int &outLength) {
317:         outLength = unsigned(vec.size());
318:         if (outLength) {
319:             out = new T[outLength];
320:             std::swap_ranges(vec.begin(), vec.end(), out);
321:         }
322:     }
323:     // -------------------------------------------------------------------
324:     /** Utility function to move a std::vector of unique_ptrs into a aiScene array
325:     *  @param vec The vector of unique_ptrs to be moved
326:     *  @param out The output pointer to the allocated array.
327:     *  @param numOut The output count of elements copied. */
328:     template <typename T>
329:     AI_FORCE_INLINE static void CopyVector(
330:             std::vector<std::unique_ptr<T> > &vec,
331:             T **&out,
332:             unsigned int &outLength) {
333:         outLength = unsigned(vec.size());
334:         if (outLength) {
335:             out = new T*[outLength];
336:             T** outPtr = out;
337:             std::for_each(vec.begin(), vec.end(), [&outPtr](std::unique_ptr<T>& uPtr){*outPtr = uPtr.release(); ++outPtr; });
338:         }
339:     }
340: private:
341:     /* Pushes state into importer for the importer scale */
342:     void UpdateImporterScale(Importer *pImp);
343: protected:
344:     /// Error description in case there was one.
345:     std::string m_ErrorText;
346:     /// The exception, in case there was one.
347:     std::exception_ptr m_Exception;
348:     /// Currently set progress handler.
349:     ProgressHandler *m_progress;
350: };
351: } // end of namespace Assimp
352: #endif // AI_BASEIMPORTER_H_INC
</file>

