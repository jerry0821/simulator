1879: bool ImGui::Combo(const char* label, int* current_item, const char* (*getter)(void* user_data, int idx), void* user_data, int items_count, int popup_max_height_in_items)
1880: {
1881:     ImGuiContext& g = *GImGui;
1882:     // Call the getter to obtain the preview string which is a parameter to BeginCombo()
1883:     const char* preview_value = NULL;
1884:     if (*current_item >= 0 && *current_item < items_count)
1885:         preview_value = getter(user_data, *current_item);
1886:     // The old Combo() API exposed "popup_max_height_in_items". The new more general BeginCombo() API doesn't have/need it, but we emulate it here.
1887:     if (popup_max_height_in_items != -1 && !(g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasSizeConstraint))
1888:         SetNextWindowSizeConstraints(ImVec2(0, 0), ImVec2(FLT_MAX, CalcMaxPopupHeightFromItemCount(popup_max_height_in_items)));
1889:     if (!BeginCombo(label, preview_value, ImGuiComboFlags_None))
1890:         return false;
1891:     // Display items
1892:     bool value_changed = false;
1893:     ImGuiListClipper clipper;
1894:     clipper.Begin(items_count);
1895:     clipper.IncludeItemByIndex(*current_item);
1896:     while (clipper.Step())
1897:         for (int i = clipper.DisplayStart; i < clipper.DisplayEnd; i++)
1898:         {
1899:             const char* item_text = getter(user_data, i);
1900:             if (item_text == NULL)
1901:                 item_text = "*Unknown item*";
1902:             PushID(i);
1903:             const bool item_selected = (i == *current_item);
1904:             if (Selectable(item_text, item_selected) && *current_item != i)
1905:             {
1906:                 value_changed = true;
1907:                 *current_item = i;
1908:             }
1909:             if (item_selected)
1910:                 SetItemDefaultFocus();
1911:             PopID();
1912:         }
1913:     EndCombo();
1914:     if (value_changed)
1915:         MarkItemEdited(g.LastItemData.ID);
1916:     return value_changed;
1917: }
