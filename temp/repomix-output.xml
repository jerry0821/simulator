 48: // ---------------------------------------------------------------------------
 49: /** @brief Represents a row-major 3x3 matrix
 50:  *
 51:  *  There's much confusion about matrix layouts (column vs. row order).
 52:  *  This is *always* a row-major matrix. Not even with the
 53:  *  #aiProcess_ConvertToLeftHanded flag, which absolutely does not affect
 54:  *  matrix order - it just affects the handedness of the coordinate system
 55:  *  defined thereby.
 56:  */
 57: template <typename TReal>
 58: class aiMatrix3x3t {
 59: public:
 60:     aiMatrix3x3t() AI_NO_EXCEPT :
 61:         a1(static_cast<TReal>(1.0f)), a2(), a3(),
