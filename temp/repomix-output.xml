3599: void ImFontAtlasTextureRepack(ImFontAtlas* atlas, int w, int h)
3600: {
3601:     ImFontAtlasBuilder* builder = atlas->Builder;
3602:     builder->LockDisableResize = true;
3603:     ImTextureData* old_tex = atlas->TexData;
3604:     ImTextureData* new_tex = ImFontAtlasTextureAdd(atlas, w, h);
3605:     new_tex->UseColors = old_tex->UseColors;
3606:     IMGUI_DEBUG_LOG_FONT("[font] Texture #%03d: resize+repack %dx%d => Texture #%03d: %dx%d\n", old_tex->UniqueID, old_tex->Width, old_tex->Height, new_tex->UniqueID, new_tex->Width, new_tex->Height);
3607:     //for (int baked_n = 0; baked_n < builder->BakedPool.Size; baked_n++)
3608:     //    IMGUI_DEBUG_LOG_FONT("[font] - Baked %.2fpx, %d glyphs, want_destroy=%d\n", builder->BakedPool[baked_n].FontSize, builder->BakedPool[baked_n].Glyphs.Size, builder->BakedPool[baked_n].WantDestroy);
3609:     //IMGUI_DEBUG_LOG_FONT("[font] - Old packed rects: %d, area %d px\n", builder->RectsPackedCount, builder->RectsPackedSurface);
3610:     //ImFontAtlasDebugWriteTexToDisk(old_tex, "Before Pack");
3611:     // Repack, lose discarded rectangle, copy pixels
3612:     // FIXME-NEWATLAS: This is unstable because packing order is based on RectsIndex
3613:     // FIXME-NEWATLAS-V2: Repacking in batch would be beneficial to packing heuristic, and fix stability.
3614:     // FIXME-NEWATLAS-TESTS: Test calling RepackTexture with size too small to fits existing rects.
3615:     ImFontAtlasPackInit(atlas);
3616:     ImVector<ImTextureRect> old_rects;
3617:     ImVector<ImFontAtlasRectEntry> old_index = builder->RectsIndex;
3618:     old_rects.swap(builder->Rects);
3619:     for (ImFontAtlasRectEntry& index_entry : builder->RectsIndex)
3620:     {
3621:         if (index_entry.IsUsed == false)
3622:             continue;
3623:         ImTextureRect& old_r = old_rects[index_entry.TargetIndex];
3624:         if (old_r.w == 0 && old_r.h == 0)
3625:             continue;
3626:         ImFontAtlasRectId new_r_id = ImFontAtlasPackAddRect(atlas, old_r.w, old_r.h, &index_entry);
3627:         if (new_r_id == ImFontAtlasRectId_Invalid)
3628:         {
3629:             // Undo, grow texture and try repacking again.
3630:             // FIXME-NEWATLAS-TESTS: This is a very rarely exercised path! It needs to be automatically tested properly.
3631:             IMGUI_DEBUG_LOG_FONT("[font] Texture #%03d: resize failed. Will grow.\n", new_tex->UniqueID);
3632:             new_tex->WantDestroyNextFrame = true;
3633:             builder->Rects.swap(old_rects);
3634:             builder->RectsIndex = old_index;
3635:             ImFontAtlasBuildSetTexture(atlas, old_tex);
3636:             ImFontAtlasTextureGrow(atlas, w, h); // Recurse
3637:             return;
3638:         }
3639:         IM_ASSERT(ImFontAtlasRectId_GetIndex(new_r_id) == builder->RectsIndex.index_from_ptr(&index_entry));
3640:         ImTextureRect* new_r = ImFontAtlasPackGetRect(atlas, new_r_id);
3641:         ImFontAtlasTextureBlockCopy(old_tex, old_r.x, old_r.y, new_tex, new_r->x, new_r->y, new_r->w, new_r->h);
3642:     }
3643:     IM_ASSERT(old_rects.Size == builder->Rects.Size + builder->RectsDiscardedCount);
3644:     builder->RectsDiscardedCount = 0;
3645:     builder->RectsDiscardedSurface = 0;
3646:     // Patch glyphs UV
3647:     for (int baked_n = 0; baked_n < builder->BakedPool.Size; baked_n++)
3648:         for (ImFontGlyph& glyph : builder->BakedPool[baked_n].Glyphs)
3649:             if (glyph.PackId != ImFontAtlasRectId_Invalid)
3650:             {
3651:                 ImTextureRect* r = ImFontAtlasPackGetRect(atlas, glyph.PackId);
3652:                 glyph.U0 = (r->x) * atlas->TexUvScale.x;
3653:                 glyph.V0 = (r->y) * atlas->TexUvScale.y;
3654:                 glyph.U1 = (r->x + r->w) * atlas->TexUvScale.x;
3655:                 glyph.V1 = (r->y + r->h) * atlas->TexUvScale.y;
3656:             }
3657:     // Update other cached UV
3658:     ImFontAtlasBuildUpdateLinesTexData(atlas);
3659:     ImFontAtlasBuildUpdateBasicTexData(atlas);
3660:     builder->LockDisableResize = false;
3661:     ImFontAtlasUpdateDrawListsSharedData(atlas);
3662:     //ImFontAtlasDebugWriteTexToDisk(new_tex, "After Pack");
3663: }
3664: void ImFontAtlasTextureGrow(ImFontAtlas* atlas, int old_tex_w, int old_tex_h)
3665: {
3666:     //ImFontAtlasDebugWriteTexToDisk(atlas->TexData, "Before Grow");
3667:     ImFontAtlasBuilder* builder = atlas->Builder;
3668:     if (old_tex_w == -1)
3669:         old_tex_w = atlas->TexData->Width;
3670:     if (old_tex_h == -1)
3671:         old_tex_h = atlas->TexData->Height;
3672:     // FIXME-NEWATLAS-V2: What to do when reaching limits exposed by backend?
3673:     // FIXME-NEWATLAS-V2: Does ImFontAtlasFlags_NoPowerOfTwoHeight makes sense now? Allow 'lock' and 'compact' operations?
3674:     IM_ASSERT(ImIsPowerOfTwo(old_tex_w) && ImIsPowerOfTwo(old_tex_h));
3675:     IM_ASSERT(ImIsPowerOfTwo(atlas->TexMinWidth) && ImIsPowerOfTwo(atlas->TexMaxWidth) && ImIsPowerOfTwo(atlas->TexMinHeight) && ImIsPowerOfTwo(atlas->TexMaxHeight));
3676:     // Grow texture so it follows roughly a square.
3677:     // - Grow height before width, as width imply more packing nodes.
3678:     // - Caller should be taking account of RectsDiscardedSurface and may not need to grow.
3679:     int new_tex_w = (old_tex_h <= old_tex_w) ? old_tex_w : old_tex_w * 2;
3680:     int new_tex_h = (old_tex_h <= old_tex_w) ? old_tex_h * 2 : old_tex_h;
3681:     // Handle minimum size first (for pathologically large packed rects)
3682:     const int pack_padding = atlas->TexGlyphPadding;
3683:     new_tex_w = ImMax(new_tex_w, ImUpperPowerOfTwo(builder->MaxRectSize.x + pack_padding));
3684:     new_tex_h = ImMax(new_tex_h, ImUpperPowerOfTwo(builder->MaxRectSize.y + pack_padding));
3685:     new_tex_w = ImClamp(new_tex_w, atlas->TexMinWidth, atlas->TexMaxWidth);
3686:     new_tex_h = ImClamp(new_tex_h, atlas->TexMinHeight, atlas->TexMaxHeight);
3687:     if (new_tex_w == old_tex_w && new_tex_h == old_tex_h)
3688:         return;
3689:     ImFontAtlasTextureRepack(atlas, new_tex_w, new_tex_h);
3690: }
3691: void ImFontAtlasTextureMakeSpace(ImFontAtlas* atlas)
3692: {
3693:     // Can some baked contents be ditched?
3694:     //IMGUI_DEBUG_LOG_FONT("[font] ImFontAtlasBuildMakeSpace()\n");
3695:     ImFontAtlasBuilder* builder = atlas->Builder;
3696:     ImFontAtlasBuildDiscardBakes(atlas, 2);
3697:     // Currently using a heuristic for repack without growing.
3698:     if (builder->RectsDiscardedSurface < builder->RectsPackedSurface * 0.20f)
3699:         ImFontAtlasTextureGrow(atlas);
3700:     else
3701:         ImFontAtlasTextureRepack(atlas, atlas->TexData->Width, atlas->TexData->Height);
3702: }
3703: ImVec2i ImFontAtlasTextureGetSizeEstimate(ImFontAtlas* atlas)
3704: {
3705:     int min_w = ImUpperPowerOfTwo(atlas->TexMinWidth);
3706:     int min_h = ImUpperPowerOfTwo(atlas->TexMinHeight);
3707:     if (atlas->Builder == NULL || atlas->TexData == NULL || atlas->TexData->Status == ImTextureStatus_WantDestroy)
3708:         return ImVec2i(min_w, min_h);
3709:     ImFontAtlasBuilder* builder = atlas->Builder;
3710:     min_w = ImMax(ImUpperPowerOfTwo(builder->MaxRectSize.x), min_w);
3711:     min_h = ImMax(ImUpperPowerOfTwo(builder->MaxRectSize.y), min_h);
3712:     const int surface_approx = builder->RectsPackedSurface - builder->RectsDiscardedSurface; // Expected surface after repack
3713:     const int surface_sqrt = (int)sqrtf((float)surface_approx);
3714:     int new_tex_w;
3715:     int new_tex_h;
3716:     if (min_w >= min_h)
3717:     {
3718:         new_tex_w = ImMax(min_w, ImUpperPowerOfTwo(surface_sqrt));
3719:         new_tex_h = ImMax(min_h, (int)((surface_approx + new_tex_w - 1) / new_tex_w));
3720:         if ((atlas->Flags & ImFontAtlasFlags_NoPowerOfTwoHeight) == 0)
3721:             new_tex_h = ImUpperPowerOfTwo(new_tex_h);
3722:     }
3723:     else
3724:     {
3725:         new_tex_h = ImMax(min_h, ImUpperPowerOfTwo(surface_sqrt));
3726:         if ((atlas->Flags & ImFontAtlasFlags_NoPowerOfTwoHeight) == 0)
3727:             new_tex_h = ImUpperPowerOfTwo(new_tex_h);
3728:         new_tex_w = ImMax(min_w, (int)((surface_approx + new_tex_h - 1) / new_tex_h));
3729:     }
3730:     IM_ASSERT(ImIsPowerOfTwo(new_tex_w) && ImIsPowerOfTwo(new_tex_h));
3731:     return ImVec2i(new_tex_w, new_tex_h);
3732: }
3733: // Clear all output. Invalidates all AddCustomRect() return values!
3734: void ImFontAtlasBuildClear(ImFontAtlas* atlas)
3735: {
3736:     ImVec2i new_tex_size = ImFontAtlasTextureGetSizeEstimate(atlas);
3737:     ImFontAtlasBuildDestroy(atlas);
3738:     ImFontAtlasTextureAdd(atlas, new_tex_size.x, new_tex_size.y);
3739:     ImFontAtlasBuildInit(atlas);
3740:     for (ImFontConfig& src : atlas->Sources)
3741:         ImFontAtlasFontSourceInit(atlas, &src);
3742:     for (ImFont* font : atlas->Fonts)
3743:         for (ImFontConfig* src : font->Sources)
3744:             ImFontAtlasFontSourceAddToFont(atlas, font, src);
3745: }
3746: // You should not need to call this manually!
3747: // If you think you do, let us know and we can advise about policies auto-compact.
3748: void ImFontAtlasTextureCompact(ImFontAtlas* atlas)
3749: {
3750:     ImFontAtlasBuilder* builder = atlas->Builder;
3751:     ImFontAtlasBuildDiscardBakes(atlas, 1);
3752:     ImTextureData* old_tex = atlas->TexData;
3753:     ImVec2i old_tex_size = ImVec2i(old_tex->Width, old_tex->Height);
3754:     ImVec2i new_tex_size = ImFontAtlasTextureGetSizeEstimate(atlas);
3755:     if (builder->RectsDiscardedCount == 0 && new_tex_size.x == old_tex_size.x && new_tex_size.y == old_tex_size.y)
3756:         return;
3757:     ImFontAtlasTextureRepack(atlas, new_tex_size.x, new_tex_size.y);
3758: }
3759: // Start packing over current empty texture
3760: void ImFontAtlasBuildInit(ImFontAtlas* atlas)
3761: {
3762:     // Select Backend
3763:     // - Note that we do not reassign to atlas->FontLoader, since it is likely to point to static data which
3764:     //   may mess with some hot-reloading schemes. If you need to assign to this (for dynamic selection) AND are
3765:     //   using a hot-reloading scheme that messes up static data, store your own instance of FontLoader somewhere
3766:     //   and point to it instead of pointing directly to return value of the GetFontLoaderXXX functions.
3767:     if (atlas->FontLoader == NULL)
3768:     {
3769: #ifdef IMGUI_ENABLE_FREETYPE
3770:         atlas->SetFontLoader(ImGuiFreeType::GetFontLoader());
3771: #elif defined(IMGUI_ENABLE_STB_TRUETYPE)
3772:         atlas->SetFontLoader(ImFontAtlasGetFontLoaderForStbTruetype());
3773: #else
3774:         IM_ASSERT(0); // Invalid Build function
3775: #endif
3776:     }
3777:     // Create initial texture size
3778:     if (atlas->TexData == NULL || atlas->TexData->Pixels == NULL)
3779:         ImFontAtlasTextureAdd(atlas, ImUpperPowerOfTwo(atlas->TexMinWidth), ImUpperPowerOfTwo(atlas->TexMinHeight));
3780:     atlas->Builder = IM_NEW(ImFontAtlasBuilder)();
3781:     if (atlas->FontLoader->LoaderInit)
3782:         atlas->FontLoader->LoaderInit(atlas);
3783:     ImFontAtlasBuildUpdateRendererHasTexturesFromContext(atlas);
3784:     ImFontAtlasPackInit(atlas);
3785:     // Add required texture data
3786:     ImFontAtlasBuildUpdateLinesTexData(atlas);
3787:     ImFontAtlasBuildUpdateBasicTexData(atlas);
3788:     // Register fonts
3789:     ImFontAtlasBuildUpdatePointers(atlas);
3790:     // Update UV coordinates etc. stored in bound ImDrawListSharedData instance
3791:     ImFontAtlasUpdateDrawListsSharedData(atlas);
3792:     //atlas->TexIsBuilt = true;
3793: }
3794: // Destroy builder and all cached glyphs. Do not destroy actual fonts.
3795: void ImFontAtlasBuildDestroy(ImFontAtlas* atlas)
3796: {
3797:     for (ImFont* font : atlas->Fonts)
3798:         ImFontAtlasFontDestroyOutput(atlas, font);
3799:     if (atlas->Builder && atlas->FontLoader && atlas->FontLoader->LoaderShutdown)
3800:     {
3801:         atlas->FontLoader->LoaderShutdown(atlas);
3802:         IM_ASSERT(atlas->FontLoaderData == NULL);
3803:     }
3804:     IM_DELETE(atlas->Builder);
3805:     atlas->Builder = NULL;
3806: }
3807: void ImFontAtlasPackInit(ImFontAtlas * atlas)
3808: {
3809:     ImTextureData* tex = atlas->TexData;
3810:     ImFontAtlasBuilder* builder = atlas->Builder;
3811:     // In theory we could decide to reduce the number of nodes, e.g. halve them, and waste a little texture space, but it doesn't seem worth it.
3812:     const int pack_node_count = tex->Width / 2;
3813:     builder->PackNodes.resize(pack_node_count);
3814:     IM_STATIC_ASSERT(sizeof(stbrp_context) <= sizeof(stbrp_context_opaque));
3815:     stbrp_init_target((stbrp_context*)(void*)&builder->PackContext, tex->Width, tex->Height, builder->PackNodes.Data, builder->PackNodes.Size);
3816:     builder->RectsPackedSurface = builder->RectsPackedCount = 0;
3817:     builder->MaxRectSize = ImVec2i(0, 0);
3818:     builder->MaxRectBounds = ImVec2i(0, 0);
3819: }
3820: // This is essentially a free-list pattern, it may be nice to wrap it into a dedicated type.
3821: static ImFontAtlasRectId ImFontAtlasPackAllocRectEntry(ImFontAtlas* atlas, int rect_idx)
3822: {
3823:     ImFontAtlasBuilder* builder = (ImFontAtlasBuilder*)atlas->Builder;
3824:     int index_idx;
3825:     ImFontAtlasRectEntry* index_entry;
3826:     if (builder->RectsIndexFreeListStart < 0)
3827:     {
3828:         builder->RectsIndex.resize(builder->RectsIndex.Size + 1);
3829:         index_idx = builder->RectsIndex.Size - 1;
3830:         index_entry = &builder->RectsIndex[index_idx];
3831:         memset(index_entry, 0, sizeof(*index_entry));
3832:     }
3833:     else
3834:     {
3835:         index_idx = builder->RectsIndexFreeListStart;
3836:         index_entry = &builder->RectsIndex[index_idx];
3837:         IM_ASSERT(index_entry->IsUsed == false && index_entry->Generation > 0); // Generation is incremented during DiscardRect
3838:         builder->RectsIndexFreeListStart = index_entry->TargetIndex;
3839:     }
3840:     index_entry->TargetIndex = rect_idx;
3841:     index_entry->IsUsed = 1;
3842:     return ImFontAtlasRectId_Make(index_idx, index_entry->Generation);
3843: }
3844: // Overwrite existing entry
3845: static ImFontAtlasRectId ImFontAtlasPackReuseRectEntry(ImFontAtlas* atlas, ImFontAtlasRectEntry* index_entry)
3846: {
3847:     IM_ASSERT(index_entry->IsUsed);
3848:     index_entry->TargetIndex = atlas->Builder->Rects.Size - 1;
3849:     int index_idx = atlas->Builder->RectsIndex.index_from_ptr(index_entry);
3850:     return ImFontAtlasRectId_Make(index_idx, index_entry->Generation);
3851: }
3852: // This is expected to be called in batches and followed by a repack
3853: void ImFontAtlasPackDiscardRect(ImFontAtlas* atlas, ImFontAtlasRectId id)
3854: {
3855:     IM_ASSERT(id != ImFontAtlasRectId_Invalid);
3856:     ImTextureRect* rect = ImFontAtlasPackGetRect(atlas, id);
3857:     if (rect == NULL)
3858:         return;
3859:     ImFontAtlasBuilder* builder = atlas->Builder;
3860:     int index_idx = ImFontAtlasRectId_GetIndex(id);
3861:     ImFontAtlasRectEntry* index_entry = &builder->RectsIndex[index_idx];
3862:     IM_ASSERT(index_entry->IsUsed && index_entry->TargetIndex >= 0);
3863:     index_entry->IsUsed = false;
3864:     index_entry->TargetIndex = builder->RectsIndexFreeListStart;
3865:     index_entry->Generation++;
3866:     if (index_entry->Generation == 0)
3867:         index_entry->Generation++; // Keep non-zero on overflow
3868:     const int pack_padding = atlas->TexGlyphPadding;
3869:     builder->RectsIndexFreeListStart = index_idx;
3870:     builder->RectsDiscardedCount++;
3871:     builder->RectsDiscardedSurface += (rect->w + pack_padding) * (rect->h + pack_padding);
3872:     rect->w = rect->h = 0; // Clear rectangle so it won't be packed again
3873: }
3874: // Important: Calling this may recreate a new texture and therefore change atlas->TexData
3875: // FIXME-NEWFONTS: Expose other glyph padding settings for custom alteration (e.g. drop shadows). See #7962
3876: ImFontAtlasRectId ImFontAtlasPackAddRect(ImFontAtlas* atlas, int w, int h, ImFontAtlasRectEntry* overwrite_entry)
3877: {
3878:     IM_ASSERT(w > 0 && w <= 0xFFFF);
3879:     IM_ASSERT(h > 0 && h <= 0xFFFF);
3880:     ImFontAtlasBuilder* builder = (ImFontAtlasBuilder*)atlas->Builder;
3881:     const int pack_padding = atlas->TexGlyphPadding;
3882:     builder->MaxRectSize.x = ImMax(builder->MaxRectSize.x, w);
3883:     builder->MaxRectSize.y = ImMax(builder->MaxRectSize.y, h);
3884:     // Pack
3885:     ImTextureRect r = { 0, 0, (unsigned short)w, (unsigned short)h };
3886:     for (int attempts_remaining = 3; attempts_remaining >= 0; attempts_remaining--)
3887:     {
3888:         // Try packing
3889:         stbrp_rect pack_r = {};
3890:         pack_r.w = w + pack_padding;
3891:         pack_r.h = h + pack_padding;
3892:         stbrp_pack_rects((stbrp_context*)(void*)&builder->PackContext, &pack_r, 1);
3893:         r.x = (unsigned short)pack_r.x;
3894:         r.y = (unsigned short)pack_r.y;
3895:         if (pack_r.was_packed)
3896:             break;
3897:         // If we ran out of attempts, return fallback
3898:         if (attempts_remaining == 0 || builder->LockDisableResize)
3899:         {
3900:             IMGUI_DEBUG_LOG_FONT("[font] Failed packing %dx%d rectangle. Returning fallback.\n", w, h);
3901:             return ImFontAtlasRectId_Invalid;
3902:         }
3903:         // Resize or repack atlas! (this should be a rare event)
3904:         ImFontAtlasTextureMakeSpace(atlas);
3905:     }
3906:     builder->MaxRectBounds.x = ImMax(builder->MaxRectBounds.x, r.x + r.w + pack_padding);
3907:     builder->MaxRectBounds.y = ImMax(builder->MaxRectBounds.y, r.y + r.h + pack_padding);
3908:     builder->RectsPackedCount++;
3909:     builder->RectsPackedSurface += (w + pack_padding) * (h + pack_padding);
3910:     builder->Rects.push_back(r);
3911:     if (overwrite_entry != NULL)
3912:         return ImFontAtlasPackReuseRectEntry(atlas, overwrite_entry); // Write into an existing entry instead of adding one (used during repack)
3913:     else
3914:         return ImFontAtlasPackAllocRectEntry(atlas, builder->Rects.Size - 1);
3915: }
3916: // Generally for non-user facing functions: assert on invalid ID.
3917: ImTextureRect* ImFontAtlasPackGetRect(ImFontAtlas* atlas, ImFontAtlasRectId id)
3918: {
3919:     IM_ASSERT(id != ImFontAtlasRectId_Invalid);
3920:     int index_idx = ImFontAtlasRectId_GetIndex(id);
3921:     ImFontAtlasBuilder* builder = (ImFontAtlasBuilder*)atlas->Builder;
3922:     ImFontAtlasRectEntry* index_entry = &builder->RectsIndex[index_idx];
3923:     IM_ASSERT(index_entry->Generation == ImFontAtlasRectId_GetGeneration(id));
3924:     IM_ASSERT(index_entry->IsUsed);
3925:     return &builder->Rects[index_entry->TargetIndex];
3926: }
3927: // For user-facing functions: return NULL on invalid ID.
3928: // Important: return pointer is valid until next call to AddRect(), e.g. FindGlyph(), CalcTextSize() can all potentially invalidate previous pointers.
3929: ImTextureRect* ImFontAtlasPackGetRectSafe(ImFontAtlas* atlas, ImFontAtlasRectId id)
3930: {
3931:     if (id == ImFontAtlasRectId_Invalid)
3932:         return NULL;
3933:     int index_idx = ImFontAtlasRectId_GetIndex(id);
3934:     if (atlas->Builder == NULL)
3935:         ImFontAtlasBuildInit(atlas);
3936:     ImFontAtlasBuilder* builder = (ImFontAtlasBuilder*)atlas->Builder;
3937:     IM_MSVC_WARNING_SUPPRESS(28182); // Static Analysis false positive "warning C28182: Dereferencing NULL pointer 'builder'"
3938:     if (index_idx >= builder->RectsIndex.Size)
3939:         return NULL;
3940:     ImFontAtlasRectEntry* index_entry = &builder->RectsIndex[index_idx];
3941:     if (index_entry->Generation != ImFontAtlasRectId_GetGeneration(id) || !index_entry->IsUsed)
3942:         return NULL;
3943:     return &builder->Rects[index_entry->TargetIndex];
3944: }
3945: // Important! This assume by ImFontConfig::GlyphExcludeRanges[] is a SMALL ARRAY (e.g. <10 entries)
3946: // Use "Input Glyphs Overlap Detection Tool" to display a list of glyphs provided by multiple sources in order to set this array up.
3947: static bool ImFontAtlasBuildAcceptCodepointForSource(ImFontConfig* src, ImWchar codepoint)
3948: {
3949:     if (const ImWchar* exclude_list = src->GlyphExcludeRanges)
3950:         for (; exclude_list[0] != 0; exclude_list += 2)
3951:             if (codepoint >= exclude_list[0] && codepoint <= exclude_list[1])
3952:                 return false;
3953:     return true;
3954: }
3955: static void ImFontBaked_BuildGrowIndex(ImFontBaked* baked, int new_size)
3956: {
3957:     IM_ASSERT(baked->IndexAdvanceX.Size == baked->IndexLookup.Size);
3958:     if (new_size <= baked->IndexLookup.Size)
3959:         return;
3960:     baked->IndexAdvanceX.resize(new_size, -1.0f);
3961:     baked->IndexLookup.resize(new_size, IM_FONTGLYPH_INDEX_UNUSED);
3962: }
3963: static void ImFontAtlas_FontHookRemapCodepoint(ImFontAtlas* atlas, ImFont* font, ImWchar* c)
3964: {
3965:     IM_UNUSED(atlas);
3966:     if (font->RemapPairs.Data.Size != 0)
3967:         *c = (ImWchar)font->RemapPairs.GetInt((ImGuiID)*c, (int)*c);
3968: }
3969: static ImFontGlyph* ImFontBaked_BuildLoadGlyph(ImFontBaked* baked, ImWchar codepoint, float* only_load_advance_x)
3970: {
3971:     ImFont* font = baked->OwnerFont;
3972:     ImFontAtlas* atlas = font->OwnerAtlas;
3973:     if (atlas->Locked || (font->Flags & ImFontFlags_NoLoadGlyphs))
3974:     {
3975:         // Lazily load fallback glyph
3976:         if (baked->FallbackGlyphIndex == -1 && baked->LoadNoFallback == 0)
3977:             ImFontAtlasBuildSetupFontBakedFallback(baked);
3978:         return NULL;
3979:     }
3980:     // User remapping hooks
3981:     ImWchar src_codepoint = codepoint;
3982:     ImFontAtlas_FontHookRemapCodepoint(atlas, font, &codepoint);
3983:     //char utf8_buf[5];
3984:     //IMGUI_DEBUG_LOG("[font] BuildLoadGlyph U+%04X (%s)\n", (unsigned int)codepoint, ImTextCharToUtf8(utf8_buf, (unsigned int)codepoint));
3985:     // Special hook
3986:     // FIXME-NEWATLAS: it would be nicer if this used a more standardized way of hooking
3987:     if (codepoint == font->EllipsisChar && font->EllipsisAutoBake)
3988:         if (ImFontGlyph* glyph = ImFontAtlasBuildSetupFontBakedEllipsis(atlas, baked))
3989:             return glyph;
3990:     // Call backend
3991:     char* loader_user_data_p = (char*)baked->FontLoaderDatas;
3992:     int src_n = 0;
3993:     for (ImFontConfig* src : font->Sources)
3994:     {
3995:         const ImFontLoader* loader = src->FontLoader ? src->FontLoader : atlas->FontLoader;
3996:         if (!src->GlyphExcludeRanges || ImFontAtlasBuildAcceptCodepointForSource(src, codepoint))
3997:         {
3998:             if (only_load_advance_x == NULL)
3999:             {
4000:                 ImFontGlyph glyph_buf;
4001:                 if (loader->FontBakedLoadGlyph(atlas, src, baked, loader_user_data_p, codepoint, &glyph_buf, NULL))
4002:                 {
4003:                     // FIXME: Add hooks for e.g. #7962
4004:                     glyph_buf.Codepoint = src_codepoint;
4005:                     glyph_buf.SourceIdx = src_n;
4006:                     return ImFontAtlasBakedAddFontGlyph(atlas, baked, src, &glyph_buf);
4007:                 }
4008:             }
4009:             else
4010:             {
4011:                 // Special mode but only loading glyphs metrics. Will rasterize and pack later.
4012:                 if (loader->FontBakedLoadGlyph(atlas, src, baked, loader_user_data_p, codepoint, NULL, only_load_advance_x))
4013:                 {
4014:                     ImFontAtlasBakedAddFontGlyphAdvancedX(atlas, baked, src, codepoint, *only_load_advance_x);
4015:                     return NULL;
4016:                 }
4017:             }
4018:         }
4019:         loader_user_data_p += loader->FontBakedSrcLoaderDataSize;
4020:         src_n++;
4021:     }
4022:     // Lazily load fallback glyph
4023:     if (baked->LoadNoFallback)
4024:         return NULL;
4025:     if (baked->FallbackGlyphIndex == -1)
4026:         ImFontAtlasBuildSetupFontBakedFallback(baked);
4027:     // Mark index as not found, so we don't attempt the search twice
4028:     ImFontBaked_BuildGrowIndex(baked, codepoint + 1);
4029:     baked->IndexAdvanceX[codepoint] = baked->FallbackAdvanceX;
4030:     baked->IndexLookup[codepoint] = IM_FONTGLYPH_INDEX_NOT_FOUND;
4031:     return NULL;
4032: }
4033: static float ImFontBaked_BuildLoadGlyphAdvanceX(ImFontBaked* baked, ImWchar codepoint)
4034: {
4035:     if (baked->Size >= IMGUI_FONT_SIZE_THRESHOLD_FOR_LOADADVANCEXONLYMODE || baked->LoadNoRenderOnLayout)
4036:     {
4037:         // First load AdvanceX value used by CalcTextSize() API then load the rest when loaded by drawing API.
4038:         float only_advance_x = 0.0f;
