2377:    int numEntries = ttUSHORT(svg_doc_list);
2378:    stbtt_uint8 *svg_docs = svg_doc_list + 2;
2379:    for(i=0; i<numEntries; i++) {
2380:       stbtt_uint8 *svg_doc = svg_docs + (12 * i);
2381:       if ((gl >= ttUSHORT(svg_doc)) && (gl <= ttUSHORT(svg_doc + 2)))
