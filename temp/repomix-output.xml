15260:     if (window && IsItemHovered() && fg_draw_list)
15261:         fg_draw_list->AddRect(window->Pos, window->Pos + window->Size, IM_COL32(255, 255, 0, 255));
15262:     if (!node_open)
15263:         return;
15264:     if (window && !window->WasActive)
15265:         TextDisabled("Warning: owning Window is inactive. This DrawList is not being rendered!");
15266:     for (const ImDrawCmd* pcmd = draw_list->CmdBuffer.Data; pcmd < draw_list->CmdBuffer.Data + cmd_count; pcmd++)
15267:     {
15268:         if (pcmd->UserCallback)
15269:         {
15270:             BulletText("Callback %p, user_data %p", pcmd->UserCallback, pcmd->UserCallbackData);
15271:             continue;
15272:         }
15273:         char texid_desc[30];
15274:         FormatTextureRefForDebugDisplay(texid_desc, IM_ARRAYSIZE(texid_desc), pcmd->TexRef);
15275:         char buf[300];
15276:         ImFormatString(buf, IM_ARRAYSIZE(buf), "DrawCmd:%5d tris, Tex %s, ClipRect (%4.0f,%4.0f)-(%4.0f,%4.0f)",
15277:             pcmd->ElemCount / 3, texid_desc, pcmd->ClipRect.x, pcmd->ClipRect.y, pcmd->ClipRect.z, pcmd->ClipRect.w);
15278:         bool pcmd_node_open = TreeNode((void*)(pcmd - draw_list->CmdBuffer.begin()), "%s", buf);
15279:         if (IsItemHovered() && (cfg->ShowDrawCmdMesh || cfg->ShowDrawCmdBoundingBoxes) && fg_draw_list)
15280:             DebugNodeDrawCmdShowMeshAndBoundingBox(fg_draw_list, draw_list, pcmd, cfg->ShowDrawCmdMesh, cfg->ShowDrawCmdBoundingBoxes);
15281:         if (!pcmd_node_open)
15282:             continue;
15283:         // Calculate approximate coverage area (touched pixel count)
15284:         // This will be in pixels squared as long there's no post-scaling happening to the renderer output.
15285:         const ImDrawIdx* idx_buffer = (draw_list->IdxBuffer.Size > 0) ? draw_list->IdxBuffer.Data : NULL;
15286:         const ImDrawVert* vtx_buffer = draw_list->VtxBuffer.Data + pcmd->VtxOffset;
15287:         float total_area = 0.0f;
15288:         for (unsigned int idx_n = pcmd->IdxOffset; idx_n < pcmd->IdxOffset + pcmd->ElemCount; )
15289:         {
15290:             ImVec2 triangle[3];
15291:             for (int n = 0; n < 3; n++, idx_n++)
15292:                 triangle[n] = vtx_buffer[idx_buffer ? idx_buffer[idx_n] : idx_n].pos;
15293:             total_area += ImTriangleArea(triangle[0], triangle[1], triangle[2]);
15294:         }
15295:         // Display vertex information summary. Hover to get all triangles drawn in wire-frame
15296:         ImFormatString(buf, IM_ARRAYSIZE(buf), "Mesh: ElemCount: %d, VtxOffset: +%d, IdxOffset: +%d, Area: ~%0.f px", pcmd->ElemCount, pcmd->VtxOffset, pcmd->IdxOffset, total_area);
15297:         Selectable(buf);
15298:         if (IsItemHovered() && fg_draw_list)
15299:             DebugNodeDrawCmdShowMeshAndBoundingBox(fg_draw_list, draw_list, pcmd, true, false);
15300:         // Display individual triangles/vertices. Hover on to get the corresponding triangle highlighted.
15301:         ImGuiListClipper clipper;
15302:         clipper.Begin(pcmd->ElemCount / 3); // Manually coarse clip our print out of individual vertices to save CPU, only items that may be visible.
15303:         while (clipper.Step())
15304:             for (int prim = clipper.DisplayStart, idx_i = pcmd->IdxOffset + clipper.DisplayStart * 3; prim < clipper.DisplayEnd; prim++)
15305:             {
15306:                 char* buf_p = buf, * buf_end = buf + IM_ARRAYSIZE(buf);
15307:                 ImVec2 triangle[3];
15308:                 for (int n = 0; n < 3; n++, idx_i++)
15309:                 {
15310:                     const ImDrawVert& v = vtx_buffer[idx_buffer ? idx_buffer[idx_i] : idx_i];
15311:                     triangle[n] = v.pos;
15312:                     buf_p += ImFormatString(buf_p, buf_end - buf_p, "%s %04d: pos (%8.2f,%8.2f), uv (%.6f,%.6f), col %08X\n",
15313:                         (n == 0) ? "Vert:" : "     ", idx_i, v.pos.x, v.pos.y, v.uv.x, v.uv.y, v.col);
15314:                 }
15315:                 Selectable(buf, false);
15316:                 if (fg_draw_list && IsItemHovered())
15317:                 {
15318:                     ImDrawListFlags backup_flags = fg_draw_list->Flags;
15319:                     fg_draw_list->Flags &= ~ImDrawListFlags_AntiAliasedLines; // Disable AA on triangle outlines is more readable for very large and thin triangles.
15320:                     fg_draw_list->AddPolyline(triangle, 3, IM_COL32(255, 255, 0, 255), ImDrawFlags_Closed, 1.0f);
15321:                     fg_draw_list->Flags = backup_flags;
15322:                 }
15323:             }
15324:         TreePop();
15325:     }
15326:     TreePop();
15327: }
15328: // [DEBUG] Display mesh/aabb of a ImDrawCmd
15329: void ImGui::DebugNodeDrawCmdShowMeshAndBoundingBox(ImDrawList* out_draw_list, const ImDrawList* draw_list, const ImDrawCmd* draw_cmd, bool show_mesh, bool show_aabb)
15330: {
15331:     IM_ASSERT(show_mesh || show_aabb);
15332:     // Draw wire-frame version of all triangles
15333:     ImRect clip_rect = draw_cmd->ClipRect;
15334:     ImRect vtxs_rect(FLT_MAX, FLT_MAX, -FLT_MAX, -FLT_MAX);
15335:     ImDrawListFlags backup_flags = out_draw_list->Flags;
15336:     out_draw_list->Flags &= ~ImDrawListFlags_AntiAliasedLines; // Disable AA on triangle outlines is more readable for very large and thin triangles.
15337:     for (unsigned int idx_n = draw_cmd->IdxOffset, idx_end = draw_cmd->IdxOffset + draw_cmd->ElemCount; idx_n < idx_end; )
15338:     {
15339:         ImDrawIdx* idx_buffer = (draw_list->IdxBuffer.Size > 0) ? draw_list->IdxBuffer.Data : NULL; // We don't hold on those pointers past iterations as ->AddPolyline() may invalidate them if out_draw_list==draw_list
15340:         ImDrawVert* vtx_buffer = draw_list->VtxBuffer.Data + draw_cmd->VtxOffset;
15341:         ImVec2 triangle[3];
15342:         for (int n = 0; n < 3; n++, idx_n++)
15343:             vtxs_rect.Add((triangle[n] = vtx_buffer[idx_buffer ? idx_buffer[idx_n] : idx_n].pos));
15344:         if (show_mesh)
15345:             out_draw_list->AddPolyline(triangle, 3, IM_COL32(255, 255, 0, 255), ImDrawFlags_Closed, 1.0f); // In yellow: mesh triangles
15346:     }
15347:     // Draw bounding boxes
15348:     if (show_aabb)
15349:     {
15350:         out_draw_list->AddRect(ImTrunc(clip_rect.Min), ImTrunc(clip_rect.Max), IM_COL32(255, 0, 255, 255)); // In pink: clipping rectangle submitted to GPU
15351:         out_draw_list->AddRect(ImTrunc(vtxs_rect.Min), ImTrunc(vtxs_rect.Max), IM_COL32(0, 255, 255, 255)); // In cyan: bounding box of triangles
15352:     }
15353:     out_draw_list->Flags = backup_flags;
15354: }
15355: // [DEBUG] Compute mask of inputs with the same codepoint.
15356: static int CalcFontGlyphSrcOverlapMask(ImFontAtlas* atlas, ImFont* font, unsigned int codepoint)
15357: {
15358:     int mask = 0, count = 0;
15359:     for (int src_n = 0; src_n < font->Sources.Size; src_n++)
15360:     {
15361:         ImFontConfig* src = font->Sources[src_n];
15362:         if (!(src->FontLoader ? src->FontLoader : atlas->FontLoader)->FontSrcContainsGlyph(atlas, src, (ImWchar)codepoint))
15363:             continue;
15364:         mask |= (1 << src_n);
15365:         count++;
15366:     }
15367:     return count > 1 ? mask : 0;
15368: }
