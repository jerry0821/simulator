 17: static ID3D11Buffer* g_pPSConstantBuffer0 = nullptr; // Material
 18: static ID3D11Buffer* g_pVSConstantBuffer3 = nullptr; // 
 19: bool ShaderBillBoard_Initialize()
 20: {
 21: 	HRESULT hr; // 戻り値格納用
 22: 	// 事前コンパイル済み頂点シェーダーの読み込み
 23: 	std::ifstream ifs_vs("resource/shader/shader_vertex_billboard.cso", std::ios::binary);
 24: 	if (!ifs_vs) {
 25: 		MessageBox(nullptr, "頂点シェーダーの読み込みに失敗しました\n\nshader_vertex_3d.cso", "エラー", MB_OK);
 26: 		return false;
 27: 	}
 28: 	// ファイルサイズを取得
 29: 	ifs_vs.seekg(0, std::ios::end); // ファイルポインタを末尾に移動
 30: 	std::streamsize filesize = ifs_vs.tellg(); // ファイルポインタの位置を取得（つまりファイルサイズ）
 31: 	ifs_vs.seekg(0, std::ios::beg); // ファイルポインタを先頭に戻す
 32: 	// バイナリデータを格納するためのバッファを確保
 33: 	unsigned char* vsbinary_pointer = new unsigned char[filesize];
 34: 	ifs_vs.read((char*)vsbinary_pointer, filesize); // バイナリデータを読み込む
 35: 	ifs_vs.close(); // ファイルを閉じる
 36: 	// 頂点シェーダーの作成
 37: 	hr = Direct3D_GetDevice()->CreateVertexShader(vsbinary_pointer, filesize, nullptr, &g_pVertexShader);
 38: 	if (FAILED(hr)) {
 39: 		hal::dout << "Shader_Initialize() : 頂点シェーダーの作成に失敗しました" << std::endl;
 40: 		delete[] vsbinary_pointer; // メモリリークしないようにバイナリデータのバッファを解放
 41: 		return false;
 42: 	}
 43: 	// 頂点レイアウトの定義
 44: 	D3D11_INPUT_ELEMENT_DESC layout[] = {
 45: 		{ "POSITION", 0, DXGI_FORMAT_R32G32B32_FLOAT,		0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 },
 46: 		{ "COLOR",	  0, DXGI_FORMAT_R32G32B32A32_FLOAT,    0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 },
 47: 		{ "TEXCOORD", 0, DXGI_FORMAT_R32G32_FLOAT,			0, D3D11_APPEND_ALIGNED_ELEMENT, D3D11_INPUT_PER_VERTEX_DATA, 0 }
 48: 	};
 49: 	UINT num_elements = ARRAYSIZE(layout); // 配列の要素数を取得
 50: 	// 頂点レイアウトの作成
 51: 	hr = Direct3D_GetDevice()->CreateInputLayout(layout, num_elements, vsbinary_pointer, filesize, &g_pInputLayout);
 52: 	delete[] vsbinary_pointer; // バイナリデータのバッファを解放
 53: 	if (FAILED(hr)) {
 54: 		hal::dout << "Shader_Initialize() : 頂点レイアウトの作成に失敗しました" << std::endl;
 55: 		return false;
 56: 	}
 57: 	// 頂点シェーダー用定数バッファの作成
 58: 	D3D11_BUFFER_DESC buffer_desc{};
 59: 	buffer_desc.ByteWidth = sizeof(XMFLOAT4X4); // バッファのサイズ
 60: 	buffer_desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER; // バインドフラグ
 61: 	Direct3D_GetDevice()->CreateBuffer(&buffer_desc, nullptr, &g_pVSConstantBuffer0);
 62: 	buffer_desc.ByteWidth = sizeof(UVParameter); // バッファのサイズ
 63: 	Direct3D_GetDevice()->CreateBuffer(&buffer_desc, nullptr, &g_pVSConstantBuffer3);
 64: 	// 事前コンパイル済みピクセルシェーダーの読み込み
 65: 	std::ifstream ifs_ps("resource/shader/shader_pixel_billboard.cso", std::ios::binary);
 66: 	if (!ifs_ps) {
 67: 		MessageBox(nullptr, "ピクセルシェーダーの読み込みに失敗しました\n\nshader_pixel_3d.cso", "エラー", MB_OK);
 68: 		return false;
 69: 	}
 70: 	ifs_ps.seekg(0, std::ios::end);
 71: 	filesize = ifs_ps.tellg();
 72: 	ifs_ps.seekg(0, std::ios::beg);
 73: 	unsigned char* psbinary_pointer = new unsigned char[filesize];
 74: 	ifs_ps.read((char*)psbinary_pointer, filesize);
 75: 	ifs_ps.close();
 76: 	// ピクセルシェーダーの作成
 77: 	hr = Direct3D_GetDevice()->CreatePixelShader(psbinary_pointer, filesize, nullptr, &g_pPixelShader);
 78: 	delete[] psbinary_pointer; // バイナリデータのバッファを解放
 79: 	if (FAILED(hr)) {
 80: 		hal::dout << "Shader_Initialize() : ピクセルシェーダーの作成に失敗しました" << std::endl;
 81: 		return false;
 82: 	}
 83: 	// ピクセルシェーダー用定数バッファの作成
 84: 	buffer_desc.ByteWidth = sizeof(XMFLOAT4); // バッファのサイズ
 85: 	Direct3D_GetDevice()->CreateBuffer(&buffer_desc, nullptr, &g_pPSConstantBuffer0);
 86: 	return true;
 87: }
 88: void ShaderBillBoard_Finalize()
 89: {
 90: 	SAFE_RELEASE(g_pPixelShader);
 91: 	SAFE_RELEASE(g_pPSConstantBuffer0);
 92: 	SAFE_RELEASE(g_pVSConstantBuffer3);
 93: 	SAFE_RELEASE(g_pVSConstantBuffer0);
 94: 	SAFE_RELEASE(g_pInputLayout);
 95: 	SAFE_RELEASE(g_pVertexShader);
 96: }
 97: void ShaderBillBoard_SetWorldMatrix(const DirectX::XMMATRIX& matrix)
 98: {
 99: 	// 定数バッファ格納用行列の構造体を定義
100: 	XMFLOAT4X4 transpose;
101: 	// 行列を転置して定数バッファ格納用行列に変換
102: 	XMStoreFloat4x4(&transpose, XMMatrixTranspose(matrix));
103: 	// 定数バッファに行列をセット
104: 	Direct3D_GetContext()->UpdateSubresource(g_pVSConstantBuffer0, 0, nullptr, &transpose, 0, 0);
105: }
106: void ShaderBillBoard_SetMaterialColor(const DirectX::XMFLOAT4& material_color)
107: {
108: 	//定数バッファに行列をセット
109: 	Direct3D_GetContext()->UpdateSubresource(g_pPSConstantBuffer0, 0, nullptr, &material_color, 0, 0);
110: }
111: void ShaderBillBoard_SetUVParameter(const UVParameter& parameter)
112: {
113: 	//定数バッファに行列をセット
114: 	Direct3D_GetContext()->UpdateSubresource(g_pVSConstantBuffer3, 0, nullptr, &parameter, 0, 0);
115: }
116: void ShaderBillBoard_Begin()
117: {
118: 	// 頂点シェーダーとピクセルシェーダーを描画パイプラインに設定
119: 	Direct3D_GetContext()->VSSetShader(g_pVertexShader, nullptr, 0);
120: 	Direct3D_GetContext()->PSSetShader(g_pPixelShader, nullptr, 0);
121: 	// 頂点レイアウトを描画パイプラインに設定
122: 	Direct3D_GetContext()->IASetInputLayout(g_pInputLayout);
123: 	// 定数バッファを描画パイプラインに設定
124: 	Direct3D_GetContext()->VSSetConstantBuffers(0, 1, &g_pVSConstantBuffer0);
125: 	Direct3D_GetContext()->VSSetConstantBuffers(3, 1, &g_pVSConstantBuffer3);
126: 	Direct3D_GetContext()->PSSetConstantBuffers(0, 1, &g_pPSConstantBuffer0);
127: }
