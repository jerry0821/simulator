 4535: // We record the number of allocation in recent frames, as a way to audit/sanitize our guiding principles of "no allocations on idle/repeating frames"
 4536: void ImGui::DebugAllocHook(ImGuiDebugAllocInfo* info, int frame_count, void* ptr, size_t size)
 4537: {
 4538:     ImGuiDebugAllocEntry* entry = &info->LastEntriesBuf[info->LastEntriesIdx];
 4539:     IM_UNUSED(ptr);
 4540:     if (entry->FrameCount != frame_count)
 4541:     {
 4542:         info->LastEntriesIdx = (info->LastEntriesIdx + 1) % IM_ARRAYSIZE(info->LastEntriesBuf);
 4543:         entry = &info->LastEntriesBuf[info->LastEntriesIdx];
 4544:         entry->FrameCount = frame_count;
 4545:         entry->AllocCount = entry->FreeCount = 0;
 4546:     }
 4547:     if (size != (size_t)-1)
 4548:     {
 4549:         //printf("[%05d] MemAlloc(%d) -> 0x%p\n", frame_count, (int)size, ptr);
 4550:         entry->AllocCount++;
 4551:         info->TotalAllocCount++;
 4552:     }
 4553:     else
 4554:     {
 4555:         //printf("[%05d] MemFree(0x%p)\n", frame_count, ptr);
 4556:         entry->FreeCount++;
 4557:         info->TotalFreeCount++;
 4558:     }
 4559: }
