10446: // Helper to snap on edges when aiming at an item very close to the edge,
10447: // So the difference between WindowPadding and ItemSpacing will be in the visible area after scrolling.
10448: // When we refactor the scrolling API this may be configurable with a flag?
10449: // Note that the effect for this won't be visible on X axis with default Style settings as WindowPadding.x == ItemSpacing.x by default.
10450: static float CalcScrollEdgeSnap(float target, float snap_min, float snap_max, float snap_threshold, float center_ratio)
10451: {
10452:     if (target <= snap_min + snap_threshold)
10453:         return ImLerp(snap_min, target, center_ratio);
10454:     if (target >= snap_max - snap_threshold)
10455:         return ImLerp(target, snap_max, center_ratio);
10456:     return target;
10457: }
10458: static ImVec2 CalcNextScrollFromScrollTargetAndClamp(ImGuiWindow* window)
10459: {
10460:     ImVec2 scroll = window->Scroll;
10461:     ImVec2 decoration_size(window->DecoOuterSizeX1 + window->DecoInnerSizeX1 + window->DecoOuterSizeX2, window->DecoOuterSizeY1 + window->DecoInnerSizeY1 + window->DecoOuterSizeY2);
10462:     for (int axis = 0; axis < 2; axis++)
10463:     {
10464:         if (window->ScrollTarget[axis] < FLT_MAX)
10465:         {
10466:             float center_ratio = window->ScrollTargetCenterRatio[axis];
10467:             float scroll_target = window->ScrollTarget[axis];
10468:             if (window->ScrollTargetEdgeSnapDist[axis] > 0.0f)
10469:             {
10470:                 float snap_min = 0.0f;
10471:                 float snap_max = window->ScrollMax[axis] + window->SizeFull[axis] - decoration_size[axis];
10472:                 scroll_target = CalcScrollEdgeSnap(scroll_target, snap_min, snap_max, window->ScrollTargetEdgeSnapDist[axis], center_ratio);
10473:             }
10474:             scroll[axis] = scroll_target - center_ratio * (window->SizeFull[axis] - decoration_size[axis]);
10475:         }
10476:         scroll[axis] = ImRound64(ImMax(scroll[axis], 0.0f));
10477:         if (!window->Collapsed && !window->SkipItems)
