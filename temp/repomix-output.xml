14003: static void ScaleWindow(ImGuiWindow* window, float scale)
14004: {
14005:     ImVec2 origin = window->Viewport->Pos;
14006:     window->Pos = ImFloor((window->Pos - origin) * scale + origin);
14007:     window->Size = ImTrunc(window->Size * scale);
14008:     window->SizeFull = ImTrunc(window->SizeFull * scale);
14009:     window->ContentSize = ImTrunc(window->ContentSize * scale);
14010: }
