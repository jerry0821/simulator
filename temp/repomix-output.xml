2086:         return;
2087:     //IMGUI_DEBUG_PRINT("TableSetColumnWidth(%d, %.1f->%.1f)\n", column_0_idx, column_0->WidthGiven, column_0_width);
2088:     ImGuiTableColumn* column_1 = (column_0->NextEnabledColumn != -1) ? &table->Columns[column_0->NextEnabledColumn] : NULL;
2089:     // In this surprisingly not simple because of how we support mixing Fixed and multiple Stretch columns.
2090:     // - All fixed: easy.
2091:     // - All stretch: easy.
2092:     // - One or more fixed + one stretch: easy.
2093:     // - One or more fixed + more than one stretch: tricky.
2094:     // Qt when manual resize is enabled only supports a single _trailing_ stretch column, we support more cases here.
2095:     // When forwarding resize from Wn| to Fn+1| we need to be considerate of the _NoResize flag on Fn+1.
2096:     // FIXME-TABLE: Find a way to rewrite all of this so interactions feel more consistent for the user.
2097:     // Scenarios:
2098:     // - F1 F2 F3  resize from F1| or F2|   --> ok: alter ->WidthRequested of Fixed column. Subsequent columns will be offset.
2099:     // - F1 F2 F3  resize from F3|          --> ok: alter ->WidthRequested of Fixed column. If active, ScrollX extent can be altered.
2100:     // - F1 F2 W3  resize from F1| or F2|   --> ok: alter ->WidthRequested of Fixed column. If active, ScrollX extent can be altered, but it doesn't make much sense as the Stretch column will always be minimal size.
2101:     // - F1 F2 W3  resize from W3|          --> ok: no-op (disabled by Resize Rule 1)
2102:     // - W1 W2 W3  resize from W1| or W2|   --> ok
2103:     // - W1 W2 W3  resize from W3|          --> ok: no-op (disabled by Resize Rule 1)
2104:     // - W1 F2 F3  resize from F3|          --> ok: no-op (disabled by Resize Rule 1)
2105:     // - W1 F2     resize from F2|          --> ok: no-op (disabled by Resize Rule 1)
2106:     // - W1 W2 F3  resize from W1| or W2|   --> ok
2107:     // - W1 F2 W3  resize from W1| or F2|   --> ok
2108:     // - F1 W2 F3  resize from W2|          --> ok
2109:     // - F1 W3 F2  resize from W3|          --> ok
2110:     // - W1 F2 F3  resize from W1|          --> ok: equivalent to resizing |F2. F3 will not move.
2111:     // - W1 F2 F3  resize from F2|          --> ok
2112:     // All resizes from a Wx columns are locking other columns.
2113:     // Possible improvements:
2114:     // - W1 W2 W3  resize W1|               --> to not be stuck, both W2 and W3 would stretch down. Seems possible to fix. Would be most beneficial to simplify resize of all-weighted columns.
2115:     // - W3 F1 F2  resize W3|               --> to not be stuck past F1|, both F1 and F2 would need to stretch down, which would be lossy or ambiguous. Seems hard to fix.
2116:     // [Resize Rule 1] Can't resize from right of right-most visible column if there is any Stretch column. Implemented in TableUpdateLayout().
2117:     // If we have all Fixed columns OR resizing a Fixed column that doesn't come after a Stretch one, we can do an offsetting resize.
2118:     // This is the preferred resize path
2119:     if (column_0->Flags & ImGuiTableColumnFlags_WidthFixed)
2120:         if (!column_1 || table->LeftMostStretchedColumn == -1 || table->Columns[table->LeftMostStretchedColumn].DisplayOrder >= column_0->DisplayOrder)
2121:         {
2122:             column_0->WidthRequest = column_0_width;
2123:             table->IsSettingsDirty = true;
2124:             return;
2125:         }
2126:     // We can also use previous column if there's no next one (this is used when doing an auto-fit on the right-most stretch column)
2127:     if (column_1 == NULL)
2128:         column_1 = (column_0->PrevEnabledColumn != -1) ? &table->Columns[column_0->PrevEnabledColumn] : NULL;
2129:     if (column_1 == NULL)
2130:         return;
2131:     // Resizing from right-side of a Stretch column before a Fixed column forward sizing to left-side of fixed column.
2132:     // (old_a + old_b == new_a + new_b) --> (new_a == old_a + old_b - new_b)
2133:     float column_1_width = ImMax(column_1->WidthRequest - (column_0_width - column_0->WidthRequest), min_width);
2134:     column_0_width = column_0->WidthRequest + column_1->WidthRequest - column_1_width;
2135:     IM_ASSERT(column_0_width > 0.0f && column_1_width > 0.0f);
2136:     column_0->WidthRequest = column_0_width;
2137:     column_1->WidthRequest = column_1_width;
2138:     if ((column_0->Flags | column_1->Flags) & ImGuiTableColumnFlags_WidthStretch)
2139:         TableUpdateColumnsWeightFromWidth(table);
2140:     table->IsSettingsDirty = true;
2141: }
