1555: // Using 'hover_visibility_delay' allows us to hide the highlight and mouse cursor for a short time, which can be convenient to reduce visual noise.
1556: bool ImGui::SplitterBehavior(const ImRect& bb, ImGuiID id, ImGuiAxis axis, float* size1, float* size2, float min_size1, float min_size2, float hover_extend, float hover_visibility_delay, ImU32 bg_col)
1557: {
1558:     ImGuiContext& g = *GImGui;
1559:     ImGuiWindow* window = g.CurrentWindow;
1560:     if (!ItemAdd(bb, id, NULL, ImGuiItemFlags_NoNav))
1561:         return false;
1562:     // FIXME: AFAIK the only leftover reason for passing ImGuiButtonFlags_AllowOverlap here is
1563:     // to allow caller of SplitterBehavior() to call SetItemAllowOverlap() after the item.
1564:     // Nowadays we would instead want to use SetNextItemAllowOverlap() before the item.
1565:     ImGuiButtonFlags button_flags = ImGuiButtonFlags_FlattenChildren;
1566: #ifndef IMGUI_DISABLE_OBSOLETE_FUNCTIONS
1567:     button_flags |= ImGuiButtonFlags_AllowOverlap;
1568: #endif
1569:     bool hovered, held;
1570:     ImRect bb_interact = bb;
1571:     bb_interact.Expand(axis == ImGuiAxis_Y ? ImVec2(0.0f, hover_extend) : ImVec2(hover_extend, 0.0f));
1572:     ButtonBehavior(bb_interact, id, &hovered, &held, button_flags);
1573:     if (hovered)
1574:         g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_HoveredRect; // for IsItemHovered(), because bb_interact is larger than bb
1575:     if (held || (hovered && g.HoveredIdPreviousFrame == id && g.HoveredIdTimer >= hover_visibility_delay))
1576:         SetMouseCursor(axis == ImGuiAxis_Y ? ImGuiMouseCursor_ResizeNS : ImGuiMouseCursor_ResizeEW);
1577:     ImRect bb_render = bb;
1578:     if (held)
1579:     {
1580:         float mouse_delta = (g.IO.MousePos - g.ActiveIdClickOffset - bb_interact.Min)[axis];
1581:         // Minimum pane size
1582:         float size_1_maximum_delta = ImMax(0.0f, *size1 - min_size1);
1583:         float size_2_maximum_delta = ImMax(0.0f, *size2 - min_size2);
1584:         if (mouse_delta < -size_1_maximum_delta)
1585:             mouse_delta = -size_1_maximum_delta;
1586:         if (mouse_delta > size_2_maximum_delta)
1587:             mouse_delta = size_2_maximum_delta;
1588:         // Apply resize
1589:         if (mouse_delta != 0.0f)
1590:         {
1591:             *size1 = ImMax(*size1 + mouse_delta, min_size1);
1592:             *size2 = ImMax(*size2 - mouse_delta, min_size2);
1593:             bb_render.Translate((axis == ImGuiAxis_X) ? ImVec2(mouse_delta, 0.0f) : ImVec2(0.0f, mouse_delta));
1594:             MarkItemEdited(id);
1595:         }
1596:     }
1597:     // Render at new position
1598:     if (bg_col & IM_COL32_A_MASK)
1599:         window->DrawList->AddRectFilled(bb_render.Min, bb_render.Max, bg_col, 0.0f);
1600:     const ImU32 col = GetColorU32(held ? ImGuiCol_SeparatorActive : (hovered && g.HoveredIdTimer >= hover_visibility_delay) ? ImGuiCol_SeparatorHovered : ImGuiCol_Separator);
1601:     window->DrawList->AddRectFilled(bb_render.Min, bb_render.Max, col, 0.0f);
1602:     return held;
1603: }
1604: static int IMGUI_CDECL ShrinkWidthItemComparer(const void* lhs, const void* rhs)
1605: {
1606:     const ImGuiShrinkWidthItem* a = (const ImGuiShrinkWidthItem*)lhs;
1607:     const ImGuiShrinkWidthItem* b = (const ImGuiShrinkWidthItem*)rhs;
1608:     if (int d = (int)(b->Width - a->Width))
1609:         return d;
1610:     return b->Index - a->Index;
1611: }
1612: // Shrink excess width from a set of item, by removing width from the larger items first.
1613: // Set items Width to -1.0f to disable shrinking this item.
1614: void ImGui::ShrinkWidths(ImGuiShrinkWidthItem* items, int count, float width_excess, float width_min)
1615: {
1616:     if (count == 1)
1617:     {
1618:         if (items[0].Width >= 0.0f)
1619:             items[0].Width = ImMax(items[0].Width - width_excess, width_min);
1620:         return;
1621:     }
1622:     ImQsort(items, (size_t)count, sizeof(ImGuiShrinkWidthItem), ShrinkWidthItemComparer); // Sort largest first, smallest last.
1623:     int count_same_width = 1;
1624:     while (width_excess > 0.001f && count_same_width < count)
1625:     {
1626:         while (count_same_width < count && items[0].Width <= items[count_same_width].Width)
1627:             count_same_width++;
1628:         float max_width_to_remove_per_item = (count_same_width < count && items[count_same_width].Width >= 0.0f) ? (items[0].Width - items[count_same_width].Width) : (items[0].Width - 1.0f);
1629:         max_width_to_remove_per_item = ImMin(items[0].Width - width_min, max_width_to_remove_per_item);
1630:         if (max_width_to_remove_per_item <= 0.0f)
1631:             break;
1632:         float base_width_to_remove_per_item = ImMin(width_excess / count_same_width, max_width_to_remove_per_item);
1633:         for (int item_n = 0; item_n < count_same_width; item_n++)
1634:         {
1635:             float width_to_remove_for_this_item = ImMin(base_width_to_remove_per_item, items[item_n].Width - width_min);
1636:             items[item_n].Width -= width_to_remove_for_this_item;
1637:             width_excess -= width_to_remove_for_this_item;
1638:         }
1639:     }
1640:     // Round width and redistribute remainder
1641:     // Ensure that e.g. the right-most tab of a shrunk tab-bar always reaches exactly at the same distance from the right-most edge of the tab bar separator.
1642:     width_excess = 0.0f;
1643:     for (int n = 0; n < count; n++)
1644:     {
1645:         float width_rounded = ImTrunc(items[n].Width);
1646:         width_excess += items[n].Width - width_rounded;
1647:         items[n].Width = width_rounded;
1648:     }
1649:     while (width_excess > 0.0f)
1650:         for (int n = 0; n < count && width_excess > 0.0f; n++)
1651:         {
1652:             float width_to_add = ImMin(items[n].InitialWidth - items[n].Width, 1.0f);
1653:             items[n].Width += width_to_add;
1654:             width_excess -= width_to_add;
1655:         }
1656: }
