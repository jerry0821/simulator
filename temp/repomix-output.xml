  6: // Version: 1.0
  7: // ----------------------------------------------------
  8: #include "camera.h"
  9: #include "direct3d.h"
 10: #include <DirectXMath.h>
 11: using namespace DirectX;
 12: #include "key_logger.h"
 13: #include "debug_text.h"
 14: #include "mouse.h"
 15: #include <sstream>
 16: #include <windows.h>
 17: static XMFLOAT3 g_CameraPos = {  0.0f, 0.0f, -5.0f }; // カメラの位置
 18: static XMFLOAT3 g_CameraVector_Front = { 0.0f, 0.0f, 1.0f }; // 
 19: static XMFLOAT3 g_CameraVector_Up = { 0.0f, 1.0f, 0.0f }; // 
 20: static XMFLOAT3 g_CameraVector_Right = { 1.0f, 0.0f, 0.0f }; // 
 21: float g_CameraMoveSpeed = 20.0f; // カメラの移動速度
 22: static constexpr float g_CameraRotateSpeed = XMConvertToRadians(30.0f); // カメラの回転速度
 23: static XMFLOAT4X4 g_CameraMatrix;
 24: static XMFLOAT4X4 g_PerspectiveMatrix;
 25: static float g_Fov = XMConvertToRadians(60);
 26: static hal::DebugText* g_pDT = nullptr;
 27: static ID3D11Buffer* g_pVSConstantBuffer1 = nullptr; // World Matrix
 28: static ID3D11Buffer* g_pVSConstantBuffer2 = nullptr; // View Matrix
 29: static int g_camPrevMouseX = 0;
 30: static int g_camPrevMouseY = 0;
 31: static int g_camPrevScrollVal = 0;
 32: void Camera_Initialize(const DirectX::XMFLOAT3& position,
 33: 	const DirectX::XMFLOAT3& front,
 34: 	const DirectX::XMFLOAT3& right)
 35: {
 36: 	Camera_Initialize();
 37: 	g_CameraPos = position;
 38: 	XMVECTOR f = XMVector3Normalize(XMLoadFloat3(&front));
 39: 	XMVECTOR r = XMVector3Normalize(XMLoadFloat3(&right) * XMVECTOR { 1.0f, 0.0f, 1.0f });
 40: 	XMVECTOR u = XMVector3Normalize(XMVector3Cross(f, r));
 41: 	XMStoreFloat3(&g_CameraVector_Front, f);
 42: 	XMStoreFloat3(&g_CameraVector_Right, r);
 43: 	XMStoreFloat3(&g_CameraVector_Up, u);
 44: }
 45: void Camera_Initialize()
 46: {
 47: 	g_CameraPos = { 0.0f, 0.0f, -5.0f };
 48: 	g_CameraVector_Front = { 0.0f, 0.0f, 1.0f };
 49: 	g_CameraVector_Up = { 0.0f, 1.0f, 0.0f };
 50: 	g_CameraVector_Right = { 1.0f, 0.0f, 0.0f };
 51: 	g_Fov = XMConvertToRadians(60);
 52: 	XMStoreFloat4x4(&g_CameraMatrix, XMMatrixIdentity());
 53: 	XMStoreFloat4x4(&g_PerspectiveMatrix, XMMatrixIdentity());
 54: 	// 頂点シェーダー用定数バッファの作成
 55: 	D3D11_BUFFER_DESC buffer_desc{};
 56: 	buffer_desc.ByteWidth = sizeof(XMFLOAT4X4); // バッファのサイズ
 57: 	buffer_desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER; // バインドフラグ
 58: 	Direct3D_GetDevice()->CreateBuffer(&buffer_desc, nullptr, &g_pVSConstantBuffer1);
 59: 	Direct3D_GetDevice()->CreateBuffer(&buffer_desc, nullptr, &g_pVSConstantBuffer2);
 60: #if defined(DEBUG) || defined(_DEBUG)
 61: 	g_pDT = new hal::DebugText(Direct3D_GetDevice(), Direct3D_GetContext(),
 62: 		L"resource/texture/consolab_ascii_512.png", Direct3D_GetBackBufferWidth(), Direct3D_GetBackBufferHeight(),
 63: 		0.0f, 32.0f,
 64: 		0, 0,
 65: 		0.0f, 14.0f);
 66: #endif
 67: }
 68: void Camera_Finalize()
 69: {
 70: 	SAFE_RELEASE(g_pVSConstantBuffer2);
 71: 	SAFE_RELEASE(g_pVSConstantBuffer1);
 72: 	delete g_pDT;
 73: }
 74: void Camera_Update(double elapsed_time)
 75: {
 76: 	XMVECTOR front = XMLoadFloat3(&g_CameraVector_Front);
 77: 	XMVECTOR up = XMLoadFloat3(&g_CameraVector_Up);
 78: 	XMVECTOR right = XMLoadFloat3(&g_CameraVector_Right);
 79: 	XMVECTOR position = XMLoadFloat3(&g_CameraPos);
 80: 	// Mouse input
 81: 	Mouse_State ms{};
 82: 	Mouse_GetState(&ms);
 83: 	int mouseDX = ms.x - g_camPrevMouseX;
 84: 	int mouseDY = ms.y - g_camPrevMouseY;
 85: 	bool altHeld = (GetAsyncKeyState(VK_MENU) & 0x8000) != 0;
 86: 	// Alt + Right Mouse Button = Orbit/Rotate Camera
 87: 	if (altHeld && ms.rightButton) {
 88: 		float yawAngle = mouseDX * 0.005f;
 89: 		float pitchAngle = mouseDY * 0.005f;
 90: 		// Yaw (rotate around world Y)
 91: 		XMMATRIX yawRot = XMMatrixRotationY(yawAngle);
 92: 		front = XMVector3Normalize(XMVector3TransformNormal(front, yawRot));
 93: 		right = XMVector3Normalize(XMVector3TransformNormal(right, yawRot));
 94: 		up = XMVector3Normalize(XMVector3TransformNormal(up, yawRot));
 95: 		// Pitch (rotate around local right axis)
 96: 		XMMATRIX pitchRot = XMMatrixRotationAxis(right, pitchAngle);
 97: 		front = XMVector3Normalize(XMVector3TransformNormal(front, pitchRot));
 98: 		up = XMVector3Normalize(XMVector3Cross(front, right));
 99: 	}
100: 	// Alt + Left Mouse Button = Pan Camera
101: 	if (altHeld && ms.leftButton) {
102: 		float panSpeed = 0.02f;
103: 		position += -right * (float)mouseDX * panSpeed;
104: 		position += up * (float)mouseDY * panSpeed;
105: 	}
106: 	// Scroll Wheel = Zoom (Move along front axis)
107: 	int scrollDelta = ms.scrollWheelValue - g_camPrevScrollVal;
108: 	if (scrollDelta != 0) {
109: 		float zoomSpeed = 0.005f;
110: 		position += front * (float)scrollDelta * zoomSpeed;
111: 	}
112: 	// --- Keyboard fallback controls (kept for convenience) ---
113: 	if (KeyLogger_IsPressed(KK_DOWN)) {
114: 		XMMATRIX rotation = XMMatrixRotationAxis(right, g_CameraRotateSpeed * (float)elapsed_time);
115: 		front = XMVector3Normalize(XMVector3TransformNormal(front, rotation));
116: 		up = XMVector3Normalize(XMVector3Cross(front, right));
117: 	}
118: 	if (KeyLogger_IsPressed(KK_UP)) {
119: 		XMMATRIX rotation = XMMatrixRotationAxis(right, -g_CameraRotateSpeed * (float)elapsed_time);
120: 		front = XMVector3Normalize(XMVector3TransformNormal(front, rotation));
121: 		up = XMVector3Normalize(XMVector3Cross(front, right));
122: 	}
123: 	if (KeyLogger_IsPressed(KK_RIGHT)) {
124: 		XMMATRIX rotation = XMMatrixRotationY((float)(g_CameraRotateSpeed * elapsed_time));
125: 		up = XMVector3Normalize(XMVector3TransformNormal(up, rotation));
126: 		right = XMVector3Normalize(XMVector3TransformNormal(right, rotation));
127: 		front = XMVector3Normalize(XMVector3Cross(right, up));
128: 	}
129: 	if (KeyLogger_IsPressed(KK_LEFT)) {
130: 		XMMATRIX rotation = XMMatrixRotationY((float)(-g_CameraRotateSpeed * elapsed_time));
131: 		up = XMVector3Normalize(XMVector3TransformNormal(up, rotation));
132: 		right = XMVector3Normalize(XMVector3TransformNormal(right, rotation));
133: 		front = XMVector3Normalize(XMVector3Cross(right, up));
134: 	}
135: 	// Save mouse state for next frame
136: 	g_camPrevMouseX = ms.x;
137: 	g_camPrevMouseY = ms.y;
138: 	g_camPrevScrollVal = ms.scrollWheelValue;
139: 	// 各種更新結果を保存
140: 	XMStoreFloat3(&g_CameraPos, position);
141: 	XMStoreFloat3(&g_CameraVector_Front, front);
142: 	XMStoreFloat3(&g_CameraVector_Up, up);
143: 	XMStoreFloat3(&g_CameraVector_Right, right);
144: 	// ビュー座標変換行列の作成
145: 	XMMATRIX mtxView = XMMatrixLookAtLH(
146: 		position,
147: 		position + front,
148: 		up);
149: 	XMStoreFloat4x4(&g_CameraMatrix, mtxView);
150: 	float aspectRatio = (float)Direct3D_GetBackBufferWidth() / (float)Direct3D_GetBackBufferHeight();
151: 	float nearZ = 0.1f;
152: 	float farZ = 100.0f;
153: 	XMMATRIX mtxPerspective = XMMatrixPerspectiveFovLH(g_Fov, aspectRatio, nearZ, farZ);
154: 	XMStoreFloat4x4(&g_PerspectiveMatrix, mtxPerspective);
155: }
156: const DirectX::XMFLOAT4X4& Camera_GetMatrix()
157: {
158: 	return g_CameraMatrix;
159: }
160: const DirectX::XMFLOAT4X4& Camera_GetPerspectiveMatrix()
161: {
162: 	return g_PerspectiveMatrix;
163: }
164: const DirectX::XMFLOAT3& Camera_GetPosition()
165: {
166: 	return g_CameraPos;
167: }
168: const DirectX::XMFLOAT3& Camera_GetVector_Front()
169: {
170: 	return g_CameraVector_Front;
171: }
172: float Camera_GetFov()
173: {
174: 	return g_Fov;
175: }
176: void Camera_SetMatrix(const DirectX::XMMATRIX& view, const DirectX::XMMATRIX& projection)
177: {
178: 	// 定数バッファビュー設定
179: 	XMFLOAT4X4 v,p;
180: 	XMStoreFloat4x4(&v, XMMatrixTranspose(view));
181: 	XMStoreFloat4x4(&p, XMMatrixTranspose(projection));
182: 	Direct3D_GetContext()->UpdateSubresource(g_pVSConstantBuffer1, 0, nullptr, &v, 0, 0);
183: 	Direct3D_GetContext()->VSSetConstantBuffers(1, 1, &g_pVSConstantBuffer1);
184: 	Direct3D_GetContext()->UpdateSubresource(g_pVSConstantBuffer2, 0, nullptr, &p, 0, 0);
185: 	Direct3D_GetContext()->VSSetConstantBuffers(2, 1, &g_pVSConstantBuffer2);
186: }
187: void Camera_DebugDraw()
188: {
189: #if defined(DEBUG) || defined(_DEBUG)
190: 	std::stringstream ss;
191: 	ss<<std::endl;
192: 	ss << "Camera Position	   	: x =" << g_CameraPos.x;
193: 	ss << " y = " << g_CameraPos.y;
194: 	ss << " z = " << g_CameraPos.z << std::endl;
195: 	ss << "CameraVector Front	: x =" << g_CameraVector_Front.x;
196: 	ss << " y = " << g_CameraVector_Front.y;
197: 	ss << " z = " << g_CameraVector_Front.z << std::endl;
198: 	ss << "CameraVector Right	: x =" << g_CameraVector_Right.x;
199: 	ss << " y = " << g_CameraVector_Right.y;
200: 	ss << " z = " << g_CameraVector_Right.z << std::endl;
201: 	ss << "CameraVector Up	   	: x =" << g_CameraVector_Up.x;
202: 	ss << " y = " << g_CameraVector_Up.y;
203: 	ss << " z = " << g_CameraVector_Up.z << std::endl;
204: 	ss << "CameraVector Fov	   	: x =" << g_Fov << std::endl;
205: 	g_pDT->SetText(ss.str().c_str(), { 0.0f,1.0f,0.0f,1.0f });
206: 	g_pDT->Draw();
207: 	g_pDT->Clear();
208: #endif
209: }
