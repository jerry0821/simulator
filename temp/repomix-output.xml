 2491: {
 2492:     float t = ((col_b >> IM_COL32_A_SHIFT) & 0xFF) / 255.f;
 2493:     int r = ImLerp((int)(col_a >> IM_COL32_R_SHIFT) & 0xFF, (int)(col_b >> IM_COL32_R_SHIFT) & 0xFF, t);
