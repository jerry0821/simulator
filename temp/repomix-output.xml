163: void DrawCapsuleMtx(float radius, float halfHeight, const DirectX::XMMATRIX &mtxWorld, const DirectX::XMFLOAT4 &color) {
164:   const int segments = 16;
165:   Shader3D_Begin();
166:   D3D11_MAPPED_SUBRESOURCE msr;
167:   if (FAILED(g_pContext->Map(g_pVertexBuffer.Get(), 0, D3D11_MAP_WRITE_DISCARD, 0, &msr))) return;
168:   Vertex *v = (Vertex *)msr.pData;
169:   int idx = 0;
170:   float step = XM_2PI / segments;
171:   for (int i = 0; i < segments; ++i) {
172:     float c1=cosf(step*i)*radius,s1=sinf(step*i)*radius,c2=cosf(step*(i+1))*radius,s2=sinf(step*(i+1))*radius;
173:     v[idx].position={c1,halfHeight,s1};v[idx].normal={0,1,0};v[idx].color=color;v[idx++].uv={0,0};
174:     v[idx].position={c2,halfHeight,s2};v[idx].normal={0,1,0};v[idx].color=color;v[idx++].uv={0,0};
175:     v[idx].position={c1,-halfHeight,s1};v[idx].normal={0,-1,0};v[idx].color=color;v[idx++].uv={0,0};
176:     v[idx].position={c2,-halfHeight,s2};v[idx].normal={0,-1,0};v[idx].color=color;v[idx++].uv={0,0};
177:   }
178:   for (int i = 0; i < 4; ++i) {
179:     float c1=cosf(step*(i*4))*radius,s1=sinf(step*(i*4))*radius;
180:     v[idx].position={c1,halfHeight,s1};v[idx].normal={1,0,0};v[idx].color=color;v[idx++].uv={0,0};
181:     v[idx].position={c1,-halfHeight,s1};v[idx].normal={1,0,0};v[idx].color=color;v[idx++].uv={0,0};
182:   }
183:   int hemiSeg = segments / 2;
184:   float hStep = XM_PI / hemiSeg;
185:   for (int i = 0; i < hemiSeg; ++i) {
186:     float hc1=cosf(hStep*i)*radius,hs1=sinf(hStep*i)*radius,hc2=cosf(hStep*(i+1))*radius,hs2=sinf(hStep*(i+1))*radius;
187:     v[idx].position={hs1,halfHeight+hc1,0};v[idx].normal={0,1,0};v[idx].color=color;v[idx++].uv={0,0};
188:     v[idx].position={hs2,halfHeight+hc2,0};v[idx].normal={0,1,0};v[idx].color=color;v[idx++].uv={0,0};
189:     v[idx].position={0,halfHeight+hc1,hs1};v[idx].normal={1,0,0};v[idx].color=color;v[idx++].uv={0,0};
190:     v[idx].position={0,halfHeight+hc2,hs2};v[idx].normal={1,0,0};v[idx].color=color;v[idx++].uv={0,0};
191:     v[idx].position={hs1,-halfHeight-hc1,0};v[idx].normal={0,-1,0};v[idx].color=color;v[idx++].uv={0,0};
192:     v[idx].position={hs2,-halfHeight-hc2,0};v[idx].normal={0,-1,0};v[idx].color=color;v[idx++].uv={0,0};
193:     v[idx].position={0,-halfHeight-hc1,hs1};v[idx].normal={-1,0,0};v[idx].color=color;v[idx++].uv={0,0};
194:     v[idx].position={0,-halfHeight-hc2,hs2};v[idx].normal={-1,0,0};v[idx].color=color;v[idx++].uv={0,0};
195:   }
196:   g_pContext->Unmap(g_pVertexBuffer.Get(), 0);
197:   Shader3D_SetWorldMatrix(mtxWorld);
198:   UINT stride = sizeof(Vertex); UINT offset = 0;
199:   g_pContext->IASetVertexBuffers(0, 1, g_pVertexBuffer.GetAddressOf(), &stride, &offset);
200:   g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_LINELIST);
201:   Texture_SetTexture(g_WhiteTexId);
202:   g_pContext->Draw(idx, 0);
203: }
204: void DrawConeOBB(const DirectX::XMFLOAT3 &baseCenter, const DirectX::XMFLOAT3 &tip, float radius, const DirectX::XMMATRIX &mtxWorld, const DirectX::XMFLOAT4 &color) {
205:   const int segments = 16;
206:   const int numVertex = segments * 4;
207:   Shader3D_Begin();
208:   D3D11_MAPPED_SUBRESOURCE msr;
209:   if (FAILED(g_pContext->Map(g_pVertexBuffer.Get(), 0, D3D11_MAP_WRITE_DISCARD, 0, &msr))) return;
210:   Vertex *v = (Vertex *)msr.pData;
211:   XMVECTOR vBase=XMLoadFloat3(&baseCenter),vTip=XMLoadFloat3(&tip),vDir=XMVector3Normalize(vTip-vBase);
212:   XMVECTOR vUp=XMVectorSet(0,1,0,0);
213:   if(std::abs(XMVectorGetY(vDir))>0.99f) vUp=XMVectorSet(1,0,0,0);
214:   XMVECTOR vRight=XMVector3Normalize(XMVector3Cross(vUp,vDir));
215:   vUp=XMVector3Normalize(XMVector3Cross(vDir,vRight));
216:   XMFLOAT3 bp[16];
217:   for(int i=0;i<segments;i++){float a=(XM_2PI*i)/segments;XMStoreFloat3(&bp[i],vBase+vRight*(radius*cosf(a))+vUp*(radius*sinf(a)));}
218:   int vi=0;
219:   for(int i=0;i<segments;i++){
220:     int n=(i+1)%segments;
221:     v[vi].position=bp[i];v[vi].normal=XMFLOAT3(0,1,0);v[vi].color=color;v[vi].uv=XMFLOAT2(0,0);vi++;
222:     v[vi].position=bp[n];v[vi].normal=XMFLOAT3(0,1,0);v[vi].color=color;v[vi].uv=XMFLOAT2(0,0);vi++;
223:     v[vi].position=bp[i];v[vi].normal=XMFLOAT3(0,1,0);v[vi].color=color;v[vi].uv=XMFLOAT2(0,0);vi++;
224:     v[vi].position=tip;  v[vi].normal=XMFLOAT3(0,1,0);v[vi].color=color;v[vi].uv=XMFLOAT2(0,0);vi++;
225:   }
226:   g_pContext->Unmap(g_pVertexBuffer.Get(), 0);
227:   Shader3D_SetWorldMatrix(mtxWorld);
228:   UINT stride=sizeof(Vertex);UINT offset=0;
229:   g_pContext->IASetVertexBuffers(0,1,g_pVertexBuffer.GetAddressOf(),&stride,&offset);
230:   g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_LINELIST);
231:   Texture_SetTexture(g_WhiteTexId);
232:   g_pContext->Draw(numVertex,0);
233: }
