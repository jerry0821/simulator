15881: // Display line, search for 0xXXXXXXXX identifiers and call DebugLocateItemOnHover() when hovered.
15882: void ImGui::DebugTextUnformattedWithLocateItem(const char* line_begin, const char* line_end)
15883: {
15884:     TextUnformatted(line_begin, line_end);
15885:     if (!IsItemHovered(ImGuiHoveredFlags_AllowWhenBlockedByPopup | ImGuiHoveredFlags_AllowWhenBlockedByActiveItem))
15886:         return;
15887:     ImGuiContext& g = *GImGui;
15888:     ImRect text_rect = g.LastItemData.Rect;
15889:     for (const char* p = line_begin; p <= line_end - 10; p++)
15890:     {
15891:         ImGuiID id = 0;
15892:         if (p[0] != '0' || (p[1] != 'x' && p[1] != 'X') || sscanf(p + 2, "%X", &id) != 1 || ImCharIsXdigitA(p[10]))
15893:             continue;
15894:         ImVec2 p0 = CalcTextSize(line_begin, p);
15895:         ImVec2 p1 = CalcTextSize(p, p + 10);
15896:         g.LastItemData.Rect = ImRect(text_rect.Min + ImVec2(p0.x, 0.0f), text_rect.Min + ImVec2(p0.x + p1.x, p1.y));
15897:         if (IsMouseHoveringRect(g.LastItemData.Rect.Min, g.LastItemData.Rect.Max, true))
15898:             DebugLocateItemOnHover(id);
15899:         p += 10;
15900:     }
15901: }
