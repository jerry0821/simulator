14058: // Win32 clipboard implementation
14059: // We use g.ClipboardHandlerData for temporary storage to ensure it is freed on Shutdown()
14060: static const char* Platform_GetClipboardTextFn_DefaultImpl(ImGuiContext* ctx)
14061: {
14062:     ImGuiContext& g = *ctx;
14063:     g.ClipboardHandlerData.clear();
14064:     if (!::OpenClipboard(NULL))
14065:         return NULL;
14066:     HANDLE wbuf_handle = ::GetClipboardData(CF_UNICODETEXT);
14067:     if (wbuf_handle == NULL)
14068:     {
14069:         ::CloseClipboard();
14070:         return NULL;
14071:     }
14072:     if (const WCHAR* wbuf_global = (const WCHAR*)::GlobalLock(wbuf_handle))
14073:     {
14074:         int buf_len = ::WideCharToMultiByte(CP_UTF8, 0, wbuf_global, -1, NULL, 0, NULL, NULL);
14075:         g.ClipboardHandlerData.resize(buf_len);
14076:         ::WideCharToMultiByte(CP_UTF8, 0, wbuf_global, -1, g.ClipboardHandlerData.Data, buf_len, NULL, NULL);
14077:     }
14078:     ::GlobalUnlock(wbuf_handle);
14079:     ::CloseClipboard();
14080:     return g.ClipboardHandlerData.Data;
14081: }
14082: static void Platform_SetClipboardTextFn_DefaultImpl(ImGuiContext*, const char* text)
14083: {
14084:     if (!::OpenClipboard(NULL))
14085:         return;
14086:     const int wbuf_length = ::MultiByteToWideChar(CP_UTF8, 0, text, -1, NULL, 0);
14087:     HGLOBAL wbuf_handle = ::GlobalAlloc(GMEM_MOVEABLE, (SIZE_T)wbuf_length * sizeof(WCHAR));
14088:     if (wbuf_handle == NULL)
14089:     {
14090:         ::CloseClipboard();
14091:         return;
14092:     }
14093:     WCHAR* wbuf_global = (WCHAR*)::GlobalLock(wbuf_handle);
14094:     ::MultiByteToWideChar(CP_UTF8, 0, text, -1, wbuf_global, wbuf_length);
14095:     ::GlobalUnlock(wbuf_handle);
14096:     ::EmptyClipboard();
14097:     if (::SetClipboardData(CF_UNICODETEXT, wbuf_handle) == NULL)
14098:         ::GlobalFree(wbuf_handle);
14099:     ::CloseClipboard();
14100: }
