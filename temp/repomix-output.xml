 649: // Reserve space for a number of vertices and indices.
 650: // You must finish filling your reserved data before calling PrimReserve() again, as it may reallocate or
 651: // submit the intermediate results. PrimUnreserve() can be used to release unused allocations.
 652: void ImDrawList::PrimReserve(int idx_count, int vtx_count)
 653: {
 654:     // Large mesh support (when enabled)
 655:     IM_ASSERT_PARANOID(idx_count >= 0 && vtx_count >= 0);
 656:     if (sizeof(ImDrawIdx) == 2 && (_VtxCurrentIdx + vtx_count >= (1 << 16)) && (Flags & ImDrawListFlags_AllowVtxOffset))
 657:     {
 658:         // FIXME: In theory we should be testing that vtx_count <64k here.
 659:         // In practice, RenderText() relies on reserving ahead for a worst case scenario so it is currently useful for us
 660:         // to not make that check until we rework the text functions to handle clipping and large horizontal lines better.
 661:         _CmdHeader.VtxOffset = VtxBuffer.Size;
 662:         _OnChangedVtxOffset();
 663:     }
 664:     ImDrawCmd* draw_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];
 665:     draw_cmd->ElemCount += idx_count;
 666:     int vtx_buffer_old_size = VtxBuffer.Size;
 667:     VtxBuffer.resize(vtx_buffer_old_size + vtx_count);
 668:     _VtxWritePtr = VtxBuffer.Data + vtx_buffer_old_size;
 669:     int idx_buffer_old_size = IdxBuffer.Size;
 670:     IdxBuffer.resize(idx_buffer_old_size + idx_count);
 671:     _IdxWritePtr = IdxBuffer.Data + idx_buffer_old_size;
 672: }
 673: // Release the number of reserved vertices/indices from the end of the last reservation made with PrimReserve().
 674: void ImDrawList::PrimUnreserve(int idx_count, int vtx_count)
 675: {
 676:     IM_ASSERT_PARANOID(idx_count >= 0 && vtx_count >= 0);
 677:     ImDrawCmd* draw_cmd = &CmdBuffer.Data[CmdBuffer.Size - 1];
 678:     draw_cmd->ElemCount -= idx_count;
 679:     VtxBuffer.shrink(VtxBuffer.Size - vtx_count);
 680:     IdxBuffer.shrink(IdxBuffer.Size - idx_count);
 681: }
 682: // Fully unrolled with inline call to keep our debug builds decently fast.
 683: void ImDrawList::PrimRect(const ImVec2& a, const ImVec2& c, ImU32 col)
 684: {
 685:     ImVec2 b(c.x, a.y), d(a.x, c.y), uv(_Data->TexUvWhitePixel);
 686:     ImDrawIdx idx = (ImDrawIdx)_VtxCurrentIdx;
 687:     _IdxWritePtr[0] = idx; _IdxWritePtr[1] = (ImDrawIdx)(idx+1); _IdxWritePtr[2] = (ImDrawIdx)(idx+2);
 688:     _IdxWritePtr[3] = idx; _IdxWritePtr[4] = (ImDrawIdx)(idx+2); _IdxWritePtr[5] = (ImDrawIdx)(idx+3);
 689:     _VtxWritePtr[0].pos = a; _VtxWritePtr[0].uv = uv; _VtxWritePtr[0].col = col;
 690:     _VtxWritePtr[1].pos = b; _VtxWritePtr[1].uv = uv; _VtxWritePtr[1].col = col;
 691:     _VtxWritePtr[2].pos = c; _VtxWritePtr[2].uv = uv; _VtxWritePtr[2].col = col;
 692:     _VtxWritePtr[3].pos = d; _VtxWritePtr[3].uv = uv; _VtxWritePtr[3].col = col;
 693:     _VtxWritePtr += 4;
 694:     _VtxCurrentIdx += 4;
 695:     _IdxWritePtr += 6;
 696: }
 697: void ImDrawList::PrimRectUV(const ImVec2& a, const ImVec2& c, const ImVec2& uv_a, const ImVec2& uv_c, ImU32 col)
 698: {
