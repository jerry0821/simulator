401:             closestDist = hit.distance;
402:             hitBlockIndex = i;
403:             // Place the block adjacent to the collided face
404:             bestHitPos = {obj->Position.x + hit.normal.x * 1.0f,
405:                           obj->Position.y + hit.normal.y * 1.0f,
406:                           obj->Position.z + hit.normal.z * 1.0f};
