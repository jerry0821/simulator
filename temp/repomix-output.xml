829: 	sprintf (str1, "%" PRINTF_INTMAX_MODIFIER "d %x\n",  imax, ~0);
830: 	if (0 != strcmp (str0, str1)) REPORTERROR (("Something wrong with imax : %s\n", str1));
831: 	sprintf (str1, "%" PRINTF_INTMAX_MODIFIER "u %x\n",  umax, ~0);
832: 	if (0 != strcmp (str0, str1)) REPORTERROR (("Something wrong with umax : %s\n", str1));
833: 	TESTUMAX(8);
834: 	TESTUMAX(16);
835: 	TESTUMAX(32);
836: #ifdef INT64_MAX
837: 	TESTUMAX(64);
838: #endif
839: #define STR(v) #v
840: #define Q(v) printf ("sizeof " STR(v) " = %u\n", (unsigned) sizeof (v));
841: 	if (err_n) {
842: 		printf ("pstdint.h is not correct.  Please use sizes below to correct it:\n");
843: 	}
844: 	Q(int)
845: 	Q(unsigned)
846: 	Q(long int)
847: 	Q(short int)
848: 	Q(int8_t)
849: 	Q(int16_t)
850: 	Q(int32_t)
851: #ifdef INT64_MAX
852: 	Q(int64_t)
853: #endif
854: 	return EXIT_SUCCESS;
855: }
856: #endif
</file>

