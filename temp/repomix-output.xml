3542: static bool ImCharIsSeparatorW(unsigned int c)
3543: {
3544:     static const unsigned int separator_list[] =
3545:     {
3546:         ',', 0x3001, '.', 0x3002, ';', 0xFF1B, '(', 0xFF08, ')', 0xFF09, '{', 0xFF5B, '}', 0xFF5D,
3547:         '[', 0x300C, ']', 0x300D, '|', 0xFF5C, '!', 0xFF01, '\\', 0xFFE5, '/', 0x30FB, 0xFF0F,
3548:         '\n', '\r',
3549:     };
3550:     for (unsigned int separator : separator_list)
3551:         if (c == separator)
3552:             return true;
3553:     return false;
3554: }
3555: static int is_word_boundary_from_right(ImGuiInputTextState* obj, int idx)
3556: {
3557:     // When ImGuiInputTextFlags_Password is set, we don't want actions such as Ctrl+Arrow to leak the fact that underlying data are blanks or separators.
3558:     if ((obj->Flags & ImGuiInputTextFlags_Password) || idx <= 0)
3559:         return 0;
3560:     const char* curr_p = obj->TextSrc + idx;
3561:     const char* prev_p = ImTextFindPreviousUtf8Codepoint(obj->TextSrc, curr_p);
3562:     unsigned int curr_c; ImTextCharFromUtf8(&curr_c, curr_p, obj->TextSrc + obj->TextLen);
3563:     unsigned int prev_c; ImTextCharFromUtf8(&prev_c, prev_p, obj->TextSrc + obj->TextLen);
3564:     bool prev_white = ImCharIsBlankW(prev_c);
3565:     bool prev_separ = ImCharIsSeparatorW(prev_c);
3566:     bool curr_white = ImCharIsBlankW(curr_c);
3567:     bool curr_separ = ImCharIsSeparatorW(curr_c);
3568:     return ((prev_white || prev_separ) && !(curr_separ || curr_white)) || (curr_separ && !prev_separ);
3569: }
3570: static int is_word_boundary_from_left(ImGuiInputTextState* obj, int idx)
3571: {
3572:     if ((obj->Flags & ImGuiInputTextFlags_Password) || idx <= 0)
3573:         return 0;
3574:     const char* curr_p = obj->TextSrc + idx;
3575:     const char* prev_p = ImTextFindPreviousUtf8Codepoint(obj->TextSrc, curr_p);
3576:     unsigned int prev_c; ImTextCharFromUtf8(&prev_c, curr_p, obj->TextSrc + obj->TextLen);
3577:     unsigned int curr_c; ImTextCharFromUtf8(&curr_c, prev_p, obj->TextSrc + obj->TextLen);
3578:     bool prev_white = ImCharIsBlankW(prev_c);
3579:     bool prev_separ = ImCharIsSeparatorW(prev_c);
3580:     bool curr_white = ImCharIsBlankW(curr_c);
3581:     bool curr_separ = ImCharIsSeparatorW(curr_c);
3582:     return ((prev_white) && !(curr_separ || curr_white)) || (curr_separ && !prev_separ);
3583: }
