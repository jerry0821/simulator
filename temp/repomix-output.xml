 9720: // Chosen name "Try to recover" over e.g. "Restore" to suggest this is not a 100% guaranteed recovery.
 9721: // Called by e.g. EndFrame() but may be called for manual recovery.
 9722: // Attempt to recover full window stack.
 9723: void ImGui::ErrorRecoveryTryToRecoverState(const ImGuiErrorRecoveryState* state_in)
 9724: {
 9725:     // PVS-Studio V1044 is "Loop break conditions do not depend on the number of iterations"
 9726:     ImGuiContext& g = *GImGui;
 9727:     while (g.CurrentWindowStack.Size > state_in->SizeOfWindowStack) //-V1044
 9728:     {
 9729:         // Recap:
 9730:         // - Begin()/BeginChild() return false to indicate the window is collapsed or fully clipped.
 9731:         // - Always call a matching End() for each Begin() call, regardless of its return value!
 9732:         // - Begin/End and BeginChild/EndChild logic is KNOWN TO BE INCONSISTENT WITH ALL OTHER BEGIN/END FUNCTIONS.
 9733:         // - We will fix that in a future major update.
 9734:         ImGuiWindow* window = g.CurrentWindow;
 9735:         if (window->Flags & ImGuiWindowFlags_ChildWindow)
 9736:         {
 9737:             if (g.CurrentTable != NULL && g.CurrentTable->InnerWindow == g.CurrentWindow)
 9738:             {
 9739:                 IM_ASSERT_USER_ERROR(0, "Missing EndTable()");
 9740:                 EndTable();
 9741:             }
 9742:             else
 9743:             {
 9744:                 IM_ASSERT_USER_ERROR(0, "Missing EndChild()");
 9745:                 EndChild();
 9746:             }
 9747:         }
 9748:         else
 9749:         {
 9750:             IM_ASSERT_USER_ERROR(0, "Missing End()");
 9751:             End();
 9752:         }
 9753:     }
 9754:     if (g.CurrentWindowStack.Size == state_in->SizeOfWindowStack)
 9755:         ErrorRecoveryTryToRecoverWindowState(state_in);
 9756: }
