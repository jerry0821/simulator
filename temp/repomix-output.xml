2676:         if ((v_min * v_max) < 0.0f) // Range crosses zero, so we have to do this in two parts
2677:         {
2678:             float zero_point_center = (-(float)ImMin(v_min, v_max)) / ImAbs((float)v_max - (float)v_min); // The zero point in parametric space
2679:             float zero_point_snap_L = zero_point_center - zero_deadzone_halfsize;
2680:             float zero_point_snap_R = zero_point_center + zero_deadzone_halfsize;
2681:             if (t_with_flip >= zero_point_snap_L && t_with_flip <= zero_point_snap_R)
