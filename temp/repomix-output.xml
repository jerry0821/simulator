 1583: static ImGuiInputEvent* FindLatestInputEvent(ImGuiContext* ctx, ImGuiInputEventType type, int arg = -1)
 1584: {
 1585:     ImGuiContext& g = *ctx;
 1586:     for (int n = g.InputEventsQueue.Size - 1; n >= 0; n--)
 1587:     {
 1588:         ImGuiInputEvent* e = &g.InputEventsQueue[n];
 1589:         if (e->Type != type)
 1590:             continue;
 1591:         if (type == ImGuiInputEventType_Key && e->Key.Key != arg)
 1592:             continue;
 1593:         if (type == ImGuiInputEventType_MouseButton && e->MouseButton.Button != arg)
 1594:             continue;
 1595:         return e;
 1596:     }
 1597:     return NULL;
 1598: }
 1599: // Queue a new key down/up event.
 1600: // - ImGuiKey key:       Translated key (as in, generally ImGuiKey_A matches the key end-user would use to emit an 'A' character)
 1601: // - bool down:          Is the key down? use false to signify a key release.
 1602: // - float analog_value: 0.0f..1.0f
 1603: // IMPORTANT: THIS FUNCTION AND OTHER "ADD" GRABS THE CONTEXT FROM OUR INSTANCE.
 1604: // WE NEED TO ENSURE THAT ALL FUNCTION CALLS ARE FULFILLING THIS, WHICH IS WHY GetKeyData() HAS AN EXPLICIT CONTEXT.
 1605: void ImGuiIO::AddKeyAnalogEvent(ImGuiKey key, bool down, float analog_value)
 1606: {
 1607:     //if (e->Down) { IMGUI_DEBUG_LOG_IO("AddKeyEvent() Key='%s' %d, NativeKeycode = %d, NativeScancode = %d\n", ImGui::GetKeyName(e->Key), e->Down, e->NativeKeycode, e->NativeScancode); }
 1608:     IM_ASSERT(Ctx != NULL);
 1609:     if (key == ImGuiKey_None || !AppAcceptingEvents)
 1610:         return;
 1611:     ImGuiContext& g = *Ctx;
 1612:     IM_ASSERT(ImGui::IsNamedKeyOrMod(key)); // Backend needs to pass a valid ImGuiKey_ constant. 0..511 values are legacy native key codes which are not accepted by this API.
 1613:     IM_ASSERT(ImGui::IsAliasKey(key) == false); // Backend cannot submit ImGuiKey_MouseXXX values they are automatically inferred from AddMouseXXX() events.
 1614:     // MacOS: swap Cmd(Super) and Ctrl
 1615:     if (g.IO.ConfigMacOSXBehaviors)
 1616:     {
 1617:         if (key == ImGuiMod_Super)          { key = ImGuiMod_Ctrl; }
 1618:         else if (key == ImGuiMod_Ctrl)      { key = ImGuiMod_Super; }
 1619:         else if (key == ImGuiKey_LeftSuper) { key = ImGuiKey_LeftCtrl; }
 1620:         else if (key == ImGuiKey_RightSuper){ key = ImGuiKey_RightCtrl; }
 1621:         else if (key == ImGuiKey_LeftCtrl)  { key = ImGuiKey_LeftSuper; }
 1622:         else if (key == ImGuiKey_RightCtrl) { key = ImGuiKey_RightSuper; }
 1623:     }
 1624:     // Filter duplicate (in particular: key mods and gamepad analog values are commonly spammed)
 1625:     const ImGuiInputEvent* latest_event = FindLatestInputEvent(&g, ImGuiInputEventType_Key, (int)key);
 1626:     const ImGuiKeyData* key_data = ImGui::GetKeyData(&g, key);
 1627:     const bool latest_key_down = latest_event ? latest_event->Key.Down : key_data->Down;
 1628:     const float latest_key_analog = latest_event ? latest_event->Key.AnalogValue : key_data->AnalogValue;
 1629:     if (latest_key_down == down && latest_key_analog == analog_value)
 1630:         return;
 1631:     // Add event
 1632:     ImGuiInputEvent e;
 1633:     e.Type = ImGuiInputEventType_Key;
 1634:     e.Source = ImGui::IsGamepadKey(key) ? ImGuiInputSource_Gamepad : ImGuiInputSource_Keyboard;
 1635:     e.EventId = g.InputEventsNextEventId++;
 1636:     e.Key.Key = key;
 1637:     e.Key.Down = down;
 1638:     e.Key.AnalogValue = analog_value;
 1639:     g.InputEventsQueue.push_back(e);
 1640: }
 1641: void ImGuiIO::AddKeyEvent(ImGuiKey key, bool down)
 1642: {
 1643:     if (!AppAcceptingEvents)
 1644:         return;
 1645:     AddKeyAnalogEvent(key, down, down ? 1.0f : 0.0f);
 1646: }
 1647: // [Optional] Call after AddKeyEvent().
 1648: // Specify native keycode, scancode + Specify index for legacy <1.87 IsKeyXXX() functions with native indices.
 1649: // If you are writing a backend in 2022 or don't use IsKeyXXX() with native values that are not ImGuiKey values, you can avoid calling this.
 1650: void ImGuiIO::SetKeyEventNativeData(ImGuiKey key, int native_keycode, int native_scancode, int native_legacy_index)
 1651: {
 1652:     if (key == ImGuiKey_None)
 1653:         return;
 1654:     IM_ASSERT(ImGui::IsNamedKey(key)); // >= 512
 1655:     IM_ASSERT(native_legacy_index == -1 || ImGui::IsLegacyKey((ImGuiKey)native_legacy_index)); // >= 0 && <= 511
 1656:     IM_UNUSED(key);                 // Yet unused
 1657:     IM_UNUSED(native_keycode);      // Yet unused
 1658:     IM_UNUSED(native_scancode);     // Yet unused
 1659:     IM_UNUSED(native_legacy_index); // Yet unused
 1660: }
