4779: ImFontBaked* ImFontAtlasBakedGetOrAdd(ImFontAtlas* atlas, ImFont* font, float font_size, float font_rasterizer_density)
4780: {
4781:     // FIXME-NEWATLAS: Design for picking a nearest size based on some criteria?
4782:     // FIXME-NEWATLAS: Altering font density won't work right away.
4783:     IM_ASSERT(font_size > 0.0f && font_rasterizer_density > 0.0f);
