39: #include <string>
40: namespace Assimp {
41:     // XML escape the 5 XML special characters (",',<,> and &) in |data|
42:     // Based on http://stackoverflow.com/questions/5665231
43:     std::string XMLEscape(const std::string& data) {
44:         std::string buffer;
45:         const size_t size = data.size();
46:         buffer.reserve(size + size / 8);
47:         for(size_t i = 0; i < size; ++i) {
48:             const char c = data[i];
49:             switch(c) {
50:                 case '&' :
51:                     buffer.append("&amp;");
52:                     break;
53:                 case '\"':
54:                     buffer.append("&quot;");
55:                     break;
56:                 case '\'':
57:                     buffer.append("&apos;");
58:                     break;
59:                 case '<' :
60:                     buffer.append("&lt;");
61:                     break;
62:                 case '>' :
63:                     buffer.append("&gt;");
64:                     break;
65:                 default:
66:                     buffer.append(&c, 1);
67:                     break;
68:             }
69:         }
70:         return buffer;
71:     }
72: }
73: #endif // INCLUDED_ASSIMP_XML_TOOLS_H
</file>

