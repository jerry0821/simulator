 1252: // DLL users:
 1253: // - Heaps and globals are not shared across DLL boundaries!
 1254: // - You will need to call SetCurrentContext() + SetAllocatorFunctions() for each static/DLL boundary you are calling from.
 1255: // - Same applies for hot-reloading mechanisms that are reliant on reloading DLL (note that many hot-reloading mechanisms work without DLL).
 1256: // - Using Dear ImGui via a shared library is not recommended, because of function call overhead and because we don't guarantee backward nor forward ABI compatibility.
 1257: // - Confused? In a debugger: add GImGui to your watch window and notice how its value changes depending on your current location (which DLL boundary you are in).
 1258: // Current context pointer. Implicitly used by all Dear ImGui functions. Always assumed to be != NULL.
 1259: // - ImGui::CreateContext() will automatically set this pointer if it is NULL.
 1260: //   Change to a different context by calling ImGui::SetCurrentContext().
 1261: // - Important: Dear ImGui functions are not thread-safe because of this pointer.
 1262: //   If you want thread-safety to allow N threads to access N different contexts:
 1263: //   - Change this variable to use thread local storage so each thread can refer to a different context, in your imconfig.h:
 1264: //         struct ImGuiContext;
 1265: //         extern thread_local ImGuiContext* MyImGuiTLS;
 1266: //         #define GImGui MyImGuiTLS
 1267: //     And then define MyImGuiTLS in one of your cpp files. Note that thread_local is a C++11 keyword, earlier C++ uses compiler-specific keyword.
 1268: //   - Future development aims to make this context pointer explicit to all calls. Also read https://github.com/ocornut/imgui/issues/586
 1269: //   - If you need a finite number of contexts, you may compile and use multiple instances of the ImGui code from a different namespace.
 1270: // - DLL users: read comments above.
 1271: #ifndef GImGui
 1272: ImGuiContext*   GImGui = NULL;
 1273: #endif
 1274: // Memory Allocator functions. Use SetAllocatorFunctions() to change them.
 1275: // - You probably don't want to modify that mid-program, and if you use global/static e.g. ImVector<> instances you may need to keep them accessible during program destruction.
 1276: // - DLL users: read comments above.
 1277: #ifndef IMGUI_DISABLE_DEFAULT_ALLOCATORS
 1278: static void*   MallocWrapper(size_t size, void* user_data)    { IM_UNUSED(user_data); return malloc(size); }
 1279: static void    FreeWrapper(void* ptr, void* user_data)        { IM_UNUSED(user_data); free(ptr); }
 1280: #else
 1281: static void*   MallocWrapper(size_t size, void* user_data)    { IM_UNUSED(user_data); IM_UNUSED(size); IM_ASSERT(0); return NULL; }
 1282: static void    FreeWrapper(void* ptr, void* user_data)        { IM_UNUSED(user_data); IM_UNUSED(ptr); IM_ASSERT(0); }
 1283: #endif
