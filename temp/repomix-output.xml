 2225: ImFileHandle ImFileOpen(const char* filename, const char* mode)
 2226: {
 2227: #if defined(_WIN32) && !defined(IMGUI_DISABLE_WIN32_FUNCTIONS) && (defined(__MINGW32__) || (!defined(__CYGWIN__) && !defined(__GNUC__)))
 2228:     // We need a fopen() wrapper because MSVC/Windows fopen doesn't handle UTF-8 filenames.
 2229:     // Previously we used ImTextCountCharsFromUtf8/ImTextStrFromUtf8 here but we now need to support ImWchar16 and ImWchar32!
 2230:     const int filename_wsize = ::MultiByteToWideChar(CP_UTF8, 0, filename, -1, NULL, 0);
 2231:     const int mode_wsize = ::MultiByteToWideChar(CP_UTF8, 0, mode, -1, NULL, 0);
 2232:     // Use stack buffer if possible, otherwise heap buffer. Sizes include zero terminator.
 2233:     // We don't rely on current ImGuiContext as this is implied to be a helper function which doesn't depend on it (see #7314).
 2234:     wchar_t local_temp_stack[FILENAME_MAX];
 2235:     ImVector<wchar_t> local_temp_heap;
 2236:     if (filename_wsize + mode_wsize > IM_ARRAYSIZE(local_temp_stack))
 2237:         local_temp_heap.resize(filename_wsize + mode_wsize);
 2238:     wchar_t* filename_wbuf = local_temp_heap.Data ? local_temp_heap.Data : local_temp_stack;
 2239:     wchar_t* mode_wbuf = filename_wbuf + filename_wsize;
 2240:     ::MultiByteToWideChar(CP_UTF8, 0, filename, -1, filename_wbuf, filename_wsize);
 2241:     ::MultiByteToWideChar(CP_UTF8, 0, mode, -1, mode_wbuf, mode_wsize);
 2242:     return ::_wfopen(filename_wbuf, mode_wbuf);
 2243: #else
 2244:     return fopen(filename, mode);
 2245: #endif
 2246: }
