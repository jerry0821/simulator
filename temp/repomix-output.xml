388: ///	@brief  This class declares an iterator to loop through all children of the root node.
389: class XmlNodeIterator {
390: public:
391:     /// @brief The iteration mode.
392:     enum IterationMode {
393:         PreOrderMode, ///< Pre-ordering, get the values, continue the iteration.
394:         PostOrderMode ///< Post-ordering, continue the iteration, get the values.
395:     };
396:     ///	@brief  The class constructor
397:     /// @param  parent      [in] The xml parent to to iterate through.
398:     /// @param  mode        [in] The iteration mode.
399:     explicit XmlNodeIterator(XmlNode &parent, IterationMode mode) :
400:             mParent(parent),
401:             mNodes(),
402:             mIndex(0) {
403:         if (mode == PreOrderMode) {
404:             collectChildrenPreOrder(parent);
405:         } else {
406:             collectChildrenPostOrder(parent);
407:         }
408:     }
409:     ///	@brief  The class destructor, default implementation.
410:     ~XmlNodeIterator() = default;
411:     ///	@brief  Will iterate through all children in pre-order iteration.
412:     /// @param  node    [in] The nod to iterate through.
413:     void collectChildrenPreOrder(XmlNode &node) {
414:         if (node != mParent && node.type() == pugi::node_element) {
415:             mNodes.push_back(node);
416:         }
417:         for (XmlNode currentNode : node.children()) {
418:             collectChildrenPreOrder(currentNode);
419:         }
420:     }
421:     ///	@brief  Will iterate through all children in post-order iteration.
422:     /// @param  node    [in] The nod to iterate through.
423:     void collectChildrenPostOrder(XmlNode &node) {
424:         for (XmlNode currentNode = node.first_child(); currentNode; currentNode = currentNode.next_sibling()) {
425:             collectChildrenPostOrder(currentNode);
426:         }
427:         if (node != mParent) {
428:             mNodes.push_back(node);
429:         }
430:     }
431:     ///	@brief  Will iterate through all collected nodes.
432:     /// @param  next    The next node, if there is any.
433:     /// @return true, if there is a node left.
434:     bool getNext(XmlNode &next) {
435:         if (mIndex == mNodes.size()) {
436:             return false;
437:         }
438:         next = mNodes[mIndex];
439:         ++mIndex;
440:         return true;
441:     }
442:     ///	@brief  Will return the number of collected nodes.
443:     /// @return The number of collected nodes.
444:     size_t size() const {
445:         return mNodes.size();
446:     }
447:     ///	@brief  Returns true, if the node is empty.
448:     /// @return true, if the node is empty, false if not.
449:     bool isEmpty() const {
450:         return mNodes.empty();
451:     }
452:     ///	@brief  Will clear all collected nodes.
453:     void clear() {
454:         if (mNodes.empty()) {
455:             return;
456:         }
457:         mNodes.clear();
458:         mIndex = 0;
459:     }
460: private:
461:     XmlNode &mParent;
462:     std::vector<XmlNode> mNodes;
463:     size_t mIndex;
464: };
465: } // namespace Assimp
