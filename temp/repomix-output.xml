11373: static void ImGui::UpdateWindowInFocusOrderList(ImGuiWindow* window, bool just_created, ImGuiWindowFlags new_flags)
11374: {
11375:     ImGuiContext& g = *GImGui;
11376:     const bool new_is_explicit_child = (new_flags & ImGuiWindowFlags_ChildWindow) != 0 && ((new_flags & ImGuiWindowFlags_Popup) == 0 || (new_flags & ImGuiWindowFlags_ChildMenu) != 0);
11377:     const bool child_flag_changed = new_is_explicit_child != window->IsExplicitChild;
11378:     if ((just_created || child_flag_changed) && !new_is_explicit_child)
11379:     {
11380:         IM_ASSERT(!g.WindowsFocusOrder.contains(window));
11381:         g.WindowsFocusOrder.push_back(window);
11382:         window->FocusOrder = (short)(g.WindowsFocusOrder.Size - 1);
11383:     }
11384:     else if (!just_created && child_flag_changed && new_is_explicit_child)
11385:     {
11386:         IM_ASSERT(g.WindowsFocusOrder[window->FocusOrder] == window);
11387:         for (int n = window->FocusOrder + 1; n < g.WindowsFocusOrder.Size; n++)
11388:             g.WindowsFocusOrder[n]->FocusOrder--;
11389:         g.WindowsFocusOrder.erase(g.WindowsFocusOrder.Data + window->FocusOrder);
11390:         window->FocusOrder = -1;
11391:     }
11392:     window->IsExplicitChild = new_is_explicit_child;
11393: }
11394: void ImGui::BringWindowToFocusFront(ImGuiWindow* window)
11395: {
11396:     ImGuiContext& g = *GImGui;
11397:     IM_ASSERT(window == window->RootWindow);
11398:     const int cur_order = window->FocusOrder;
11399:     IM_ASSERT(g.WindowsFocusOrder[cur_order] == window);
11400:     if (g.WindowsFocusOrder.back() == window)
11401:         return;
11402:     const int new_order = g.WindowsFocusOrder.Size - 1;
11403:     for (int n = cur_order; n < new_order; n++)
11404:     {
11405:         g.WindowsFocusOrder[n] = g.WindowsFocusOrder[n + 1];
11406:         g.WindowsFocusOrder[n]->FocusOrder--;
11407:         IM_ASSERT(g.WindowsFocusOrder[n]->FocusOrder == n);
11408:     }
11409:     g.WindowsFocusOrder[new_order] = window;
11410:     window->FocusOrder = (short)new_order;
11411: }
11412: // Note technically focus related but rather adjacent and close to BringWindowToFocusFront()
11413: void ImGui::BringWindowToDisplayFront(ImGuiWindow* window)
11414: {
11415:     ImGuiContext& g = *GImGui;
11416:     ImGuiWindow* current_front_window = g.Windows.back();
11417:     if (current_front_window == window || current_front_window->RootWindow == window) // Cheap early out (could be better)
11418:         return;
11419:     for (int i = g.Windows.Size - 2; i >= 0; i--) // We can ignore the top-most window
11420:         if (g.Windows[i] == window)
11421:         {
11422:             memmove(&g.Windows[i], &g.Windows[i + 1], (size_t)(g.Windows.Size - i - 1) * sizeof(ImGuiWindow*));
11423:             g.Windows[g.Windows.Size - 1] = window;
11424:             break;
11425:         }
11426: }
