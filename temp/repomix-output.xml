3269: // Create a compact, baked "..." if it doesn't exist, by using the ".".
3270: // This may seem overly complicated right now but the point is to exercise and improve a technique which should be increasingly used.
3271: // FIXME-NEWATLAS: This borrows too much from FontLoader's FontLoadGlyph() handlers and suggest that we should add further helpers.
3272: static ImFontGlyph* ImFontAtlasBuildSetupFontBakedEllipsis(ImFontAtlas* atlas, ImFontBaked* baked)
3273: {
3274:     ImFont* font = baked->OwnerFont;
3275:     IM_ASSERT(font->EllipsisChar != 0);
3276:     const ImFontGlyph* dot_glyph = baked->FindGlyphNoFallback((ImWchar)'.');
3277:     if (dot_glyph == NULL)
3278:         dot_glyph = baked->FindGlyphNoFallback((ImWchar)0xFF0E);
3279:     if (dot_glyph == NULL)
3280:         return NULL;
3281:     ImFontAtlasRectId dot_r_id = dot_glyph->PackId; // Deep copy to avoid invalidation of glyphs and rect pointers
3282:     ImTextureRect* dot_r = ImFontAtlasPackGetRect(atlas, dot_r_id);
3283:     const int dot_spacing = 1;
3284:     const float dot_step = (dot_glyph->X1 - dot_glyph->X0) + dot_spacing;
3285:     ImFontAtlasRectId pack_id = ImFontAtlasPackAddRect(atlas, (dot_r->w * 3 + dot_spacing * 2), dot_r->h);
3286:     ImTextureRect* r = ImFontAtlasPackGetRect(atlas, pack_id);
3287:     ImFontGlyph glyph_in = {};
3288:     ImFontGlyph* glyph = &glyph_in;
3289:     glyph->Codepoint = font->EllipsisChar;
3290:     glyph->AdvanceX = ImMax(dot_glyph->AdvanceX, dot_glyph->X0 + dot_step * 3.0f - dot_spacing); // FIXME: Slightly odd for normally mono-space fonts but since this is used for trailing contents.
3291:     glyph->X0 = dot_glyph->X0;
3292:     glyph->Y0 = dot_glyph->Y0;
3293:     glyph->X1 = dot_glyph->X0 + dot_step * 3 - dot_spacing;
3294:     glyph->Y1 = dot_glyph->Y1;
3295:     glyph->Visible = true;
3296:     glyph->PackId = pack_id;
3297:     glyph = ImFontAtlasBakedAddFontGlyph(atlas, baked, NULL, glyph);
3298:     dot_glyph = NULL; // Invalidated
3299:     // Copy to texture, post-process and queue update for backend
3300:     // FIXME-NEWATLAS-V2: Dot glyph is already post-processed as this point, so this would damage it.
3301:     dot_r = ImFontAtlasPackGetRect(atlas, dot_r_id);
3302:     ImTextureData* tex = atlas->TexData;
3303:     for (int n = 0; n < 3; n++)
3304:         ImFontAtlasTextureBlockCopy(tex, dot_r->x, dot_r->y, tex, r->x + (dot_r->w + dot_spacing) * n, r->y, dot_r->w, dot_r->h);
3305:     ImFontAtlasTextureBlockQueueUpload(atlas, tex, r->x, r->y, r->w, r->h);
3306:     return glyph;
3307: }
3308: // Load fallback in order to obtain its index
3309: // (this is called from in hot-path so we avoid extraneous parameters to minimize impact on code size)
3310: static void ImFontAtlasBuildSetupFontBakedFallback(ImFontBaked* baked)
3311: {
3312:     IM_ASSERT(baked->FallbackGlyphIndex == -1);
3313:     IM_ASSERT(baked->FallbackAdvanceX == 0.0f);
3314:     ImFont* font = baked->OwnerFont;
3315:     ImFontGlyph* fallback_glyph = NULL;
3316:     if (font->FallbackChar != 0)
3317:         fallback_glyph = baked->FindGlyphNoFallback(font->FallbackChar);
3318:     if (fallback_glyph == NULL)
3319:     {
3320:         ImFontGlyph* space_glyph = baked->FindGlyphNoFallback((ImWchar)' ');
3321:         ImFontGlyph glyph;
3322:         glyph.Codepoint = 0;
3323:         glyph.AdvanceX = space_glyph ? space_glyph->AdvanceX : IM_ROUND(baked->Size * 0.40f);
3324:         fallback_glyph = ImFontAtlasBakedAddFontGlyph(font->OwnerAtlas, baked, NULL, &glyph);
3325:     }
3326:     baked->FallbackGlyphIndex = baked->Glyphs.index_from_ptr(fallback_glyph); // Storing index avoid need to update pointer on growth and simplify inner loop code
3327:     baked->FallbackAdvanceX = fallback_glyph->AdvanceX;
3328: }
3329: static void ImFontAtlasBuildSetupFontBakedBlanks(ImFontAtlas* atlas, ImFontBaked* baked)
3330: {
3331:     // Mark space as always hidden (not strictly correct/necessary. but some e.g. icons fonts don't have a space. it tends to look neater in previews)
3332:     ImFontGlyph* space_glyph = baked->FindGlyphNoFallback((ImWchar)' ');
3333:     if (space_glyph != NULL)
3334:         space_glyph->Visible = false;
3335:     // Setup Tab character.
3336:     // FIXME: Needs proper TAB handling but it needs to be contextualized (or we could arbitrary say that each string starts at "column 0" ?)
3337:     if (baked->FindGlyphNoFallback('\t') == NULL && space_glyph != NULL)
3338:     {
3339:         ImFontGlyph tab_glyph;
3340:         tab_glyph.Codepoint = '\t';
3341:         tab_glyph.AdvanceX = space_glyph->AdvanceX * IM_TABSIZE;
3342:         ImFontAtlasBakedAddFontGlyph(atlas, baked, NULL, &tab_glyph);
3343:     }
3344: }
3345: // Load/identify special glyphs
3346: // (note that this is called again for fonts with MergeMode)
3347: void ImFontAtlasBuildSetupFontSpecialGlyphs(ImFontAtlas* atlas, ImFont* font, ImFontConfig* src)
3348: {
3349:     IM_UNUSED(atlas);
3350:     IM_ASSERT(font->Sources.contains(src));
3351:     // Find Fallback character. Actual glyph loaded in GetFontBaked().
3352:     const ImWchar fallback_chars[] = { font->FallbackChar, (ImWchar)IM_UNICODE_CODEPOINT_INVALID, (ImWchar)'?', (ImWchar)' ' };
3353:     if (font->FallbackChar == 0)
3354:         for (ImWchar candidate_char : fallback_chars)
3355:             if (candidate_char != 0 && font->IsGlyphInFont(candidate_char))
3356:             {
3357:                 font->FallbackChar = (ImWchar)candidate_char;
3358:                 break;
3359:             }
3360:     // Setup Ellipsis character. It is required for rendering elided text. We prefer using U+2026 (horizontal ellipsis).
3361:     // However some old fonts may contain ellipsis at U+0085. Here we auto-detect most suitable ellipsis character.
3362:     // FIXME: Note that 0x2026 is rarely included in our font ranges. Because of this we are more likely to use three individual dots.
3363:     const ImWchar ellipsis_chars[] = { src->EllipsisChar, (ImWchar)0x2026, (ImWchar)0x0085 };
3364:     if (font->EllipsisChar == 0)
3365:         for (ImWchar candidate_char : ellipsis_chars)
3366:             if (candidate_char != 0 && font->IsGlyphInFont(candidate_char))
3367:             {
3368:                 font->EllipsisChar = candidate_char;
3369:                 break;
3370:             }
3371:     if (font->EllipsisChar == 0)
3372:     {
3373:         font->EllipsisChar = 0x0085;
3374:         font->EllipsisAutoBake = true;
3375:     }
3376: }
3377: void ImFontAtlasBakedDiscardFontGlyph(ImFontAtlas* atlas, ImFont* font, ImFontBaked* baked, ImFontGlyph* glyph)
3378: {
3379:     if (glyph->PackId != ImFontAtlasRectId_Invalid)
3380:     {
3381:         ImFontAtlasPackDiscardRect(atlas, glyph->PackId);
3382:         glyph->PackId = ImFontAtlasRectId_Invalid;
3383:     }
3384:     ImWchar c = (ImWchar)glyph->Codepoint;
3385:     IM_ASSERT(font->FallbackChar != c && font->EllipsisChar != c); // Unsupported for simplicity
3386:     IM_ASSERT(glyph >= baked->Glyphs.Data && glyph < baked->Glyphs.Data + baked->Glyphs.Size);
3387:     IM_UNUSED(font);
3388:     baked->IndexLookup[c] = IM_FONTGLYPH_INDEX_UNUSED;
3389:     baked->IndexAdvanceX[c] = baked->FallbackAdvanceX;
3390: }
3391: ImFontBaked* ImFontAtlasBakedAdd(ImFontAtlas* atlas, ImFont* font, float font_size, float font_rasterizer_density, ImGuiID baked_id)
3392: {
3393:     IMGUI_DEBUG_LOG_FONT("[font] Created baked %.2fpx\n", font_size);
3394:     ImFontBaked* baked = atlas->Builder->BakedPool.push_back(ImFontBaked());
3395:     baked->Size = font_size;
3396:     baked->RasterizerDensity = font_rasterizer_density;
3397:     baked->BakedId = baked_id;
3398:     baked->OwnerFont = font;
3399:     baked->LastUsedFrame = atlas->Builder->FrameCount;
3400:     // Initialize backend data
3401:     size_t loader_data_size = 0;
3402:     for (ImFontConfig* src : font->Sources) // Cannot easily be cached as we allow changing backend
3403:     {
3404:         const ImFontLoader* loader = src->FontLoader ? src->FontLoader : atlas->FontLoader;
3405:         loader_data_size += loader->FontBakedSrcLoaderDataSize;
3406:     }
3407:     baked->FontLoaderDatas = (loader_data_size > 0) ? IM_ALLOC(loader_data_size) : NULL;
3408:     char* loader_data_p = (char*)baked->FontLoaderDatas;
3409:     for (ImFontConfig* src : font->Sources)
3410:     {
3411:         const ImFontLoader* loader = src->FontLoader ? src->FontLoader : atlas->FontLoader;
3412:         if (loader->FontBakedInit)
3413:             loader->FontBakedInit(atlas, src, baked, loader_data_p);
3414:         loader_data_p += loader->FontBakedSrcLoaderDataSize;
3415:     }
3416:     ImFontAtlasBuildSetupFontBakedBlanks(atlas, baked);
3417:     return baked;
3418: }
3419: // FIXME-OPT: This is not a fast query. Adding a BakedCount field in Font might allow to take a shortcut for the most common case.
3420: ImFontBaked* ImFontAtlasBakedGetClosestMatch(ImFontAtlas* atlas, ImFont* font, float font_size, float font_rasterizer_density)
3421: {
3422:     ImFontAtlasBuilder* builder = atlas->Builder;
3423:     for (int step_n = 0; step_n < 2; step_n++)
3424:     {
3425:         ImFontBaked* closest_larger_match = NULL;
3426:         ImFontBaked* closest_smaller_match = NULL;
3427:         for (int baked_n = 0; baked_n < builder->BakedPool.Size; baked_n++)
3428:         {
3429:             ImFontBaked* baked = &builder->BakedPool[baked_n];
3430:             if (baked->OwnerFont != font || baked->WantDestroy)
3431:                 continue;
3432:             if (step_n == 0 && baked->RasterizerDensity != font_rasterizer_density) // First try with same density
3433:                 continue;
3434:             if (baked->Size > font_size && (closest_larger_match == NULL || baked->Size < closest_larger_match->Size))
3435:                 closest_larger_match = baked;
3436:             if (baked->Size < font_size && (closest_smaller_match == NULL || baked->Size > closest_smaller_match->Size))
3437:                 closest_smaller_match = baked;
3438:         }
3439:         if (closest_larger_match)
3440:             if (closest_smaller_match == NULL || (closest_larger_match->Size >= font_size * 2.0f && closest_smaller_match->Size > font_size * 0.5f))
3441:                 return closest_larger_match;
3442:         if (closest_smaller_match)
3443:             return closest_smaller_match;
3444:     }
3445:     return NULL;
3446: }
3447: void ImFontAtlasBakedDiscard(ImFontAtlas* atlas, ImFont* font, ImFontBaked* baked)
3448: {
3449:     ImFontAtlasBuilder* builder = atlas->Builder;
3450:     IMGUI_DEBUG_LOG_FONT("[font] Discard baked %.2f for \"%s\"\n", baked->Size, font->GetDebugName());
3451:     for (ImFontGlyph& glyph : baked->Glyphs)
3452:         if (glyph.PackId != ImFontAtlasRectId_Invalid)
3453:             ImFontAtlasPackDiscardRect(atlas, glyph.PackId);
3454:     char* loader_data_p = (char*)baked->FontLoaderDatas;
3455:     for (ImFontConfig* src : font->Sources)
3456:     {
3457:         const ImFontLoader* loader = src->FontLoader ? src->FontLoader : atlas->FontLoader;
3458:         if (loader->FontBakedDestroy)
3459:             loader->FontBakedDestroy(atlas, src, baked, loader_data_p);
3460:         loader_data_p += loader->FontBakedSrcLoaderDataSize;
3461:     }
3462:     if (baked->FontLoaderDatas)
3463:     {
3464:         IM_FREE(baked->FontLoaderDatas);
3465:         baked->FontLoaderDatas = NULL;
3466:     }
3467:     builder->BakedMap.SetVoidPtr(baked->BakedId, NULL);
3468:     builder->BakedDiscardedCount++;
3469:     baked->ClearOutputData();
3470:     baked->WantDestroy = true;
3471:     font->LastBaked = NULL;
3472: }
3473: // use unused_frames==0 to discard everything.
3474: void ImFontAtlasFontDiscardBakes(ImFontAtlas* atlas, ImFont* font, int unused_frames)
3475: {
3476:     if (ImFontAtlasBuilder* builder = atlas->Builder) // This can be called from font destructor
3477:         for (int baked_n = 0; baked_n < builder->BakedPool.Size; baked_n++)
3478:         {
3479:             ImFontBaked* baked = &builder->BakedPool[baked_n];
3480:             if (baked->LastUsedFrame + unused_frames > atlas->Builder->FrameCount)
3481:                 continue;
3482:             if (baked->OwnerFont != font || baked->WantDestroy)
3483:                 continue;
3484:             ImFontAtlasBakedDiscard(atlas, font, baked);
3485:         }
3486: }
3487: // use unused_frames==0 to discard everything.
3488: void ImFontAtlasBuildDiscardBakes(ImFontAtlas* atlas, int unused_frames)
3489: {
3490:     ImFontAtlasBuilder* builder = atlas->Builder;
3491:     for (int baked_n = 0; baked_n < builder->BakedPool.Size; baked_n++)
3492:     {
3493:         ImFontBaked* baked = &builder->BakedPool[baked_n];
3494:         if (baked->LastUsedFrame + unused_frames > atlas->Builder->FrameCount)
3495:             continue;
3496:         if (baked->WantDestroy || (baked->OwnerFont->Flags & ImFontFlags_LockBakedSizes))
3497:             continue;
3498:         ImFontAtlasBakedDiscard(atlas, baked->OwnerFont, baked);
3499:     }
3500: }
