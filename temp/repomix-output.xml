 3167: ImU32 ImGui::GetColorU32(ImU32 col, float alpha_mul)
 3168: {
 3169:     ImGuiStyle& style = GImGui->Style;
 3170:     alpha_mul *= style.Alpha;
 3171:     if (alpha_mul >= 1.0f)
 3172:         return col;
 3173:     ImU32 a = (col & IM_COL32_A_MASK) >> IM_COL32_A_SHIFT;
 3174:     a = (ImU32)(a * alpha_mul); // We don't need to clamp 0..255 because alpha is in 0..1 range.
 3175:     return (col & ~IM_COL32_A_MASK) | (a << IM_COL32_A_SHIFT);
 3176: }
