 5843: static void ApplyWindowSettings(ImGuiWindow* window, ImGuiWindowSettings* settings)
 5844: {
 5845:     window->Pos = ImTrunc(ImVec2(settings->Pos.x, settings->Pos.y));
 5846:     if (settings->Size.x > 0 && settings->Size.y > 0)
 5847:         window->Size = window->SizeFull = ImTrunc(ImVec2(settings->Size.x, settings->Size.y));
 5848:     window->Collapsed = settings->Collapsed;
 5849: }
 5850: static void InitOrLoadWindowSettings(ImGuiWindow* window, ImGuiWindowSettings* settings)
 5851: {
 5852:     // Initial window state with e.g. default/arbitrary window position
 5853:     // Use SetNextWindowPos() with the appropriate condition flag to change the initial position of a window.
 5854:     const ImGuiViewport* main_viewport = ImGui::GetMainViewport();
 5855:     window->Pos = main_viewport->Pos + ImVec2(60, 60);
 5856:     window->Size = window->SizeFull = ImVec2(0, 0);
 5857:     window->SetWindowPosAllowFlags = window->SetWindowSizeAllowFlags = window->SetWindowCollapsedAllowFlags = ImGuiCond_Always | ImGuiCond_Once | ImGuiCond_FirstUseEver | ImGuiCond_Appearing;
 5858:     if (settings != NULL)
 5859:     {
 5860:         SetWindowConditionAllowFlags(window, ImGuiCond_FirstUseEver, false);
 5861:         ApplyWindowSettings(window, settings);
 5862:     }
 5863:     window->DC.CursorStartPos = window->DC.CursorMaxPos = window->DC.IdealMaxPos = window->Pos; // So first call to CalcWindowContentSizes() doesn't return crazy values
 5864:     if ((window->Flags & ImGuiWindowFlags_AlwaysAutoResize) != 0)
 5865:     {
 5866:         window->AutoFitFramesX = window->AutoFitFramesY = 2;
 5867:         window->AutoFitOnlyGrows = false;
 5868:     }
 5869:     else
 5870:     {
 5871:         if (window->Size.x <= 0.0f)
 5872:             window->AutoFitFramesX = 2;
 5873:         if (window->Size.y <= 0.0f)
 5874:             window->AutoFitFramesY = 2;
 5875:         window->AutoFitOnlyGrows = (window->AutoFitFramesX > 0) || (window->AutoFitFramesY > 0);
 5876:     }
 5877: }
