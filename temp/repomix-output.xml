16011: // Update queries. The steps are: -1: query Stack, >= 0: query each stack item
16012: // We can only perform 1 ID Info query every frame. This is designed so the GetID() tests are cheap and constant-time
16013: static ImGuiID DebugItemPathQuery_UpdateAndGetHookId(ImGuiDebugItemPathQuery* query, ImGuiID id)
16014: {
16015:     // Update query. Clear hook when no active query
16016:     if (query->MainID != id)
16017:     {
16018:         query->MainID = id;
16019:         query->Step = -1;
16020:         query->Complete = false;
16021:         query->Results.resize(0);
16022:         query->ResultsDescBuf.resize(0);
16023:     }
16024:     query->Active = false;
16025:     if (id == 0)
16026:         return 0;
16027:     // Advance to next stack level when we got our result, or after 2 frames (in case we never get a result)
16028:     if (query->Step >= 0 && query->Step < query->Results.Size)
16029:         if (query->Results[query->Step].QuerySuccess || query->Results[query->Step].QueryFrameCount > 2)
16030:             query->Step++;
16031:     // Update status and hook
16032:     query->Complete = (query->Step == query->Results.Size);
16033:     if (query->Step == -1)
16034:     {
16035:         query->Active = true;
16036:         return id;
16037:     }
16038:     else if (query->Step >= 0 && query->Step < query->Results.Size)
16039:     {
16040:         query->Results[query->Step].QueryFrameCount++;
16041:         query->Active = true;
16042:         return query->Results[query->Step].ID;
16043:     }
16044:     return 0;
16045: }
