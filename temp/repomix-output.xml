 33: /** @file Defines a helper class to represent an interleaved vertex
 34:   along with arithmetic operations to support vertex operations
 35:   such as subdivision, smoothing etc.
 36:   While the code is kept as general as possible, arithmetic operations
 37:   that are not currently well-defined (and would cause compile errors
 38:   due to missing operators in the math library), are commented.
 39:   */
 40: #pragma once
 41: #ifndef AI_VERTEX_H_INC
 42: #define AI_VERTEX_H_INC
 43: #ifdef __GNUC__
 44: #   pragma GCC system_header
 45: #endif
 46: #include "vector3.h"
 47: #include "mesh.h"
 48: #include "ai_assert.h"
 49: #include <functional>
 50: namespace Assimp    {
 51:     ///////////////////////////////////////////////////////////////////////////
 52:     // std::plus-family operates on operands with identical types - we need to
 53:     // support all the (vectype op float) combinations in vector maths.
 54:     // Providing T(float) would open the way to endless implicit conversions.
 55:     ///////////////////////////////////////////////////////////////////////////
 56:     namespace Intern {
 57:         template <typename T0, typename T1, typename TRES = T0> struct plus {
 58:             TRES operator() (const T0& t0, const T1& t1) const {
 59:                 return t0+t1;
 60:             }
 61:         };
 62:         template <typename T0, typename T1, typename TRES = T0> struct minus {
 63:             TRES operator() (const T0& t0, const T1& t1) const {
 64:                 return t0-t1;
 65:             }
 66:         };
 67:         template <typename T0, typename T1, typename TRES = T0> struct multiplies {
 68:             TRES operator() (const T0& t0, const T1& t1) const {
 69:                 return t0*t1;
 70:             }
 71:         };
 72:         template <typename T0, typename T1, typename TRES = T0> struct divides {
 73:             TRES operator() (const T0& t0, const T1& t1) const {
 74:                 return t0/t1;
 75:             }
 76:         };
 77:     }
 78: // ------------------------------------------------------------------------------------------------
 79: /** Intermediate description a vertex with all possible components. Defines a full set of
 80:  *  operators, so you may use such a 'Vertex' in basic arithmetic. All operators are applied
 81:  *  to *all* vertex components equally. This is useful for stuff like interpolation
 82:  *  or subdivision, but won't work if special handling is required for some vertex components. */
 83: // ------------------------------------------------------------------------------------------------
 84: class Vertex {
 85:     friend Vertex operator + (const Vertex&,const Vertex&);
 86:     friend Vertex operator - (const Vertex&,const Vertex&);
 87:     friend Vertex operator * (const Vertex&,ai_real);
 88:     friend Vertex operator / (const Vertex&,ai_real);
 89:     friend Vertex operator * (ai_real, const Vertex&);
 90: public:
 91:     Vertex() {}
 92:     // ----------------------------------------------------------------------------
 93:     /** Extract a particular vertex from a mesh and interleave all components */
 94:     explicit Vertex(const aiMesh* msh, unsigned int idx) {
 95:         ai_assert(idx < msh->mNumVertices);
 96:         position = msh->mVertices[idx];
 97:         if (msh->HasNormals()) {
 98:             normal = msh->mNormals[idx];
 99:         }
100:         if (msh->HasTangentsAndBitangents()) {
101:             tangent = msh->mTangents[idx];
102:             bitangent = msh->mBitangents[idx];
103:         }
104:         for (unsigned int i = 0; msh->HasTextureCoords(i); ++i) {
105:             texcoords[i] = msh->mTextureCoords[i][idx];
106:         }
107:         for (unsigned int i = 0; msh->HasVertexColors(i); ++i) {
108:             colors[i] = msh->mColors[i][idx];
109:         }
110:     }
111:     // ----------------------------------------------------------------------------
112:     /** Extract a particular vertex from a anim mesh and interleave all components */
113:     explicit Vertex(const aiAnimMesh* msh, unsigned int idx) {
114:         ai_assert(idx < msh->mNumVertices);
115:         if (msh->HasPositions()) {
116:             position = msh->mVertices[idx];
117:         }
118:         if (msh->HasNormals()) {
119:             normal = msh->mNormals[idx];
120:         }
121:         if (msh->HasTangentsAndBitangents()) {
122:             tangent = msh->mTangents[idx];
123:             bitangent = msh->mBitangents[idx];
124:         }
125:         for (unsigned int i = 0; msh->HasTextureCoords(i); ++i) {
126:             texcoords[i] = msh->mTextureCoords[i][idx];
127:         }
128:         for (unsigned int i = 0; msh->HasVertexColors(i); ++i) {
129:            colors[i] = msh->mColors[i][idx];
130:         }
131:     }
132:     Vertex& operator += (const Vertex& v) {
133:         *this = *this+v;
134:         return *this;
135:     }
136:     Vertex& operator -= (const Vertex& v) {
137:         *this = *this-v;
138:         return *this;
139:     }
140:     Vertex& operator *= (ai_real v) {
141:         *this = *this*v;
142:         return *this;
143:     }
144:     Vertex& operator /= (ai_real v) {
145:         *this = *this/v;
146:         return *this;
147:     }
148:     // ----------------------------------------------------------------------------
149:     /** Convert back to non-interleaved storage */
150:     void SortBack(aiMesh* out, unsigned int idx) const {
151:         ai_assert(idx<out->mNumVertices);
152:         out->mVertices[idx] = position;
153:         if (out->HasNormals()) {
154:             out->mNormals[idx] = normal;
155:         }
156:         if (out->HasTangentsAndBitangents()) {
157:             out->mTangents[idx] = tangent;
158:             out->mBitangents[idx] = bitangent;
159:         }
160:         for(unsigned int i = 0; out->HasTextureCoords(i); ++i) {
161:             out->mTextureCoords[i][idx] = texcoords[i];
162:         }
163:         for(unsigned int i = 0; out->HasVertexColors(i); ++i) {
164:             out->mColors[i][idx] = colors[i];
165:         }
166:     }
167: private:
168:     // ----------------------------------------------------------------------------
169:     /** Construct from two operands and a binary operation to combine them */
170:     template <template <typename t> class op> static Vertex BinaryOp(const Vertex& v0, const Vertex& v1) {
171:         // this is a heavy task for the compiler to optimize ... *pray*
172:         Vertex res;
173:         res.position  = op<aiVector3D>()(v0.position,v1.position);
174:         res.normal    = op<aiVector3D>()(v0.normal,v1.normal);
175:         res.tangent   = op<aiVector3D>()(v0.tangent,v1.tangent);
176:         res.bitangent = op<aiVector3D>()(v0.bitangent,v1.bitangent);
177:         for (unsigned int i = 0; i < AI_MAX_NUMBER_OF_TEXTURECOORDS; ++i) {
178:             res.texcoords[i] = op<aiVector3D>()(v0.texcoords[i],v1.texcoords[i]);
179:         }
180:         for (unsigned int i = 0; i < AI_MAX_NUMBER_OF_COLOR_SETS; ++i) {
181:             res.colors[i] = op<aiColor4D>()(v0.colors[i],v1.colors[i]);
182:         }
183:         return res;
184:     }
185:     // ----------------------------------------------------------------------------
186:     /** This time binary arithmetic of v0 with a floating-point number */
187:     template <template <typename, typename, typename> class op> static Vertex BinaryOp(const Vertex& v0, ai_real f) {
188:         // this is a heavy task for the compiler to optimize ... *pray*
189:         Vertex res;
190:         res.position  = op<aiVector3D,ai_real,aiVector3D>()(v0.position,f);
191:         res.normal    = op<aiVector3D,ai_real,aiVector3D>()(v0.normal,f);
192:         res.tangent   = op<aiVector3D,ai_real,aiVector3D>()(v0.tangent,f);
193:         res.bitangent = op<aiVector3D,ai_real,aiVector3D>()(v0.bitangent,f);
194:         for (unsigned int i = 0; i < AI_MAX_NUMBER_OF_TEXTURECOORDS; ++i) {
195:             res.texcoords[i] = op<aiVector3D,ai_real,aiVector3D>()(v0.texcoords[i],f);
196:         }
197:         for (unsigned int i = 0; i < AI_MAX_NUMBER_OF_COLOR_SETS; ++i) {
198:             res.colors[i] = op<aiColor4D,ai_real,aiColor4D>()(v0.colors[i],f);
199:         }
200:         return res;
201:     }
202:     // ----------------------------------------------------------------------------
203:     /** This time binary arithmetic of v0 with a floating-point number */
204:     template <template <typename, typename, typename> class op> static Vertex BinaryOp(ai_real f, const Vertex& v0) {
205:         // this is a heavy task for the compiler to optimize ... *pray*
206:         Vertex res;
207:         res.position  = op<ai_real,aiVector3D,aiVector3D>()(f,v0.position);
208:         res.normal    = op<ai_real,aiVector3D,aiVector3D>()(f,v0.normal);
209:         res.tangent   = op<ai_real,aiVector3D,aiVector3D>()(f,v0.tangent);
210:         res.bitangent = op<ai_real,aiVector3D,aiVector3D>()(f,v0.bitangent);
211:         for (unsigned int i = 0; i < AI_MAX_NUMBER_OF_TEXTURECOORDS; ++i) {
212:             res.texcoords[i] = op<ai_real,aiVector3D,aiVector3D>()(f,v0.texcoords[i]);
213:         }
214:         for (unsigned int i = 0; i < AI_MAX_NUMBER_OF_COLOR_SETS; ++i) {
215:             res.colors[i] = op<ai_real,aiColor4D,aiColor4D>()(f,v0.colors[i]);
216:         }
217:         return res;
218:     }
219: public:
220:     aiVector3D position;
221:     aiVector3D normal;
222:     aiVector3D tangent, bitangent;
223:     aiVector3D texcoords[AI_MAX_NUMBER_OF_TEXTURECOORDS];
224:     aiColor4D colors[AI_MAX_NUMBER_OF_COLOR_SETS];
225: };
226: // ------------------------------------------------------------------------------------------------
227: AI_FORCE_INLINE Vertex operator + (const Vertex& v0,const Vertex& v1) {
228:     return Vertex::BinaryOp<std::plus>(v0,v1);
229: }
230: AI_FORCE_INLINE Vertex operator - (const Vertex& v0,const Vertex& v1) {
231:     return Vertex::BinaryOp<std::minus>(v0,v1);
232: }
233: AI_FORCE_INLINE Vertex operator * (const Vertex& v0,ai_real f) {
234:     return Vertex::BinaryOp<Intern::multiplies>(v0,f);
235: }
236: AI_FORCE_INLINE Vertex operator / (const Vertex& v0,ai_real f) {
237:     return Vertex::BinaryOp<Intern::multiplies>(v0,1.f/f);
238: }
239: AI_FORCE_INLINE Vertex operator * (ai_real f,const Vertex& v0) {
240:     return Vertex::BinaryOp<Intern::multiplies>(f,v0);
241: }
242: }
243: #endif // AI_VERTEX_H_INC
</file>

