11643: // Scoring function for keyboard/gamepad directional navigation. Based on https://gist.github.com/rygorous/6981057
11644: static bool ImGui::NavScoreItem(ImGuiNavItemData* result, const ImRect& nav_bb)
11645: {
11646:     ImGuiContext& g = *GImGui;
11647:     ImGuiWindow* window = g.CurrentWindow;
11648:     if (g.NavLayer != window->DC.NavLayerCurrent)
11649:         return false;
11650:     // FIXME: Those are not good variables names
11651:     ImRect cand = nav_bb;                   // Current item nav rectangle
11652:     const ImRect curr = g.NavScoringRect;   // Current modified source rect (NB: we've applied Max.x = Min.x in NavUpdate() to inhibit the effect of having varied item width)
11653:     g.NavScoringDebugCount++;
11654:     // When entering through a NavFlattened border, we consider child window items as fully clipped for scoring
11655:     if (window->ParentWindow == g.NavWindow)
11656:     {
11657:         IM_ASSERT((window->ChildFlags | g.NavWindow->ChildFlags) & ImGuiChildFlags_NavFlattened);
11658:         if (!window->ClipRect.Overlaps(cand))
11659:             return false;
11660:         cand.ClipWithFull(window->ClipRect); // This allows the scored item to not overlap other candidates in the parent window
11661:     }
11662:     // Compute distance between boxes
11663:     // FIXME-NAV: Introducing biases for vertical navigation, needs to be removed.
11664:     float dbx = NavScoreItemDistInterval(cand.Min.x, cand.Max.x, curr.Min.x, curr.Max.x);
11665:     float dby = NavScoreItemDistInterval(ImLerp(cand.Min.y, cand.Max.y, 0.2f), ImLerp(cand.Min.y, cand.Max.y, 0.8f), ImLerp(curr.Min.y, curr.Max.y, 0.2f), ImLerp(curr.Min.y, curr.Max.y, 0.8f)); // Scale down on Y to keep using box-distance for vertically touching items
11666:     if (dby != 0.0f && dbx != 0.0f)
