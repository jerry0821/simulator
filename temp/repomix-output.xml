15511: void ImGui::DebugNodeFontGlyphesForSrcMask(ImFont* font, ImFontBaked* baked, int src_mask)
15512: {
15513:     ImDrawList* draw_list = GetWindowDrawList();
15514:     const ImU32 glyph_col = GetColorU32(ImGuiCol_Text);
15515:     const float cell_size = baked->Size * 1;
15516:     const float cell_spacing = GetStyle().ItemSpacing.y;
15517:     for (unsigned int base = 0; base <= IM_UNICODE_CODEPOINT_MAX; base += 256)
15518:     {
15519:         // Skip ahead if a large bunch of glyphs are not present in the font (test in chunks of 4k)
15520:         // This is only a small optimization to reduce the number of iterations when IM_UNICODE_MAX_CODEPOINT
15521:         // is large // (if ImWchar==ImWchar32 we will do at least about 272 queries here)
15522:         if (!(base & 8191) && font->IsGlyphRangeUnused(base, base + 8191))
15523:         {
15524:             base += 8192 - 256;
15525:             continue;
15526:         }
15527:         int count = 0;
15528:         for (unsigned int n = 0; n < 256; n++)
15529:             if (const ImFontGlyph* glyph = baked->IsGlyphLoaded((ImWchar)(base + n)) ? baked->FindGlyph((ImWchar)(base + n)) : NULL)
15530:                 if (src_mask & (1 << glyph->SourceIdx))
15531:                     count++;
15532:         if (count <= 0)
15533:             continue;
15534:         if (!TreeNode((void*)(intptr_t)base, "U+%04X..U+%04X (%d %s)", base, base + 255, count, count > 1 ? "glyphs" : "glyph"))
15535:             continue;
15536:         // Draw a 16x16 grid of glyphs
15537:         ImVec2 base_pos = GetCursorScreenPos();
15538:         for (unsigned int n = 0; n < 256; n++)
15539:         {
15540:             // We use ImFont::RenderChar as a shortcut because we don't have UTF-8 conversion functions
15541:             // available here and thus cannot easily generate a zero-terminated UTF-8 encoded string.
15542:             ImVec2 cell_p1(base_pos.x + (n % 16) * (cell_size + cell_spacing), base_pos.y + (n / 16) * (cell_size + cell_spacing));
15543:             ImVec2 cell_p2(cell_p1.x + cell_size, cell_p1.y + cell_size);
15544:             const ImFontGlyph* glyph = baked->IsGlyphLoaded((ImWchar)(base + n)) ? baked->FindGlyph((ImWchar)(base + n)) : NULL;
15545:             draw_list->AddRect(cell_p1, cell_p2, glyph ? IM_COL32(255, 255, 255, 100) : IM_COL32(255, 255, 255, 50));
15546:             if (!glyph || (src_mask & (1 << glyph->SourceIdx)) == 0)
15547:                 continue;
15548:             font->RenderChar(draw_list, cell_size, cell_p1, glyph_col, (ImWchar)(base + n));
15549:             if (IsMouseHoveringRect(cell_p1, cell_p2) && BeginTooltip())
15550:             {
15551:                 DebugNodeFontGlyph(font, glyph);
15552:                 EndTooltip();
15553:             }
15554:         }
15555:         Dummy(ImVec2((cell_size + cell_spacing) * 16, (cell_size + cell_spacing) * 16));
15556:         TreePop();
15557:     }
15558: }
