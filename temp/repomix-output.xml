 7260:         return;
 7261:     }
 7262:     ImGuiWindowStackData& window_stack_data = g.CurrentWindowStack.back();
 7263:     // Error checking: verify that user doesn't directly call End() on a child window.
 7264:     if (window->Flags & ImGuiWindowFlags_ChildWindow)
 7265:         IM_ASSERT_USER_ERROR(g.WithinEndChildID == window->ID, "Must call EndChild() and not End()!");
 7266:     // Close anything that is open
 7267:     if (window->DC.CurrentColumns)
 7268:         EndColumns();
 7269:     if (!window->SkipRefresh)
 7270:         PopClipRect();   // Inner window clip rectangle
 7271:     PopFocusScope();
 7272:     if (window_stack_data.DisabledOverrideReenable && window->RootWindow == window)
