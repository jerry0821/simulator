 41: namespace Assimp {
 42: /// @brief  Will find a node by its name.
 43: struct find_node_by_name_predicate {
 44:     std::string mName;
 45:     find_node_by_name_predicate(const std::string &name) :
 46:             mName(name) {
 47:         // empty
 48:     }
 49:     bool operator()(pugi::xml_node node) const {
 50:         return node.name() == mName;
 51:     }
 52: };
 53: /// @brief  Will convert an attribute to its int value.
 54: /// @tparam TNodeType The node type.
 55: template <class TNodeType>
 56: struct NodeConverter {
 57: public:
 58:     static int to_int(TNodeType &node, const char *attribName) {
 59:         ai_assert(nullptr != attribName);
 60:         return node.attribute(attribName).to_int();
 61:     }
 62: };
 63: using XmlNode = pugi::xml_node;
 64: using XmlAttribute = pugi::xml_attribute;
 65: /// @brief The Xml-Parser class.
 66: ///
 67: /// Use this parser if you have to import any kind of xml-format.
 68: ///
 69: /// An example:
 70: /// @code
 71: /// TXmlParser<XmlNode> theParser;
 72: /// if (theParser.parse(fileStream)) {
 73: ///     auto node = theParser.getRootNode();
 74: ///     for ( auto currentNode : node.children()) {
 75: ///         // Will loop over all children
 76: ///     }
 77: /// }
 78: /// @endcode
 79: /// @tparam TNodeType
 80: template <class TNodeType>
 81: class TXmlParser {
 82: public:
 83:     /// @brief The default class constructor.
 84:     TXmlParser();
 85:     ///	@brief  The class destructor.
 86:     ~TXmlParser();
 87:     ///	@brief  Will clear the parsed xml-file.
 88:     void clear();
 89:     ///	@brief  Will search for a child-node by its name
 90:     /// @param  name     [in] The name of the child-node.
 91:     /// @return The node instance or nullptr, if nothing was found.
 92:     TNodeType *findNode(const std::string &name);
 93:     /// @brief  Will return true, if the node is a child-node.
 94:     /// @param  name    [in] The name of the child node to look for.
 95:     /// @return true, if the node is a child-node or false if not.
 96:     bool hasNode(const std::string &name);
 97:     /// @brief  Will parse an xml-file from a given stream.
 98:     /// @param  stream      The input stream.
 99:     /// @return true, if the parsing was successful, false if not.
100:     bool parse(IOStream *stream);
101:     /// @brief  Will return true if a root node is there.
