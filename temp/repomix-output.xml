 7255:     ImGuiWindow* window = g.CurrentWindow;
 7256:     // Error checking: verify that user hasn't called End() too many times!
 7257:     if (g.CurrentWindowStack.Size <= 1 && g.WithinFrameScopeWithImplicitWindow)
 7258:     {
