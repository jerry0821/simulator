10667: bool ImGui::BeginTooltipEx(ImGuiTooltipFlags tooltip_flags, ImGuiWindowFlags extra_window_flags)
10668: {
10669:     ImGuiContext& g = *GImGui;
10670:     const bool is_dragdrop_tooltip = g.DragDropWithinSource || g.DragDropWithinTarget;
10671:     if (is_dragdrop_tooltip)
10672:     {
10673:         // Drag and Drop tooltips are positioning differently than other tooltips:
10674:         // - offset visibility to increase visibility around mouse.
10675:         // - never clamp within outer viewport boundary.
10676:         // We call SetNextWindowPos() to enforce position and disable clamping.
10677:         // See FindBestWindowPosForPopup() for positioning logic of other tooltips (not drag and drop ones).
10678:         //ImVec2 tooltip_pos = g.IO.MousePos - g.ActiveIdClickOffset - g.Style.WindowPadding;
10679:         const bool is_touchscreen = (g.IO.MouseSource == ImGuiMouseSource_TouchScreen);
10680:         if ((g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasPos) == 0)
10681:         {
10682:             ImVec2 tooltip_pos = is_touchscreen ? (g.IO.MousePos + TOOLTIP_DEFAULT_OFFSET_TOUCH * g.Style.MouseCursorScale) : (g.IO.MousePos + TOOLTIP_DEFAULT_OFFSET_MOUSE * g.Style.MouseCursorScale);
10683:             ImVec2 tooltip_pivot = is_touchscreen ? TOOLTIP_DEFAULT_PIVOT_TOUCH : ImVec2(0.0f, 0.0f);
10684:             SetNextWindowPos(tooltip_pos, ImGuiCond_None, tooltip_pivot);
10685:         }
10686:         SetNextWindowBgAlpha(g.Style.Colors[ImGuiCol_PopupBg].w * 0.60f);
10687:         //PushStyleVar(ImGuiStyleVar_Alpha, g.Style.Alpha * 0.60f); // This would be nice but e.g ColorButton with checkerboard has issue with transparent colors :(
10688:         tooltip_flags |= ImGuiTooltipFlags_OverridePrevious;
10689:     }
10690:     // Hide previous tooltip from being displayed. We can't easily "reset" the content of a window so we create a new one.
10691:     if ((tooltip_flags & ImGuiTooltipFlags_OverridePrevious) && g.TooltipPreviousWindow != NULL && g.TooltipPreviousWindow->Active && !IsWindowInBeginStack(g.TooltipPreviousWindow))
10692:     {
10693:         //IMGUI_DEBUG_LOG("[tooltip] '%s' already active, using +1 for this frame\n", window_name);
10694:         SetWindowHiddenAndSkipItemsForCurrentFrame(g.TooltipPreviousWindow);
10695:         g.TooltipOverrideCount++;
10696:     }
10697:     const char* window_name_template = is_dragdrop_tooltip ? "##Tooltip_DragDrop_%02d" : "##Tooltip_%02d";
10698:     char window_name[32];
10699:     ImFormatString(window_name, IM_ARRAYSIZE(window_name), window_name_template, g.TooltipOverrideCount);
10700:     ImGuiWindowFlags flags = ImGuiWindowFlags_Tooltip | ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_AlwaysAutoResize;
10701:     Begin(window_name, NULL, flags | extra_window_flags);
10702:     // 2023-03-09: Added bool return value to the API, but currently always returning true.
10703:     // If this ever returns false we need to update BeginDragDropSource() accordingly.
10704:     //if (!ret)
10705:     //    End();
10706:     //return ret;
10707:     return true;
10708: }
