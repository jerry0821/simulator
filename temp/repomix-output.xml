 7193:     if (first_begin_of_the_frame && !window->SkipRefresh)
 7194:     {
 7195:         if ((flags & ImGuiWindowFlags_ChildWindow) && !(flags & ImGuiWindowFlags_ChildMenu))
 7196:         {
 7197:             // Child window can be out of sight and have "negative" clip windows.
 7198:             // Mark them as collapsed so commands are skipped earlier (we can't manually collapse them because they have no title bar).
 7199:             IM_ASSERT((flags & ImGuiWindowFlags_NoTitleBar) != 0);
 7200:             const bool nav_request = (window->ChildFlags & ImGuiChildFlags_NavFlattened) && (g.NavAnyRequest && g.NavWindow && g.NavWindow->RootWindowForNav == window->RootWindowForNav);
