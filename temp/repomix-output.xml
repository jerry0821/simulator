6850: static void BoxSelectPreStartDrag(ImGuiID id, ImGuiSelectionUserData clicked_item)
6851: {
6852:     ImGuiContext& g = *GImGui;
6853:     ImGuiBoxSelectState* bs = &g.BoxSelectState;
6854:     bs->ID = id;
6855:     bs->IsStarting = true; // Consider starting box-select.
6856:     bs->IsStartedFromVoid = (clicked_item == ImGuiSelectionUserData_Invalid);
6857:     bs->IsStartedSetNavIdOnce = bs->IsStartedFromVoid;
6858:     bs->KeyMods = g.IO.KeyMods;
6859:     bs->StartPosRel = bs->EndPosRel = ImGui::WindowPosAbsToRel(g.CurrentWindow, g.IO.MousePos);
6860:     bs->ScrollAccum = ImVec2(0.0f, 0.0f);
6861: }
6862: static void BoxSelectActivateDrag(ImGuiBoxSelectState* bs, ImGuiWindow* window)
6863: {
6864:     ImGuiContext& g = *GImGui;
6865:     IMGUI_DEBUG_LOG_SELECTION("[selection] BeginBoxSelect() 0X%08X: Activate\n", bs->ID);
6866:     bs->IsActive = true;
6867:     bs->Window = window;
6868:     bs->IsStarting = false;
6869:     ImGui::SetActiveID(bs->ID, window);
6870:     ImGui::SetActiveIdUsingAllKeyboardKeys();
6871:     if (bs->IsStartedFromVoid && (bs->KeyMods & (ImGuiMod_Ctrl | ImGuiMod_Shift)) == 0)
6872:         bs->RequestClear = true;
6873: }
6874: static void BoxSelectDeactivateDrag(ImGuiBoxSelectState* bs)
6875: {
6876:     ImGuiContext& g = *GImGui;
6877:     bs->IsActive = bs->IsStarting = false;
6878:     if (g.ActiveId == bs->ID)
6879:     {
6880:         IMGUI_DEBUG_LOG_SELECTION("[selection] BeginBoxSelect() 0X%08X: Deactivate\n", bs->ID);
6881:         ImGui::ClearActiveID();
6882:     }
6883:     bs->ID = 0;
6884: }
6885: static void BoxSelectScrollWithMouseDrag(ImGuiBoxSelectState* bs, ImGuiWindow* window, const ImRect& inner_r)
6886: {
6887:     ImGuiContext& g = *GImGui;
6888:     IM_ASSERT(bs->Window == window);
6889:     for (int n = 0; n < 2; n++) // each axis
6890:     {
6891:         const float mouse_pos = g.IO.MousePos[n];
6892:         const float dist = (mouse_pos > inner_r.Max[n]) ? mouse_pos - inner_r.Max[n] : (mouse_pos < inner_r.Min[n]) ? mouse_pos - inner_r.Min[n] : 0.0f;
6893:         const float scroll_curr = window->Scroll[n];
6894:         if (dist == 0.0f || (dist < 0.0f && scroll_curr < 0.0f) || (dist > 0.0f && scroll_curr >= window->ScrollMax[n]))
6895:             continue;
6896:         const float speed_multiplier = ImLinearRemapClamp(g.FontSize, g.FontSize * 5.0f, 1.0f, 4.0f, ImAbs(dist)); // x1 to x4 depending on distance
6897:         const float scroll_step = g.FontSize * 35.0f * speed_multiplier * ImSign(dist) * g.IO.DeltaTime;
6898:         bs->ScrollAccum[n] += scroll_step;
6899:         // Accumulate into a stored value so we can handle high-framerate
6900:         const float scroll_step_i = ImFloor(bs->ScrollAccum[n]);
6901:         if (scroll_step_i == 0.0f)
6902:             continue;
6903:         if (n == 0)
6904:             ImGui::SetScrollX(window, scroll_curr + scroll_step_i);
6905:         else
6906:             ImGui::SetScrollY(window, scroll_curr + scroll_step_i);
6907:         bs->ScrollAccum[n] -= scroll_step_i;
6908:     }
6909: }
6910: bool ImGui::BeginBoxSelect(const ImRect& scope_rect, ImGuiWindow* window, ImGuiID box_select_id, ImGuiMultiSelectFlags ms_flags)
6911: {
6912:     ImGuiContext& g = *GImGui;
6913:     ImGuiBoxSelectState* bs = &g.BoxSelectState;
6914:     KeepAliveID(box_select_id);
6915:     if (bs->ID != box_select_id)
6916:         return false;
6917:     // IsStarting is set by MultiSelectItemFooter() when considering a possible box-select. We validate it here and lock geometry.
6918:     bs->UnclipMode = false;
6919:     bs->RequestClear = false;
6920:     if (bs->IsStarting && IsMouseDragPastThreshold(0))
6921:         BoxSelectActivateDrag(bs, window);
6922:     else if ((bs->IsStarting || bs->IsActive) && g.IO.MouseDown[0] == false)
6923:         BoxSelectDeactivateDrag(bs);
6924:     if (!bs->IsActive)
6925:         return false;
6926:     // Current frame absolute prev/current rectangles are used to toggle selection.
6927:     // They are derived from positions relative to scrolling space.
6928:     ImVec2 start_pos_abs = WindowPosRelToAbs(window, bs->StartPosRel);
6929:     ImVec2 prev_end_pos_abs = WindowPosRelToAbs(window, bs->EndPosRel); // Clamped already
6930:     ImVec2 curr_end_pos_abs = g.IO.MousePos;
6931:     if (ms_flags & ImGuiMultiSelectFlags_ScopeWindow) // Box-select scrolling only happens with ScopeWindow
6932:         curr_end_pos_abs = ImClamp(curr_end_pos_abs, scope_rect.Min, scope_rect.Max);
6933:     bs->BoxSelectRectPrev.Min = ImMin(start_pos_abs, prev_end_pos_abs);
6934:     bs->BoxSelectRectPrev.Max = ImMax(start_pos_abs, prev_end_pos_abs);
6935:     bs->BoxSelectRectCurr.Min = ImMin(start_pos_abs, curr_end_pos_abs);
6936:     bs->BoxSelectRectCurr.Max = ImMax(start_pos_abs, curr_end_pos_abs);
6937:     // Box-select 2D mode detects horizontal changes (vertical ones are already picked by Clipper)
6938:     // Storing an extra rect used by widgets supporting box-select.
6939:     if (ms_flags & ImGuiMultiSelectFlags_BoxSelect2d)
6940:         if (bs->BoxSelectRectPrev.Min.x != bs->BoxSelectRectCurr.Min.x || bs->BoxSelectRectPrev.Max.x != bs->BoxSelectRectCurr.Max.x)
6941:         {
6942:             bs->UnclipMode = true;
6943:             bs->UnclipRect = bs->BoxSelectRectPrev; // FIXME-OPT: UnclipRect x coordinates could be intersection of Prev and Curr rect on X axis.
6944:             bs->UnclipRect.Add(bs->BoxSelectRectCurr);
6945:         }
6946:     //GetForegroundDrawList()->AddRect(bs->UnclipRect.Min, bs->UnclipRect.Max, IM_COL32(255,0,0,200), 0.0f, 0, 3.0f);
6947:     //GetForegroundDrawList()->AddRect(bs->BoxSelectRectPrev.Min, bs->BoxSelectRectPrev.Max, IM_COL32(255,0,0,200), 0.0f, 0, 3.0f);
6948:     //GetForegroundDrawList()->AddRect(bs->BoxSelectRectCurr.Min, bs->BoxSelectRectCurr.Max, IM_COL32(0,255,0,200), 0.0f, 0, 1.0f);
6949:     return true;
6950: }
6951: void ImGui::EndBoxSelect(const ImRect& scope_rect, ImGuiMultiSelectFlags ms_flags)
6952: {
6953:     ImGuiContext& g = *GImGui;
6954:     ImGuiWindow* window = g.CurrentWindow;
6955:     ImGuiBoxSelectState* bs = &g.BoxSelectState;
6956:     IM_ASSERT(bs->IsActive);
6957:     bs->UnclipMode = false;
6958:     // Render selection rectangle
6959:     bs->EndPosRel = WindowPosAbsToRel(window, ImClamp(g.IO.MousePos, scope_rect.Min, scope_rect.Max)); // Clamp stored position according to current scrolling view
6960:     ImRect box_select_r = bs->BoxSelectRectCurr;
6961:     box_select_r.ClipWith(scope_rect);
6962:     window->DrawList->AddRectFilled(box_select_r.Min, box_select_r.Max, GetColorU32(ImGuiCol_SeparatorHovered, 0.30f)); // FIXME-MULTISELECT: Styling
6963:     window->DrawList->AddRect(box_select_r.Min, box_select_r.Max, GetColorU32(ImGuiCol_NavCursor)); // FIXME-MULTISELECT FIXME-DPI: Styling
6964:     // Scroll
6965:     const bool enable_scroll = (ms_flags & ImGuiMultiSelectFlags_ScopeWindow) && (ms_flags & ImGuiMultiSelectFlags_BoxSelectNoScroll) == 0;
6966:     if (enable_scroll)
6967:     {
6968:         ImRect scroll_r = scope_rect;
6969:         scroll_r.Expand(-g.FontSize);
6970:         //GetForegroundDrawList()->AddRect(scroll_r.Min, scroll_r.Max, IM_COL32(0, 255, 0, 255));
6971:         if (!scroll_r.Contains(g.IO.MousePos))
6972:             BoxSelectScrollWithMouseDrag(bs, window, scroll_r);
6973:     }
6974: }
