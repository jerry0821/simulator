 791: // Button to close a window
 792: bool ImGui::CloseButton(ImGuiID id, const ImVec2& pos)
 793: {
 794:     ImGuiContext& g = *GImGui;
 795:     ImGuiWindow* window = g.CurrentWindow;
 796:     // Tweak 1: Shrink hit-testing area if button covers an abnormally large proportion of the visible region. That's in order to facilitate moving the window away. (#3825)
 797:     // This may better be applied as a general hit-rect reduction mechanism for all widgets to ensure the area to move window is always accessible?
 798:     const ImRect bb(pos, pos + ImVec2(g.FontSize, g.FontSize));
 799:     ImRect bb_interact = bb;
 800:     const float area_to_visible_ratio = window->OuterRectClipped.GetArea() / bb.GetArea();
 801:     if (area_to_visible_ratio < 1.5f)
 802:         bb_interact.Expand(ImTrunc(bb_interact.GetSize() * -0.25f));
 803:     // Tweak 2: We intentionally allow interaction when clipped so that a mechanical Alt,Right,Activate sequence can always close a window.
 804:     // (this isn't the common behavior of buttons, but it doesn't affect the user because navigation tends to keep items visible in scrolling layer).
 805:     bool is_clipped = !ItemAdd(bb_interact, id);
 806:     bool hovered, held;
 807:     bool pressed = ButtonBehavior(bb_interact, id, &hovered, &held);
 808:     if (is_clipped)
 809:         return pressed;
 810:     // Render
 811:     ImU32 bg_col = GetColorU32(held ? ImGuiCol_ButtonActive : ImGuiCol_ButtonHovered);
 812:     if (hovered)
 813:         window->DrawList->AddRectFilled(bb.Min, bb.Max, bg_col);
 814:     RenderNavCursor(bb, id, ImGuiNavRenderCursorFlags_Compact);
 815:     const ImU32 cross_col = GetColorU32(ImGuiCol_Text);
 816:     const ImVec2 cross_center = bb.GetCenter() - ImVec2(0.5f, 0.5f);
 817:     const float cross_extent = g.FontSize * 0.5f * 0.7071f - 1.0f;
 818:     const float cross_thickness = 1.0f; // FIXME-DPI
 819:     window->DrawList->AddLine(cross_center + ImVec2(+cross_extent, +cross_extent), cross_center + ImVec2(-cross_extent, -cross_extent), cross_col, cross_thickness);
 820:     window->DrawList->AddLine(cross_center + ImVec2(+cross_extent, -cross_extent), cross_center + ImVec2(-cross_extent, +cross_extent), cross_col, cross_thickness);
 821:     return pressed;
 822: }
