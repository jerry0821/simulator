 9855:     if (g.IO.ConfigErrorRecoveryEnableTooltip)
 9856:     {
 9857:         if (g.WithinFrameScope && BeginErrorTooltip())
 9858:         {
 9859:             if (g.ErrorCountCurrentFrame < 20)
 9860:             {
 9861:                 Text("In window '%s': %s", window ? window->Name : "NULL", msg);
 9862:                 if (window && (!window->IsFallbackWindow || window->WasActive))
 9863:                     GetForegroundDrawList(window)->AddRect(window->Pos, window->Pos + window->Size, IM_COL32(255, 0, 0, 255));
 9864:             }
 9865:             if (g.ErrorCountCurrentFrame == 20)
 9866:                 Text("(and more errors)");
 9867:             // EndFrame() will amend debug buttons to this window, after all errors have been submitted.
 9868:             EndErrorTooltip();
 9869:         }
 9870:         g.ErrorCountCurrentFrame++;
 9871:     }
 9872: #endif
 9873:     // Output to callback
 9874:     if (g.ErrorCallback != NULL)
 9875:         g.ErrorCallback(&g, g.ErrorCallbackUserData, msg);
