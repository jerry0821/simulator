2762: float ImGui::TableGetHeaderRowHeight()
2763: {
2764:     // Caring for a minor edge case:
2765:     // Calculate row height, for the unlikely case that some labels may be taller than others.
2766:     // If we didn't do that, uneven header height would highlight but smaller one before the tallest wouldn't catch input for all height.
2767:     // In your custom header row you may omit this all together and just call TableNextRow() without a height...
2768:     ImGuiContext& g = *GImGui;
2769:     ImGuiTable* table = g.CurrentTable;
2770:     float row_height = g.FontSize;
2771:     for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
2772:         if (IM_BITARRAY_TESTBIT(table->EnabledMaskByIndex, column_n))
2773:             if ((table->Columns[column_n].Flags & ImGuiTableColumnFlags_NoHeaderLabel) == 0)
2774:                 row_height = ImMax(row_height, CalcTextSize(TableGetColumnName(table, column_n)).y);
2775:     return row_height + g.Style.CellPadding.y * 2.0f;
2776: }
2777: float ImGui::TableGetHeaderAngledMaxLabelWidth()
2778: {
2779:     ImGuiContext& g = *GImGui;
2780:     ImGuiTable* table = g.CurrentTable;
2781:     float width = 0.0f;
2782:     for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
2783:         if (IM_BITARRAY_TESTBIT(table->EnabledMaskByIndex, column_n))
2784:             if (table->Columns[column_n].Flags & ImGuiTableColumnFlags_AngledHeader)
2785:                 width = ImMax(width, CalcTextSize(TableGetColumnName(table, column_n), NULL, true).x);
2786:     return width + g.Style.CellPadding.y * 2.0f; // Swap padding
2787: }
2788: // [Public] This is a helper to output TableHeader() calls based on the column names declared in TableSetupColumn().
2789: // The intent is that advanced users willing to create customized headers would not need to use this helper
2790: // and can create their own! For example: TableHeader() may be preceded by Checkbox() or other custom widgets.
2791: // See 'Demo->Tables->Custom headers' for a demonstration of implementing a custom version of this.
2792: // This code is intentionally written to not make much use of internal functions, to give you better direction
2793: // if you need to write your own.
2794: // FIXME-TABLE: TableOpenContextMenu() and TableGetHeaderRowHeight() are not public.
2795: void ImGui::TableHeadersRow()
2796: {
2797:     ImGuiContext& g = *GImGui;
2798:     ImGuiTable* table = g.CurrentTable;
2799:     if (table == NULL)
2800:     {
2801:         IM_ASSERT_USER_ERROR(table != NULL, "Call should only be done while in BeginTable() scope!");
2802:         return;
2803:     }
2804:     // Call layout if not already done. This is automatically done by TableNextRow: we do it here _only_ to make
2805:     // it easier to debug-step in TableUpdateLayout(). Your own version of this function doesn't need this.
2806:     if (!table->IsLayoutLocked)
2807:         TableUpdateLayout(table);
2808:     // Open row
2809:     const float row_height = TableGetHeaderRowHeight();
2810:     TableNextRow(ImGuiTableRowFlags_Headers, row_height);
2811:     const float row_y1 = GetCursorScreenPos().y;
2812:     if (table->HostSkipItems) // Merely an optimization, you may skip in your own code.
2813:         return;
2814:     const int columns_count = TableGetColumnCount();
2815:     for (int column_n = 0; column_n < columns_count; column_n++)
2816:     {
2817:         if (!TableSetColumnIndex(column_n))
2818:             continue;
2819:         // Push an id to allow empty/unnamed headers. This is also idiomatic as it ensure there is a consistent ID path to access columns (for e.g. automation)
2820:         const char* name = (TableGetColumnFlags(column_n) & ImGuiTableColumnFlags_NoHeaderLabel) ? "" : TableGetColumnName(column_n);
2821:         PushID(column_n);
2822:         TableHeader(name);
2823:         PopID();
