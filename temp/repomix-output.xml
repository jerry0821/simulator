2791: static const char* GetDefaultCompressedFontDataTTF(int* out_size);
2792: #endif
2793: // Load embedded ProggyClean.ttf at size 13, disable oversampling
2794: // If you want a similar font which may be better scaled, consider using ProggyVector from the same author!
2795: ImFont* ImFontAtlas::AddFontDefault(const ImFontConfig* font_cfg_template)
2796: {
2797: #ifndef IMGUI_DISABLE_DEFAULT_FONT
2798:     ImFontConfig font_cfg = font_cfg_template ? *font_cfg_template : ImFontConfig();
2799:     if (!font_cfg_template)
2800:     {
2801:         font_cfg.OversampleH = font_cfg.OversampleV = 1;
2802:         font_cfg.PixelSnapH = true;
2803:     }
2804:     if (font_cfg.SizePixels <= 0.0f)
2805:         font_cfg.SizePixels = 13.0f * 1.0f;
2806:     if (font_cfg.Name[0] == '\0')
2807:         ImFormatString(font_cfg.Name, IM_ARRAYSIZE(font_cfg.Name), "ProggyClean.ttf");
2808:     font_cfg.EllipsisChar = (ImWchar)0x0085;
2809:     font_cfg.GlyphOffset.y += 1.0f * IM_TRUNC(font_cfg.SizePixels / 13.0f);  // Add +1 offset per 13 units
2810:     int ttf_compressed_size = 0;
2811:     const char* ttf_compressed = GetDefaultCompressedFontDataTTF(&ttf_compressed_size);
2812:     return AddFontFromMemoryCompressedTTF(ttf_compressed, ttf_compressed_size, font_cfg.SizePixels, &font_cfg);
2813: #else
2814:     IM_ASSERT(0 && "AddFontDefault() disabled in this build.");
2815:     IM_UNUSED(font_cfg_template);
2816:     return NULL;
2817: #endif // #ifndef IMGUI_DISABLE_DEFAULT_FONT
2818: }
2819: ImFont* ImFontAtlas::AddFontFromFileTTF(const char* filename, float size_pixels, const ImFontConfig* font_cfg_template, const ImWchar* glyph_ranges)
2820: {
2821:     IM_ASSERT(!Locked && "Cannot modify a locked ImFontAtlas!");
2822:     size_t data_size = 0;
2823:     void* data = ImFileLoadToMemory(filename, "rb", &data_size, 0);
2824:     if (!data)
2825:     {
2826:         if (font_cfg_template == NULL || (font_cfg_template->Flags & ImFontFlags_NoLoadError) == 0)
2827:         {
2828:             IMGUI_DEBUG_LOG("While loading '%s'\n", filename);
2829:             IM_ASSERT_USER_ERROR(0, "Could not load font file!");
2830:         }
2831:         return NULL;
2832:     }
2833:     ImFontConfig font_cfg = font_cfg_template ? *font_cfg_template : ImFontConfig();
2834:     if (font_cfg.Name[0] == '\0')
2835:     {
2836:         // Store a short copy of filename into into the font name for convenience
2837:         const char* p;
2838:         for (p = filename + ImStrlen(filename); p > filename && p[-1] != '/' && p[-1] != '\\'; p--) {}
2839:         ImFormatString(font_cfg.Name, IM_ARRAYSIZE(font_cfg.Name), "%s", p);
2840:     }
2841:     return AddFontFromMemoryTTF(data, (int)data_size, size_pixels, &font_cfg, glyph_ranges);
2842: }
2843: // NB: Transfer ownership of 'ttf_data' to ImFontAtlas, unless font_cfg_template->FontDataOwnedByAtlas == false. Owned TTF buffer will be deleted after Build().
2844: ImFont* ImFontAtlas::AddFontFromMemoryTTF(void* font_data, int font_data_size, float size_pixels, const ImFontConfig* font_cfg_template, const ImWchar* glyph_ranges)
2845: {
