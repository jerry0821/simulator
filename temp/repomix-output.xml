11057: // If 'p_open' is specified for a modal popup window, the popup will have a regular close button which will close the popup.
11058: // Note that popup visibility status is owned by Dear ImGui (and manipulated with e.g. OpenPopup).
11059: // - *p_open set back to false in BeginPopupModal() when popup is not open.
11060: // - if you set *p_open to false before calling BeginPopupModal(), it will close the popup.
11061: bool ImGui::BeginPopupModal(const char* name, bool* p_open, ImGuiWindowFlags flags)
11062: {
11063:     ImGuiContext& g = *GImGui;
11064:     ImGuiWindow* window = g.CurrentWindow;
11065:     const ImGuiID id = window->GetID(name);
11066:     if (!IsPopupOpen(id, ImGuiPopupFlags_None))
11067:     {
11068:         g.NextWindowData.ClearFlags(); // We behave like Begin() and need to consume those values
11069:         if (p_open && *p_open)
11070:             *p_open = false;
11071:         return false;
11072:     }
11073:     // Center modal windows by default for increased visibility
11074:     // (this won't really last as settings will kick in, and is mostly for backward compatibility. user may do the same themselves)
11075:     // FIXME: Should test for (PosCond & window->SetWindowPosAllowFlags) with the upcoming window.
11076:     if ((g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasPos) == 0)
11077:     {
11078:         const ImGuiViewport* viewport = GetMainViewport();
11079:         SetNextWindowPos(viewport->GetCenter(), ImGuiCond_FirstUseEver, ImVec2(0.5f, 0.5f));
11080:     }
11081:     flags |= ImGuiWindowFlags_Popup | ImGuiWindowFlags_Modal | ImGuiWindowFlags_NoCollapse;
11082:     const bool is_open = Begin(name, p_open, flags);
11083:     if (!is_open || (p_open && !*p_open)) // NB: is_open can be 'false' when the popup is completely clipped (e.g. zero size display)
11084:     {
11085:         EndPopup();
11086:         if (is_open)
11087:             ClosePopupToLevel(g.BeginPopupStack.Size, true);
11088:         return false;
11089:     }
11090:     return is_open;
11091: }
