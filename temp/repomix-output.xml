272:   UINT stride=sizeof(DebugVertex);UINT offset=0;
273:   g_pContext->IASetVertexBuffers(0,1,g_pVertexBuffer.GetAddressOf(),&stride,&offset);
274:   g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_LINESTRIP);
275:   Texture_SetTexture(g_WhiteTexId);
276:   g_pContext->Draw(vpr,0);g_pContext->Draw(vpr,vpr);g_pContext->Draw(vpr,vpr*2);
277: }
