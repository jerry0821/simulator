 374: // Text with a little bullet aligned to the typical tree node.
 375: void ImGui::BulletTextV(const char* fmt, va_list args)
 376: {
 377:     ImGuiWindow* window = GetCurrentWindow();
 378:     if (window->SkipItems)
 379:         return;
 380:     ImGuiContext& g = *GImGui;
 381:     const ImGuiStyle& style = g.Style;
 382:     const char* text_begin, *text_end;
 383:     ImFormatStringToTempBufferV(&text_begin, &text_end, fmt, args);
 384:     const ImVec2 label_size = CalcTextSize(text_begin, text_end, false);
 385:     const ImVec2 total_size = ImVec2(g.FontSize + (label_size.x > 0.0f ? (label_size.x + style.FramePadding.x * 2) : 0.0f), label_size.y);  // Empty text doesn't add padding
 386:     ImVec2 pos = window->DC.CursorPos;
 387:     pos.y += window->DC.CurrLineTextBaseOffset;
 388:     ItemSize(total_size, 0.0f);
 389:     const ImRect bb(pos, pos + total_size);
 390:     if (!ItemAdd(bb, 0))
 391:         return;
 392:     // Render
 393:     ImU32 text_col = GetColorU32(ImGuiCol_Text);
 394:     RenderBullet(window->DrawList, bb.Min + ImVec2(style.FramePadding.x + g.FontSize * 0.5f, g.FontSize * 0.5f), text_col);
 395:     RenderText(bb.Min + ImVec2(g.FontSize + style.FramePadding.x * 2, 0.0f), text_begin, text_end, false);
 396: }
