 1: /*==============================================================================
 2: 
 3:    3D描画用頂点シェーダー [shader_vertex_3d.hlsl]
 4: 														 Author : Youhei Sato
 5: 														 Date   : 2025/05/15
 6: --------------------------------------------------------------------------------
 7: 
 8: ==============================================================================*/
 9: 
10: // 定?バッファ
11: cbuffer VS_CONSTANT_BUFFER : register(b0)
12: {
13:     float4x4 world;
14: };
15: 
16: cbuffer VS_CONSTANT_BUFFER : register(b1)
17: {
18:     float4x4 view;
19: };
20: 
21: cbuffer VS_CONSTANT_BUFFER : register(b2)
22: {
23:     float4x4 proj;
24: };
25: 
26: 
27: 
28: struct VS_IN
29: {
30:     float3 posL : POSITION0;
31:     float3 normalL : NORMAL0; //Local法線
32:     float4 color : COLOR0;
33:     float2 uv : TEXCOORD0;
34: };
35:  
36: struct VS_OUT
37: {
38:     float4 posH : SV_POSITION;
39:     float4 posW : POSITION0;
40:     float4 normalW : NORMAL0;
41:     float4 color : COLOR0;
42:     float2 uv : TEXCOORD0;
43: };
44:  
45: //=============================================================================
46: // 頂点シェーダ
47: //=============================================================================
48: VS_OUT main(VS_IN vi)
49: {
50:     VS_OUT vo;
51:     
52:     float4 localPos = float4(vi.posL, 1.0f);
53:     float4 localNormal = float4(vi.normalL, 0.0f);
54:     // --- 座標変換 ---
55:     // World * View * Projection を一度に計算
56:     float4x4 mtxWVP = mul(mul(world, view), proj);
57:     vo.posH = mul(localPos, mtxWVP); // 頂点をクリップ空間へ
58:     
59:     // --- ピクセルシェーダへ渡すデータ ---
60:     
61:     // 1. ワールド座標
62:     vo.posW = mul(localPos, world);
63:     
64:     float4 normalW = mul(localNormal, world);
65:     //float4 normalW = mul(float4(vi.normalL.xyz, 0.0f), world);
66:     vo.normalW = normalize(normalW); // 法線を正規化（単位ベクトル化）する
67:     
68:     // 3. 他のデータをパススルー
69:     vo.color = vi.color;
70:     vo.uv = vi.uv;
71:     
72:     return vo;
73: }
