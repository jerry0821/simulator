235:      *
236:      * If there are rotation keys, there will also be at least one
237:      * scaling and one position key. */
238:     C_STRUCT aiQuatKey *mRotationKeys;
239:     /** The number of scaling keys */
240:     unsigned int mNumScalingKeys;
241:     /** The scaling keys of this animation channel. Scalings are
242:      *  specified as 3D vector. The array is mNumScalingKeys in size.
243:      *
244:      * If there are scaling keys, there will also be at least one
245:      * position and one rotation key.*/
246:     C_STRUCT aiVectorKey *mScalingKeys;
247:     /** Defines how the animation behaves before the first
248:      *  key is encountered.
249:      *
250:      *  The default value is aiAnimBehaviour_DEFAULT (the original
251:      *  transformation matrix of the affected node is used).*/
252:     C_ENUM aiAnimBehaviour mPreState;
253:     /** Defines how the animation behaves after the last
254:      *  key was processed.
255:      *
256:      *  The default value is aiAnimBehaviour_DEFAULT (the original
257:      *  transformation matrix of the affected node is taken).*/
258:     C_ENUM aiAnimBehaviour mPostState;
259: #ifdef __cplusplus
260:     aiNodeAnim() AI_NO_EXCEPT
261:             : mNumPositionKeys(0),
262:               mPositionKeys(nullptr),
263:               mNumRotationKeys(0),
264:               mRotationKeys(nullptr),
265:               mNumScalingKeys(0),
266:               mScalingKeys(nullptr),
267:               mPreState(aiAnimBehaviour_DEFAULT),
268:               mPostState(aiAnimBehaviour_DEFAULT) {
269:         // empty
270:     }
271:     ~aiNodeAnim() {
272:         delete[] mPositionKeys;
273:         delete[] mRotationKeys;
274:         delete[] mScalingKeys;
275:     }
276: #endif // __cplusplus
277: };
278: // ---------------------------------------------------------------------------
279: /** Describes vertex-based animations for a single mesh or a group of
280:  *  meshes. Meshes carry the animation data for each frame in their
281:  *  aiMesh::mAnimMeshes array. The purpose of aiMeshAnim is to
282:  *  define keyframes linking each mesh attachment to a particular
283:  *  point in time. */
284: struct aiMeshAnim {
285:     /** Name of the mesh to be animated. An empty string is not allowed,
286:      *  animated meshes need to be named (not necessarily uniquely,
287:      *  the name can basically serve as wild-card to select a group
288:      *  of meshes with similar animation setup)*/
289:     C_STRUCT aiString mName;
290:     /** Size of the #mKeys array. Must be 1, at least. */
291:     unsigned int mNumKeys;
292:     /** Key frames of the animation. May not be nullptr. */
293:     C_STRUCT aiMeshKey *mKeys;
294: #ifdef __cplusplus
295:     aiMeshAnim() AI_NO_EXCEPT
296:             : mNumKeys(),
297:               mKeys() {}
298:     ~aiMeshAnim() {
299:         delete[] mKeys;
300:     }
301: #endif
302: };
303: // ---------------------------------------------------------------------------
304: /** Describes a morphing animation of a given mesh. */
305: struct aiMeshMorphAnim {
306:     /** Name of the mesh to be animated. An empty string is not allowed,
307:      *  animated meshes need to be named (not necessarily uniquely,
308:      *  the name can basically serve as wildcard to select a group
309:      *  of meshes with similar animation setup)*/
310:     C_STRUCT aiString mName;
311:     /** Size of the #mKeys array. Must be 1, at least. */
312:     unsigned int mNumKeys;
313:     /** Key frames of the animation. May not be nullptr. */
314:     C_STRUCT aiMeshMorphKey *mKeys;
315: #ifdef __cplusplus
316:     aiMeshMorphAnim() AI_NO_EXCEPT
317:             : mNumKeys(),
318:               mKeys() {}
319:     ~aiMeshMorphAnim() {
320:         delete[] mKeys;
321:     }
322: #endif
323: };
324: // ---------------------------------------------------------------------------
325: /** An animation consists of key-frame data for a number of nodes. For
326:  *  each node affected by the animation a separate series of data is given.*/
327: struct aiAnimation {
328:     /** The name of the animation. If the modeling package this data was
329:      *  exported from does support only a single animation channel, this
330:      *  name is usually empty (length is zero). */
331:     C_STRUCT aiString mName;
332:     /** Duration of the animation in ticks.  */
333:     double mDuration;
334:     /** Ticks per second. 0 if not specified in the imported file */
335:     double mTicksPerSecond;
336:     /** The number of bone animation channels. Each channel affects
337:      *  a single node. */
338:     unsigned int mNumChannels;
339:     /** The node animation channels. Each channel affects a single node.
340:      *  The array is mNumChannels in size. */
341:     C_STRUCT aiNodeAnim **mChannels;
342:     /** The number of mesh animation channels. Each channel affects
343:      *  a single mesh and defines vertex-based animation. */
344:     unsigned int mNumMeshChannels;
345:     /** The mesh animation channels. Each channel affects a single mesh.
346:      *  The array is mNumMeshChannels in size. */
347:     C_STRUCT aiMeshAnim **mMeshChannels;
348:     /** The number of mesh animation channels. Each channel affects
349:      *  a single mesh and defines morphing animation. */
350:     unsigned int mNumMorphMeshChannels;
351:     /** The morph mesh animation channels. Each channel affects a single mesh.
352:      *  The array is mNumMorphMeshChannels in size. */
353:     C_STRUCT aiMeshMorphAnim **mMorphMeshChannels;
354: #ifdef __cplusplus
355:     aiAnimation() AI_NO_EXCEPT
356:             : mDuration(-1.),
357:               mTicksPerSecond(0.),
358:               mNumChannels(0),
359:               mChannels(nullptr),
360:               mNumMeshChannels(0),
361:               mMeshChannels(nullptr),
362:               mNumMorphMeshChannels(0),
363:               mMorphMeshChannels(nullptr) {
364:         // empty
365:     }
366:     ~aiAnimation() {
367:         // DO NOT REMOVE THIS ADDITIONAL CHECK
368:         if (mNumChannels && mChannels) {
369:             for (unsigned int a = 0; a < mNumChannels; a++) {
370:                 delete mChannels[a];
371:             }
372:             delete[] mChannels;
373:         }
374:         if (mNumMeshChannels && mMeshChannels) {
375:             for (unsigned int a = 0; a < mNumMeshChannels; a++) {
376:                 delete mMeshChannels[a];
377:             }
378:             delete[] mMeshChannels;
379:         }
380:         if (mNumMorphMeshChannels && mMorphMeshChannels) {
381:             for (unsigned int a = 0; a < mNumMorphMeshChannels; a++) {
382:                 delete mMorphMeshChannels[a];
383:             }
384:             delete[] mMorphMeshChannels;
385:         }
386:     }
387: #endif // __cplusplus
388: };
389: #ifdef __cplusplus
390: }
391: /// @brief  Some C++ utilities for inter- and extrapolation
392: namespace Assimp {
393: // ---------------------------------------------------------------------------
394: /**
395:   * @brief CPP-API: Utility class to simplify interpolations of various data types.
396:   *
397:   *  The type of interpolation is chosen automatically depending on the
398:   *  types of the arguments.
399:   */
400: template <typename T>
401: struct Interpolator {
402:     // ------------------------------------------------------------------
403:     /** @brief Get the result of the interpolation between a,b.
404:      *
405:      *  The interpolation algorithm depends on the type of the operands.
406:      *  aiQuaternion's and aiQuatKey's SLERP, the rest does a simple
407:      *  linear interpolation. */
408:     void operator()(T &anim_out, const T &a, const T &b, ai_real d) const {
409:         anim_out = a + (b - a) * d;
410:     }
411: }; // ! Interpolator <T>
412: //! @cond Never
413: template <>
414: struct Interpolator<aiQuaternion> {
415:     void operator()(aiQuaternion &out, const aiQuaternion &a,
416:             const aiQuaternion &b, ai_real d) const {
417:         aiQuaternion::Interpolate(out, a, b, d);
418:     }
419: }; // ! Interpolator <aiQuaternion>
420: template <>
421: struct Interpolator<unsigned int> {
422:     void operator()(unsigned int &out, unsigned int a,
423:             unsigned int b, ai_real d) const {
424:         out = d > 0.5f ? b : a;
425:     }
426: }; // ! Interpolator <aiQuaternion>
427: template <>
428: struct Interpolator<aiVectorKey> {
429:     void operator()(aiVector3D &out, const aiVectorKey &a,
430:             const aiVectorKey &b, ai_real d) const {
431:         Interpolator<aiVector3D> ipl;
432:         ipl(out, a.mValue, b.mValue, d);
433:     }
434: }; // ! Interpolator <aiVectorKey>
435: template <>
436: struct Interpolator<aiQuatKey> {
437:     void operator()(aiQuaternion &out, const aiQuatKey &a,
438:             const aiQuatKey &b, ai_real d) const {
439:         Interpolator<aiQuaternion> ipl;
440:         ipl(out, a.mValue, b.mValue, d);
441:     }
442: }; // ! Interpolator <aiQuatKey>
443: template <>
444: struct Interpolator<aiMeshKey> {
445:     void operator()(unsigned int &out, const aiMeshKey &a,
446:             const aiMeshKey &b, ai_real d) const {
447:         Interpolator<unsigned int> ipl;
448:         ipl(out, a.mValue, b.mValue, d);
449:     }
450: }; // ! Interpolator <aiQuatKey>
451: //! @endcond
452: } // namespace Assimp
453: #endif // __cplusplus
454: #endif // AI_ANIM_H_INC
</file>

