3051: // Setup main font loader for the atlas
3052: // Every font source (ImFontConfig) will use this unless ImFontConfig::FontLoader specify a custom loader.
3053: void ImFontAtlasBuildSetupFontLoader(ImFontAtlas* atlas, const ImFontLoader* font_loader)
3054: {
3055:     if (atlas->FontLoader == font_loader)
3056:         return;
3057:     IM_ASSERT(!atlas->Locked && "Cannot modify a locked ImFontAtlas!");
3058:     for (ImFont* font : atlas->Fonts)
3059:         ImFontAtlasFontDestroyOutput(atlas, font);
3060:     if (atlas->Builder && atlas->FontLoader && atlas->FontLoader->LoaderShutdown)
3061:         atlas->FontLoader->LoaderShutdown(atlas);
3062:     atlas->FontLoader = font_loader;
3063:     atlas->FontLoaderName = font_loader ? font_loader->Name : "NULL";
3064:     IM_ASSERT(atlas->FontLoaderData == NULL);
3065:     if (atlas->Builder && atlas->FontLoader && atlas->FontLoader->LoaderInit)
3066:         atlas->FontLoader->LoaderInit(atlas);
3067:     for (ImFont* font : atlas->Fonts)
3068:         ImFontAtlasFontInitOutput(atlas, font);
3069:     for (ImFont* font : atlas->Fonts)
3070:         for (ImFontConfig* src : font->Sources)
3071:             ImFontAtlasFontSourceAddToFont(atlas, font, src);
3072: }
3073: // Preload all glyph ranges for legacy backends.
3074: // This may lead to multiple texture creation which might be a little slower than before.
3075: void ImFontAtlasBuildLegacyPreloadAllGlyphRanges(ImFontAtlas* atlas)
3076: {
3077:     atlas->Builder->PreloadedAllGlyphsRanges = true;
3078:     for (ImFont* font : atlas->Fonts)
3079:     {
3080:         ImFontBaked* baked = font->GetFontBaked(font->LegacySize);
3081:         if (font->FallbackChar != 0)
3082:             baked->FindGlyph(font->FallbackChar);
3083:         if (font->EllipsisChar != 0)
3084:             baked->FindGlyph(font->EllipsisChar);
3085:         for (ImFontConfig* src : font->Sources)
3086:         {
3087:             const ImWchar* ranges = src->GlyphRanges ? src->GlyphRanges : atlas->GetGlyphRangesDefault();
3088:             for (; ranges[0]; ranges += 2)
3089:                 for (unsigned int c = ranges[0]; c <= ranges[1] && c <= IM_UNICODE_CODEPOINT_MAX; c++) //-V560
3090:                     baked->FindGlyph((ImWchar)c);
3091:         }
3092:     }
3093: }
