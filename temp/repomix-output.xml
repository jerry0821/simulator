2603: // Convert a value v in the output space of a slider into a parametric position on the slider itself (the logical opposite of ScaleValueFromRatioT)
2604: template<typename TYPE, typename SIGNEDTYPE, typename FLOATTYPE>
2605: float ImGui::ScaleRatioFromValueT(ImGuiDataType data_type, TYPE v, TYPE v_min, TYPE v_max, bool is_logarithmic, float logarithmic_zero_epsilon, float zero_deadzone_halfsize)
2606: {
2607:     if (v_min == v_max)
2608:         return 0.0f;
2609:     IM_UNUSED(data_type);
2610:     const TYPE v_clamped = (v_min < v_max) ? ImClamp(v, v_min, v_max) : ImClamp(v, v_max, v_min);
2611:     if (is_logarithmic)
2612:     {
2613:         bool flipped = v_max < v_min;
2614:         if (flipped) // Handle the case where the range is backwards
2615:             ImSwap(v_min, v_max);
2616:         // Fudge min/max to avoid getting close to log(0)
2617:         FLOATTYPE v_min_fudged = (ImAbs((FLOATTYPE)v_min) < logarithmic_zero_epsilon) ? ((v_min < 0.0f) ? -logarithmic_zero_epsilon : logarithmic_zero_epsilon) : (FLOATTYPE)v_min;
2618:         FLOATTYPE v_max_fudged = (ImAbs((FLOATTYPE)v_max) < logarithmic_zero_epsilon) ? ((v_max < 0.0f) ? -logarithmic_zero_epsilon : logarithmic_zero_epsilon) : (FLOATTYPE)v_max;
2619:         // Awkward special cases - we need ranges of the form (-100 .. 0) to convert to (-100 .. -epsilon), not (-100 .. epsilon)
2620:         if ((v_min == 0.0f) && (v_max < 0.0f))
2621:             v_min_fudged = -logarithmic_zero_epsilon;
2622:         else if ((v_max == 0.0f) && (v_min < 0.0f))
2623:             v_max_fudged = -logarithmic_zero_epsilon;
2624:         float result;
2625:         if (v_clamped <= v_min_fudged)
2626:             result = 0.0f; // Workaround for values that are in-range but below our fudge
2627:         else if (v_clamped >= v_max_fudged)
2628:             result = 1.0f; // Workaround for values that are in-range but above our fudge
2629:         else if ((v_min * v_max) < 0.0f) // Range crosses zero, so split into two portions
2630:         {
2631:             float zero_point_center = (-(float)v_min) / ((float)v_max - (float)v_min); // The zero point in parametric space.  There's an argument we should take the logarithmic nature into account when calculating this, but for now this should do (and the most common case of a symmetrical range works fine)
2632:             float zero_point_snap_L = zero_point_center - zero_deadzone_halfsize;
2633:             float zero_point_snap_R = zero_point_center + zero_deadzone_halfsize;
2634:             if (v == 0.0f)
2635:                 result = zero_point_center; // Special case for exactly zero
2636:             else if (v < 0.0f)
2637:                 result = (1.0f - (float)(ImLog(-(FLOATTYPE)v_clamped / logarithmic_zero_epsilon) / ImLog(-v_min_fudged / logarithmic_zero_epsilon))) * zero_point_snap_L;
2638:             else
2639:                 result = zero_point_snap_R + ((float)(ImLog((FLOATTYPE)v_clamped / logarithmic_zero_epsilon) / ImLog(v_max_fudged / logarithmic_zero_epsilon)) * (1.0f - zero_point_snap_R));
2640:         }
2641:         else if ((v_min < 0.0f) || (v_max < 0.0f)) // Entirely negative slider
2642:             result = 1.0f - (float)(ImLog(-(FLOATTYPE)v_clamped / -v_max_fudged) / ImLog(-v_min_fudged / -v_max_fudged));
2643:         else
2644:             result = (float)(ImLog((FLOATTYPE)v_clamped / v_min_fudged) / ImLog(v_max_fudged / v_min_fudged));
2645:         return flipped ? (1.0f - result) : result;
2646:     }
2647:     else
2648:     {
2649:         // Linear slider
2650:         return (float)((FLOATTYPE)(SIGNEDTYPE)(v_clamped - v_min) / (FLOATTYPE)(SIGNEDTYPE)(v_max - v_min));
2651:     }
2652: }
2653: // Convert a parametric position on a slider into a value v in the output space (the logical opposite of ScaleRatioFromValueT)
2654: template<typename TYPE, typename SIGNEDTYPE, typename FLOATTYPE>
2655: TYPE ImGui::ScaleValueFromRatioT(ImGuiDataType data_type, float t, TYPE v_min, TYPE v_max, bool is_logarithmic, float logarithmic_zero_epsilon, float zero_deadzone_halfsize)
2656: {
2657:     // We special-case the extents because otherwise our logarithmic fudging can lead to "mathematically correct"
2658:     // but non-intuitive behaviors like a fully-left slider not actually reaching the minimum value. Also generally simpler.
2659:     if (t <= 0.0f || v_min == v_max)
2660:         return v_min;
2661:     if (t >= 1.0f)
2662:         return v_max;
2663:     TYPE result = (TYPE)0;
2664:     if (is_logarithmic)
2665:     {
2666:         // Fudge min/max to avoid getting silly results close to zero
2667:         FLOATTYPE v_min_fudged = (ImAbs((FLOATTYPE)v_min) < logarithmic_zero_epsilon) ? ((v_min < 0.0f) ? -logarithmic_zero_epsilon : logarithmic_zero_epsilon) : (FLOATTYPE)v_min;
2668:         FLOATTYPE v_max_fudged = (ImAbs((FLOATTYPE)v_max) < logarithmic_zero_epsilon) ? ((v_max < 0.0f) ? -logarithmic_zero_epsilon : logarithmic_zero_epsilon) : (FLOATTYPE)v_max;
2669:         const bool flipped = v_max < v_min; // Check if range is "backwards"
2670:         if (flipped)
2671:             ImSwap(v_min_fudged, v_max_fudged);
