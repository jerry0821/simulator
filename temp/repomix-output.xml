 398: // [SECTION] Widgets: Main
 399: //-------------------------------------------------------------------------
 400: // - ButtonBehavior() [Internal]
 401: // - Button()
 402: // - SmallButton()
 403: // - InvisibleButton()
 404: // - ArrowButton()
 405: // - CloseButton() [Internal]
 406: // - CollapseButton() [Internal]
 407: // - GetWindowScrollbarID() [Internal]
 408: // - GetWindowScrollbarRect() [Internal]
 409: // - Scrollbar() [Internal]
 410: // - ScrollbarEx() [Internal]
 411: // - Image()
 412: // - ImageButton()
 413: // - Checkbox()
 414: // - CheckboxFlagsT() [Internal]
 415: // - CheckboxFlags()
 416: // - RadioButton()
 417: // - ProgressBar()
 418: // - Bullet()
 419: // - Hyperlink()
 420: //-------------------------------------------------------------------------
 421: // The ButtonBehavior() function is key to many interactions and used by many/most widgets.
 422: // Because we handle so many cases (keyboard/gamepad navigation, drag and drop) and many specific behavior (via ImGuiButtonFlags_),
 423: // this code is a little complex.
 424: // By far the most common path is interacting with the Mouse using the default ImGuiButtonFlags_PressedOnClickRelease button behavior.
 425: // See the series of events below and the corresponding state reported by dear imgui:
 426: //------------------------------------------------------------------------------------------------------------------------------------------------
 427: // with PressedOnClickRelease:             return-value  IsItemHovered()  IsItemActive()  IsItemActivated()  IsItemDeactivated()  IsItemClicked()
 428: //   Frame N+0 (mouse is outside bb)        -             -                -               -                  -                    -
 429: //   Frame N+1 (mouse moves inside bb)      -             true             -               -                  -                    -
 430: //   Frame N+2 (mouse button is down)       -             true             true            true               -                    true
 431: //   Frame N+3 (mouse button is down)       -             true             true            -                  -                    -
 432: //   Frame N+4 (mouse moves outside bb)     -             -                true            -                  -                    -
 433: //   Frame N+5 (mouse moves inside bb)      -             true             true            -                  -                    -
 434: //   Frame N+6 (mouse button is released)   true          true             -               -                  true                 -
 435: //   Frame N+7 (mouse button is released)   -             true             -               -                  -                    -
 436: //   Frame N+8 (mouse moves outside bb)     -             -                -               -                  -                    -
 437: //------------------------------------------------------------------------------------------------------------------------------------------------
 438: // with PressedOnClick:                    return-value  IsItemHovered()  IsItemActive()  IsItemActivated()  IsItemDeactivated()  IsItemClicked()
 439: //   Frame N+2 (mouse button is down)       true          true             true            true               -                    true
 440: //   Frame N+3 (mouse button is down)       -             true             true            -                  -                    -
 441: //   Frame N+6 (mouse button is released)   -             true             -               -                  true                 -
 442: //   Frame N+7 (mouse button is released)   -             true             -               -                  -                    -
 443: //------------------------------------------------------------------------------------------------------------------------------------------------
 444: // with PressedOnRelease:                  return-value  IsItemHovered()  IsItemActive()  IsItemActivated()  IsItemDeactivated()  IsItemClicked()
 445: //   Frame N+2 (mouse button is down)       -             true             -               -                  -                    true
 446: //   Frame N+3 (mouse button is down)       -             true             -               -                  -                    -
 447: //   Frame N+6 (mouse button is released)   true          true             -               -                  -                    -
 448: //   Frame N+7 (mouse button is released)   -             true             -               -                  -                    -
 449: //------------------------------------------------------------------------------------------------------------------------------------------------
 450: // with PressedOnDoubleClick:              return-value  IsItemHovered()  IsItemActive()  IsItemActivated()  IsItemDeactivated()  IsItemClicked()
 451: //   Frame N+0 (mouse button is down)       -             true             -               -                  -                    true
 452: //   Frame N+1 (mouse button is down)       -             true             -               -                  -                    -
 453: //   Frame N+2 (mouse button is released)   -             true             -               -                  -                    -
 454: //   Frame N+3 (mouse button is released)   -             true             -               -                  -                    -
 455: //   Frame N+4 (mouse button is down)       true          true             true            true               -                    true
 456: //   Frame N+5 (mouse button is down)       -             true             true            -                  -                    -
 457: //   Frame N+6 (mouse button is released)   -             true             -               -                  true                 -
 458: //   Frame N+7 (mouse button is released)   -             true             -               -                  -                    -
 459: //------------------------------------------------------------------------------------------------------------------------------------------------
 460: // Note that some combinations are supported,
 461: // - PressedOnDragDropHold can generally be associated with any flag.
 462: // - PressedOnDoubleClick can be associated by PressedOnClickRelease/PressedOnRelease, in which case the second release event won't be reported.
 463: //------------------------------------------------------------------------------------------------------------------------------------------------
 464: // The behavior of the return-value changes when ImGuiItemFlags_ButtonRepeat is set:
 465: //                                         Repeat+                  Repeat+           Repeat+             Repeat+
 466: //                                         PressedOnClickRelease    PressedOnClick    PressedOnRelease    PressedOnDoubleClick
 467: //-------------------------------------------------------------------------------------------------------------------------------------------------
 468: //   Frame N+0 (mouse button is down)       -                        true              -                   true
 469: //   ...                                    -                        -                 -                   -
 470: //   Frame N + RepeatDelay                  true                     true              -                   true
 471: //   ...                                    -                        -                 -                   -
 472: //   Frame N + RepeatDelay + RepeatRate*N   true                     true              -                   true
 473: //-------------------------------------------------------------------------------------------------------------------------------------------------
 474: // - FIXME: For refactor we could output flags, incl mouse hovered vs nav keyboard vs nav triggered etc.
 475: //   And better standardize how widgets use 'GetColor32((held && hovered) ? ... : hovered ? ...)' vs 'GetColor32(held ? ... : hovered ? ...);'
 476: //   For mouse feedback we typically prefer the 'held && hovered' test, but for nav feedback not always. Outputting hovered=true on Activation may be misleading.
 477: // - Since v1.91.2 (Sept 2024) we included io.ConfigDebugHighlightIdConflicts feature.
 478: //   One idiom which was previously valid which will now emit a warning is when using multiple overlaid ButtonBehavior()
 479: //   with same ID and different MouseButton (see #8030). You can fix it by:
 480: //       (1) switching to use a single ButtonBehavior() with multiple _MouseButton flags.
 481: //    or (2) surrounding those calls with PushItemFlag(ImGuiItemFlags_AllowDuplicateId, true); ... PopItemFlag()
 482: bool ImGui::ButtonBehavior(const ImRect& bb, ImGuiID id, bool* out_hovered, bool* out_held, ImGuiButtonFlags flags)
 483: {
 484:     ImGuiContext& g = *GImGui;
 485:     ImGuiWindow* window = GetCurrentWindow();
 486:     // Default behavior inherited from item flags
 487:     // Note that _both_ ButtonFlags and ItemFlags are valid sources, so copy one into the item_flags and only check that.
 488:     ImGuiItemFlags item_flags = (g.LastItemData.ID == id ? g.LastItemData.ItemFlags : g.CurrentItemFlags);
 489:     if (flags & ImGuiButtonFlags_AllowOverlap)
 490:         item_flags |= ImGuiItemFlags_AllowOverlap;
 491:     if (item_flags & ImGuiItemFlags_NoFocus)
 492:         flags |= ImGuiButtonFlags_NoFocus | ImGuiButtonFlags_NoNavFocus;
 493:     // Default only reacts to left mouse button
 494:     if ((flags & ImGuiButtonFlags_MouseButtonMask_) == 0)
 495:         flags |= ImGuiButtonFlags_MouseButtonLeft;
 496:     // Default behavior requires click + release inside bounding box
 497:     if ((flags & ImGuiButtonFlags_PressedOnMask_) == 0)
 498:         flags |= (item_flags & ImGuiItemFlags_ButtonRepeat) ? ImGuiButtonFlags_PressedOnClick : ImGuiButtonFlags_PressedOnDefault_;
 499:     ImGuiWindow* backup_hovered_window = g.HoveredWindow;
 500:     const bool flatten_hovered_children = (flags & ImGuiButtonFlags_FlattenChildren) && g.HoveredWindow && g.HoveredWindow->RootWindow == window->RootWindow;
 501:     if (flatten_hovered_children)
 502:         g.HoveredWindow = window;
 503: #ifdef IMGUI_ENABLE_TEST_ENGINE
 504:     // Alternate registration spot, for when caller didn't use ItemAdd()
 505:     if (g.LastItemData.ID != id)
 506:         IMGUI_TEST_ENGINE_ITEM_ADD(id, bb, NULL);
 507: #endif
 508:     bool pressed = false;
 509:     bool hovered = ItemHoverable(bb, id, item_flags);
 510:     // Special mode for Drag and Drop used by openables (tree nodes, tabs etc.)
 511:     // where holding the button pressed for a long time while drag a payload item triggers the button.
 512:     if (g.DragDropActive)
 513:     {
 514:         if ((flags & ImGuiButtonFlags_PressedOnDragDropHold) && !(g.DragDropSourceFlags & ImGuiDragDropFlags_SourceNoHoldToOpenOthers) && IsItemHovered(ImGuiHoveredFlags_AllowWhenBlockedByActiveItem))
 515:         {
 516:             hovered = true;
 517:             SetHoveredID(id);
 518:             if (g.HoveredIdTimer - g.IO.DeltaTime <= DRAGDROP_HOLD_TO_OPEN_TIMER && g.HoveredIdTimer >= DRAGDROP_HOLD_TO_OPEN_TIMER)
 519:             {
 520:                 pressed = true;
 521:                 g.DragDropHoldJustPressedId = id;
 522:                 FocusWindow(window);
 523:             }
 524:         }
 525:         if (g.DragDropAcceptIdPrev == id && (g.DragDropAcceptFlagsPrev & ImGuiDragDropFlags_AcceptDrawAsHovered))
 526:             hovered = true;
 527:     }
 528:     if (flatten_hovered_children)
 529:         g.HoveredWindow = backup_hovered_window;
 530:     // Mouse handling
 531:     const ImGuiID test_owner_id = (flags & ImGuiButtonFlags_NoTestKeyOwner) ? ImGuiKeyOwner_Any : id;
 532:     if (hovered)
 533:     {
 534:         IM_ASSERT(id != 0); // Lazily check inside rare path.
 535:         // Poll mouse buttons
 536:         // - 'mouse_button_clicked' is generally carried into ActiveIdMouseButton when setting ActiveId.
 537:         // - Technically we only need some values in one code path, but since this is gated by hovered test this is fine.
 538:         int mouse_button_clicked = -1;
 539:         int mouse_button_released = -1;
 540:         for (int button = 0; button < 3; button++)
 541:             if (flags & (ImGuiButtonFlags_MouseButtonLeft << button)) // Handle ImGuiButtonFlags_MouseButtonRight and ImGuiButtonFlags_MouseButtonMiddle here.
 542:             {
 543:                 if (IsMouseClicked(button, ImGuiInputFlags_None, test_owner_id) && mouse_button_clicked == -1) { mouse_button_clicked = button; }
 544:                 if (IsMouseReleased(button, test_owner_id) && mouse_button_released == -1) { mouse_button_released = button; }
 545:             }
 546:         // Process initial action
 547:         const bool mods_ok = !(flags & ImGuiButtonFlags_NoKeyModsAllowed) || (!g.IO.KeyCtrl && !g.IO.KeyShift && !g.IO.KeyAlt);
 548:         if (mods_ok)
 549:         {
 550:             if (mouse_button_clicked != -1 && g.ActiveId != id)
 551:             {
 552:                 if (!(flags & ImGuiButtonFlags_NoSetKeyOwner))
 553:                     SetKeyOwner(MouseButtonToKey(mouse_button_clicked), id);
 554:                 if (flags & (ImGuiButtonFlags_PressedOnClickRelease | ImGuiButtonFlags_PressedOnClickReleaseAnywhere))
 555:                 {
 556:                     SetActiveID(id, window);
 557:                     g.ActiveIdMouseButton = (ImS8)mouse_button_clicked;
 558:                     if (!(flags & ImGuiButtonFlags_NoNavFocus))
 559:                     {
 560:                         SetFocusID(id, window);
 561:                         FocusWindow(window);
 562:                     }
 563:                     else if (!(flags & ImGuiButtonFlags_NoFocus))
 564:                     {
 565:                         FocusWindow(window, ImGuiFocusRequestFlags_RestoreFocusedChild); // Still need to focus and bring to front, but try to avoid losing NavId when navigating a child
 566:                     }
 567:                 }
 568:                 if ((flags & ImGuiButtonFlags_PressedOnClick) || ((flags & ImGuiButtonFlags_PressedOnDoubleClick) && g.IO.MouseClickedCount[mouse_button_clicked] == 2))
 569:                 {
 570:                     pressed = true;
 571:                     if (flags & ImGuiButtonFlags_NoHoldingActiveId)
 572:                         ClearActiveID();
 573:                     else
 574:                         SetActiveID(id, window); // Hold on ID
 575:                     g.ActiveIdMouseButton = (ImS8)mouse_button_clicked;
 576:                     if (!(flags & ImGuiButtonFlags_NoNavFocus))
 577:                     {
 578:                         SetFocusID(id, window);
 579:                         FocusWindow(window);
 580:                     }
 581:                     else if (!(flags & ImGuiButtonFlags_NoFocus))
 582:                     {
 583:                         FocusWindow(window, ImGuiFocusRequestFlags_RestoreFocusedChild); // Still need to focus and bring to front, but try to avoid losing NavId when navigating a child
 584:                     }
 585:                 }
 586:             }
 587:             if (flags & ImGuiButtonFlags_PressedOnRelease)
 588:             {
 589:                 if (mouse_button_released != -1)
 590:                 {
 591:                     const bool has_repeated_at_least_once = (item_flags & ImGuiItemFlags_ButtonRepeat) && g.IO.MouseDownDurationPrev[mouse_button_released] >= g.IO.KeyRepeatDelay; // Repeat mode trumps on release behavior
 592:                     if (!has_repeated_at_least_once)
 593:                         pressed = true;
 594:                     if (!(flags & ImGuiButtonFlags_NoNavFocus))
 595:                         SetFocusID(id, window); // FIXME: Lack of FocusWindow() call here is inconsistent with other paths. Research why.
 596:                     ClearActiveID();
 597:                 }
 598:             }
 599:             // 'Repeat' mode acts when held regardless of _PressedOn flags (see table above).
 600:             // Relies on repeat logic of IsMouseClicked() but we may as well do it ourselves if we end up exposing finer RepeatDelay/RepeatRate settings.
 601:             if (g.ActiveId == id && (item_flags & ImGuiItemFlags_ButtonRepeat))
 602:                 if (g.IO.MouseDownDuration[g.ActiveIdMouseButton] > 0.0f && IsMouseClicked(g.ActiveIdMouseButton, ImGuiInputFlags_Repeat, test_owner_id))
 603:                     pressed = true;
 604:         }
 605:         if (pressed && g.IO.ConfigNavCursorVisibleAuto)
 606:             g.NavCursorVisible = false;
 607:     }
 608:     // Keyboard/Gamepad navigation handling
 609:     // We report navigated and navigation-activated items as hovered but we don't set g.HoveredId to not interfere with mouse.
 610:     if ((item_flags & ImGuiItemFlags_Disabled) == 0)
 611:     {
 612:         if (g.NavId == id && g.NavCursorVisible && g.NavHighlightItemUnderNav)
 613:             if (!(flags & ImGuiButtonFlags_NoHoveredOnFocus))
 614:                 hovered = true;
 615:         if (g.NavActivateDownId == id)
 616:         {
 617:             bool nav_activated_by_code = (g.NavActivateId == id);
 618:             bool nav_activated_by_inputs = (g.NavActivatePressedId == id);
 619:             if (!nav_activated_by_inputs && (item_flags & ImGuiItemFlags_ButtonRepeat))
 620:             {
 621:                 // Avoid pressing multiple keys from triggering excessive amount of repeat events
 622:                 const ImGuiKeyData* key1 = GetKeyData(ImGuiKey_Space);
 623:                 const ImGuiKeyData* key2 = GetKeyData(ImGuiKey_Enter);
 624:                 const ImGuiKeyData* key3 = GetKeyData(ImGuiKey_NavGamepadActivate);
 625:                 const float t1 = ImMax(ImMax(key1->DownDuration, key2->DownDuration), key3->DownDuration);
 626:                 nav_activated_by_inputs = CalcTypematicRepeatAmount(t1 - g.IO.DeltaTime, t1, g.IO.KeyRepeatDelay, g.IO.KeyRepeatRate) > 0;
 627:             }
 628:             if (nav_activated_by_code || nav_activated_by_inputs)
 629:             {
 630:                 // Set active id so it can be queried by user via IsItemActive(), equivalent of holding the mouse button.
 631:                 pressed = true;
 632:                 SetActiveID(id, window);
 633:                 g.ActiveIdSource = g.NavInputSource;
 634:                 if (!(flags & ImGuiButtonFlags_NoNavFocus) && !(g.NavActivateFlags & ImGuiActivateFlags_FromShortcut))
 635:                     SetFocusID(id, window);
 636:                 if (g.NavActivateFlags & ImGuiActivateFlags_FromShortcut)
 637:                     g.ActiveIdFromShortcut = true;
 638:             }
 639:         }
 640:     }
 641:     // Process while held
 642:     bool held = false;
 643:     if (g.ActiveId == id)
 644:     {
 645:         if (g.ActiveIdSource == ImGuiInputSource_Mouse)
 646:         {
 647:             if (g.ActiveIdIsJustActivated)
 648:                 g.ActiveIdClickOffset = g.IO.MousePos - bb.Min;
 649:             const int mouse_button = g.ActiveIdMouseButton;
 650:             if (mouse_button == -1)
 651:             {
 652:                 // Fallback for the rare situation were g.ActiveId was set programmatically or from another widget (e.g. #6304).
 653:                 ClearActiveID();
 654:             }
 655:             else if (IsMouseDown(mouse_button, test_owner_id))
 656:             {
 657:                 held = true;
 658:             }
 659:             else
 660:             {
 661:                 bool release_in = hovered && (flags & ImGuiButtonFlags_PressedOnClickRelease) != 0;
 662:                 bool release_anywhere = (flags & ImGuiButtonFlags_PressedOnClickReleaseAnywhere) != 0;
 663:                 if ((release_in || release_anywhere) && !g.DragDropActive)
 664:                 {
 665:                     // Report as pressed when releasing the mouse (this is the most common path)
 666:                     bool is_double_click_release = (flags & ImGuiButtonFlags_PressedOnDoubleClick) && g.IO.MouseReleased[mouse_button] && g.IO.MouseClickedLastCount[mouse_button] == 2;
 667:                     bool is_repeating_already = (item_flags & ImGuiItemFlags_ButtonRepeat) && g.IO.MouseDownDurationPrev[mouse_button] >= g.IO.KeyRepeatDelay; // Repeat mode trumps <on release>
 668:                     bool is_button_avail_or_owned = TestKeyOwner(MouseButtonToKey(mouse_button), test_owner_id);
 669:                     if (!is_double_click_release && !is_repeating_already && is_button_avail_or_owned)
 670:                         pressed = true;
 671:                 }
 672:                 ClearActiveID();
 673:             }
 674:             if (!(flags & ImGuiButtonFlags_NoNavFocus) && g.IO.ConfigNavCursorVisibleAuto)
 675:                 g.NavCursorVisible = false;
 676:         }
 677:         else if (g.ActiveIdSource == ImGuiInputSource_Keyboard || g.ActiveIdSource == ImGuiInputSource_Gamepad)
 678:         {
 679:             // When activated using Nav, we hold on the ActiveID until activation button is released
 680:             if (g.NavActivateDownId == id)
 681:                 held = true; // hovered == true not true as we are already likely hovered on direct activation.
 682:             else
 683:                 ClearActiveID();
 684:         }
 685:         if (pressed)
 686:             g.ActiveIdHasBeenPressedBefore = true;
 687:     }
 688:     // Activation highlight (this may be a remote activation)
 689:     if (g.NavHighlightActivatedId == id && (item_flags & ImGuiItemFlags_Disabled) == 0)
 690:         hovered = true;
 691:     if (out_hovered) *out_hovered = hovered;
 692:     if (out_held) *out_held = held;
 693:     return pressed;
 694: }
 695: bool ImGui::ButtonEx(const char* label, const ImVec2& size_arg, ImGuiButtonFlags flags)
 696: {
 697:     ImGuiWindow* window = GetCurrentWindow();
 698:     if (window->SkipItems)
 699:         return false;
 700:     ImGuiContext& g = *GImGui;
 701:     const ImGuiStyle& style = g.Style;
 702:     const ImGuiID id = window->GetID(label);
 703:     const ImVec2 label_size = CalcTextSize(label, NULL, true);
 704:     ImVec2 pos = window->DC.CursorPos;
 705:     if ((flags & ImGuiButtonFlags_AlignTextBaseLine) && style.FramePadding.y < window->DC.CurrLineTextBaseOffset) // Try to vertically align buttons that are smaller/have no padding so that text baseline matches (bit hacky, since it shouldn't be a flag)
 706:         pos.y += window->DC.CurrLineTextBaseOffset - style.FramePadding.y;
 707:     ImVec2 size = CalcItemSize(size_arg, label_size.x + style.FramePadding.x * 2.0f, label_size.y + style.FramePadding.y * 2.0f);
 708:     const ImRect bb(pos, pos + size);
 709:     ItemSize(size, style.FramePadding.y);
 710:     if (!ItemAdd(bb, id))
 711:         return false;
 712:     bool hovered, held;
 713:     bool pressed = ButtonBehavior(bb, id, &hovered, &held, flags);
 714:     // Render
 715:     const ImU32 col = GetColorU32((held && hovered) ? ImGuiCol_ButtonActive : hovered ? ImGuiCol_ButtonHovered : ImGuiCol_Button);
 716:     RenderNavCursor(bb, id);
 717:     RenderFrame(bb.Min, bb.Max, col, true, style.FrameRounding);
 718:     if (g.LogEnabled)
 719:         LogSetNextTextDecoration("[", "]");
 720:     RenderTextClipped(bb.Min + style.FramePadding, bb.Max - style.FramePadding, label, NULL, &label_size, style.ButtonTextAlign, &bb);
 721:     // Automatically close popups
 722:     //if (pressed && !(flags & ImGuiButtonFlags_DontClosePopups) && (window->Flags & ImGuiWindowFlags_Popup))
 723:     //    CloseCurrentPopup();
 724:     IMGUI_TEST_ENGINE_ITEM_INFO(id, label, g.LastItemData.StatusFlags);
 725:     return pressed;
 726: }
