  1: // --------------------------------------------
  2: // ビルボード [billboard.h]
  3: // ============================================
  4: // Created by: Jerry
  5: // Date: 2025-11-14
  6: //---------------------------------------------
  7: #include "billboard.h"
  8: #include "direct3d.h"
  9: #include <DirectXMath.h>
 10: using namespace DirectX;
 11: #include "shader_billboard.h"
 12: #include "texture.h"
 13: #include "camera.h"
 14: static constexpr int NUM_VERTEX = 4; // 頂点
 15: static ID3D11Buffer* g_pVertexBuffer = nullptr; // 頂点バッファ
 16: static XMFLOAT4X4 g_mtxView{}; //ビュー行列の平行移動成分をカットした行列
 17: // 頂点構造体
 18: struct Vertex_Billboard
 19: {
 20: 	XMFLOAT3 position;	// 頂点座標
 21: 	XMFLOAT4 color;		// 色
 22: 	XMFLOAT2 texcoord;	// テクスチャーUV
 23: };
 24: void Billboard_Initialize()
 25: {
 26: 	ShaderBillBoard_Initialize();
 27: 	static Vertex_Billboard vertex[]{
 28: 	{{ -0.5f,  0.5f, 0.0f}, { 1.0f, 1.0f, 1.0f, 1.0f},{  0.0f,  0.0f}}, // 左上
 29: 	{{  0.5f,  0.5f, 0.0f}, { 1.0f, 1.0f, 1.0f, 1.0f},{  1.0f,  0.0f}}, // 右上
 30: 	{{ -0.5f, -0.5f, 0.0f}, { 1.0f, 1.0f, 1.0f, 1.0f},{  0.0f,  1.0f}}, // 左下
 31: 	{{  0.5f, -0.5f, 0.0f}, { 1.0f, 1.0f, 1.0f, 1.0f},{  1.0f,  1.0f}}, // 右下
 32: 	};
 33: 	// 頂点バッファ生成
 34: 	D3D11_BUFFER_DESC bd = {};
 35: 	bd.Usage = D3D11_USAGE_DEFAULT;
 36: 	bd.ByteWidth = sizeof(Vertex_Billboard) * NUM_VERTEX;
 37: 	bd.BindFlags = D3D11_BIND_VERTEX_BUFFER;
 38: 	bd.CPUAccessFlags = 0;
 39: 	D3D11_SUBRESOURCE_DATA sd{};
 40: 	sd.pSysMem = vertex;
 41: 	Direct3D_GetDevice()->CreateBuffer(&bd, &sd, &g_pVertexBuffer);
 42: }
 43: void Billboard_Finalize(void)
 44: {
 45: 	SAFE_RELEASE(g_pVertexBuffer); // 頂点バッファの解放
 46: }
 47: void BillBoard_SetViewMatrix(const DirectX::XMFLOAT4X4& view)
 48: {
 49: 	//　カメラ行列の平行移動成分をカット
 50: 	g_mtxView = view;
 51: 	g_mtxView._41 = g_mtxView._42 = g_mtxView._43 = 0.0f;
 52: }
 53: void Billboard_Draw(int texId, const DirectX::XMFLOAT3& position, const DirectX::XMFLOAT2& scale, const DirectX::XMFLOAT2& pivot)
 54: {
 55: 	//ShaderBillBoard_SetUVParameter({{ 0.25f, 0.5f }, { 0.25f * 2, 0.5f }});
 56: 	// シェーダーを描画パイプラインに設定
 57: 	ShaderBillBoard_Begin();
 58: 	ShaderBillBoard_SetUVParameter({ { 1.0f, 1.0f }, { 0.0f, 0.0f } });
 59: 	ShaderBillBoard_SetMaterialColor({ 0.7f, 0.7f, 0.7f, 1.0f });
 60: 	// テクスチャの設定
 61: 	Texture_SetTexture(texId);
 62: 	// 頂点バッファを描画パイプラインに設定
 63: 	UINT stride = sizeof(Vertex_Billboard);
 64: 	UINT offset = 0;
 65: 	Direct3D_GetContext()->IASetVertexBuffers(0, 1, &g_pVertexBuffer, &stride, &offset);
 66: 	// プリミティブトポロジ設定
 67: 	Direct3D_GetContext()->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
 68: 	// ワールド座標変換行列の作成
 69: 	// 頂点シェーダーにワールド座標変換行列を設定
 70: 	// 回転軸までのオフセット行列
 71: 	XMMATRIX pivot_offset = XMMatrixTranslation(-pivot.x, -pivot.y, 0.0f);
 72: 	//　カメラ行列の回転だけ逆行列を作る
 73: 	//XMMATRIX iv = XMMatrixInverse(nullptr, XMLoadFloat4x4(&mtxCamera));
 74: 	XMMATRIX iv = XMMatrixTranspose(XMLoadFloat4x4(&g_mtxView));
 75: 	//正方直交行列の逆行列は転置行列と等しい
 76: 	XMMATRIX s = XMMatrixScaling(scale.x, scale.y, 1.0f);
 77: 	XMMATRIX t = XMMatrixTranslation(position.x, position.y, position.z);
 78: 	//XMMATRIX t = XMMatrixTranslation(position.x + pivot.x, position.y + pivot.y, position.z);
 79: 	ShaderBillBoard_SetWorldMatrix(s * pivot_offset * iv * t);
 80: 	//ShaderBillBoard_SetWorldMatrix(pivot_offset * s * iv * t);
 81: 	// ポリゴン描画命令発行
 82: 	Direct3D_GetContext()->Draw(NUM_VERTEX, 0);
 83: }
 84: void Billboard_Draw(int texId, const DirectX::XMFLOAT3& position, const DirectX::XMFLOAT2& scale, const DirectX::XMFLOAT4& text_cut, const DirectX::XMFLOAT2& pivot)
 85: {
 86: 	ShaderBillBoard_Begin();
 87: 	//ShaderBillBoard_SetUVParameter({ { 1.0f, 1.0f }, { 0.0f , 0.0f } });
 88: 	float uv_x = (float)text_cut.x / Texture_Width(texId);
 89: 	float uv_y = (float)text_cut.y / Texture_Height(texId);
 90: 	float uv_w = (float)text_cut.z / Texture_Width(texId);
 91: 	float uv_h = (float)text_cut.w / Texture_Height(texId);
 92: 	ShaderBillBoard_SetUVParameter({ { uv_w, uv_h }, { uv_x, uv_y } });
 93: 	// シェーダーを描画パイプラインに設定
 94: 	ShaderBillBoard_SetMaterialColor({ 1.0f, 1.0f, 1.0f, 1.0f }); // 白色
 95: 	// テクスチャの設定
 96: 	Texture_SetTexture(texId);
 97: 	// 頂点バッファを描画パイプラインに設定
 98: 	UINT stride = sizeof(Vertex_Billboard);
 99: 	UINT offset = 0;
100: 	Direct3D_GetContext()->IASetVertexBuffers(0, 1, &g_pVertexBuffer, &stride, &offset);
101: 	// プリミティブトポロジ設定
102: 	Direct3D_GetContext()->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
103: 	// ワールド座標変換行列の作成
104: 	// 頂点シェーダーにワールド座標変換行列を設定
105: 	// 回転軸までのオフセット行列
106: 	XMMATRIX pivot_offset = XMMatrixTranslation(-pivot.x, -pivot.y, 0.0f);
107: 	//　カメラ行列の回転だけ逆行列を作る
108: 	XMFLOAT4X4 mtxCamera = Camera_GetMatrix();
109: 	mtxCamera._41 = mtxCamera._42 = mtxCamera._43 = 0.0f;
110: 	//XMMATRIX iv = XMMatrixInverse(nullptr, XMLoadFloat4x4(&mtxCamera));
111: 	XMMATRIX iv = XMMatrixTranspose(XMLoadFloat4x4(&g_mtxView));
112: 	//正方直交行列の逆行列は転置行列と等しい
113: 	XMMATRIX s = XMMatrixScaling(scale.x, scale.y, 1.0f);
114: 	XMMATRIX t = XMMatrixTranslation(position.x, position.y, position.z);
115: 	//XMMATRIX t = XMMatrixTranslation(position.x + pivot.x, position.y + pivot.y, position.z);
116: 	ShaderBillBoard_SetWorldMatrix(XMMatrixTranslation(-pivot.x, -pivot.y, 0.0f) * s * iv * t);
117: 	//ShaderBillBoard_SetWorldMatrix(pivot_offset * s * iv * t);
118: 	// ポリゴン描画命令発行
119: 	Direct3D_GetContext()->Draw(NUM_VERTEX, 0);
120: }
121: void Billboard_Draw(int texId, const DirectX::XMFLOAT3& position, const DirectX::XMFLOAT2& scale, const DirectX::XMFLOAT4& uv_rect, const DirectX::XMFLOAT4& color)
122: {
123: 	ShaderBillBoard_Begin();
124: 	// 1. 設定 UV (支援切圖，如果不切圖傳 {0,0,1,1} 即可)
125: 	ShaderBillBoard_SetUVParameter({ { uv_rect.z, uv_rect.w }, { uv_rect.x, uv_rect.y } });
126: 	// 2. 【關鍵】使用傳進來的顏色 (包含透明度)
127: 	ShaderBillBoard_SetMaterialColor(color);
128: 	Texture_SetTexture(texId);
129: 	UINT stride = sizeof(Vertex_Billboard);
130: 	UINT offset = 0;
131: 	Direct3D_GetContext()->IASetVertexBuffers(0, 1, &g_pVertexBuffer, &stride, &offset);
132: 	Direct3D_GetContext()->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
133: 	// 矩陣計算
134: 	XMMATRIX iv = XMMatrixTranspose(XMLoadFloat4x4(&g_mtxView));
135: 	XMMATRIX s = XMMatrixScaling(scale.x, scale.y, 1.0f);
136: 	XMMATRIX t = XMMatrixTranslation(position.x, position.y, position.z);
137: 	// P.S. 特效通常不需要 Pivot，所以這裡簡化計算
138: 	ShaderBillBoard_SetWorldMatrix(s * iv * t);
139: 	Direct3D_GetContext()->Draw(NUM_VERTEX, 0);
140: }
141: void Billboard_DrawAnim(int texId, const DirectX::XMFLOAT3& position, const DirectX::XMFLOAT2& scale, int currentFrame, int splitX, int splitY, const DirectX::XMFLOAT4& color)
142: {
143: 	float texW = (float)Texture_Width(texId);
144: 	float texH = (float)Texture_Height(texId);
145: 	float cellW = texW / splitX;
146: 	float cellH = texH / splitY;
147: 	int col = currentFrame % splitX;
148: 	int row = currentFrame / splitX;
149: 	XMFLOAT4 cutRect;
150: 	cutRect.x = col * cellW; // X 起點
151: 	cutRect.y = row * cellH; // Y 起點
152: 	cutRect.z = cellW;       // 寬度
153: 	cutRect.w = cellH;       // 高度
154: 	XMFLOAT4 uv_rect;
155: 	uv_rect.x = cutRect.x / texW; // u min
156: 	uv_rect.y = cutRect.y / texH; // v min
157: 	uv_rect.z = cellW / texW;     // u size (width)
158: 	uv_rect.w = cellH / texH;     // v size (height)
159: 	Billboard_Draw(texId, position, scale, uv_rect, color);
160: }
</file>

<file path="camera.cpp">
