2836: //-----------------------------------------------------------------------------
2837: // [SECTION] Drawing API (ImDrawCmd, ImDrawIdx, ImDrawVert, ImDrawChannel, ImDrawListSplitter, ImDrawListFlags, ImDrawList, ImDrawData)
2838: // Hold a series of drawing commands. The user provides a renderer for ImDrawData which essentially contains an array of ImDrawList.
2839: //-----------------------------------------------------------------------------
2840: // The maximum line width to bake anti-aliased textures for. Build atlas with ImFontAtlasFlags_NoBakedLines to disable baking.
2841: #ifndef IM_DRAWLIST_TEX_LINES_WIDTH_MAX
2842: #define IM_DRAWLIST_TEX_LINES_WIDTH_MAX     (32)
2843: #endif
2844: // ImDrawIdx: vertex index. [Compile-time configurable type]
2845: // - To use 16-bit indices + allow large meshes: backend need to set 'io.BackendFlags |= ImGuiBackendFlags_RendererHasVtxOffset' and handle ImDrawCmd::VtxOffset (recommended).
2846: // - To use 32-bit indices: override with '#define ImDrawIdx unsigned int' in your imconfig.h file.
2847: #ifndef ImDrawIdx
2848: typedef unsigned short ImDrawIdx;   // Default: 16-bit (for maximum compatibility with renderer backends)
2849: #endif
2850: // ImDrawCallback: Draw callbacks for advanced uses [configurable type: override in imconfig.h]
2851: // NB: You most likely do NOT need to use draw callbacks just to create your own widget or customized UI rendering,
2852: // you can poke into the draw list for that! Draw callback may be useful for example to:
2853: //  A) Change your GPU render state,
2854: //  B) render a complex 3D scene inside a UI element without an intermediate texture/render target, etc.
2855: // The expected behavior from your rendering function is 'if (cmd.UserCallback != NULL) { cmd.UserCallback(parent_list, cmd); } else { RenderTriangles() }'
2856: // If you want to override the signature of ImDrawCallback, you can simply use e.g. '#define ImDrawCallback MyDrawCallback' (in imconfig.h) + update rendering backend accordingly.
2857: #ifndef ImDrawCallback
2858: typedef void (*ImDrawCallback)(const ImDrawList* parent_list, const ImDrawCmd* cmd);
2859: #endif
2860: // Special Draw callback value to request renderer backend to reset the graphics/render state.
2861: // The renderer backend needs to handle this special value, otherwise it will crash trying to call a function at this address.
2862: // This is useful, for example, if you submitted callbacks which you know have altered the render state and you want it to be restored.
2863: // Render state is not reset by default because they are many perfectly useful way of altering render state (e.g. changing shader/blending settings before an Image call).
2864: #define ImDrawCallback_ResetRenderState     (ImDrawCallback)(-8)
2865: // Typically, 1 command = 1 GPU draw call (unless command is a callback)
2866: // - VtxOffset: When 'io.BackendFlags & ImGuiBackendFlags_RendererHasVtxOffset' is enabled,
2867: //   this fields allow us to render meshes larger than 64K vertices while keeping 16-bit indices.
2868: //   Backends made for <1.71. will typically ignore the VtxOffset fields.
2869: // - The ClipRect/TexRef/VtxOffset fields must be contiguous as we memcmp() them together (this is asserted for).
2870: struct ImDrawCmd
2871: {
2872:     ImVec4          ClipRect;           // 4*4  // Clipping rectangle (x1, y1, x2, y2). Subtract ImDrawData->DisplayPos to get clipping rectangle in "viewport" coordinates
2873:     ImTextureRef    TexRef;             // 16   // Reference to a font/texture atlas (where backend called ImTextureData::SetTexID()) or to a user-provided texture ID (via e.g. ImGui::Image() calls). Both will lead to a ImTextureID value.
2874:     unsigned int    VtxOffset;          // 4    // Start offset in vertex buffer. ImGuiBackendFlags_RendererHasVtxOffset: always 0, otherwise may be >0 to support meshes larger than 64K vertices with 16-bit indices.
2875:     unsigned int    IdxOffset;          // 4    // Start offset in index buffer.
2876:     unsigned int    ElemCount;          // 4    // Number of indices (multiple of 3) to be rendered as triangles. Vertices are stored in the callee ImDrawList's vtx_buffer[] array, indices in idx_buffer[].
2877:     ImDrawCallback  UserCallback;       // 4-8  // If != NULL, call the function instead of rendering the vertices. clip_rect and texture_id will be set normally.
2878:     void*           UserCallbackData;   // 4-8  // Callback user data (when UserCallback != NULL). If called AddCallback() with size == 0, this is a copy of the AddCallback() argument. If called AddCallback() with size > 0, this is pointing to a buffer where data is stored.
2879:     int             UserCallbackDataSize;  // 4 // Size of callback user data when using storage, otherwise 0.
2880:     int             UserCallbackDataOffset;// 4 // [Internal] Offset of callback user data when using storage, otherwise -1.
2881:     ImDrawCmd()     { memset(this, 0, sizeof(*this)); } // Also ensure our padding fields are zeroed
2882:     // Since 1.83: returns ImTextureID associated with this draw call. Warning: DO NOT assume this is always same as 'TextureId' (we will change this function for an upcoming feature)
