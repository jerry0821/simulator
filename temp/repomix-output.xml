12068:         return;
12069:     }
12070:     bool init_for_nav = false;
12071:     if (window == window->RootWindow || (window->Flags & ImGuiWindowFlags_Popup) || (window->NavLastIds[0] == 0) || force_reinit)
12072:         init_for_nav = true;
