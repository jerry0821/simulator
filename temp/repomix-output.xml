121: #include "grid.h"
122: #include "direct3d.h"
123: #include "shader3d.h"
124: #include "texture.h"
125: #include <DirectXMath.h>
126: using namespace DirectX;
127: // 網格設定 (10x10 格 = 10.0f x 10.0f 的範圍)
128: static constexpr int GRID_H_COUNT = 30; // 橫向線條數
129: static constexpr int GRID_V_COUNT = 30; // 縱向線條數
130: static constexpr int GRID_H_LINE_COUNT = GRID_H_COUNT + 1;
131: static constexpr int GRID_V_LINE_COUNT = GRID_V_COUNT + 1;
132: static constexpr int NUM_VERTEX = (GRID_H_LINE_COUNT + GRID_V_LINE_COUNT) * 2;
133: static ID3D11Buffer *g_pVertexBuffer = nullptr;
134: // 頂点構造体
135: struct Vertex3D {
136:   XMFLOAT3 position; // 頂点座標
137:   XMFLOAT3 normal;   // 法線
138:   XMFLOAT4 color;    // 色
139:   XMFLOAT2 texcoord; // UV
140: };
141: // 頂點資料陣列
142: static Vertex3D g_GridVertex[NUM_VERTEX]{};
143: // 用來保存 Device 指標
144: static ID3D11Device *g_pDevice = nullptr;
145: static ID3D11DeviceContext *g_pContext = nullptr;
146: void Grid_Initialize(ID3D11Device *pDevice, ID3D11DeviceContext *pContext) {
147:   g_pDevice = pDevice;
148:   g_pContext = pContext;
149:   // 1. 建立頂點資料 (以 0,0,0 為中心)
150:   float x_start = -((float)GRID_H_COUNT / 2.0f); // -5.0f
151:   float z_start = -((float)GRID_V_COUNT / 2.0f); // -5.0f
152:   // 縱向線 (平行於 Z 軸)
153:   for (int i = 0; i < GRID_H_LINE_COUNT; i++) {
154:     float x = x_start + i;
155:     g_GridVertex[i * 2 + 0] = {{x, 0.0f, (float)GRID_V_COUNT / 2.0f},
156:                                {0, 1, 0},
157:                                {0.0f, 1.0f, 0.0f, 1.0f},
158:                                {0, 0}}; // 遠端
159:     g_GridVertex[i * 2 + 1] = {{x, 0.0f, -(float)GRID_V_COUNT / 2.0f},
160:                                {0, 1, 0},
161:                                {0.0f, 1.0f, 0.0f, 1.0f},
162:                                {0, 0}}; // 近端
163:   }
164:   // 橫向線 (平行於 X 軸)
165:   for (int i = 0; i < GRID_V_LINE_COUNT; i++) {
166:     float z = z_start + i;
167:     int offset = GRID_H_LINE_COUNT * 2;
168:     g_GridVertex[offset + i * 2 + 0] = {{(float)GRID_H_COUNT / 2.0f, 0.0f, z},
169:                                         {0, 1, 0},
170:                                         {0.0f, 1.0f, 0.0f, 1.0f},
171:                                         {0, 0}}; // 右端
172:     g_GridVertex[offset + i * 2 + 1] = {{-(float)GRID_H_COUNT / 2.0f, 0.0f, z},
173:                                         {0, 1, 0},
174:                                         {0.0f, 1.0f, 0.0f, 1.0f},
175:                                         {0, 0}}; // 左端
176:   }
177:   // 2. 建立頂點緩衝區
178:   D3D11_BUFFER_DESC bd = {};
179:   bd.Usage = D3D11_USAGE_DEFAULT;
180:   bd.ByteWidth = sizeof(Vertex3D) * NUM_VERTEX;
181:   bd.BindFlags = D3D11_BIND_VERTEX_BUFFER;
182:   bd.CPUAccessFlags = 0;
183:   D3D11_SUBRESOURCE_DATA sd{};
184:   sd.pSysMem = g_GridVertex;
185:   g_pDevice->CreateBuffer(&bd, &sd, &g_pVertexBuffer);
186: }
187: void Grid_Finalize(void) { SAFE_RELEASE(g_pVertexBuffer); }
188: void Grid_Draw(void) {
189:   // 開始 Shader
190:   Shader3D_Begin();
191:   // 設定頂點緩衝
192:   UINT stride = sizeof(Vertex3D);
193:   UINT offset = 0;
194:   g_pContext->IASetVertexBuffers(0, 1, &g_pVertexBuffer, &stride, &offset);
195:   // 世界矩陣 (單位矩陣 = 原點不移動)
196:   XMMATRIX mtxWorld = XMMatrixIdentity();
197:   Shader3D_SetWorldMatrix(mtxWorld);
198:   // 【重要】這裡假設 View 和 Projection 矩陣已經在 Game_Draw 裡設定好了
199:   // 所以這裡不需要再設定一次 Camera
200:   // 設定畫線模式
201:   g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_LINELIST);
202:   // 設定紋理 (使用 0 號貼圖以防止前一次畫的貼圖污染線條顏色)
203:   Texture_SetTexture(0);
204:   g_pContext->Draw(NUM_VERTEX, 0);
205: }
