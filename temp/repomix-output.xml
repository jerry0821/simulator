2070: // User can input math operators (e.g. +100) to edit a numerical values.
2071: // NB: This is _not_ a full expression evaluator. We should probably add one and replace this dumb mess..
2072: bool ImGui::DataTypeApplyFromText(const char* buf, ImGuiDataType data_type, void* p_data, const char* format, void* p_data_when_empty)
2073: {
2074:     // Copy the value in an opaque buffer so we can compare at the end of the function if it changed at all.
2075:     const ImGuiDataTypeInfo* type_info = DataTypeGetInfo(data_type);
2076:     ImGuiDataTypeStorage data_backup;
2077:     memcpy(&data_backup, p_data, type_info->Size);
2078:     while (ImCharIsBlankA(*buf))
2079:         buf++;
2080:     if (!buf[0])
2081:     {
2082:         if (p_data_when_empty != NULL)
2083:         {
2084:             memcpy(p_data, p_data_when_empty, type_info->Size);
2085:             return memcmp(&data_backup, p_data, type_info->Size) != 0;
2086:         }
2087:         return false;
2088:     }
2089:     // Sanitize format
2090:     // - For float/double we have to ignore format with precision (e.g. "%.2f") because sscanf doesn't take them in, so force them into %f and %lf
2091:     // - In theory could treat empty format as using default, but this would only cover rare/bizarre case of using InputScalar() + integer + format string without %.
2092:     char format_sanitized[32];
2093:     if (data_type == ImGuiDataType_Float || data_type == ImGuiDataType_Double)
2094:         format = type_info->ScanFmt;
2095:     else
2096:         format = ImParseFormatSanitizeForScanning(format, format_sanitized, IM_ARRAYSIZE(format_sanitized));
2097:     // Small types need a 32-bit buffer to receive the result from scanf()
2098:     int v32 = 0;
2099:     if (sscanf(buf, format, type_info->Size >= 4 ? p_data : &v32) < 1)
2100:         return false;
2101:     if (type_info->Size < 4)
2102:     {
2103:         if (data_type == ImGuiDataType_S8)
2104:             *(ImS8*)p_data = (ImS8)ImClamp(v32, (int)IM_S8_MIN, (int)IM_S8_MAX);
2105:         else if (data_type == ImGuiDataType_U8)
2106:             *(ImU8*)p_data = (ImU8)ImClamp(v32, (int)IM_U8_MIN, (int)IM_U8_MAX);
2107:         else if (data_type == ImGuiDataType_S16)
2108:             *(ImS16*)p_data = (ImS16)ImClamp(v32, (int)IM_S16_MIN, (int)IM_S16_MAX);
2109:         else if (data_type == ImGuiDataType_U16)
2110:             *(ImU16*)p_data = (ImU16)ImClamp(v32, (int)IM_U16_MIN, (int)IM_U16_MAX);
2111:         else
2112:             IM_ASSERT(0);
2113:     }
2114:     return memcmp(&data_backup, p_data, type_info->Size) != 0;
2115: }
