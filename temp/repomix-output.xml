 15: #include "mouse.h"
 16: #include <windowsx.h>
 17: #include <assert.h>
 18: #define SAFE_CLOSEHANDLE(h) if(h){CloseHandle(h); h = NULL;}
 19: static Mouse_State        gState = {};
 20: static HWND               gWindow = NULL;
 21: static Mouse_PositionMode gMode = MOUSE_POSITION_MODE_ABSOLUTE;
 22: static HANDLE             gScrollWheelValue = NULL;
 23: static HANDLE             gRelativeRead = NULL;
 24: static HANDLE             gAbsoluteMode = NULL;
 25: static HANDLE             gRelativeMode = NULL;
 26: static int                gLastX = 0;
 27: static int                gLastY = 0;
 28: static int                gRelativeX = INT32_MAX;
 29: static int                gRelativeY = INT32_MAX;
 30: static bool               gInFocus = true;
 31: static void clipToWindow(void);
 32: void Mouse_Initialize(HWND window)
 33: {
 34:     RtlZeroMemory(&gState, sizeof(gState));
 35:     assert(window != NULL);
 36:     RAWINPUTDEVICE Rid;
 37:     Rid.usUsagePage = 0x01 /* HID_USAGE_PAGE_GENERIC */;
 38:     Rid.usUsage = 0x02     /* HID_USAGE_GENERIC_MOUSE */;
 39:     Rid.dwFlags = RIDEV_INPUTSINK;
 40:     Rid.hwndTarget = window;
 41:     RegisterRawInputDevices(&Rid, 1, sizeof(RAWINPUTDEVICE));
 42:     gWindow = window;
 43:     gMode = MOUSE_POSITION_MODE_ABSOLUTE;
 44:     if (!gScrollWheelValue) { gScrollWheelValue = CreateEventEx(nullptr, nullptr, CREATE_EVENT_MANUAL_RESET, EVENT_MODIFY_STATE | SYNCHRONIZE); }
 45:     if (!gRelativeRead) { gRelativeRead = CreateEventEx(nullptr, nullptr, CREATE_EVENT_MANUAL_RESET, EVENT_MODIFY_STATE | SYNCHRONIZE); }
 46:     if (!gAbsoluteMode) { gAbsoluteMode = CreateEventEx(nullptr, nullptr, 0, EVENT_MODIFY_STATE | SYNCHRONIZE); }
 47:     if (!gRelativeMode) { gRelativeMode = CreateEventEx(nullptr, nullptr, 0, EVENT_MODIFY_STATE | SYNCHRONIZE); }
 48:     gLastX = 0;
 49:     gLastY = 0;
 50:     gRelativeX = INT32_MAX;
 51:     gRelativeY = INT32_MAX;
 52:     gInFocus = true;
 53: }
 54: void Mouse_Finalize(void)
 55: {
 56:     SAFE_CLOSEHANDLE(gScrollWheelValue);
 57:     SAFE_CLOSEHANDLE(gRelativeRead);
 58:     SAFE_CLOSEHANDLE(gAbsoluteMode);
 59:     SAFE_CLOSEHANDLE(gRelativeMode);
 60: }
 61: void Mouse_GetState(Mouse_State* pState)
 62: {
 63:     memcpy(pState, &gState, sizeof(gState));
 64:     pState->positionMode = gMode;
 65:     DWORD Result = WaitForSingleObjectEx(gScrollWheelValue, 0, FALSE);
 66:     if (Result == WAIT_FAILED) { return; }
 67:     if (Result == WAIT_OBJECT_0) {
 68:         pState->scrollWheelValue = 0;
 69:     }
 70:     if (pState->positionMode == MOUSE_POSITION_MODE_RELATIVE) {
 71:         Result = WaitForSingleObjectEx(gRelativeRead, 0, FALSE);
 72:         if (Result == WAIT_FAILED) { return; }
 73:         if (Result == WAIT_OBJECT_0) {
 74:             pState->x = 0;
 75:             pState->y = 0;
 76:         }
 77:         else {
 78:             SetEvent(gRelativeRead);
 79:         }
 80:     }
 81: }
 82: void Mouse_ResetScrollWheelValue(void)
 83: {
 84:     SetEvent(gScrollWheelValue);
 85: }
 86: void Mouse_SetMode(Mouse_PositionMode mode)
 87: {
 88:     if (gMode == mode)
 89:         return;
 90:     SetEvent((mode == MOUSE_POSITION_MODE_ABSOLUTE) ? gAbsoluteMode : gRelativeMode);
 91:     assert(gWindow != NULL);
 92:     TRACKMOUSEEVENT tme;
 93:     tme.cbSize = sizeof(tme);
 94:     tme.dwFlags = TME_HOVER;
 95:     tme.hwndTrack = gWindow;
 96:     tme.dwHoverTime = 1;
 97:     TrackMouseEvent(&tme);
 98: }
 99: bool Mouse_IsConnected(void)
100: {
101:     return GetSystemMetrics(SM_MOUSEPRESENT) != 0;
102: }
103: bool Mouse_IsVisible(void)
104: {
105:     if (gMode == MOUSE_POSITION_MODE_RELATIVE) {
106:         return false;
107:     }
108:     CURSORINFO info = { sizeof(CURSORINFO), 0, nullptr, {} };
109:     GetCursorInfo(&info);
110:     return (info.flags & CURSOR_SHOWING) != 0;
111: }
112: void Mouse_SetVisible(bool visible)
113: {
114:     if (gMode == MOUSE_POSITION_MODE_RELATIVE) {
115:         return;
116:     }
117:     CURSORINFO info = { sizeof(CURSORINFO), 0, nullptr, {} };
118:     GetCursorInfo(&info);
119:     bool isVisible = (info.flags & CURSOR_SHOWING) != 0;
120:     if (isVisible != visible) {
121:         ShowCursor(visible);
122:     }
123: }
124: void Mouse_ProcessMessage(UINT message, WPARAM wParam, LPARAM lParam)
125: {
126:     HANDLE evts[3] = {
127:         gScrollWheelValue,
128:         gAbsoluteMode,
129:         gRelativeMode
130:     };
131:     switch (WaitForMultipleObjectsEx(_countof(evts), evts, FALSE, 0, FALSE))
132:     {
133:     case WAIT_OBJECT_0:
134:         gState.scrollWheelValue = 0;
135:         ResetEvent(evts[0]);
136:         break;
137:     case (WAIT_OBJECT_0 + 1):
138:     {
139:         gMode = MOUSE_POSITION_MODE_ABSOLUTE;
140:         ClipCursor(nullptr);
141:         POINT point;
142:         point.x = gLastX;
143:         point.y = gLastY;
144:         // リモートディスクトップに対応するために移動前にカーソルを表示する
145:         ShowCursor(TRUE);
146:         if (MapWindowPoints(gWindow, nullptr, &point, 1)) {
147:             SetCursorPos(point.x, point.y);
148:         }
149:         gState.x = gLastX;
150:         gState.y = gLastY;
151:     }
152:     break;
153:     case (WAIT_OBJECT_0 + 2):
154:     {
155:         ResetEvent(gRelativeRead);
156:         gMode = MOUSE_POSITION_MODE_RELATIVE;
157:         gState.x = gState.y = 0;
158:         gRelativeX = INT32_MAX;
159:         gRelativeY = INT32_MAX;
160:         ShowCursor(FALSE);
161:         clipToWindow();
162:     }
163:     break;
164:     case WAIT_FAILED:
165:         return;
166:     }
167:     switch (message)
168:     {
169:     case WM_ACTIVATEAPP:
170:         if (wParam) {
171:             gInFocus = true;
172:             if (gMode == MOUSE_POSITION_MODE_RELATIVE) {
173:                 gState.x = gState.y = 0;
174:                 ShowCursor(FALSE);
175:                 clipToWindow();
176:             }
177:         }
178:         else {
179:             int scrollWheel = gState.scrollWheelValue;
180:             memset(&gState, 0, sizeof(gState));
181:             gState.scrollWheelValue = scrollWheel;
182:             gInFocus = false;
183:         }
184:         return;
185:     case WM_INPUT:
186:         if (gInFocus && gMode == MOUSE_POSITION_MODE_RELATIVE) {
187:             RAWINPUT raw;
188:             UINT rawSize = sizeof(raw);
189:             GetRawInputData((HRAWINPUT)lParam, RID_INPUT, &raw, &rawSize, sizeof(RAWINPUTHEADER));
190:             if (raw.header.dwType == RIM_TYPEMOUSE) {
191:                 if (!(raw.data.mouse.usFlags & MOUSE_MOVE_ABSOLUTE)) {
192:                     gState.x = raw.data.mouse.lLastX;
193:                     gState.y = raw.data.mouse.lLastY;
194:                     ResetEvent(gRelativeRead);
195:                 }
196:                 else if (raw.data.mouse.usFlags & MOUSE_VIRTUAL_DESKTOP) {
197:                     // リモートディスクトップなどに対応
198:                     const int width = GetSystemMetrics(SM_CXVIRTUALSCREEN);
199:                     const int height = GetSystemMetrics(SM_CYVIRTUALSCREEN);
200:                     int x = (int)((raw.data.mouse.lLastX / 65535.0f) * width);
201:                     int y = (int)((raw.data.mouse.lLastY / 65535.0f) * height);
202:                     if (gRelativeX == INT32_MAX) {
203:                         gState.x = gState.y = 0;
204:                     }
205:                     else {
206:                         gState.x = x - gRelativeX;
207:                         gState.y = y - gRelativeY;
208:                     }
209:                     gRelativeX = x;
210:                     gRelativeY = y;
211:                     ResetEvent(gRelativeRead);
212:                 }
213:             }
214:         }
215:         return;
216:     case WM_MOUSEMOVE:
217:         break;
218:     case WM_LBUTTONDOWN:
219:         gState.leftButton = true;
220:         break;
221:     case WM_LBUTTONUP:
222:         gState.leftButton = false;
223:         break;
224:     case WM_RBUTTONDOWN:
225:         gState.rightButton = true;
226:         break;
227:     case WM_RBUTTONUP:
228:         gState.rightButton = false;
229:         break;
230:     case WM_MBUTTONDOWN:
231:         gState.middleButton = true;
232:         break;
233:     case WM_MBUTTONUP:
234:         gState.middleButton = false;
235:         break;
236:     case WM_MOUSEWHEEL:
237:         gState.scrollWheelValue += GET_WHEEL_DELTA_WPARAM(wParam);
238:         return;
239:     case WM_XBUTTONDOWN:
240:         switch (GET_XBUTTON_WPARAM(wParam))
241:         {
242:         case XBUTTON1:
243:             gState.xButton1 = true;
244:             break;
245:         case XBUTTON2:
246:             gState.xButton2 = true;
247:             break;
248:         }
249:         break;
250:     case WM_XBUTTONUP:
251:         switch (GET_XBUTTON_WPARAM(wParam))
252:         {
253:         case XBUTTON1:
254:             gState.xButton1 = false;
255:             break;
256:         case XBUTTON2:
257:             gState.xButton2 = false;
258:             break;
259:         }
260:         break;
261:     case WM_MOUSEHOVER:
262:         break;
263:     default:
264:         // マウスに対するメッセージは無かった…
265:         return;
266:     }
267:     if (gMode == MOUSE_POSITION_MODE_ABSOLUTE) {
268:         // すべてのマウスメッセージに対して新しい座標を取得する
269:         int xPos = GET_X_LPARAM(lParam);
270:         int yPos = GET_Y_LPARAM(lParam);
271:         gState.x = gLastX = xPos;
272:         gState.y = gLastY = yPos;
273:     }
274: }
275: void clipToWindow(void)
276: {
277:     assert(gWindow != NULL);
278:     RECT rect;
279:     GetClientRect(gWindow, &rect);
280:     POINT ul;
281:     ul.x = rect.left;
282:     ul.y = rect.top;
283:     POINT lr;
284:     lr.x = rect.right;
285:     lr.y = rect.bottom;
286:     MapWindowPoints(gWindow, NULL, &ul, 1);
287:     MapWindowPoints(gWindow, NULL, &lr, 1);
288:     rect.left = ul.x;
289:     rect.top = ul.y;
290:     rect.right = lr.x;
291:     rect.bottom = lr.y;
292:     ClipCursor(&rect);
293: }
</file>

