1150: // Process hit-testing on resizing borders. Actual size change will be applied in EndTable()
1151: // - Set table->HoveredColumnBorder with a short delay/timer to reduce visual feedback noise.
1152: void ImGui::TableUpdateBorders(ImGuiTable* table)
1153: {
1154:     ImGuiContext& g = *GImGui;
1155:     IM_ASSERT(table->Flags & ImGuiTableFlags_Resizable);
1156:     // At this point OuterRect height may be zero or under actual final height, so we rely on temporal coherency and
1157:     // use the final height from last frame. Because this is only affecting _interaction_ with columns, it is not
1158:     // really problematic (whereas the actual visual will be displayed in EndTable() and using the current frame height).
1159:     // Actual columns highlight/render will be performed in EndTable() and not be affected.
1160:     ImGuiTableInstanceData* table_instance = TableGetInstanceData(table, table->InstanceCurrent);
1161:     const float hit_half_width = ImTrunc(TABLE_RESIZE_SEPARATOR_HALF_THICKNESS * g.CurrentDpiScale);
1162:     const float hit_y1 = (table->FreezeRowsCount >= 1 ? table->OuterRect.Min.y : table->WorkRect.Min.y) + table->AngledHeadersHeight;
1163:     const float hit_y2_body = ImMax(table->OuterRect.Max.y, hit_y1 + table_instance->LastOuterHeight - table->AngledHeadersHeight);
1164:     const float hit_y2_head = hit_y1 + table_instance->LastTopHeadersRowHeight;
1165:     for (int order_n = 0; order_n < table->ColumnsCount; order_n++)
1166:     {
1167:         if (!IM_BITARRAY_TESTBIT(table->EnabledMaskByDisplayOrder, order_n))
1168:             continue;
1169:         const int column_n = table->DisplayOrderToIndex[order_n];
1170:         ImGuiTableColumn* column = &table->Columns[column_n];
1171:         if (column->Flags & (ImGuiTableColumnFlags_NoResize | ImGuiTableColumnFlags_NoDirectResize_))
1172:             continue;
1173:         // ImGuiTableFlags_NoBordersInBodyUntilResize will be honored in TableDrawBorders()
1174:         const float border_y2_hit = (table->Flags & ImGuiTableFlags_NoBordersInBody) ? hit_y2_head : hit_y2_body;
1175:         if ((table->Flags & ImGuiTableFlags_NoBordersInBody) && table->IsUsingHeaders == false)
1176:             continue;
1177:         if (!column->IsVisibleX && table->LastResizedColumn != column_n)
1178:             continue;
1179:         ImGuiID column_id = TableGetColumnResizeID(table, column_n, table->InstanceCurrent);
1180:         ImRect hit_rect(column->MaxX - hit_half_width, hit_y1, column->MaxX + hit_half_width, border_y2_hit);
1181:         ItemAdd(hit_rect, column_id, NULL, ImGuiItemFlags_NoNav);
1182:         //GetForegroundDrawList()->AddRect(hit_rect.Min, hit_rect.Max, IM_COL32(255, 0, 0, 100));
1183:         bool hovered = false, held = false;
1184:         bool pressed = ButtonBehavior(hit_rect, column_id, &hovered, &held, ImGuiButtonFlags_FlattenChildren | ImGuiButtonFlags_PressedOnClick | ImGuiButtonFlags_PressedOnDoubleClick | ImGuiButtonFlags_NoNavFocus);
1185:         if (pressed && IsMouseDoubleClicked(0))
1186:         {
1187:             TableSetColumnWidthAutoSingle(table, column_n);
1188:             ClearActiveID();
1189:             held = false;
1190:         }
1191:         if (held)
1192:         {
1193:             if (table->LastResizedColumn == -1)
1194:                 table->ResizeLockMinContentsX2 = table->RightMostEnabledColumn != -1 ? table->Columns[table->RightMostEnabledColumn].MaxX : -FLT_MAX;
1195:             table->ResizedColumn = (ImGuiTableColumnIdx)column_n;
1196:             table->InstanceInteracted = table->InstanceCurrent;
1197:         }
1198:         if ((hovered && g.HoveredIdTimer > TABLE_RESIZE_SEPARATOR_FEEDBACK_TIMER) || held)
1199:         {
1200:             table->HoveredColumnBorder = (ImGuiTableColumnIdx)column_n;
1201:             SetMouseCursor(ImGuiMouseCursor_ResizeEW);
1202:         }
1203:     }
1204: }
