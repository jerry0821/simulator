 2460: }
 2461: const char* ImTextFindValidUtf8CodepointEnd(const char* in_text_start, const char* in_text_end, const char* in_p)
 2462: {
 2463:     if (in_text_start == in_p)
 2464:         return in_text_start;
 2465:     const char* prev = ImTextFindPreviousUtf8Codepoint(in_text_start, in_p);
 2466:     unsigned int prev_c;
 2467:     int prev_c_len = ImTextCharFromUtf8(&prev_c, prev, in_text_end);
 2468:     if (prev_c != IM_UNICODE_CODEPOINT_INVALID && prev_c_len <= (int)(in_p - prev))
 2469:         return in_p;
 2470:     return prev;
 2471: }
