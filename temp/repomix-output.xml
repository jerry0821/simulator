2164: void ImGui::TableUpdateColumnsWeightFromWidth(ImGuiTable* table)
2165: {
2166:     IM_ASSERT(table->LeftMostStretchedColumn != -1 && table->RightMostStretchedColumn != -1);
2167:     // Measure existing quantities
2168:     float visible_weight = 0.0f;
2169:     float visible_width = 0.0f;
2170:     for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
2171:     {
2172:         ImGuiTableColumn* column = &table->Columns[column_n];
2173:         if (!column->IsEnabled || !(column->Flags & ImGuiTableColumnFlags_WidthStretch))
2174:             continue;
2175:         IM_ASSERT(column->StretchWeight > 0.0f);
2176:         visible_weight += column->StretchWeight;
2177:         visible_width += column->WidthRequest;
2178:     }
2179:     IM_ASSERT(visible_weight > 0.0f && visible_width > 0.0f);
2180:     // Apply new weights
2181:     for (int column_n = 0; column_n < table->ColumnsCount; column_n++)
2182:     {
2183:         ImGuiTableColumn* column = &table->Columns[column_n];
2184:         if (!column->IsEnabled || !(column->Flags & ImGuiTableColumnFlags_WidthStretch))
2185:             continue;
2186:         column->StretchWeight = (column->WidthRequest / visible_width) * visible_weight;
2187:         IM_ASSERT(column->StretchWeight > 0.0f);
2188:     }
2189: }
