 6099: // Handle resize for: Resize Grips, Borders, Gamepad
 6100: // Return true when using auto-fit (double-click on resize grip)
 6101: static int ImGui::UpdateWindowManualResize(ImGuiWindow* window, int* border_hovered, int* border_held, int resize_grip_count, ImU32 resize_grip_col[4], const ImRect& visibility_rect)
 6102: {
 6103:     ImGuiContext& g = *GImGui;
 6104:     ImGuiWindowFlags flags = window->Flags;
 6105:     if ((flags & ImGuiWindowFlags_NoResize) || window->AutoFitFramesX > 0 || window->AutoFitFramesY > 0)
 6106:         return false;
 6107:     if ((flags & ImGuiWindowFlags_AlwaysAutoResize) && (window->ChildFlags & (ImGuiChildFlags_ResizeX | ImGuiChildFlags_ResizeY)) == 0)
 6108:         return false;
 6109:     if (window->WasActive == false) // Early out to avoid running this code for e.g. a hidden implicit/fallback Debug window.
 6110:         return false;
 6111:     int ret_auto_fit_mask = 0x00;
 6112:     const float grip_draw_size = IM_TRUNC(ImMax(g.FontSize * 1.35f, window->WindowRounding + 1.0f + g.FontSize * 0.2f));
 6113:     const float grip_hover_inner_size = (resize_grip_count > 0) ? IM_TRUNC(grip_draw_size * 0.75f) : 0.0f;
 6114:     const float grip_hover_outer_size = g.WindowsBorderHoverPadding;
 6115:     ImRect clamp_rect = visibility_rect;
 6116:     const bool window_move_from_title_bar = !(window->BgClickFlags & ImGuiWindowBgClickFlags_Move) && !(window->Flags & ImGuiWindowFlags_NoTitleBar);
 6117:     if (window_move_from_title_bar)
 6118:         clamp_rect.Min.y -= window->TitleBarHeight;
 6119:     ImVec2 pos_target(FLT_MAX, FLT_MAX);
 6120:     ImVec2 size_target(FLT_MAX, FLT_MAX);
 6121:     // Resize grips and borders are on layer 1
 6122:     window->DC.NavLayerCurrent = ImGuiNavLayer_Menu;
 6123:     // Manual resize grips
 6124:     PushID("#RESIZE");
 6125:     for (int resize_grip_n = 0; resize_grip_n < resize_grip_count; resize_grip_n++)
 6126:     {
 6127:         const ImGuiResizeGripDef& def = resize_grip_def[resize_grip_n];
 6128:         const ImVec2 corner = ImLerp(window->Pos, window->Pos + window->Size, def.CornerPosN);
 6129:         // Using the FlattenChilds button flag we make the resize button accessible even if we are hovering over a child window
 6130:         bool hovered, held;
 6131:         ImRect resize_rect(corner - def.InnerDir * grip_hover_outer_size, corner + def.InnerDir * grip_hover_inner_size);
 6132:         if (resize_rect.Min.x > resize_rect.Max.x) ImSwap(resize_rect.Min.x, resize_rect.Max.x);
 6133:         if (resize_rect.Min.y > resize_rect.Max.y) ImSwap(resize_rect.Min.y, resize_rect.Max.y);
 6134:         ImGuiID resize_grip_id = window->GetID(resize_grip_n); // == GetWindowResizeCornerID()
 6135:         ItemAdd(resize_rect, resize_grip_id, NULL, ImGuiItemFlags_NoNav);
 6136:         ButtonBehavior(resize_rect, resize_grip_id, &hovered, &held, ImGuiButtonFlags_FlattenChildren | ImGuiButtonFlags_NoNavFocus);
 6137:         //GetForegroundDrawList(window)->AddRect(resize_rect.Min, resize_rect.Max, IM_COL32(255, 255, 0, 255));
 6138:         if (hovered || held)
 6139:             SetMouseCursor((resize_grip_n & 1) ? ImGuiMouseCursor_ResizeNESW : ImGuiMouseCursor_ResizeNWSE);
 6140:         if (held && g.IO.MouseDoubleClicked[0])
 6141:         {
 6142:             // Auto-fit when double-clicking
 6143:             ImVec2 size_auto_fit = CalcWindowAutoFitSize(window, window->ContentSizeIdeal, ~0);
 6144:             size_target = CalcWindowSizeAfterConstraint(window, size_auto_fit);
 6145:             ret_auto_fit_mask = 0x03; // Both axes
 6146:             ClearActiveID();
 6147:         }
 6148:         else if (held)
 6149:         {
 6150:             // Resize from any of the four corners
 6151:             // We don't use an incremental MouseDelta but rather compute an absolute target size based on mouse position
 6152:             ImVec2 clamp_min = ImVec2(def.CornerPosN.x == 1.0f ? clamp_rect.Min.x : -FLT_MAX, (def.CornerPosN.y == 1.0f || (def.CornerPosN.y == 0.0f && window_move_from_title_bar)) ? clamp_rect.Min.y : -FLT_MAX);
 6153:             ImVec2 clamp_max = ImVec2(def.CornerPosN.x == 0.0f ? clamp_rect.Max.x : +FLT_MAX, def.CornerPosN.y == 0.0f ? clamp_rect.Max.y : +FLT_MAX);
 6154:             ImVec2 corner_target = g.IO.MousePos - g.ActiveIdClickOffset + ImLerp(def.InnerDir * grip_hover_outer_size, def.InnerDir * -grip_hover_inner_size, def.CornerPosN); // Corner of the window corresponding to our corner grip
 6155:             corner_target = ImClamp(corner_target, clamp_min, clamp_max);
 6156:             CalcResizePosSizeFromAnyCorner(window, corner_target, def.CornerPosN, &pos_target, &size_target);
 6157:         }
 6158:         // Only lower-left grip is visible before hovering/activating
 6159:         const bool resize_grip_visible = held || hovered || (resize_grip_n == 0 && (window->Flags & ImGuiWindowFlags_ChildWindow) == 0);
 6160:         if (resize_grip_visible)
 6161:             resize_grip_col[resize_grip_n] = GetColorU32(held ? ImGuiCol_ResizeGripActive : hovered ? ImGuiCol_ResizeGripHovered : ImGuiCol_ResizeGrip);
 6162:     }
 6163:     int resize_border_mask = 0x00;
 6164:     if (window->Flags & ImGuiWindowFlags_ChildWindow)
 6165:         resize_border_mask |= ((window->ChildFlags & ImGuiChildFlags_ResizeX) ? 0x02 : 0) | ((window->ChildFlags & ImGuiChildFlags_ResizeY) ? 0x08 : 0);
 6166:     else
 6167:         resize_border_mask = g.IO.ConfigWindowsResizeFromEdges ? 0x0F : 0x00;
 6168:     for (int border_n = 0; border_n < 4; border_n++)
 6169:     {
 6170:         if ((resize_border_mask & (1 << border_n)) == 0)
 6171:             continue;
 6172:         const ImGuiResizeBorderDef& def = resize_border_def[border_n];
 6173:         const ImGuiAxis axis = (border_n == ImGuiDir_Left || border_n == ImGuiDir_Right) ? ImGuiAxis_X : ImGuiAxis_Y;
 6174:         bool hovered, held;
 6175:         ImRect border_rect = GetResizeBorderRect(window, border_n, grip_hover_inner_size, g.WindowsBorderHoverPadding);
 6176:         ImGuiID border_id = window->GetID(border_n + 4); // == GetWindowResizeBorderID()
 6177:         ItemAdd(border_rect, border_id, NULL, ImGuiItemFlags_NoNav);
 6178:         ButtonBehavior(border_rect, border_id, &hovered, &held, ImGuiButtonFlags_FlattenChildren | ImGuiButtonFlags_NoNavFocus);
 6179:         //GetForegroundDrawList(window)->AddRect(border_rect.Min, border_rect.Max, IM_COL32(255, 255, 0, 255));
 6180:         if (hovered && g.HoveredIdTimer <= WINDOWS_RESIZE_FROM_EDGES_FEEDBACK_TIMER)
 6181:             hovered = false;
 6182:         if (hovered || held)
 6183:             SetMouseCursor((axis == ImGuiAxis_X) ? ImGuiMouseCursor_ResizeEW : ImGuiMouseCursor_ResizeNS);
 6184:         if (held && g.IO.MouseDoubleClicked[0])
 6185:         {
 6186:             // Double-clicking bottom or right border auto-fit on this axis
 6187:             // FIXME: Support top and right borders: rework CalcResizePosSizeFromAnyCorner() to be reusable in both cases.
