13341: const ImGuiPayload* ImGui::AcceptDragDropPayload(const char* type, ImGuiDragDropFlags flags)
13342: {
13343:     ImGuiContext& g = *GImGui;
13344:     ImGuiPayload& payload = g.DragDropPayload;
13345:     IM_ASSERT(g.DragDropActive);                        // Not called between BeginDragDropTarget() and EndDragDropTarget() ?
13346:     IM_ASSERT(payload.DataFrameCount != -1);            // Forgot to call EndDragDropTarget() ?
13347:     if (type != NULL && !payload.IsDataType(type))
13348:         return NULL;
13349:     // Accept smallest drag target bounding box, this allows us to nest drag targets conveniently without ordering constraints.
13350:     // NB: We currently accept NULL id as target. However, overlapping targets requires a unique ID to function!
13351:     const bool was_accepted_previously = (g.DragDropAcceptIdPrev == g.DragDropTargetId);
13352:     ImRect r = g.DragDropTargetRect;
13353:     float r_surface = r.GetWidth() * r.GetHeight();
13354:     if (r_surface > g.DragDropAcceptIdCurrRectSurface)
13355:         return NULL;
13356:     g.DragDropAcceptFlagsCurr = flags;
13357:     g.DragDropAcceptIdCurr = g.DragDropTargetId;
13358:     g.DragDropAcceptIdCurrRectSurface = r_surface;
13359:     //IMGUI_DEBUG_LOG("AcceptDragDropPayload(): %08X: accept\n", g.DragDropTargetId);
13360:     // Render default drop visuals
13361:     payload.Preview = was_accepted_previously;
13362:     flags |= (g.DragDropSourceFlags & ImGuiDragDropFlags_AcceptNoDrawDefaultRect); // Source can also inhibit the preview (useful for external sources that live for 1 frame)
13363:     const bool draw_target_rect = payload.Preview && !(flags & ImGuiDragDropFlags_AcceptNoDrawDefaultRect);
13364:     if (draw_target_rect && g.DragDropTargetFullViewport != 0)
13365:     {
13366:         ImRect bb = g.DragDropTargetRect;
13367:         bb.Expand(-3.5f);
13368:         RenderDragDropTargetRectEx(GetForegroundDrawList(), bb);
13369:     }
13370:     else if (draw_target_rect)
13371:     {
13372:         RenderDragDropTargetRectForItem(r);
13373:     }
13374:     g.DragDropAcceptFrameCount = g.FrameCount;
13375:     if ((g.DragDropSourceFlags & ImGuiDragDropFlags_SourceExtern) && g.DragDropMouseButton == -1)
13376:         payload.Delivery = was_accepted_previously && (g.DragDropSourceFrameCount < g.FrameCount);
13377:     else
13378:         payload.Delivery = was_accepted_previously && !IsMouseDown(g.DragDropMouseButton); // For extern drag sources affecting OS window focus, it's easier to just test !IsMouseDown() instead of IsMouseReleased()
13379:     if (!payload.Delivery && !(flags & ImGuiDragDropFlags_AcceptBeforeDelivery))
13380:         return NULL;
13381:     if (payload.Delivery)
13382:         IMGUI_DEBUG_LOG_ACTIVEID("[dragdrop] AcceptDragDropPayload(): 0x%08X: payload delivery\n", g.DragDropTargetId);
13383:     return &payload;
13384: }
