 3609: void ImGui::RenderMouseCursor(ImVec2 base_pos, float base_scale, ImGuiMouseCursor mouse_cursor, ImU32 col_fill, ImU32 col_border, ImU32 col_shadow)
 3610: {
 3611:     ImGuiContext& g = *GImGui;
 3612:     if (mouse_cursor <= ImGuiMouseCursor_None || mouse_cursor >= ImGuiMouseCursor_COUNT) // We intentionally accept out of bound values.
 3613:         mouse_cursor = ImGuiMouseCursor_Arrow;
 3614:     ImFontAtlas* font_atlas = g.DrawListSharedData.FontAtlas;
 3615:     for (ImGuiViewportP* viewport : g.Viewports)
 3616:     {
 3617:         // We scale cursor with current viewport/monitor, however Windows 10 for its own hardware cursor seems to be using a different scale factor.
 3618:         ImVec2 offset, size, uv[4];
 3619:         if (!ImFontAtlasGetMouseCursorTexData(font_atlas, mouse_cursor, &offset, &size, &uv[0], &uv[2]))
 3620:             continue;
 3621:         const ImVec2 pos = base_pos - offset;
 3622:         const float scale = base_scale;
 3623:         if (!viewport->GetMainRect().Overlaps(ImRect(pos, pos + ImVec2(size.x + 2, size.y + 2) * scale)))
 3624:             continue;
 3625:         ImDrawList* draw_list = GetForegroundDrawList(viewport);
 3626:         ImTextureRef tex_ref = font_atlas->TexRef;
 3627:         draw_list->PushTexture(tex_ref);
 3628:         draw_list->AddImage(tex_ref, pos + ImVec2(1, 0) * scale, pos + (ImVec2(1, 0) + size) * scale, uv[2], uv[3], col_shadow);
 3629:         draw_list->AddImage(tex_ref, pos + ImVec2(2, 0) * scale, pos + (ImVec2(2, 0) + size) * scale, uv[2], uv[3], col_shadow);
 3630:         draw_list->AddImage(tex_ref, pos,                        pos + size * scale,                  uv[2], uv[3], col_border);
 3631:         draw_list->AddImage(tex_ref, pos,                        pos + size * scale,                  uv[0], uv[1], col_fill);
 3632:         if (mouse_cursor == ImGuiMouseCursor_Wait || mouse_cursor == ImGuiMouseCursor_Progress)
 3633:         {
 3634:             float a_min = ImFmod((float)g.Time * 5.0f, 2.0f * IM_PI);
 3635:             float a_max = a_min + IM_PI * 1.65f;
 3636:             draw_list->PathArcTo(pos + ImVec2(14, -1) * scale, 6.0f * scale, a_min, a_max);
 3637:             draw_list->PathStroke(col_fill, ImDrawFlags_None, 3.0f * scale);
 3638:         }
 3639:         draw_list->PopTexture();
 3640:     }
 3641: }
