11440: void ImGui::BringWindowToDisplayBehind(ImGuiWindow* window, ImGuiWindow* behind_window)
11441: {
11442:     IM_ASSERT(window != NULL && behind_window != NULL);
11443:     ImGuiContext& g = *GImGui;
11444:     window = window->RootWindow;
11445:     behind_window = behind_window->RootWindow;
11446:     int pos_wnd = FindWindowDisplayIndex(window);
11447:     int pos_beh = FindWindowDisplayIndex(behind_window);
11448:     if (pos_wnd < pos_beh)
11449:     {
11450:         size_t copy_bytes = (pos_beh - pos_wnd - 1) * sizeof(ImGuiWindow*);
11451:         memmove(&g.Windows.Data[pos_wnd], &g.Windows.Data[pos_wnd + 1], copy_bytes);
11452:         g.Windows[pos_beh - 1] = window;
11453:     }
11454:     else
11455:     {
11456:         size_t copy_bytes = (pos_wnd - pos_beh) * sizeof(ImGuiWindow*);
11457:         memmove(&g.Windows.Data[pos_beh + 1], &g.Windows.Data[pos_beh], copy_bytes);
11458:         g.Windows[pos_beh] = window;
11459:     }
11460: }
