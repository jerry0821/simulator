16128: static const char* DebugItemPathQuery_GetResultAsPath(ImGuiDebugItemPathQuery* query, bool hex_encode_non_ascii_chars)
16129: {
16130:     ImGuiTextBuffer* buf = &query->ResultPathBuf;
16131:     buf->resize(0);
16132:     for (int stack_n = 0; stack_n < query->Results.Size; stack_n++)
16133:     {
16134:         char level_desc[256];
16135:         DebugItemPathQuery_FormatLevelInfo(query, stack_n, false, level_desc, IM_ARRAYSIZE(level_desc));
16136:         buf->append(stack_n == 0 ? "//" : "/");
16137:         for (const char* p = level_desc; *p != 0; )
16138:         {
16139:             unsigned int c;
16140:             const char* p_next = p + ImTextCharFromUtf8(&c, p, NULL);
16141:             if (c == '/')
16142:                 buf->append("\\");
16143:             if (c < 256 || !hex_encode_non_ascii_chars)
16144:                 buf->append(p, p_next);
16145:             else for (; p < p_next; p++)
16146:                 buf->appendf("\\x%02x", (unsigned char)*p);
16147:             p = p_next;
16148:         }
16149:     }
16150:     return buf->c_str();
16151: }
