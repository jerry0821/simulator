3610: // Reimplementation of stb_textedit_move_line_start()/stb_textedit_move_line_end() which supports word-wrapping.
3611: static int STB_TEXTEDIT_MOVELINESTART_IMPL(ImGuiInputTextState* obj, ImStb::STB_TexteditState* state, int cursor)
3612: {
3613:     if (state->single_line)
3614:         return 0;
3615:     if (obj->WrapWidth > 0.0f)
3616:     {
3617:         ImGuiContext& g = *obj->Ctx;
3618:         const char* p_cursor = obj->TextSrc + cursor;
3619:         const char* p_bol = ImStrbol(p_cursor, obj->TextSrc);
3620:         const char* p = p_bol;
3621:         const char* text_end = obj->TextSrc + obj->TextLen; // End of line would be enough
3622:         while (p >= p_bol)
3623:         {
3624:             const char* p_eol = ImFontCalcWordWrapPositionEx(g.Font, g.FontSize, p, text_end, obj->WrapWidth, ImDrawTextFlags_WrapKeepBlanks);
3625:             if (p == p_cursor) // If we are already on a visible beginning-of-line, return real beginning-of-line (would be same as regular handler below)
3626:                 return (int)(p_bol - obj->TextSrc);
3627:             if (p_eol == p_cursor && obj->TextA[cursor] != '\n' && obj->LastMoveDirectionLR == ImGuiDir_Left)
3628:                 return (int)(p_bol - obj->TextSrc);
3629:             if (p_eol >= p_cursor)
3630:                 return (int)(p - obj->TextSrc);
3631:             p = (*p_eol == '\n') ? p_eol + 1 : p_eol;
3632:         }
3633:     }
3634:     // Regular handler, same as stb_textedit_move_line_start()
3635:     while (cursor > 0)
3636:     {
3637:         int prev_cursor = IMSTB_TEXTEDIT_GETPREVCHARINDEX(obj, cursor);
3638:         if (STB_TEXTEDIT_GETCHAR(obj, prev_cursor) == STB_TEXTEDIT_NEWLINE)
3639:             break;
3640:         cursor = prev_cursor;
3641:     }
3642:     return cursor;
3643: }
3644: static int STB_TEXTEDIT_MOVELINEEND_IMPL(ImGuiInputTextState* obj, ImStb::STB_TexteditState* state, int cursor)
3645: {
3646:     int n = STB_TEXTEDIT_STRINGLEN(obj);
3647:     if (state->single_line)
3648:         return n;
3649:     if (obj->WrapWidth > 0.0f)
3650:     {
3651:         ImGuiContext& g = *obj->Ctx;
3652:         const char* p_cursor = obj->TextSrc + cursor;
3653:         const char* p = ImStrbol(p_cursor, obj->TextSrc);
3654:         const char* text_end = obj->TextSrc + obj->TextLen; // End of line would be enough
3655:         while (p < text_end)
3656:         {
3657:             const char* p_eol = ImFontCalcWordWrapPositionEx(g.Font, g.FontSize, p, text_end, obj->WrapWidth, ImDrawTextFlags_WrapKeepBlanks);
3658:             cursor = (int)(p_eol - obj->TextSrc);
3659:             if (p_eol == p_cursor && obj->LastMoveDirectionLR != ImGuiDir_Left) // If we are already on a visible end-of-line, switch to regular handle
3660:                 break;
3661:             if (p_eol > p_cursor)
3662:                 return cursor;
3663:             p = (*p_eol == '\n') ? p_eol + 1 : p_eol;
3664:         }
3665:     }
3666:     // Regular handler, same as stb_textedit_move_line_end()
3667:     while (cursor < n && STB_TEXTEDIT_GETCHAR(obj, cursor) != STB_TEXTEDIT_NEWLINE)
3668:         cursor = IMSTB_TEXTEDIT_GETNEXTCHARINDEX(obj, cursor);
3669:     return cursor;
3670: }
