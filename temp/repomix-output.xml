3552: // Flags stored in ImGuiViewport::Flags, giving indications to the platform backends.
3553: enum ImGuiViewportFlags_
3554: {
3555:     ImGuiViewportFlags_None                     = 0,
3556:     ImGuiViewportFlags_IsPlatformWindow         = 1 << 0,   // Represent a Platform Window
3557:     ImGuiViewportFlags_IsPlatformMonitor        = 1 << 1,   // Represent a Platform Monitor (unused yet)
