10960: void ImGui::ClosePopupToLevel(int remaining, bool restore_focus_to_window_under_popup)
10961: {
10962:     ImGuiContext& g = *GImGui;
10963:     IMGUI_DEBUG_LOG_POPUP("[popup] ClosePopupToLevel(%d), restore_under=%d\n", remaining, restore_focus_to_window_under_popup);
10964:     IM_ASSERT(remaining >= 0 && remaining < g.OpenPopupStack.Size);
10965:     if (g.DebugLogFlags & ImGuiDebugLogFlags_EventPopup)
10966:         for (int n = remaining; n < g.OpenPopupStack.Size; n++)
10967:             IMGUI_DEBUG_LOG_POPUP("[popup] - Closing PopupID 0x%08X Window \"%s\"\n", g.OpenPopupStack[n].PopupId, g.OpenPopupStack[n].Window ? g.OpenPopupStack[n].Window->Name : NULL);
10968:     // Trim open popup stack
10969:     ImGuiPopupData prev_popup = g.OpenPopupStack[remaining];
10970:     g.OpenPopupStack.resize(remaining);
10971:     // Restore focus (unless popup window was not yet submitted, and didn't have a chance to take focus anyhow. See #7325 for an edge case)
10972:     if (restore_focus_to_window_under_popup && prev_popup.Window)
10973:     {
10974:         ImGuiWindow* popup_window = prev_popup.Window;
10975:         ImGuiWindow* focus_window = (popup_window->Flags & ImGuiWindowFlags_ChildMenu) ? popup_window->ParentWindow : prev_popup.RestoreNavWindow;
10976:         if (focus_window && !focus_window->WasActive)
10977:             FocusTopMostWindowUnderOne(popup_window, NULL, NULL, ImGuiFocusRequestFlags_RestoreFocusedChild); // Fallback
10978:         else
10979:             FocusWindow(focus_window, (g.NavLayer == ImGuiNavLayer_Main) ? ImGuiFocusRequestFlags_RestoreFocusedChild : ImGuiFocusRequestFlags_None);
10980:     }
10981: }
10982: // Close the popup we have begin-ed into.
10983: void ImGui::CloseCurrentPopup()
10984: {
10985:     ImGuiContext& g = *GImGui;
10986:     int popup_idx = g.BeginPopupStack.Size - 1;
10987:     if (popup_idx < 0 || popup_idx >= g.OpenPopupStack.Size || g.BeginPopupStack[popup_idx].PopupId != g.OpenPopupStack[popup_idx].PopupId)
10988:         return;
10989:     // Closing a menu closes its top-most parent popup (unless a modal)
10990:     while (popup_idx > 0)
10991:     {
10992:         ImGuiWindow* popup_window = g.OpenPopupStack[popup_idx].Window;
10993:         ImGuiWindow* parent_popup_window = g.OpenPopupStack[popup_idx - 1].Window;
10994:         bool close_parent = false;
10995:         if (popup_window && (popup_window->Flags & ImGuiWindowFlags_ChildMenu))
10996:             if (parent_popup_window && !(parent_popup_window->Flags & ImGuiWindowFlags_MenuBar))
10997:                 close_parent = true;
10998:         if (!close_parent)
10999:             break;
11000:         popup_idx--;
11001:     }
11002:     IMGUI_DEBUG_LOG_POPUP("[popup] CloseCurrentPopup %d -> %d\n", g.BeginPopupStack.Size - 1, popup_idx);
11003:     ClosePopupToLevel(popup_idx, true);
11004:     // A common pattern is to close a popup when selecting a menu item/selectable that will open another window.
11005:     // To improve this usage pattern, we avoid nav highlight for a single frame in the parent window.
11006:     // Similarly, we could avoid mouse hover highlight in this window but it is less visually problematic.
11007:     if (ImGuiWindow* window = g.NavWindow)
11008:         window->DC.NavHideHighlightOneFrame = true;
11009: }
