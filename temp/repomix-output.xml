122:     // Texture metadata
123:     enum TEX_DIMENSION : uint32_t
124:         // Subset here matches D3D10_RESOURCE_DIMENSION and D3D11_RESOURCE_DIMENSION
125:     {
126:         TEX_DIMENSION_TEXTURE1D = 2,
127:         TEX_DIMENSION_TEXTURE2D = 3,
128:         TEX_DIMENSION_TEXTURE3D = 4,
129:     };
130:     enum TEX_MISC_FLAG : uint32_t
131:         // Subset here matches D3D10_RESOURCE_MISC_FLAG and D3D11_RESOURCE_MISC_FLAG
132:     {
133:         TEX_MISC_TEXTURECUBE = 0x4L,
134:     };
135:     enum TEX_MISC_FLAG2 : uint32_t
136:     {
137:         TEX_MISC2_ALPHA_MODE_MASK = 0x7L,
138:     };
139:     enum TEX_ALPHA_MODE : uint32_t
140:         // Matches DDS_ALPHA_MODE, encoded in MISC_FLAGS2
141:     {
142:         TEX_ALPHA_MODE_UNKNOWN = 0,
143:         TEX_ALPHA_MODE_STRAIGHT = 1,
144:         TEX_ALPHA_MODE_PREMULTIPLIED = 2,
145:         TEX_ALPHA_MODE_OPAQUE = 3,
146:         TEX_ALPHA_MODE_CUSTOM = 4,
147:     };
148:     struct DIRECTX_TEX_API TexMetadata
149:     {
150:         size_t          width;
151:         size_t          height;     // Should be 1 for 1D textures
152:         size_t          depth;      // Should be 1 for 1D or 2D textures
153:         size_t          arraySize;  // For cubemap, this is a multiple of 6
154:         size_t          mipLevels;
155:         uint32_t        miscFlags;
156:         uint32_t        miscFlags2;
157:         DXGI_FORMAT     format;
158:         TEX_DIMENSION   dimension;
159:         size_t __cdecl ComputeIndex(size_t mip, size_t item, size_t slice) const noexcept;
160:             // Returns size_t(-1) to indicate an out-of-range error
161:         bool __cdecl IsCubemap() const noexcept { return (miscFlags & TEX_MISC_TEXTURECUBE) != 0; }
162:             // Helper for miscFlags
163:         bool __cdecl IsPMAlpha() const noexcept { return ((miscFlags2 & TEX_MISC2_ALPHA_MODE_MASK) == TEX_ALPHA_MODE_PREMULTIPLIED) != 0; }
164:         void __cdecl SetAlphaMode(TEX_ALPHA_MODE mode) noexcept { miscFlags2 = (miscFlags2 & ~static_cast<uint32_t>(TEX_MISC2_ALPHA_MODE_MASK)) | static_cast<uint32_t>(mode); }
165:         TEX_ALPHA_MODE __cdecl GetAlphaMode() const noexcept { return static_cast<TEX_ALPHA_MODE>(miscFlags2 & TEX_MISC2_ALPHA_MODE_MASK); }
166:             // Helpers for miscFlags2
167:         bool __cdecl IsVolumemap() const noexcept { return (dimension == TEX_DIMENSION_TEXTURE3D); }
168:             // Helper for dimension
169:         uint32_t __cdecl CalculateSubresource(size_t mip, size_t item) const noexcept;
170:         uint32_t __cdecl CalculateSubresource(size_t mip, size_t item, size_t plane) const noexcept;
171:             // Returns size_t(-1) to indicate an out-of-range error
172:     };
173:     struct DIRECTX_TEX_API DDSMetaData
174:     {
175:         uint32_t    size;           // DDPIXELFORMAT.dwSize
176:         uint32_t    flags;          // DDPIXELFORMAT.dwFlags
177:         uint32_t    fourCC;         // DDPIXELFORMAT.dwFourCC
178:         uint32_t    RGBBitCount;    // DDPIXELFORMAT.dwRGBBitCount/dwYUVBitCount/dwAlphaBitDepth/dwLuminanceBitCount/dwBumpBitCount
179:         uint32_t    RBitMask;       // DDPIXELFORMAT.dwRBitMask/dwYBitMask/dwLuminanceBitMask/dwBumpDuBitMask
180:         uint32_t    GBitMask;       // DDPIXELFORMAT.dwGBitMask/dwUBitMask/dwBumpDvBitMask
181:         uint32_t    BBitMask;       // DDPIXELFORMAT.dwBBitMask/dwVBitMask/dwBumpLuminanceBitMask
182:         uint32_t    ABitMask;       // DDPIXELFORMAT.dwRGBAlphaBitMask/dwYUVAlphaBitMask/dwLuminanceAlphaBitMask
183:         bool __cdecl IsDX10() const noexcept { return (fourCC == 0x30315844); }
184:     };
185:     enum DDS_FLAGS : uint32_t
186:     {
187:         DDS_FLAGS_NONE = 0x0,
188:         DDS_FLAGS_LEGACY_DWORD = 0x1,
189:         // Assume pitch is DWORD aligned instead of BYTE aligned (used by some legacy DDS files)
190:         DDS_FLAGS_NO_LEGACY_EXPANSION = 0x2,
191:         // Do not implicitly convert legacy formats that result in larger pixel sizes (24 bpp, 3:3:2, A8L8, A4L4, P8, A8P8)
192:         DDS_FLAGS_NO_R10B10G10A2_FIXUP = 0x4,
193:         // Do not use work-around for long-standing D3DX DDS file format issue which reversed the 10:10:10:2 color order masks
194:         DDS_FLAGS_FORCE_RGB = 0x8,
195:         // Convert DXGI 1.1 BGR formats to DXGI_FORMAT_R8G8B8A8_UNORM to avoid use of optional WDDM 1.1 formats
196:         DDS_FLAGS_NO_16BPP = 0x10,
197:         // Conversions avoid use of 565, 5551, and 4444 formats and instead expand to 8888 to avoid use of optional WDDM 1.2 formats
198:         DDS_FLAGS_EXPAND_LUMINANCE = 0x20,
199:         // When loading legacy luminance formats expand replicating the color channels rather than leaving them packed (L8, L16, A8L8)
200:         DDS_FLAGS_BAD_DXTN_TAILS = 0x40,
201:         // Some older DXTn DDS files incorrectly handle mipchain tails for blocks smaller than 4x4
202:         DDS_FLAGS_PERMISSIVE = 0x80,
203:         // Allow some file variants due to common bugs in the header written by various leagcy DDS writers
204:         DDS_FLAGS_IGNORE_MIPS = 0x100,
205:         // Allow some files to be read that have incorrect mipcount values in the header by only reading the top-level mip
206:         DDS_FLAGS_FORCE_DX10_EXT = 0x10000,
207:         // Always use the 'DX10' header extension for DDS writer (i.e. don't try to write DX9 compatible DDS files)
208:         DDS_FLAGS_FORCE_DX10_EXT_MISC2 = 0x20000,
209:         // DDS_FLAGS_FORCE_DX10_EXT including miscFlags2 information (result may not be compatible with D3DX10 or D3DX11)
210:         DDS_FLAGS_FORCE_DX9_LEGACY = 0x40000,
211:         // Force use of legacy header for DDS writer (will fail if unable to write as such)
212:         DDS_FLAGS_FORCE_DXT5_RXGB = 0x80000,
213:         // Force use of 'RXGB' instead of 'DXT5' for DDS write of BC3_UNORM data
214:         DDS_FLAGS_ALLOW_LARGE_FILES = 0x1000000,
215:         // Enables the loader to read large dimension .dds files (i.e. greater than known hardware requirements)
216:     };
217:     enum TGA_FLAGS : uint32_t
218:     {
219:         TGA_FLAGS_NONE = 0x0,
220:         TGA_FLAGS_BGR = 0x1,
221:         // 24bpp files are returned as BGRX; 32bpp files are returned as BGRA
222:         TGA_FLAGS_ALLOW_ALL_ZERO_ALPHA = 0x2,
223:         // If the loaded image has an all zero alpha channel, normally we assume it should be opaque. This flag leaves it alone.
224:         TGA_FLAGS_IGNORE_SRGB = 0x10,
225:         // Ignores sRGB TGA 2.0 metadata if present in the file
226:         TGA_FLAGS_FORCE_SRGB = 0x20,
227:         // Writes sRGB metadata into the file reguardless of format (TGA 2.0 only)
228:         TGA_FLAGS_FORCE_LINEAR = 0x40,
229:         // Writes linear gamma metadata into the file reguardless of format (TGA 2.0 only)
230:         TGA_FLAGS_DEFAULT_SRGB = 0x80,
231:         // If no colorspace is specified in TGA 2.0 metadata, assume sRGB
232:     };
233:     enum WIC_FLAGS : uint32_t
234:     {
235:         WIC_FLAGS_NONE = 0x0,
236:         WIC_FLAGS_FORCE_RGB = 0x1,
237:         // Loads DXGI 1.1 BGR formats as DXGI_FORMAT_R8G8B8A8_UNORM to avoid use of optional WDDM 1.1 formats
238:         WIC_FLAGS_NO_X2_BIAS = 0x2,
239:         // Loads DXGI 1.1 X2 10:10:10:2 format as DXGI_FORMAT_R10G10B10A2_UNORM
240:         WIC_FLAGS_NO_16BPP = 0x4,
241:         // Loads 565, 5551, and 4444 formats as 8888 to avoid use of optional WDDM 1.2 formats
242:         WIC_FLAGS_ALLOW_MONO = 0x8,
243:         // Loads 1-bit monochrome (black & white) as R1_UNORM rather than 8-bit grayscale
244:         WIC_FLAGS_ALL_FRAMES = 0x10,
245:         // Loads all images in a multi-frame file, converting/resizing to match the first frame as needed, defaults to 0th frame otherwise
246:         WIC_FLAGS_IGNORE_SRGB = 0x20,
247:         // Ignores sRGB metadata if present in the file
248:         WIC_FLAGS_FORCE_SRGB = 0x40,
249:         // Writes sRGB metadata into the file reguardless of format
250:         WIC_FLAGS_FORCE_LINEAR = 0x80,
251:         // Writes linear gamma metadata into the file reguardless of format
252:         WIC_FLAGS_DEFAULT_SRGB = 0x100,
253:         // If no colorspace is specified, assume sRGB
254:         WIC_FLAGS_DITHER = 0x10000,
255:         // Use ordered 4x4 dithering for any required conversions
256:         WIC_FLAGS_DITHER_DIFFUSION = 0x20000,
257:         // Use error-diffusion dithering for any required conversions
258:         WIC_FLAGS_FILTER_POINT = 0x100000,
259:         WIC_FLAGS_FILTER_LINEAR = 0x200000,
260:         WIC_FLAGS_FILTER_CUBIC = 0x300000,
261:         WIC_FLAGS_FILTER_FANT = 0x400000, // Combination of Linear and Box filter
262:             // Filtering mode to use for any required image resizing (only needed when loading arrays of differently sized images; defaults to Fant)
263:     };
