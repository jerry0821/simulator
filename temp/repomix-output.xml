3771: float ImGui::GetColumnNormFromOffset(const ImGuiOldColumns* columns, float offset)
3772: {
3773:     return offset / (columns->OffMaxX - columns->OffMinX);
3774: }
3775: static const float COLUMNS_HIT_RECT_HALF_THICKNESS = 4.0f;
3776: static float GetDraggedColumnOffset(ImGuiOldColumns* columns, int column_index)
3777: {
3778:     // Active (dragged) column always follow mouse. The reason we need this is that dragging a column to the right edge of an auto-resizing
3779:     // window creates a feedback loop because we store normalized positions. So while dragging we enforce absolute positioning.
3780:     ImGuiContext& g = *GImGui;
3781:     ImGuiWindow* window = g.CurrentWindow;
3782:     IM_ASSERT(column_index > 0); // We are not supposed to drag column 0.
3783:     IM_ASSERT(g.ActiveId == columns->ID + ImGuiID(column_index));
3784:     float x = g.IO.MousePos.x - g.ActiveIdClickOffset.x + ImTrunc(COLUMNS_HIT_RECT_HALF_THICKNESS * g.CurrentDpiScale) - window->Pos.x;
3785:     x = ImMax(x, ImGui::GetColumnOffset(column_index - 1) + g.Style.ColumnsMinSpacing);
3786:     if ((columns->Flags & ImGuiOldColumnFlags_NoPreserveWidths))
3787:         x = ImMin(x, ImGui::GetColumnOffset(column_index + 1) - g.Style.ColumnsMinSpacing);
3788:     return x;
3789: }
3790: float ImGui::GetColumnOffset(int column_index)
3791: {
3792:     ImGuiWindow* window = GetCurrentWindowRead();
3793:     ImGuiOldColumns* columns = window->DC.CurrentColumns;
3794:     if (columns == NULL)
3795:         return 0.0f;
3796:     if (column_index < 0)
3797:         column_index = columns->Current;
3798:     IM_ASSERT(column_index < columns->Columns.Size);
3799:     const float t = columns->Columns[column_index].OffsetNorm;
3800:     const float x_offset = ImLerp(columns->OffMinX, columns->OffMaxX, t);
3801:     return x_offset;
3802: }
3803: static float GetColumnWidthEx(ImGuiOldColumns* columns, int column_index, bool before_resize = false)
3804: {
3805:     if (column_index < 0)
3806:         column_index = columns->Current;
3807:     float offset_norm;
3808:     if (before_resize)
3809:         offset_norm = columns->Columns[column_index + 1].OffsetNormBeforeResize - columns->Columns[column_index].OffsetNormBeforeResize;
3810:     else
3811:         offset_norm = columns->Columns[column_index + 1].OffsetNorm - columns->Columns[column_index].OffsetNorm;
3812:     return ImGui::GetColumnOffsetFromNorm(columns, offset_norm);
3813: }
