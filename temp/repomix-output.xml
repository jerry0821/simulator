 33: #pragma once
 34: #ifndef AI_IOSTREAMBUFFER_H_INC
 35: #define AI_IOSTREAMBUFFER_H_INC
 36: #ifdef __GNUC__
 37: #pragma GCC system_header
 38: #endif
 39: #include "ParsingUtils.h"
 40: #include "types.h"
 41: #include "IOStream.hpp>
 42: #include <vector>
 43: namespace Assimp {
 44: // ---------------------------------------------------------------------------
 45: /**
 46:  *  Implementation of a cached stream buffer.
 47:  */
 48: template <class T>
 49: class IOStreamBuffer {
 50: public:
 51:     /// @brief  The class constructor.
 52:     IOStreamBuffer(size_t cache = 4096 * 4096);
 53:     /// @brief  The class destructor.
 54:     ~IOStreamBuffer();
 55:     /// @brief  Will open the cached access for a given stream.
 56:     /// @param  stream      The stream to cache.
 57:     /// @return true if successful.
 58:     bool open(IOStream *stream);
 59:     /// @brief  Will close the cached access.
 60:     /// @return true if successful.
 61:     bool close();
 62:     /// @brief  Returns the file-size.
 63:     /// @return The file-size.
 64:     size_t size() const;
 65:     /// @brief  Returns the cache size.
 66:     /// @return The cache size.
 67:     size_t cacheSize() const;
 68:     /// @brief  Will read the next block.
 69:     /// @return true if successful.
 70:     bool readNextBlock();
 71:     /// @brief  Returns the number of blocks to read.
 72:     /// @return The number of blocks.
 73:     size_t getNumBlocks() const;
 74:     /// @brief  Returns the current block index.
 75:     /// @return The current block index.
 76:     size_t getCurrentBlockIndex() const;
 77:     /// @brief  Returns the current file pos.
 78:     /// @return The current file pos.
 79:     size_t getFilePos() const;
 80:     /// @brief  Will read the next line.
 81:     /// @param  buffer      The buffer for the next line.
 82:     /// @return true if successful.
 83:     bool getNextDataLine(std::vector<T> &buffer, T continuationToken);
 84:     /// @brief  Will read the next line ascii or binary end line char.
 85:     /// @param  buffer      The buffer for the next line.
 86:     /// @return true if successful.
 87:     bool getNextLine(std::vector<T> &buffer);
 88:     /// @brief  Will read the next block.
 89:     /// @param  buffer      The buffer for the next block.
 90:     /// @return true if successful.
 91:     bool getNextBlock(std::vector<T> &buffer);
 92: private:
 93:     IOStream *m_stream;
 94:     size_t m_filesize;
 95:     size_t m_cacheSize;
 96:     size_t m_numBlocks;
 97:     size_t m_blockIdx;
 98:     std::vector<T> m_cache;
 99:     size_t m_cachePos;
100:     size_t m_filePos;
101: };
102: template <class T>
103: AI_FORCE_INLINE IOStreamBuffer<T>::IOStreamBuffer(size_t cache) :
104:         m_stream(nullptr),
105:         m_filesize(0),
106:         m_cacheSize(cache),
107:         m_numBlocks(0),
108:         m_blockIdx(0),
109:         m_cachePos(0),
110:         m_filePos(0) {
111:     m_cache.resize(cache);
112:     std::fill(m_cache.begin(), m_cache.end(), '\n');
113: }
114: template <class T>
115: AI_FORCE_INLINE IOStreamBuffer<T>::~IOStreamBuffer() {
116:     // empty
117: }
118: template <class T>
119: AI_FORCE_INLINE bool IOStreamBuffer<T>::open(IOStream *stream) {
120:     //  file still opened!
121:     if (nullptr != m_stream) {
122:         return false;
123:     }
124:     //  Invalid stream pointer
125:     if (nullptr == stream) {
126:         return false;
127:     }
128:     m_stream = stream;
129:     m_filesize = m_stream->FileSize();
130:     if (m_filesize == 0) {
131:         return false;
132:     }
133:     if (m_filesize < m_cacheSize) {
134:         m_cacheSize = m_filesize;
135:     }
136:     m_numBlocks = m_filesize / m_cacheSize;
137:     if ((m_filesize % m_cacheSize) > 0) {
138:         m_numBlocks++;
139:     }
140:     return true;
141: }
142: template <class T>
143: AI_FORCE_INLINE bool IOStreamBuffer<T>::close() {
144:     if (nullptr == m_stream) {
145:         return false;
146:     }
147:     // init counters and state vars
148:     m_stream = nullptr;
149:     m_filesize = 0;
150:     m_numBlocks = 0;
151:     m_blockIdx = 0;
152:     m_cachePos = 0;
153:     m_filePos = 0;
154:     return true;
155: }
156: template <class T>
157: AI_FORCE_INLINE
158:         size_t
159:         IOStreamBuffer<T>::size() const {
160:     return m_filesize;
161: }
162: template <class T>
163: AI_FORCE_INLINE
164:         size_t
165:         IOStreamBuffer<T>::cacheSize() const {
166:     return m_cacheSize;
167: }
168: template <class T>
169: AI_FORCE_INLINE bool IOStreamBuffer<T>::readNextBlock() {
170:     m_stream->Seek(m_filePos, aiOrigin_SET);
171:     size_t readLen = m_stream->Read(&m_cache[0], sizeof(T), m_cacheSize);
172:     if (readLen == 0) {
173:         return false;
174:     }
175:     if (readLen < m_cacheSize) {
176:         m_cacheSize = readLen;
177:     }
178:     m_filePos += m_cacheSize;
179:     m_cachePos = 0;
180:     m_blockIdx++;
181:     return true;
182: }
183: template <class T>
184: AI_FORCE_INLINE size_t IOStreamBuffer<T>::getNumBlocks() const {
185:     return m_numBlocks;
186: }
187: template <class T>
188: AI_FORCE_INLINE size_t IOStreamBuffer<T>::getCurrentBlockIndex() const {
189:     return m_blockIdx;
190: }
191: template <class T>
192: AI_FORCE_INLINE size_t IOStreamBuffer<T>::getFilePos() const {
193:     return m_filePos;
194: }
195: template <class T>
196: AI_FORCE_INLINE bool IOStreamBuffer<T>::getNextDataLine(std::vector<T> &buffer, T continuationToken) {
197:     buffer.resize(m_cacheSize);
198:     if (m_cachePos >= m_cacheSize || 0 == m_filePos) {
199:         if (!readNextBlock()) {
200:             return false;
201:         }
202:     }
203:     size_t i = 0;
204:     for (;;) {
205:         if (continuationToken == m_cache[m_cachePos] && IsLineEnd(m_cache[m_cachePos + 1])) {
206:             ++m_cachePos;
207:             while (m_cache[m_cachePos] != '\n') {
208:                 ++m_cachePos;
209:             }
210:             ++m_cachePos;
211:         } else if (IsLineEnd(m_cache[m_cachePos])) {
212:             break;
213:         }
214:         buffer[i] = m_cache[m_cachePos];
215:         ++m_cachePos;
216:         ++i;
217:         if(i == buffer.size()) {
218:             buffer.resize(buffer.size() * 2);
219:         }
220:         if (m_cachePos >= size()) {
221:             break;
222:         }
223:         if (m_cachePos >= m_cacheSize) {
224:             if (!readNextBlock()) {
225:                 return false;
226:             }
227:         }
228:     }
229:     buffer[i] = '\n';
230:     ++m_cachePos;
231:     return true;
232: }
233: static AI_FORCE_INLINE bool isEndOfCache(size_t pos, size_t cacheSize) {
234:     return (pos == cacheSize);
235: }
236: template <class T>
237: AI_FORCE_INLINE bool IOStreamBuffer<T>::getNextLine(std::vector<T> &buffer) {
238:     buffer.resize(m_cacheSize);
239:     if (isEndOfCache(m_cachePos, m_cacheSize) || 0 == m_filePos) {
240:         if (!readNextBlock()) {
241:             return false;
242:         }
243:     }
244:     if (IsLineEnd(m_cache[m_cachePos])) {
245:         // skip line end
246:         while (m_cache[m_cachePos] != '\n') {
247:             ++m_cachePos;
248:         }
249:         ++m_cachePos;
250:         if (isEndOfCache(m_cachePos, m_cacheSize)) {
251:             if (!readNextBlock()) {
252:                 return false;
253:             }
254:         }
255:     }
256:     size_t i(0);
257:     while (!IsLineEnd(m_cache[m_cachePos])) {
258:         buffer[i] = m_cache[m_cachePos];
259:         ++m_cachePos;
260:         ++i;
261:         if(i == buffer.size()) {
262:             buffer.resize(buffer.size() * 2);
263:         }
264:         if (m_cachePos >= m_cacheSize) {
265:             if (!readNextBlock()) {
266:                 return false;
267:             }
268:         }
269:     }
270:     buffer[i] = '\n';
271:     ++m_cachePos;
272:     return true;
273: }
274: template <class T>
275: AI_FORCE_INLINE bool IOStreamBuffer<T>::getNextBlock(std::vector<T> &buffer) {
276:     // Return the last block-value if getNextLine was used before
277:     if (0 != m_cachePos) {
278:         buffer = std::vector<T>(m_cache.begin() + m_cachePos, m_cache.end());
279:         m_cachePos = 0;
280:     } else {
281:         if (!readNextBlock()) {
282:             return false;
283:         }
284:         buffer = std::vector<T>(m_cache.begin(), m_cache.end());
285:     }
286:     return true;
287: }
288: } // namespace Assimp
289: #endif // AI_IOSTREAMBUFFER_H_INC
</file>

