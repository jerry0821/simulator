 2057: void ImFormatStringToTempBuffer(const char** out_buf, const char** out_buf_end, const char* fmt, ...)
 2058: {
 2059:     va_list args;
 2060:     va_start(args, fmt);
 2061:     ImFormatStringToTempBufferV(out_buf, out_buf_end, fmt, args);
 2062:     va_end(args);
 2063: }
 2064: // FIXME: Should rework API toward allowing multiple in-flight temp buffers (easier and safer for caller)
 2065: // by making the caller acquire a temp buffer token, with either explicit or destructor release, e.g.
 2066: //  ImGuiTempBufferToken token;
 2067: //  ImFormatStringToTempBuffer(token, ...);
 2068: void ImFormatStringToTempBufferV(const char** out_buf, const char** out_buf_end, const char* fmt, va_list args)
 2069: {
 2070:     ImGuiContext& g = *GImGui;
 2071:     if (fmt[0] == '%' && fmt[1] == 's' && fmt[2] == 0)
 2072:     {
 2073:         const char* buf = va_arg(args, const char*); // Skip formatting when using "%s"
 2074:         if (buf == NULL)
 2075:             buf = "(null)";
 2076:         *out_buf = buf;
 2077:         if (out_buf_end) { *out_buf_end = buf + ImStrlen(buf); }
 2078:     }
 2079:     else if (fmt[0] == '%' && fmt[1] == '.' && fmt[2] == '*' && fmt[3] == 's' && fmt[4] == 0)
 2080:     {
 2081:         int buf_len = va_arg(args, int); // Skip formatting when using "%.*s"
 2082:         const char* buf = va_arg(args, const char*);
 2083:         if (buf == NULL)
 2084:         {
 2085:             buf = "(null)";
 2086:             buf_len = ImMin(buf_len, 6);
 2087:         }
 2088:         *out_buf = buf;
 2089:         *out_buf_end = buf + buf_len; // Disallow not passing 'out_buf_end' here. User is expected to use it.
 2090:     }
 2091:     else
 2092:     {
 2093:         int buf_len = ImFormatStringV(g.TempBuffer.Data, g.TempBuffer.Size, fmt, args);
 2094:         *out_buf = g.TempBuffer.Data;
 2095:         if (out_buf_end) { *out_buf_end = g.TempBuffer.Data + buf_len; }
 2096:     }
 2097: }
