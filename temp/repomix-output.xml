543: // Helper to obtain the source of mouse messages.
544: // See https://learn.microsoft.com/en-us/windows/win32/tablet/system-events-and-mouse-messages
545: // Prefer to call this at the top of the message handler to avoid the possibility of other Win32 calls interfering with this.
546: static ImGuiMouseSource ImGui_ImplWin32_GetMouseSourceFromMessageExtraInfo()
547: {
548:     LPARAM extra_info = ::GetMessageExtraInfo();
549:     if ((extra_info & 0xFFFFFF80) == 0xFF515700)
550:         return ImGuiMouseSource_Pen;
551:     if ((extra_info & 0xFFFFFF80) == 0xFF515780)
552:         return ImGuiMouseSource_TouchScreen;
553:     return ImGuiMouseSource_Mouse;
554: }
555: // Win32 message handler (process Win32 mouse/keyboard inputs, etc.)
556: // Call from your application's message handler. Keep calling your message handler unless this function returns TRUE.
557: // When implementing your own backend, you can read the io.WantCaptureMouse, io.WantCaptureKeyboard flags to tell if Dear ImGui wants to use your inputs.
558: // - When io.WantCaptureMouse is true, do not dispatch mouse input data to your main application, or clear/overwrite your copy of the mouse data.
559: // - When io.WantCaptureKeyboard is true, do not dispatch keyboard input data to your main application, or clear/overwrite your copy of the keyboard data.
560: // Generally you may always pass all inputs to Dear ImGui, and hide them from your application based on those two flags.
561: // PS: We treat DBLCLK messages as regular mouse down messages, so this code will work on windows classes that have the CS_DBLCLKS flag set. Our own example app code doesn't set this flag.
562: // Copy either line into your .cpp file to forward declare the function:
563: extern IMGUI_IMPL_API LRESULT ImGui_ImplWin32_WndProcHandler(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam);                // Use ImGui::GetCurrentContext()
564: extern IMGUI_IMPL_API LRESULT ImGui_ImplWin32_WndProcHandlerEx(HWND hWnd, UINT msg, WPARAM wParam, LPARAM lParam, ImGuiIO& io); // Doesn't use ImGui::GetCurrentContext()
565: IMGUI_IMPL_API LRESULT ImGui_ImplWin32_WndProcHandler(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam)
566: {
567:     // Most backends don't have silent checks like this one, but we need it because WndProc are called early in CreateWindow().
568:     // We silently allow both context or just only backend data to be nullptr.
569:     if (ImGui::GetCurrentContext() == nullptr)
570:         return 0;
571:     return ImGui_ImplWin32_WndProcHandlerEx(hwnd, msg, wParam, lParam, ImGui::GetIO());
572: }
573: // This version is in theory thread-safe in the sense that no path should access ImGui::GetCurrentContext().
574: IMGUI_IMPL_API LRESULT ImGui_ImplWin32_WndProcHandlerEx(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam, ImGuiIO& io)
575: {
576:     ImGui_ImplWin32_Data* bd = ImGui_ImplWin32_GetBackendData(io);
577:     if (bd == nullptr)
578:         return 0;
579:     switch (msg)
580:     {
581:     case WM_MOUSEMOVE:
582:     case WM_NCMOUSEMOVE:
583:     {
584:         // We need to call TrackMouseEvent in order to receive WM_MOUSELEAVE events
585:         ImGuiMouseSource mouse_source = ImGui_ImplWin32_GetMouseSourceFromMessageExtraInfo();
586:         const int area = (msg == WM_MOUSEMOVE) ? 1 : 2;
587:         bd->MouseHwnd = hwnd;
588:         if (bd->MouseTrackedArea != area)
589:         {
590:             TRACKMOUSEEVENT tme_cancel = { sizeof(tme_cancel), TME_CANCEL, hwnd, 0 };
591:             TRACKMOUSEEVENT tme_track = { sizeof(tme_track), (DWORD)((area == 2) ? (TME_LEAVE | TME_NONCLIENT) : TME_LEAVE), hwnd, 0 };
592:             if (bd->MouseTrackedArea != 0)
593:                 ::TrackMouseEvent(&tme_cancel);
594:             ::TrackMouseEvent(&tme_track);
595:             bd->MouseTrackedArea = area;
596:         }
597:         POINT mouse_pos = { (LONG)GET_X_LPARAM(lParam), (LONG)GET_Y_LPARAM(lParam) };
598:         if (msg == WM_NCMOUSEMOVE && ::ScreenToClient(hwnd, &mouse_pos) == FALSE) // WM_NCMOUSEMOVE are provided in absolute coordinates.
599:             return 0;
600:         io.AddMouseSourceEvent(mouse_source);
601:         io.AddMousePosEvent((float)mouse_pos.x, (float)mouse_pos.y);
602:         return 0;
603:     }
604:     case WM_MOUSELEAVE:
605:     case WM_NCMOUSELEAVE:
606:     {
607:         const int area = (msg == WM_MOUSELEAVE) ? 1 : 2;
608:         if (bd->MouseTrackedArea == area)
609:         {
610:             if (bd->MouseHwnd == hwnd)
611:                 bd->MouseHwnd = nullptr;
