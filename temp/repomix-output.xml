 33: /** Small helper classes to optimize finding vertices close to a given location
 34:  */
 35: #pragma once
 36: #ifndef AI_D3DSSPATIALSORT_H_INC
 37: #define AI_D3DSSPATIALSORT_H_INC
 38: #ifdef __GNUC__
 39: #   pragma GCC system_header
 40: #endif
 41: #include "types.h"
 42: #include <vector>
 43: #include <stdint.h"
 44: namespace Assimp    {
 45: // ----------------------------------------------------------------------------------
 46: /** Specialized version of SpatialSort to support smoothing groups
 47:  *  This is used in by the 3DS, ASE and LWO loaders. 3DS and ASE share their
 48:  *  normal computation code in SmoothingGroups.inl, the LWO loader has its own
 49:  *  implementation to handle all details of its file format correctly.
 50:  */
 51: // ----------------------------------------------------------------------------------
 52: class ASSIMP_API SGSpatialSort
 53: {
 54: public:
 55:     SGSpatialSort();
 56:     // -------------------------------------------------------------------
 57:     /** Construction from a given face array, handling smoothing groups
 58:      *  properly
 59:      */
 60:     explicit SGSpatialSort(const std::vector<aiVector3D>& vPositions);
 61:     // -------------------------------------------------------------------
 62:     /** Add a vertex to the spatial sort
 63:      * @param vPosition Vertex position to be added
 64:      * @param index Index of the vrtex
 65:      * @param smoothingGroup SmoothingGroup for this vertex
 66:      */
 67:     void Add(const aiVector3D& vPosition, unsigned int index,
 68:         unsigned int smoothingGroup);
 69:     // -------------------------------------------------------------------
 70:     /** Prepare the spatial sorter for use. This step runs in O(logn)
 71:      */
 72:     void Prepare();
 73:     /** Destructor */
 74:     ~SGSpatialSort();
 75:     // -------------------------------------------------------------------
 76:     /** Returns an iterator for all positions close to the given position.
 77:      * @param pPosition The position to look for vertices.
 78:      * @param pSG Only included vertices with at least one shared smooth group
 79:      * @param pRadius Maximal distance from the position a vertex may have
 80:      *   to be counted in.
 81:      * @param poResults The container to store the indices of the found
 82:      *   positions. Will be emptied by the call so it may contain anything.
 83:      * @param exactMatch Specifies whether smoothing groups are bit masks
 84:      *   (false) or integral values (true). In the latter case, a vertex
 85:      *   cannot belong to more than one smoothing group.
 86:      * @return An iterator to iterate over all vertices in the given area.
 87:      */
 88:     // -------------------------------------------------------------------
 89:     void FindPositions( const aiVector3D& pPosition, uint32_t pSG,
 90:         float pRadius, std::vector<unsigned int>& poResults,
 91:         bool exactMatch = false) const;
 92: protected:
 93:     /** Normal of the sorting plane, normalized. The center is always at (0, 0, 0) */
 94:     aiVector3D mPlaneNormal;
 95:     // -------------------------------------------------------------------
 96:     /** An entry in a spatially sorted position array. Consists of a
 97:      *  vertex index, its position and its pre-calculated distance from
 98:      *  the reference plane */
 99:     // -------------------------------------------------------------------
100:     struct Entry {
101:         unsigned int mIndex;    ///< The vertex referred by this entry
102:         aiVector3D mPosition;   ///< Position
103:         uint32_t mSmoothGroups;
104:         float mDistance;        ///< Distance of this vertex to the sorting plane
105:         Entry() AI_NO_EXCEPT
106:         : mIndex(0)
107:         , mPosition()
108:         , mSmoothGroups(0)
109:         , mDistance(0.0f) {
110:             // empty
111:         }
112:         Entry( unsigned int pIndex, const aiVector3D& pPosition, float pDistance,uint32_t pSG)
113:         : mIndex( pIndex)
114:         , mPosition( pPosition)
115:         , mSmoothGroups(pSG)
116:         , mDistance( pDistance) {
117:             // empty
118:         }
119:         bool operator < (const Entry& e) const {
120:             return mDistance < e.mDistance;
121:         }
122:     };
123:     // all positions, sorted by distance to the sorting plane
124:     std::vector<Entry> mPositions;
125: };
126: } // end of namespace Assimp
127: #endif // AI_SPATIALSORT_H_INC
</file>

