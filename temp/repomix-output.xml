284: void Map_SaveToFile(const char *filename) {
285:   FILE *fp = nullptr;
286:   fopen_s(&fp, filename, "w");
287:   if (!fp)
288:     return;
289:   fprintf(fp, "%d\n", (int)g_MapObjects.size());
290:   for (const MapObject &obj : g_MapObjects) {
291:     const char *tex = obj.TexturePath.empty() ? "-" : obj.TexturePath.c_str();
292:     fprintf(
293:         fp,
294:         "%d %.4f %.4f %.4f %.4f %.4f %.4f %.4f %.4f %.4f %.4f %.4f %.4f %s\n",
295:         obj.KindId, obj.Position.x, obj.Position.y, obj.Position.z,
296:         obj.Rotation.x, obj.Rotation.y, obj.Rotation.z, obj.Scale.x,
297:         obj.Scale.y, obj.Scale.z, obj.Collision.min.x, obj.Collision.min.y,
298:         obj.Collision.min.z, tex);
299:   }
300:   fclose(fp);
301: }
302: void Map_LoadFromFile(const char *filename) {
303:   FILE *fp = nullptr;
304:   fopen_s(&fp, filename, "r");
305:   if (!fp)
306:     return;
307:   int count = 0;
308:   fscanf_s(fp, "%d\n", &count);
309:   g_MapObjects.clear();
310:   for (int i = 0; i < count; ++i) {
311:     MapObject obj = {};
312:     obj.TextureId = -1;
313:     char line[512] = {};
314:     if (!fgets(line, sizeof(line), fp))
315:       break;
316:     std::istringstream iss(line);
317:     std::string texStr;
318:     if (iss >> obj.KindId >> obj.Position.x >> obj.Position.y >>
319:         obj.Position.z >> obj.Rotation.x >> obj.Rotation.y >> obj.Rotation.z >>
320:         obj.Scale.x >> obj.Scale.y >> obj.Scale.z >> obj.Collision.min.x >>
321:         obj.Collision.min.y >> obj.Collision.min.z >> texStr) {
322:       if (texStr == "-") {
323:         obj.TexturePath = "";
324:       } else if (texStr.length() > 1 && texStr[0] == '-') {
325:         // Handle case where user pasted "-resource/texture/..."
326:         obj.TexturePath = texStr.substr(1);
327:       } else {
328:         obj.TexturePath = texStr;
329:       }
330:     } else {
331:       // Fallback for older save format (no texture string at the end)
332:       obj.TexturePath = "";
333:     }
334:     // Rebuild collision Collision::AABB from position and scale
335:     if (obj.KindId == BLOCK || obj.KindId == GRASS) {
336:       obj.Collision.min = {obj.Position.x - 0.5f * obj.Scale.x,
337:                            obj.Position.y - 0.5f * obj.Scale.y,
338:                            obj.Position.z - 0.5f * obj.Scale.z};
339:       obj.Collision.max = {obj.Position.x + 0.5f * obj.Scale.x,
340:                            obj.Position.y + 0.5f * obj.Scale.y,
341:                            obj.Position.z + 0.5f * obj.Scale.z};
342:     }
343:     g_MapObjects.push_back(obj);
344:   }
345:   fclose(fp);
346: }
347: void Map_PushUndoState() {
348:   g_UndoStack.push_back(g_MapObjects);
349:   if ((int)g_UndoStack.size() > MAX_UNDO) {
350:     g_UndoStack.erase(g_UndoStack.begin());
351:   }
352:   g_RedoStack.clear(); // New action clears redo history
353: }
354: void Map_Undo() {
355:   if (g_UndoStack.empty())
356:     return;
357:   g_RedoStack.push_back(g_MapObjects); // Save current to redo
358:   g_MapObjects = g_UndoStack.back();
359:   g_UndoStack.pop_back();
360: }
361: void Map_Redo() {
362:   if (g_RedoStack.empty())
363:     return;
364:   g_UndoStack.push_back(g_MapObjects); // Save current to undo
365:   g_MapObjects = g_RedoStack.back();
366:   g_RedoStack.pop_back();
367: }
