12731: static void ImGui::NavUpdateCreateWrappingRequest()
12732: {
12733:     ImGuiContext& g = *GImGui;
12734:     ImGuiWindow* window = g.NavWindow;
12735:     bool do_forward = false;
12736:     ImRect bb_rel = window->NavRectRel[g.NavLayer];
12737:     ImGuiDir clip_dir = g.NavMoveDir;
12738:     const ImGuiNavMoveFlags move_flags = g.NavMoveFlags;
12739:     //const ImGuiAxis move_axis = (g.NavMoveDir == ImGuiDir_Up || g.NavMoveDir == ImGuiDir_Down) ? ImGuiAxis_Y : ImGuiAxis_X;
12740:     if (g.NavMoveDir == ImGuiDir_Left && (move_flags & (ImGuiNavMoveFlags_WrapX | ImGuiNavMoveFlags_LoopX)))
12741:     {
12742:         bb_rel.Min.x = bb_rel.Max.x = window->ContentSize.x + window->WindowPadding.x;
12743:         if (move_flags & ImGuiNavMoveFlags_WrapX)
12744:         {
12745:             bb_rel.TranslateY(-bb_rel.GetHeight()); // Previous row
12746:             clip_dir = ImGuiDir_Up;
12747:         }
12748:         do_forward = true;
12749:     }
12750:     if (g.NavMoveDir == ImGuiDir_Right && (move_flags & (ImGuiNavMoveFlags_WrapX | ImGuiNavMoveFlags_LoopX)))
12751:     {
12752:         bb_rel.Min.x = bb_rel.Max.x = -window->WindowPadding.x;
12753:         if (move_flags & ImGuiNavMoveFlags_WrapX)
12754:         {
12755:             bb_rel.TranslateY(+bb_rel.GetHeight()); // Next row
12756:             clip_dir = ImGuiDir_Down;
12757:         }
12758:         do_forward = true;
12759:     }
12760:     if (g.NavMoveDir == ImGuiDir_Up && (move_flags & (ImGuiNavMoveFlags_WrapY | ImGuiNavMoveFlags_LoopY)))
12761:     {
12762:         bb_rel.Min.y = bb_rel.Max.y = window->ContentSize.y + window->WindowPadding.y;
12763:         if (move_flags & ImGuiNavMoveFlags_WrapY)
12764:         {
12765:             bb_rel.TranslateX(-bb_rel.GetWidth()); // Previous column
12766:             clip_dir = ImGuiDir_Left;
12767:         }
12768:         do_forward = true;
12769:     }
12770:     if (g.NavMoveDir == ImGuiDir_Down && (move_flags & (ImGuiNavMoveFlags_WrapY | ImGuiNavMoveFlags_LoopY)))
12771:     {
12772:         bb_rel.Min.y = bb_rel.Max.y = -window->WindowPadding.y;
12773:         if (move_flags & ImGuiNavMoveFlags_WrapY)
12774:         {
12775:             bb_rel.TranslateX(+bb_rel.GetWidth()); // Next column
12776:             clip_dir = ImGuiDir_Right;
12777:         }
12778:         do_forward = true;
12779:     }
12780:     if (!do_forward)
12781:         return;
12782:     window->NavRectRel[g.NavLayer] = bb_rel;
12783:     NavClearPreferredPosForAxis(ImGuiAxis_X);
12784:     NavClearPreferredPosForAxis(ImGuiAxis_Y);
12785:     NavMoveRequestForward(g.NavMoveDir, clip_dir, move_flags, g.NavMoveScrollFlags);
12786: }
12787: // Can we focus this window with Ctrl+Tab (or PadMenu + PadFocusPrev/PadFocusNext)
12788: // Note that NoNavFocus makes the window not reachable with Ctrl+Tab but it can still be focused with mouse or programmatically.
12789: // If you want a window to never be focused, you may use the e.g. NoInputs flag.
12790: bool ImGui::IsWindowNavFocusable(ImGuiWindow* window)
12791: {
12792:     return window->WasActive && window == window->RootWindow && !(window->Flags & ImGuiWindowFlags_NoNavFocus);
12793: }
12794: static ImGuiWindow* FindWindowNavFocusable(int i_start, int i_stop, int dir) // FIXME-OPT O(N)
12795: {
12796:     ImGuiContext& g = *GImGui;
12797:     for (int i = i_start; i >= 0 && i < g.WindowsFocusOrder.Size && i != i_stop; i += dir)
12798:         if (ImGui::IsWindowNavFocusable(g.WindowsFocusOrder[i]))
12799:             return g.WindowsFocusOrder[i];
12800:     return NULL;
12801: }
12802: static void NavUpdateWindowingTarget(int focus_change_dir)
12803: {
12804:     ImGuiContext& g = *GImGui;
12805:     IM_ASSERT(g.NavWindowingTarget);
12806:     if (g.NavWindowingTarget->Flags & ImGuiWindowFlags_Modal)
12807:         return;
12808:     const int i_current = ImGui::FindWindowFocusIndex(g.NavWindowingTarget);
12809:     ImGuiWindow* window_target = FindWindowNavFocusable(i_current + focus_change_dir, -INT_MAX, focus_change_dir);
12810:     if (!window_target)
12811:         window_target = FindWindowNavFocusable((focus_change_dir < 0) ? (g.WindowsFocusOrder.Size - 1) : 0, i_current, focus_change_dir);
12812:     if (window_target) // Don't reset windowing target if there's a single window in the list
12813:     {
12814:         g.NavWindowingTarget = g.NavWindowingTargetAnim = window_target;
12815:         g.NavWindowingAccumDeltaPos = g.NavWindowingAccumDeltaSize = ImVec2(0.0f, 0.0f);
12816:     }
12817:     g.NavWindowingToggleLayer = false;
12818: }
12819: // Apply focus and close overlay
12820: static void ImGui::NavUpdateWindowingApplyFocus(ImGuiWindow* apply_focus_window)
12821: {
12822:     ImGuiContext& g = *GImGui;
12823:     if (g.NavWindow == NULL || apply_focus_window != g.NavWindow->RootWindow)
12824:     {
12825:         ClearActiveID();
12826:         SetNavCursorVisibleAfterMove();
12827:         ClosePopupsOverWindow(apply_focus_window, false);
12828:         FocusWindow(apply_focus_window, ImGuiFocusRequestFlags_RestoreFocusedChild);
12829:         IM_ASSERT(g.NavWindow != NULL);
12830:         apply_focus_window = g.NavWindow;
12831:         if (apply_focus_window->NavLastIds[0] == 0)
12832:             NavInitWindow(apply_focus_window, false);
12833:         // If the window has ONLY a menu layer (no main layer), select it directly
12834:         // Use NavLayersActiveMaskNext since windows didn't have a chance to be Begin()-ed on this frame,
12835:         // so Ctrl+Tab where the keys are only held for 1 frame will be able to use correct layers mask since
12836:         // the target window as already been previewed once.
12837:         // FIXME-NAV: This should be done in NavInit.. or in FocusWindow... However in both of those cases,
12838:         // we won't have a guarantee that windows has been visible before and therefore NavLayersActiveMask*
12839:         // won't be valid.
12840:         if (apply_focus_window->DC.NavLayersActiveMaskNext == (1 << ImGuiNavLayer_Menu))
12841:             g.NavLayer = ImGuiNavLayer_Menu;
12842:     }
12843:     g.NavWindowingTarget = NULL;
12844: }
12845: // Windowing management mode
12846: // Keyboard: Ctrl+Tab (change focus/move/resize), Alt (toggle menu layer)
12847: // Gamepad:  Hold Menu/Square (change focus/move/resize), Tap Menu/Square (toggle menu layer)
12848: static void ImGui::NavUpdateWindowing()
12849: {
12850:     ImGuiContext& g = *GImGui;
12851:     ImGuiIO& io = g.IO;
12852:     ImGuiWindow* apply_focus_window = NULL;
12853:     bool apply_toggle_layer = false;
12854:     ImGuiWindow* modal_window = GetTopMostPopupModal();
12855:     bool allow_windowing = (modal_window == NULL); // FIXME: This prevent Ctrl+Tab from being usable with windows that are inside the Begin-stack of that modal.
12856:     if (!allow_windowing)
12857:         g.NavWindowingTarget = NULL;
12858:     // Fade out
12859:     if (g.NavWindowingTargetAnim && g.NavWindowingTarget == NULL)
12860:     {
12861:         g.NavWindowingHighlightAlpha = ImMax(g.NavWindowingHighlightAlpha - io.DeltaTime * 10.0f, 0.0f);
12862:         if (g.DimBgRatio <= 0.0f && g.NavWindowingHighlightAlpha <= 0.0f)
12863:             g.NavWindowingTargetAnim = NULL;
12864:     }
12865:     // Start Ctrl+Tab or Square+L/R window selection
12866:     // (g.ConfigNavWindowingKeyNext/g.ConfigNavWindowingKeyPrev defaults are ImGuiMod_Ctrl|ImGuiKey_Tab and ImGuiMod_Ctrl|ImGuiMod_Shift|ImGuiKey_Tab)
12867:     const ImGuiID owner_id = ImHashStr("##NavUpdateWindowing");
12868:     const bool nav_gamepad_active = (io.ConfigFlags & ImGuiConfigFlags_NavEnableGamepad) != 0 && (io.BackendFlags & ImGuiBackendFlags_HasGamepad) != 0;
12869:     const bool nav_keyboard_active = (io.ConfigFlags & ImGuiConfigFlags_NavEnableKeyboard) != 0;
12870:     const bool keyboard_next_window = allow_windowing && g.ConfigNavWindowingKeyNext && Shortcut(g.ConfigNavWindowingKeyNext, ImGuiInputFlags_Repeat | ImGuiInputFlags_RouteAlways, owner_id);
12871:     const bool keyboard_prev_window = allow_windowing && g.ConfigNavWindowingKeyPrev && Shortcut(g.ConfigNavWindowingKeyPrev, ImGuiInputFlags_Repeat | ImGuiInputFlags_RouteAlways, owner_id);
12872:     const bool start_toggling_with_gamepad = nav_gamepad_active && !g.NavWindowingTarget && Shortcut(ImGuiKey_NavGamepadMenu, ImGuiInputFlags_RouteAlways, owner_id);
12873:     const bool start_windowing_with_gamepad = allow_windowing && start_toggling_with_gamepad;
12874:     const bool start_windowing_with_keyboard = allow_windowing && !g.NavWindowingTarget && (keyboard_next_window || keyboard_prev_window); // Note: enabled even without NavEnableKeyboard!
12875:     bool just_started_windowing_from_null_focus = false;
12876:     if (start_toggling_with_gamepad)
12877:     {
12878:         g.NavWindowingToggleLayer = true; // Gamepad starts toggling layer
12879:         g.NavWindowingToggleKey = ImGuiKey_NavGamepadMenu;
12880:         g.NavWindowingInputSource = g.NavInputSource = ImGuiInputSource_Gamepad;
12881:     }
12882:     if (start_windowing_with_gamepad || start_windowing_with_keyboard)
12883:         if (ImGuiWindow* window = (g.NavWindow && IsWindowNavFocusable(g.NavWindow)) ? g.NavWindow : FindWindowNavFocusable(g.WindowsFocusOrder.Size - 1, -INT_MAX, -1))
12884:         {
12885:             if (start_windowing_with_keyboard || g.ConfigNavWindowingWithGamepad)
12886:                 g.NavWindowingTarget = g.NavWindowingTargetAnim = window->RootWindow; // Current location
12887:             g.NavWindowingTimer = g.NavWindowingHighlightAlpha = 0.0f;
12888:             g.NavWindowingAccumDeltaPos = g.NavWindowingAccumDeltaSize = ImVec2(0.0f, 0.0f);
12889:             g.NavWindowingInputSource = g.NavInputSource = start_windowing_with_keyboard ? ImGuiInputSource_Keyboard : ImGuiInputSource_Gamepad;
12890:             if (g.NavWindow == NULL)
12891:                 just_started_windowing_from_null_focus = true;
12892:             // Manually register ownership of our mods. Using a global route in the Shortcut() calls instead would probably be correct but may have more side-effects.
12893:             if (keyboard_next_window || keyboard_prev_window)
12894:                 SetKeyOwnersForKeyChord((g.ConfigNavWindowingKeyNext | g.ConfigNavWindowingKeyPrev) & ImGuiMod_Mask_, owner_id);
12895:         }
12896:     // Gamepad update
12897:     if ((g.NavWindowingTarget || g.NavWindowingToggleLayer) && g.NavWindowingInputSource == ImGuiInputSource_Gamepad)
12898:     {
12899:         if (g.NavWindowingTarget != NULL)
12900:         {
12901:             // Highlight only appears after a brief time holding the button, so that a fast tap on ImGuiKey_NavGamepadMenu (to toggle NavLayer) doesn't add visual noise
12902:             // However inputs are accepted immediately, so you press ImGuiKey_NavGamepadMenu + L1/R1 fast.
12903:             g.NavWindowingTimer += io.DeltaTime;
12904:             g.NavWindowingHighlightAlpha = ImMax(g.NavWindowingHighlightAlpha, ImSaturate((g.NavWindowingTimer - NAV_WINDOWING_HIGHLIGHT_DELAY) / 0.05f));
12905:             // Select window to focus
12906:             const int focus_change_dir = (int)IsKeyPressed(ImGuiKey_GamepadL1) - (int)IsKeyPressed(ImGuiKey_GamepadR1);
12907:             if (focus_change_dir != 0 && !just_started_windowing_from_null_focus)
12908:             {
12909:                 NavUpdateWindowingTarget(focus_change_dir);
12910:                 g.NavWindowingHighlightAlpha = 1.0f;
12911:             }
12912:         }
12913:         // Single press toggles NavLayer, long press with L/R apply actual focus on release (until then the window was merely rendered top-most)
12914:         if (!IsKeyDown(ImGuiKey_NavGamepadMenu))
12915:         {
12916:             g.NavWindowingToggleLayer &= (g.NavWindowingHighlightAlpha < 1.0f); // Once button was held long enough we don't consider it a tap-to-toggle-layer press anymore.
12917:             if (g.NavWindowingToggleLayer && g.NavWindow)
12918:                 apply_toggle_layer = true;
12919:             else if (!g.NavWindowingToggleLayer)
12920:                 apply_focus_window = g.NavWindowingTarget;
12921:             g.NavWindowingTarget = NULL;
12922:             g.NavWindowingToggleLayer = false;
12923:         }
12924:     }
12925:     // Keyboard: Focus
12926:     if (g.NavWindowingTarget && g.NavWindowingInputSource == ImGuiInputSource_Keyboard)
12927:     {
12928:         // Visuals only appears after a brief time after pressing TAB the first time, so that a fast Ctrl+Tab doesn't add visual noise
12929:         ImGuiKeyChord shared_mods = ((g.ConfigNavWindowingKeyNext ? g.ConfigNavWindowingKeyNext : ImGuiMod_Mask_) & (g.ConfigNavWindowingKeyPrev ? g.ConfigNavWindowingKeyPrev : ImGuiMod_Mask_)) & ImGuiMod_Mask_;
12930:         IM_ASSERT(shared_mods != 0); // Next/Prev shortcut currently needs a shared modifier to "hold", otherwise Prev actions would keep cycling between two windows.
12931:         g.NavWindowingTimer += io.DeltaTime;
12932:         g.NavWindowingHighlightAlpha = ImMax(g.NavWindowingHighlightAlpha, ImSaturate((g.NavWindowingTimer - NAV_WINDOWING_HIGHLIGHT_DELAY) / 0.05f)); // 1.0f
12933:         if ((keyboard_next_window || keyboard_prev_window) && !just_started_windowing_from_null_focus)
12934:             NavUpdateWindowingTarget(keyboard_next_window ? -1 : +1);
12935:         else if ((io.KeyMods & shared_mods) != shared_mods)
12936:             apply_focus_window = g.NavWindowingTarget;
12937:     }
12938:     // Keyboard: Press and Release Alt to toggle menu layer
12939:     const ImGuiKey windowing_toggle_keys[] = { ImGuiKey_LeftAlt, ImGuiKey_RightAlt };
12940:     bool windowing_toggle_layer_start = false;
12941:     if (g.NavWindow != NULL && !(g.NavWindow->Flags & ImGuiWindowFlags_NoNavInputs))
12942:         for (ImGuiKey windowing_toggle_key : windowing_toggle_keys)
12943:             if (nav_keyboard_active && IsKeyPressed(windowing_toggle_key, 0, ImGuiKeyOwner_NoOwner))
12944:             {
12945:                 windowing_toggle_layer_start = true;
12946:                 g.NavWindowingToggleLayer = true;
12947:                 g.NavWindowingToggleKey = windowing_toggle_key;
12948:                 g.NavWindowingInputSource = g.NavInputSource = ImGuiInputSource_Keyboard;
12949:                 break;
12950:             }
12951:     if (g.NavWindowingToggleLayer && g.NavWindowingInputSource == ImGuiInputSource_Keyboard)
12952:     {
12953:         // We cancel toggling nav layer when any text has been typed (generally while holding Alt). (See #370)
12954:         // We cancel toggling nav layer when other modifiers are pressed. (See #4439)
12955:         // - AltGR is Alt+Ctrl on some layout but we can't reliably detect it (not all backends/systems/layout emit it as Alt+Ctrl).
12956:         // We cancel toggling nav layer if an owner has claimed the key.
12957:         if (io.InputQueueCharacters.Size > 0 || io.KeyCtrl || io.KeyShift || io.KeySuper)
12958:             g.NavWindowingToggleLayer = false;
12959:         else if (windowing_toggle_layer_start == false && g.LastKeyboardKeyPressTime == g.Time)
12960:             g.NavWindowingToggleLayer = false;
12961:         else if (TestKeyOwner(g.NavWindowingToggleKey, ImGuiKeyOwner_NoOwner) == false || TestKeyOwner(ImGuiMod_Alt, ImGuiKeyOwner_NoOwner) == false)
12962:             g.NavWindowingToggleLayer = false;
12963:         // Apply layer toggle on Alt release
12964:         // Important: as before version <18314 we lacked an explicit IO event for focus gain/loss, we also compare mouse validity to detect old backends clearing mouse pos on focus loss.
12965:         if (IsKeyReleased(g.NavWindowingToggleKey) && g.NavWindowingToggleLayer)
12966:             if (g.ActiveId == 0 || g.ActiveIdAllowOverlap)
12967:                 if (IsMousePosValid(&io.MousePos) == IsMousePosValid(&io.MousePosPrev))
12968:                     apply_toggle_layer = true;
12969:         if (!IsKeyDown(g.NavWindowingToggleKey))
12970:             g.NavWindowingToggleLayer = false;
12971:     }
12972:     // Move window
12973:     if (g.NavWindowingTarget && !(g.NavWindowingTarget->Flags & ImGuiWindowFlags_NoMove))
12974:     {
12975:         ImVec2 nav_move_dir;
12976:         if (g.NavInputSource == ImGuiInputSource_Keyboard && !io.KeyShift)
12977:             nav_move_dir = GetKeyMagnitude2d(ImGuiKey_LeftArrow, ImGuiKey_RightArrow, ImGuiKey_UpArrow, ImGuiKey_DownArrow);
12978:         if (g.NavInputSource == ImGuiInputSource_Gamepad)
12979:             nav_move_dir = GetKeyMagnitude2d(ImGuiKey_GamepadLStickLeft, ImGuiKey_GamepadLStickRight, ImGuiKey_GamepadLStickUp, ImGuiKey_GamepadLStickDown);
12980:         if (nav_move_dir.x != 0.0f || nav_move_dir.y != 0.0f)
12981:         {
12982:             const float NAV_MOVE_SPEED = 800.0f;
12983:             const float move_step = NAV_MOVE_SPEED * io.DeltaTime * ImMin(io.DisplayFramebufferScale.x, io.DisplayFramebufferScale.y);
12984:             g.NavWindowingAccumDeltaPos += nav_move_dir * move_step;
12985:             g.NavHighlightItemUnderNav = true;
12986:             ImVec2 accum_floored = ImTrunc(g.NavWindowingAccumDeltaPos);
12987:             if (accum_floored.x != 0.0f || accum_floored.y != 0.0f)
12988:             {
12989:                 ImGuiWindow* moving_window = g.NavWindowingTarget->RootWindow;
12990:                 SetWindowPos(moving_window, moving_window->Pos + accum_floored, ImGuiCond_Always);
12991:                 g.NavWindowingAccumDeltaPos -= accum_floored;
12992:             }
12993:         }
12994:     }
12995:     // Apply final focus
12996:     if (apply_focus_window)
12997:         NavUpdateWindowingApplyFocus(apply_focus_window);
12998:     // Apply menu/layer toggle
12999:     if (apply_toggle_layer && g.NavWindow)
13000:     {
13001:         ClearActiveID();
13002:         // Move to parent menu if necessary
13003:         ImGuiWindow* new_nav_window = g.NavWindow;
13004:         while (new_nav_window->ParentWindow
13005:             && (new_nav_window->DC.NavLayersActiveMask & (1 << ImGuiNavLayer_Menu)) == 0
13006:             && (new_nav_window->Flags & ImGuiWindowFlags_ChildWindow) != 0
13007:             && (new_nav_window->Flags & (ImGuiWindowFlags_Popup | ImGuiWindowFlags_ChildMenu)) == 0)
13008:             new_nav_window = new_nav_window->ParentWindow;
13009:         if (new_nav_window != g.NavWindow)
13010:         {
13011:             ImGuiWindow* old_nav_window = g.NavWindow;
13012:             FocusWindow(new_nav_window);
13013:             new_nav_window->NavLastChildNavWindow = old_nav_window;
13014:         }
13015:         // Toggle layer
13016:         const ImGuiNavLayer new_nav_layer = (g.NavWindow->DC.NavLayersActiveMask & (1 << ImGuiNavLayer_Menu)) ? (ImGuiNavLayer)((int)g.NavLayer ^ 1) : ImGuiNavLayer_Main;
13017:         if (new_nav_layer != g.NavLayer)
13018:         {
13019:             // Reinitialize navigation when entering menu bar with the Alt key (FIXME: could be a properly of the layer?)
13020:             if (new_nav_layer == ImGuiNavLayer_Menu)
13021:                 g.NavWindow->NavLastIds[new_nav_layer] = 0;
13022:             NavRestoreLayer(new_nav_layer);
13023:             SetNavCursorVisibleAfterMove();
13024:         }
13025:     }
13026: }
